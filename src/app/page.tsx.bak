  const importeDocumento = (n: number, moneda: string) => `${moneda || 'ARS'} $ ${n.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

  const renderizarPaginaPresupuesto = async (documento: jsPDF, p: Presupuesto) => {
    // El diseño base ocupa 190 × 279 mm. Llevarlo al 95% de A4 conserva

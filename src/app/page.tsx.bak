#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .budget-generator .budget-v2-form{display:flex!important;flex-direction:column!important;flex:1 1 auto!important;min-height:0!important;overflow:hidden!important;margin:0!important;padding:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .budget-generator .budget-v2-scroll{position:relative!important;flex:1 1 0!important;min-height:0!important;height:auto!important;max-height:none!important;overflow-y:auto!important;overflow-x:hidden!important;overscroll-behavior:contain!important;scroll-padding:14px!important;padding:16px 20px!important;box-sizing:border-box!important}

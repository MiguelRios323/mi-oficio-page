#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-step-instruction{font-size:13px!important;line-height:1.65!important;color:#473152!important;margin:12px 0!important;min-height:42px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-real-capture{margin:0!important;min-width:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-capture-open{display:flex!important;flex-direction:column!important;align-items:center!important;width:100%!important;height:auto!important;min-height:0!important;padding:0!important;overflow:hidden!important;background:#f8f5fc!important;border:1px solid #e8def1!important;border-radius:12px!important;box-shadow:none!important;cursor:zoom-in!important}

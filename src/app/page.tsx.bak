#mioficio-dashboard.mio-compact-v2 #perfil-profesional .profile-v2-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:10px!important}
#mioficio-dashboard.mio-compact-v2 #perfil-profesional .profile-v2-grid>.profile-v2-full{grid-column:1/-1!important}
#mioficio-dashboard.mio-compact-v2 #perfil-profesional .compact-profile-logo{display:block}
#mioficio-dashboard.mio-compact-v2 #perfil-profesional .compact-profile-logo h3{margin-bottom:10px!important}
#mioficio-dashboard.mio-compact-v2 #perfil-profesional .profile-v2-payment{flex:1 1 92px!important}
}
@media(max-width:540px){
#mioficio-dashboard.mio-compact-v2 #perfil-profesional .profile-v2-grid{grid-template-columns:minmax(0,1fr)!important}

#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .budget-generator .budget-v2-payment-options>.budget-v2-payment{width:100%!important;min-width:0!important;margin:0!important;padding:9px 6px!important;gap:5px!important;font-size:11px!important;box-sizing:border-box!important}

}

/* V12: encabezado en su tarjeta y formulario de cliente sin columna vacía. */
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-document-side{display:grid!important;grid-template-columns:minmax(0,1fr)!important;align-content:start!important;gap:14px!important;min-width:0!important}

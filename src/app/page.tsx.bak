#mioficio-dashboard.mio-compact-v2 .compact-kpi-icon{width:29px;height:29px;min-width:29px;border-radius:8px}#mioficio-dashboard.mio-compact-v2 .compact-kpi-icon svg{width:17px!important;height:17px!important}
#mioficio-dashboard.mio-compact-v2 .compact-kpis article>div>span{font-size:10px!important}#mioficio-dashboard.mio-compact-v2 .compact-kpis strong{font-size:17px!important;letter-spacing:-.4px;margin-top:4px;white-space:normal}
#mioficio-dashboard.mio-compact-v2 .compact-money-toggle{top:3px;right:3px;padding:0}#mioficio-dashboard.mio-compact-v2 .compact-money-toggle svg{width:11px!important;height:11px!important}
#mioficio-dashboard.mio-compact-v2 .compact-counts{display:grid!important;grid-template-columns:1fr 1fr;gap:9px}#mioficio-dashboard.mio-compact-v2 .compact-counts button{display:flex;align-items:center;gap:10px;text-align:left;padding:12px!important;border:1px solid #e2d7f1!important;border-radius:10px!important;background:white!important;color:#6541df!important;font-size:10px!important;min-height:56px!important;height:auto!important}

    }
    setPeriodoInicioModelo(periodo);
  };
  const rangoInicioInvalido=periodoInicioModelo==='personalizado'&&(!desdeInicioModelo||!hastaInicioModelo||desdeInicioModelo>hastaInicioModelo);
  const fechaEnPeriodoModelo=(fecha:string)=>!rangoInicioInvalido && /^\d{4}-\d{2}-\d{2}$/.test(fecha) && (periodoInicioModelo==='mes'?fecha.slice(0,7)===mesResumenReferencia:periodoInicioModelo==='anio'?fecha.slice(0,4)===hoyInicioModelo.slice(0,4):(!desdeInicioModelo||fecha>=desdeInicioModelo)&&(!hastaInicioModelo||fecha<=hastaInicioModelo));
  const presupuestosPeriodoModelo=presupuestos.filter(p=>p.estado!=='Borrador'&&monedaPresupuesto(p.moneda)===monedaCobrado&&fechaEnPeriodoModelo(p.fecha));
  // One dated ledger for dashboard and reports; refunds preserve the original income date.
  const movimientosPeriodoModelo=movimientosFinancierosPresupuestos(presupuestos,monedaCobrado).filter(m=>fechaEnPeriodoModelo(m.fecha));
  const cobradoInicioModelo=Math.round(movimientosPeriodoModelo.reduce((n,m)=>n+m.importe,0)*100)/100;
  const cobrosPorFechaModelo=new Map<string,number>();
  for(const m of movimientosPeriodoModelo)cobrosPorFechaModelo.set(m.fecha,(cobrosPorFechaModelo.get(m.fecha)||0)+m.importe);
  const graficoCobrosModelo=Array.from(cobrosPorFechaModelo,([fecha,importe])=>({fecha,importe:Math.round(importe*100)/100})).filter(c=>c.importe!==0).sort((a,b)=>a.fecha.localeCompare(b.fecha)).slice(-7);
  const maximoGraficoCobrosModelo=Math.max(0,...graficoCobrosModelo.map(c=>c.importe));
  const minimoGraficoCobrosModelo=Math.min(0,...graficoCobrosModelo.map(c=>c.importe));
  const amplitudGraficoCobrosModelo=maximoGraficoCobrosModelo-minimoGraficoCobrosModelo||1;
  const pendientesPeriodoModelo=presupuestos.filter(p=>monedaPresupuesto(p.moneda)===monedaCobrado&&fechaEnPeriodoModelo(p.fecha_aceptacion||p.fecha)&&(p.estado==='Aceptado'||p.estado==='Pagado'||cobradoPresupuesto(p)>0)&&saldoPresupuesto(p)>0);
  const pendienteInicioModelo=pendientesPeriodoModelo.reduce((n,p)=>n+saldoPresupuesto(p),0);
  const emitidosPeriodoModelo=presupuestosPeriodoModelo.filter(p=>(p.estado||'Emitido')==='Emitido');
  const presupuestadoInicioModelo=emitidosPeriodoModelo.reduce((n,p)=>n+totalVigentePresupuesto(p),0);
  const actividadInicioModelo = presupuestos.flatMap(p => {
    const movimientos: {id:string;presupuesto:Presupuesto;fecha:string;orden:number;titulo:string;detalle:string;pagado:boolean;importe:number;tipo:'presupuesto'|'pago'|'devolucion'|'correccion';medio?:string}[] = [];
    if (p.estado !== 'Borrador') movimientos.push({id:`emitido-${p.presupuesto_id}`,presupuesto:p,fecha:p.fecha,orden:0,titulo:`Presupuesto emitido · ${p.cliente || 'Sin cliente'}`,detalle:p.numero_presupuesto,pagado:false,importe:totalVigentePresupuesto(p),tipo:'presupuesto'});
    for(const r of listarComprobantesCobros([p])){
      if(r.tipo==='pago')movimientos.push({id:`cobro-${p.presupuesto_id}-${r.c.id}`,presupuesto:p,fecha:r.fecha,orden:Number(r.c.registradoAt)||1,titulo:`Pago recibido · ${p.cliente||'Sin cliente'}`,detalle:`${p.numero_presupuesto} · ${r.c.medio||'Pago'}`,pagado:true,importe:r.importe,tipo:'pago',medio:r.c.medio});
      else movimientos.push({id:`reversion-${p.presupuesto_id}-${r.r.id}`,presupuesto:p,fecha:r.fecha,orden:r.r.registradoAt,titulo:`${r.tipo==='devolucion'?'Devolución realizada':'Pago corregido'} · ${p.cliente||'Sin cliente'}`,detalle:`${p.numero_presupuesto} · ${importeDocumento(r.importe,p.moneda)}`,pagado:false,importe:r.importe,tipo:r.tipo,medio:r.r.medio_devolucion||r.r.medio_pago_anterior});
    }
    return movimientos;
  }).sort((a,b) => b.fecha.localeCompare(a.fecha) || b.orden-a.orden || b.presupuesto.presupuesto_id-a.presupuesto.presupuesto_id);
  const filasActividadInicioModelo = (limite:number) => actividadInicioModelo.slice(0,limite).map(m => <button type="button" className="approved-activity-row" key={m.id} onClick={()=>abrirDetallePresupuesto(m.presupuesto)}><span className={`approved-circle ${m.pagado?'green':''}`}><IconoOficial nombre={m.pagado?'banknote':'file-text'}/></span><span><strong>{m.titulo}</strong><small>{m.detalle}</small></span><small>{fechaCortaCompacta(m.fecha)}</small></button>);
  const porVencerModelo=presupuestos.filter(p=>{
    if(['Borrador','Pagado','Aceptado','Rechazado','Cancelado'].includes(p.estado)||p.incluir_condiciones===false||!p.validez_dias||!/^\d{4}-\d{2}-\d{2}$/.test(p.fecha))return false;
    const dias=(Date.parse(`${p.fecha}T12:00:00Z`)+Number(p.validez_dias)*86400000-Date.parse(`${hoyInicioModelo}T12:00:00Z`))/86400000;
    return dias>=0&&dias<=7;
  });
  const porCobrarModelo=presupuestos.filter(p=>(p.estado==='Aceptado'||cobradoPresupuesto(p)>0)&&saldoPresupuesto(p)>0);

  const porPaginaClientes = configuracionGuardada.ajustar_listas_pantalla?Math.max(configuracionGuardada.clientes_por_pagina,capacidadPantalla.clientes):configuracionGuardada.clientes_por_pagina;
  const clientesFiltrados = clientes.filter(c => 

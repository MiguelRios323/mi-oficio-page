@media(max-width:1023px){
#mioficio-dashboard.reference-ui.banking-ui .compact-bottom-nav{position:fixed!important;width:calc(100% - 24px)!important;max-width:476px!important;left:50%!important;right:auto!important;transform:translateX(-50%)!important;bottom:calc(10px + env(safe-area-inset-bottom))!important;height:68px!important;min-height:68px!important;border:1px solid #bcb2f1!important;border-bottom:2px solid #6049f8!important;border-radius:21px!important;background:white!important;box-shadow:0 0 14px #624af83a!important;padding:6px 4px!important;z-index:40!important;overflow:visible!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-bottom-nav>button,#mioficio-dashboard.reference-ui.banking-ui .compact-bottom-nav>button:nth-child(3){display:grid!important;grid-template-rows:24px 14px!important;gap:7px!important;align-items:center!important;justify-items:center!important;align-self:stretch!important;position:relative!important;height:54px!important;min-height:54px!important;padding:4px 0!important;line-height:1!important;background:none!important;color:#827e8c!important}

    const nuevaPagina = () => { doc.addPage(); y = 12; font(true,9.5); doc.text(`PRESUPUESTO ${p.numero_presupuesto} - Continuación`,left,y);y+=8; };
    const espacio = (h: number) => { if(y+h>bottom) nuevaPagina(); };
    const lines = (value: string, w: number, bold = false, size = 9.5) => { font(bold,size); return doc.splitTextToSize(String(value), w) as string[]; };
    const bloque = (titulo: string, value: string) => {

#mioficio-dashboard.reference-ui.banking-ui .visual-client-name>span{display:flex;align-items:center;justify-content:center;flex:0 0 32px;width:32px;height:32px;border-radius:50%;background:#eeebff;color:#5041f8;font-size:11px}
#mioficio-dashboard.reference-ui.banking-ui .visual-client-table strong{font-size:12px;font-weight:500}
#mioficio-dashboard.reference-ui.banking-ui .visual-catalog-labels,#mioficio-dashboard.reference-ui.banking-ui .visual-catalog-row{display:grid;grid-template-columns:minmax(0,2fr) 70px minmax(120px,1fr) 80px;gap:10px;align-items:center;padding:14px 8px;font-size:12px;border-bottom:1px solid #eeebf8}
#mioficio-dashboard.reference-ui.banking-ui .visual-catalog-labels{background:#faf9ff;font-size:11px;color:#4e487f}
#mioficio-dashboard.reference-ui.banking-ui .visual-catalog-row>strong{font-size:12px;font-weight:500}
#mioficio-dashboard.reference-ui.banking-ui .visual-catalog-row>.catalogo-delete-confirm{grid-column:1/-1}
#mioficio-dashboard.reference-ui.banking-ui .visual-catalog-free{padding:24px 12px;color:#7972a0;font-size:12px;text-align:center}
#mioficio-dashboard.reference-ui.banking-ui .visual-empty{font-size:12px!important;color:#7972a0;padding:14px 0}
#mioficio-dashboard.reference-ui.banking-ui .visual-plan-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
#mioficio-dashboard.reference-ui.banking-ui .visual-plan-grid h3{display:flex;align-items:center;gap:9px;color:#5041f8;font-size:18px!important;margin:0 0 8px!important}
#mioficio-dashboard.reference-ui.banking-ui .visual-plan-grid p{font-size:12px!important;color:#7972a0;margin:0 0 14px!important}
#mioficio-dashboard.reference-ui.banking-ui .visual-plan-grid ul{list-style:none;margin:0;padding:0;display:grid;gap:12px;font-size:13px}

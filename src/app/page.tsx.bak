/* El medio de los pagos guardados se presenta como dato de consulta. */
.collection-dialog .collection-method-select{min-width:140px;max-width:180px;width:100%;height:38px;padding:6px 24px 6px 10px;border:1px solid #e7e2f3;border-radius:9px;background:#faf8ff;color:#302253;font-size:13px}

#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .collection-dialog .collection-method-select{min-width:130px!important;width:100%!important;max-width:none!important;font-size:13px!important;height:38px!important;padding:6px 24px 6px 10px!important}
@media(max-width:640px){#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .collection-dialog .gestion-table-scroll:has(.collection-method-select){overflow:visible!important}#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .collection-dialog .gestion-table-scroll:has(.collection-method-select) :is(table,tbody){display:block!important;width:100%!important;min-width:0!important}#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .collection-dialog .gestion-table-scroll:has(.collection-method-select) thead{display:none!important}#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .collection-dialog .gestion-table-scroll:has(.collection-method-select) tr{display:grid!important;grid-template-columns:minmax(0,1fr) minmax(0,1fr)!important;gap:12px!important;border-bottom:1px solid #eee9f6!important;padding:12px 0!important}#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .collection-dialog .gestion-table-scroll:has(.collection-method-select) td{display:flex!important;flex-direction:column!important;gap:6px!important;padding:0!important;border:0!important;min-width:0!important;white-space:normal!important;font-size:13px!important}#mioficio-dashboard .collection-dialog .gestion-table-scroll:has(.collection-method-select) td:before{font-size:11px;color:#827a94}#mioficio-dashboard .collection-dialog .gestion-table-scroll:has(.collection-method-select) td:nth-child(1):before{content:'Fecha'}#mioficio-dashboard .collection-dialog .gestion-table-scroll:has(.collection-method-select) td:nth-child(2):before{content:'Medio'}#mioficio-dashboard .collection-dialog .gestion-table-scroll:has(.collection-method-select) td:nth-child(3):before{content:'Importe'}#mioficio-dashboard .collection-dialog .gestion-table-scroll:has(.collection-method-select) td:nth-child(4):before{content:'Nota'}}

#mioficio-dashboard .collection-dialog .received-receipt-button{display:flex!important;align-items:center!important;gap:6px!important;padding:8px 10px!important;margin-top:8px!important;background:#f1ecff!important;color:#6244e8!important;border:1px solid #e5dcff!important;border-radius:9px!important;font-size:12px!important;line-height:1.3!important;white-space:normal!important;min-height:38px!important;width:auto!important}
#mioficio-dashboard .collection-dialog .received-receipt-button svg{width:16px!important;height:16px!important;flex-shrink:0!important}


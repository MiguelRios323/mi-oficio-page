#mioficio-dashboard.mio-compact-v2 .compact-upsell{display:flex;align-items:center;gap:10px;border:1px solid #ded0fa!important;background:#eae2ff!important;color:#704bbd!important;padding:12px 14px!important;height:auto!important;border-radius:10px!important;font-size:12px!important}

#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-guide-figure figcaption{font-size:10px!important;line-height:1.5!important;color:#9b86a6!important;text-align:center!important;margin-top:7px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-center-empty{font-size:12px!important;color:#897294!important;line-height:1.7!important;padding:16px 0!important}

        .inicio-recent-row {display:flex;align-items:center;gap:12px;width:100%;min-width:0;padding:17px 20px;text-align:left;background:#fff;border:0;border-bottom:1px solid #edf0f6;cursor:pointer;}
        .inicio-recent-row:last-child {border-bottom:0;}.inicio-recent-row:hover {background:#f8faff;}.inicio-recent-row:focus-visible {outline:2px solid #6441df;outline-offset:-2px;}
        .inicio-recent-icon {width:38px;height:38px;display:flex;align-items:center;justify-content:center;flex-shrink:0;border-radius:11px;background:#eee8ff;color:#6441df;}.inicio-recent-icon svg {}
        .inicio-recent-copy {display:grid;gap:5px;flex:1;min-width:0;}.inicio-recent-copy strong {font-size:15px;font-weight:650;color:#24203c;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}.inicio-recent-copy>span {font-size:12px;color:#78829b;overflow-wrap:anywhere;}
        .inicio-recent-value {display:flex;flex-direction:column;align-items:flex-end;gap:6px;flex-shrink:0;}.inicio-recent-value>strong {font-size:16px;font-weight:600;color:#24203c;font-variant-numeric:tabular-nums;}
        .inicio-recent-status {font-size:11px;font-weight:650;line-height:1.3;padding:4px 8px;border-radius:6px;}.inicio-recent-status.is-issued {background:#f0f2f7;color:#61708d;}.inicio-recent-status.is-accepted {background:#eee8ff;color:#6441df;}.inicio-recent-status.is-paid {background:#eaf7ef;color:#247749;}.inicio-recent-status.is-rejected {background:#fff0f0;color:#ac4343;}
        .inicio-recent-arrow {color:#a4aec3;font-size:22px;}.inicio-recent-empty {display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:36px 20px;text-align:center;color:#79829e;}.inicio-recent-empty svg {color:#6441df;}.inicio-recent-empty strong {font-size:15px;color:#24203c;}.inicio-recent-empty p {margin:0;font-size:13px;line-height:1.5;}

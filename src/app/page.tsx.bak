#mioficio-dashboard.mio-compact-v2 .compact-topbar-title img{width:116px;height:29px;object-fit:contain;filter:brightness(0) invert(1)}#mioficio-dashboard.mio-compact-v2 .compact-topbar-actions{gap:9px}

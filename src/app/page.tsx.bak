#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-finances .approved-card-heading h2{font-size:14px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-finances-period{font-size:9px!important;max-width:90px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-finances-grid{gap:12px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-finances-grid .approved-metric{align-items:flex-start!important;gap:7px!important}

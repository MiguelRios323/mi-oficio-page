#mioficio-dashboard.reference-ui.banking-ui>.compact-main{height:100dvh!important;max-height:100dvh!important;min-height:0!important;align-self:stretch!important;border-radius:0!important}
#mioficio-dashboard.reference-ui.banking-ui>.compact-main>.compact-content{width:100%!important;max-width:1180px!important;margin:0 auto!important;padding:16px 28px 24px!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-topbar{width:100%!important;max-width:1180px!important;margin:0 auto!important;padding:24px 28px!important;box-sizing:border-box!important}
}

#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard :is(.approved-header,.approved-home,.approved-clients,.approved-quotes,.approved-client-detail) :is(h1,h2,h3,p){margin:0!important;text-transform:none!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard [class*="approved-"]>svg{width:20px!important;height:20px!important;min-width:20px!important;max-width:none!important;max-height:none!important;stroke-width:1.8!important;flex-shrink:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard :is(.approved-primary,.approved-outline,.approved-soft,.approved-icon,.approved-link,.approved-text,.approved-brand){display:inline-flex!important;align-items:center!important;justify-content:center!important;gap:8px!important;border-radius:10px!important;font-size:13px!important;line-height:1.3!important;text-transform:none!important;cursor:pointer;min-height:40px!important;padding:10px 15px!important;font-weight:600!important;letter-spacing:0!important;box-shadow:none!important;white-space:nowrap!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-primary{border:1px solid transparent!important;background:linear-gradient(110deg,#674bff,#5840ee)!important;color:white!important;box-shadow:0 3px 9px #6046f52a!important}

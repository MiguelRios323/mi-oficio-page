#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-icon{display:flex!important;align-items:center!important;justify-content:center!important;flex:0 0 35px!important;width:35px!important;height:35px!important;background:#f1eafa!important;color:#8b60c0!important;border-radius:10px!important}

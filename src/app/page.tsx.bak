interface ItemPresupuesto {
  tipo: string; // compatibilidad con presupuestos anteriores; ya no se solicita en el generador
  descripcion: string; // Producto / Servicio: único concepto comercial
  cantidad: number;
  unidad?: string;
  precio_unitario: number; // precio neto unitario
  bonificacion?: number; // porcentaje por ítem
  iva?: number; // porcentaje por ítem
}

interface ArticuloCatalogo {
  id: string;
  descripcion: string;
  unidad: string;
  precio_unitario: number;
  iva: number;
  moneda: string;
}

const validarArticuloCatalogo = (a: ArticuloCatalogo) => {
  if (!a.descripcion.trim() || a.descripcion.trim().length > 160) return 'Ingresá una descripción de hasta 160 caracteres.';
  if (!Number.isFinite(a.precio_unitario) || a.precio_unitario < 0 || a.precio_unitario > 999999999) return 'Ingresá un precio válido entre 0 y 999.999.999.';
  if (![0, 10.5, 21, 27].includes(a.iva)) return 'Seleccioná una tasa de IVA válida.';
  if (!a.unidad.trim() || !a.moneda.trim()) return 'Completá la unidad y la moneda.';
  return '';
};
const insertarArticuloCatalogo = (items: ItemPresupuesto[], a: ArticuloCatalogo): ItemPresupuesto[] => {
  const item: ItemPresupuesto = { tipo: '', descripcion: a.descripcion, cantidad: 1, unidad: a.unidad, precio_unitario: a.precio_unitario, bonificacion: 0, iva: a.iva };
  const vacio = items.findIndex(i => !i.descripcion.trim() && !i.precio_unitario && i.cantidad === 1 && !i.bonificacion);
  return vacio < 0 ? [...items, item] : items.map((i, indice) => indice === vacio ? item : i);
};

const fechaArgentina = (instante = new Date()) => {
  const partes = new Intl.DateTimeFormat('en-US', {timeZone:'America/Argentina/Buenos_Aires', year:'numeric', month:'2-digit', day:'2-digit'}).formatToParts(instante);
  const valor = (tipo: string) => partes.find(p=>p.type===tipo)?.value || '';
  return `${valor('year')}-${valor('month')}-${valor('day')}`;
};

const LIMITES_ESPECIFICACIONES = [60, 120, 160] as const;
const limitarEspecificacion = (valor: string, indice: number) => String(valor || '').replace(/\s+/g, ' ').trimStart().slice(0, LIMITES_ESPECIFICACIONES[indice] ?? 30);

const formatearDuracionPresupuesto = (valor: string) => {
  const texto = String(valor || '').trim();
  return /^\d+(?:[.,]\d+)?$/.test(texto) ? `${texto} ${Number(texto.replace(',','.')) === 1 ? 'día' : 'días'}` : texto;
};

const UNIDADES_PRESUPUESTO = ['un.', 'm', 'm²', 'm³', 'cm', 'kg', 'g', 'l', 'h', 'día', 'servicio', 'lote'];
const DETALLE_UNIDADES: Record<string, { nombre: string; simbolo: string }> = {
  'un.': { nombre: 'Unidad', simbolo: 'UNI' },
  m: { nombre: 'Metro', simbolo: 'm' },
  'm²': { nombre: 'Metro cuadrado', simbolo: 'm²' },
  'm³': { nombre: 'Metro cúbico', simbolo: 'm³' },
  cm: { nombre: 'Centímetro', simbolo: 'cm' },
  kg: { nombre: 'Kilogramo', simbolo: 'kg' },
  g: { nombre: 'Gramo', simbolo: 'g' },
  l: { nombre: 'Litro', simbolo: 'L' },
  h: { nombre: 'Hora', simbolo: 'h' },
  'día': { nombre: 'Día', simbolo: 'd' },
  servicio: { nombre: 'Servicio', simbolo: 'SERV.' },
  lote: { nombre: 'Lote', simbolo: 'LOTE' }
};
const abreviarUnidadPresupuesto = (unidad?: string) => {
  const valor = (unidad || 'un.').trim().toLowerCase();
  const equivalencias: Record<string, string> = { unidad:'un.', unidades:'un.', uni:'un.', un:'un.', 'serv.':'servicio', serv:'servicio', m2:'m²', mt2:'m²', m3:'m³', mt3:'m³', metro:'m', hora:'h', dia:'día' };
  return DETALLE_UNIDADES[equivalencias[valor] || valor]?.simbolo || unidad || 'UNI';
};

const redondearImporte = (n: number) => Math.round((n + Number.EPSILON) * 100) / 100;
const calcularItemPresupuesto = (i: ItemPresupuesto) => {
  const cantidad = Math.max(0, Number(i.cantidad) || 0);
  const precio = Math.max(0, Number(i.precio_unitario) || 0);
  const bruto = redondearImporte(cantidad * precio);
  const bonificacion = redondearImporte(bruto * Math.min(100, Math.max(0, Number(i.bonificacion) || 0)) / 100);
  const neto = redondearImporte(bruto - bonificacion);
  const tasaIva = Math.max(0, Number(i.iva ?? 21) || 0);
  const iva = redondearImporte(neto * tasaIva / 100);
  return { bruto, bonificacion, neto, tasaIva, iva, total: redondearImporte(neto + iva) };
};
const calcularTotalesPresupuesto = (items: ItemPresupuesto[], descuento = 0) => {
  const sumas = items.reduce((a, i) => {
    const c = calcularItemPresupuesto(i);
    return { subtotal: a.subtotal + c.bruto, bonificaciones: a.bonificaciones + c.bonificacion, iva: a.iva + c.iva, total: a.total + c.total };
  }, { subtotal: 0, bonificaciones: 0, iva: 0, total: 0 });
  return { subtotal: redondearImporte(sumas.subtotal), bonificaciones: redondearImporte(sumas.bonificaciones), iva: redondearImporte(sumas.iva), descuento: Math.max(0, Number(descuento) || 0), total: redondearImporte(Math.max(0, sumas.total - (Number(descuento) || 0))) };
};

interface CobroPresupuesto { tipo_pago?:'total'|'parcial'; id:string; importe:number; fecha:string; medio:string; nota:string; registradoAt:number; comprobante_recibido?:ComprobantePagoRecibido; }
const monedaPresupuesto = (value?:string):string => {
  const code=String(value||'ARS').trim().toUpperCase();
  if(['ARS','$','AR$','PESO','PESOS','PESOS ARGENTINOS','PESO ARGENTINO','ARG'].includes(code))return 'ARS';
  if(['USD','US$','U$S','DOLAR','DÓLAR','DOLARES','DÓLARES'].includes(code))return 'USD';
  return code;
};
const monedaInicialPerfil = (perfil: Pick<Perfil, 'moneda_default' | 'moneda_elegida_explicitamente'>): string => perfil.moneda_elegida_explicitamente === true && monedaPresupuesto(perfil.moneda_default) === 'USD' ? 'USD' : 'ARS';
const totalVigentePresupuesto=(p:Presupuesto):number=>Math.max(0,Number(p.total_acordado??p.total)||0);
const cobradoPresupuesto = (p: Presupuesto): number => {
  const importe=totalVigentePresupuesto(p);
  const registrados=Object.values(p.cobros||{}).reduce((sum,c)=>sum+Math.max(0,Number(c?.importe)||0),0);
  // Pagado registra el total completo, también para presupuestos anteriores sin libro de cobros.
  return Math.round((String(p.estado).trim().toLowerCase()==='pagado'?Math.max(importe,registrados):registrados)*100)/100;
};
const saldoPresupuesto = (p: Presupuesto): number => Math.max(0,Math.round((totalVigentePresupuesto(p)-cobradoPresupuesto(p))*100)/100);
const conservarCobrosAlEditar=(p:Presupuesto,nuevoTotal:number):{estado:string;cobros:CobroPresupuesto[]}=>{
  const cobrado=cobradoPresupuesto(p),total=Math.round(Math.max(0,nuevoTotal)*100)/100;
  if(Math.round(total*100)<Math.round(cobrado*100))throw new Error('El nuevo total es menor que lo cobrado. Registrá primero la devolución desde Más → Devolver dinero.');
  const cobros=Object.values(p.cobros||{}).map(c=>({...c}));
  const historico=Math.max(0,Math.round((cobrado-cobros.reduce((n,c)=>n+Math.max(0,Number(c.importe)||0),0))*100)/100);
  if(historico>0)cobros.push({id:`historico-edicion-${p.presupuesto_id}`,importe:historico,fecha:p.fecha_pago||p.fecha,medio:p.medio_pago_registrado||'No especificado',nota:'Pago histórico conservado al editar el presupuesto.',registradoAt:0,tipo_pago:'total'});
  const estado=cobrado>0?(Math.round(cobrado*100)>=Math.round(total*100)?'Pagado':'Aceptado'):['Borrador','Cancelado'].includes(p.estado)?'Emitido':p.estado||'Emitido';
  return {estado,cobros};
};

const estadoComercialVisible=(p:Presupuesto)=>p.estado==='Pagado'?'Aceptado':p.estado||'Emitido';
const situacionPagoVisible=(p:Presupuesto)=>p.estado==='Borrador'||totalVigentePresupuesto(p)<=0?'No aplica':cobradoPresupuesto(p)<=0?'Pendiente':saldoPresupuesto(p)>0?'Parcial':'Pagado';
// El sello depende de los pagos vigentes; emitir o aceptar no acredita un pago.
const estadoMarcaPagoPresupuesto = (p: Presupuesto): 'PAGADO' | 'PAGADO PARCIALMENTE' | null => {
  if (['borrador','cancelado','rechazado'].includes(String(p.estado || '').trim().toLowerCase())) return null;
  if (totalVigentePresupuesto(p) <= 0 || cobradoPresupuesto(p) <= 0) return null;
  return saldoPresupuesto(p) > 0 ? 'PAGADO PARCIALMENTE' : 'PAGADO';
};
const dibujarMarcaPagoPresupuesto = (documento: jsPDF, p: Presupuesto, recuadro?: {x:number;y:number;width:number;height:number}, empresa='MiOficio'): void => {
  const estado=estadoMarcaPagoPresupuesto(p);
  if(!estado||!recuadro)return;
  const area={x:recuadro.x+3,y:recuadro.y+6,width:recuadro.width-6,height:recuadro.height-7.5};
  if(area.width<20||area.height<8)return;
  documento.saveGraphicsState();
  try{
    documento.rect(recuadro.x+1,recuadro.y+1,recuadro.width-2,recuadro.height-2,null);
    documento.clip();documento.discardPath();
    const color=estado==='PAGADO'?'#16744c':'#946217';
    const angulo=12,rad=angulo*Math.PI/180,cos=Math.cos(rad),sin=Math.sin(rad);
    const ancho=Math.min(76,area.width-4),margen=1.7;
    const tituloBase=estado==='PAGADO'?24:20;
    documento.setFont('Roboto','bold');documento.setFontSize(tituloBase);
    const tituloSize=Math.min(tituloBase,tituloBase*(ancho-8)/Math.max(1,documento.getTextWidth(estado)+0.12*(estado.length-1)));
    const firmaSize=8;
    documento.setFont('Roboto','normal');documento.setFontSize(firmaSize);
    const nombre=empresa.trim().replace(/\s+/g,' ').toLocaleUpperCase('es-AR')||'MIOFICIO';
    const firma=documento.splitTextToSize(nombre,ancho-8) as string[];
    const tituloH=tituloSize*0.352778,firmaH=firmaSize*0.352778;
    const alto=margen*2+tituloH+1+firmaH*firma.length;
    const escala=Math.min(1,area.width/(ancho*cos+alto*sin),area.height/(ancho*sin+alto*cos));
    const cx=area.x+area.width/2,cy=area.y+area.height/2;
    const punto=(x:number,y:number)=>({x:cx+escala*(x*cos+y*sin),y:cy+escala*(-x*sin+y*cos)});
    const linea=(x1:number,y1:number,x2:number,y2:number)=>{const a=punto(x1,y1),b=punto(x2,y2);documento.line(a.x,a.y,b.x,b.y);};
    const marco=(inset:number)=>{const x=ancho/2-inset,y=alto/2-inset;linea(-x,-y,x,-y);linea(x,-y,x,y);linea(x,y,-x,y);linea(-x,y,-x,-y);};
    documento.setGState(documento.GState({opacity:0.34}));
    documento.setDrawColor(color);documento.setTextColor(color);documento.setLineWidth(0.35*escala);marco(0);
    documento.setLineWidth(0.12*escala);marco(0.65);
    const tituloY=-alto/2+margen+tituloH*0.8;
    const texto=(valor:string,size:number,y:number,bold:boolean,espaciado=0)=>{
      documento.setFont('Roboto',bold?'bold':'normal');documento.setFontSize(size*escala);
      const w=documento.getTextWidth(valor)+espaciado*escala*(valor.length-1);
      const a=punto(-w/(2*escala),y);
      documento.text(valor,a.x,a.y,{angle:angulo,charSpace:espaciado*escala});
    };
    texto(estado,tituloSize,tituloY,true,0.12);
    linea(-ancho/2+3,tituloY+1.1,ancho/2-3,tituloY+1.1);
    documento.setGState(documento.GState({opacity:0.5}));
    firma.forEach((linea,index)=>texto(linea,firmaSize,tituloY+tituloH*0.2+1+firmaH*(index+0.8),false));
  }finally{documento.restoreGraphicsState();}
};

// Los importes principales mantienen todos sus dígitos y se ajustan al ancho real.
const ImporteAdaptable = ({children,className=''}:{children:string;className?:string}) => {
  const elemento=useRef<HTMLElement|null>(null);
  useEffect(()=>{
    const nodo=elemento.current;
    if(!nodo)return;
    let activo=true,frame=0,ultimoAncho=-1;
    const ajustar=()=>{
      if(!activo||!nodo.isConnected)return;
      const ancho=nodo.clientWidth;
      if(ancho<=0)return;
      ultimoAncho=ancho;
      const base=parseFloat(getComputedStyle(nodo).getPropertyValue('--importe-max-font'))||32;
      nodo.style.setProperty('font-size',base+'px','important');
      const texto=nodo.firstElementChild as HTMLElement|null;
      if(!texto)return;
      const anchoTexto=texto.getBoundingClientRect().width;
      const size=Math.min(base,base*Math.max(1,ancho-1)/Math.max(1,anchoTexto));
      nodo.style.setProperty('font-size',Math.max(1,size)+'px','important');
    };
    const solicitar=()=>{if(Math.abs(nodo.clientWidth-ultimoAncho)<0.5)return;cancelAnimationFrame(frame);frame=requestAnimationFrame(ajustar);};
    ajustar();
    const observador=typeof ResizeObserver==='undefined'?null:new ResizeObserver(solicitar);
    observador?.observe(nodo);
    window.addEventListener('resize',solicitar);
    void document.fonts?.ready.then(()=>{if(activo)ajustar();});
    return ()=>{activo=false;cancelAnimationFrame(frame);observador?.disconnect();window.removeEventListener('resize',solicitar);};
  },[children]);
  return <strong ref={elemento} className={'importe-adaptable '+className} data-long-amount={children.length>14} title={children}><span>{children}</span></strong>;
};
const etiquetaEjeImporte=(valor:number):string=>{
  if(!Number.isFinite(valor))return '0';
  const n=Math.abs(valor),divisor=n>=1e12?1e12:n>=1e6?1e6:n>=1e3?1e3:1;
  const sufijo=divisor===1e12?' bill.':divisor===1e6?' M':divisor===1e3?' mil':'';
  return (valor/divisor).toLocaleString('es-AR',{maximumFractionDigits:divisor===1?0:1})+sufijo;
};

type DatosCuentaSincronizados={perfil?:Perfil;clientes?:Cliente[]|Record<string,Cliente>;presupuestos?:Presupuesto[]|Record<string,Presupuesto>;[clave:string]:unknown};
const compararDatosGuardados=(a:unknown,b:unknown):boolean=>{
  const ordenar=(v:unknown):unknown=>{
    if(v===undefined||v===null)return null;
    if(Array.isArray(v))return v.length?v.map(ordenar):null;
    if(typeof v==='object'){const obj=v as Record<string,unknown>;const entries=Object.keys(obj).sort().map(k=>[k,ordenar(obj[k])] as const).filter(([,value])=>value!==null);return entries.length?Object.fromEntries(entries):null;}
    return v;
  };
  return JSON.stringify(ordenar(a))===JSON.stringify(ordenar(b));
};
const fusionarCuentaSegura=(actual:DatosCuentaSincronizados,base:DatosCuentaSincronizados,deseado:DatosCuentaSincronizados):DatosCuentaSincronizados=>{
  const conflicto=()=>{throw new Error('CONFLICTO_GUARDADO: Hay cambios nuevos en otra sesión. Actualizá los datos antes de repetir la operación.');};
  const lista=<T extends object>(remotos:T[],anteriores:T[],nuevos:T[],campo:keyof T):T[]=>{
    const a=new Map(anteriores.map(item=>[String(item[campo]),item]));
    const n=new Map(nuevos.map(item=>[String(item[campo]),item]));
    const r=new Map(remotos.map(item=>[String(item[campo]),item]));
    if(n.size!==nuevos.length)throw new Error('Hay identificadores repetidos. Actualizá los datos antes de guardar.');
    for(const id of new Set([...a.keys(),...n.keys()])){
      const antes=a.get(id),nuevo=n.get(id),vigente=r.get(id);
      if(compararDatosGuardados(antes,nuevo)||compararDatosGuardados(vigente,nuevo))continue;
      if(!compararDatosGuardados(vigente,antes))conflicto();
      if(nuevo)r.set(id,nuevo);else r.delete(id);
    }
    const orden=new Set([...n.keys(),...r.keys()]);
    return Array.from(orden).flatMap(id=>{const item=r.get(id);return item?[item]:[];});
  };
  const perfil={...(actual.perfil||{})} as Record<string,unknown>;
  const anterior=(base.perfil||{}) as Record<string,unknown>,nuevo=(deseado.perfil||{}) as Record<string,unknown>;
  for(const key of new Set([...Object.keys(anterior),...Object.keys(nuevo)])){
    if(compararDatosGuardados(anterior[key],nuevo[key])||compararDatosGuardados(perfil[key],nuevo[key]))continue;
    if(!compararDatosGuardados(perfil[key],anterior[key]))conflicto();
    if(nuevo[key]===undefined)delete perfil[key];else perfil[key]=nuevo[key];
  }
  return {...actual,perfil:perfil as Perfil,
    clientes:lista(Object.values(actual.clientes||{}),Object.values(base.clientes||{}),Object.values(deseado.clientes||{}),'cliente_id'),
    presupuestos:lista(Object.values(actual.presupuestos||{}),Object.values(base.presupuestos||{}),Object.values(deseado.presupuestos||{}),'presupuesto_id'),
    actualizado:new Date().toISOString()};
};

const estadoPagoVisible=(p:Presupuesto):string=>cobradoPresupuesto(p)>0&&saldoPresupuesto(p)>0&&!['Borrador','Cancelado','Rechazado'].includes(p.estado)?'Pago parcial':p.estado||'Emitido';
interface ReversionCobro {
  tipo?:'correccion'|'devolucion';medio_devolucion?:string;referencia_devolucion?:string;fecha_devolucion?:string;
  id:string;fecha:string;importe:number;cobros?:CobroPresupuesto[];registradoAt:number;motivo:string;
  fecha_pago_anterior?:string;medio_pago_anterior?:string;
  comprobante?:{numero:string;presupuesto:string;cliente:string;documentoCliente:string;moneda:string;total:number;totalAnterior?:number;cobradoAntes:number;cobradoDespues:number;saldoAntes:number;saldoDespues:number;emisor:{nombre:string;identificacion:string;email:string;telefono:string;domicilio?:string;condicionFiscal?:string;responsable?:string}};
}
// La reversión conserva los cobros afectados y una copia de los datos del comprobante.
const construirReversionCobro=(p:Presupuesto,importe:number,motivo:string,perfil:Perfil)=>{
  const antes=Math.round(cobradoPresupuesto(p)*100),centavos=Math.round(importe*100);
  if(!Number.isFinite(importe)||centavos<=0||centavos>antes)throw new Error('Ingresá un importe mayor a cero que no supere lo cobrado.');
  const id=crypto.randomUUID(),fecha=fechaArgentina(),registradoAt=Date.now();
  const originales=Object.values(p.cobros||{}).filter(c=>Number(c.importe)>0).map(c=>({...c}));
  const registrados=originales.reduce((n,c)=>n+Math.round(c.importe*100),0);
  if(antes>registrados)originales.push({id:`historico-${id}`,importe:(antes-registrados)/100,fecha:p.fecha_pago||p.fecha,medio:p.medio_pago_registrado||'No especificado',nota:'Pago histórico registrado como completo.',registradoAt:0});
  let pendiente=centavos;const afectados:CobroPresupuesto[]=[];
  const conservados=originales.sort((a,b)=>b.fecha.localeCompare(a.fecha)||b.registradoAt-a.registradoAt).flatMap(c=>{
    const disponible=Math.round(c.importe*100),revertido=Math.min(disponible,pendiente);pendiente-=revertido;
    if(revertido>0)afectados.push({...c,importe:revertido/100});
    return disponible>revertido?[{...c,importe:(disponible-revertido)/100}]:[];
  }).sort((a,b)=>a.fecha.localeCompare(b.fecha)||a.registradoAt-b.registradoAt);
  const despues=(antes-centavos)/100,total=totalVigentePresupuesto(p);
  const reversion:ReversionCobro={id,fecha,tipo:'correccion',importe:centavos/100,cobros:afectados,registradoAt,motivo:motivo.trim().slice(0,200),fecha_pago_anterior:p.fecha_pago||p.fecha,medio_pago_anterior:p.medio_pago_registrado||'No especificado',comprobante:{numero:`REV-${fecha.slice(0,4)}-${id.replace(/-/g,'').toUpperCase()}`,presupuesto:p.numero_presupuesto,cliente:p.cliente,documentoCliente:p.cuit_cuil||'',moneda:p.moneda||'ARS',total,cobradoAntes:antes/100,cobradoDespues:despues,saldoAntes:Math.max(0,Math.round((total-antes/100)*100)/100),saldoDespues:Math.max(0,Math.round((total-despues)*100)/100),emisor:{nombre:perfil.nombre_comercial||perfil.nombre||'Profesional',identificacion:perfil.cuit_cuil||'',email:perfil.email||'',telefono:perfil.telefono||'',domicilio:perfil.direccion||'',condicionFiscal:perfil.condicion_iva||'',responsable:perfil.nombre||''}}};
  const {fecha_pago,medio_pago_registrado,...resto}=p;
  const presupuesto:Presupuesto={...resto,estado:despues>=total?'Pagado':'Aceptado',fecha_aceptacion:fecha,cobros:conservados,reversiones_cobros:[...Object.values(p.reversiones_cobros||{}),reversion],...(despues>=total?{fecha_pago:fecha_pago||fecha,medio_pago_registrado:medio_pago_registrado||'No especificado'}:{})};
  return {presupuesto,reversion};
};
const construirDevolucionCobro=(p:Presupuesto,importe:number,motivo:string,perfil:Perfil,medio:string,referencia:string,fecha:string,nuevoTotal:number)=>{
  if(!['Efectivo','Transferencia','Cheque'].includes(medio))throw new Error('Elegí cómo devolviste el dinero.');
  const vigente=totalVigentePresupuesto(p),neto=Math.round((cobradoPresupuesto(p)-importe)*100)/100;
  if(!Number.isFinite(nuevoTotal)||nuevoTotal<0||Math.round(nuevoTotal*100)>Math.round(vigente*100))throw new Error('El nuevo total debe estar entre cero y el total vigente.');
  if(Math.round(nuevoTotal*100)<Math.round(neto*100))throw new Error('El nuevo total es menor al dinero que conservás. Revisá el importe a devolver.');
  const resultado=construirReversionCobro(p,importe,motivo,perfil);
  const reversion:ReversionCobro={...resultado.reversion,tipo:'devolucion',medio_devolucion:medio,referencia_devolucion:referencia.trim().slice(0,120),fecha_devolucion:fecha,comprobante:{...resultado.reversion.comprobante!,numero:resultado.reversion.comprobante!.numero.replace(/^REV-/,'DEV-'),total:Math.round(nuevoTotal*100)/100,totalAnterior:vigente,saldoDespues:Math.max(0,Math.round((nuevoTotal-neto)*100)/100)}};
  const presupuesto:Presupuesto={...resultado.presupuesto,total_acordado:Math.round(nuevoTotal*100)/100,estado:nuevoTotal===0?'Cancelado':Math.round(neto*100)>=Math.round(nuevoTotal*100)?'Pagado':'Aceptado',reversiones_cobros:[...Object.values(p.reversiones_cobros||{}),reversion]};
  return {presupuesto,reversion};
};

interface ComprobantePagoRecibido {condicionPago?:string;resumen?:{total:number;acumulado:number;saldo:number};numero:string;importe:number;fecha:string;medio:string;nota:string;concepto:string;cliente:string;documentoCliente:string;presupuesto:string;moneda:string;emisor:{nombre:string;identificacion:string;domicilio:string;email:string;telefono:string;responsable:string};}
const datosComprobanteRecibido=(p:Presupuesto,c:CobroPresupuesto,perfil:Perfil,incluirResumen=false):ComprobantePagoRecibido=>c.comprobante_recibido||({condicionPago:p.forma_pago||'',...incluirResumen?{resumen:{total:totalVigentePresupuesto(p),acumulado:Math.round((cobradoPresupuesto(p)+c.importe)*100)/100,saldo:Math.max(0,Math.round((totalVigentePresupuesto(p)-cobradoPresupuesto(p)-c.importe)*100)/100)}}:{},numero:`REC-${(c.fecha||p.fecha).slice(0,4)}-${p.presupuesto_id}-${c.id.replace(/[^a-zA-Z0-9-]/g,'').toUpperCase()}`,importe:c.importe,fecha:c.fecha,medio:c.medio,nota:c.nota||'',concepto:[p.tipo_proyecto,...(p.items||[]).map(i=>i.descripcion)].filter(Boolean).filter((v,i,a)=>a.indexOf(v)===i).join(' · ')||`Pago a cuenta del presupuesto ${p.numero_presupuesto}`,cliente:p.cliente,documentoCliente:p.cuit_cuil||'',presupuesto:p.numero_presupuesto,moneda:p.moneda||'ARS',emisor:{nombre:perfil.nombre_comercial||perfil.nombre||'Profesional',identificacion:perfil.cuit_cuil||'',domicilio:perfil.direccion||'',email:perfil.email||'',telefono:perfil.telefono||'',responsable:perfil.nombre||''}});
const dibujarMarcaMiOficioCentrada=(doc:jsPDF,esPremium:boolean)=>{
 if(esPremium)return;
 const ancho=doc.internal.pageSize.getWidth(),alto=doc.internal.pageSize.getHeight();
 const w=Math.min(145,ancho*.7),h=w/3.82802548;
 doc.saveGraphicsState();doc.setGState(doc.GState({opacity:.4}));
 doc.addImage(MI_OFICIO_MARCA_AGUA_PNG,'PNG',(ancho-w)/2,(alto-h)/2,w,h);
 doc.restoreGraphicsState();
};
const logoPdfSegunPlan=async(perfil:Perfil)=>{
 const premium=perfil.es_premium===true;
 const url=perfil.logo_url?.trim();
 if(premium&&(!url||[MIOFICIO_LOGO_PERMANENTE,MI_OFICIO_PDF_PNG,MI_OFICIO_PDF_SVG].includes(url)))return null;
 try{return await prepararLogoParaPdf(premium?url:undefined);}
 catch{return premium?null:{data:MI_OFICIO_PDF_PNG,format:'PNG' as const};}
};
// Branding for receipts only. Budget PDF rendering remains independent.
const marcaComprobanteSegunPlan=async(perfil:Perfil)=>{
 if(perfil.es_premium!==true)return {data:MI_OFICIO_PDF_PNG,format:'PNG' as const};
 return logoPdfSegunPlan(perfil);
};
const dibujarMarcaComprobante=(doc:jsPDF,logo:Awaited<ReturnType<typeof marcaComprobanteSegunPlan>>)=>{
 if(!logo)return;
 const p=doc.getImageProperties(logo.data),pw=doc.internal.pageSize.getWidth(),ph=doc.internal.pageSize.getHeight();
 const escala=Math.min(112/p.width,80/p.height),w=p.width*escala,h=p.height*escala;
 doc.saveGraphicsState();doc.setGState(doc.GState({opacity:.075}));
 doc.addImage(logo.data,logo.format,(pw-w)/2,(ph-h)/2,w,h);doc.restoreGraphicsState();
};
const encabezadoComprobante=(doc:jsPDF,nombre:string,datos:string[])=>{
 doc.setFont('Roboto','bold');doc.setFontSize(16);doc.setTextColor('#192c3c');
 const lineas=doc.splitTextToSize(nombre.toUpperCase(),174) as string[];let y=23;
 for(const linea of lineas){doc.text(linea,18,y);y+=6.5;}
 doc.setFont('Roboto','normal');doc.setFontSize(8);doc.setTextColor('#657582');
 for(const dato of datos.filter(Boolean))for(const linea of doc.splitTextToSize(dato,174)){doc.text(linea,18,y);y+=4.2;}
 return y+9;
};
const importeEnLetrasRecibo=(importe:number,moneda:string):string=>{
 const unidades=['cero','uno','dos','tres','cuatro','cinco','seis','siete','ocho','nueve','diez','once','doce','trece','catorce','quince','dieciséis','diecisiete','dieciocho','diecinueve','veinte','veintiuno','veintidós','veintitrés','veinticuatro','veinticinco','veintiséis','veintisiete','veintiocho','veintinueve'];
 const decenas=['','','veinte','treinta','cuarenta','cincuenta','sesenta','setenta','ochenta','noventa'];
 const centenas=['','ciento','doscientos','trescientos','cuatrocientos','quinientos','seiscientos','setecientos','ochocientos','novecientos'];
 const apocopar=(s:string)=>s.replace(/veintiuno$/,'veintiún').replace(/uno$/,'un');
 const numero=(n:number):string=>{if(n<30)return unidades[n];if(n<100)return decenas[Math.floor(n/10)]+(n%10?' y '+unidades[n%10]:'');if(n===100)return 'cien';if(n<1000)return centenas[Math.floor(n/100)]+(n%100?' '+numero(n%100):'');if(n<1000000)return (n<2000?'mil':apocopar(numero(Math.floor(n/1000)))+' mil')+(n%1000?' '+numero(n%1000):'');return (n<2000000?'un millón':apocopar(numero(Math.floor(n/1000000)))+' millones')+(n%1000000?' '+numero(n%1000000):'');};
 if(!Number.isFinite(importe)||importe<0||importe>=1e12)return '';
 const centavos=Math.round(importe*100),entero=Math.floor(centavos/100),fraccion=centavos%100;
 const divisa=moneda==='ARS'?'pesos argentinos':moneda==='USD'?'dólares estadounidenses':moneda;
 return `${apocopar(numero(entero))}${entero>0&&entero%1000000===0?' de':''} ${divisa}${fraccion?' con '+String(fraccion).padStart(2,'0')+'/100':''}`;
};
const crearPdfPagoRecibido=async(c:ComprobantePagoRecibido,perfil:Perfil)=>{
 const doc=new jsPDF({unit:'mm',format:'a4'});
 doc.addFileToVFS('Roboto-Regular.ttf',ROBOTO_REGULAR_BASE64);doc.addFont('Roboto-Regular.ttf','Roboto','normal');doc.addFileToVFS('Roboto-Bold.ttf',ROBOTO_BOLD_BASE64);doc.addFont('Roboto-Bold.ttf','Roboto','bold');
 const ink='#192c3c',muted='#71808c',line='#dde4e9',left=18,right=192,width=174;
 const parcial=c.resumen?c.resumen.saldo>.005:false,color=parcial?'#a2762c':'#237855';let y=18;
 const font=(size=10,bold=false,col=ink)=>{doc.setFont('Roboto',bold?'bold':'normal');doc.setFontSize(size);doc.setTextColor(col);};
 const split=(v:string,w:number,size=10,bold=false)=>{font(size,bold);return doc.splitTextToSize(v,w) as string[];};
 const fecha=(v:string)=>/^\d{4}-\d{2}-\d{2}$/.test(v)?v.split('-').reverse().join('/'):v;
 const monto=(n:number)=>'$ '+Number(n).toLocaleString('es-AR',{minimumFractionDigits:2,maximumFractionDigits:2});
 const regla=(at:number)=>{doc.setDrawColor(line);doc.setLineWidth(.25);doc.line(left,at,right,at);};
 const pagina=()=>{doc.addPage();font(9,true);doc.text('COMPROBANTE DE PAGO',left,19);font(8,false,muted);doc.text(c.numero,right,19,{align:'right'});regla(24);y=34;};
 const espacio=(h:number)=>{if(y+h>264)pagina();};
 const texto=(v:string,size=10,col=ink)=>{for(const l of split(v,width,size)){espacio(5);font(size,false,col);doc.text(l,left,y);y+=5;}};
 const marca=await marcaComprobanteSegunPlan(perfil);
 y=encabezadoComprobante(doc,c.emisor.nombre,[c.emisor.identificacion?`CUIT / identificación: ${c.emisor.identificacion}`:'',c.emisor.domicilio,[c.emisor.telefono,c.emisor.email].filter(Boolean).join(' · ')]);
 font(18,true);doc.text('COMPROBANTE DE PAGO',left,y);y+=8;
 const refs=split(`N.º ${c.numero}`,116,9,true);font(9,true);doc.text(refs,left,y,{lineHeightFactor:1.2});font(9,false);doc.text(`Fecha: ${fecha(c.fecha)}`,right,y,{align:'right'});y+=Math.max(1,refs.length)*4.5+5;regla(y);y+=9;
 font(7.5,true,muted);doc.text('RECIBIDO DE',left,y);doc.text('PRESUPUESTO ASOCIADO',108,y);y+=7;
 const nombre=split(c.cliente,82,11,true),ref=split(c.presupuesto,84,11,true);font(11,true);doc.text(nombre,left,y,{lineHeightFactor:1.2});doc.text(ref,108,y,{lineHeightFactor:1.2});y+=Math.max(nombre.length,ref.length)*5;
 if(c.documentoCliente){font(8,false,muted);doc.text(`CUIT / DNI: ${c.documentoCliente}`,left,y);y+=4.5;}
 const concepto=split(c.concepto,84,8);font(8,false,muted);doc.text(concepto,108,y,{lineHeightFactor:1.3});y+=Math.max(5,concepto.length*4)+4;
 espacio(39);doc.setFillColor('#eff4f7');doc.roundedRect(left,y,width,30,3,3,'F');font(8,true,muted);doc.text('MONTO DEL PAGO RECIBIDO',left+6,y+8);
 let size=29;while(size>14){font(size,true);if(doc.getTextWidth(monto(c.importe))<140)break;size--;}
 font(size,true);doc.text(monto(c.importe),left+6,y+22);font(11,true,muted);doc.text(c.moneda,right-7,y+21,{align:'right'});y+=37;
 const medio=c.medio==='Transferencia'?'transferencia bancaria':c.medio.toLowerCase();const letras=importeEnLetrasRecibo(c.importe,c.moneda);
 texto(`Recibí de ${c.cliente} la suma de ${letras?letras+' ('+monto(c.importe)+')':c.moneda+' '+monto(c.importe)}, mediante ${medio}, en concepto de ${c.resumen?(parcial?'pago parcial':'cancelación del saldo'):'pago recibido'} por los trabajos correspondientes al presupuesto N.º ${c.presupuesto}.`,10);
 y+=4;
 if(c.resumen){espacio(47);font(8,true,muted);doc.text('RESUMEN DEL PAGO',left,y);y+=8;
 for(const [etiqueta,valor] of [['Monto total acordado',c.resumen.total],['Pagos anteriores',Math.max(0,Math.round((c.resumen.acumulado-c.importe)*100)/100)],['Pago recibido',c.importe]] as [string,number][]){font(10);doc.text(etiqueta,left,y);doc.text(monto(valor),right,y,{align:'right'});y+=7;}
 regla(y-3);y+=6;font(10,true);doc.text('SALDO PENDIENTE',left,y);font(15,true,color);doc.text(monto(c.resumen.saldo),right,y,{align:'right'});y+=9;
 if(parcial&&c.condicionPago?.trim()){
  const condicion=c.condicionPago.trim(),dias=condicion.match(/(?:pago a|a los|dentro de)\s*(\d+)\s*d[ií]as/i);
  if(dias&&/^\d{4}-\d{2}-\d{2}$/.test(c.fecha)){const d=new Date(c.fecha+'T12:00:00Z');d.setUTCDate(d.getUTCDate()+Number(dias[1]));texto(`El saldo pendiente deberá abonarse dentro de los ${Number(dias[1])} días corridos siguientes a la fecha de este comprobante, con vencimiento el ${fecha(d.toISOString().slice(0,10))}.`,9);}
  else if(/(?:al finalizar|a la finalizaci[oó]n)/i.test(condicion))texto('El saldo pendiente deberá abonarse al finalizar el trabajo, según lo acordado en el presupuesto.',9);
  else if(!/^(a convenir|contado)$/i.test(condicion))texto(`Condición de pago acordada: ${condicion}.`,9);
 }
 }
 if(c.nota.trim()){y+=3;texto(c.nota.trim(),9,muted);}
 y+=5;espacio(29);const base=y; font(8,true,muted);doc.text('Medio de pago',left,base+7);font(9);doc.text(c.medio==='Transferencia'?'Transferencia bancaria':c.medio,left,base+14);
 if(c.resumen){const label=parcial?'PAGADO PARCIALMENTE':'PAGADO',empresa=c.emisor.nombre.toUpperCase();doc.saveGraphicsState();const angle=5*Math.PI/180,cos=Math.cos(angle),sin=Math.sin(angle),cx=151,cy=base+11;
 const punto=(x:number,y:number)=>({x:cx+x*cos-y*sin,y:cy+x*sin+y*cos});
 const lineaSello=(x:number,y:number,xx:number,yy:number)=>{const a=punto(x,y),b=punto(xx,yy);doc.line(a.x,a.y,b.x,b.y);};
 doc.setDrawColor(color);doc.setLineWidth(.55);lineaSello(-40,-10,40,-10);lineaSello(40,-10,40,10);lineaSello(40,10,-40,10);lineaSello(-40,10,-40,-10);
 const estampar=(v:string,size:number,yy:number,bold:boolean)=>{font(size,bold,color);const a=punto(-doc.getTextWidth(v)/2,yy);doc.text(v,a.x,a.y,{angle:-5});};
 estampar(label,parcial?10:13,0,true);let firmaSize=7;let firmante=split(empresa+' · Emisor',73,firmaSize);while(firmante.length>2&&firmaSize>4){firmaSize-=.5;firmante=split(empresa+' · Emisor',73,firmaSize);}firmante.forEach((v,i)=>estampar(v,firmaSize,4+i*3,false));doc.restoreGraphicsState();}
 else {font(9,true,color);doc.text('PAGO RECIBIDO',right,base+12,{align:'right'});}y+=29;
 const total=doc.getNumberOfPages();for(let n=1;n<=total;n++){doc.setPage(n);dibujarMarcaComprobante(doc,marca);regla(276);font(7,false,muted);doc.text('Constancia de recepción de pago. No reemplaza la factura correspondiente.',left,282);
 if(perfil.es_premium!==true){font(6.5,false,muted);doc.text('Generado con MiOficio · www.mioficio.com.ar',right,290,{align:'right'});}else{font(7,false,muted);doc.text('Comprobante generado al registrar el cobro',left,289);}if(total>1)doc.text(`${n} / ${total}`,right,294,{align:'right'});}
 doc.setProperties({title:`Comprobante de pago ${c.numero}`,author:c.emisor.nombre,subject:`Presupuesto ${c.presupuesto}`,creator:'MiOficio'});return doc;
};

const crearPdfDevolucionCliente=async(p:Presupuesto,r:ReversionCobro,perfil:Perfil)=>{
 const doc=new jsPDF({unit:'mm',format:'a4'});doc.addFileToVFS('Roboto-Regular.ttf',ROBOTO_REGULAR_BASE64);doc.addFont('Roboto-Regular.ttf','Roboto','normal');doc.addFileToVFS('Roboto-Bold.ttf',ROBOTO_BOLD_BASE64);doc.addFont('Roboto-Bold.ttf','Roboto','bold');
 const c=r.comprobante,emisor=c?.emisor||{nombre:perfil.nombre_comercial||perfil.nombre||'Profesional',responsable:perfil.nombre||'',identificacion:perfil.cuit_cuil||'',email:perfil.email||'',telefono:perfil.telefono||''};
 const cliente=c?.cliente||p.cliente,presupuesto=c?.presupuesto||p.numero_presupuesto,numero=c?.numero||`DEV-${r.fecha.slice(0,4)}-${r.id.toUpperCase()}`;
 const antes=Number(c?.cobradoAntes),alcance=c&&Number.isFinite(antes)&&antes>0?(Math.round(r.importe*100)===Math.round(antes*100)?'total':'parcial'):'';
 const marca=await marcaComprobanteSegunPlan(perfil),l=18,right=192,w=174,ink='#192c3c',muted='#657582';let y=18;
 const font=(size=10,bold=false,color=ink)=>{doc.setFont('Roboto',bold?'bold':'normal');doc.setFontSize(size);doc.setTextColor(color);};
 const wrap=(s:string,width=w,size=10,bold=false)=>{font(size,bold);return doc.splitTextToSize(s,width) as string[];};
 const rule=(at:number)=>{doc.setDrawColor('#dde4e9');doc.setLineWidth(.25);doc.line(l,at,right,at);};
 const room=(h:number)=>{if(y+h>265){doc.addPage();font(10,true);doc.text('COMPROBANTE DE DEVOLUCIÓN',l,22);font(8);doc.text(numero,right,22,{align:'right'});rule(27);y=36;}};
 const text=(s:string,size=10)=>{for(const line of wrap(s,w,size)){room(5.2);font(size);doc.text(line,l,y);y+=5.2;}};
 const fecha=(r.fecha_devolucion||r.fecha).split('-').reverse().join('/');
 y=encabezadoComprobante(doc,emisor.nombre,[emisor.identificacion?'CUIT / identificación: '+emisor.identificacion:'',[emisor.telefono,emisor.email].filter(Boolean).join(' · ')]);
 font(19,true);doc.text('COMPROBANTE DE DEVOLUCIÓN',l,y);y+=8;
 const refs=wrap('N.º '+numero,120,9,true);font(9,true);doc.text(refs,l,y,{lineHeightFactor:1.2});font(9);doc.text('Fecha: '+fecha,right,y,{align:'right'});y+=refs.length*4.5+5;rule(y);y+=9;
 font(8,true,muted);doc.text('DEVUELTO A',l,y);doc.text('PRESUPUESTO ASOCIADO',108,y);y+=7;
 const nom=wrap(cliente,82,11,true),pres=wrap(presupuesto,84,11,true);font(11,true);doc.text(nom,l,y,{lineHeightFactor:1.2});doc.text(pres,108,y,{lineHeightFactor:1.2});y+=Math.max(nom.length,pres.length)*5+10;
 const moneda=c?.moneda||p.moneda||'ARS',importe='$ '+Number(r.importe).toLocaleString('es-AR',{minimumFractionDigits:2,maximumFractionDigits:2});room(38);doc.setFillColor('#eff4f7');doc.roundedRect(l,y,w,30,3,3,'F');font(8,true,muted);doc.text('IMPORTE DEVUELTO',l+6,y+8);
 let size=27;while(size>13){font(size,true);if(doc.getTextWidth(importe)<140)break;size--;}doc.text(importe,l+6,y+22);font(11,true,muted);doc.text(moneda,right-7,y+21,{align:'right'});y+=41;
 text(`Se deja constancia de que ${emisor.nombre} devolvió a ${cliente} el importe indicado, mediante ${(r.medio_devolucion||'medio no informado').toLowerCase()}, correspondiente al presupuesto N.º ${presupuesto}.`);y+=5;
 font(9,true);doc.text(alcance?'DEVOLUCIÓN '+alcance.toUpperCase():'DEVOLUCIÓN REGISTRADA',l,y);y+=9;
 if(r.referencia_devolucion?.trim()){text('Referencia: '+r.referencia_devolucion.trim(),9);y+=4;}
 if(r.motivo?.trim()){font(8,true,muted);doc.text('MOTIVO DE LA DEVOLUCIÓN',l,y);y+=6;text(r.motivo.trim(),10);y+=4;}
 const giver=wrap(emisor.responsable||emisor.nombre,73,9),receiver=wrap(cliente,73,9);room(38+Math.max(giver.length,receiver.length)*4.5);y+=25;rule(y-17);doc.setDrawColor('#c8d1d8');doc.line(l,y,l+73,y);doc.line(right-73,y,right,y);font(8,false,muted);doc.text('Firma de quien devuelve',l,y+5);doc.text('Firma de quien recibe',right-73,y+5);font(9);doc.text(giver,l,y+11,{lineHeightFactor:1.2});doc.text(receiver,right-73,y+11,{lineHeightFactor:1.2});
 const pages=doc.getNumberOfPages();for(let i=1;i<=pages;i++){doc.setPage(i);dibujarMarcaComprobante(doc,marca);rule(276);font(7,false,muted);doc.text('Constancia de devolución de dinero. No reemplaza la factura correspondiente.',l,282);if(perfil.es_premium!==true)doc.text('Generado con MiOficio · www.mioficio.com.ar',l,289);if(pages>1)doc.text(`${i} / ${pages}`,right,289,{align:'right'});}
 doc.setProperties({title:`Comprobante de devolución ${numero}`,subject:`Presupuesto ${presupuesto}`,author:emisor.nombre,creator:'MiOficio'});return doc;
};
const crearPdfReversion=async(p:Presupuesto,r:ReversionCobro,perfil:Perfil)=>r.tipo==='devolucion'?crearPdfDevolucionCliente(p,r,perfil):crearPdfCorreccionInterna(p,r,perfil);
const crearPdfCorreccionInterna=async(p:Presupuesto,r:ReversionCobro,perfil:Perfil)=>{
  const doc=new jsPDF({unit:'mm',format:'a4'});
  doc.addFileToVFS('Roboto-Regular.ttf',ROBOTO_REGULAR_BASE64);doc.addFont('Roboto-Regular.ttf','Roboto','normal');doc.addFileToVFS('Roboto-Bold.ttf',ROBOTO_BOLD_BASE64);doc.addFont('Roboto-Bold.ttf','Roboto','bold');
  const devolucion=r.tipo==='devolucion',c=r.comprobante;
  const numero=c?.numero||`REV-${r.fecha.slice(0,4)}-${r.id.toUpperCase()}`;
  const emisor=c?.emisor||{nombre:perfil.nombre_comercial||perfil.nombre||'Profesional',identificacion:perfil.cuit_cuil||'',email:perfil.email||'',telefono:perfil.telefono||'',domicilio:perfil.direccion||'',condicionFiscal:perfil.condicion_iva||'',responsable:perfil.nombre||''};
  const cliente=c?.cliente||p.cliente,documentoCliente=c?c.documentoCliente:p.cuit_cuil;
  const presupuesto=c?.presupuesto||p.numero_presupuesto;
  const titulo=devolucion?'Comprobante de devolución':'Constancia de reversión';
  const purple='#6244e8',ink='#231f38',muted='#776f87',ruleColor='#e7e3ef';
  const money=(n:number)=>`${c?.moneda||p.moneda||'ARS'} $ ${n.toLocaleString('es-AR',{minimumFractionDigits:2,maximumFractionDigits:2})}`;
  const fecha=(value:string)=>/^\d{4}-\d{2}-\d{2}$/.test(value)?value.split('-').reverse().join('/'):value;
  const font=(size=10,bold=false,color=ink)=>{doc.setFont('Roboto',bold?'bold':'normal');doc.setFontSize(size);doc.setTextColor(color);};
  const split=(value:string,width:number,size=10,bold=false)=>{font(size,bold);return doc.splitTextToSize(String(value),width) as string[];};
  const write=(lines:string[],x:number,y:number,size=10,bold=false,color=ink,lineHeight=5)=>{font(size,bold,color);lines.forEach((line,i)=>doc.text(line,x,y+i*lineHeight));return lines.length*lineHeight;};
  const headerRule=(at:number)=>{doc.setDrawColor(ruleColor);doc.setLineWidth(.25);doc.line(18,at,192,at);};
  // The issuer is the professional's business. MiOficio appears only in the footer.
  doc.setDrawColor(purple);doc.setLineWidth(1.1);doc.line(18,17,192,17);
  const marca=await marcaComprobanteSegunPlan(perfil);
  let leftY=27;leftY+=write(split(emisor.nombre.slice(0,180),94,12,true),18,leftY,12,true,ink,5.4);leftY+=1;
  if(emisor.identificacion)leftY+=write(split(`CUIT / identificación: ${emisor.identificacion}`,94,8.5),18,leftY,8.5,false,muted,4.3);
  if(emisor.condicionFiscal)leftY+=write(split(emisor.condicionFiscal,94,8.5),18,leftY,8.5,false,muted,4.3);
  if(emisor.domicilio)leftY+=write(split(emisor.domicilio.slice(0,180),94,8.5),18,leftY,8.5,false,muted,4.3);
  if(emisor.email||emisor.telefono)leftY+=write(split([emisor.email,emisor.telefono].filter(Boolean).join(' · '),94,8.5),18,leftY,8.5,false,muted,4.3);
  let rightY=27;font(9,true,purple);doc.text(devolucion?'DEVOLUCIÓN DE DINERO':'REVERSIÓN DE COBRO',192,rightY,{align:'right'});rightY+=8;
  font(15,true);doc.text('Comprobante',192,rightY,{align:'right'});rightY+=7;
  const refs=split(`N.º ${numero}`,74,7.6);font(7.6,false,muted);refs.forEach(line=>{doc.text(line,192,rightY,{align:'right'});rightY+=4;});rightY+=2;
  font(9,false,muted);doc.text(`Emisión: ${fecha(r.fecha)}`,192,rightY,{align:'right'});rightY+=6;
  let y=Math.max(60,leftY+5,rightY+4);headerRule(y);y+=9;
  const continued=()=>{doc.addPage();font(9,true,purple);doc.text(titulo,18,18);font(7.5,false,muted);doc.text(numero,192,18,{align:'right'});headerRule(22);y=31;};
  const ensure=(h:number)=>{if(y+h>266)continued();};
  const paragraph=(value:string,size=10,bold=false,color=ink,width=174,x=18,lineHeight=5)=>{const lines=split(value,width,size,bold);for(const line of lines){ensure(lineHeight+1);font(size,bold,color);doc.text(line,x,y);y+=lineHeight;}};
  const section=(label:string)=>{ensure(13);font(10.5,true);doc.text(label,18,y);y+=7;};
  font(8,true,muted);doc.text('CLIENTE',18,y);doc.text('PRESUPUESTO ASOCIADO',119,y);y+=6;
  const nombres=split(cliente,92,12,true),refsPresupuesto=split(presupuesto,73,11,true);
  write(nombres,18,y,12,true,ink,5.4);write(refsPresupuesto,119,y,11,true,ink,5.4);
  y+=Math.max(nombres.length,refsPresupuesto.length)*5.4;
  if(documentoCliente){font(8.5,false,muted);doc.text(`CUIT / DNI: ${documentoCliente}`,18,y+1);y+=5;}
  y+=5;
  ensure(37);doc.setFillColor('#f5f2ff');doc.setDrawColor('#e7e0ff');doc.setLineWidth(.25);doc.roundedRect(18,y,174,31,2,2,'FD');
  font(8.5,true,muted);doc.text(devolucion?'IMPORTE DEVUELTO':'IMPORTE REVERTIDO',24,y+8);
  let amountSize=23;while(amountSize>13){font(amountSize,true);if(doc.getTextWidth(money(r.importe))<=96)break;amountSize--;}
  font(amountSize,true,ink);doc.text(money(r.importe),24,y+23);
  if(devolucion){font(8,false,muted);doc.text('MEDIO DE DEVOLUCIÓN',131,y+8);font(11,true,purple);doc.text(r.medio_devolucion||'Sin informar',131,y+15);font(8.5,false,muted);doc.text(fecha(r.fecha_devolucion||r.fecha),131,y+23);}
  y+=39;
  if(devolucion&&r.referencia_devolucion){font(8.5,true,muted);doc.text(r.medio_devolucion==='Cheque'?'CHEQUE / REFERENCIA':'REFERENCIA DE LA OPERACIÓN',18,y);y+=5;paragraph(r.referencia_devolucion,9);y+=3;}
  section(devolucion?'Motivo y alcance de la devolución':'Motivo de la corrección');paragraph(r.motivo||'Reversión registrada.',10,false,ink,174,18,5.2);y+=5;
  if(c){ensure(52);headerRule(y);y+=9;section(devolucion?'Resumen del acuerdo vigente':'Resumen del presupuesto');
    const rows:[string,number][]=[];
    if(devolucion&&c.totalAnterior!==undefined)rows.push(['Total acordado anterior',c.totalAnterior]);
    rows.push([devolucion?'Nuevo total acordado':'Total del presupuesto',c.total]);
    if(!devolucion)rows.push(['Cobrado antes de la corrección',c.cobradoAntes]);
    rows.push([devolucion?'Cobrado neto que conserva el negocio':'Cobrado después de la corrección',c.cobradoDespues],['Saldo pendiente del cliente',c.saldoDespues]);
    rows.forEach(([label,value],i)=>{ensure(9);const last=i===rows.length-1;if(last){doc.setFillColor('#f5f2ff');doc.roundedRect(18,y-5.8,174,9,1,1,'F');}font(9.5,last,last?purple:muted);doc.text(label,22,y);font(10.5,true,last?purple:ink);doc.text(money(value),188,y,{align:'right'});if(!last){doc.setDrawColor('#eeebf3');doc.line(22,y+3.2,188,y+3.2);}y+=9;});y+=6;
  }
  // The client-facing refund receipt refers to the quotation; payment allocation remains in the app's audit history.
  if(!devolucion){const pagos=Object.values(r.cobros||{});if(pagos.length){section('Cobros que se corrigieron');for(const pago of pagos){const lines=split(`${fecha(pago.fecha)} · ${pago.medio}`,108,9);ensure(lines.length*4.5+4);write(lines,18,y,9,false,muted,4.5);font(9.5,true);doc.text(money(pago.importe),192,y,{align:'right'});y+=lines.length*4.5+4;}y+=5;}}
  if(devolucion){const firmaEmisor=split(emisor.responsable||emisor.nombre,72,8),firmaCliente=split(cliente,72,8);ensure(38+Math.max(firmaEmisor.length,firmaCliente.length)*4);y+=6;font(8.5,false,muted);doc.text('Constancia de entrega y recepción',18,y);y+=20;
    doc.setDrawColor('#bcb4ca');doc.setLineWidth(.25);doc.line(22,y,94,y);doc.line(116,y,188,y);y+=5;
    font(8.5,true);doc.text('Firma de quien entrega',58,y,{align:'center'});doc.text('Firma de quien recibe',152,y,{align:'center'});y+=5;
    font(8,false,muted);firmaEmisor.forEach((line,i)=>doc.text(line,58,y+i*4,{align:'center'}));firmaCliente.forEach((line,i)=>doc.text(line,152,y+i*4,{align:'center'}));
  }
  const paginas=doc.getNumberOfPages();for(let i=1;i<=paginas;i++){doc.setPage(i);dibujarMarcaComprobante(doc,marca);headerRule(277);font(7.2,false,muted);doc.text(devolucion?'Registro de devolución informado por el profesional. No constituye factura.':'Constancia interna de corrección de cobro. No constituye factura.',18,282);font(7.5,false,muted);doc.text(`${i} / ${paginas}`,192,288,{align:'right'});}
  doc.setProperties({title:`${titulo} ${numero}`,subject:`Presupuesto ${presupuesto}`,author:emisor.nombre,creator:'MiOficio'});return doc;
};

interface ComprobanteEntrega { firmaDigital?:FirmaDigitalDocumento;importeRecibido?:number;partidas?:PartidaEntrega[];clienteDocumento?:string;clienteContacto?:string;condicionesPresupuesto?:{formaPago:string;plazo:string;validez:number;adicionales:string;descuento:number};rubro?:string;contexto?:string;importePresupuesto?:number;monedaPresupuesto?:string;id:string;numero:string;presupuestoNumero:string;cliente:string;domicilio:string;fecha:string;detalle:string;observaciones:string;garantia:string;recibe:string;creadoAt:number;emisor:{nombre:string;identificacion:string;contacto:string;logo:string}; }
const textosEntregaRubro=(rubro='')=>{
  const r=rubro.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
  const base={titulo:'Trabajo realizado',detalle:'Detalle del trabajo realizado',fecha:'Fecha de finalización',lugar:'Lugar del trabajo',contexto:'Datos del trabajo',introduccion:'Se deja constancia de los trabajos realizados conforme al presupuesto de referencia:'};
  if(/nautic|embarcacion|naval|lancha|velero|barco/.test(r))return {...base,contexto:'Embarcación y datos técnicos',introduccion:'Se deja constancia de los trabajos náuticos realizados conforme al presupuesto de referencia:'};
  if(/automotor|mecanic|vehiculo|gomer|chapa/.test(r))return {...base,contexto:'Vehículo y datos de la intervención',introduccion:'Se deja constancia de los trabajos realizados sobre el vehículo conforme al presupuesto de referencia:'};
  if(/construccion|obra|albanil|pintor|pintura|plomer|gasist|electric|clima|carpint|herrer/.test(r))return {...base,contexto:'Obra, instalación o sector intervenido'};
  if(/agro|rural|campo/.test(r))return {...base,contexto:'Establecimiento, equipo o tarea rural',introduccion:'Se deja constancia de las tareas rurales realizadas conforme al presupuesto de referencia:'};
  if(/comercio|venta|minorista|mayorista|producto/.test(r))return {...base,titulo:'Entrega de productos',detalle:'Productos entregados',fecha:'Fecha de entrega',lugar:'Lugar de entrega',contexto:'Datos de la entrega',introduccion:'Se deja constancia de la entrega de los productos detallados en el presupuesto de referencia:'};
  if(/software|informat|tecnolog|\bit\b|diseno|marketing|fotograf|audiovisual/.test(r))return {...base,titulo:'Entrega de servicio',detalle:'Servicios y entregables',fecha:'Fecha de entrega',lugar:'Lugar o modalidad de entrega',contexto:'Proyecto y especificaciones',introduccion:'Se deja constancia de los servicios prestados y los entregables correspondientes al presupuesto de referencia:'};
  if(/logistica|transporte|flete|mudanza/.test(r))return {...base,titulo:'Servicio de traslado',detalle:'Servicio de traslado realizado',fecha:'Fecha del servicio',lugar:'Lugar de prestación o entrega',contexto:'Datos del traslado',introduccion:'Se deja constancia del servicio de traslado realizado conforme al presupuesto de referencia:'};
  if(/gastronom|catering|comida|evento/.test(r))return {...base,titulo:'Servicio realizado',detalle:'Servicio y entregas realizados',fecha:'Fecha del servicio',lugar:'Lugar del servicio',contexto:'Evento y alcance del servicio',introduccion:'Se deja constancia del servicio realizado y las entregas detalladas en el presupuesto de referencia:'};
  if(/salud|laboratorio|profesional|legal|contab|gestor|consult|asesor/.test(r))return {...base,titulo:'Servicio prestado',detalle:'Servicios prestados',fecha:'Fecha del servicio',lugar:'Lugar o modalidad del servicio',contexto:'Alcance del servicio',introduccion:'Se deja constancia de los servicios prestados conforme al presupuesto de referencia:'};
  if(/limpieza|mantenimiento/.test(r))return {...base,contexto:'Espacio, equipo y alcance de las tareas',introduccion:'Se deja constancia de las tareas de limpieza o mantenimiento realizadas conforme al presupuesto de referencia:'};
  return base;
};
const autocompletarEntrega=(p:Presupuesto,rubroAlternativo='')=>{
  const rubro=p.rubro?.trim()||rubroAlternativo;
  const t=textosEntregaRubro(rubro);
  const items=(p.items||[]).filter(i=>i.descripcion?.trim()).map(i=>{const cantidad=Number(i.cantidad);return `• ${i.descripcion.trim()}${cantidad>0?` (${cantidad.toLocaleString('es-AR')} ${abreviarUnidadPresupuesto(i.unidad)})`:''}`;});
  const notasAdicionales=p.incluir_nota===false?'':(p.notas_adicionales?.trim()||(p.notas||'').match(/Nota adicional:\s*([\s\S]*)/i)?.[1]?.trim()||'');
  const contexto=p.incluir_especificaciones===false?'':(p.especificaciones?.trim()||(p.notas||'').replace(/(?:\n|^)Nota adicional:[\s\S]*/i,'').trim());
  return {rubro,cliente:p.cliente||'',domicilio:p.direccion_obra||'',contexto,detalle:items.length?`${t.introduccion}\n\n${items.join('\n')}`:p.tipo_proyecto?.trim()?`${t.introduccion}\n\n${p.tipo_proyecto.trim()}`:'',observaciones:notasAdicionales,garantia:p.incluir_condiciones===false?'':p.garantia||'',recibe:p.cliente||''};
};
type EstadoPartidaEntrega='realizado'|'no_realizado'|'';
interface PartidaEntrega {descripcion:string;cantidad:number;unidad:string;precioUnitario:number;bonificacion:number;iva:number;importe:number;estado:EstadoPartidaEntrega;}
const partidasEntregaPresupuesto=(p:Presupuesto,estados:EstadoPartidaEntrega[]):PartidaEntrega[]=>(p.items||[]).map((i,index)=>({descripcion:i.descripcion||'Ítem sin descripción',cantidad:Number(i.cantidad)||0,unidad:abreviarUnidadPresupuesto(i.unidad),precioUnitario:Number(i.precio_unitario)||0,bonificacion:Number(i.bonificacion)||0,iva:Number(i.iva??21)||0,importe:calcularItemPresupuesto(i).total,estado:estados[index]||''}));
const resumenPartidasEntrega=(partidas:PartidaEntrega[])=>['realizado','no_realizado'].map(estado=>{const items=partidas.filter(i=>i.estado===estado);return items.length?`${estado==='realizado'?'Realizado / entregado':'No realizado / no entregado'}:\n${items.map(i=>`• ${i.descripcion} (${i.cantidad} ${i.unidad})`).join('\n')}`:'';}).filter(Boolean).join('\n\n');
interface FirmaDigitalDocumento { tipo?:'imagen'|'nombre'|'certificado';pdfBase64:string;firmante:string;certificadoSerie:string;fecha:string;sha256:string; }
const blobFirmaDigital=(firma:FirmaDigitalDocumento)=>{const raw=atob(firma.pdfBase64),bytes=new Uint8Array(raw.length);for(let i=0;i<raw.length;i++)bytes[i]=raw.charCodeAt(i);return new Blob([bytes],{type:'application/pdf'});};
const descargarPdfFirmado=(firma:FirmaDigitalDocumento,numero:string)=>{const url=URL.createObjectURL(blobFirmaDigital(firma)),a=document.createElement('a');a.href=url;a.download=`MiOficio-${numero}-firmado.pdf`;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),60000);};
async function imagenFirmaPremium(file:File):Promise<string>{
 if(file.size>5*1024*1024||!['image/png','image/jpeg','image/webp','image/gif','image/bmp','image/x-ms-bmp'].includes(file.type))throw new Error('Subí una imagen PNG, JPG, WEBP, GIF o BMP de hasta 5 MB.');
 const image=await createImageBitmap(file);try{if(!image.width||!image.height||image.width*image.height>12000000)throw new Error('Usá una imagen de hasta 12 megapíxeles.');const k=Math.min(1,1400/image.width,500/image.height),canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(image.width*k));canvas.height=Math.max(1,Math.round(image.height*k));const ctx=canvas.getContext('2d');if(!ctx)throw new Error('No se pudo preparar la firma.');ctx.drawImage(image,0,0,canvas.width,canvas.height);return canvas.toDataURL('image/png');}finally{image.close();}
}
type ModoFirmaAutomatica='ninguna'|'imagen'|'nombre';
function modoFirmaPerfil(perfil:Perfil):ModoFirmaAutomatica{
 const modo=perfil.firma_automatica;
 if(modo==='imagen'||modo==='nombre'||modo==='ninguna')return modo;
 return !modo&&perfil.firma_imagen?.png?'imagen':'ninguna';
}
function archivarFirma(bytes:Uint8Array,datos:{firmante:string;certificadoSerie:string;fecha:string;sha256:string},tipo:'imagen'|'nombre'):FirmaDigitalDocumento{let binary='';for(let i=0;i<bytes.length;i+=8192)binary+=String.fromCharCode(...bytes.subarray(i,i+8192));return {...datos,tipo,pdfBase64:btoa(binary)};}
async function firmarEntregaAutomatica(entrega:ComprobanteEntrega,perfil:Perfil):Promise<FirmaDigitalDocumento>{
 if(perfil.es_premium!==true)throw new Error('La firma del profesional está incluida en Premium.');
 const modo=modoFirmaPerfil(perfil),imagen=modo==='imagen'?perfil.firma_imagen?.png:'',firmante=(perfil.firma_imagen?.nombre||'').trim();
 if(modo==='ninguna'||(modo==='imagen'&&!imagen)||(modo==='nombre'&&!firmante))throw new Error('Completá la firma del profesional en Premium.');
 const doc=await crearPdfEntregaProfesional(entrega,perfil),punto=puntosFirmaTrabajo.get(doc)||{x:18,y:239};doc.setPage(doc.getNumberOfPages());
 if(imagen){const props=doc.getImageProperties(imagen),scale=Math.min(68/props.width,16/props.height);doc.addImage(imagen,'PNG',punto.x+(73-props.width*scale)/2,punto.y-2-props.height*scale,props.width*scale,props.height*scale);}
 if(firmante){doc.setFont('Roboto','normal');doc.setTextColor('#192f3f');let size=imagen?8:12;doc.setFontSize(size);let lines=doc.splitTextToSize(firmante,73) as string[];while(lines.length>2&&size>6){size-=.5;doc.setFontSize(size);lines=doc.splitTextToSize(firmante,73) as string[];}const alto=size*.3528*1.15;doc.text(lines,punto.x,imagen?punto.y+10:punto.y-3-(lines.length-1)*alto,{lineHeightFactor:1.15});}
 const bytes=new Uint8Array(doc.output('arraybuffer'));const sha256=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',bytes))).map(b=>b.toString(16).padStart(2,'0')).join('');return archivarFirma(bytes,{firmante,certificadoSerie:'',fecha:new Date().toISOString(),sha256},modo==='imagen'?'imagen':'nombre');
}
function ConfiguracionFirmaPremium({perfil,onCerrar,onGuardar,onVerificar}:{perfil:Perfil;onCerrar:()=>void;onGuardar:(png:string,nombre:string,modo:ModoFirmaAutomatica)=>Promise<void>;onVerificar:()=>Promise<void>}){
 const [modo,setModo]=useState<ModoFirmaAutomatica>(modoFirmaPerfil(perfil)),[png,setPng]=useState(perfil.firma_imagen?.png||''),[nombre,setNombre]=useState(perfil.firma_imagen?.nombre||perfil.nombre||''),[ocupado,setOcupado]=useState(false),[error,setError]=useState(''),[leyendo,setLeyendo]=useState(false);
 const dialog=useRef<HTMLDialogElement|null>(null),lock=useRef(false),carga=useRef(0),archivo=useRef<HTMLInputElement|null>(null);
 useEffect(()=>{dialog.current?.showModal();return()=>{carga.current++;};},[]);
 const elegir=async(file?:File)=>{if(!file)return;const n=++carga.current;setLeyendo(true);setError('');try{const imagen=await imagenFirmaPremium(file);if(n===carga.current)setPng(imagen);}catch(e){if(n===carga.current)setError(e instanceof Error?e.message:'No se pudo cargar la imagen.');}finally{if(n===carga.current)setLeyendo(false);}};
 const guardar=async(e:FormEvent)=>{e.preventDefault();if(lock.current||leyendo)return;lock.current=true;setOcupado(true);setError('');const uid=auth.currentUser?.uid;try{
 if(modo==='imagen'&&!png)throw new Error('Subí la imagen de tu firma.');
 if(modo==='nombre'&&!nombre.trim())throw new Error('Escribí el nombre del firmante.');
 await onVerificar();if(!uid||auth.currentUser?.uid!==uid)throw new Error('Iniciá sesión nuevamente.');
 await onGuardar(png,nombre.trim(),modo);onCerrar();
 }catch(e){setError(e instanceof Error?e.message:'No se pudo guardar la firma.');}finally{lock.current=false;setOcupado(false);}};
 const btn:CSSProperties={padding:'11px 14px',border:'1px solid #e2d9ef',borderRadius:10,background:'#f5efff',color:'#6244e8',fontSize:14,fontWeight:600,cursor:'pointer',minWidth:0};
 const input:CSSProperties={padding:11,width:'100%',minWidth:0,boxSizing:'border-box',border:'1px solid #e2d9ef',borderRadius:9,fontSize:16,background:'#fff',color:'#30283f'};
 return createPortal(<dialog className="firma-premium-config" ref={dialog} aria-labelledby="firma-premium-titulo" onCancel={e=>{e.preventDefault();if(!lock.current)onCerrar();}} style={{padding:22,width:510,maxWidth:'calc(100vw - 24px)',maxHeight:'calc(100dvh - 24px)',overflow:'auto',boxSizing:'border-box',border:'1px solid #e6deef',borderRadius:18,color:'#231f38',background:'#fff'}}><header style={{display:'flex',justifyContent:'space-between',gap:12,alignItems:'start'}}><div><small style={{color:'#6244e8',fontWeight:600}}>Tu membresía Premium</small><h2 id="firma-premium-titulo" style={{fontSize:22,margin:'6px 0 12px'}}>Firma del profesional</h2></div><button type="button" aria-label="Cerrar firmas de comprobantes" disabled={ocupado||leyendo} style={{...btn,padding:8,width:36,height:36,flexShrink:0}} onClick={onCerrar}>×</button></header><p style={{fontSize:14,color:'#776f87',margin:'0 0 16px',lineHeight:1.5}}>Guardala una vez. Se agrega automáticamente a tus nuevos comprobantes de trabajo.</p><form onSubmit={guardar} style={{display:'grid',gridTemplateColumns:'minmax(0,1fr)',gap:14,minWidth:0}}><div style={{display:'grid',gap:7}}><label htmlFor="firma-profesional-tipo">Cómo querés firmar</label><select id="firma-profesional-tipo" style={input} value={modo} disabled={ocupado||leyendo} onChange={e=>{setModo(e.target.value as ModoFirmaAutomatica);setError('');}}><option value="ninguna">A mano, al imprimir</option><option value="imagen">Imagen de mi firma</option><option value="nombre">Solo mi nombre</option></select></div>
 {modo==='imagen'&&<><input ref={archivo} aria-label="Archivo de firma" type="file" style={{display:'none'}} accept="image/png,image/jpeg,image/webp,image/gif,image/bmp,image/x-ms-bmp" disabled={ocupado||leyendo} onChange={e=>void elegir(e.target.files?.[0])}/><div style={{display:'flex',gap:8,alignItems:'center',flexWrap:'wrap'}}><button type="button" style={btn} disabled={ocupado||leyendo} onClick={()=>archivo.current?.click()}>{png?'Cambiar imagen':'Subir firma'}</button><small style={{color:'#776f87'}}>PNG, JPG, WEBP, GIF o BMP · Hasta 5 MB</small></div>{leyendo&&<span role="status">Preparando imagen…</span>}{png&&<div style={{display:'flex',justifyContent:'flex-end'}}><button type="button" style={{...btn,padding:'4px 0',border:0,background:'none',fontSize:12}} disabled={ocupado||leyendo} onClick={()=>{setPng('');setModo(nombre.trim()?'nombre':'ninguna');if(archivo.current)archivo.current.value='';}}>Quitar imagen</button></div>}</>}
 {modo!=='ninguna'&&<div style={{display:'grid',gap:7}}><label htmlFor="firma-profesional-nombre">Nombre del firmante{modo==='imagen'?' (opcional)':''}</label><input id="firma-profesional-nombre" value={nombre} maxLength={100} required={modo==='nombre'} style={input} disabled={ocupado||leyendo} onChange={e=>setNombre(e.target.value)} placeholder="Nombre y apellido"/></div>}
 <section aria-label="Vista previa de la firma" style={{padding:'16px 18px',background:'#faf9fd',border:'1px solid #e8e2f1',borderRadius:12,minWidth:0}}><small style={{display:'block',color:'#847b92',marginBottom:12}}>Así se verá en el comprobante</small><div style={{minHeight:60,display:'flex',alignItems:'end',paddingBottom:9,minWidth:0}}>{modo==='imagen'&&png?<img src={png} alt="Firma guardada en Premium" style={{width:'100%',maxHeight:65,objectFit:'contain',objectPosition:'left bottom'}}/>:modo==='nombre'?<span style={{fontSize:20,overflowWrap:'anywhere',lineHeight:1.25}}>{nombre.trim()||'Tu nombre y apellido'}</span>:null}</div><div style={{borderTop:'1px solid #cfd4db',paddingTop:7}}><small style={{color:'#847b92'}}>Firma y aclaración del profesional</small>{modo==='imagen'&&nombre.trim()&&<span style={{display:'block',fontSize:13,marginTop:5,overflowWrap:'anywhere'}}>{nombre.trim()}</span>}</div></section>
 {modo==='ninguna'?<p style={{margin:0,fontSize:13,color:'#776f87'}}>Se deja el espacio libre para firmar y aclarar a mano.</p>:<label style={{display:'flex',gap:8,alignItems:'start',fontSize:13,lineHeight:1.4}}><input type="checkbox" required disabled={ocupado||leyendo} style={{accentColor:'#6244e8',marginTop:3}}/>Autorizo agregar esta firma a los comprobantes de trabajo que genere.</label>}
 {error&&<p role="alert" style={{color:'#b42335',margin:0,fontSize:14}}>{error}</p>}<button type="submit" style={{...btn,background:'#6244e8',color:'#fff'}} disabled={ocupado||leyendo}>{ocupado?'Guardando…':'Guardar firma'}</button></form></dialog>,document.body);
}
const puntosFirmaTrabajo=new WeakMap<jsPDF,{x:number;y:number}>();

const crearPdfEntregaDetallada=async(e:ComprobanteEntrega,perfil:Perfil)=>{
 const doc=new jsPDF({unit:'mm',format:'a4'});doc.addFileToVFS('Roboto-Regular.ttf',ROBOTO_REGULAR_BASE64);doc.addFont('Roboto-Regular.ttf','Roboto','normal');doc.addFileToVFS('Roboto-Bold.ttf',ROBOTO_BOLD_BASE64);doc.addFont('Roboto-Bold.ttf','Roboto','bold');
 const ink='#192f3f',muted='#74838f',line='#dce5e9',l=18,r=192,w=174;let y=18;
 const font=(size=10,bold=false,col=ink)=>{doc.setFont('Roboto',bold?'bold':'normal');doc.setFontSize(size);doc.setTextColor(col);};
 const wrap=(s:string,width=w,size=10,bold=false)=>{font(size,bold);return doc.splitTextToSize(s||'',width) as string[];};
 const rule=(at:number)=>{doc.setDrawColor(line);doc.setLineWidth(.25);doc.line(l,at,r,at);};
 const siguiente=()=>{throw new Error('El contenido supera una hoja. Abrí Elegir trabajos para incluir y seleccioná los de esta constancia, o acortá la aclaración. No se guardó el comprobante.');};
 const room=(h:number)=>{if(y+h>236)siguiente();};
 const texto=(s:string,size=10)=>{for(const a of wrap(s,w,size)){room(4.5);font(size);doc.text(a,l,y);y+=4.5;}};
 const seccion=(s:string)=>{room(10);font(8,true,muted);doc.text(s,l,y);y+=3;};
 const marca=await marcaComprobanteSegunPlan({...perfil,logo_url:e.emisor.logo||perfil.logo_url});
 y=encabezadoComprobante(doc,e.emisor.nombre,[e.emisor.identificacion?'CUIT / identificación: '+e.emisor.identificacion:'',e.emisor.contacto]);let tituloSize=16;while(tituloSize>11){font(tituloSize,true);if(doc.getTextWidth('COMPROBANTE DE TRABAJO REALIZADO')<=w)break;tituloSize--;}
 font(tituloSize,true);doc.text('COMPROBANTE DE TRABAJO REALIZADO',l,y);y+=8;const referencia=wrap('N.º '+e.numero,112,9,true);font(9,true);doc.text(referencia,l,y,{lineHeightFactor:1.2});font(9);doc.text('Fecha: '+e.fecha.split('-').reverse().join('/'),r,y,{align:'right'});y+=referencia.length*4.5+5;rule(y);y+=9;
 font(8,true,muted);doc.text('CLIENTE',l,y);doc.text('PRESUPUESTO ASOCIADO',108,y);y+=7;const cliente=wrap(e.cliente,83,11,true),pres=wrap(e.presupuestoNumero,84,11,true);font(11,true);doc.text(cliente,l,y,{lineHeightFactor:1.2});doc.text(pres,108,y,{lineHeightFactor:1.2});y+=Math.max(cliente.length,pres.length)*5+3;
 if(e.clienteDocumento){font(8,false,muted);doc.text('CUIT / DNI: '+e.clienteDocumento,l,y);y+=3;}
 if(e.domicilio.trim()){for(const a of wrap('Lugar: '+e.domicilio,w,9)){font(9,false,muted);doc.text(a,l,y);y+=3;}}y+=6;
 const realizadas=(e.partidas||[]).filter(i=>i.estado==='realizado'),pendientes=(e.partidas||[]).filter(i=>i.estado!=='realizado'),parcial=pendientes.length>0;
 room(34);doc.setFillColor('#eff4f7');doc.roundedRect(l,y,w,25,3,3,'F');font(8,true,muted);doc.text('MONTO ACORDADO DEL PRESUPUESTO',l+6,y+7);
 const moneda=e.monedaPresupuesto||'ARS',dinero=(n:number)=>'$ '+n.toLocaleString('es-AR',{minimumFractionDigits:2,maximumFractionDigits:2});let size=25;const monto=dinero(Number(e.importePresupuesto||0));while(size>13){font(size,true);if(doc.getTextWidth(monto)<98)break;size--;}
 font(size,true);doc.text(monto,l+6,y+19);font(9,true,muted);doc.text(moneda,117,y+19);font(8,true,parcial?'#a2762c':'#237855');doc.text(parcial?'TRABAJOS PARCIALES':'TRABAJOS COMPLETADOS',r-6,y+15,{align:'right'});y+=30;
 texto(`Se deja constancia de que el día ${e.fecha.split('-').reverse().join('/')} se realizaron para ${e.cliente} los trabajos detallados a continuación, correspondientes al presupuesto N.º ${e.presupuestoNumero}${parcial?'. Esta constancia comprende únicamente los trabajos indicados':''}.`,10);y+=4;
 const cabecera=()=>{room(18);doc.setFillColor('#eff4f7');doc.rect(l,y,w,8,'F');font(9,true);doc.text('Descripción',l+3,y+5.3);doc.text('Cant.',160,y+5.3,{align:'right'});doc.text('Unidad',r-3,y+5.3,{align:'right'});y+=8;};
 seccion('TRABAJOS REALIZADOS');cabecera();
 for(const i of realizadas){const desc=wrap(i.descripcion,120,9);const h=Math.max(7,desc.length*4+3);room(h);font(9);doc.text(desc,l+3,y+4.8,{lineHeightFactor:1.25});doc.text(String(i.cantidad),160,y+4.8,{align:'right'});doc.text(i.unidad||'UN',r-3,y+4.8,{align:'right'});y+=h;rule(y);}
 if(!e.partidas){texto(e.detalle,10);y+=3;}y+=7;
 if(pendientes.length){texto(`${pendientes.length===1?'Queda 1 trabajo del presupuesto sin incluir':'Quedan '+pendientes.length+' trabajos del presupuesto sin incluir'} en esta constancia.`,8);y+=3;}
 if(e.observaciones.trim()){seccion('OBSERVACIONES');texto(e.observaciones.trim(),9);y+=3;}
 if(e.garantia.trim()){seccion('GARANTÍA ACORDADA');texto(/^\d+$/.test(e.garantia.trim())?'Según las condiciones del presupuesto N.º '+e.presupuestoNumero+'.':e.garantia.trim(),9);y+=3;}
 if(y+24>264)siguiente();y=y+25;puntosFirmaTrabajo.set(doc,{x:l,y});doc.setDrawColor(line);doc.line(l,y,l+73,y);doc.line(r-73,y,r,y);font(8,false,muted);doc.text('Firma y aclaración del profesional',l,y+5);doc.text('Firma y aclaración de quien recibe',r-73,y+5);font(8);const nombre=wrap(e.recibe,73,8);doc.text(nombre,r-73,y+10,{lineHeightFactor:1.2});
 for(let n=1;n<=doc.getNumberOfPages();n++){doc.setPage(n);dibujarMarcaComprobante(doc,marca);rule(276);font(7,false,muted);doc.text('Constancia de los trabajos detallados. No acredita pagos ni reemplaza una factura.',l,282);if(perfil.es_premium!==true){font(7,true,'#3156dc');doc.text('Generado con MiOficio · www.mioficio.com.ar',l,289);}if(doc.getNumberOfPages()>1)doc.text(`${n} / ${doc.getNumberOfPages()}`,r,289,{align:'right'});}
 doc.setProperties({title:`Comprobante de trabajo ${e.numero}`,author:e.emisor.nombre,subject:`Presupuesto ${e.presupuestoNumero}`,creator:'MiOficio'});return doc;
};

const crearPdfEntregaProfesional=async(entrega:ComprobanteEntrega,perfil:Perfil)=>crearPdfEntregaDetallada(entrega,perfil);

interface TareaOrdenTrabajo { id:string; descripcion:string; cantidad:number; unidad:string; realizada:boolean; }
interface FotoOrdenTrabajo { id:string; nombre:string; datos:string; fecha:string; }
interface GastoOrdenTrabajo { id:string; concepto:string; importe:number; fecha:string; }
interface EventoOrdenTrabajo { id:string; texto:string; fecha:string; }
interface OrdenTrabajo {
  id:string; numero:string; presupuestoId:number; presupuestoNumero:string;
  cliente:string; titulo:string; moneda:string; montoAcordado:number;
  creadaAt:string; fechaProgramada:string; estado:'Pendiente'|'En curso'|'Terminado';
  tareas:TareaOrdenTrabajo[]; fotos:FotoOrdenTrabajo[]; gastos:GastoOrdenTrabajo[]; seguimiento:EventoOrdenTrabajo[];
}

interface Presupuesto {
  total_acordado?: number;
  fecha_aceptacion?: string;
  reversiones_cobros?: ReversionCobro[];
  entregas?: ComprobanteEntrega[];
  cobros?: CobroPresupuesto[];
  fecha_pago?: string;
  medio_pago_registrado?: string;
  fecha_recordatorio?: string;
  presupuesto_id: number;
  numero_presupuesto: string;
  cliente: string;
  condicion_iva_cliente?: string;
  cuit_cuil?: string;
  email?: string;
  telefono?: string;
  direccion_obra?: string;
  validez_dias: number;
  forma_pago: string;
  tiempo_ejecucion: string;
  garantia?: string;
  condiciones_adicionales?: string;
  incluir_condiciones_adicionales?: boolean;
  descuento: number;
  notas: string;
  notas_adicionales?: string;
  especificaciones?: string;
  incluir_especificaciones?: boolean;
  incluir_condiciones?: boolean;
  incluir_nota?: boolean;
  incluir_pago?: boolean;
  moneda: string;
  estado: string; 
  total: number;
  fecha: string;
  rubro?: string;
  tipo_proyecto?: string;
  items?: ItemPresupuesto[];
}

type ComprobanteCobroHub={tipo:'pago';p:Presupuesto;c:CobroPresupuesto;fecha:string;importe:number}|{tipo:'devolucion'|'correccion';p:Presupuesto;r:ReversionCobro;fecha:string;importe:number};
const listarComprobantesCobros=(lista:Presupuesto[]):ComprobanteCobroHub[]=>lista.flatMap((p):ComprobanteCobroHub[]=>{
  const pagos=new Map<string,CobroPresupuesto>();
  for(const c of Object.values(p.cobros||{}))if(Number(c.importe)>0)pagos.set(c.id,{...c});
  // Las devoluciones conservan el pago original en el historial: no se vuelve a registrar dinero.
  for(const r of Object.values(p.reversiones_cobros||{}))if(r.tipo==='devolucion')for(const c of Object.values(r.cobros||{})){
    const actual=pagos.get(c.id);pagos.set(c.id,{...c,...actual,importe:(Number(actual?.importe)||0)+(Number(c.importe)||0),comprobante_recibido:actual?.comprobante_recibido||c.comprobante_recibido});
  }
  if(!pagos.size&&cobradoPresupuesto(p)>0)pagos.set(`historico-${p.presupuesto_id}`,{id:`historico-${p.presupuesto_id}`,importe:cobradoPresupuesto(p),fecha:p.fecha_pago||p.fecha,medio:p.medio_pago_registrado||'',nota:'Pago histórico registrado como completo.',registradoAt:0});
  return [...Array.from(pagos.values(),c=>({tipo:'pago' as const,p,c,fecha:c.fecha,importe:c.comprobante_recibido?.importe??c.importe})),...Object.values(p.reversiones_cobros||{}).map(r=>({tipo:r.tipo==='devolucion'?'devolucion' as const:'correccion' as const,p,r,fecha:r.fecha_devolucion||r.fecha,importe:r.importe}))];
}).sort((a,b)=>b.fecha.localeCompare(a.fecha)||b.p.presupuesto_id-a.p.presupuesto_id);

// Informes: lectura agregada; no registra ni modifica cobros.
const movimientosFinancierosPresupuestos=(lista:Presupuesto[],moneda:string):{fecha:string;importe:number}[]=>{
  const iso=(f:string)=>/^\d{4}-\d{2}-\d{2}$/.test(String(f||''))?String(f).slice(0,10):'';
  const movimientos:{fecha:string;importe:number}[]=[];
  const presupuestosMoneda=lista.filter(p=>monedaPresupuesto(p.moneda)===moneda);
  for(const p of presupuestosMoneda){
    const cobros=Object.values(p.cobros||{});
    for(const c of cobros)if(iso(c.fecha)&&Number(c.importe)>0)movimientos.push({fecha:c.fecha,importe:Number(c.importe)});
    const historico=Math.max(0,cobradoPresupuesto(p)-cobros.reduce((n,c)=>n+Math.max(0,Number(c.importe)||0),0));
    if(historico>0&&iso(p.fecha_pago||p.fecha))movimientos.push({fecha:p.fecha_pago||p.fecha,importe:historico});
    for(const r of Object.values(p.reversiones_cobros||{}))if(r.tipo==='devolucion'){
      // Restituir el ingreso original y descontar la devolución en su fecha real.
      for(const c of Object.values(r.cobros||{}))if(iso(c.fecha)&&Number(c.importe)>0)movimientos.push({fecha:c.fecha,importe:Number(c.importe)});
      const fecha=r.fecha_devolucion||r.fecha;
      if(iso(fecha)&&Number(r.importe)>0)movimientos.push({fecha,importe:-Number(r.importe)});
    }
  }
  return movimientos;
};

const construirInformeNegocio=(lista:Presupuesto[],moneda:string,periodo:'mes'|'anio',clave:string)=>{
  const iso=(f:string)=>/^\d{4}-\d{2}-\d{2}$/.test(String(f||''))?String(f).slice(0,10):'';
  const fechaAnterior=periodo==='mes'?new Date(Date.UTC(Number(clave.slice(0,4)),Number(clave.slice(5,7))-2,1)).toISOString().slice(0,7):String(Number(clave)-1);
  const movimientos=movimientosFinancierosPresupuestos(lista,moneda);
  const presupuestosMoneda=lista.filter(p=>monedaPresupuesto(p.moneda)===moneda);
  const sumar=(prefijo:string)=>Math.round(movimientos.filter(m=>m.fecha.startsWith(prefijo)).reduce((n,m)=>n+m.importe,0)*100)/100;
  const ingresos=sumar(clave),anteriores=sumar(fechaAnterior);
  const emitidos=presupuestosMoneda.filter(p=>iso(p.fecha)&&p.fecha.startsWith(clave)&&!['Borrador','Cancelado'].includes(p.estado));
  const contratados=emitidos.filter(p=>p.estado==='Aceptado'||p.estado==='Pagado');
  const estados=['Emitido','Aceptado','Pagado','Rechazado','Vencido'].map(estado=>({estado,cantidad:emitidos.filter(p=>p.estado===estado).length}));
  const otros=emitidos.filter(p=>!estados.some(e=>e.estado===p.estado)).length;if(otros)estados.push({estado:'Otros',cantidad:otros});
  const servicios=new Map<string,{descripcion:string;cantidad:number}>();
  for(const p of contratados){const vistos=new Set<string>();for(const i of p.items||[]){const descripcion=String(i.descripcion||'').trim().replace(/\s+/g,' '),key=descripcion.toLocaleLowerCase('es-AR');if(!key||vistos.has(key))continue;vistos.add(key);const actual=servicios.get(key);servicios.set(key,{descripcion:actual?.descripcion||descripcion,cantidad:(actual?.cantidad||0)+1});}}
  const dias=periodo==='mes'?new Date(Date.UTC(Number(clave.slice(0,4)),Number(clave.slice(5,7)),0)).getUTCDate():0;
  const serie=Array.from({length:periodo==='anio'?12:Math.ceil(dias/7)},(_,i)=>{
    const desde=i*7+1,hasta=Math.min(dias,(i+1)*7);
    const importe=movimientos.filter(m=>m.fecha.startsWith(clave)&&(periodo==='anio'?Number(m.fecha.slice(5,7))===i+1:Number(m.fecha.slice(8))>=desde&&Number(m.fecha.slice(8))<=hasta)).reduce((n,m)=>n+m.importe,0);
    return {etiqueta:periodo==='anio'?['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'][i]:`${desde}–${hasta}`,importe:Math.round(importe*100)/100};
  });
  return {ingresos,anteriores,variacion:anteriores!==0?(ingresos-anteriores)/Math.abs(anteriores)*100:null,emitidos:emitidos.length,contratados:contratados.length,aceptacion:emitidos.length?contratados.length/emitidos.length*100:null,clientes:new Set(contratados.map(p=>p.cliente.trim().toLocaleLowerCase('es-AR')).filter(Boolean)).size,estados,servicios:Array.from(servicios.values()).sort((a,b)=>b.cantidad-a.cantidad||a.descripcion.localeCompare(b.descripcion)).slice(0,5),serie};
};

// Exportación CSV: UTF-8 con BOM y protección frente a fórmulas en campos de texto.
const crearCsvProfesional = (filas: (string | number | null | undefined)[][]) => '\uFEFF' + filas.map(fila => fila.map(valor => {
  let texto = String(valor ?? '');
  if (typeof valor === 'string' && /^[\s]*[=+\-@]/.test(texto)) texto = "'" + texto;
  return '"' + texto.replace(/"/g, '""') + '"';
}).join(';')).join('\r\n');
const filasPresupuestosExportacion = (lista: Presupuesto[], desde = '', hasta = '', moneda = '') => lista.filter(p => {
  const fecha = String(p.fecha || '').slice(0,10);
  if ((desde || hasta) && !/^\d{4}-\d{2}-\d{2}$/.test(fecha)) return false;
  return (!desde || fecha >= desde) && (!hasta || fecha <= hasta) && (!moneda || (p.moneda || 'ARS') === moneda);
}).sort((a,b) => String(a.fecha).localeCompare(String(b.fecha)) || a.presupuesto_id - b.presupuesto_id);
const contenidoCsvClientes = (lista: Cliente[]) => crearCsvProfesional([
  ['ID','Nombre / Razón social','CUIT / DNI','Condición fiscal','Email','Teléfono','Dirección'],
  ...lista.map(c => [c.cliente_id,c.nombre_razon_social,c.cuit_cuil,c.condicion_tributaria,c.email,c.telefono,c.direccion])
]);
const contenidoCsvPresupuestos = (lista: Presupuesto[]) => crearCsvProfesional([
  ['Número','Fecha','Cliente','CUIT / DNI','Concepto','Moneda','Importe final','Estado'],
  ...lista.map(p => [p.numero_presupuesto,String(p.fecha || '').slice(0,10),p.cliente,p.cuit_cuil,(p.items || []).map(i => i.descripcion).filter(Boolean).join(' | '),p.moneda || 'ARS',Number.isFinite(totalVigentePresupuesto(p)) ? totalVigentePresupuesto(p).toFixed(2).replace('.',',') : '0,00',p.estado || 'Emitido'])
]);

interface Cliente {
  cliente_id: number;
  nombre_razon_social: string;
  cuit_cuil?: string;
  tipo_documento?: string;
  condicion_tributaria?: string;
  iibb?: string;
  email?: string;
  telefono?: string;
  contacto_compras?: string;
  direccion?: string;
  observaciones?: string;
}

interface CitaAgenda {
  id: string; titulo: string; cliente_id: string; cliente: string;
  fecha: string; inicio: string; fin: string; lugar: string;
  telefono: string; email: string; notas: string; repetir_semanal: boolean;
}
interface Perfil {
  firma_imagen?:{png:string;nombre:string};
  firma_automatica?:ModoFirmaAutomatica|'certificado';
  ordenes_trabajo?: OrdenTrabajo[];
  configuracion?: PreferenciasMiOficio;
  agenda?: CitaAgenda[];
  catalogo?: ArticuloCatalogo[];
  actividades_economicas?: ActividadEconomica[];
  nombre_comercial?: string;
  nombre?: string;
  cuit_cuil?: string;
  oficio_rubro?: string;
  telefono?: string;
  direccion?: string;
  localidad?: string;
  provincia?: string;
  codigo_postal?: string;
  email?: string;
  condicion_iva?: string;
  iibb?: string;
  titular_cuenta?: string;
  banco_pasarela?: string;
  cbu_alias?: string;
  cbu_cvu?: string;
  logo_url?: string;
  foto_perfil_url?: string;
  terminos_default?: string;
  es_premium?: boolean;
  acepta_efectivo?: boolean;
  acepta_cheque?: boolean;
  acepta_transferencia?: boolean;
  prefijo_presupuesto?: string;
  validez_default?: number;
  condicion_pago_default?: string;
  condiciones_default?: string;
  moneda_default?: string;
  moneda_elegida_explicitamente?: boolean;
  iva_default?: string;
  notificar_aceptados?: boolean;
  notificar_vencimientos?: boolean;
  plantilla_estilo?: string;
  numeracion_inicial?: number;
  serie_anio?: string;
  serie_digitos?: string;
  serie_siguiente?: string;
  garantia_default?: string;
  plazo_pago_default?: string;
  firma_nombre?: string;
  firma_cargo?: string;
  automatizar_recordatorios?: boolean;
  integracion_email?: boolean;
}


interface PreferenciasMiOficio {
  ajustar_listas_pantalla?: boolean;
  iniciar_en?: 'dashboard'|'clientes'|'presupuestos'|'agenda'|'herramientas';
  periodo_inicio?: 'mes'|'anio';
  clientes_por_pagina?: 2|5|10|20;
  presupuestos_por_pagina?: 3|5|10|20;
  ocultar_importes?: boolean;
  dias_vencimiento?: 1|3|7;
  recordatorios_cobro?: boolean;
  revision_pendientes?: boolean;
}
type ConfiguracionMiOficio = Required<PreferenciasMiOficio> & {notificar_aceptados:boolean;notificar_vencimientos:boolean};
const leerConfiguracionMiOficio=(perfil:Perfil):ConfiguracionMiOficio=>{
 const c=perfil.configuracion||{};
 return {ajustar_listas_pantalla:c.ajustar_listas_pantalla!==false,iniciar_en:c.iniciar_en&&['dashboard','clientes','presupuestos','agenda','herramientas'].includes(c.iniciar_en)?c.iniciar_en:'dashboard',periodo_inicio:c.periodo_inicio==='anio'?'anio':'mes',clientes_por_pagina:c.clientes_por_pagina&&[2,5,10,20].includes(c.clientes_por_pagina)?c.clientes_por_pagina:2,presupuestos_por_pagina:c.presupuestos_por_pagina&&[3,5,10,20].includes(c.presupuestos_por_pagina)?c.presupuestos_por_pagina:3,ocultar_importes:c.ocultar_importes===true,dias_vencimiento:c.dias_vencimiento&&[1,3,7].includes(c.dias_vencimiento)?c.dias_vencimiento:3,recordatorios_cobro:c.recordatorios_cobro!==false,revision_pendientes:c.revision_pendientes!==false,notificar_aceptados:perfil.notificar_aceptados!==false,notificar_vencimientos:perfil.notificar_vencimientos!==false};
};
const crearCsvMiOficio=(filas:(string|number)[][])=>'\uFEFF'+filas.map(f=>f.map(v=>{let t=String(v??'');if(typeof v==='string'&&/^[\s]*[=+\-@]/.test(t))t="'"+t;return '"'+t.replace(/"/g,'""')+'"';}).join(';')).join('\r\n');

const ROBOTO_REGULAR_BASE64 = '';
const ROBOTO_BOLD_BASE64 = '';


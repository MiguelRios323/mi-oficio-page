const PLANTILLA_RUBRO_GENERAL: PlantillaRubro = {
  etiquetas: ETIQUETAS_TRABAJO,
  ejemplos: ['Casa del cliente', 'Según lo acordado', 'Objetivo del trabajo'],
  producto: 'Servicio acordado',
};
const obtenerPlantillaRubro = (rubro: string): PlantillaRubro => {
  const rubroNormalizado = normalizarBusqueda(rubro);
  const oficio = OFICIOS_BASE.find(([nombre, alias]) =>
    normalizarBusqueda(nombre) === rubroNormalizado || alias.some(valor => normalizarBusqueda(valor) === rubroNormalizado)
  );
  const texto = normalizarBusqueda(oficio?.[0] || rubro).replace(/[^a-z0-9]+/g, ' ').trim();
  // Un límite de palabra evita confundir "gas" con "gastronomía" u "obra" con "cobranza".
  const coincide = (clave: string) => {
    const patron = normalizarBusqueda(clave).replace(/[^a-z0-9]+/g, ' ').trim();
    return texto.split(' ').some((_, indice, palabras) => {
      const resto = palabras.slice(indice).join(' ');
      return patron.length <= 2
        ? resto === patron || resto.startsWith(patron + ' ')
        : resto.startsWith(patron);
    });
  };
  return PLANTILLAS_RUBRO.find(({ claves }) => claves.some(coincide))?.plantilla
    || PLANTILLA_RUBRO_GENERAL;
};


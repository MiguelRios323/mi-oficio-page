    const contactoCliente: [string,string][]=[['Teléfono:',p.telefono || ''],['Email:',p.email || '']].filter(([,v])=>Boolean(v)) as [string,string][];
    const alturasCliente=datosCliente.map(([l,v],i)=>{font(true,9.5);const offset=doc.getTextWidth(l)+1.5;return Math.max(4.5,lines(v,114-offset,i===0).length*4.2);});
    const clienteH=5+Math.max(alturasCliente.reduce((a,v)=>a+v,0),contactoCliente.length*4.5);

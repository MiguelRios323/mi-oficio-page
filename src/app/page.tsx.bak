#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .budget-mobile-extra>summary::-webkit-details-marker{display:none}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .budget-mobile-extra>summary svg{width:14px!important;height:14px!important;min-width:14px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .budget-mobile-extra>div{position:absolute!important;bottom:calc(100% + 8px)!important;left:0!important;width:180px!important;padding:6px!important;background:white!important;border:1px solid #e5def3!important;border-radius:10px!important;box-shadow:0 8px 24px #33205826!important;z-index:5!important}

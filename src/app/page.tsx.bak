#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-page select{display:block!important;width:100%!important;min-width:0!important;min-height:38px!important;height:38px!important;padding:8px 30px 8px 10px!important;background-color:#fcfaff!important;border:1px solid #e5dbee!important;border-radius:8px!important;color:#60466f!important;font-size:12px!important;line-height:1.5!important;box-shadow:none!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-toggle{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:14px!important;min-height:56px!important;padding:11px 0!important;border-bottom:1px solid #f0eaf7!important;margin:0!important;cursor:pointer!important}

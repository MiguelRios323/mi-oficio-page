/* Banking proportions: a single compact Home layout, content-sized cards. */
#mioficio-dashboard.reference-ui.banking-ui{--compact-violet:#6049f8;--compact-ink:#27233c;--compact-muted:#858194;--compact-border:#e2def0;background:#eef1ff!important}
#mioficio-dashboard.reference-ui.banking-ui>.compact-main{display:block!important;background:linear-gradient(180deg,#5b46f5 0px,#6553fa 160px,#bbb4fc 260px,#edf0ff 360px)!important;padding:0!important}
#mioficio-dashboard.reference-ui.banking-ui>.compact-main>.compact-content{width:100%!important;max-width:980px!important;margin:0 auto!important;padding:8px 24px 28px!important;min-height:0!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-topbar{position:relative!important;max-width:980px;margin:0 auto!important;height:100px!important;min-height:100px!important;padding:20px 24px!important;background:transparent!important;border:0!important;gap:14px!important}
#mioficio-dashboard.reference-ui.banking-ui .reference-greeting{color:white;display:flex;align-items:center;flex-shrink:0}

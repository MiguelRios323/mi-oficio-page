#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-export-actions{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:9px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-export-actions>.configuration-full-export{grid-column:1/-1!important;justify-content:flex-start!important;padding:12px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-full-export>span{flex:1!important;text-align:left!important;min-width:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-full-export strong{display:block!important;font-size:12px!important;font-weight:600!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-full-export small{display:block!important;font-size:10px!important;font-weight:400!important;color:#b49abb!important;margin-top:3px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-support{grid-column:1/-1!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-support .configuration-card-body{display:flex!important;align-items:center!important;gap:16px!important;flex-wrap:wrap!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-support .configuration-card-body>div:first-child{flex:1!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-support strong{font-size:12px!important;color:#8b679d!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-support .configuration-card-body p{font-size:11px!important;color:#b59dbe!important;margin:5px 0 0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-support-actions{display:flex!important;gap:9px!important;flex-wrap:wrap!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-support .configuration-card-body>small{width:100%!important;text-align:right!important;font-size:10px!important;color:#bfa5c7!important;line-height:1.5!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-save{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:14px!important;margin-top:16px!important;padding:14px 0 6px!important;border-top:1px solid #e6dced!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-save p{font-size:11px!important;line-height:1.5!important;color:#9a7da8!important;margin:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-save>div:last-child{display:flex!important;gap:9px!important;flex-shrink:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-save>div>button{display:inline-flex!important;align-items:center!important;justify-content:center!important;gap:7px!important;min-height:38px!important;height:auto!important;padding:9px 14px!important;border-radius:9px!important;font-size:12px!important;font-weight:600!important;line-height:1.4!important;background:white!important;border:1px solid #e3d5ed!important;color:#9b77af!important;box-shadow:none!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-save button[type=submit]{background:#8a5ac1!important;border-color:#8a5ac1!important;color:white!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-page :is(button,input,select):disabled{opacity:.5!important;cursor:default!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-page :is(button,a,input,select,summary):focus-visible{outline:2px solid #aa83d0!important;outline-offset:3px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-save .configuration-result.error{color:#bd6486!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-save .configuration-result.ok{color:#659778!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .mobile-hub>.mobile-menu-card{display:grid!important}
@media(max-width:1023px){
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-grid{grid-template-columns:minmax(0,1fr)!important;gap:12px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-card>summary{padding:15px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-card-body{padding:0 15px 16px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-input-grid{gap:12px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-input-grid>label{grid-column:1/-1!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-save{align-items:flex-start!important;flex-direction:column!important;padding-bottom:15px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-save>div:last-child{width:100%!important;justify-content:flex-end!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-support .configuration-card-body{display:block!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-support-actions{margin-top:13px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-support .configuration-card-body>small{display:block!important;text-align:left!important;margin-top:10px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-account>div{flex-direction:column!important;gap:5px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-account dd{text-align:left!important}
}
@media(min-width:1024px) and (max-width:1279px){
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-topnav{gap:2px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-topnav>button{font-size:11px!important;padding:7px!important;gap:5px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-account>.approved-desktop{display:none!important}
}

/* Ajuste de contraste y alineación de los controles de configuración. */
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-page label.configuration-lead-time{display:grid!important;grid-template-columns:minmax(0,1fr) 150px!important;align-items:center!important;text-align:left!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-toggle>input:checked{background:var(--approved-purple)!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-save button[type=submit]{background:var(--approved-purple)!important;border-color:var(--approved-purple)!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-card :is(.configuration-footnote,.configuration-toggle small,.configuration-card-body label>small,.configuration-account dt,.configuration-full-export small){color:#80708c!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-card>summary p{color:#8b7a98!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-icon{color:var(--approved-purple)!important}
@media(max-width:639px){#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-page label.configuration-lead-time{grid-template-columns:minmax(0,1fr)!important}}


/* V19: guardado automático con confirmación visible y recuperación ante errores. */
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-autosave{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:10px!important;flex-wrap:wrap!important;margin:0 0 14px!important;padding:10px 12px!important;border:1px solid #e9e1f5!important;border-radius:10px!important;background:#fcfaff!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-autosave p{margin:0!important;font-size:12px!important;line-height:1.5!important;color:#71558a!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-autosave .ok{color:#32744d!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-autosave .error{color:#a23850!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-autosave>div{display:flex!important;gap:8px!important;flex-wrap:wrap!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-autosave button{padding:9px 12px!important;min-height:40px!important;border:1px solid #e3d5ed!important;border-radius:8px!important;background:white!important;font-size:12px!important;color:#72518d!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-autosave button[type=submit]{background:#8a5ac1!important;color:white!important;border-color:#8a5ac1!important}

/* V20: columnas independientes; cerrar un apartado no estira las tarjetas. */
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-grid{align-items:start!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-column{display:flex!important;flex-direction:column!important;gap:16px!important;min-width:0!important;align-self:start!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-column>.configuration-card{flex:none!important;height:auto!important;min-height:0!important;align-self:stretch!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-support .configuration-card-body{display:block!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-support-actions{margin-top:12px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-support .configuration-card-body>small{display:block!important;text-align:left!important;margin-top:10px!important}
@media(min-width:1024px){
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-input-grid>.configuration-full{grid-column:auto!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-input-grid{align-items:start!important}
}
@media(max-width:1023px){
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-column{gap:12px!important}
}

/* V21: confirmación manual junto al estado del guardado automático. */
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-autosave>p{flex:1 1 220px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-autosave>div{flex:0 0 auto!important;justify-content:flex-end!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-autosave button[type=submit]{display:inline-flex!important;align-items:center!important;justify-content:center!important;gap:7px!important;background:var(--approved-purple)!important;border-color:var(--approved-purple)!important;font-weight:600!important;white-space:nowrap!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-autosave button[type=submit]>svg{width:16px!important;height:16px!important}
@media(max-width:639px){#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .configuration-autosave>div{width:100%!important}}

/* V22: reversión total/parcial y comprobantes persistentes. */
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .reversal-form{border:1px solid #e5dcf5!important;background:#fcfaff!important;border-radius:12px!important;padding:16px!important;margin-top:14px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .reversal-form h3{font-size:16px!important;margin:0 0 8px!important;color:#30203f!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .reversal-form p,#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .reversal-form small{font-size:12px!important;line-height:1.5!important;color:#80708c!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .reversal-form label{display:flex!important;flex-direction:column!important;gap:6px!important;margin:12px 0!important;font-size:13px!important;color:#60466f!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .reversal-form input{min-width:0!important;width:100%!important;box-sizing:border-box!important;height:42px!important;padding:10px!important;border:1px solid #e5dbee!important;border-radius:8px!important;background:white!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .reversal-receipt-button{display:inline-flex!important;align-items:center!important;justify-content:center!important;gap:6px!important;padding:9px 12px!important;min-height:38px!important;height:auto!important;border:1px solid #e3d5ed!important;border-radius:8px!important;background:#f1eafa!important;color:#6244e8!important;font-size:12px!important;line-height:1.4!important;margin:8px 0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .reversal-receipt-button svg{width:16px!important;height:16px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .reversal-receipts{margin-top:14px!important;font-size:13px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .reversal-receipts>article{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:10px!important;flex-wrap:wrap!important;border-bottom:1px solid #eee6f5!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .collection-actions{flex-wrap:wrap!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .collection-actions>button{white-space:normal!important;height:auto!important;min-height:40px!important;line-height:1.4!important}

#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .reversal-form textarea{width:100%!important;min-width:0!important;box-sizing:border-box!important;min-height:72px!important;padding:10px!important;border:1px solid #e5dbee!important;border-radius:8px!important;background:white!important;font-size:14px!important;line-height:1.5!important;resize:vertical!important;color:#30203f!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .collection-actions.reversal-mode>button{border:1px solid #e3d5ed!important;background:#f1eafa!important;color:#6244e8!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .collection-actions.reversal-mode>button:last-child{background:var(--approved-purple)!important;color:white!important;border-color:var(--approved-purple)!important}

/* V23: devoluciones al cliente con medio real y nuevo importe acordado. */
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .refund-field-grid{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:0 12px!important;align-items:start!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .refund-field-grid>label{min-width:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .reversal-form select{height:42px!important;width:100%!important;min-width:0!important;box-sizing:border-box!important;padding:8px!important;border:1px solid #e5dbee!important;border-radius:8px!important;background:white!important;color:#30203f!important}
@media(max-width:639px){#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .refund-field-grid{grid-template-columns:minmax(0,1fr)!important}}

#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .collection-dialog:has(.reversal-form){display:flex!important;flex-direction:column!important;max-height:calc(100dvh - 32px)!important;overflow:hidden!important;min-height:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .collection-dialog:has(.reversal-form)>:not(.reversal-form){flex-shrink:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .collection-dialog>.reversal-form{flex:0 1 auto!important;overflow:auto!important;min-height:0!important;overscroll-behavior:contain!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .collection-dialog:has(.reversal-form)>.collection-actions{padding-top:12px!important;border-top:1px solid #e9e1f5!important;margin-top:12px!important}

#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .refund-field-grid>label{display:grid!important;grid-template-rows:minmax(36px,auto) 42px!important;align-content:start!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .refund-cancellation-hint{display:block!important;margin:4px 0 10px!important}
@media(min-width:360px) and (max-width:639px){#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .refund-field-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}}

/* V25: la operación se confirma y la descarga siempre se solicita con un botón. */
.receipt-ready-dialog{box-sizing:border-box;width:min(440px,calc(100vw - 32px));max-height:calc(100dvh - 32px);overflow:auto;border:1px solid #e7e0f5;border-radius:20px;padding:24px;background:#fff;color:#231f38;box-shadow:0 24px 80px #20163833;font-family:inherit}
.receipt-ready-dialog::backdrop{background:#1e153c80;backdrop-filter:blur(3px)}
.receipt-ready-dialog header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.receipt-ready-dialog header>button{display:flex;align-items:center;justify-content:center;border:0;background:#f4f0fb;color:#726086;width:36px;height:36px;border-radius:10px;cursor:pointer}
.receipt-ready-dialog svg{width:20px;height:20px}
.receipt-ready-icon{display:flex;align-items:center;justify-content:center;width:42px;height:42px;background:#e6f7ec;color:#228953;border-radius:14px}
.receipt-ready-dialog h2{font-size:21px;font-weight:700;line-height:1.3;margin:0 0 8px}
.receipt-ready-dialog p{font-size:13px;line-height:1.6;color:#80708c;margin:0 0 18px}
.receipt-ready-summary{display:grid;gap:6px;border:1px solid #e9e1f5;border-radius:12px;padding:16px;background:#fcfaff;margin:0 0 18px;font-size:13px}
.receipt-ready-summary span,.receipt-ready-summary small{color:#80708c}
.receipt-ready-summary b{font-size:25px;line-height:1.4;margin-top:5px;overflow-wrap:anywhere}
.receipt-ready-dialog .receipt-download-primary{display:flex;align-items:center;justify-content:center;gap:9px;width:100%;min-height:44px;border:0;border-radius:10px;background:#6244e8;color:white;font-size:14px;font-weight:600;cursor:pointer;padding:12px}
.receipt-ready-dialog button:disabled{opacity:.55;cursor:default}
.receipt-ready-dialog button:focus-visible{outline:2px solid #a98bea;outline-offset:3px}

/* V26: acceso visible a devolución parcial/completa, junto a los importes. */
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .refund-direct-button{display:flex!important;align-items:center!important;justify-content:flex-start!important;gap:9px!important;width:100%!important;min-height:44px!important;height:auto!important;padding:11px 12px!important;border:1px solid #ded4fa!important;border-radius:10px!important;background:#f3eeff!important;color:#6244e8!important;font-size:13px!important;font-weight:600!important;line-height:1.5!important;text-align:left!important;white-space:normal!important;margin:12px 0 16px!important;cursor:pointer!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .refund-direct-button>span{flex:1!important;min-width:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .refund-direct-button>svg{width:18px!important;height:18px!important;flex-shrink:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .refund-kind{border:0!important;padding:0!important;margin:12px 0 4px!important;min-width:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .refund-kind legend{font-size:13px!important;font-weight:600!important;color:#60466f!important;margin-bottom:8px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .refund-kind>div{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .refund-kind label{display:flex!important;flex-direction:row!important;align-items:center!important;gap:8px!important;margin:0!important;min-height:40px!important;padding:8px!important;border:1px solid #e5dbee!important;border-radius:8px!important;background:white!important;font-size:12px!important;line-height:1.4!important;cursor:pointer!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .refund-kind label:has(input:checked){border-color:#aa93ed!important;background:#f3eeff!important;color:#6244e8!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .refund-kind input{width:16px!important;height:16px!important;min-width:16px!important;padding:0!important;margin:0!important;accent-color:#6244e8!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard #reversal-amount:read-only{background:#f4f0fa!important;color:#735d86!important}

/* V28: biblioteca de herramientas compacta y extensible, con una sola vista adaptable. */
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .tools-library{min-width:0!important;width:100%!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .tools-library-toolbar{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:16px!important;margin:0 0 18px!important;flex-wrap:wrap!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .tools-plan-filters{display:flex!important;gap:7px!important;flex-wrap:wrap!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .tools-plan-filters button{display:flex!important;align-items:center!important;gap:7px!important;min-height:38px!important;height:auto!important;padding:8px 12px!important;border:1px solid #e7dff2!important;border-radius:10px!important;background:#faf8fe!important;color:#7f6a92!important;font-size:12px!important;line-height:1.4!important;box-shadow:none!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .tools-plan-filters button[aria-pressed=true]{background:#6244e8!important;border-color:#6244e8!important;color:white!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .tools-plan-filters button span{display:inline-flex!important;align-items:center!important;justify-content:center!important;min-width:20px!important;height:20px!important;padding:0 4px!important;border-radius:6px!important;background:#eae3f5!important;font-size:10px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .tools-plan-filters button[aria-pressed=true] span{background:#ffffff30!important}

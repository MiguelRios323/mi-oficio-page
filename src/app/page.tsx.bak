/* Resumen simplificado y detalle del presupuesto, dentro del modelo aprobado. */
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-summary-simple{grid-template-columns:minmax(0,1fr) auto!important;gap:20px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-summary-simple .approved-main-metric{grid-column:auto!important;border:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-summary-simple .approved-main-metric>div>span{font-size:13px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-summary-simple .approved-metric small{display:block!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-summary-simple .approved-hide-money{display:flex!important;margin-left:10px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-summary-simple .approved-summary-actions{grid-column:auto!important;grid-template-columns:1fr 1fr!important;gap:9px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-home-primary{min-width:0}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-finances-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-finances-grid .approved-metric:last-child{border:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-finances-grid .approved-metric strong{font-size:21px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-finances-period{font-size:10px!important;color:var(--approved-muted)!important;text-align:right}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-budget-row{cursor:pointer}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-budget-row:hover{background:#f8f6ff!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-overlay{position:fixed!important;inset:0!important;z-index:120!important;display:flex!important;align-items:center!important;justify-content:center!important;padding:24px!important;background:#16103366!important;backdrop-filter:blur(4px)!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-dialog{display:flex!important;flex-direction:column!important;width:740px!important;max-width:100%!important;max-height:calc(100dvh - 48px)!important;background:#fff!important;border:1px solid #e8e1f6!important;border-radius:20px!important;color:#17113b!important;overflow:hidden!important;box-shadow:0 24px 80px #1c114a33!important;padding:0!important;text-align:left!important;outline:none}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-heading{display:flex!important;align-items:center!important;justify-content:space-between!important;padding:18px 22px!important;gap:12px!important;border-bottom:1px solid #eee9f7!important;background:#f9f7ff!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-heading small{display:block!important;color:#75688d!important;font-size:11px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-heading h2{font-size:20px!important;line-height:1.3!important;font-weight:700!important;margin:4px 0 0!important;overflow-wrap:anywhere!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-scroll{overflow-y:auto!important;min-height:0!important;padding:20px 22px!important;overscroll-behavior:contain!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-client{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:12px!important;margin-bottom:16px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-client h3{font-size:18px!important;line-height:1.4!important;font-weight:700!important;margin:0!important;overflow-wrap:anywhere!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-dialog p{font-size:12px!important;line-height:1.6!important;color:#746987!important;margin:5px 0 10px!important;white-space:pre-wrap!important;overflow-wrap:anywhere!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-totals{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:10px!important;padding:15px!important;background:#f5f2ff!important;border:1px solid #e9e2fc!important;border-radius:12px!important;margin:16px 0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-totals span{font-size:11px!important;color:#746987!important;display:block!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-totals strong{display:block!important;font-size:20px!important;line-height:1.4!important;font-weight:700!important;margin-top:5px!important;overflow-wrap:anywhere!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-section{padding:14px 0!important;border-top:1px solid #eee9f7!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-section h3{font-size:14px!important;font-weight:700!important;line-height:1.4!important;margin:0 0 10px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-contact{display:grid!important;grid-template-columns:1fr 1fr!important;gap:12px!important;margin:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-contact dt{font-size:11px!important;color:#827491!important;line-height:1.4!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-contact dd{font-size:12px!important;line-height:1.5!important;margin:3px 0 0!important;overflow-wrap:anywhere!important;color:#17113b!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-items article{display:flex!important;align-items:flex-start!important;justify-content:space-between!important;gap:14px!important;padding:12px 0!important;border-bottom:1px solid #f0edf6!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-items article:last-child{border:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-items article>div{min-width:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-items strong{font-size:12px!important;font-weight:600!important;line-height:1.5!important;overflow-wrap:anywhere!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-items small{display:block!important;color:#827491!important;font-size:11px!important;line-height:1.5!important;margin-top:4px!important;overflow-wrap:anywhere!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-items b{font-size:12px!important;font-weight:600!important;white-space:nowrap!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-actions{display:flex!important;flex-wrap:wrap!important;align-items:center!important;justify-content:flex-end!important;gap:8px!important;padding:14px 22px!important;border-top:1px solid #eee9f7!important;background:#faf9ff!important;flex-shrink:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-actions button{display:inline-flex!important;align-items:center!important;justify-content:center!important;gap:6px!important;min-height:38px!important;font-size:12px!important;padding:9px 12px!important;white-space:nowrap!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-dialog button svg{width:17px!important;height:17px!important;min-width:17px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-dialog button:focus-visible,#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-budget-row button:focus-visible{outline:2px solid #6046f5!important;outline-offset:3px!important}
@media(max-width:1023px){
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-summary-simple{grid-template-columns:1fr!important;gap:14px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-summary-simple .approved-summary-actions{grid-template-columns:1fr!important;width:100%!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-summary-simple .approved-main-metric strong{font-size:26px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-summary-simple .approved-main-metric small{font-size:10px!important}

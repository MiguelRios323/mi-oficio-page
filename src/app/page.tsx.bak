#mioficio-dashboard.reference-ui .budget-mobile-progress [aria-current=step] span{background:#6246f5;border-color:#6246f5;color:white}
#mioficio-dashboard.reference-ui .budget-mobile-progress [aria-current=step] small{color:#6246f5}
#mioficio-dashboard.reference-ui .budget-desktop-progress{background:#f3f0fc!important;border-color:#e8e0f5!important}

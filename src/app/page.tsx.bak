      <style>{`#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .received-payment-method{display:flex!important;flex-direction:column!important;gap:5px!important;min-width:0!important;flex:1!important;}

#mioficio-dashboard.reference-ui.banking-ui .visual-page-heading p{font-size:12px!important;color:#7972a0;margin:4px 0 0!important}
#mioficio-dashboard.reference-ui.banking-ui .visual-page-heading>svg,#mioficio-dashboard.reference-ui.banking-ui .visual-page-heading>span{color:#5041f8}
#mioficio-dashboard.reference-ui.banking-ui .visual-primary{display:inline-flex;align-items:center;justify-content:center;gap:7px;height:36px;padding:0 14px;border:0;border-radius:8px;background:#5041f8;color:white;font-size:12px;font-weight:500}
#mioficio-dashboard.reference-ui.banking-ui .visual-row-actions{display:flex;align-items:center;gap:8px}
#mioficio-dashboard.reference-ui.banking-ui .visual-row-actions button{display:inline-flex;align-items:center;gap:5px;border:0;border-radius:6px;background:#f5f2ff;color:#5041f8;font-size:11px;padding:7px;white-space:nowrap}
#mioficio-dashboard.reference-ui.banking-ui .visual-search{display:flex;align-items:center;gap:8px;min-width:0;border:1px solid #ded8f2;border-radius:8px;background:white;padding:0 10px;margin-bottom:14px;height:38px;color:#5041f8}
#mioficio-dashboard.reference-ui.banking-ui .visual-search input{background:none;border:0;outline:none;min-width:0;flex:1;font-size:12px;color:#17143d}
#mioficio-dashboard.reference-ui.banking-ui .compact-page-heading{display:flex!important;align-items:center!important;background:white!important;border:1px solid #e4e0f5!important;border-radius:12px!important;padding:16px!important;gap:12px!important;margin:0 0 12px!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-page-heading h1{font-size:18px!important;display:flex;align-items:center;gap:10px}
#mioficio-dashboard.reference-ui.banking-ui .compact-page-heading h1{color:#17143d!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-page-heading .compact-primary{background:#5041f8!important;color:white!important;border:0!important;border-radius:8px!important;height:36px!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-page-heading h1 svg{color:#5041f8}
#mioficio-dashboard.reference-ui.banking-ui .compact-page-heading button{margin-left:auto}
#mioficio-dashboard.reference-ui.banking-ui .compact-list-toolbar>.compact-mobile{display:none!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-list-toolbar{padding:0!important;gap:10px!important;margin-bottom:12px!important}
#mioficio-dashboard.reference-ui.banking-ui .visual-client-table{padding:0;overflow-x:auto}
#mioficio-dashboard.reference-ui.banking-ui .visual-client-table table{width:100%;border-collapse:collapse;font-size:12px}
#mioficio-dashboard.reference-ui.banking-ui .visual-client-table th{text-align:left;color:#4e487f;font-size:11px;background:#faf9ff;font-weight:500}
#mioficio-dashboard.reference-ui.banking-ui .visual-client-table :is(th,td){padding:13px 14px;border-bottom:1px solid #eeebf8;vertical-align:middle}
#mioficio-dashboard.reference-ui.banking-ui .visual-client-table small{display:block;font-size:11px;margin:3px 0;color:#706b92}

  const detalleResumenCobrado=Object.entries(cobradoPorMoneda).filter(([code,total])=>code!==monedaCobrado&&total>0).map(([code,total])=>`${code} $ ${total.toLocaleString('es-AR',{maximumFractionDigits:2})}`).join(' · ');



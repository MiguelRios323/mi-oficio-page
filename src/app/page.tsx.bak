    if(tab==='agenda'){const c=siguienteCitaAgenda();setCitaSeleccionada(c || null);if(c){setDiaAgenda(c.fecha_instancia);setSemanaAgenda(lunesAgenda(c.fecha_instancia));setAgendaFinSemana(new Date(c.fecha_instancia+'T12:00:00Z').getUTCDay()===0 || new Date(c.fecha_instancia+'T12:00:00Z').getUTCDay()===6);}}
    setActiveTab(tab);
  };

  const diasAgenda=(fecha:string,cantidad:number)=>{const d=new Date(`${fecha}T12:00:00Z`);d.setUTCDate(d.getUTCDate()+cantidad);return d.toISOString().slice(0,10);};
  const lunesAgenda=(fecha:string)=>diasAgenda(fecha,-((new Date(`${fecha}T12:00:00Z`).getUTCDay()+6)%7));
  const fechaCortaAgenda=(fecha:string,opciones:Intl.DateTimeFormatOptions={day:'numeric',month:'short'})=>new Date(`${fecha}T12:00:00Z`).toLocaleDateString('es-AR',{...opciones,timeZone:'America/Argentina/Buenos_Aires'});
  const hoyAgenda=fechaArgentina();
  const inicioSemanaAgenda=semanaAgenda || lunesAgenda(hoyAgenda);
  const diasSemanaAgenda=Array.from({length:7},(_,i)=>diasAgenda(inicioSemanaAgenda,i));
  const diaActivoAgenda=diaAgenda || hoyAgenda;
  const diasVisiblesAgenda=agendaFinSemana?diasSemanaAgenda.slice(5):diasSemanaAgenda.slice(0,5);
  const citasAgenda:CitaAgenda[]=Array.isArray(perfilForm.agenda)?perfilForm.agenda:[];
  const citasDelDia=(fecha:string)=>(citasAgenda.filter(c=>c.fecha===fecha || (c.repetir_semanal && perfilForm.es_premium===true && fecha>=c.fecha && Math.round((Date.parse(`${fecha}T12:00:00Z`)-Date.parse(`${c.fecha}T12:00:00Z`))/86400000)%7===0)).map(c=>({...c,fecha_instancia:fecha})).sort((a,b)=>a.inicio.localeCompare(b.inicio)));
  const citasSemanaVisible = diasVisiblesAgenda.flatMap(d => citasDelDia(d));
  const agendaHoraInicio = Math.min(8, ...citasSemanaVisible.map(c => Number(c.inicio.slice(0,2))));
  const agendaHoraFin = Math.min(24, Math.max(19, ...citasSemanaVisible.map(c => Math.ceil((Number(c.fin.slice(0,2))*60 + Number(c.fin.slice(3)))/60))));
  const agendaAltoCalendario = (agendaHoraFin - agendaHoraInicio)*36 + 14;
  const seleccionarCitaAgenda=(c:CitaAgenda & {fecha_instancia:string})=>{setCitaSeleccionada(c);setFormAgenda(null);setDiaAgenda(c.fecha_instancia);setSemanaAgenda(lunesAgenda(c.fecha_instancia));setAgendaFinSemana([0,6].includes(new Date(c.fecha_instancia+'T12:00:00Z').getUTCDay()));setActiveTab('agenda');};
  const abrirFormularioAgenda=(cita?:CitaAgenda)=>{setErrorAgenda('');setFormAgenda(cita?{...cita,repetir_semanal:cita.repetir_semanal && perfilForm.es_premium===true}:{id:'',titulo:'',cliente_id:'',cliente:'',fecha:diaActivoAgenda,inicio:'10:00',fin:'11:00',lugar:'',telefono:'',email:'',notas:'',repetir_semanal:false});};
  const guardarCitaAgenda=async(e:FormEvent)=>{
    e.preventDefault();if(!formAgenda || guardandoAgenda)return;
    if(!formAgenda.titulo.trim() || !/^\d{4}-\d{2}-\d{2}$/.test(formAgenda.fecha) || !/^\d{2}:\d{2}$/.test(formAgenda.inicio) || !/^\d{2}:\d{2}$/.test(formAgenda.fin) || formAgenda.fin<=formAgenda.inicio){setErrorAgenda('Completá el trabajo, la fecha y un horario de fin posterior al inicio.');return;}
    if(formAgenda.repetir_semanal && perfilForm.es_premium!==true){activarPremium();return;}
    const cita={...formAgenda,id:formAgenda.id || (typeof crypto!=='undefined' && crypto.randomUUID?crypto.randomUUID():`${Date.now()}-${Math.random().toString(36).slice(2)}`),titulo:formAgenda.titulo.trim(),cliente:formAgenda.cliente.trim(),lugar:formAgenda.lugar.trim(),notas:formAgenda.notas.trim()};
    const perfil={...perfilForm,agenda:[...citasAgenda.filter(c=>c.id!==cita.id),cita]};setGuardandoAgenda(true);setErrorAgenda('');
    try{if(await sincronizarConCloudDirecto(perfil,clientes,presupuestos)){setPerfilForm(perfil);setFormAgenda(null);seleccionarCitaAgenda({...cita,fecha_instancia:cita.fecha});mostrarNotificacion('Trabajo agendado.');}else setErrorAgenda('No se pudo guardar. Tus datos siguen en el formulario.');}finally{setGuardandoAgenda(false);}
  };
  const eliminarCitaAgenda=async()=>{if(!citaSeleccionada || guardandoAgenda || !window.confirm(citaSeleccionada.repetir_semanal?'¿Eliminar esta visita y todas sus repeticiones?':'¿Eliminar este trabajo de la agenda?'))return;const perfil={...perfilForm,agenda:citasAgenda.filter(c=>c.id!==citaSeleccionada.id)};setGuardandoAgenda(true);try{if(await sincronizarConCloudDirecto(perfil,clientes,presupuestos)){setPerfilForm(perfil);setCitaSeleccionada(null);mostrarNotificacion('Trabajo eliminado de la agenda.');}}finally{setGuardandoAgenda(false);}};
  const contactoCitaAgenda=(c:CitaAgenda)=>{const telefono=c.telefono.replace(/\D/g,'');if(telefono)window.open(`https://wa.me/${telefono}`,'_blank','noopener,noreferrer');else if(c.email)window.location.href=`mailto:${encodeURIComponent(c.email)}`;else mostrarNotificacion('Este trabajo no tiene un teléfono o correo de contacto.','error');};
  const siguienteCitaAgenda=()=>{
    const hora=new Intl.DateTimeFormat('es-AR',{timeZone:'America/Argentina/Buenos_Aires',hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).format(new Date());
    return citasAgenda.map(c=>{let fecha=c.fecha;if(c.repetir_semanal && perfilForm.es_premium===true && (fecha<hoyAgenda || fecha===hoyAgenda && c.fin<hora)){const n=Math.max(0,Math.ceil((Date.parse(`${hoyAgenda}T12:00:00Z`)-Date.parse(`${fecha}T12:00:00Z`))/604800000));fecha=diasAgenda(fecha,n*7);if(fecha===hoyAgenda && c.fin<hora)fecha=diasAgenda(fecha,7);}return {...c,fecha_instancia:fecha};}).filter(c=>c.fecha_instancia>hoyAgenda || c.fecha_instancia===hoyAgenda && c.fin>=hora).sort((a,b)=>`${a.fecha_instancia} ${a.inicio}`.localeCompare(`${b.fecha_instancia} ${b.inicio}`))[0];
  };
  const previewAgenda=()=>{const proxima=siguienteCitaAgenda();return <section className="agenda-home"><div className="agenda-home-heading"><h2><IconoOficial nombre="calendar" />Agenda<span className="agenda-desktop"> · Esta semana</span></h2><div className="agenda-desktop agenda-week-controls"><button type="button" aria-label="Semana anterior" onClick={()=>setSemanaAgenda(diasAgenda(inicioSemanaAgenda,-7))}><IconoOficial nombre="chevron-left"/></button><span>{fechaCortaAgenda(inicioSemanaAgenda)} – {fechaCortaAgenda(diasAgenda(inicioSemanaAgenda,4))}</span><button type="button" aria-label="Semana siguiente" onClick={()=>setSemanaAgenda(diasAgenda(inicioSemanaAgenda,7))}><IconoOficial nombre="chevron-right"/></button></div></div>
      <div className="agenda-desktop agenda-home-week">{diasSemanaAgenda.slice(0,5).map(d=><div className={d===hoyAgenda?'is-today':''} key={d}><strong>{fechaCortaAgenda(d,{weekday:'short',day:'numeric'})}</strong>{citasDelDia(d).slice(0,2).map(c=><button type="button" key={c.id} onClick={()=>seleccionarCitaAgenda(c)}><b>{c.inicio}</b><span>{c.titulo}</span><small>{c.cliente}</small><IconoOficial nombre="chevron-right"/></button>)}</div>)}</div>
      {diasSemanaAgenda.slice(5).some(d=>citasDelDia(d).length>0) && <button type="button" className="agenda-weekend agenda-desktop" onClick={()=>{setActiveTab('agenda');setDiaAgenda(diasSemanaAgenda[5]);setAgendaFinSemana(true);setCitaSeleccionada(null);setFormAgenda(null);}}>Ver trabajos del fin de semana<IconoOficial nombre="chevron-right"/></button>}
      <div className="agenda-mobile">{proxima?<button type="button" className="agenda-next" onClick={()=>seleccionarCitaAgenda(proxima)}><span className="agenda-date-chip"><b>{fechaCortaAgenda(proxima.fecha_instancia,{day:'numeric'})}</b><small>{fechaCortaAgenda(proxima.fecha_instancia,{month:'short'})}</small></span><span><strong>{proxima.titulo}</strong><small>{[proxima.cliente,proxima.lugar].filter(Boolean).join(' · ')}</small></span><b>{proxima.inicio}</b></button>:<button type="button" className="agenda-empty-link" onClick={()=>{setActiveTab('agenda');abrirFormularioAgenda();}}>Agendá tu próximo trabajo<IconoOficial nombre="chevron-right"/></button>}</div>
      {!citasAgenda.length && <button type="button" className="agenda-empty-link agenda-desktop" onClick={()=>{setActiveTab('agenda');abrirFormularioAgenda();}}>Agendá tu primer trabajo<IconoOficial nombre="chevron-right"/></button>}
    </section>;};
  const panelAgenda=()=> <section className="agenda-page">
    <div className="visual-page-heading"><span><IconoOficial nombre="calendar"/></span><div><h2>Agenda</h2><p>Visitas y trabajos programados</p></div><button type="button" className="visual-primary" disabled={guardandoAgenda} onClick={()=>abrirFormularioAgenda()}><IconoPanel name="plus"/>Agendar trabajo</button></div>
    {formAgenda?<form className="agenda-form visual-card" onSubmit={guardarCitaAgenda}><h3>{formAgenda.id?'Editar trabajo':'Agendar trabajo'}</h3><div className="agenda-form-grid"><label className="agenda-full">Trabajo<input required maxLength={100} aria-label="Trabajo de agenda" placeholder="Ej.: Visita técnica" value={formAgenda.titulo} onChange={e=>setFormAgenda({...formAgenda,titulo:e.target.value})}/></label><label className="agenda-full">Cliente<select aria-label="Cliente de agenda" value={formAgenda.cliente_id} onChange={e=>{const c=clientes.find(c=>String(c.cliente_id)===e.target.value);setFormAgenda({...formAgenda,cliente_id:e.target.value,cliente:c?.nombre_razon_social || '',telefono:c?.telefono || '',email:c?.email || '',lugar:c?.direccion || ''});}}><option value="">Completar manualmente</option>{clientes.map(c=><option key={c.cliente_id} value={String(c.cliente_id)}>{c.nombre_razon_social}</option>)}</select></label><label className="agenda-full">Nombre / razón social<input maxLength={100} aria-label="Nombre del cliente de agenda" value={formAgenda.cliente} onChange={e=>setFormAgenda({...formAgenda,cliente:e.target.value})}/></label><label>Fecha<input required type="date" aria-label="Fecha del trabajo" value={formAgenda.fecha} onChange={e=>setFormAgenda({...formAgenda,fecha:e.target.value})}/></label><div className="agenda-time-fields"><label>Desde<input required type="time" aria-label="Hora de inicio" value={formAgenda.inicio} onChange={e=>setFormAgenda({...formAgenda,inicio:e.target.value})}/></label><label>Hasta<input required type="time" aria-label="Hora de fin" value={formAgenda.fin} onChange={e=>setFormAgenda({...formAgenda,fin:e.target.value})}/></label></div><label className="agenda-full">Lugar<input maxLength={180} aria-label="Lugar del trabajo" value={formAgenda.lugar} onChange={e=>setFormAgenda({...formAgenda,lugar:e.target.value})}/></label><label>Teléfono<input type="tel" maxLength={40} aria-label="Teléfono de agenda" value={formAgenda.telefono} onChange={e=>setFormAgenda({...formAgenda,telefono:e.target.value})}/></label><label>Email<input type="email" maxLength={100} aria-label="Email de agenda" value={formAgenda.email} onChange={e=>setFormAgenda({...formAgenda,email:e.target.value})}/></label><label className="agenda-full">Notas<textarea maxLength={500} rows={2} aria-label="Notas de agenda" value={formAgenda.notas} onChange={e=>setFormAgenda({...formAgenda,notas:e.target.value})}/></label></div><button type="button" className="agenda-repeat" onClick={()=>perfilForm.es_premium===true?setFormAgenda({...formAgenda,repetir_semanal:!formAgenda.repetir_semanal}):activarPremium()} aria-pressed={formAgenda.repetir_semanal}><IconoOficial nombre="crown"/>Repetir visita cada semana<span>{perfilForm.es_premium===true?(formAgenda.repetir_semanal?'Activado':'Desactivado'):'Premium'}</span></button>{errorAgenda && <p role="alert" className="agenda-error">{errorAgenda}</p>}<div className="agenda-form-actions"><button type="button" disabled={guardandoAgenda} onClick={()=>setFormAgenda(null)}>Cancelar</button><button className="visual-primary" type="submit" disabled={guardandoAgenda}>{guardandoAgenda?'Guardando…':'Guardar trabajo'}</button></div></form>:<>
      <div className="agenda-toolbar"><button type="button" aria-label="Semana anterior" onClick={()=>{setSemanaAgenda(diasAgenda(inicioSemanaAgenda,-7));setDiaAgenda(diasAgenda(inicioSemanaAgenda,-7));}}><IconoOficial nombre="chevron-left"/></button><strong>{fechaCortaAgenda(inicioSemanaAgenda)} – {fechaCortaAgenda(diasAgenda(inicioSemanaAgenda,6))}</strong><button type="button" aria-label="Semana siguiente" onClick={()=>{setSemanaAgenda(diasAgenda(inicioSemanaAgenda,7));setDiaAgenda(diasAgenda(inicioSemanaAgenda,7));}}><IconoOficial nombre="chevron-right"/></button><button type="button" onClick={()=>{setSemanaAgenda(lunesAgenda(hoyAgenda));setDiaAgenda(hoyAgenda);}}>Hoy</button><button type="button" aria-pressed={agendaFinSemana} onClick={()=>{setAgendaFinSemana(!agendaFinSemana);setDiaAgenda(diasSemanaAgenda[agendaFinSemana?0:5]);setCitaSeleccionada(null);}}>{agendaFinSemana?'Lunes a viernes':'Fin de semana'}</button></div>
      <div className="agenda-layout"><div className="agenda-calendar visual-card" style={{'--agenda-grid-height':`${agendaAltoCalendario}px`} as CSSProperties}><div className="agenda-days" style={{gridTemplateColumns:`repeat(${agendaFinSemana?2:5},minmax(0,1fr))`}}>{diasVisiblesAgenda.map(d=><button type="button" className={d===diaActivoAgenda?'is-selected':''} key={d} onClick={()=>{setDiaAgenda(d);setCitaSeleccionada(null);}}><span>{fechaCortaAgenda(d,{weekday:'short'}).toUpperCase()} {fechaCortaAgenda(d,{day:'numeric'})}</span><small>{fechaCortaAgenda(d,{month:'long'})}</small></button>)}</div><div className="agenda-desktop agenda-week-grid" style={{gridTemplateColumns:`repeat(${agendaFinSemana?2:5},minmax(0,1fr))`}}>{diasVisiblesAgenda.map(d=><div className={`agenda-day-column ${d===diaActivoAgenda ? 'is-selected' : ''}`} key={d}>{Array.from({length:agendaHoraFin-agendaHoraInicio},(_,h)=><span className="agenda-hour" key={h}>{h+agendaHoraInicio}:00</span>)}{citasDelDia(d).map((c,i)=>{const minutos=(t:string)=>Number(t.slice(0,2))*60+Number(t.slice(3));const m=minutos(c.inicio);const conflictos=citasDelDia(d).filter(o=>minutos(o.inicio)<minutos(c.fin) && minutos(o.fin)>m);const columna=conflictos.findIndex(o=>o.id===c.id);return <button type="button" key={`${c.id}-${i}`} className={`agenda-event ${citaSeleccionada?.id===c.id?'is-selected':''}`} style={{top:Math.max(0,(m-agendaHoraInicio*60)*.6),minHeight:50,height:Math.min(100,Math.max(50,(minutos(c.fin)-m)*.6)),left:`${columna/Math.max(1,conflictos.length)*100}%`,width:`${100/Math.max(1,conflictos.length)}%`}} onClick={()=>seleccionarCitaAgenda(c)}><b>{c.inicio}</b><strong>{c.titulo}</strong><small>{c.cliente}</small></button>;})}</div>)}</div><div className="agenda-mobile agenda-day-list"><h3>{fechaCortaAgenda(diaActivoAgenda,{weekday:'long',day:'numeric',month:'long'})}</h3>{citasDelDia(diaActivoAgenda).map(c=><button type="button" key={c.id} onClick={()=>seleccionarCitaAgenda(c)}><span><b>{c.inicio}</b><small>{c.fin}</small></span><span><strong>{c.titulo}</strong><small>{c.cliente || c.lugar}</small></span><IconoOficial nombre="chevron-right"/></button>)}{!citasDelDia(diaActivoAgenda).length && <p>No hay trabajos agendados para este día.</p>}</div></div>
      {citaSeleccionada && <aside className="agenda-detail visual-card"><div className="agenda-detail-heading"><h3>Detalle del trabajo</h3><button type="button" aria-label="Cerrar detalle" onClick={()=>setCitaSeleccionada(null)}><IconoOficial nombre="x"/></button></div><strong>{citaSeleccionada.cliente}</strong><h4>{citaSeleccionada.titulo}</h4>{citaSeleccionada.lugar && <p><IconoOficial nombre="map-pin"/>{citaSeleccionada.lugar}</p>}<p><IconoOficial nombre="calendar"/>{fechaCortaAgenda(citaSeleccionada.fecha_instancia,{weekday:'long',day:'numeric',month:'long'})}</p><p><IconoOficial nombre="clock"/>{citaSeleccionada.inicio} – {citaSeleccionada.fin}</p>{citaSeleccionada.notas && <p className="agenda-notes">{citaSeleccionada.notas}</p>}<div className="agenda-detail-actions"><button type="button" disabled={guardandoAgenda} onClick={()=>abrirFormularioAgenda(citaSeleccionada)}><IconoOficial nombre="square-pen"/>Editar</button><button type="button" onClick={()=>contactoCitaAgenda(citaSeleccionada)}><IconoOficial nombre="message-circle"/>Contactar</button></div><button type="button" className="agenda-repeat" onClick={()=>perfilForm.es_premium===true?abrirFormularioAgenda(citaSeleccionada):activarPremium()}><IconoOficial nombre="crown"/>Repetir visita<span>{perfilForm.es_premium===true?(citaSeleccionada.repetir_semanal?'Semanal':'Configurar'):'Premium'}</span></button><button type="button" className="agenda-delete" disabled={guardandoAgenda} onClick={()=>void eliminarCitaAgenda()}><IconoOficial nombre="trash-2"/>Eliminar trabajo</button></aside>}
      </div>
    </>}
  </section>;

  const formularioCatalogoVisual = () => (<form className="catalogo-form" onSubmit={guardarArticuloCatalogo}>
            <h3>{editandoArticulo ? 'Editar artículo' : 'Nuevo producto o servicio'}</h3>
            <label htmlFor="catalogo-descripcion">Descripción</label><input id="catalogo-descripcion" autoFocus required maxLength={160} value={formArticulo.descripcion} onChange={e => setFormArticulo({...formArticulo, descripcion:e.target.value})} disabled={guardandoCatalogo} placeholder="Lo que vas a cobrar" /><small>{formArticulo.descripcion.length}/160</small>
            <div className="catalogo-form-grid"><div><label htmlFor="catalogo-unidad">Unidad</label><select id="catalogo-unidad" value={formArticulo.unidad} onChange={e => setFormArticulo({...formArticulo,unidad:e.target.value})} disabled={guardandoCatalogo}>{Array.from(new Set([formArticulo.unidad,...UNIDADES_PRESUPUESTO])).map(u => <option key={u} value={u}>{abreviarUnidadPresupuesto(u)} · {DETALLE_UNIDADES[u]?.nombre || u}</option>)}</select></div><div><label htmlFor="catalogo-moneda">Moneda</label><select id="catalogo-moneda" value={formArticulo.moneda} onChange={e => setFormArticulo({...formArticulo,moneda:e.target.value})} disabled={guardandoCatalogo}>{Array.from(new Set([formArticulo.moneda, 'ARS', 'USD', 'EUR'])).map(m => <option key={m}>{m}</option>)}</select></div><div><label htmlFor="catalogo-precio">Precio neto unitario</label><input id="catalogo-precio" type="number" inputMode="decimal" min="0" max="999999999" step="0.01" required value={formArticulo.precio} onChange={e => setFormArticulo({...formArticulo,precio:e.target.value})} disabled={guardandoCatalogo} placeholder="0,00" /></div><div><label htmlFor="catalogo-iva">IVA</label><select id="catalogo-iva" value={formArticulo.iva} onChange={e => setFormArticulo({...formArticulo,iva:e.target.value})} disabled={guardandoCatalogo}>{[0,10.5,21,27].map(t => <option key={t} value={t}>{String(t).replace('.',',')} %</option>)}</select></div></div>
            <p className="catalogo-hint">Al agregarlo al presupuesto, podés ajustar cantidad, precio, IVA y bonificación sin cambiar el producto o servicio guardado.</p><div className="catalogo-form-actions"><button type="button" className="catalogo-secondary" disabled={guardandoCatalogo} onClick={() => { setFormArticuloVisible(false); setErrorCatalogo(''); }}>Cancelar</button><button type="submit" className="catalogo-primary" disabled={guardandoCatalogo}>{guardandoCatalogo ? 'Guardando…' : 'Guardar para reutilizar'}</button></div>
          </form>);

  const tablaClientesVisual = () => <section className="visual-client-table visual-card"><table><thead><tr><th>Nombre</th><th>Documento</th><th>Contacto</th><th>Acciones</th></tr></thead><tbody>{clientesPagina.map(c=><tr key={c.cliente_id}><td><span className="visual-client-name"><span>{c.nombre_razon_social.trim().split(/\s+/).slice(0,2).map(v=>v[0]).join('')}</span><strong>{c.nombre_razon_social}</strong></span></td><td>{c.cuit_cuil || 'Sin informar'}</td><td><small>{c.email}</small><small>{c.telefono}</small></td><td><div className="visual-row-actions"><button type="button" aria-label={`Ver perfil de ${c.nombre_razon_social}`} onClick={()=>abrirFichaClienteCompacta(c)}><IconoOficial nombre="eye"/></button><button type="button" aria-label={`Editar ${c.nombre_razon_social}`} onClick={()=>abrirEditorCliente(c)}><IconoOficial nombre="square-pen"/></button><button type="button" aria-label={`Eliminar ${c.nombre_razon_social}`} onClick={()=>eliminarCliente(c.cliente_id,c.nombre_razon_social)}><IconoOficial nombre="trash-2"/></button><button type="button" onClick={()=>abrirFichaClienteCompacta(c,true)}><IconoOficial nombre="history"/>Historial</button></div></td></tr>)}</tbody></table></section>;
  const panelCatalogoVisual = () => <section className="visual-catalog-page"><div className="visual-page-heading"><IconoOficial nombre="package-search"/><div><h2>Catálogo</h2><p>Administrá tus productos y servicios.</p></div>{!formArticuloVisible&&<button type="button" className="visual-primary" onClick={()=>prepararArticulo()}><IconoPanel name="plus"/>Agregar concepto</button>}</div><div className="visual-card">{errorCatalogo && <p role="alert">{errorCatalogo}</p>}{formArticuloVisible?formularioCatalogoVisual():<><label className="visual-search"><IconoBusqueda/><input aria-label="Buscar producto o servicio" placeholder="Buscar producto o servicio…" value={busquedaCatalogo} onChange={e=>setBusquedaCatalogo(e.target.value)} onKeyDown={e=>{if(e.key==='Escape'&&busquedaCatalogo){e.preventDefault();e.stopPropagation();setBusquedaCatalogo('');}}}/><LimpiarBusqueda visible={Boolean(busquedaCatalogo)} onLimpiar={()=>{setBusquedaCatalogo('');}} etiqueta="catálogo"/></label>{perfilForm.es_premium!==true?<div className="visual-catalog-free"><IconoOficial nombre="crown"/><p>Guardá tus productos y servicios para reutilizarlos en los presupuestos.</p><button type="button" className="visual-primary" onClick={activarPremium}>Contratar Premium</button></div>:<><div className="visual-catalog-table"><div className="visual-catalog-labels"><span>Concepto</span><span>Unidad</span><span>Precio</span><span>Acciones</span></div>{articulosCatalogo.filter(a=>a.descripcion.toLocaleLowerCase('es').includes(busquedaCatalogo.trim().toLocaleLowerCase('es'))).map(a=><div className="visual-catalog-row" key={a.id}><span className="reference-catalog-concept"><span className="reference-action-icon"><IconoOficial nombre="package-search"/></span><strong>{a.descripcion}</strong></span><span className="reference-unit">{abreviarUnidadPresupuesto(a.unidad)}</span><span>{importeDocumento(a.precio_unitario,a.moneda)}</span><div className="visual-row-actions"><button type="button" disabled={guardandoCatalogo} aria-label={`Editar ${a.descripcion}`} onClick={()=>prepararArticulo(a)}><IconoOficial nombre="square-pen"/></button><button type="button" disabled={guardandoCatalogo} aria-label={`Eliminar ${a.descripcion}`} onClick={()=>setEliminarArticuloId(a.id)}><IconoOficial nombre="trash-2"/></button></div>{eliminarArticuloId===a.id && <div className="catalogo-delete-confirm"><span>¿Eliminar este concepto?</span><button type="button" disabled={guardandoCatalogo} onClick={()=>void borrarArticuloCatalogo(a.id)}>Eliminar</button><button type="button" onClick={()=>setEliminarArticuloId(null)}>Cancelar</button></div>}</div>)}</div>{!articulosCatalogo.length&&<p className="visual-empty" role="status">Agregá tu primer producto o servicio desde Nuevo concepto.</p>}{articulosCatalogo.length>0&&!articulosCatalogo.some(a=>a.descripcion.toLocaleLowerCase('es').includes(busquedaCatalogo.trim().toLocaleLowerCase('es')))&&<p className="visual-empty" role="status">No hay productos o servicios que coincidan con tu búsqueda.</p>}</>}</>}</div></section>;
  const panelPremiumVisual = () => <section className="visual-premium-page"><div className="visual-page-heading"><div><h2>Tu plan y membresía</h2><p>Consultá las funciones y opciones de tu cuenta.</p></div></div><div className={`visual-plan-grid ${perfilForm.es_premium?'approved-current-plan':''}`}>{!perfilForm.es_premium&&<article className="visual-card"><h3>Free <span className="approved-badge">Plan actual</span></h3><ul>{['Gestión de presupuestos','Agenda de trabajos','Clientes'].map(t=><li key={t}><IconoOficial nombre="check"/>{t}</li>)}</ul><p className="approved-plan-note">Documentos con la marca de MiOficio.</p></article>}<article className="visual-card visual-premium-card"><h3>Premium {perfilForm.es_premium&&<span className="approved-badge aceptado">Plan actual</span>}</h3><p>{perfilForm.es_premium?'Funciones habilitadas en tu cuenta.':'Incluye Free y las siguientes funciones:'}</p><ul>{['Documentos sin marca de agua','Logo profesional en documentos','Catálogo de productos y servicios','Informes del negocio','Visitas recurrentes en Agenda'].map(t=><li key={t}><IconoOficial nombre="check"/>{t}</li>)}</ul>{!perfilForm.es_premium&&<button type="button" className="visual-primary" onClick={activarPremium}>Contratar Premium</button>}</article></div><details className="visual-premium-tools"><summary>Administrar membresía y herramientas<IconoOficial nombre="chevron-down"/></summary>{herramientasPremium()}</details></section>;

  const inicialesUsuario = user.name
    .split(' ')
    .map(n => n[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();

  const panelModalAbierto=fotoOrdenActiva!==null || showModalPresupuesto || showModalCliente || mostrarCuentaAcceso || selectorConsolidadoModelo || !!clientePdfPremium || !!rangoInicioEditor || detallePresupuestoId!==null || cobroObjetivo!==null || mostrarAyuda || presupuestoCreado!==null || movimientoCobro!==null || mostrarEntregas || selectorComprobante!==null || entregaGenerada!==null;

  useEffect(()=>{
    if(cargandoNube||panelModalAbierto)return;
    let frame=0;
    const medir=()=>{
      cancelAnimationFrame(frame);
      frame=requestAnimationFrame(()=>{
        const esMovil=window.matchMedia('(max-width:1023px)').matches;
        const raiz=document.getElementById('mioficio-dashboard');if(!raiz)return;
        const alto=window.visualViewport?.height||window.innerHeight;
        const barra=raiz.querySelector<HTMLElement>('.approved-bottom-nav');
        const pie=esMovil?(barra?.getBoundingClientRect().height||74):0;
        const calcular=(selector:string,fila:string,minimo:number,maximo:number,reserva:number)=>{
          const lista=raiz.querySelector<HTMLElement>(selector);if(!lista)return null;
          const item=lista.querySelector<HTMLElement>(fila);if(!item)return null;
          const top=lista.getBoundingClientRect().top+window.scrollY;
          const gap=parseFloat(getComputedStyle(lista).rowGap)||0;
          const altura=item.getBoundingClientRect().height+gap;
          if(altura<=0)return null;
          const columnas=getComputedStyle(lista).display==='grid'?Math.max(1,getComputedStyle(lista).gridTemplateColumns.split(' ').filter(Boolean).length):1;
          return Math.min(maximo,Math.max(minimo,Math.ceil((alto-pie-top-reserva)/altura)*columnas));
        };
        const clientes=calcular('.approved-client-list','.approved-client-card',3,20,56);
        const presupuestos=calcular('.approved-quote-list','.approved-quote-card',4,20,56)??calcular('.approved-table tbody','tr',4,20,56);
        const actividad=calcular('.ref-mobile-activity','.ref-event-row',4,8,48);
        setCapacidadPantalla(prev=>{const next={clientes:clientes??prev.clientes,presupuestos:presupuestos??prev.presupuestos,actividad:actividad??prev.actividad};return prev.clientes===next.clientes&&prev.presupuestos===next.presupuestos&&prev.actividad===next.actividad?prev:next;});
      });
    };
    const alRedimensionar=()=>{if(document.activeElement?.matches('input,textarea,select'))return;medir();};
    medir();window.addEventListener('resize',alRedimensionar);window.visualViewport?.addEventListener('resize',alRedimensionar);
    return()=>{cancelAnimationFrame(frame);window.removeEventListener('resize',alRedimensionar);window.visualViewport?.removeEventListener('resize',alRedimensionar);};
  },[activeTab,cargandoNube,panelModalAbierto,clientes.length,presupuestos.length,configuracionGuardada.ajustar_listas_pantalla]);


  const tecladoPestanasOrden=(e:React.KeyboardEvent<HTMLDivElement>)=>{
    if(!['ArrowLeft','ArrowRight','Home','End'].includes(e.key))return;
    const tabs=Array.from(e.currentTarget.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const actual=tabs.indexOf(document.activeElement as HTMLButtonElement);if(actual<0||!tabs.length)return;
    e.preventDefault();const siguiente=e.key==='Home'?0:e.key==='End'?tabs.length-1:(actual+(e.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length;
    tabs[siguiente].focus();tabs[siguiente].click();
  };
  const vistaOrdenesTrabajo=()=>{
    const orden=ordenSeleccionada;
    const elegibles=presupuestos.filter(p=>['Aceptado','Pagado'].includes(p.estado)&&!ordenesTrabajo.some(o=>o.presupuestoId===p.presupuesto_id));
    const consulta=busquedaOrdenes.trim().toLocaleLowerCase('es');
    const visibles=ordenesTrabajo.filter(o=>(filtroOrdenes==='Todas'||o.estado===filtroOrdenes)&&[o.numero,o.cliente,o.presupuestoNumero,o.titulo].join(' ').toLocaleLowerCase('es').includes(consulta)).sort((a,b)=>b.creadaAt.localeCompare(a.creadaAt));
    if(!orden)return <section className="wo-workspace" id="work-orders-panel" role="tabpanel" aria-labelledby="work-orders-tab">
      <div className="wo-section-heading"><div><h2>Órdenes de trabajo</h2><p>Organizá los trabajos de tus presupuestos aceptados.</p></div><span className="wo-count">{ordenesTrabajo.length} {ordenesTrabajo.length===1?'orden':'órdenes'}</span></div>
      <form className="wo-create-card" onSubmit={e=>{e.preventDefault();const p=presupuestos.find(item=>String(item.presupuesto_id)===presupuestoNuevaOrden);if(p)void crearOrdenTrabajo(p);}}>
        <div><label htmlFor="work-budget-select">Crear desde un presupuesto aceptado</label><select id="work-budget-select" value={presupuestoNuevaOrden} onChange={e=>setPresupuestoNuevaOrden(e.target.value)} disabled={guardandoOrden||!elegibles.length} required><option value="">{elegibles.length?'Seleccionar presupuesto':'No hay presupuestos aceptados sin orden'}</option>{elegibles.map(p=><option key={p.presupuesto_id} value={p.presupuesto_id}>{p.numero_presupuesto} · {p.cliente}</option>)}</select></div><button type="submit" className="wo-primary" disabled={guardandoOrden||!elegibles.some(p=>String(p.presupuesto_id)===presupuestoNuevaOrden)}><IconoOficial nombre="wrench"/>{guardandoOrden?'Guardando…':'Crear orden de trabajo'}</button>
      </form>
      <div className="wo-list-toolbar"><label className="wo-search"><IconoOficial nombre="search"/><input aria-label="Buscar orden de trabajo" placeholder="Cliente, orden o presupuesto" value={busquedaOrdenes} onChange={e=>setBusquedaOrdenes(e.target.value)} onKeyDown={e=>{if(e.key==='Escape')setBusquedaOrdenes('');}}/>{busquedaOrdenes&&<button type="button" aria-label="Limpiar búsqueda de órdenes" onClick={()=>setBusquedaOrdenes('')}><IconoOficial nombre="x"/></button>}</label><label className="wo-filter">Estado<select aria-label="Estado de las órdenes" value={filtroOrdenes} onChange={e=>setFiltroOrdenes(e.target.value)}>{['Todas','Pendiente','En curso','Terminado'].map(v=><option key={v}>{v}</option>)}</select></label></div>
      <div className="wo-order-list">{visibles.map(o=><button type="button" className="wo-order-row" key={o.id} aria-label={`Abrir orden ${o.numero}`} onClick={()=>abrirOrdenTrabajo(o)}><span className="wo-order-symbol"><IconoOficial nombre="wrench"/></span><span className="wo-order-copy"><strong>{o.titulo}</strong><span>{o.cliente}</span><small>{o.numero} · {o.presupuestoNumero}</small></span><span className="wo-order-end"><span className="wo-status" data-status={o.estado}>{o.estado}</span><strong>{ocultarMontosInicio?'••••••':importeDocumento(o.montoAcordado,o.moneda)}</strong><small>{Object.values(o.tareas||{}).filter(t=>t.realizada).length}/{Object.values(o.tareas||{}).length} trabajos realizados</small></span><IconoOficial nombre="chevron-right"/></button>)}</div>
      {!visibles.length&&<div className="wo-empty"><IconoOficial nombre="wrench"/><h3>{consulta||filtroOrdenes!=='Todas'?'No hay órdenes que coincidan':'Todavía no hay órdenes de trabajo'}</h3><p>{consulta||filtroOrdenes!=='Todas'?'Probá con otro cliente, número o estado.':'Seleccioná un presupuesto aceptado para cargar sus trabajos y comenzar.'}</p>{(consulta||filtroOrdenes!=='Todas')&&<button type="button" className="wo-secondary" onClick={()=>{setBusquedaOrdenes('');setFiltroOrdenes('Todas');}}>Limpiar filtros</button>}</div>}
    </section>;
    const tareas=Object.values(orden.tareas||{});
    const terminadas=tareas.filter(t=>t.realizada).length,completa=tareas.length>0&&terminadas===tareas.length;
    const origen=presupuestos.find(p=>p.presupuesto_id===orden.presupuestoId);
    const dinero=(importe:number)=>ocultarMontosInicio?'••••••':importeDocumento(importe,orden.moneda).replace(/^ARS\s+/,'');
    return <section className="wo-workspace" id="work-orders-panel" role="tabpanel" aria-labelledby="work-orders-tab" aria-busy={guardandoOrden} data-simple="true">
      <div className="wo-detail-heading"><div><button type="button" className="wo-back" onClick={()=>{setOrdenSeleccionadaId(null);setPestanaOrden('detalle');}}><IconoOficial nombre="chevron-left"/>Todas las órdenes</button><h2>Orden de trabajo <span>{orden.numero}</span></h2></div><span className="wo-status" data-status={orden.estado}>{orden.estado}</span></div>
      <div className="wo-budget-reference"><span>Presupuesto de referencia</span>{origen?<button type="button" onClick={()=>abrirDetallePresupuesto(origen)}>{orden.presupuestoNumero}<IconoOficial nombre="arrow-up-right"/></button>:<strong>{orden.presupuestoNumero}</strong>}</div>
      <section className="wo-hero"><div className="wo-identity"><div><h3>{orden.titulo}</h3><p>{orden.cliente}</p></div></div><div className="wo-hero-facts"><div><small>Monto acordado</small><strong className={dinero(orden.montoAcordado).length>18?'wo-money-long':undefined}>{dinero(orden.montoAcordado)}</strong></div><label htmlFor="work-schedule-date"><small>Fecha programada</small><span className="wo-date-control"><span aria-hidden="true">{orden.fechaProgramada?fechaCortaCompacta(orden.fechaProgramada):'Sin programar'}</span><IconoOficial nombre="calendar"/><input id="work-schedule-date" type="date" aria-label="Fecha programada del trabajo" value={orden.fechaProgramada} disabled={guardandoOrden} onChange={e=>{const fecha=e.target.value;if(!fecha||/^\d{4}-\d{2}-\d{2}$/.test(fecha))void guardarCambioOrden(orden.id,actual=>({...actual,fechaProgramada:fecha}),fecha?`Trabajo programado para ${fechaCortaCompacta(fecha)}.`:'Fecha programada quitada.');}}/></span></label></div></section>
      <section className="wo-card wo-simple-tasks" aria-labelledby="work-tasks-title"><div className="wo-card-heading"><h3 id="work-tasks-title">Trabajos a realizar</h3><small>{terminadas} de {tareas.length} realizados</small></div><div className="wo-tasks">{tareas.map(t=><label key={t.id} className="wo-task"><input type="checkbox" checked={t.realizada} disabled={guardandoOrden} onChange={e=>{const realizada=e.target.checked;void guardarCambioOrden(orden.id,actual=>({...actual,tareas:Object.values(actual.tareas||{}).map(item=>item.id===t.id?{...item,realizada}:item),estado:actual.estado==='Terminado'&&!realizada?'En curso':actual.estado==='Pendiente'&&realizada?'En curso':actual.estado}),`${realizada?'Trabajo realizado':'Trabajo pendiente'}: ${t.descripcion}`);}}/><span><strong>{t.descripcion}</strong><small>{t.cantidad} {abreviarUnidadPresupuesto(t.unidad)}</small></span></label>)}</div></section>
      <div className="wo-bottom-actions">{orden.estado==='Terminado'?<><span className="wo-complete"><IconoOficial nombre="check"/>Trabajo terminado</span><button type="button" className="wo-secondary" disabled={guardandoOrden} onClick={()=>void cambiarEstadoOrden(orden,'En curso')}>Reabrir trabajo</button>{origen&&['Aceptado','Pagado'].includes(origen.estado)&&<button type="button" className="wo-primary" onClick={()=>abrirEntregas(origen)}><IconoOficial nombre="file-text"/>Generar comprobante de trabajo</button>}</>:<><small>{completa?'Todos los trabajos están marcados como realizados.':`${tareas.length-terminadas} ${tareas.length-terminadas===1?'trabajo pendiente':'trabajos pendientes'} para terminar.`}</small><button type="button" className="wo-primary" disabled={guardandoOrden||!completa} onClick={()=>void cambiarEstadoOrden(orden,'Terminado')}>{guardandoOrden?'Guardando…':'Marcar como terminado'}<IconoOficial nombre="check"/></button></>}</div>
      <p className="wo-save-status" role="status" aria-live="polite">{guardandoOrden?'Guardando cambios…':'Cambios guardados en tu cuenta.'}</p>
    </section>;
  };

  if (cargandoNube) {
    return (
      <div className="min-h-screen bg-[#f8fafc] flex flex-col items-center justify-center space-y-3">
        <div className="w-8 h-8 border-4 border-blue-600 border-t-transparent rounded-full animate-spin"></div>
        <p className="text-xs font-bold text-slate-600">Preparando tu espacio de trabajo…</p>
      </div>
    );
  }


  const navegacionReferencia:{tab:string;label:string;icono:NombreIconoOficial}[]=[{tab:'dashboard',label:'Inicio',icono:'house'},{tab:'clientes',label:'Clientes',icono:'users'},{tab:'presupuestos',label:'Presupuestos',icono:'file-text'},{tab:'cobros',label:'Cobros',icono:'banknote'},{tab:'comprobantes',label:'Comprobantes',icono:'file-text'},{tab:'agenda',label:'Agenda',icono:'calendar'},{tab:'catalogo',label:'Catálogo',icono:'package-search'},{tab:'negocio',label:'Mi negocio',icono:'store'},{tab:'informes',label:'Informes',icono:'chart-no-axes-combined'},{tab:'menu',label:'Configuración',icono:'settings'}];
  const accesoHerramientasMembresia=(movil=false)=><div className={`ref-sidebar-bottom membership-tools-entry${movil?' membership-tools-mobile':''}`}><IconoOficial nombre="crown"/><strong>Tu membresía {perfilForm.es_premium?'Premium':'Free'}</strong><button type="button" aria-current={activeTab==='herramientas'?'page':undefined} onClick={()=>{setBusquedaHerramientas('');setFiltroHerramientas('todas');abrirMenuPrincipal('herramientas');}}>Ver herramientas<IconoOficial nombre="arrow-right"/></button></div>;
  const montoReferencia=(n:number)=>ocultarMontosInicio?'••••••':formatearMontoCompacto(n);
  const selectorPeriodoReferencia=()=> <div className="ref-period"><select aria-label="Período del resumen" value={periodoInicioModelo} onChange={e=>{const v=e.target.value as typeof periodoInicioModelo;cambiarPeriodoInicioModelo(v);if(v==='personalizado')setRangoInicioEditor({desde:desdeInicioModelo||hoyInicioModelo.slice(0,7)+'-01',hasta:hastaInicioModelo||hoyInicioModelo});}}><option value="mes">Este mes</option><option value="anio">Este año</option><option value="personalizado">Personalizado</option></select><IconoOficial nombre="chevron-down"/>{periodoInicioModelo==='personalizado'&&<button type="button" aria-label="Cambiar fechas del período personalizado" onClick={()=>setRangoInicioEditor({desde:desdeInicioModelo,hasta:hastaInicioModelo})}><IconoOficial nombre="calendar"/></button>}</div>;
  const resumenMovilReferencia=()=> <section className="m78-summary" aria-label="Resumen de cobros"><div className="m78-summary-top"><span>Cobros registrados</span>{selectorPeriodoReferencia()}</div><div className="m78-amount"><ImporteAdaptable>{montoReferencia(cobradoInicioModelo)}</ImporteAdaptable><button type="button" aria-label={ocultarMontosInicio?'Mostrar importes':'Ocultar importes'} onClick={()=>setOcultarMontosInicio(v=>!v)}><IconoOficial nombre="eye"/></button></div><small>Pagos menos devoluciones · {monedaCobrado}</small><button type="button" className="m78-pending" onClick={()=>{abrirMenuPrincipal('cobros');setBusquedaCobros('');}}><span><IconoOficial nombre="clock"/>Pendiente de cobro</span><ImporteAdaptable>{montoReferencia(pendienteInicioModelo)}</ImporteAdaptable><IconoOficial nombre="chevron-right"/></button></section>;

  const fechaAnteriorReferencia=new Date((periodoInicioModelo==='mes'?mesResumenReferencia+'-15':hoyInicioModelo)+'T12:00:00Z');
  if(periodoInicioModelo==='anio')fechaAnteriorReferencia.setUTCFullYear(fechaAnteriorReferencia.getUTCFullYear()-1);else fechaAnteriorReferencia.setUTCMonth(fechaAnteriorReferencia.getUTCMonth()-1);
  const claveAnteriorReferencia=fechaAnteriorReferencia.toISOString().slice(0,periodoInicioModelo==='anio'?4:7);
  const totalAnteriorReferencia=Math.round(movimientosFinancierosPresupuestos(presupuestos,monedaCobrado).filter(m=>m.fecha.slice(0,claveAnteriorReferencia.length)===claveAnteriorReferencia).reduce((n,m)=>n+m.importe,0)*100)/100;
  const comparacionReferencia=!ocultarMontosInicio&&periodoInicioModelo!=='personalizado'&&totalAnteriorReferencia>0?(cobradoInicioModelo-totalAnteriorReferencia)/totalAnteriorReferencia*100:null;
  const miniGraficoReferencia=()=>{
    if(ocultarMontosInicio||!graficoCobrosModelo.length)return null;
    const datos=graficoCobrosModelo.slice(-7),max=Math.max(0,...datos.map(c=>c.importe)),min=Math.min(0,...datos.map(c=>c.importe)),rango=max-min||1;
    return <svg className="ref-mini-chart ref-real-chart" viewBox="0 0 70 42" role="img" aria-label="Cobros y devoluciones reales por fecha"><title>{datos.map(c=>`${fechaCortaCompacta(c.fecha)}: ${importeDocumento(c.importe,monedaCobrado)}`).join('; ')}</title>{min<0&&<line x1="1" x2="68" y1={4+max/rango*32} y2={4+max/rango*32} stroke="#d9cce5" strokeWidth="1"/>}{datos.map((c,i)=><rect key={c.fecha} x={3+i*9} y={4+(max-Math.max(0,c.importe))/rango*32} width="5" height={Math.max(1,Math.abs(c.importe)/rango*32)} rx="2" fill={c.importe<0?'#b78c52':'currentColor'} opacity={.5+i/Math.max(1,datos.length-1)*.5}/>)}</svg>;
  };
  const cobrosRecientesReferencia=presupuestos.filter(p=>monedaPresupuesto(p.moneda)===monedaCobrado).flatMap(p=>{const cs=Object.values(p.cobros||{});const extra=Math.max(0,cobradoPresupuesto(p)-cs.reduce((s,c)=>s+Math.max(0,Number(c.importe)||0),0));return [...cs.filter(c=>Number(c.importe)>0).map(c=>({key:`${p.presupuesto_id}-${c.id}`,p,fecha:c.fecha,importe:c.importe,medio:c.medio,orden:c.registradoAt})),...(extra>0?[{key:`historico-${p.presupuesto_id}`,p,fecha:p.fecha_pago||p.fecha,importe:extra,medio:p.medio_pago_registrado||'Sin informar',orden:0}]:[])];}).sort((a,b)=>b.fecha.localeCompare(a.fecha)||b.orden-a.orden);
  const proximosReferencia=[...porVencerModelo.map(p=>({id:`p-${p.presupuesto_id}`,fecha:diasAgenda(p.fecha,Number(p.validez_dias)),titulo:'Presupuesto por vencer',detalle:p.numero_presupuesto,importe:monedaPresupuesto(p.moneda)===monedaCobrado?totalVigentePresupuesto(p):null,agenda:false,abrir:()=>abrirDetallePresupuesto(p)})),...Array.from({length:8},(_,i)=>diasAgenda(hoyInicioModelo,i)).flatMap(fecha=>citasDelDia(fecha).map(c=>({id:`c-${c.id}-${fecha}`,fecha,titulo:'Tarea en agenda',detalle:c.titulo,importe:null,agenda:true,abrir:()=>{abrirMenuPrincipal('agenda');setCitaSeleccionada(c);setDiaAgenda(fecha);setSemanaAgenda(lunesAgenda(fecha));}})))].sort((a,b)=>a.fecha.localeCompare(b.fecha));
  const filasReferencia=(limite:number,soloFinancieros=false)=>{
    const filas=actividadInicioModelo.filter(m=>!soloFinancieros||m.tipo!=='presupuesto').slice(0,limite);
    return filas.length?filas.map(m=>{
      const salida=m.tipo==='devolucion'||m.tipo==='correccion';
      const titulo=m.tipo==='pago'?'Pago recibido':m.tipo==='devolucion'?'Devolución realizada':m.tipo==='correccion'?'Pago corregido':'Emisión de presupuesto';
      const monto=ocultarMontosInicio?'••••••':`${m.tipo==='pago'?'+ ':salida?'− ':''}${monedaPresupuesto(m.presupuesto.moneda)==='ARS'?'':monedaPresupuesto(m.presupuesto.moneda)+' '}${formatearMontoCompacto(m.importe,monedaPresupuesto(m.presupuesto.moneda))}`;
      return <button type="button" className="ref-event-row" data-movement={m.tipo} key={m.id} aria-label={`${titulo}, ${m.presupuesto.cliente}, ${monto}, ${m.presupuesto.numero_presupuesto}`} onClick={()=>m.pagado?abrirCobro(m.presupuesto):abrirDetallePresupuesto(m.presupuesto)}><span className={`ref-round ${m.pagado?'green':salida?'orange':'violet'}`}><IconoOficial nombre={m.pagado?'banknote':salida?'arrow-up-right':'file-text'}/></span><span className="ref-row-copy"><strong>{titulo}</strong><small>{m.presupuesto.cliente||'Sin cliente'}</small><small className="ref-movement-reference">{m.presupuesto.numero_presupuesto}{m.medio?` · ${m.medio}`:''}</small></span><span className="ref-row-end">{m.tipo==='presupuesto'&&<small className="movement-document-label">Presupuestado</small>}<b className={m.pagado?'movement-credit':salida?'movement-debit':''}>{monto}</b><small>{fechaCortaCompacta(m.fecha)}</small></span><IconoOficial nombre="chevron-right"/></button>;
    }):<p className="ref-empty">{soloFinancieros?'Todavía no hay pagos ni devoluciones.':'Tu actividad aparecerá cuando comiences a trabajar.'}</p>;
  };
  const qReferencia=busquedaGeneralReferencia.trim().toLocaleLowerCase('es');
  const resultadosBusquedaReferencia:{id:string;titulo:string;detalle:string;icono:NombreIconoOficial;abrir:()=>void}[]=qReferencia?[...clientes.filter(c=>[c.nombre_razon_social,c.cuit_cuil,c.telefono].some(v=>(v||'').toLowerCase().includes(qReferencia))).slice(0,3).map(c=>({id:`cliente-${c.cliente_id}`,titulo:c.nombre_razon_social,detalle:'Cliente',icono:'users' as const,abrir:()=>{abrirMenuPrincipal('clientes');setBusquedaCliente(c.nombre_razon_social);setFichaClienteModelo(c.cliente_id);}})),...presupuestos.filter(p=>[p.numero_presupuesto,p.cliente,...(p.items||[]).map(i=>i.descripcion)].some(v=>(v||'').toLowerCase().includes(qReferencia))).slice(0,4).map(p=>({id:`p-${p.presupuesto_id}`,titulo:p.numero_presupuesto,detalle:p.cliente,icono:'file-text' as const,abrir:()=>abrirDetallePresupuesto(p)})),...cobrosRecientesReferencia.filter(c=>[c.p.cliente,c.p.numero_presupuesto,c.medio].some(v=>(v||'').toLowerCase().includes(qReferencia))).slice(0,3).map(c=>({id:`c-${c.key}`,titulo:`Cobro · ${c.p.cliente}`,detalle:`${c.medio||'Sin medio'} · ${fechaCortaCompacta(c.fecha)}`,icono:'banknote' as const,abrir:()=>abrirCobro(c.p)}))]:[];



  return (
    <>


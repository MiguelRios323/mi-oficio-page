        if(b.titulo==='Datos de pago')referenciasMediosPago.set(doc.getNumberOfPages(),{x:x(left),y:yy(ly),width:100*sx,height:altura*sy});
        font(true,9.5);doc.text(b.titulo==='Condiciones comerciales'?'CONDICIONES:':b.titulo==='Datos de pago'?'MEDIOS DE PAGO:':b.titulo.toUpperCase(),13,ly+5.5);
        let by=ly+10.5;

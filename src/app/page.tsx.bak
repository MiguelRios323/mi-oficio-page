#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-home-sidebar .approved-activity .approved-link{font-size:10px!important;gap:4px!important;flex-shrink:0}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-home-sidebar .approved-activity-row{gap:10px!important;align-items:flex-start!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-home-sidebar .approved-activity-row>span:nth-child(2){overflow-wrap:anywhere}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-home-sidebar .approved-activity-row>small{font-size:9px!important;white-space:nowrap}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-home-sidebar .approved-activity-row strong{font-size:11px!important;line-height:1.4!important}

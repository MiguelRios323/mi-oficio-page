@media(max-width:640px){.mi-oficio-ui.mioficio-model .premium-plan-dialog{max-width:420px!important}.mi-oficio-ui.mioficio-model .premium-plan-header{padding:14px 16px!important}.mi-oficio-ui.mioficio-model .premium-plan-body{grid-template-columns:1fr!important;padding:14px 16px!important;gap:12px!important}.mi-oficio-ui.mioficio-model .premium-plan-benefits{width:auto;padding:10px!important}.mi-oficio-ui.mioficio-model .premium-plan-benefit-list[data-expanded=true]{gap:10px}.mi-oficio-ui.mioficio-model .premium-plan-header h2{font-size:21px!important}}
@media(max-width:360px){.mi-oficio-ui.mioficio-model .premium-plan-overlay{padding:8px!important}.mi-oficio-ui.mioficio-model .premium-plan-dialog{max-height:calc(100dvh - 16px)!important}.mi-oficio-ui.mioficio-model .premium-plan-body{padding:12px!important}.mi-oficio-ui.mioficio-model .premium-plan-price{font-size:18px!important}}

/* Professional checkout: stable columns, compact pricing and clear payment choice. */
.mi-oficio-ui.mioficio-model .premium-plan-dialog{max-width:760px!important;background:#fff!important;border:1px solid #e2e8f0!important;box-shadow:0 24px 80px #0f172a26!important}
.mi-oficio-ui.mioficio-model .premium-plan-header{padding:22px 24px 18px!important;border-bottom:1px solid #eef2f6!important;background:#fff!important}
.mi-oficio-ui.mioficio-model .premium-plan-eyebrow{color:#2563eb!important;letter-spacing:.12em!important;font-size:10px!important;font-weight:700!important}
.mi-oficio-ui.mioficio-model .premium-plan-header h2{font-size:26px!important;letter-spacing:-.6px!important;color:#0f172a!important}
.mi-oficio-ui.mioficio-model .premium-plan-body{padding:20px 24px!important;gap:24px!important;grid-template-columns:minmax(0,.88fr) minmax(0,1.12fr)!important}
.mi-oficio-ui.mioficio-model .premium-plan-benefits{background:#f8fafc!important;border:1px solid #edf2f7!important;padding:16px!important;align-self:start!important}
.mi-oficio-ui.mioficio-model .premium-plan-benefit-list{display:grid;gap:15px!important}
.mi-oficio-ui.mioficio-model .premium-plan-benefit{display:grid!important;align-items:start!important}
.mi-oficio-ui.mioficio-model .premium-plan-benefit p{margin:3px 0 0!important;color:#64748b!important}
.mi-oficio-ui.mioficio-model .premium-plan-options{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px!important}
.mi-oficio-ui.mioficio-model .premium-plan-option{display:flex!important;flex-direction:column!important;align-items:stretch!important;text-align:left!important;background:#fff!important;border:1px solid #e2e8f0!important;min-width:0!important;min-height:91px!important;padding:12px!important;box-shadow:none!important}
.mi-oficio-ui.mioficio-model .premium-plan-option[aria-pressed=true]{border-color:#2563eb!important;background:#eff6ff!important;box-shadow:inset 0 0 0 1px #2563eb!important}
.mi-oficio-ui.mioficio-model .premium-plan-option-top{display:flex!important;justify-content:space-between!important;align-items:center!important}
.mi-oficio-ui.mioficio-model .premium-plan-price{display:block!important;font-size:21px!important;line-height:1.3!important;letter-spacing:-.4px!important}
.mi-oficio-ui.mioficio-model .premium-plan-price small{font-size:9px!important;color:#64748b!important;font-weight:500!important;letter-spacing:0!important}
.mi-oficio-ui.mioficio-model .premium-plan-duration{display:block!important;margin-top:3px!important;color:#64748b!important;font-size:11px!important}
.mi-oficio-ui.mioficio-model .premium-plan-summary{display:flex!important;justify-content:space-between!important;align-items:center!important;gap:10px!important;background:#f8fafc!important;padding:11px 12px!important;border-radius:8px!important}
.mi-oficio-ui.mioficio-model .premium-plan-summary small{display:block!important;margin-top:3px!important;font-size:10px!important;color:#64748b!important}
.mi-oficio-ui.mioficio-model .premium-plan-summary strong{font-size:21px!important;white-space:nowrap!important}
.mi-oficio-ui.mioficio-model .premium-payment-label{margin:0 0 8px!important;font-size:11px!important;font-weight:600!important;color:#334155!important}
.mi-oficio-ui.mioficio-model .premium-plan-security{display:flex!important;align-items:center!important;justify-content:center!important;gap:6px!important;font-size:11px!important;margin-top:14px!important}
.mi-oficio-ui.mioficio-model .premium-plan-privacy{text-align:center!important;font-size:10px!important;margin:4px 0 12px!important}
.mi-oficio-ui.mioficio-model .premium-plan-pay{width:100%!important;display:flex!important;align-items:center!important;justify-content:center!important;gap:10px!important;border-radius:9px!important;white-space:normal!important;line-height:1.3!important;padding:10px 14px!important;height:auto!important;min-height:44px!important}
.mi-oficio-ui.mioficio-model .premium-plan-pay svg{width:17px!important;height:17px!important;flex-shrink:0!important}
@media(max-width:640px){.mi-oficio-ui.mioficio-model .premium-plan-body{grid-template-columns:minmax(0,1fr)!important;padding:16px!important;gap:16px!important}.mi-oficio-ui.mioficio-model .premium-plan-header{padding:18px 16px!important}.mi-oficio-ui.mioficio-model .premium-plan-header h2{font-size:23px!important}.mi-oficio-ui.mioficio-model .premium-plan-benefit-list[data-expanded=false]{display:none!important}.mi-oficio-ui.mioficio-model .premium-plan-benefits{width:100%!important}.mi-oficio-ui.mioficio-model .premium-plan-subtitle{max-width:280px!important}}

.premium-plan-dialog .premium-plan-summary{background:transparent!important;border-bottom:1px solid #e2e8f0!important;border-radius:0!important;padding:12px 0 14px!important;margin:6px 0 14px!important}
.premium-plan-dialog .premium-plan-summary div>span{display:block;font-size:12px;color:#64748b}
.premium-plan-dialog .premium-plan-summary small{display:block!important;margin-top:4px!important;font-size:11px!important;color:#64748b!important}
.premium-plan-dialog .premium-plan-summary strong{font-size:25px!important;letter-spacing:-.7px}
.premium-plan-dialog .premium-renewal-options{border:0!important;background:transparent!important;padding:0!important;margin:0 0 14px!important}
.premium-plan-dialog .premium-payment-label{font-size:12px!important;font-weight:600!important;margin-bottom:8px!important}
.premium-plan-dialog .premium-renewal-choice{display:grid!important;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px!important}
.premium-plan-dialog .premium-renewal-choice button{display:flex!important;align-items:center!important;justify-content:flex-start!important;text-align:left!important;gap:8px!important;padding:10px!important;min-height:58px!important;border-radius:8px!important;font-weight:600!important;font-size:12px!important}
.premium-plan-dialog .premium-renewal-choice button small{display:block!important;font-size:10px!important;font-weight:400!important;margin-top:3px!important;color:#64748b!important}
.premium-plan-dialog .premium-choice-dot{width:13px;height:13px;border:1px solid #cbd5e1;border-radius:50%;flex:0 0 13px;background:#fff}
.premium-plan-dialog button[aria-pressed=true] .premium-choice-dot{border:4px solid #2563eb}
.premium-plan-dialog .premium-renewal-options>p{font-size:10px!important;margin:7px 0 0!important}
.premium-plan-dialog .premium-plan-security{margin-top:12px!important;font-size:10px!important;color:#64748b!important}
.premium-plan-dialog .premium-plan-security svg{width:13px!important;height:13px!important;flex-shrink:0}
.premium-plan-dialog .premium-plan-privacy{font-size:9px!important;margin-bottom:10px!important}
.premium-plan-dialog .premium-plan-pay{font-size:13px!important;min-height:42px!important;height:42px!important;box-shadow:none!important;position:static!important}

.premium-plan-dialog .premium-plan-benefit-list[data-expanded=false]{display:none!important}
.premium-plan-dialog .premium-tools-disclosure{display:flex!important;align-items:center!important;justify-content:flex-start!important;gap:8px!important;width:100%!important;margin:0!important;padding:10px!important;text-align:left!important;white-space:normal!important}
.premium-plan-dialog .premium-tools-disclosure>span{flex:1;min-width:0}
.premium-plan-dialog .premium-tools-disclosure svg{width:17px!important;height:17px!important;flex:0 0 17px}
.premium-plan-dialog .premium-tools-disclosure[aria-expanded=true]>svg:last-child{transform:rotate(180deg)}
.premium-plan-dialog .premium-included-title{display:block!important;margin:16px 0 12px!important}

@media(min-width:641px){
.premium-plan-dialog .premium-plan-body{grid-template-columns:minmax(0,1fr)!important}
.premium-plan-dialog .premium-plan-benefits{width:100%!important;padding:10px 12px!important}
.premium-plan-dialog .premium-plan-options{grid-template-columns:repeat(4,minmax(0,1fr))!important}
.premium-plan-dialog .premium-payment-fields[data-monthly=true]{display:grid!important;grid-template-columns:minmax(0,1.45fr) minmax(0,1fr)!important;gap:20px!important;align-items:start!important}
.premium-plan-dialog .premium-payment-fields .premium-document-field{margin:0!important;padding-top:0!important;font-size:12px!important}
.premium-plan-dialog .premium-payment-fields .premium-document-field input{margin-top:3px!important;height:58px!important;min-height:58px!important}
.premium-plan-dialog .premium-renewal-options{margin:0!important}
.premium-plan-dialog .premium-plan-security{margin-top:16px!important}
}
@media(max-width:640px){.premium-plan-dialog .premium-payment-fields{display:grid!important;gap:12px!important}.premium-plan-dialog .premium-document-field{margin:0!important}}

/* One authoritative layout, overriding legacy modal rules. */
#premium-purchase-panel{width:min(900px,calc(100vw - 32px))!important;max-width:900px!important;max-height:calc(100dvh - 24px)!important;border-radius:14px!important}
#premium-purchase-panel .premium-plan-header{padding:16px 20px!important}
#premium-purchase-panel .premium-plan-header h2{font-size:23px!important;line-height:1.2!important;margin:0!important}
#premium-purchase-panel .premium-plan-subtitle{font-size:11px!important;line-height:1.4!important}
#premium-purchase-panel .premium-plan-body{display:grid!important;grid-template-columns:minmax(0,1.8fr) minmax(0,1fr)!important;gap:20px!important;padding:18px 20px!important;align-items:start!important}
#premium-purchase-panel .premium-plan-checkout{order:0!important;min-width:0!important}
#premium-purchase-panel .premium-plan-benefits{order:1!important;min-width:0!important;width:100%!important;padding:12px!important;align-self:start!important}
#premium-purchase-panel .premium-plan-options{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:7px!important}
#premium-purchase-panel .premium-plan-option{min-height:80px!important;padding:9px!important}
#premium-purchase-panel .premium-plan-price{font-size:18px!important;letter-spacing:-.4px!important}
#premium-purchase-panel .premium-plan-price small{display:none!important}
#premium-purchase-panel .premium-plan-name{font-size:11px!important}
#premium-purchase-panel .premium-plan-duration{font-size:9px!important;white-space:nowrap!important}
#premium-purchase-panel .premium-plan-summary{margin:8px 0 12px!important;padding:8px 0!important}
#premium-purchase-panel .premium-plan-summary strong{font-size:23px!important}
#premium-purchase-panel .premium-payment-fields{display:grid!important;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr)!important;gap:12px!important;align-items:start!important}
#premium-purchase-panel .premium-payment-fields[data-monthly=false]{grid-template-columns:minmax(0,1fr)!important}
#premium-purchase-panel .premium-document-field{margin:0!important;font-size:11px!important;gap:8px!important}
#premium-purchase-panel .premium-document-field input{height:54px!important;min-height:54px!important;font-size:13px!important;padding:10px!important;margin:0!important}
#premium-purchase-panel .premium-renewal-options{background:transparent!important;border:0!important;padding:0!important;margin:0!important}
#premium-purchase-panel .premium-payment-label{font-size:11px!important;margin:0 0 8px!important}
#premium-purchase-panel .premium-renewal-choice{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:6px!important}
#premium-purchase-panel .premium-renewal-choice button{padding:8px!important;gap:6px!important;min-height:54px!important;font-size:10px!important;word-break:normal!important;overflow-wrap:normal!important;line-height:1.3!important}
#premium-purchase-panel .premium-renewal-choice button>span:last-child{white-space:nowrap!important;min-width:0!important}
#premium-purchase-panel .premium-renewal-choice button small{font-size:8px!important;white-space:normal!important}
#premium-purchase-panel .premium-choice-dot{width:11px!important;height:11px!important;flex-basis:11px!important}
#premium-purchase-panel .premium-renewal-consent{font-size:10px!important;line-height:1.4!important;margin:8px 0!important}
#premium-purchase-panel .premium-plan-security{margin:12px 0 0!important;font-size:10px!important}
#premium-purchase-panel .premium-plan-privacy{font-size:9px!important;margin:3px 0 10px!important}
#premium-purchase-panel .premium-plan-pay{height:40px!important;min-height:40px!important;font-size:12px!important;position:static!important}
#premium-purchase-panel .premium-plan-benefit-list{gap:10px!important}
#premium-purchase-panel .premium-plan-benefit{grid-template-columns:24px minmax(0,1fr)!important;gap:7px!important}
#premium-purchase-panel .premium-plan-benefit-icon{width:24px!important;height:24px!important}
#premium-purchase-panel .premium-plan-benefit strong{font-size:11px!important}
#premium-purchase-panel .premium-plan-benefit p{font-size:10px!important;line-height:1.35!important}
#premium-purchase-panel .premium-plan-included{font-size:10px!important;margin:10px 0 0!important}
#premium-purchase-panel .premium-tools-disclosure{font-size:11px!important;padding:8px!important}
@media(max-width:760px){#premium-purchase-panel .premium-plan-body{grid-template-columns:minmax(0,1fr)!important;padding:14px!important;gap:12px!important}#premium-purchase-panel .premium-plan-benefits{order:1!important}#premium-purchase-panel .premium-plan-header{padding:14px!important}}
@media(max-width:430px){#premium-purchase-panel .premium-plan-options{grid-template-columns:repeat(2,minmax(0,1fr))!important}#premium-purchase-panel .premium-payment-fields{grid-template-columns:minmax(0,1fr)!important}#premium-purchase-panel .premium-plan-option{min-height:67px!important}#premium-purchase-panel .premium-plan-price{font-size:19px!important}}

#premium-purchase-panel .premium-purchase-footer{flex-shrink:0!important;display:grid!important;grid-template-columns:minmax(0,1fr) minmax(200px,.8fr)!important;align-items:center!important;column-gap:20px!important;padding:12px 20px!important;border-top:1px solid #e2e8f0!important;background:#fff!important;position:relative!important;z-index:2!important}
#premium-purchase-panel .premium-purchase-footer .premium-plan-security{grid-column:1!important;grid-row:1!important;justify-content:flex-start!important;margin:0!important}
#premium-purchase-panel .premium-purchase-footer .premium-plan-privacy{grid-column:1!important;grid-row:2!important;text-align:left!important;margin:3px 0 0!important}
#premium-purchase-panel .premium-purchase-footer .premium-plan-pay{grid-column:2!important;grid-row:1 / 3!important;margin:0!important;position:static!important;min-height:42px!important;height:auto!important}
@media(max-width:480px){#premium-purchase-panel .premium-purchase-footer{grid-template-columns:minmax(0,1fr)!important;padding:10px 14px!important;gap:4px!important}#premium-purchase-panel .premium-purchase-footer .premium-plan-pay{grid-column:1!important;grid-row:1!important}#premium-purchase-panel .premium-purchase-footer .premium-plan-security{grid-row:2!important;justify-content:center!important;margin-top:4px!important}#premium-purchase-panel .premium-purchase-footer .premium-plan-privacy{display:none!important}}

@media(max-width:640px){
.mi-oficio-ui .quotes-mobile-filters{display:flex!important;flex-wrap:wrap!important;gap:5px!important;overflow:visible!important}
.mi-oficio-ui .quotes-mobile-filters .budget-status-filter{min-width:0!important;flex:0 1 auto!important;padding:7px 9px!important;font-size:11px!important;line-height:1.3!important;gap:4px!important;white-space:nowrap!important}
.mi-oficio-ui .quotes-mobile-filters .budget-status-filter svg{width:13px!important;height:13px!important;flex-shrink:0!important}
#premium-purchase-panel{width:calc(100vw - 20px)!important;max-height:calc(100dvh - 20px)!important}
#premium-purchase-panel .premium-plan-header{padding:12px 14px!important}
#premium-purchase-panel .premium-plan-header h2{font-size:21px!important}
#premium-purchase-panel .premium-plan-body{padding:12px 14px!important;gap:10px!important}
#premium-purchase-panel .premium-plan-options{grid-template-columns:repeat(2,minmax(0,1fr))!important}
#premium-purchase-panel .premium-plan-option{min-height:65px!important;padding:8px 10px!important}
#premium-purchase-panel .premium-plan-price{font-size:19px!important;margin-top:2px!important}
#premium-purchase-panel .premium-plan-summary{margin:5px 0 9px!important;padding:7px 0!important}
#premium-purchase-panel .premium-payment-fields{grid-template-columns:minmax(0,1fr)!important;gap:9px!important}
#premium-purchase-panel .premium-renewal-choice button{min-height:45px!important;font-size:11px!important;padding:8px!important}
#premium-purchase-panel .premium-document-field input{height:38px!important;min-height:38px!important}
#premium-purchase-panel .premium-renewal-consent{font-size:10px!important;gap:7px!important}
#premium-purchase-panel .premium-plan-benefits{padding:8px!important}
#premium-purchase-panel .premium-plan-included{display:none!important}
#premium-purchase-panel .premium-plan-benefit-list[data-expanded=true]{display:grid!important;grid-template-columns:minmax(0,1fr)!important}
}
`}</style>
          <div id="premium-purchase-panel" className="premium-plan-dialog" role="dialog" aria-modal="true" aria-labelledby="premium-plan-title" aria-describedby="premium-plan-description" onClick={event => event.stopPropagation()}>
            <div className="premium-plan-header">
              <div><p className="premium-plan-eyebrow">Premium</p><h2 id="premium-plan-title">Elegí tu plan</h2><p id="premium-plan-description" className="premium-plan-subtitle">Herramientas profesionales, en un plan a tu medida.</p></div>
              <button type="button" className="premium-plan-close" aria-label="Cerrar planes" disabled={procesandoPago} onClick={() => setShowModalPremium(false)}><IconoCerrar /></button>
            </div>
            <div className="premium-plan-body">
              <section className="premium-plan-benefits" aria-label="Funciones incluidas">
                <button type="button" className="premium-gallery-open premium-tools-disclosure" aria-expanded={verBeneficiosPremium} aria-controls="premium-benefits-content" onClick={() => setVerBeneficiosPremium(!verBeneficiosPremium)}><IconoOficial nombre="eye" width={18} /><span>{verBeneficiosPremium ? 'Ocultar herramientas Premium' : 'Ver herramientas Premium'}</span><IconoLanding nombre="desplegar" /></button>
                {verBeneficiosPremium && <h3 className="premium-benefits-heading premium-included-title">Incluido en todos los planes</h3>}
                <div id="premium-benefits-content" className="premium-plan-benefit-list" data-expanded={verBeneficiosPremium}>{[
                  { title: 'Tu logo en el PDF', description: 'Documentos con tu logo y sin marca de agua.', icon: 'logo' as const, example: 0 },
                  { title: 'Numeración y series', description: 'Organizá la identificación de tus presupuestos.', icon: 'series' as const, example: 2 },
                  { title: 'Presupuestos en un único PDF', description: 'Reuní los de un mismo cliente.', icon: 'unir' as const, example: 3 },
                  { title: 'Mis productos y servicios', description: 'Reutilizá descripción, unidad, precio e IVA.', icon: 'catalogo' as const, example: 4 },
                  { title: 'Exportación de datos', description: 'Clientes y presupuestos a CSV para Excel.', icon: 'exportar' as const, example: 5 },

                ].map(benefit => <div className="premium-plan-benefit" key={benefit.title}><span className="premium-plan-benefit-icon"><IconoLanding nombre={benefit.icon} /></span><div><strong>{benefit.title}</strong><p>{benefit.description}</p></div></div>)}</div>

                <p className="premium-plan-included">Acceso completo durante el período contratado.</p>
              </section>
              <div className="premium-plan-checkout">
                <h3 className="premium-checkout-title">Seleccioná tu plan</h3>
                <div className="premium-plan-options" role="group" aria-label="Duración del plan Premium">
                  {[
                    { id: 'daily', label: 'Diario', price: '$ 399', duration: '1 día de acceso' },
                    { id: 'weekly', label: 'Semanal', price: '$ 2.799', duration: '7 días de acceso' },
                    { id: 'monthly', label: 'Mensual', price: '$ 11.999', duration: '30 días de acceso' },
                    { id: 'yearly', label: 'Anual', price: '$ 139.999', duration: '365 días de acceso' },
                  ].map(plan => <button key={plan.id} type="button" className="premium-plan-option" data-popular={plan.id === 'yearly' ? 'true' : undefined} aria-pressed={planPremium === plan.id} disabled={procesandoPago} onClick={() => {setPlanPremium(plan.id as 'daily' | 'weekly' | 'monthly' | 'yearly');setConsentimientoRenovacion(false);}}><span className="premium-plan-option-top"><span className="premium-plan-name">{plan.label}</span><span className="premium-plan-radio" aria-hidden="true" /></span><span className="premium-plan-price">{plan.price} <small>ARS</small></span><span className="premium-plan-duration">{plan.duration}</span></button>)}
                </div>
                <div className="premium-plan-summary"><div><span>Importe a pagar</span><small>{planPremium==='monthly'&&renovacionMensual?'Renovación mensual · ARS':'Pago único · ARS'}</small></div><strong>{planPremium === 'daily' ? '$ 399' : planPremium === 'weekly' ? '$ 2.799' : planPremium === 'monthly' ? '$ 11.999' : '$ 139.999'}</strong></div>
                <div className="premium-payment-fields" data-monthly={planPremium==='monthly'}>
                {planPremium==='monthly'&&<div className="premium-renewal-options"><h4 className="premium-payment-label">Cómo querés pagar</h4><div className="premium-renewal-choice"><button type="button" aria-pressed={!renovacionMensual} disabled={procesandoPago} onClick={()=>{setRenovacionMensual(false);setConsentimientoRenovacion(false);}}><span className="premium-choice-dot" aria-hidden="true"/><span>Una sola vez<small>30 días de acceso</small></span></button><button type="button" aria-pressed={renovacionMensual} disabled={procesandoPago} onClick={()=>{setRenovacionMensual(true);setConsentimientoRenovacion(false);}}><span className="premium-choice-dot" aria-hidden="true"/><span>Mensualmente<small>Renovación automática</small></span></button></div>{renovacionMensual?<><p>Cancelá la renovación cuando quieras. Conservás el período pagado.</p><label className="premium-renewal-consent"><input type="checkbox" checked={consentimientoRenovacion} disabled={procesandoPago} onChange={e=>setConsentimientoRenovacion(e.target.checked)}/><span>Autorizo el cobro automático de $ 11.999 ARS por mes hasta cancelar.</span></label></>:<p>Sin renovación ni cobros posteriores.</p>}</div>}
                <label className="premium-document-field" style={{display:'grid',gap:5,fontSize:12,margin:'10px 0'}}>CUIT / DNI del titular<input className="field model-input" inputMode="numeric" maxLength={11} value={perfilForm.cuit_cuil || ''} onChange={e => setPerfilForm(prev => ({...prev,cuit_cuil:e.target.value.replace(/\D/g,'').slice(0,11)}))} placeholder="Ingresá tu documento" autoComplete="off" /></label>
                </div>
                {errorTarjeta && <div className="premium-plan-error" role="alert">{errorTarjeta}</div>}

              </div>
            </div>
            <div className="premium-purchase-footer">
                <div className="premium-plan-security"><IconoOficial nombre="lock-keyhole" className="w-3.5 h-3.5" />Pago seguro con Mercado Pago</div>
                <p className="premium-plan-privacy">Los datos de tu tarjeta están protegidos por Mercado Pago.</p>
                <button type="button" className="premium-plan-pay" onClick={pagarPremiumConTarjeta} disabled={procesandoPago}>{procesandoPago ? 'Preparando pago…' : planPremium==='monthly'&&renovacionMensual?'Contratar suscripción':'Continuar al pago'}<IconoOficial nombre="arrow-right"  /></button>
            </div>
          </div>
        </div>
      )}

        </div>
      </main>

      {avisoPagoMercado && <div role="status" style={{position:'fixed',bottom:90,left:'50%',transform:'translateX(-50%)',width:'min(420px, calc(100% - 32px))',padding:'12px 16px',border:'1px solid #dbeafe',borderRadius:14,background:'#eff6ff',color:'#1e3a8a',fontSize:13,zIndex:90,boxShadow:'0 6px 24px #0f172a16'}}>{avisoPagoMercado}<button type="button" aria-label="Cerrar aviso" onClick={() => setAvisoPagoMercado('')} style={{marginLeft:8,fontWeight:600}}>Cerrar</button></div>}


      <style>{`@media(max-width:1023px){#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .ref-home{gap:10px!important;}#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .ref-mobile-activity .ref-event-row{min-height:54px!important;height:auto!important;padding:6px 0!important;}#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .ref-mobile-activity .ref-row-copy{display:grid!important;gap:2px!important;}#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .ref-mobile-activity .ref-row-copy>*{margin:0!important;}#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .ref-mobile-activity .ref-row-copy strong{font-size:12px!important;line-height:1.3!important;}#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .ref-mobile-activity .ref-row-copy small{font-size:10px!important;line-height:1.25!important;}}`}</style>

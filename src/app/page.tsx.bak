#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-reversals strong{font-size:12px!important;display:block!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-reversals small{font-size:11px!important;display:block!important;margin-top:4px!important;color:#8b7b94!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-reversals summary{font-size:11px!important;margin-top:8px!important;cursor:pointer!important;color:#7751ad!important}

/* V9: importe y cantidad juntos, sin una segunda tarjeta de pendientes. */
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-expiry-notice{display:flex!important;align-items:center!important;gap:8px!important;width:100%!important;margin:12px 0 0!important;padding:10px 12px!important;min-height:36px!important;background:#faf5ec!important;border:0!important;border-radius:10px!important;color:#91662a!important;font-size:11px!important;font-weight:500!important;box-shadow:none!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-expiry-notice>span{flex:1!important;text-align:left!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-expiry-notice>svg{width:15px!important;height:15px!important;min-width:15px!important}

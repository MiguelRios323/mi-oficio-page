  ).sort((a,b)=>ordenClientesModelo==='nombre'?a.nombre_razon_social.localeCompare(b.nombre_razon_social,'es'):b.cliente_id-a.cliente_id);
  const totalPaginasClientes = Math.max(1, Math.ceil(clientesFiltrados.length / porPaginaClientes));
  const paginaClientesActual = Math.min(paginaClientes, totalPaginasClientes);
  const inicioClientes = (paginaClientesActual - 1) * porPaginaClientes;
  const clientesPagina = clientesFiltrados.slice(inicioClientes, inicioClientes + porPaginaClientes);

  const presupuestosFiltradosCompactos = [...presupuestos].filter(p => {

#mioficio-dashboard.mio-compact-v2{font-weight:400;--compact-border:#e7e2f5;--compact-radius:12px}
#mioficio-dashboard.mio-compact-v2 .compact-topbar-title{display:flex;align-items:center;flex:1;gap:12px}
#mioficio-dashboard.mio-compact-v2 .compact-topbar-search{width:min(100%,360px);background:#fbfaff}
#mioficio-dashboard.mio-compact-v2 .compact-topbar-actions{margin-left:auto}
#mioficio-dashboard.mio-compact-v2 .compact-content :is(h1,h2,h3,h4){font-weight:600!important}
#mioficio-dashboard.mio-compact-v2 .compact-content :is(button,label,th){font-weight:500}
#mioficio-dashboard.mio-compact-v2 .compact-content :is(input,select,textarea){font-weight:400!important}
#mioficio-dashboard.mio-compact-v2 :is(.compact-card,.inicio-recent,.profile-v2-section,.premium-hub-card){border-color:var(--compact-border)!important;border-radius:var(--compact-radius)!important}
#mioficio-dashboard.mio-compact-v2 :is(.compact-card,.inicio-recent){padding:16px!important}
#mioficio-dashboard.mio-compact-v2 .compact-home-panels>.inicio-recent{align-self:start;height:auto;min-height:0!important}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-header{border-bottom:0!important}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-header h2{font-size:16px!important}
#mioficio-dashboard.mio-compact-v2 .compact-card h2{font-size:16px!important}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-row{text-align:left;width:100%;cursor:pointer}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-row:hover{background:#faf8ff!important}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-copy strong{font-weight:500!important}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-empty{padding:18px 10px}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-empty svg{color:var(--compact-violet)}
#mioficio-dashboard.mio-compact-v2 #perfil-profesional{max-width:none!important}
#mioficio-dashboard.mio-compact-v2 #perfil-profesional .profile-v2-card{gap:0!important}
#mioficio-dashboard.mio-compact-v2 #perfil-profesional .profile-v2-label{font-weight:500!important;text-transform:none!important;letter-spacing:0!important}
#mioficio-dashboard.mio-compact-v2 #perfil-profesional .profile-v2-transfer h4{font-size:12px!important;font-weight:500!important;color:var(--compact-muted)!important}
#mioficio-dashboard.mio-compact-v2 .premium-hub{max-width:none!important}
#mioficio-dashboard.mio-compact-v2 .premium-hub-heading h2{display:block!important;font-size:24px!important;line-height:1.25!important}
#mioficio-dashboard.mio-compact-v2 .compact-table .budget-state-trigger{width:112px!important;min-width:112px!important;max-width:none!important}
#mioficio-dashboard.mio-compact-v2 :is(.budget-generator,.client-v2,.catalogo-dialog,.series-dialog,.logo-config-dialog,.rubro-v2-card) :is(input,select,textarea):not([type=checkbox]):not([type=radio]):not([type=file]):not([type=range]){background:#fbfaff!important;border-color:#ded2ef!important;color:var(--compact-ink)!important}
#mioficio-dashboard.mio-compact-v2 input:is([type=checkbox],[type=radio]){accent-color:var(--compact-violet)!important}
@media(min-width:1024px){
#mioficio-dashboard.mio-compact-v2 .compact-list-toolbar>.compact-search{display:none!important}
#mioficio-dashboard.mio-compact-v2 .compact-clients-page>.compact-list-toolbar{display:none!important}
}
@media(max-width:1023px){
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-header h2,#mioficio-dashboard.mio-compact-v2 .compact-card h2{font-size:14px!important}
#mioficio-dashboard.mio-compact-v2 .premium-hub-heading h2{font-size:19px!important}
#mioficio-dashboard.mio-compact-v2 :is(.compact-card,.inicio-recent){padding:14px!important}
}

/* Clientes: tarjetas compactas y más registros por página en escritorio. */
#mioficio-dashboard.mio-compact-v2 .compact-client-grid{align-items:start;gap:12px}
#mioficio-dashboard.mio-compact-v2 .compact-client-card{padding:14px!important;min-height:0!important;height:auto!important}
#mioficio-dashboard.mio-compact-v2 .compact-client-heading{gap:9px}
#mioficio-dashboard.mio-compact-v2 .compact-client-heading h2{font-size:14px!important}
#mioficio-dashboard.mio-compact-v2 .compact-client-avatar{width:32px;height:32px;flex-basis:32px;font-size:11px}
#mioficio-dashboard.mio-compact-v2 .compact-client-data{margin:12px 0;gap:9px 12px}
#mioficio-dashboard.mio-compact-v2 .compact-client-data dt{margin-bottom:2px}
#mioficio-dashboard.mio-compact-v2 .compact-client-history{min-height:32px!important;padding:7px 9px!important}
#mioficio-dashboard.mio-compact-v2 .compact-clients-page{gap:12px}
#mioficio-dashboard.mio-compact-v2 .compact-clients-page .compact-pagination{padding:0}
@media(min-width:1280px){#mioficio-dashboard.mio-compact-v2 .compact-client-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:1023px){#mioficio-dashboard.mio-compact-v2 .compact-client-data{grid-template-columns:repeat(2,minmax(0,1fr))}}

/* MiOficio: estructura inspirada en la referencia, compartida en PC y móvil. */
#mioficio-dashboard.reference-ui{--compact-violet:#6047f4;--compact-ink:#292634;--compact-muted:#89869b;--compact-border:#e6e4f1;--compact-radius:16px;background:#edf0ff!important}
#mioficio-dashboard.reference-ui .compact-upsell{background:white!important;box-shadow:0 2px 0 #ced5f7;padding:12px 16px!important;border-color:#e2def5!important;color:#6047f4!important}
#mioficio-dashboard.reference-ui .compact-page-heading h1,#mioficio-dashboard.reference-ui .premium-hub-heading h2{color:white!important}
#mioficio-dashboard.reference-ui .premium-hub-heading p{color:#e8e2ff!important}
#mioficio-dashboard.reference-ui .compact-page-heading .compact-member{color:#ede6ff!important}
#mioficio-dashboard.reference-ui .compact-filters button{background:white!important;border-color:#e3def5!important}
#mioficio-dashboard.reference-ui .compact-filters button[aria-pressed=true]{background:#6047f4!important;color:white!important}
@media(min-width:1024px){
#mioficio-dashboard.reference-ui .compact-primary{background:white!important;color:#6047f4!important;border-color:#e3dcff!important}
}
@media(max-width:1023px){
}

/* Inicio: navegación única y acciones centradas en crear. */
@media(max-width:1023px){
}


#mioficio-dashboard.reference-ui :is(.business-completion,.personal-profile>.compact-card,.business-personal-link){background:white;border:1px solid var(--compact-border);border-radius:16px;padding:16px}
#mioficio-dashboard.reference-ui .business-completion{margin-bottom:14px}
#mioficio-dashboard.reference-ui .business-completion strong{font-size:14px;font-weight:500}
#mioficio-dashboard.reference-ui .business-completion p,#mioficio-dashboard.reference-ui .business-tools p{font-size:12px!important;color:#89869b;margin:4px 0 14px}
#mioficio-dashboard.reference-ui :is(.business-checklist,.business-tool-grid){display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
#mioficio-dashboard.reference-ui :is(.business-checklist,.business-tool-grid)>button{display:flex;align-items:center;gap:8px;padding:12px;background:#faf9ff;border:1px solid #e6e0f6;border-radius:10px;text-align:left;color:#6047f4;font-size:12px;min-width:0}
#mioficio-dashboard.reference-ui :is(.business-checklist,.business-tool-grid) button span{flex:1;min-width:0}
#mioficio-dashboard.reference-ui :is(.business-checklist,.business-tool-grid) small{display:block;color:#89869b;font-size:10px;margin-top:4px;line-height:1.5}
#mioficio-dashboard.reference-ui .business-checklist .is-complete{color:#328152}
#mioficio-dashboard.reference-ui :is(.business-checklist,.business-tool-grid,.personal-link) svg{width:18px!important;height:18px!important;min-width:18px!important;max-width:18px!important}
#mioficio-dashboard.reference-ui #perfil-profesional .business-settings{margin-top:14px!important}
#mioficio-dashboard.reference-ui #perfil-profesional .business-conditions{grid-column:1/-1}
#mioficio-dashboard.reference-ui #perfil-profesional textarea.profile-v2-field{height:auto!important;min-height:82px!important;resize:vertical}
#mioficio-dashboard.reference-ui .business-tools{margin-top:16px!important}
#mioficio-dashboard.reference-ui .business-tool-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
#mioficio-dashboard.reference-ui .personal-profile{display:grid;gap:14px;max-width:860px}
#mioficio-dashboard.reference-ui .personal-identity{display:flex;align-items:center;gap:14px;padding:18px 0}
#mioficio-dashboard.reference-ui .personal-identity p{font-size:12px!important;color:#89869b;margin:4px 0 0}
#mioficio-dashboard.reference-ui .personal-link{display:flex;align-items:center;gap:10px;width:100%;border:0;background:#faf9ff;border-radius:9px;padding:12px;color:#6047f4;font-size:12px;text-align:left;margin-top:8px}
#mioficio-dashboard.reference-ui .personal-link>svg:last-child{margin-left:auto}
#mioficio-dashboard.reference-ui .personal-link small{display:block;font-size:11px;color:#89869b;margin-top:4px}
#mioficio-dashboard.reference-ui .personal-help{font-size:12px!important;color:#89869b}
#mioficio-dashboard.reference-ui .create-overlay{position:fixed;inset:0;z-index:100;background:#21174766;display:flex;align-items:end;justify-content:center;padding:16px;backdrop-filter:blur(3px)}
#mioficio-dashboard.reference-ui .create-sheet{width:100%;max-width:440px;background:white;border-radius:20px;padding:20px;margin-bottom:env(safe-area-inset-bottom);box-shadow:0 12px 45px #21174744}
#mioficio-dashboard.reference-ui .create-sheet h2{font-size:18px;font-weight:600;margin:0 0 16px}
#mioficio-dashboard.reference-ui .create-sheet button{display:flex;align-items:center;gap:12px;width:100%;padding:14px;border:1px solid #e6e0f6;border-radius:10px;background:#faf9ff;color:#6047f4;margin-top:10px;font-size:14px}
#mioficio-dashboard.reference-ui .create-sheet button svg{width:21px!important;height:21px!important;min-width:21px!important;max-width:21px!important}
#mioficio-dashboard.reference-ui .create-sheet button svg:last-child{margin-left:auto}
#mioficio-dashboard.reference-ui .create-sheet .create-cancel{justify-content:center;background:white;color:#89869b;border:0}
@media(max-width:1023px){
#mioficio-dashboard.reference-ui :is(.business-checklist,.business-tool-grid){grid-template-columns:1fr}
}

/* Ajuste de proporciones a la referencia elegida. */
#mioficio-dashboard.reference-ui{--compact-ink:#211b48;--compact-muted:#87839d;--compact-border:#dfd9fc;--compact-radius:13px}
#mioficio-dashboard.reference-ui .compact-table{font-size:12px!important}
#mioficio-dashboard.reference-ui .compact-table th{font-size:11px!important;font-weight:500!important;color:#514865;background:#f2f0fb;padding:10px 8px!important}
#mioficio-dashboard.reference-ui .compact-table td{font-size:12px!important;padding:12px 8px!important;color:#302845}
#mioficio-dashboard.reference-ui .compact-table td:nth-child(4){font-weight:500}
#mioficio-dashboard.reference-ui .compact-upsell{padding:16px 18px!important;border:1px solid #dcd5fa!important;border-radius:13px!important;background:white!important;box-shadow:0 3px 10px #5847b30b!important;color:#302845!important}
#mioficio-dashboard.reference-ui .compact-upsell svg:first-child{color:#e9ab40!important;width:23px!important;height:23px!important;min-width:23px!important;max-width:23px!important}
#mioficio-dashboard.reference-ui .compact-upsell span{font-size:13px;font-weight:500}

        .mi-oficio-ui.mioficio-model .inicio-recent {min-width:0;overflow:hidden;background:#fff;border:1px solid #e4e8f1;border-radius:20px;padding:0;}
        .inicio-recent-header {display:flex;align-items:center;justify-content:space-between;gap:12px;padding:20px;border-bottom:1px solid #edf0f6;}

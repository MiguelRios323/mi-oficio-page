#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .settings-tool-footer{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:14px!important;padding:14px 20px!important;border-top:1px solid #eee7f6!important;background:#fdfbff!important}

    return (!q || [p.numero_presupuesto,p.cliente,...(p.items || []).map(i => i.descripcion)].some(v => String(v || '').toLocaleLowerCase('es-AR').includes(q))) && (!filtroEstadoPresupuesto || filtroEstadoPresupuesto === 'Todos' || (p.estado || 'Emitido') === filtroEstadoPresupuesto);
  }).sort((a,b) => String(b.fecha || '').localeCompare(String(a.fecha || '')) || b.presupuesto_id-a.presupuesto_id);
  const porPaginaPresupuestosCompactos=configuracionGuardada.ajustar_listas_pantalla?Math.max(configuracionGuardada.presupuestos_por_pagina,capacidadPantalla.presupuestos):configuracionGuardada.presupuestos_por_pagina;
  const totalPaginasPresupuestosCompactos = Math.max(1,Math.ceil(presupuestosFiltradosCompactos.length/porPaginaPresupuestosCompactos));
  const paginaPresupuestosCompacta = Math.min(paginaPresupuestos,totalPaginasPresupuestosCompactos);
  const presupuestosPaginaCompacta = presupuestosFiltradosCompactos.slice((paginaPresupuestosCompacta-1)*porPaginaPresupuestosCompactos,paginaPresupuestosCompacta*porPaginaPresupuestosCompactos);
  const abrirFichaClienteCompacta = (c: Cliente, historial = false) => {setMostrarTodosPresupuestosCliente(false);setMostrarHistorialCliente(historial);setClienteSeleccionadoParaVer(c);};
  const formatearMontoCompacto = (importe:number, moneda = monedaCobrado) => new Intl.NumberFormat('es-AR',{style:'currency',currency:moneda,currencyDisplay:'narrowSymbol',minimumFractionDigits:0,maximumFractionDigits:2}).format(importe);
  const importeFilaCompacta = (p:Presupuesto) => `${monedaPresupuesto(p.moneda) === 'ARS' ? '' : monedaPresupuesto(p.moneda)+' '}${formatearMontoCompacto(totalVigentePresupuesto(p),monedaPresupuesto(p.moneda))}`;
  const fechaCortaCompacta = (fecha:string) => /^\d{4}-\d{2}-\d{2}$/.test(fecha) ? fecha.split('-').reverse().join('/') : fecha;
  const importePendienteCompacto = formatearMontoCompacto(presupuestos.filter(p => monedaPresupuesto(p.moneda) === monedaCobrado && (p.estado === 'Aceptado' || p.estado === 'Pagado' || cobradoPresupuesto(p) > 0)).reduce((t,p) => t + saldoPresupuesto(p),0),monedaCobrado);
  const paginacionCompacta = (pagina:number,total:number,cantidad:number,cambiar:(pagina:number)=>void) => total > 1 ? <nav className="compact-pagination" aria-label="Paginación"><span>{cantidad} resultado{cantidad === 1 ? '' : 's'}</span><div><button type="button" aria-label="Página anterior" disabled={pagina <= 1} onClick={() => cambiar(Math.max(1,pagina-1))}><IconoOficial nombre="chevron-left" /></button><span>{pagina} de {total}</span><button type="button" aria-label="Página siguiente" disabled={pagina >= total} onClick={() => cambiar(Math.min(total,pagina+1))}><IconoOficial nombre="chevron-right" /></button></div></nav> : null;
  const menuPrincipal = [
    {tab:'dashboard',label:'Inicio',icon:'home',count:0},
    {tab:'clientes',label:'Clientes',icon:'clients',count:clientes.length},
    {tab:'presupuestos',label:'Presupuestos',icon:'quotes',count:presupuestos.length},

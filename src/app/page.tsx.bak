#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-list{gap:8px!important}#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-row{background:white!important;border:1px solid #e4d8f0!important;border-radius:10px!important;min-height:66px!important;padding:11px!important;gap:8px!important}

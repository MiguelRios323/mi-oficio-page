        .mi-oficio-ui.mioficio-model .profile-v2 {width:100%;max-width:none;padding:0;}
        .mi-oficio-ui.mioficio-model .profile-v2-card {display:flex;flex-direction:column;gap:24px;width:100%;min-width:0;min-height:0;padding:28px;border-radius:24px;}
        .profile-v2-blocks {display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);align-items:start;gap:22px;}.profile-v2-side {display:grid;gap:22px;min-width:0;}
        .mi-oficio-ui.mioficio-model .profile-v2-blocks .profile-v2-section {min-width:0;padding:22px;border:1px solid #e4e8f1;border-radius:18px;background:#fff;}
        .profile-v2-section h3 {font-size:20px;margin:0 0 20px;line-height:1.3;}.profile-v2-grid {gap:18px 16px;}.profile-v2-grid>div {min-width:0;}.profile-v2 .profile-v2-label {font-size:14px;line-height:1.4;margin-bottom:8px;}.profile-v2-transfer .profile-v2-grid {grid-template-columns:1fr;}
        .profile-v2-transfer {margin-top:20px;padding-top:20px;border-top:1px solid #edf0f6;}.profile-v2-transfer h4 {margin:0 0 18px;font-size:17px;}
        .profile-v2-payments {grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;}.profile-v2-payment {min-width:0;padding:10px 8px;gap:6px;font-size:13px;min-height:48px;}.profile-v2-payment input {width:18px !important;height:18px !important;}
        .profile-v2-footer {display:flex;justify-content:flex-end;padding-top:20px;border-top:1px solid #edf0f6;}.profile-v2-footer .profile-v2-save {width:auto;min-width:220px;margin:0;padding:12px 24px;font-size:16px;}
        @media(min-width:1400px) {.profile-v2-transfer .profile-v2-grid {grid-template-columns:repeat(2,minmax(0,1fr));}.profile-v2-transfer .profile-v2-grid>div:last-child {grid-column:1/-1;}}

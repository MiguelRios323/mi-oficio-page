      @media(max-width:370px){.landing-oficio .lo-hero h1{font-size:38px}.landing-oficio .lo-plan-card{padding:20px}.landing-oficio .lo-plan-card ul{font-size:12px}.landing-oficio .lo-plan-price small{display:inline}.landing-oficio .lo-feature-title h3{font-size:14px}}
      /* Una familia, dos pesos reales y una escala por función para toda la landing. */
      .landing-oficio{font-family:MiOficioLanding,Arial,sans-serif!important;font-size:14px;font-weight:400;font-synthesis:none;line-height:1.6}
      .landing-oficio :is(h1,h2,h3,h4,p,span,strong,b,small,li,a,button,label,input,select,textarea,summary,details,header,footer,article,div,nav,section){font-family:MiOficioLanding,Arial,sans-serif!important}
      .landing-oficio :is(h1,h2,h3,h4,strong,b){font-weight:700!important}
      .landing-oficio h1{font-size:56px!important;line-height:1.08!important;letter-spacing:-.035em!important}
      .landing-oficio :is(.lo-section-intro h2,.lo-process h2,.lo-plans-intro h2,.lo-faq h2){font-size:27px!important;line-height:1.2!important;font-weight:700!important;letter-spacing:-.02em!important}
      .landing-oficio :is(.lo-feature-title h3,.lo-process h3){font-size:17px!important;line-height:1.3!important;letter-spacing:-.01em!important}
      .landing-oficio .lo-plan-heading h3{font-size:22px!important;line-height:1.3!important;letter-spacing:-.01em!important}
      .landing-oficio :is(.lo-description){font-size:19px!important;line-height:1.55!important;font-weight:400!important}
      .landing-oficio :is(.lo-hero-detail,.lo-section-intro>p:last-child,.lo-features p,.lo-process p,.lo-plans-intro>p:last-child,.lo-faq details p){font-size:13px!important;line-height:1.65!important;font-weight:400!important;letter-spacing:0!important}
      .landing-oficio :is(.lo-nav,.lo-login,.lo-primary,.lo-secondary,.lo-faq summary){font-size:13px!important;line-height:1.4!important;font-weight:700!important;letter-spacing:0!important}
      .landing-oficio :is(.lo-eyebrow,.lo-feature-benefit,.lo-trust){font-size:11px!important;line-height:1.5!important;font-weight:400!important}
      .landing-oficio .lo-eyebrow{font-weight:700!important;letter-spacing:.065em!important}
      .landing-oficio :is(.lo-plan-subtitle,.lo-plan-card li){font-size:12px!important;line-height:1.55!important;font-weight:400!important}
      .landing-oficio .lo-plan-price{font-size:31px!important;line-height:1.3!important;font-weight:700!important;letter-spacing:-.025em!important}
      .landing-oficio .lo-plan-price small{font-size:11px!important;font-weight:400!important;letter-spacing:0!important}
      .landing-oficio :is(.lo-plan-durations,.lo-plan-security,.lo-footer p,.lo-footer a,.lo-budget-client){font-size:11px!important;line-height:1.5!important;font-weight:400!important}
      .landing-oficio :is(.lo-feature-premium,.lo-plan-heading>span,.lo-demo-label,.lo-budget-preview header>span){font-size:10px!important;line-height:1.4!important;letter-spacing:0!important}
      .landing-oficio .lo-budget-preview header{font-size:14px!important;line-height:1.4!important}
      .landing-oficio :is(.lo-budget-line,.lo-budget-total,.lo-budget-preview footer,.lo-budget-client strong){font-size:12px!important;line-height:1.5!important}
      @media(max-width:760px){.landing-oficio h1{font-size:42px!important}.landing-oficio :is(.lo-section-intro h2,.lo-process h2,.lo-plans-intro h2,.lo-faq h2){font-size:24px!important}.landing-oficio :is(.lo-feature-title h3,.lo-process h3){font-size:16px!important}.landing-oficio .lo-description{font-size:17px!important}.landing-oficio :is(.lo-features p,.lo-feature-benefit,.lo-plan-card li,.lo-plan-subtitle){font-size:12px!important}.landing-oficio .lo-feature-benefit{font-size:10px!important}.landing-oficio :is(.lo-eyebrow,.lo-trust,.lo-plan-security){font-size:10px!important}.landing-oficio .lo-header :is(.lo-login,.lo-primary){font-size:11px!important}.landing-oficio .lo-plan-price{font-size:27px!important}.landing-oficio .lo-plan-heading h3{font-size:20px!important}.landing-oficio :is(.lo-feature-premium,.lo-plan-heading>span){font-size:9px!important}.landing-oficio .lo-plan-card .lo-primary{font-size:12px!important}}
      @media(max-width:370px){.landing-oficio h1{font-size:37px!important}.landing-oficio .lo-header :is(.lo-login,.lo-primary){font-size:10px!important}.landing-oficio .lo-feature-title h3{font-size:15px!important}.landing-oficio .lo-features p{font-size:11px!important}}
      /* Iconos por función, con contenedores consistentes y sin checks repetidos. */
      .landing-oficio .lo-header-actions .lo-icon{display:block!important}.landing-oficio .lo-login{gap:7px}.landing-oficio .lo-plan-heading h3>.lo-icon{padding:5px;box-sizing:content-box;border:1px solid #dae5fa;border-radius:12px;background:#eff5ff}.landing-oficio .lo-plan-card.is-premium .lo-plan-heading h3>.lo-icon{background:#e1ebff;border-color:#c7d8fb}.landing-oficio .lo-feature-benefit{align-items:center;gap:8px;font-size:11px!important;line-height:1.45!important}.lo-benefit-symbol{display:flex;align-items:center;justify-content:center;width:28px;height:28px;flex:0 0 28px;border:1px solid #e0e8f7;border-radius:8px;background:#f2f6ff}.landing-oficio .lo-feature-benefit .lo-icon{margin:0!important}.landing-oficio .lo-plan-card li{align-items:center;gap:9px}.lo-plan-benefit-symbol{display:flex;align-items:center;justify-content:center;width:30px;height:30px;flex:0 0 30px;border:1px solid #e4ebf7;border-radius:8px;background:#f5f8fe}.landing-oficio .lo-plan-card.is-premium .lo-plan-benefit-symbol{background:#e6eeff;border-color:#d4e1fc}.landing-oficio .lo-plan-card li .lo-icon{margin:0!important;color:#1850ff}.landing-oficio .lo-budget-preview footer .lo-icon{}.landing-oficio .lo-plan-card .lo-primary>.lo-icon,.landing-oficio .lo-plan-card .lo-secondary>.lo-icon{}.landing-oficio .lo-plan-durations{gap:8px}.landing-oficio .lo-plan-durations span{padding:7px 8px;line-height:1.5;border-radius:7px}
      @media(max-width:760px){.landing-oficio .lo-header .lo-brand img{width:130px}.landing-oficio .lo-header-actions .lo-icon{}.landing-oficio .lo-login{gap:4px}.landing-oficio .lo-header .lo-primary{gap:4px}.landing-oficio .lo-plan-heading h3>.lo-icon{padding:4px;border-radius:9px}.landing-oficio .lo-plan-heading h3{gap:7px;flex-wrap:wrap}.landing-oficio .lo-plan-heading{flex-wrap:wrap}.landing-oficio .lo-feature-benefit{font-size:10px!important;gap:6px}.lo-benefit-symbol{width:26px;height:26px;flex-basis:26px}.landing-oficio .lo-feature-benefit .lo-icon{}.lo-plan-benefit-symbol{width:26px;height:26px;flex-basis:26px}.landing-oficio .lo-plan-card li .lo-icon{}.landing-oficio .lo-plan-card li{gap:7px}.landing-oficio .lo-plan-card .lo-primary{flex-wrap:wrap;gap:5px;font-size:11px!important;line-height:1.4!important}.landing-oficio .lo-plan-durations span{padding:6px}}
      @media(max-width:370px){.landing-oficio .lo-header .lo-brand img{width:95px}.landing-oficio .lo-header-actions .lo-icon{}.landing-oficio .lo-header-actions{gap:0}}
      /* Interacción de la landing: movimientos contenidos, sin desplazar la estructura. */
      .landing-oficio :is(button,.lo-primary,.lo-secondary){transition:transform .2s ease,box-shadow .2s ease,background .2s ease,border-color .2s ease!important;transform:translateY(0);touch-action:manipulation}
      .landing-oficio :is(button,.lo-primary,.lo-secondary):active{transform:translateY(1px) scale(.97)!important}
      .landing-oficio .lo-brand{transition:transform .2s ease!important}
      .landing-oficio :is(.lo-primary,.lo-secondary)>.lo-icon{transition:transform .2s ease}
      .landing-oficio .lo-budget-preview{animation:lo-budget-float 5s ease-in-out infinite;transition:box-shadow .25s ease,border-color .25s ease;will-change:transform}
      .landing-oficio .lo-budget-preview header,.landing-oficio .lo-budget-total,.landing-oficio .lo-budget-preview footer{transition:background .25s ease}
      .landing-oficio .lo-features>article{transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease}
      .landing-oficio .lo-feature-icon .lo-icon,.landing-oficio .lo-step-icon>.lo-icon{transition:transform .25s ease}
      .landing-oficio .lo-faq summary>.lo-icon{transition:transform .2s ease}
      .landing-oficio .lo-nav a,.landing-oficio .lo-footer a{position:relative;transition:color .2s ease}
      .landing-oficio .lo-nav a::after,.landing-oficio .lo-footer a::after{content:'';position:absolute;left:0;right:0;bottom:-5px;height:2px;border-radius:2px;background:#1850ff;transform:scaleX(0);transform-origin:left;transition:transform .2s ease}
      @keyframes lo-budget-float{0%,100%{transform:translateY(0) rotate(-.4deg)}50%{transform:translateY(-7px) rotate(.4deg)}}
      @keyframes lo-reveal{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
      .landing-oficio .lo-hero-grid>div:first-child{animation:lo-reveal .55s ease-out both}
      .landing-oficio .lo-hero-visual{animation:lo-reveal .7s ease-out .1s both}
      @media(hover:hover) and (pointer:fine){.landing-oficio :is(button,.lo-primary,.lo-secondary):hover{transform:translateY(-2px);box-shadow:0 7px 17px #1850ff18}.landing-oficio .lo-brand:hover{transform:scale(1.025);box-shadow:none}.landing-oficio :is(.lo-primary,.lo-secondary):hover>.lo-icon{transform:translateX(3px)}.landing-oficio .lo-budget-preview:hover{animation-play-state:paused;border-color:#a9c4fb;box-shadow:0 22px 48px #1524402c}.landing-oficio .lo-budget-preview:hover .lo-budget-total{background:#dfeaff}.landing-oficio .lo-features>article:hover{transform:translateY(-4px);box-shadow:0 12px 28px #1b3e6d0d;border-color:#c7d9fa}.landing-oficio .lo-features>article:hover .lo-feature-icon .lo-icon{transform:scale(1.08) rotate(-3deg)}.landing-oficio .lo-process>article:hover .lo-step-icon>.lo-icon{transform:scale(1.08)}.landing-oficio .lo-nav a:hover::after,.landing-oficio .lo-footer a:hover::after{transform:scaleX(1)}}
      .landing-oficio .lo-plan-card{transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease;transform:translateY(0)}
      @media(hover:hover) and (pointer:fine){.landing-oficio .lo-plan-card:hover{transform:translateY(-6px);border-color:#b8cef5;box-shadow:0 16px 32px #1b3e6d12}.landing-oficio .lo-plan-card.is-premium:hover{border-color:#7da7f5;box-shadow:0 18px 38px #1850ff1c}}
      @media(prefers-reduced-motion:reduce){.landing-oficio .lo-plan-card:hover{transform:none!important}}
      @media(prefers-reduced-motion:reduce){.landing-oficio *,.landing-oficio *::before,.landing-oficio *::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}.landing-oficio :is(button,.lo-primary,.lo-secondary,.lo-features>article):is(:hover,:active){transform:none!important}.landing-oficio .lo-budget-preview{transform:none!important;will-change:auto}}
      @media(prefers-reduced-motion:reduce){.landing-oficio *{scroll-behavior:auto!important;transition:none!important}}
      /* Landing adaptable: una columna legible en teléfono y composición propia en tablet. */
      @media(min-width:761px) and (max-width:1000px){
        .landing-oficio .lo-header>.lo-wrap{gap:14px;padding-left:22px;padding-right:22px}
        .landing-oficio .lo-brand img{width:155px}.landing-oficio .lo-nav{gap:12px;font-size:12px!important}
        .landing-oficio .lo-header-actions{gap:4px}.landing-oficio .lo-header-actions :is(.lo-login,.lo-primary){font-size:12px!important;padding:9px}
        .landing-oficio .lo-hero-grid{grid-template-columns:1fr 1fr;gap:22px;padding:36px 0}
        .landing-oficio h1{font-size:44px!important}.landing-oficio .lo-description{font-size:17px!important}
        .landing-oficio .lo-features{grid-template-columns:repeat(2,minmax(0,1fr))}
        .landing-oficio .lo-process{grid-template-columns:repeat(3,minmax(0,1fr))}.landing-oficio .lo-process>div:first-child{grid-column:1/-1}
        .landing-oficio .lo-process h2{max-width:none}.landing-oficio .lo-plans{grid-template-columns:repeat(2,minmax(0,1fr));align-items:start}
        .landing-oficio .lo-plans-intro{grid-column:1/-1}.landing-oficio .lo-plans-intro :is(h2,p){max-width:none}
      }
      @media(max-width:760px){
        .landing-oficio .lo-wrap{padding-left:20px;padding-right:20px;min-width:0}
        .landing-oficio :is(.lo-hero-grid>div,.lo-plan-card,.lo-features>article,.lo-process>article){min-width:0}
        .landing-oficio .lo-header>.lo-wrap{height:auto;min-height:66px;gap:10px;padding-top:10px;padding-bottom:10px}
        .landing-oficio .lo-header .lo-brand{min-width:0;flex:0 1 130px}.landing-oficio .lo-header .lo-brand img{width:100%;max-width:130px}
        .landing-oficio .lo-header-actions{gap:7px;flex-shrink:0}.landing-oficio .lo-header-actions :is(.lo-login,.lo-primary){font-size:11px!important;white-space:nowrap;min-height:40px;padding:9px 10px}
        .landing-oficio .lo-header-actions .lo-icon{}
        .landing-oficio .lo-hero-grid{grid-template-columns:minmax(0,1fr);gap:28px;padding:30px 0 32px}
        .landing-oficio .lo-hero-tag{font-size:10px!important;letter-spacing:0!important;text-transform:none;padding:7px 9px;margin-bottom:16px!important;max-width:100%;line-height:1.5!important}
        .landing-oficio .lo-hero-tag .lo-icon{}
        .landing-oficio h1{font-size:clamp(34px,9vw,46px)!important;line-height:1.1!important;letter-spacing:-.035em!important;max-width:none}
        .landing-oficio .lo-description{font-size:17px!important;line-height:1.55!important;margin-top:17px!important;max-width:none}
        .landing-oficio .lo-hero-detail{font-size:14px!important;line-height:1.65!important;max-width:none;margin-top:10px}
        .landing-oficio .lo-hero-actions{display:grid;grid-template-columns:minmax(0,1fr);gap:10px;margin-top:22px}
        .landing-oficio .lo-hero-actions :is(.lo-primary,.lo-secondary){width:100%;min-height:46px;font-size:14px!important;padding:12px 16px}
        .landing-oficio .lo-trust{gap:10px 14px;margin-top:17px;font-size:11px!important;line-height:1.5!important}
        .landing-oficio .lo-trust .lo-icon{}.landing-oficio .lo-trust>span{min-width:0}
        .landing-oficio .lo-hero-visual{padding:0;display:flex;flex-direction:column;align-items:center}
        .landing-oficio .lo-hero-photo{height:clamp(190px,56vw,300px);border-radius:15px;object-position:55% center}
        .landing-oficio .lo-budget-preview{position:relative;right:auto;bottom:auto;width:calc(100% - 24px);max-width:380px;margin-top:-32px;padding:16px;border-radius:13px;box-shadow:0 10px 28px #15244018;z-index:1}
        .landing-oficio .lo-budget-line{align-items:flex-start;gap:12px}.landing-oficio .lo-budget-line>span{min-width:0;overflow-wrap:anywhere}
        .landing-oficio .lo-budget-line>strong,.landing-oficio .lo-budget-total>span:last-child{white-space:nowrap;flex-shrink:0}
        .landing-oficio .lo-section-intro{padding-top:30px!important}
        .landing-oficio :is(.lo-section-intro h2,.lo-process h2,.lo-plans-intro h2,.lo-faq h2){font-size:25px!important;line-height:1.25!important;max-width:none}
        .landing-oficio :is(.lo-section-intro>p:last-child,.lo-process p,.lo-plans-intro>p:last-child){font-size:14px!important;line-height:1.65!important}
        .landing-oficio .lo-features{grid-template-columns:minmax(0,1fr);gap:12px;padding-top:20px!important;padding-bottom:28px!important}
        .landing-oficio .lo-features>article{display:grid;grid-template-columns:44px minmax(0,1fr);gap:8px 13px;padding:18px;border-radius:14px}
        .landing-oficio .lo-feature-icon{grid-column:1;grid-row:1/3;width:44px;height:44px;margin:0;border-radius:12px}
        .landing-oficio .lo-feature-icon .lo-icon{}
        .landing-oficio .lo-feature-title{grid-column:2;margin:0;gap:6px;align-self:center}
        .landing-oficio .lo-feature-title h3{font-size:17px!important;line-height:1.3!important}
        .landing-oficio .lo-features p{grid-column:2;margin:0;font-size:13px!important;line-height:1.65!important}
        .landing-oficio .lo-feature-benefit{grid-column:1/-1;margin:5px 0 0;padding-top:11px;font-size:11px!important;gap:8px}
        .landing-oficio .lo-process{grid-template-columns:minmax(0,1fr);padding:22px 18px;gap:22px}
        .landing-oficio .lo-process>article{grid-template-columns:46px minmax(0,1fr);gap:5px 14px}
        .landing-oficio .lo-process h3{font-size:17px!important;margin:0}.landing-oficio .lo-process>article p{margin:0}
        .landing-oficio .lo-step-icon{width:46px;height:46px;margin:0;grid-row:1/3}
        .landing-oficio .lo-plans{grid-template-columns:minmax(0,1fr);align-items:start;gap:16px;padding-top:30px!important;padding-bottom:20px!important}
        .landing-oficio .lo-plans-intro{grid-column:auto;padding-bottom:4px}.landing-oficio .lo-plans-intro>p:last-child{max-width:none;margin-top:10px}
        .landing-oficio .lo-plan-card{padding:22px 20px;border-radius:15px;align-self:start}
        .landing-oficio .lo-plan-heading{flex-wrap:nowrap;gap:10px;align-items:center}.landing-oficio .lo-plan-heading h3{font-size:22px!important;flex-wrap:nowrap;gap:10px}
        .landing-oficio .lo-plan-heading h3>.lo-icon{padding:5px;box-sizing:content-box}
        .landing-oficio .lo-plan-heading>span{font-size:9px!important;padding:5px 8px;white-space:nowrap}
        .landing-oficio .lo-plan-subtitle{font-size:13px!important;margin-top:10px!important}
        .landing-oficio .lo-plan-price{font-size:32px!important;margin-top:17px!important;padding-bottom:14px}
        .landing-oficio .lo-plan-price small{display:inline;font-size:12px!important;white-space:nowrap}
        .landing-oficio .lo-plan-card ul{margin:17px 0 20px;gap:12px}.landing-oficio .lo-plan-card li{font-size:13px!important;line-height:1.55!important;gap:10px}
        .landing-oficio .lo-plan-card li>span:last-child{min-width:0;overflow-wrap:break-word}
        .landing-oficio .lo-plan-durations{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;font-size:11px!important}
        .landing-oficio .lo-plan-durations span{padding:8px 7px;overflow-wrap:break-word}
        .landing-oficio .lo-plan-card :is(.lo-primary,.lo-secondary){min-height:46px;font-size:13px!important;flex-wrap:nowrap;padding:12px;gap:8px}
        .landing-oficio .lo-plan-security{padding:0 20px;margin:0 auto 26px!important;text-align:left;font-size:11px!important;line-height:1.65!important;max-width:540px;align-items:flex-start}
        .landing-oficio .lo-plan-security>.lo-icon{margin-top:2px}
        .landing-oficio .lo-faq{padding:8px 20px 30px}.landing-oficio .lo-faq-intro{font-size:14px!important;line-height:1.65!important}
        .landing-oficio .lo-faq details{padding:16px 0}.landing-oficio .lo-faq summary{font-size:14px!important;line-height:1.5!important;gap:12px}
        .landing-oficio .lo-faq summary>.lo-icon{}
        .landing-oficio .lo-faq-answer{padding-right:0}.landing-oficio .lo-faq details p{font-size:14px!important;line-height:1.75!important;margin-top:12px}
        .landing-oficio .lo-footer>.lo-wrap{justify-content:center;gap:14px;padding-top:24px;padding-bottom:24px;text-align:center}
        .landing-oficio .lo-footer img{width:155px}.landing-oficio .lo-footer p{font-size:11px!important;line-height:1.6!important}
      }
      @media(max-width:420px){
        .landing-oficio .lo-header>.lo-wrap{display:grid;grid-template-columns:minmax(0,1fr);justify-items:center;gap:8px;padding-top:11px;padding-bottom:11px}
        .landing-oficio .lo-header .lo-brand{width:150px}.landing-oficio .lo-header .lo-brand img{width:150px;max-width:150px}
        .landing-oficio .lo-header-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));width:100%;gap:10px}
        .landing-oficio .lo-header-actions :is(.lo-login,.lo-primary){font-size:12px!important;min-height:40px;justify-content:center}
        .landing-oficio .lo-login{border:1px solid #dce5f3;border-radius:8px;background:#fff}
        .landing-oficio section[id]{scroll-margin-top:128px}
      }
      @media(max-width:340px){
        .landing-oficio .lo-wrap{padding-left:16px;padding-right:16px}.landing-oficio .lo-plan-card{padding:18px 16px}
        .landing-oficio .lo-plan-heading{flex-wrap:wrap}.landing-oficio .lo-plan-durations{grid-template-columns:minmax(0,1fr)}
        .landing-oficio .lo-plan-price small{display:block;margin-top:4px}
      }
    

      /* Acceso móvil: una sola distribución para ambos botones, de 320 a 760 px. */
      @media(max-width:760px){
        .landing-oficio .lo-header>.lo-wrap{display:grid;grid-template-columns:minmax(0,1fr);height:auto;min-height:0;justify-items:start;gap:12px;padding:12px 18px;}
        .landing-oficio .lo-header .lo-nav{display:none;}
        .landing-oficio .lo-header .lo-brand{width:148px;min-width:0;max-width:100%;}
        .landing-oficio .lo-header .lo-brand img{width:148px;max-width:100%;height:auto;}
        .landing-oficio .lo-header-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;width:100%;min-width:0;}
        .landing-oficio .lo-header-actions :is(.lo-login,.lo-primary){display:flex;align-items:center;justify-content:center;gap:7px;width:100%;min-width:0;min-height:42px;margin:0;padding:10px 8px;border-radius:9px;font-size:13px!important;line-height:1.3!important;white-space:nowrap;}
        .landing-oficio .lo-header-actions .lo-login{background:#fff;border:1px solid #dce5f3;color:#334155;}
        .landing-oficio .lo-header-actions .lo-primary{background:#1850ff;border:1px solid #1850ff;color:#fff;box-shadow:0 3px 8px #1850ff14;}
        .landing-oficio .lo-header-actions svg.mioficio-lucide-icon{--mioficio-icon-size:16px!important;}
        .landing-oficio section[id]{scroll-margin-top:130px;}
      }
      @media(max-width:340px){.landing-oficio .lo-header>.lo-wrap{padding-left:14px;padding-right:14px;}.landing-oficio .lo-header-actions :is(.lo-login,.lo-primary){font-size:12px!important;gap:6px;}}

      /* Contacto y pie institucional: jerarquía clara, con la misma identidad visual. */
      .landing-oficio .lo-contact{padding-top:48px;padding-bottom:48px;display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:52px;align-items:start;border-top:1px solid #e8edf4;}
      .landing-oficio .lo-contact h2{font-size:30px!important;line-height:1.22;letter-spacing:-.025em;max-width:350px;margin:0 0 14px;}
      .landing-oficio .lo-contact-copy>.lo-eyebrow{font-size:11px!important;color:#1850ff;font-weight:700!important;margin:0 0 12px;}
      .landing-oficio .lo-contact-description{font-size:14px;line-height:1.75;color:#64748b;max-width:360px;margin:0 0 24px;}
      .lo-contact-channels{display:grid;gap:10px;max-width:360px;}.lo-contact-channels a{display:flex;align-items:center;gap:12px;min-width:0;padding:13px 15px;border:1px solid #e0e7f1;border-radius:11px;background:#fff;transition:border-color .18s,box-shadow .18s,transform .18s;}.lo-contact-channel-icon{display:grid;place-items:center;width:36px;height:36px;flex:0 0 36px;border-radius:10px;background:#eff4fc;color:#315b99;}.lo-contact-channel-copy{flex:1;min-width:0;}.lo-contact-channel-copy strong{display:block;font-size:13px;color:#263b59;line-height:1.4;}.lo-contact-channel-copy small{display:block;font-size:12px;color:#728096;line-height:1.5;margin-top:3px;}.lo-contact-channels a>svg{color:#94a3b8;}
      .lo-contact-form{width:100%;min-width:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px;background:#fff;border:1px solid #e0e7f1;border-radius:16px;padding:26px;box-shadow:0 8px 28px #172b4906;}
      .landing-oficio .lo-contact-form-heading{grid-column:1/-1;margin-bottom:3px;}.landing-oficio .lo-contact-form-heading h3{font-size:17px;line-height:1.4;letter-spacing:-.01em;color:#263b59;margin:0 0 5px;}.landing-oficio .lo-contact-form-heading p{font-size:12px;line-height:1.6;color:#728096;margin:0;}
      .lo-contact-field{min-width:0;display:grid;gap:7px;}.lo-contact-field label{font-size:12px;color:#41536d;font-weight:700;}.lo-contact-field input,.lo-contact-field textarea{width:100%;min-width:0;padding:11px 12px;border:1px solid #dce4ef;background:#fafbfd;border-radius:9px;font-size:14px;color:#172b49;outline:none;transition:border-color .18s,box-shadow .18s;}.lo-contact-field input{min-height:44px;}.lo-contact-field input::placeholder,.lo-contact-field textarea::placeholder{color:#8a99ad;}.lo-contact-field input:focus,.lo-contact-field textarea:focus{background:#fff;border-color:#1850ff;box-shadow:0 0 0 3px #1850ff10;}.lo-contact-field textarea{min-height:114px;resize:vertical;line-height:1.6;}.lo-contact-wide{grid-column:1/-1;}.lo-contact-form small{font-size:11px;line-height:1.6;color:#728096;}.lo-contact-form .lo-primary{justify-self:stretch;width:100%;justify-content:center;min-height:44px;font-size:13px!important;border-radius:9px;}.lo-contact-form button:disabled{opacity:.6;cursor:wait;}.lo-contact-result{margin:0!important;padding:10px 12px;border-radius:8px;border:1px solid #cde9dd;background:#f0faf5;font-size:12px;color:#276348;line-height:1.6;}.lo-contact-result.is-error{border-color:#f0d6d9;background:#fff4f5;color:#a33143;}.lo-contact-honeypot{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden;}
      .landing-oficio .lo-footer{background:#f7f9fc;border-top:1px solid #e3e9f2;}.landing-oficio .lo-footer>.lo-footer-main{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr) auto;align-items:start;gap:32px;padding-top:26px;padding-bottom:24px;text-align:left;}.lo-footer-brand img{width:168px!important;max-width:100%;height:auto;}.landing-oficio .lo-footer-brand p{font-size:12px!important;color:#728096;line-height:1.6!important;max-width:230px;margin-top:9px;}.lo-footer-legal-label{display:block;font-size:10px!important;font-weight:700!important;letter-spacing:.06em;color:#728096;text-transform:uppercase;margin-bottom:7px;}.lo-footer-legal strong{display:block;font-size:13px;color:#34455f;line-height:1.5;}.landing-oficio .lo-footer-legal p{margin-top:4px;font-size:12px!important;line-height:1.7!important;color:#64748b;}.lo-footer-links{display:grid;gap:9px;}.lo-footer-links a{font-size:12px;color:#526885;line-height:1.5;}.lo-footer-links a:hover{color:#1850ff;text-decoration:underline;}.landing-oficio .lo-footer>.lo-footer-bottom{display:flex;align-items:center;justify-content:space-between;gap:14px;border-top:1px solid #e3e9f2;padding-top:14px;padding-bottom:16px;}.lo-footer-bottom p{font-size:11px!important;color:#8090a5;line-height:1.5;}.lo-footer-bottom a{display:inline-flex;align-items:center;gap:6px;font-size:11px;color:#64748b;}
      @media(hover:hover) and (pointer:fine){.lo-contact-channels a:hover{border-color:#b8cbea;box-shadow:0 5px 14px #172b4907;transform:translateY(-1px);}}
      @media(max-width:760px){.landing-oficio .lo-contact{grid-template-columns:minmax(0,1fr);gap:23px;padding-top:32px;padding-bottom:32px;}.landing-oficio .lo-contact h2{font-size:25px!important;max-width:none;}.landing-oficio .lo-contact-description{font-size:13px;max-width:none;margin-bottom:18px;}.lo-contact-channels{max-width:none;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;}.lo-contact-channels a{padding:12px 10px;gap:8px;align-items:start;}.lo-contact-channel-icon{width:30px;height:30px;flex-basis:30px;border-radius:8px;}.lo-contact-channel-copy strong{font-size:12px;}.lo-contact-channel-copy small{font-size:11px;overflow-wrap:anywhere;}.lo-contact-channels a>svg{display:none!important;}.lo-contact-form{grid-template-columns:minmax(0,1fr);padding:20px;gap:14px;border-radius:13px;}.lo-contact-field input,.lo-contact-field textarea{font-size:16px;}.landing-oficio .lo-footer>.lo-footer-main{grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 16px;padding-top:24px;padding-bottom:22px;}.lo-footer-brand{grid-column:1/-1;}.landing-oficio .lo-footer-brand p{max-width:none;}.landing-oficio .lo-footer>.lo-footer-bottom{align-items:start;gap:12px;padding-top:14px;padding-bottom:16px;}.lo-footer-bottom p{max-width:220px;}.lo-footer-bottom a{white-space:nowrap;}}
      @media(max-width:360px){.lo-contact-channels{grid-template-columns:minmax(0,1fr);}.lo-contact-form{padding:17px;}.landing-oficio .lo-footer>.lo-footer-bottom{flex-direction:column;gap:8px;}}
      @media(prefers-reduced-motion:reduce){.lo-contact-channels a{transition:none;transform:none!important;}}

      .landing-oficio .lo-terms{padding-top:30px;padding-bottom:30px;border-top:1px solid #e8edf4;}.lo-terms-intro{max-width:640px;margin-bottom:18px;}.landing-oficio .lo-terms h2{font-size:25px!important;line-height:1.3;letter-spacing:-.02em;margin:0 0 9px;}.lo-terms-intro>p:last-child{font-size:13px;color:#64748b;line-height:1.7;}.lo-terms-document{border:1px solid #dfe7f2;border-radius:12px;background:#fff;}.lo-terms-document>summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:17px 20px;}.lo-terms-document>summary::-webkit-details-marker{display:none;}.lo-terms-document summary strong{display:block;font-size:14px;color:#334155;line-height:1.5;}.lo-terms-document summary small{display:block;font-size:11px;color:#7b8ba0;margin-top:3px;}.lo-terms-document[open]>summary{border-bottom:1px solid #e8edf4;}.lo-terms-document[open]>summary svg{transform:rotate(180deg);}.lo-terms-content{max-width:840px;padding:22px 24px;}.lo-terms-content article+article{margin-top:23px;}.landing-oficio .lo-terms-content h3{font-size:14px!important;color:#334155;margin:0 0 9px;line-height:1.5;}.landing-oficio .lo-terms-content article p{font-size:13px;color:#64748b;line-height:1.8;margin:0 0 10px;}.lo-terms-actions{display:flex;flex-wrap:wrap;gap:9px;padding-top:12px;border-top:1px solid #e8edf4;}.lo-terms-actions button{border:1px solid #d8e2ef;background:#f8faff;border-radius:8px;padding:10px 12px;color:#315b99;font-size:12px;}.lo-footer-links button{border:0;background:none;text-align:left;padding:0;color:#526885;font-size:12px;line-height:1.5;cursor:pointer;}.lo-footer-links button:hover{color:#1850ff;text-decoration:underline;}.lo-terms-document>summary:focus-visible{outline:2px solid #1850ff;outline-offset:3px;}
      @media(max-width:760px){.landing-oficio .lo-terms{padding-top:25px;padding-bottom:25px;}.landing-oficio .lo-terms h2{font-size:23px!important;}.lo-terms-document>summary{padding:15px;}.lo-terms-content{padding:18px 16px;}.landing-oficio .lo-terms-content article p{font-size:13px;line-height:1.8;}.lo-terms-actions{display:grid;grid-template-columns:minmax(0,1fr);}.lo-terms-actions button{text-align:center;}}

      /* Un área de atención con apartados claramente identificados. */
      .lo-support-area{padding-top:36px!important;padding-bottom:36px!important;border-top:1px solid #e8edf4;}
      .lo-support-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:36px;align-items:start;}
      .landing-oficio .lo-support-grid>.lo-terms,.landing-oficio .lo-support-grid>.lo-contact{padding:0;border:0;margin:0;min-width:0;}
      .landing-oficio .lo-support-grid>.lo-contact{display:block;}
      .landing-oficio .lo-support-grid :is(.lo-terms h2,.lo-contact h2){font-size:24px!important;line-height:1.3;margin:0 0 10px;max-width:none;}
      .lo-support-grid .lo-terms-intro,.lo-support-grid .lo-contact-copy{margin-bottom:18px;}
      .landing-oficio .lo-support-grid .lo-contact-description{max-width:none;font-size:13px;margin-bottom:14px;}
      .lo-support-grid .lo-contact-channels{grid-template-columns:repeat(2,minmax(0,1fr));max-width:none;gap:8px;}
      .lo-support-grid .lo-contact-channels a{padding:11px;gap:8px;}.lo-support-grid .lo-contact-channels a>svg{display:none!important;}
      .lo-support-grid .lo-contact-channel-icon{width:30px;height:30px;flex-basis:30px;}
      .lo-support-grid .lo-contact-form{padding:20px;}
      .lo-support-grid .lo-terms-content{display:grid;gap:8px;padding:12px;max-width:none;}
      .lo-terms-topic{border:1px solid #e4eaf3;border-radius:8px;min-width:0;background:#fff;}
      .lo-terms-topic>summary{display:flex;align-items:center;gap:9px;list-style:none;padding:11px;cursor:pointer;}
      .lo-terms-topic>summary::-webkit-details-marker{display:none;}
      .lo-terms-topic-icon{display:flex;align-items:center;justify-content:center;color:#60799e;flex:0 0 22px;}
      .landing-oficio .lo-terms-topic>summary h3{flex:1;min-width:0;font-size:12px!important;line-height:1.5;margin:0;}
      .lo-terms-topic>summary>svg{color:#8b9bb0;}
      .lo-terms-topic[open]>summary{border-bottom:1px solid #edf0f5;background:#f8faff;border-radius:8px 8px 0 0;}
      .lo-terms-topic[open]>summary>svg{transform:rotate(180deg);}
      .lo-terms-topic-body{padding:12px;}
      .landing-oficio .lo-terms-topic-body p{font-size:12px;line-height:1.8;margin:0 0 9px;color:#64748b;}
      .lo-terms-topic-body p:last-child{margin-bottom:0;}
      .lo-support-grid .lo-terms-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;padding-top:10px;}
      .lo-support-grid .lo-terms-actions button{font-size:11px;padding:10px 7px;}
      .lo-support-tabs{display:none;}
      .landing-oficio .lo-footer>.lo-footer-main{grid-template-columns:minmax(0,.9fr) minmax(0,.8fr) minmax(0,1.5fr);gap:26px;}
      .lo-footer-links{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;}
      .lo-footer-links>div{display:grid;align-content:start;gap:8px;}
      .lo-footer-links .lo-footer-legal-label{margin-bottom:0;}
      .lo-footer-links button{line-height:1.6;}
      @media(max-width:760px){
        .lo-support-area{padding-top:24px!important;padding-bottom:26px!important;}
        .lo-support-grid{grid-template-columns:minmax(0,1fr);gap:0;}
        .lo-support-tabs{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:5px;padding:5px;margin-bottom:20px;border:1px solid #e0e7f1;border-radius:11px;background:#f3f6fb;}
        .lo-support-tabs button{display:flex;align-items:center;justify-content:center;gap:6px;min-height:40px;min-width:0;padding:8px 6px;border:1px solid transparent;border-radius:8px;background:transparent;color:#64748b;font-size:12px;font-weight:700;line-height:1.4;}
        .lo-support-tabs button[aria-selected="true"]{background:#fff;border-color:#dce5f2;color:#1850ff;box-shadow:0 2px 5px #172b4905;}
        .lo-support-grid>section[data-active="false"]{display:none!important;}
        .lo-support-grid .lo-contact-channels{grid-template-columns:repeat(2,minmax(0,1fr));}
        .landing-oficio .lo-footer>.lo-footer-main{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 16px;}
        .lo-footer-brand{grid-column:1;}
        .lo-footer-legal{grid-column:2;}
        .lo-footer-links{grid-column:1/-1;grid-template-columns:repeat(2,minmax(0,1fr));padding-top:15px;border-top:1px solid #e3e9f2;gap:16px;}
        .lo-footer-brand img{width:138px!important;}
        .landing-oficio .lo-footer-brand p{font-size:11px!important;}
      }
      @media(max-width:360px){.lo-support-tabs button{font-size:11px;gap:4px;}.lo-support-grid .lo-contact-channels a{gap:6px;padding:10px 8px;}.lo-support-grid .lo-contact-channel-icon{width:26px;height:26px;flex-basis:26px;}.lo-support-grid .lo-contact-form{padding:16px;}.lo-support-grid .lo-terms-actions{grid-template-columns:minmax(0,1fr);}}

      .landing-oficio .lo-premium-example-benefit{display:grid;grid-template-columns:30px minmax(0,1fr) auto;gap:9px;align-items:center;}
      .landing-oficio .lo-example-trigger{display:inline-flex;align-items:center;justify-content:center;gap:5px;padding:6px 7px;border:1px solid #cad8ef;border-radius:7px;background:#f5f8ff;color:#315b99;font-size:10px!important;line-height:1.4!important;white-space:nowrap;min-height:32px;}
      .landing-oficio .lo-example-trigger:hover{background:#fff;border-color:#93b2e6;}
      .landing-oficio .lo-plan-durations.lo-plan-picker{grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;padding-top:8px;}.landing-oficio .lo-plan-picker button{display:grid;grid-template-columns:minmax(0,1fr) auto;align-content:start;gap:3px 5px;min-width:0;text-align:left;padding:7px 8px;border:1px solid #d6e1f5;border-radius:7px;background:#fff;color:#526885;cursor:pointer;font:inherit;line-height:1.35;}.landing-oficio .lo-plan-picker button[aria-pressed=true]{background:#e8efff;border-color:#1850ff;box-shadow:inset 0 0 0 1px #1850ff;}.landing-oficio .lo-plan-picker button>strong{display:contents;font-size:11px;}.landing-oficio .lo-plan-picker button>span{grid-column:1/-1;padding:0!important;margin:0!important;font-size:11px;line-height:1.4;font-weight:600;border-radius:0;}.landing-oficio .lo-plan-picker button>small{grid-column:1/-1;font-size:10px;line-height:1.3;}.landing-oficio .lo-plan-picker strong small{font-size:8px;align-self:center;color:#315b99;white-space:nowrap;}.landing-oficio .lo-plan-next{font-size:11px!important;line-height:1.5!important;margin:8px 0 0!important;color:#64748b;text-align:center;}
      .landing-oficio .lo-plan-includes-free{display:flex;align-items:center;gap:7px;margin:12px 0 0!important;font-size:12px!important;line-height:1.5!important;font-weight:600;color:#315b99;}.landing-oficio .lo-plan-includes-free svg{flex-shrink:0;}.landing-oficio .lo-plan-card.is-premium .lo-plan-includes-free+ul{margin:6px 0 12px!important;gap:8px!important;}.landing-oficio .lo-plan-card.is-premium .lo-plan-durations{margin-bottom:12px;padding-top:8px;}
      .landing-oficio .lo-example-dialog{position:fixed;inset:0;margin:auto!important;box-sizing:border-box;width:calc(100% - 32px);max-width:360px;max-height:calc(100dvh - 32px);padding:0;border:1px solid #dfe7f2;border-radius:16px;background:white;color:#334155;box-shadow:0 24px 80px #0f172a26;overflow:auto;}
      .lo-example-dialog::backdrop{background:#0f172a70;backdrop-filter:blur(3px);}
      .lo-example-heading{display:flex;align-items:start;justify-content:space-between;gap:12px;padding:14px 16px 12px;border-bottom:1px solid #e8edf4;}.lo-example-heading>div{min-width:0;}.lo-example-heading>div>span{display:block;font-size:10px;color:#315b99;font-weight:700;margin-bottom:6px;}.landing-oficio .lo-example-heading h2{font-size:16px!important;line-height:1.35;margin:0;letter-spacing:-.015em;}.lo-example-heading>button{display:flex;align-items:center;justify-content:center;width:32px;height:32px;flex:0 0 32px;padding:0;border:1px solid #e1e7f0;border-radius:8px;background:#f8faff;color:#64748b;}
      .lo-example-body{padding:14px 16px;}.landing-oficio .lo-example-body>p{font-size:12px;line-height:1.5;color:#64748b;margin:0 0 16px;}.lo-example-paper,.lo-example-catalog{border:1px solid #dfe7f2;border-radius:10px;padding:16px;background:#fafcff;}.lo-example-label{display:block;font-size:10px;color:#8090a6;margin-bottom:12px;}.lo-example-paper-head{display:flex;align-items:center;justify-content:space-between;gap:14px;padding-bottom:14px;border-bottom:1px solid #e1e8f2;}.lo-example-business{display:flex;align-items:center;gap:8px;min-width:0;}.lo-example-monogram{display:grid;place-items:center;width:34px;height:34px;flex:0 0 34px;background:#263b59;border-radius:8px;color:white;font-weight:700;font-size:13px;}.lo-example-business strong{display:block;font-size:11px;}.lo-example-business small{display:block;font-size:9px;color:#8090a6;margin-top:2px;}.lo-example-document{text-align:right;}.lo-example-document strong{display:block;font-size:10px;}.lo-example-document span{display:block;font-size:9px;color:#8090a6;margin-top:3px;}.lo-example-emitter{display:grid;gap:3px;margin-top:12px;font-size:12px;}.lo-example-emitter>span{font-size:10px;color:#8090a6;}.lo-example-note{display:block;font-size:11px;color:#8090a6;line-height:1.6;margin-top:12px;}
      .lo-example-settings{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;padding:13px;background:#f5f8fc;border:1px solid #e1e8f2;border-radius:9px;margin-bottom:12px;}.lo-example-settings span{display:block;font-size:10px;color:#8090a6;margin-bottom:4px;}.lo-example-settings strong{display:block;font-size:12px;color:#334155;overflow-wrap:anywhere;}.lo-example-number{display:flex;align-items:center;gap:9px;padding:12px;border:1px solid #e1e8f2;border-radius:9px;margin-top:8px;color:#315b99;}.lo-example-number strong{font-size:12px;}.lo-example-number span{margin-left:auto;font-size:10px;color:#8090a6;}
      .lo-example-client{display:flex;align-items:center;gap:9px;padding:11px;background:#f5f8fc;border-radius:9px;margin-bottom:12px;}.lo-example-client small{display:block;font-size:10px;color:#8090a6;}.lo-example-client strong{font-size:12px;}.lo-example-selected{display:flex;align-items:center;gap:9px;border:1px solid #dfe7f2;border-radius:9px;padding:11px;margin-top:8px;}.lo-example-selected>svg{color:#315b99;}.lo-example-selected>div{flex:1;min-width:0;}.lo-example-selected strong,.lo-example-selected b{font-size:11px;}.lo-example-selected span{display:block;font-size:10px;color:#8090a6;margin-top:3px;}.lo-example-selected b{white-space:nowrap;}.lo-example-output{display:flex;align-items:center;gap:11px;background:#edf3ff;border:1px solid #d4e1f5;border-radius:10px;padding:14px;margin-top:14px;color:#315b99;}.lo-example-output>div{min-width:0;}.lo-example-output strong{display:block;font-size:12px;overflow-wrap:anywhere;}.lo-example-output span{display:block;font-size:10px;margin-top:3px;}.lo-example-catalog>strong{display:block;font-size:14px;margin-bottom:13px;}.lo-example-catalog .lo-example-settings{grid-template-columns:repeat(3,minmax(0,1fr));padding:10px;gap:8px;}.lo-example-reuse{display:flex;align-items:center;gap:8px;font-size:11px;color:#315b99;}
      .lo-example-bottom{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 16px;border-top:1px solid #e8edf4;background:#fafcff;}.lo-example-bottom>span{font-size:10px;color:#8090a6;}.lo-example-bottom>button{padding:8px 14px;border:1px solid #1850ff;background:#1850ff;color:#fff;border-radius:8px;font-size:12px;font-weight:700;min-height:36px;}
      @media(max-width:760px){.landing-oficio .lo-premium-example-benefit{grid-template-columns:26px minmax(0,1fr) auto;gap:7px;}.landing-oficio .lo-example-trigger{font-size:10px!important;padding:6px;}.lo-example-trigger svg{display:none!important;}}
      @media(max-width:380px){.lo-example-heading{padding:17px 16px 14px;}.lo-example-body{padding:16px;}.lo-example-bottom{padding:12px 16px;}.lo-example-paper{padding:12px;}.lo-example-paper-head{gap:8px;}.lo-example-monogram{width:28px;height:28px;flex-basis:28px;}.lo-example-business strong{font-size:10px;}.lo-example-number{flex-wrap:wrap;}.lo-example-number span{margin-left:0;width:100%;padding-left:27px;}}
${ESTILOS_ICONOS_OFICIALES}
`}</style>
    <header className="lo-header"><div className="lo-wrap"><button type="button" className="lo-brand" onClick={() => window.scrollTo({top:0,behavior:'smooth'})} aria-label="MiOficio, volver al inicio"><img src={MIOFICIO_LOGO_PERMANENTE} alt="MiOficio · Plataforma de gestión comercial" /></button><nav className="lo-nav" aria-label="Navegación de la landing"><a href="#lo-funciones">Funciones</a><a href="#lo-como-funciona">Cómo funciona</a><a href="#lo-planes">Premium</a><a href="#lo-contacto" onClick={() => setApartadoSoporte('contacto')}>Contacto</a></nav><div className="lo-header-actions"><button type="button" className="lo-login" onClick={onGoToLogin}><IconoLanding nombre="acceso" />Iniciar sesión</button><button type="button" className="lo-primary" onClick={onGoToRegister}><IconoLanding nombre="crear" />Crear cuenta</button></div></div></header>
    <main>
      <section className="lo-hero"><div className="lo-wrap"><div className="lo-hero-grid"><div><p className="lo-eyebrow lo-hero-tag"><IconoLanding nombre="gestionar" />Para profesionales, oficios y negocios</p><h1>Más tiempo<br />para <span>tu oficio.</span></h1><p className="lo-description">Tus clientes y presupuestos, <strong>ordenados desde el primer día.</strong></p><p className="lo-hero-detail">Presentá tu trabajo con claridad y llevá el control de cada presupuesto desde un solo lugar.</p><div className="lo-hero-actions"><button type="button" className="lo-primary" onClick={onGoToRegister}><IconoLanding nombre="empezar" />Comenzar gratis</button><a className="lo-secondary" href="#lo-como-funciona"><IconoLanding nombre="ver" />Ver cómo funciona</a></div><div className="lo-trust"><span><IconoLanding nombre="seguridad" />Sin tarjeta para empezar</span><span><IconoLanding nombre="dispositivos" />En PC y móvil</span><span><IconoLanding nombre="nube" />Datos en tu cuenta</span></div></div><div className="lo-hero-visual"><img className="lo-hero-photo" src={MIOFICIO_LANDING_FOTO} alt="Dos profesionales organizan su trabajo con una computadora en un taller" fetchPriority="high" /><article className="lo-budget-preview" aria-label="Presupuesto ilustrativo"><header><strong>Presupuesto</strong><span>N.º 001</span></header><p className="lo-budget-client">Cliente<strong>Cliente de ejemplo</strong></p><div className="lo-budget-line"><span>Servicio de mantenimiento</span><strong>$ 25.000</strong></div><div className="lo-budget-line"><span>IVA (21 %)</span><strong>$ 5.250</strong></div><div className="lo-budget-total"><span>Total</span><span>ARS $ 30.250</span></div><footer><IconoLanding nombre="pdf" />PDF listo para compartir</footer><p className="lo-demo-label">Datos ilustrativos</p></article></div></div></div></section>
      <div className="lo-wrap lo-section-intro"><p className="lo-eyebrow">Funciones</p><h2>Tu gestión diaria, en un solo lugar.</h2></div><section id="lo-funciones" className="lo-wrap lo-features" aria-label="Funciones de MiOficio">{[
        {nombre:'Presupuestos',descripcion:'Completá productos, servicios y condiciones, y generá el PDF para tu cliente.',icono:<IconoLanding nombre="presupuesto" />},
        {nombre:'Clientes',descripcion:'Guardá sus datos de contacto y consultá su historial de presupuestos.',icono:<IconoLanding nombre="clientes" />},
        {nombre:'Seguimiento',descripcion:'Registrá los presupuestos aceptados y pagados, y consultá los avisos de validez.',icono:<IconoLanding nombre="seguimiento" />}
      ].map(f => <article key={f.nombre}><div className="lo-feature-icon">{f.icono}</div><div className="lo-feature-title"><h3>{f.nombre}</h3></div><p>{f.descripcion}</p></article>)}</section>
      <section id="lo-como-funciona" className="lo-wrap"><div className="lo-process"><div><p className="lo-eyebrow">Cómo empezar</p><h2>Tu primer presupuesto, sin complicaciones.</h2></div>{[
        {titulo:'Creá tu cuenta',texto:'Registrate con Google o con tu correo electrónico.',icono:<IconoLanding nombre="crear" />},
        {titulo:'Completá tu perfil',texto:'Agregá los datos de tu negocio, tu rubro y tus medios de pago.',icono:<IconoLanding nombre="gestionar" />},
        {titulo:'Emití tu primer presupuesto',texto:'Cargá un cliente, detallá lo que vas a cobrar y generá el PDF.',icono:<IconoLanding nombre="presupuesto" />}
      ].map((paso,i) => <article key={paso.titulo}><div className="lo-step-icon"><span>{i+1}</span>{paso.icono}</div><h3>{paso.titulo}</h3><p>{paso.texto}</p></article>)}</div></section>
      <section id="lo-planes" className="lo-wrap lo-plans"><div className="lo-plans-intro"><p className="lo-eyebrow">Elegí cómo empezar</p><h2>Un plan para cada etapa de tu negocio.</h2><p>Empezá gratis. Cuando necesites más herramientas, activá Premium desde tu cuenta.</p></div><article className="lo-plan-card"><div className="lo-plan-heading"><h3><IconoLanding nombre="free" />Free</h3></div><p className="lo-plan-subtitle">Lo esencial para organizarte.</p><p className="lo-plan-price">$ 0 <small>para empezar</small></p><ul>{([{texto:'Gestión de clientes',icono:'clientes'},{texto:'Creación de presupuestos',icono:'presupuesto'},{texto:'PDF con marca de agua MiOficio',icono:'pdf'},{texto:'Estados y avisos de presupuestos',icono:'avisos'}] as const).map(t => <li key={t.texto}><span className="lo-plan-benefit-symbol"><IconoLanding nombre={t.icono} /></span><span>{t.texto}</span></li>)}</ul><button type="button" className="lo-secondary" onClick={onGoToRegister}><IconoLanding nombre="empezar" />Comenzar gratis</button></article><article className="lo-plan-card is-premium"><div className="lo-plan-heading"><h3><IconoLanding nombre="premium" />Premium</h3><span>Más herramientas</span></div><p className="lo-plan-subtitle">Tu identidad y más control del negocio.</p><p className="lo-plan-price">{planLanding === 'daily' ? '$ 399' : planLanding === 'weekly' ? '$ 2.799' : planLanding === 'monthly' ? '$ 11.999' : '$ 139.999'} <small>ARS / {planLanding === 'daily' ? 1 : planLanding === 'weekly' ? 7 : planLanding === 'monthly' ? 30 : 365} días</small></p><p className="lo-plan-includes-free"><IconoLanding nombre="check" />Todo lo incluido en Free, más:</p><ul>{([{texto:'Logo propio en el presupuesto',icono:'logo'},{texto:'Numeración y series personalizadas',icono:'series'},{texto:'Presupuestos de un cliente en un PDF',icono:'unir'},{texto:'Mis productos y servicios guardados',icono:'catalogo'},{texto:'Exportación a CSV para Excel',icono:'exportar'}] as const).map(t => <li key={t.texto} className="lo-premium-example-benefit"><span className="lo-plan-benefit-symbol"><IconoLanding nombre={t.icono} /></span><span>{t.texto}</span><button type="button" className="lo-example-trigger" onClick={() => setEjemploLanding(t.icono)} aria-label={`Ver ejemplo: ${t.texto}`} aria-haspopup="dialog">Ver ejemplo<IconoOficial nombre="eye" width={14} /></button></li>)}</ul><div className="lo-plan-durations lo-plan-picker" role="group" aria-label="Duración del plan Premium">{([{id:'daily',label:'Diario',precio:'399',dias:1},{id:'weekly',label:'Semanal',precio:'2.799',dias:7},{id:'monthly',label:'Mensual',precio:'11.999',dias:30},{id:'yearly',label:'Anual',precio:'139.999',dias:365}] as const).map(plan => <button type="button" key={plan.id} aria-pressed={planLanding === plan.id} onClick={() => setPlanLanding(plan.id)}><strong>{plan.label}{plan.id === 'yearly' && <small>Más elegido</small>}</strong><span>ARS $ {plan.precio}</span><small>{plan.dias} {plan.dias === 1 ? 'día' : 'días'}</small></button>)}</div><button type="button" className="lo-primary" onClick={() => onElegirPremium(planLanding)}><IconoLanding nombre="premium" />Elegir Premium</button><p className="lo-plan-next">Creá tu cuenta o iniciá sesión para continuar al pago.</p></article></section>
      <p className="lo-plan-security"><IconoLanding nombre="seguridad" />Los pagos Premium se procesan con Mercado Pago. Los datos de tu tarjeta están protegidos por Mercado Pago.</p>
      <section className="lo-faq" aria-label="Preguntas frecuentes"><p className="lo-eyebrow">Respuestas claras</p><h2>Antes de empezar</h2><p className="lo-faq-intro">Conocé cómo empezar, qué incluye cada plan y cómo gestionar tus presupuestos en el día a día.</p>{[
        ['¿Qué necesito para empezar a usar MiOficio?', 'Creá tu cuenta y completá tu perfil profesional con los datos que querés mostrar en tus presupuestos: nombre comercial o razón social, identificación, domicilio y contacto. También podés configurar tus medios de pago para reutilizarlos al crear un presupuesto.\n\nDespués, registrá un cliente y cargá los productos o servicios, cantidades, precios y condiciones del trabajo. Al emitir el presupuesto, MiOficio genera el PDF con esa información.'],
        ['¿Puedo usar MiOficio desde el celular o la computadora?', 'Sí. Accedés desde el navegador, sin instalar una aplicación. La interfaz se adapta al tamaño de la pantalla para que puedas consultar clientes, crear presupuestos y gestionar sus estados desde una computadora, un teléfono o una tablet.\n\nUsás un solo formulario en PC y celular: elegís cliente, cargás el trabajo y su precio y generás el presupuesto. El cliente aporta sus datos automáticamente; el formulario organiza el trabajo y la configuración en columnas. Los datos que completás y el modelo del PDF son los mismos. Iniciá sesión con la misma cuenta para acceder a tus datos guardados desde otro dispositivo.'],
        ['¿Cómo genero y comparto un presupuesto con mi cliente?', 'Elegí el cliente, completá el detalle de los productos o servicios y revisá los precios, impuestos y condiciones antes de emitirlo. Cuando lo emitís, el PDF se abre en el navegador para que puedas revisarlo.\n\nDesde el visor o las opciones de tu dispositivo podés guardarlo, imprimirlo o compartirlo. Por ejemplo, podés descargar el archivo y adjuntarlo en WhatsApp o en un correo. Las opciones disponibles dependen del navegador y del dispositivo que uses.'],
        ['¿Cómo sé si un presupuesto fue aceptado o pagado?', 'El presupuesto queda como Emitido cuando generás su PDF por primera vez. Cuando tu cliente confirma el trabajo, podés marcarlo como Aceptado; cuando recibís el cobro, podés marcarlo como Pagado.\n\nEstos cambios los registrás vos: compartir el PDF no confirma automáticamente la aceptación ni acredita un pago. Así mantenés el seguimiento de cada presupuesto de acuerdo con lo que ocurrió con tu cliente.'],
        ['¿Qué diferencia hay entre Free y Premium? ¿Cambia el PDF?', 'Free te permite gestionar clientes, crear presupuestos y registrar sus estados. El PDF incluye la marca de agua oficial de MiOficio. Premium agrega herramientas como tu logo profesional, numeración y series personalizadas, productos y servicios guardados y presupuestos de un cliente reunidos en un PDF.\n\nEl modelo del presupuesto se mantiene en ambos planes. Con Premium podés cargar tu propio logo; si todavía no lo cargaste, se conserva la marca de agua oficial de MiOficio. Tus datos, los ítems y los totales siguen la misma estructura.'],
        ['¿Qué diferencia hay entre dar de baja Premium y pedir un reintegro?', 'La baja pone fin al acceso Premium cuando se hace efectiva y la cuenta pasa a Free, conservando clientes y presupuestos. Si hay renovación automática, también debe cancelarse en la pasarela.\n\nLa baja anticipada no genera por sí sola una devolución proporcional. El arrepentimiento y los reintegros que correspondan por ley se evalúan por separado. Actualmente podés enviar la solicitud desde los botones del sitio y recibir la confirmación por atención.'],
        ['¿Tengo que pagar o ingresar una tarjeta para crear mi cuenta?', 'No. Podés crear tu cuenta y comenzar con Free sin ingresar una tarjeta. Si necesitás las funciones adicionales, podés elegir Premium desde tu cuenta y seleccionar el período disponible: diario, semanal, mensual o anual.\n\nAntes de continuar con el pago, revisá el importe y la duración del plan elegido. Los pagos Premium se procesan con Mercado Pago y Los datos de tu tarjeta están protegidos por Mercado Pago.']
      ].map(([pregunta,respuesta]) => <details key={pregunta}><summary>{pregunta}<IconoLanding nombre="desplegar" /></summary><div className="lo-faq-answer">{respuesta.split('\n\n').map((parrafo,indice) => <p key={indice}>{parrafo}</p>)}</div></details>)}</section>

      <div className="lo-wrap lo-support-area"><div className="lo-support-tabs" role="tablist" aria-label="Contacto e información del servicio"><button type="button" role="tab" id="lo-contact-tab" aria-selected={apartadoSoporte === 'contacto'} aria-controls="lo-contacto" onClick={() => setApartadoSoporte('contacto')}><IconoOficial nombre="message-circle" width={16} />Contacto</button><button type="button" role="tab" id="lo-terms-tab" aria-selected={apartadoSoporte === 'terminos'} aria-controls="lo-terminos" onClick={() => { setApartadoSoporte('terminos'); setTerminosAbiertos(true); }}><IconoOficial nombre="file-text" width={16} />Términos y condiciones</button></div><div className="lo-support-grid">
      <section id="lo-terminos" className="lo-terms" data-active={apartadoSoporte === 'terminos'} aria-labelledby="lo-terms-title"><div className="lo-terms-intro"><p className="lo-eyebrow">Información del servicio</p><h2 id="lo-terms-title">Términos y condiciones</h2><p>Conocé cómo funciona MiOficio, cómo se contrata Premium y qué canales tenés para solicitar ayuda.</p></div><details className="lo-terms-document" open={terminosAbiertos} onToggle={e => setTerminosAbiertos(e.currentTarget.open)}><summary><span><strong>Condiciones de uso y contratación</strong><small>Actualización: 7 de octubre de 2026</small></span><IconoOficial nombre="chevron-down" width={18} /></summary><div className="lo-terms-content">{[{"titulo": "1. Prestador y alcance del servicio", "parrafos": ["MiOficio es una plataforma de gestión comercial prestada por Miguel Rios, persona física, CUIT 20-30285382-8. Los canales de contacto son contacto@mioficio.com.ar, el teléfono 342 5057930, WhatsApp y el formulario disponible en este sitio.", "El servicio permite registrar clientes, crear presupuestos, generar su PDF y registrar sus estados. Se accede desde el navegador de una computadora o dispositivo móvil. Se ofrece acceso a software; no se comercializan productos físicos ni se realizan envíos de mercadería."]}, {"titulo": "2. Creación y uso de la cuenta", "parrafos": ["La cuenta se crea mediante Google o correo electrónico y contraseña. El usuario completa su perfil profesional y registra los datos que utilizará en sus presupuestos.", "El usuario debe proporcionar datos correctos, proteger sus credenciales y cargar únicamente información que esté autorizado a utilizar. Los datos de sus clientes y el contenido de cada presupuesto son responsabilidad de quien los registra."]}, {"titulo": "3. Plan Free y funciones Premium", "parrafos": ["Free permite la gestión de clientes, la creación de presupuestos y su PDF con la identidad de MiOficio, además del registro de estados y avisos.", "Premium agrega el logo profesional, numeración y series, productos y servicios guardados y la posibilidad de reunir presupuestos de un mismo cliente en un PDF. También permite exportar clientes y presupuestos a CSV, con filtros de fecha y moneda para los presupuestos. En dispositivos móviles compatibles permite compartir el PDF y copiar el mensaje para enviarlo por WhatsApp.", "La contratación habilita las funciones del plan. No incluye trabajos profesionales realizados por MiOficio, desarrollo a medida ni la elaboración de presupuestos por cuenta del usuario."]}, {"titulo": "4. Cómo se contrata y paga Premium", "parrafos": ["Para contratar Premium, el usuario inicia sesión, abre la selección de planes, elige una opción y revisa el importe y el período de acceso. Al continuar, se lo dirige al proceso de pago de Mercado Pago Go.", "El precio aplicable es el informado antes de confirmar el pago. Los importes se muestran en pesos argentinos. MiOficio no solicita ni almacena en sus formularios los datos completos de la tarjeta.", "El usuario debe conservar el comprobante o la referencia de la operación. Un intento de pago rechazado o pendiente no implica por sí solo la activación del acceso Premium. Si un cobro aprobado no se refleja en la cuenta, debe contactarnos con el correo de la cuenta y la referencia del pago."]}, {"titulo": "5. Período de acceso y activación", "parrafos": ["Los períodos ofrecidos en la selección de planes son: diario, 1 día; semanal, 7 días; mensual, 30 días; y anual, 365 días. Antes de contratar, el usuario debe revisar el plan y el período que se muestran en la confirmación de pago.", "El acceso Premium requiere la confirmación de la operación y su asociación con la cuenta utilizada para contratar. Ante una diferencia entre el plan elegido, el importe cobrado o las funciones habilitadas, el usuario puede solicitar su revisión por los canales de contacto."]}, {"titulo": "6. Presupuestos y documentos generados", "parrafos": ["Los precios, impuestos, cantidades, productos, servicios, medios de pago y condiciones de cada presupuesto los carga el usuario. Antes de enviarlo, debe revisar el PDF y corregir los datos que correspondan.", "El PDF generado es un presupuesto comercial. No reemplaza una factura fiscal ni certifica que el cliente haya aceptado el trabajo o efectuado el pago. Los estados Aceptado y Pagado se registran según la información disponible para el usuario.", "Compartir un archivo desde el teléfono depende de las funciones del navegador y de las aplicaciones instaladas. Abrir WhatsApp o preparar un mensaje no equivale a confirmar su recepción por el destinatario."]}, {"titulo": "7. Baja, arrepentimiento y consultas sobre reintegros", "parrafos": ["La baja de Premium y el arrepentimiento de la contratación son trámites distintos. Ambos pueden solicitarse desde los accesos públicos del sitio o por los canales de atención. Se debe identificar la cuenta y, si corresponde, la operación de pago; nunca enviar la contraseña ni los datos completos de la tarjeta.", "Al hacerse efectiva una baja inmediata de Premium, la cuenta pasa a Free y conserva sus clientes y presupuestos. Si la contratación tiene renovación automática, su cancelación debe quedar confirmada en la pasarela para detener los cobros futuros asociados. El usuario puede volver a contratar Premium. Actualmente, los accesos del sitio envían una solicitud a atención; no ejecutan por sí solos una cancelación en Mercado Pago.", "La baja anticipada no genera por sí sola un reembolso proporcional por el período restante. Esto no limita el derecho de arrepentimiento ni otros reintegros que correspondan conforme a la legislación aplicable.", "Cuando la contratación constituya una relación de consumo y corresponda el derecho de revocación por contratación a distancia, el usuario puede ejercerlo dentro del plazo legal de 10 días. Su procedencia y efectos se determinan según la Ley 24.240, el Código Civil y Comercial y las normas aplicables, incluidas sus excepciones. No se presume que toda contratación de software esté exenta.", "Cuando corresponda un reintegro, se gestionará sobre la operación identificada y se informará su estado. Un aviso de solicitud recibida no equivale a un reembolso completado. Para revisar un cobro duplicado, no reconocido o una activación incorrecta, se debe informar el correo de la cuenta, la fecha y la referencia de la operación."]}, {"titulo": "8. Disponibilidad y atención", "parrafos": ["La plataforma requiere conexión a internet y un navegador compatible. Si una función falla, el usuario puede describir el problema e indicar la cuenta y el dispositivo utilizado mediante los canales de contacto.", "El servicio puede requerir mantenimiento o verse afectado por incidencias de conexión, autenticación o procesamiento de pagos. La atención de consultas se realiza por los canales publicados; no se ofrece un horario de atención permanente ni un plazo de respuesta garantizado."]}, {"titulo": "9. Vigencia de estas condiciones", "parrafos": ["Estas condiciones describen el servicio de MiOficio y sus canales de contratación y atención. Las condiciones y el importe informados al contratar deben poder consultarse antes de confirmar una compra.", "Las modificaciones futuras se publicarán en este apartado. La versión indicada corresponde al 7 de octubre de 2026."]}].map((item,index) => <details className="lo-terms-topic" key={item.titulo}><summary><span className="lo-terms-topic-icon"><IconoOficial nombre={(['clipboard-list','user-round','crown','credit-card','clock','file-text','circle-x','monitor-smartphone','history'] as const)[index]} width={16} /></span><h3>{item.titulo}</h3><IconoOficial nombre="chevron-down" width={14} /></summary><div className="lo-terms-topic-body">{item.parrafos.map(parrafo => <p key={parrafo}>{parrafo}</p>)}</div></details>)}<div className="lo-terms-actions"><button type="button" onClick={() => iniciarSolicitudServicio('baja')}>Solicitar baja del servicio</button><button type="button" onClick={() => iniciarSolicitudServicio('arrepentimiento')}>Botón de arrepentimiento</button></div></div></details></section>
      <section id="lo-contacto" className="lo-contact" data-active={apartadoSoporte === 'contacto'} aria-labelledby="lo-contact-title">
        <div className="lo-contact-copy"><p className="lo-eyebrow">Contacto y atención</p><h2 id="lo-contact-title">¿En qué podemos ayudarte?</h2><p className="lo-contact-description">Si tenés una consulta sobre MiOficio, tu cuenta o los planes Premium, escribinos.</p><div className="lo-contact-channels"><a href="mailto:contacto@mioficio.com.ar"><span className="lo-contact-channel-icon"><IconoOficial nombre="mail" width={18} /></span><span className="lo-contact-channel-copy"><strong>Por correo</strong><small>contacto@mioficio.com.ar</small></span><IconoOficial nombre="arrow-up-right" width={14} /></a><a href="tel:+543425057930"><span className="lo-contact-channel-icon"><IconoOficial nombre="phone" width={18} /></span><span className="lo-contact-channel-copy"><strong>Por teléfono</strong><small>342 5057930</small></span><IconoOficial nombre="arrow-up-right" width={14} /></a><a href="https://wa.me/5493425057930" target="_blank" rel="noopener noreferrer"><span className="lo-contact-channel-icon"><IconoOficial nombre="message-circle" width={18} /></span><span className="lo-contact-channel-copy"><strong>Por WhatsApp</strong><small>Iniciar conversación</small></span><IconoOficial nombre="arrow-up-right" width={14} /></a></div></div>
        <form className="lo-contact-form" onSubmit={enviarContacto} aria-busy={enviandoContacto}><div className="lo-contact-form-heading"><h3>Dejanos tu consulta</h3><p>Completá tus datos y contanos cómo podemos ayudarte.</p></div>
          <div className="lo-contact-field"><label htmlFor="lo-contact-name">Nombre</label><input id="lo-contact-name" name="nombre" placeholder="Tu nombre" autoComplete="name" required minLength={2} maxLength={80} value={contacto.nombre} disabled={enviandoContacto} onChange={e => setContacto({...contacto,nombre:e.target.value})} /></div>
          <div className="lo-contact-field"><label htmlFor="lo-contact-email">Correo electrónico</label><input id="lo-contact-email" name="email" placeholder="nombre@ejemplo.com" type="email" inputMode="email" autoComplete="email" autoCapitalize="none" required maxLength={254} value={contacto.email} disabled={enviandoContacto} onChange={e => setContacto({...contacto,email:e.target.value})} /></div>
          <div className="lo-contact-field lo-contact-wide"><label htmlFor="lo-contact-message">Mensaje</label><textarea id="lo-contact-message" name="mensaje" placeholder="Escribí tu consulta…" required minLength={10} maxLength={2000} rows={4} value={contacto.mensaje} disabled={enviandoContacto} onChange={e => setContacto({...contacto,mensaje:e.target.value})} /></div>
          <div className="lo-contact-honeypot" aria-hidden="true"><label htmlFor="lo-contact-website">Sitio web</label><input id="lo-contact-website" name="website" tabIndex={-1} autoComplete="off" value={contacto.website} onChange={e => setContacto({...contacto,website:e.target.value})} /></div>
          {!correoContactoDisponible && !verificandoContacto && <small className="lo-contact-wide">Por ahora, tu consulta se abre en WhatsApp para que confirmes el envío.</small>}
          {resultadoContacto && <p className={`lo-contact-result lo-contact-wide ${resultadoContacto.error ? 'is-error' : ''}`} role={resultadoContacto.error ? 'alert' : 'status'}>{resultadoContacto.texto}</p>}
          <button type="submit" className="lo-primary lo-contact-wide" disabled={enviandoContacto || verificandoContacto}>{verificandoContacto ? 'Preparando contacto…' : enviandoContacto ? 'Enviando…' : correoContactoDisponible ? 'Enviar mensaje' : 'Continuar por WhatsApp'}<IconoOficial nombre={correoContactoDisponible ? 'send' : 'share-2'} width={16} /></button>
        </form>
      </section>
      </div></div>
    </main><footer className="lo-footer"><div className="lo-wrap lo-footer-main"><div className="lo-footer-brand"><img src={MIOFICIO_LOGO_PERMANENTE} alt="MiOficio" loading="lazy" /><p>Plataforma de gestión para profesionales, oficios y negocios.</p></div><div className="lo-footer-legal"><span className="lo-footer-legal-label">Titular del servicio</span><strong>Miguel Rios</strong><p>Persona física<br />CUIT: 20-30285382-8</p></div><nav className="lo-footer-links" aria-label="Información y atención"><div><span className="lo-footer-legal-label">Información</span><a href="#lo-planes">Planes y funciones</a><a href="#lo-terminos" onClick={() => { setApartadoSoporte('terminos'); setTerminosAbiertos(true); }}>Términos y condiciones</a></div><div><span className="lo-footer-legal-label">Atención y solicitudes</span><a href="#lo-contacto" onClick={() => setApartadoSoporte('contacto')}>Contacto</a><a href="mailto:contacto@mioficio.com.ar">contacto@mioficio.com.ar</a><button type="button" onClick={() => iniciarSolicitudServicio('arrepentimiento')}>Botón de arrepentimiento</button><button type="button" onClick={() => iniciarSolicitudServicio('baja')}>Baja del servicio</button></div></nav></div><div className="lo-wrap lo-footer-bottom"><p>© {new Date().getFullYear()} MiOficio. Todos los derechos reservados.</p><a href="#landing-inicio">Volver al inicio<IconoOficial nombre="arrow-up-right" width={14} /></a></div></footer>
    <dialog ref={dialogoEjemploLanding} className="lo-example-dialog" aria-labelledby="lo-example-title" onClose={() => setEjemploLanding(null)} onClick={e => { if (e.target === e.currentTarget) { const r = e.currentTarget.getBoundingClientRect(); if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) setEjemploLanding(null); } }}>
      <div className="lo-example-heading"><div><span>MiOficio Premium · Ejemplo</span><h2 id="lo-example-title">{ejemploLanding === 'logo' ? 'Tu logo en el presupuesto' : ejemploLanding === 'series' ? 'Numeración y series' : ejemploLanding === 'unir' ? 'Un cliente, un solo archivo' : ejemploLanding === 'catalogo' ? 'Productos y servicios guardados' : 'Exportación de datos'}</h2></div><button type="button" autoFocus aria-label="Cerrar ejemplo" onClick={() => setEjemploLanding(null)}><IconoOficial nombre="x" width={18} /></button></div>
      <div className="lo-example-body">
        {ejemploLanding === 'logo' && <><p>Cargás el logo de tu negocio desde Herramientas Premium para usarlo en tus presupuestos.</p><div className="lo-example-paper"><span className="lo-example-label">Ejemplo de encabezado</span><div className="lo-example-paper-head"><div className="lo-example-business"><span className="lo-example-monogram">TN</span><div><strong>TALLER NORTE</strong><small>Servicios y mantenimiento</small></div></div><div className="lo-example-document"><strong>PRESUPUESTO</strong><span>N.º PRES-2026-001</span></div></div><div className="lo-example-emitter"><strong>Taller Norte</strong><span>Datos profesionales del emisor</span></div></div><small className="lo-example-note">El modelo del PDF se mantiene. Este ejemplo muestra la ubicación de la identidad del negocio.</small></>}
        {ejemploLanding === 'series' && <><p>Elegís el prefijo y el próximo número para identificar tus presupuestos.</p><div className="lo-example-settings"><div><span>Prefijo de ejemplo</span><strong>PRES-2026-</strong></div><div><span>Próximo número</span><strong>001</strong></div></div><div className="lo-example-number"><IconoOficial nombre="file-text" width={18} /><strong>PRES-2026-001</strong><span>Primer presupuesto</span></div><div className="lo-example-number"><IconoOficial nombre="file-text" width={18} /><strong>PRES-2026-002</strong><span>Siguiente presupuesto</span></div></>}
        {ejemploLanding === 'unir' && <><p>Seleccionás presupuestos de un mismo cliente y generás un PDF que conserva cada documento y su total.</p><div className="lo-example-client"><IconoOficial nombre="user-round" width={18} /><div><small>Cliente de ejemplo</small><strong>Laura Gómez</strong></div></div><div className="lo-example-selected"><IconoOficial nombre="circle-check" width={18} /><div><strong>PRES-2026-001</strong><span>Servicio de mantenimiento</span></div><b>ARS $ 30.250</b></div><div className="lo-example-selected"><IconoOficial nombre="circle-check" width={18} /><div><strong>PRES-2026-002</strong><span>Materiales y repuestos</span></div><b>ARS $ 12.100</b></div><div className="lo-example-output"><IconoOficial nombre="files" width={22} /><div><strong>Presupuestos_Laura_Gomez.pdf</strong><span>Un archivo · 2 documentos</span></div></div><small className="lo-example-note">Cada presupuesto conserva su número, sus importes y su formato original.</small></>}
        {ejemploLanding === 'catalogo' && <><p>Guardás los datos de tus productos o servicios para reutilizarlos al crear otro presupuesto.</p><div className="lo-example-catalog"><span className="lo-example-label">Artículo guardado</span><strong>Servicio de mantenimiento</strong><div className="lo-example-settings"><div><span>Unidad</span><strong>UNI</strong></div><div><span>Precio neto</span><strong>ARS $ 25.000</strong></div><div><span>IVA</span><strong>21 %</strong></div></div><div className="lo-example-reuse"><IconoOficial nombre="package-search" width={18} /><span>Disponible en “Mis productos y servicios”</span></div></div><small className="lo-example-note">Al agregarlo, podés ajustar la cantidad y los valores para ese presupuesto.</small></>}
      {ejemploLanding === 'exportar' && <><p>Descargás tus clientes o presupuestos y los abrís en Excel. Podés elegir fechas y moneda al exportar presupuestos.</p><div className="lo-example-output"><IconoOficial nombre="download" width={22} /><div><strong>MiOficio_presupuestos.csv</strong><span>Número · Cliente · Fecha · Moneda · Importe · Estado</span></div></div><small className="lo-example-note">Los datos de cada moneda se conservan sin convertir ni sumar importes de monedas distintas.</small></>}
      </div><div className="lo-example-bottom"><span>Datos ilustrativos</span><button type="button" onClick={() => setEjemploLanding(null)}>Entendido</button></div>
    </dialog>

  </div>;
}


// ------------------------------------------------------------------------------
// COMPONENTE: AUTH — EXPERIENCIA PROFESIONAL
// ------------------------------------------------------------------------------
function AuthScreen({
  initialMode = 'login',
  onLoginSuccess,
  onBackToLanding
}: {
  initialMode?: 'login' | 'register';
  onLoginSuccess: (user: FirebaseUser) => void;
  onBackToLanding: () => void
}) {
  const [isRegisterMode, setIsRegisterMode] = useState(initialMode === 'register');
  const [cargando, setCargando] = useState(false);
  const [errorLogin, setErrorLogin] = useState<string | null>(null);
  const [emailInput, setEmailInput] = useState('');
  const [passwordInput, setPasswordInput] = useState('');
  const [mostrarPassword, setMostrarPassword] = useState(false);

  useEffect(() => {
    setIsRegisterMode(initialMode === 'register');
    setErrorLogin(null);
  }, [initialMode]);

  const handleGoogleLogin = async () => {
    if (cargando) return;
    setCargando(true);
    setErrorLogin(null);
    try {
      const result = await signInWithPopup(auth, googleProvider);
      if (result.user) onLoginSuccess(result.user);
    } catch (error: unknown) {
      const codigo = (error as { code?: string })?.code;
      switch (codigo) {
        case 'auth/popup-closed-by-user':
          setErrorLogin('El acceso con Google no se completó. Volvé a intentarlo y mantené abierta la ventana hasta terminar de elegir tu cuenta. Si se cierra sola, podés ingresar con correo y contraseña si ya tenés ese método configurado.');
          break;
        case 'auth/popup-blocked':
          setErrorLogin('El navegador bloqueó la ventana de Google. Permití las ventanas emergentes para este sitio y volvé a tocar Continuar con Google.');
          break;
        case 'auth/cancelled-popup-request':
          setErrorLogin('Ya se había iniciado otra solicitud de acceso. Volvé a tocar Continuar con Google una sola vez y completá la selección de tu cuenta.');
          break;
        case 'auth/unauthorized-domain':
          setErrorLogin('Este dominio todavía no está habilitado para ingresar con Google. El administrador debe autorizarlo en Firebase Authentication.');
          break;
        case 'auth/network-request-failed':
          setErrorLogin('No se pudo conectar con el servicio de acceso. Revisá tu conexión y volvé a intentarlo.');
          break;
        case 'auth/operation-not-allowed':
          setErrorLogin('El acceso con Google no está habilitado en la configuración del servicio. Contactá al administrador.');
          break;
        default:
          setErrorLogin('No se pudo iniciar sesión con Google. Volvé a intentarlo.');
      }
    } finally {
      setCargando(false);
    }
  };

  const handleEmailAuth = async (e: FormEvent) => {
    e.preventDefault();
    if (!emailInput.trim() || !passwordInput) {
      setErrorLogin("Completa tu correo y contraseña para continuar.");
      return;
    }
    setCargando(true);
    setErrorLogin(null);
    try {
      if (isRegisterMode) {
        const userCredential = await createUserWithEmailAndPassword(auth, emailInput.trim(), passwordInput);
        if (userCredential.user) onLoginSuccess(userCredential.user);
      } else {
        const userCredential = await signInWithEmailAndPassword(auth, emailInput.trim(), passwordInput);
        if (userCredential.user) onLoginSuccess(userCredential.user);
      }
    } catch (error: any) {
      console.error("Error de autenticación:", error);
      if (error.code === 'auth/email-already-in-use') setErrorLogin("Este correo ya está registrado. Inicia sesión.");
      else if (error.code === 'auth/wrong-password' || error.code === 'auth/invalid-credential') setErrorLogin("El correo o la contraseña no son correctos.");
      else if (error.code === 'auth/weak-password') setErrorLogin("La contraseña debe tener al menos 6 caracteres.");
      else if (error.code === 'auth/invalid-email') setErrorLogin("Ingresa un correo electrónico válido.");
      else setErrorLogin("No pudimos completar la autenticación. Verifica tus datos.");
      setCargando(false);
    }
  };

  return (
    <main className="mioficio-auth">
      <style>{`
        @font-face{font-family:MiOficioAccess;src:url(data:font/ttf;base64,${ROBOTO_REGULAR_BASE64}) format('truetype');font-weight:400;font-display:swap}
        @font-face{font-family:MiOficioAccess;src:url(data:font/ttf;base64,${ROBOTO_BOLD_BASE64}) format('truetype');font-weight:700;font-display:swap}
        .mioficio-auth{min-height:100svh;background:#f6f8fc;color:#14233d;display:flex;flex-direction:column;padding:26px 36px;font-family:MiOficioAccess,Arial,sans-serif;font-synthesis:none}
        .mioficio-auth *{box-sizing:border-box;font-family:inherit}.mioficio-auth button,.mioficio-auth input{font-family:MiOficioAccess,Arial,sans-serif!important}
        .mioficio-auth button{cursor:pointer;transition:transform .2s ease,background .2s ease,box-shadow .2s ease}.mioficio-auth button:disabled{opacity:.6;cursor:wait}.mioficio-auth button:focus-visible{outline:3px solid #9abaff;outline-offset:3px}.mioficio-auth button:active:not(:disabled){transform:translateY(1px)}
        .ma-top{max-width:1100px;width:100%;margin:0 auto;display:flex;justify-content:space-between;align-items:center;gap:16px}.ma-brand{background:none;border:0;padding:0}.ma-brand img{width:215px;height:auto;display:block}.ma-back{border:1px solid #dce4ef;border-radius:10px;background:white;padding:10px 14px;display:flex;align-items:center;gap:7px;font-size:12px;color:#52627a}.ma-back .lo-icon{transform:rotate(180deg)}
        .mioficio-auth .lo-icon{}.ma-layout{max-width:1040px;width:100%;margin:auto;display:grid;grid-template-columns:minmax(0,1fr) 410px;gap:70px;align-items:center;padding:32px 0}
        .ma-story .ma-eyebrow{display:inline-block;font-family:MiOficioAccess,Arial,sans-serif!important;font-size:12px!important;font-weight:700!important;line-height:1.5;color:#315b99;letter-spacing:0!important;text-transform:none!important;background:#edf2fb;border:1px solid #dce6f5;border-radius:8px;padding:7px 11px;margin:0 0 20px}.ma-story h1{font-family:MiOficioAccess,Arial,sans-serif!important;font-size:40px!important;font-weight:700!important;letter-spacing:-.025em!important;line-height:1.22!important;margin:0 0 20px!important;text-wrap:balance;color:#172b49}.ma-story h1 span{display:block;color:#1850ff;margin-top:3px}.ma-story>p:not(.ma-eyebrow){font-family:MiOficioAccess,Arial,sans-serif!important;font-size:15px!important;font-weight:400!important;line-height:1.8!important;letter-spacing:0!important;color:#52647e;max-width:410px;margin:0;text-wrap:pretty}.ma-benefits{display:grid;gap:14px;margin-top:28px}.ma-benefit{display:flex;align-items:center;gap:12px}.ma-benefit-icon{width:42px;height:42px;border:1px solid #dce6fa;background:#eaf0ff;color:#1850ff;border-radius:12px;display:grid;place-items:center;flex-shrink:0}.ma-benefit-icon .lo-icon{}.ma-benefit strong{font-size:13px;font-weight:700;display:block;margin-bottom:3px}.ma-benefit p{font-size:12px;color:#65758b;margin:0;line-height:1.5}
        .ma-card{background:#fff;border:1px solid #dfe6f0;box-shadow:0 14px 45px #243b6310;border-radius:20px;padding:28px;min-width:0}.ma-card-heading{display:flex;gap:12px;align-items:center;margin-bottom:20px}.ma-access-icon{width:43px;height:43px;border-radius:12px;background:#edf2ff;color:#1850ff;display:grid;place-items:center;flex-shrink:0}.ma-access-icon .lo-icon{}.ma-card h2{font-size:24px;line-height:1.2;letter-spacing:-.025em;margin:0 0 5px;font-weight:700}.ma-card-heading p{font-size:12px;color:#617089;line-height:1.5;margin:0}
        .ma-google,.ma-submit{min-height:44px;width:100%;display:flex;align-items:center;justify-content:center;gap:10px;border-radius:10px;font-size:13px;font-weight:700}.ma-google{background:#fff;border:1px solid #dce4ef;color:#26354c}.ma-google-icon{width:18px;height:18px;flex-shrink:0}.ma-divider{display:flex;align-items:center;gap:12px;color:#7a879a;font-size:11px;margin:20px 0}.ma-divider:before,.ma-divider:after{content:'';height:1px;background:#e5eaf2;flex:1}
        .ma-form{display:grid;gap:15px}.ma-field label{font-size:12px;font-weight:700;display:block;margin-bottom:7px;color:#34445c}.ma-field input{width:100%;height:44px;background:#f9fbfe;border:1px solid #dce4ef;border-radius:10px;color:#17253c;font-size:14px!important;padding:0 12px;outline:none;transition:box-shadow .2s,border-color .2s}.ma-field input:focus{border-color:#1850ff;box-shadow:0 0 0 3px #1850ff12}.ma-field input::placeholder{color:#91a0b3}.ma-password{position:relative}.ma-password input{padding-right:78px}.ma-password button{position:absolute;right:8px;top:8px;height:28px;font-size:11px;color:#1850ff;border:0;border-radius:6px;background:#edf2ff;padding:0 9px}.ma-hint{font-size:11px;line-height:1.5;margin:6px 0 0;color:#718096}.ma-submit{background:#1850ff;color:white;border:1px solid #1850ff;box-shadow:0 5px 12px #1850ff18;margin-top:2px}.ma-switch{padding-top:18px;margin-top:20px;border-top:1px solid #edf0f5;text-align:center;font-size:12px;color:#66758a}.ma-switch button{display:inline-block;background:none;border:0;color:#1850ff;font-weight:700;font-size:12px;padding:5px 7px}.ma-security{display:flex;gap:6px;align-items:center;justify-content:center;font-size:10px;color:#718096;line-height:1.5;margin:16px 0 0}.ma-security .lo-icon{}.ma-error{background:#fff3f3;border:1px solid #f5cccc;border-radius:10px;font-size:12px;line-height:1.6;color:#a92e36;padding:10px 12px;margin:0 0 16px}.ma-footer{text-align:center;font-size:10px;color:#7d8a9c;padding-top:8px}.ma-loading{display:inline-block;width:16px;height:16px;border:2px solid #ffffff66;border-top-color:#fff;border-radius:50%;animation:ma-spin .8s linear infinite}@keyframes ma-spin{to{transform:rotate(360deg)}}
        @media(hover:hover) and (pointer:fine){.ma-google:hover:not(:disabled),.ma-back:hover{background:#f4f7ff;transform:translateY(-2px);box-shadow:0 5px 14px #253b6310}.ma-submit:hover:not(:disabled){background:#1243df;transform:translateY(-2px);box-shadow:0 9px 18px #1850ff25}.ma-switch button:hover{background:#edf2ff;border-radius:6px}}
        @media(max-width:900px){.ma-layout{gap:32px;grid-template-columns:minmax(0,1fr) 380px}.ma-story h1{font-size:34px!important}}
        @media(max-width:720px){.mioficio-auth{padding:18px 16px}.ma-top{max-width:410px}.ma-brand img{width:170px}.ma-back{padding:8px;font-size:11px;border:0;background:none}.ma-back .lo-icon{}.ma-layout{display:block;max-width:410px;padding:24px 0;margin:auto}.ma-story{display:none}.ma-card{padding:24px 22px;border-radius:18px}.ma-card h2{font-size:23px}.ma-field input{font-size:16px!important}.ma-footer{padding:6px 0 2px}}
        @media(max-width:360px){.ma-brand img{width:145px}.ma-card{padding:22px 17px}.ma-back{font-size:10px;gap:4px}}
        @media(prefers-reduced-motion:reduce){.mioficio-auth button{transition:none!important;transform:none!important}.ma-loading{animation:none}}
      

        .ma-back-short{display:none;}
        @media(max-width:760px){
          .mioficio-auth{width:100%;min-width:0;min-height:100svh;padding:16px 16px 12px;padding-bottom:max(12px,env(safe-area-inset-bottom));}
          .mioficio-auth .ma-top{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;width:100%;max-width:440px;margin:0 auto;}
          .mioficio-auth .ma-brand{min-width:0;justify-self:start;}
          .mioficio-auth .ma-brand img{width:158px;max-width:100%;height:auto;}
          .mioficio-auth .ma-back{display:flex;align-items:center;justify-content:center;gap:6px;min-height:40px;padding:8px 10px;border:1px solid #dce4ef;border-radius:9px;background:white;font-size:12px;white-space:nowrap;}
          .ma-back-full{display:none;}.ma-back-short{display:inline;}
          .mioficio-auth .ma-back svg.mioficio-lucide-icon{--mioficio-icon-size:16px!important;}
          .mioficio-auth .ma-layout{display:block;width:100%;min-width:0;max-width:440px;padding:0;margin:22px auto 16px;}
          .mioficio-auth .ma-story{display:none;}
          .mioficio-auth .ma-card{width:100%;min-width:0;padding:22px 20px;border-radius:16px;border:1px solid #dfe6f0;box-shadow:0 8px 24px #243b630a;}
          .mioficio-auth .ma-card-heading{gap:10px;align-items:center;margin-bottom:18px;}
          .mioficio-auth .ma-card-heading>div{min-width:0;}
          .mioficio-auth .ma-access-icon{width:36px;height:36px;border-radius:10px;}
          .mioficio-auth .ma-access-icon svg.mioficio-lucide-icon{--mioficio-icon-size:20px!important;}
          .mioficio-auth .ma-card h2{font-size:22px;line-height:1.25;margin-bottom:4px;}
          .mioficio-auth .ma-card-heading p{font-size:12px;line-height:1.5;}
          .mioficio-auth :is(.ma-google,.ma-submit){min-height:44px;padding:11px 12px;font-size:14px;line-height:1.4;gap:8px;}
          .mioficio-auth .ma-divider{margin:16px 0;font-size:11px;gap:10px;}
          .mioficio-auth .ma-form{gap:14px;}
          .mioficio-auth .ma-field{min-width:0;}
          .mioficio-auth .ma-field label{font-size:12px;margin-bottom:6px;}
          .mioficio-auth .ma-field input{min-width:0;height:46px;font-size:16px!important;}
          .mioficio-auth .ma-password input{padding-right:78px;}
          .mioficio-auth .ma-password button{top:3px;right:3px;min-width:66px;height:40px;font-size:11px;background:transparent;}
          .mioficio-auth .ma-switch{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:2px 4px;margin-top:18px;padding-top:14px;line-height:1.5;}
          .mioficio-auth .ma-switch button{min-height:36px;padding:6px;font-size:12px;}
          .mioficio-auth .ma-security{align-items:flex-start;font-size:11px;line-height:1.5;margin-top:12px;text-align:left;}
          .mioficio-auth .ma-security svg.mioficio-lucide-icon{--mioficio-icon-size:14px!important;margin-top:1px;}
          .mioficio-auth .ma-footer{font-size:10px;line-height:1.5;padding:0 8px;margin-top:auto;}
        }
        @media(max-width:360px){.mioficio-auth{padding-left:12px;padding-right:12px;}.mioficio-auth .ma-card{padding:20px 16px;}.mioficio-auth .ma-brand img{width:140px;}.mioficio-auth .ma-card h2{font-size:21px;}}
${ESTILOS_ICONOS_OFICIALES}
`}</style>
      <header className="ma-top"><button className="ma-brand" type="button" onClick={onBackToLanding} disabled={cargando} aria-label="Volver al inicio de MiOficio"><img src={MIOFICIO_LOGO_PERMANENTE} alt="MiOficio" /></button><button className="ma-back" type="button" aria-label="Volver al inicio de MiOficio" onClick={onBackToLanding} disabled={cargando}><IconoLanding nombre="flecha" /><span className="ma-back-full">Volver al inicio</span><span className="ma-back-short">Volver</span></button></header>
      <div className="ma-layout">
        <section className="ma-story" aria-label="Tu gestión con MiOficio"><p className="ma-eyebrow">Para profesionales, oficios y negocios</p><h1>Tu trabajo, organizado.<span>Desde el primer día.</span></h1><p>Retomá tus presupuestos, encontrá los datos de tus clientes y mantené el control de tu negocio desde un solo lugar.</p><div className="ma-benefits">
          <div className="ma-benefit"><span className="ma-benefit-icon"><IconoLanding nombre="clientes" /></span><div><strong>Tus clientes, a mano</strong><p>Datos e historial para continuar cada trabajo.</p></div></div>
          <div className="ma-benefit"><span className="ma-benefit-icon"><IconoLanding nombre="pdf" /></span><div><strong>Presupuestos listos para compartir</strong><p>Presentá tus productos, servicios y condiciones.</p></div></div>
          <div className="ma-benefit"><span className="ma-benefit-icon"><IconoLanding nombre="dispositivos" /></span><div><strong>En tu computadora y en tu celular</strong><p>Accedé con la misma cuenta desde el navegador.</p></div></div>
        </div></section>
        <section className="ma-card" aria-labelledby="ma-title" aria-busy={cargando}>
          <div className="ma-card-heading"><span className="ma-access-icon"><IconoLanding nombre={isRegisterMode ? 'crear' : 'acceso'} /></span><div><h2 id="ma-title">{isRegisterMode ? 'Creá tu cuenta' : 'Iniciar sesión'}</h2><p>{isRegisterMode ? 'Comenzá con Free, sin tarjeta.' : 'Ingresá para continuar con tu trabajo.'}</p></div></div>
          {errorLogin && <p className="ma-error" role="alert" id="ma-error">{errorLogin}</p>}
          <button type="button" onClick={handleGoogleLogin} disabled={cargando} className="ma-google">
            <svg className="ma-google-icon" aria-hidden="true" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"/><path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.13 0-5.78-2.11-6.73-4.96H1.18v3.15C3.16 21.32 7.18 24 12 24z"/><path fill="#FBBC05" d="M5.27 14.24c-.25-.72-.39-1.5-.39-2.24s.14-1.52.39-2.24V6.61H1.18C.43 8.13 0 9.83 0 12s.43 3.87 1.18 5.39l4.09-3.15z"/><path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.18 0 3.16 2.68 1.18 6.61l4.09 3.15c.95-2.85 3.6-4.96 6.73-4.96z"/>
            </svg>
            Continuar con Google
          </button>
          <div className="ma-divider">o usá tu correo electrónico</div>
          <form onSubmit={handleEmailAuth} className="ma-form">
            <div className="ma-field"><label htmlFor="ma-email">Correo electrónico</label><input id="ma-email" name="email" type="email" autoComplete="email" inputMode="email" autoCapitalize="none" spellCheck={false} required disabled={cargando} value={emailInput} onChange={e => setEmailInput(e.target.value)} placeholder="nombre@ejemplo.com" aria-describedby={errorLogin ? 'ma-error' : undefined} /></div>
            <div className="ma-field"><label htmlFor="ma-password">Contraseña</label><div className="ma-password"><input id="ma-password" name="password" type={mostrarPassword ? 'text' : 'password'} autoComplete={isRegisterMode ? 'new-password' : 'current-password'} required minLength={isRegisterMode ? 6 : undefined} disabled={cargando} value={passwordInput} onChange={e => setPasswordInput(e.target.value)} placeholder={isRegisterMode ? 'Creá una contraseña' : 'Ingresá tu contraseña'} aria-describedby={isRegisterMode ? 'ma-password-hint' : undefined} /><button type="button" disabled={cargando} onClick={() => setMostrarPassword(!mostrarPassword)} aria-label={mostrarPassword ? 'Ocultar contraseña' : 'Mostrar contraseña'} aria-pressed={mostrarPassword}>{mostrarPassword ? 'Ocultar' : 'Mostrar'}</button></div>{isRegisterMode && <p className="ma-hint" id="ma-password-hint">Usá al menos 6 caracteres.</p>}</div>
            <button type="submit" disabled={cargando} className="ma-submit">{cargando ? <><span className="ma-loading" aria-hidden="true" />Procesando…</> : <>{isRegisterMode ? 'Crear cuenta gratuita' : 'Iniciar sesión'}<IconoLanding nombre="flecha" /></>}</button>
          </form>
          <div className="ma-switch">{isRegisterMode ? '¿Ya tenés una cuenta?' : '¿Todavía no tenés cuenta?'}<button type="button" disabled={cargando} onClick={() => {setIsRegisterMode(!isRegisterMode);setErrorLogin(null);setMostrarPassword(false);}}>{isRegisterMode ? 'Iniciá sesión' : 'Creala gratis'}</button></div>
          <p className="ma-security"><IconoLanding nombre="seguridad" />{isRegisterMode ? 'Tus datos quedan vinculados a tu cuenta.' : 'Acceso a los datos guardados en tu cuenta.'}</p>
        </section>
      </div>
      <footer className="ma-footer">© {new Date().getFullYear()} MiOficio · Plataforma de gestión comercial</footer>
    </main>
  );
}


// ------------------------------------------------------------------------------
// DASHBOARD REAL COMPLETO (INTEGRIDAD TOTAL DE FUNCIONES Y DATOS)
// ------------------------------------------------------------------------------

type ActividadEconomica = { codigo: string; nombre: string; tipo: 'oficial' | 'oficio'; busqueda?: string[] };

const normalizarBusqueda = (valor: string) =>
  valor
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim()
    .replace(/\s+/g, ' ');



#mioficio-dashboard.reference-ui.banking-ui .reference-greeting div>span{display:block;font-size:12px;color:#ece8ff;margin-top:5px}
#mioficio-dashboard.reference-ui.banking-ui .compact-topbar-title{justify-content:flex-end;min-width:0}
#mioficio-dashboard.reference-ui.banking-ui .compact-topbar-search{width:230px!important;max-width:100%;height:34px!important;border:1px solid #ffffff40!important;border-radius:20px!important;background:#ffffff16!important;color:white!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-topbar-search input{color:white!important;background:transparent!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-topbar-search input::placeholder{color:#e2dcff!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-topbar-actions{gap:12px!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-topbar-actions>button:not(.compact-avatar){width:36px!important;height:36px!important;min-width:36px!important;border-radius:10px!important;color:white!important;background:#3926b444!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-topbar-actions>.compact-avatar{background:#ebe6ff!important;color:#5537df!important;width:38px!important;height:38px!important;min-width:38px!important}
#mioficio-dashboard.reference-ui.banking-ui>.compact-sidebar{width:180px!important;min-width:180px!important;max-width:180px!important;background:linear-gradient(170deg,#5037d8,#39279d)!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-sidebar-brand{padding:24px 18px 18px!important;border:0!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-wordmark{font-size:24px!important;font-weight:600!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-sidebar>nav{padding:10px!important;gap:6px!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-sidebar>nav>button{min-height:39px!important;height:auto!important;padding:10px!important;border-radius:9px!important;font-size:12px!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-sidebar>nav>button[aria-current=page]{background:#ffffff25!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-home{display:grid!important;grid-template-columns:minmax(0,1fr) minmax(0,1fr)!important;gap:16px!important;align-items:start!important;align-content:start!important;height:auto!important;min-height:0!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-home-panels{display:flex!important;flex-direction:column!important;align-items:stretch!important;width:100%!important;gap:16px!important;grid-column:2;grid-row:1 / span 2;align-self:start!important;min-height:0!important;height:auto!important}
#mioficio-dashboard.reference-ui.banking-ui .reference-account{grid-column:1;grid-row:1;display:flex!important;flex-direction:column!important;gap:0!important;height:auto!important;min-height:0!important;background:white!important;border:1px solid #e3def4!important;border-radius:18px!important;padding:20px!important;box-shadow:0 3px 0 #cfd6f5!important;position:relative}
#mioficio-dashboard.reference-ui.banking-ui .reference-account-heading{position:static!important;margin:0 0 16px!important;display:flex!important;align-items:center!important}
#mioficio-dashboard.reference-ui.banking-ui .reference-account-heading>button{display:flex;align-items:center;gap:8px!important;flex-direction:row!important;padding:0!important;background:none!important;border:0!important;font-size:13px!important;font-weight:600!important;color:#302c3e!important}
#mioficio-dashboard.reference-ui.banking-ui .reference-account-heading svg{width:17px!important;height:17px!important;min-width:17px!important;max-width:17px!important}
#mioficio-dashboard.reference-ui.banking-ui .reference-balances{display:block!important;margin:0 0 18px!important;grid-row:auto!important;grid-column:auto!important}
#mioficio-dashboard.reference-ui.banking-ui .reference-balances>div>span{display:block;font-size:12px!important;color:#85808e!important}
#mioficio-dashboard.reference-ui.banking-ui .reference-balances strong{display:block;font-size:34px!important;line-height:1.2!important;font-weight:500!important;color:#25222e!important;letter-spacing:-.7px!important;margin-top:4px!important}
#mioficio-dashboard.reference-ui.banking-ui .reference-account>.compact-muted{font-size:11px!important;margin:-8px 0 12px!important}
#mioficio-dashboard.reference-ui.banking-ui .reference-account-actions{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:12px!important;justify-content:normal!important;grid-row:auto!important;grid-column:auto!important;margin:0!important}
#mioficio-dashboard.reference-ui.banking-ui .reference-account-actions>button{display:flex!important;flex-direction:column!important;align-items:center!important;gap:7px!important;width:100%!important;height:auto!important;min-height:0!important;padding:0!important;background:none!important;border:0!important;box-shadow:none!important;border-radius:0!important;color:#37303f!important}
#mioficio-dashboard.reference-ui.banking-ui .reference-account-actions>button>span{display:flex;align-items:center;justify-content:center;width:100%!important;height:42px!important;min-height:42px!important;background:#6049f8!important;color:white!important;border:0!important;border-radius:26px!important;box-shadow:none!important}
#mioficio-dashboard.reference-ui.banking-ui .reference-account-actions>button:nth-child(2)>span{background:#eeeefe!important;color:#5844b7!important}
#mioficio-dashboard.reference-ui.banking-ui .reference-account-actions svg{width:22px!important;height:22px!important;min-width:22px!important;max-width:22px!important}
#mioficio-dashboard.reference-ui.banking-ui .reference-account-actions strong{font-size:12px!important;font-weight:400!important;max-width:none!important;color:#393440!important;line-height:1.3!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-home :is(.inicio-recent,.home-catalog){min-height:0!important;height:auto!important;padding:16px!important;margin:0!important;background:white!important;border:1px solid #e2def0!important;border-radius:16px!important;box-shadow:0 2px 0 #d4d9f5!important;align-self:start!important;overflow:hidden!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-home-panels>.inicio-recent{width:100%!important;max-width:none!important;box-sizing:border-box!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-home-panels>.inicio-recent:first-child{grid-column:2;grid-row:1}
#mioficio-dashboard.reference-ui.banking-ui .compact-home-panels>.inicio-recent:last-child{grid-column:2;grid-row:2}
#mioficio-dashboard.reference-ui.banking-ui .home-catalog{grid-column:1;grid-row:2}
#mioficio-dashboard.reference-ui.banking-ui .compact-home :is(.inicio-recent-header,.home-catalog-heading){padding:0!important;margin:0 0 10px!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-home :is(.inicio-recent-header,.home-catalog-heading) h2{font-size:14px!important;font-weight:600!important;line-height:1.3!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-home .inicio-recent-list{display:block!important;gap:0!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-home .inicio-recent-row{display:flex!important;align-items:center!important;padding:10px 0!important;margin:0!important;min-height:0!important;height:auto!important;border:0!important;border-bottom:1px solid #efecf6!important;border-radius:0!important;background:none!important;box-shadow:none!important;gap:9px!important}

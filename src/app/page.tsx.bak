#mioficio-dashboard.reference-ui.banking-ui .compact-bottom-nav .nav-document-icon{position:relative!important;grid-row:1!important;left:auto!important;top:auto!important;transform:none!important;width:36px!important;height:36px!important;min-width:36px!important;border:0!important;box-shadow:0 2px 6px #6049f822!important;align-self:center!important;border-radius:50%!important}

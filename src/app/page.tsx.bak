  const claveConfiguracionGuardada=JSON.stringify(configuracionGuardada);
  const configuracionModificada=JSON.stringify(configuracionBorrador)!==claveConfiguracionGuardada;
  useEffect(()=>{setConfiguracionBorrador(JSON.parse(claveConfiguracionGuardada) as ConfiguracionMiOficio);},[claveConfiguracionGuardada]);
  useEffect(()=>{
    if(cargandoNube||configuracionInicialAplicada.current)return;
    configuracionInicialAplicada.current=true;
    const c=leerConfiguracionMiOficio(perfilForm);
    setOcultarMontosInicio(c.ocultar_importes);setPeriodoInicioModelo(c.periodo_inicio);
    const retorno=new URLSearchParams(window.location.search);
    if(!planInicial&&!retorno.has('mercadopago')&&!retorno.has('dlocal')&&activeTab==='dashboard')abrirMenuPrincipal(c.iniciar_en);
  },[cargandoNube,perfilForm,planInicial,activeTab]);
  // Cada cambio se confirma en la nube antes de aplicarlo al resto de la aplicación.
  const guardadoConfiguracionEnCurso=useRef(false);
  const persistirConfiguracion=async(cambios:ConfiguracionMiOficio)=>{
    if(guardadoConfiguracionEnCurso.current||cargandoNube)return;
    guardadoConfiguracionEnCurso.current=true;
    setGuardandoConfiguracion(true);setResultadoConfiguracion(null);
    const anterior=leerConfiguracionMiOficio(perfilForm);
    const {notificar_aceptados,notificar_vencimientos,...preferencias}=cambios;
    const perfil:Perfil={...perfilForm,notificar_aceptados,notificar_vencimientos,configuracion:preferencias};
    try{
      const ok=await sincronizarConCloudDirecto(perfil,clientes,presupuestos);
      if(!ok){setResultadoConfiguracion({tipo:'error',mensaje:'No se pudo guardar. El cambio todavía no está aplicado.'});return;}
      setPerfilForm(perfil);
      if(anterior.ocultar_importes!==preferencias.ocultar_importes)setOcultarMontosInicio(preferencias.ocultar_importes);
      if(anterior.periodo_inicio!==preferencias.periodo_inicio)setPeriodoInicioModelo(preferencias.periodo_inicio);
      if(anterior.clientes_por_pagina!==preferencias.clientes_por_pagina||anterior.ajustar_listas_pantalla!==preferencias.ajustar_listas_pantalla)setPaginaClientes(1);
      if(anterior.presupuestos_por_pagina!==preferencias.presupuestos_por_pagina||anterior.ajustar_listas_pantalla!==preferencias.ajustar_listas_pantalla)setPaginaPresupuestos(1);
      const mensaje=anterior.iniciar_en!==preferencias.iniciar_en
        ?'Cambio guardado. La pantalla elegida se abrirá en tu próximo ingreso.'
        :'Cambio guardado y aplicado.';
      setResultadoConfiguracion({tipo:'ok',mensaje});
    }catch{
      setResultadoConfiguracion({tipo:'error',mensaje:'No se pudo guardar. El cambio todavía no está aplicado.'});
    }finally{guardadoConfiguracionEnCurso.current=false;setGuardandoConfiguracion(false);}
  };
  const cambiarConfiguracion=<K extends keyof ConfiguracionMiOficio>(campo:K,valor:ConfiguracionMiOficio[K])=>{
    if(guardadoConfiguracionEnCurso.current||cargandoNube)return;
    const siguiente={...configuracionBorrador,[campo]:valor};
    setConfiguracionBorrador(siguiente);void persistirConfiguracion(siguiente);
  };
  const guardarConfiguracion=(e:FormEvent<HTMLFormElement>)=>{
    e.preventDefault();void persistirConfiguracion(configuracionBorrador);
  };
  const descargarDatosConfiguracion=(tipo:'json'|'clientes'|'presupuestos')=>{
    const fecha=fechaArgentina();let contenido='';let mime='application/json';let nombre=`MiOficio-datos-${fecha}.json`;
    if(tipo==='json')contenido=JSON.stringify({formato:'MiOficio',version:1,exportado_en:new Date().toISOString(),perfil:perfilForm,clientes,presupuestos},null,2);
    if(tipo==='clientes'){contenido=crearCsvMiOficio([['Nombre / empresa','CUIT / DNI','Email','Teléfono','Domicilio'],...clientes.map(c=>[c.nombre_razon_social,c.cuit_cuil||'',c.email||'',c.telefono||'',c.direccion||''])]);mime='text/csv;charset=utf-8';nombre=`MiOficio-clientes-${fecha}.csv`;}
    if(tipo==='presupuestos'){contenido=crearCsvMiOficio([['Número','Fecha','Cliente','Estado','Moneda','Total','Cobrado','Saldo'],...presupuestos.map(p=>[p.numero_presupuesto,p.fecha,p.cliente,p.estado,p.moneda||'ARS',totalVigentePresupuesto(p).toFixed(2).replace('.',','),cobradoPresupuesto(p).toFixed(2).replace('.',','),saldoPresupuesto(p).toFixed(2).replace('.',',')])]);mime='text/csv;charset=utf-8';nombre=`MiOficio-presupuestos-${fecha}.csv`;}
    const url=URL.createObjectURL(new Blob([contenido],{type:mime}));const enlace=document.createElement('a');enlace.href=url;enlace.download=nombre;document.body.appendChild(enlace);enlace.click();enlace.remove();window.setTimeout(()=>URL.revokeObjectURL(url),1000);
    setResultadoConfiguracion({tipo:'ok',mensaje:'Descarga preparada. Revisá las descargas de tu navegador.'});
  };
  const esInformal = perfilForm.condicion_iva === 'Informal / Particular ("En negro")';

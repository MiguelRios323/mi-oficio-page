#mioficio-dashboard.reference-ui.banking-ui .visual-plan-grid li svg{color:#5041f8}
#mioficio-dashboard.reference-ui.banking-ui .visual-plan-grid .visual-unavailable{margin-top:12px;color:#8f89a9}
#mioficio-dashboard.reference-ui.banking-ui .visual-plan-grid .visual-unavailable svg{color:#aaa3bf}
#mioficio-dashboard.reference-ui.banking-ui .visual-premium-card{background:linear-gradient(145deg,#fff,#f0edff)}
#mioficio-dashboard.reference-ui.banking-ui .visual-premium-card>.visual-primary{width:100%;margin-top:20px}
#mioficio-dashboard.reference-ui.banking-ui .visual-premium-tools,#mioficio-dashboard.reference-ui.banking-ui .visual-business-extra{margin-top:14px;font-size:12px;color:#7972a0}
#mioficio-dashboard.reference-ui.banking-ui .visual-premium-tools>summary,#mioficio-dashboard.reference-ui.banking-ui .visual-business-extra>summary{display:flex;align-items:center;gap:7px;cursor:pointer;padding:8px 0}
#mioficio-dashboard.reference-ui.banking-ui .visual-premium-tools .premium-hub-heading{display:none!important}
#mioficio-dashboard.reference-ui.banking-ui .agenda-desktop,#mioficio-dashboard.reference-ui.banking-ui .visual-desktop{display:block}
#mioficio-dashboard.reference-ui.banking-ui .agenda-mobile,#mioficio-dashboard.reference-ui.banking-ui .visual-mobile{display:none!important}
#mioficio-dashboard.reference-ui.banking-ui .agenda-home{grid-column:1/-1;background:white;border:1px solid #e4e0f5;border-radius:14px;padding:16px}
#mioficio-dashboard.reference-ui.banking-ui .agenda-home-heading{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}
#mioficio-dashboard.reference-ui.banking-ui .agenda-home-heading h2{display:flex;align-items:center;gap:8px;font-size:14px!important;margin:0!important}
#mioficio-dashboard.reference-ui.banking-ui .agenda-home-heading h2 svg{color:#5041f8}
#mioficio-dashboard.reference-ui.banking-ui .agenda-week-controls{display:flex;align-items:center;gap:10px;font-size:12px}
#mioficio-dashboard.reference-ui.banking-ui .agenda-page button,#mioficio-dashboard.reference-ui.banking-ui .agenda-home button{cursor:pointer}
#mioficio-dashboard.reference-ui.banking-ui .agenda-week-controls button,#mioficio-dashboard.reference-ui.banking-ui .agenda-toolbar button{background:none;border:0;color:#5041f8;padding:5px}
#mioficio-dashboard.reference-ui.banking-ui .agenda-home-week{display:grid;grid-template-columns:repeat(5,minmax(0,1fr))}
#mioficio-dashboard.reference-ui.banking-ui .agenda-home-week>div{min-height:104px;border-right:1px solid #eeeafa;padding:8px;min-width:0}
#mioficio-dashboard.reference-ui.banking-ui .agenda-home-week>div:last-child{border:0}
#mioficio-dashboard.reference-ui.banking-ui .agenda-home-week>div>strong{display:block;text-align:center;text-transform:uppercase;font-size:11px;font-weight:500;margin-bottom:12px}
#mioficio-dashboard.reference-ui.banking-ui .agenda-home-week>div.is-today{background:#f7f5ff;border-radius:8px;color:#5041f8}
#mioficio-dashboard.reference-ui.banking-ui .agenda-home-week button{position:relative;display:grid;gap:3px;width:100%;padding:9px 20px 9px 9px;text-align:left;border:0;border-radius:8px;background:#efebff;color:#17143d;font-size:11px;margin:5px 0}
#mioficio-dashboard.reference-ui.banking-ui .agenda-home-week button small{color:#7064af;font-size:10px}
#mioficio-dashboard.reference-ui.banking-ui .agenda-home-week button svg{position:absolute;right:4px;top:12px;color:#5041f8}
#mioficio-dashboard.reference-ui.banking-ui .agenda-empty-link,#mioficio-dashboard.reference-ui.banking-ui .agenda-weekend{background:none;border:0;padding:8px 0;color:#5041f8;font-size:12px;align-items:center;gap:8px}
#mioficio-dashboard.reference-ui.banking-ui .agenda-toolbar{display:flex;align-items:center;gap:10px;padding:0 0 14px;font-size:13px}
#mioficio-dashboard.reference-ui.banking-ui .agenda-layout{display:grid;grid-template-columns:minmax(0,1fr);gap:14px}
#mioficio-dashboard.reference-ui.banking-ui .agenda-layout:has(.agenda-detail){grid-template-columns:minmax(0,1fr) 270px}
#mioficio-dashboard.reference-ui.banking-ui .agenda-calendar{padding:12px;overflow-x:auto}
#mioficio-dashboard.reference-ui.banking-ui .agenda-days{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));margin-bottom:8px}
#mioficio-dashboard.reference-ui.banking-ui .agenda-days button{display:grid;gap:4px;text-align:center;border:0;border-radius:7px;background:white;color:#4b4475;padding:8px;font-size:11px;min-width:0}
#mioficio-dashboard.reference-ui.banking-ui .agenda-days button b{font-size:14px}
#mioficio-dashboard.reference-ui.banking-ui .agenda-days .is-selected{background:#ece8ff;color:#5041f8}
#mioficio-dashboard.reference-ui.banking-ui .agenda-week-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));height:540px}
#mioficio-dashboard.reference-ui.banking-ui .agenda-day-column{position:relative;border-right:1px solid #eeeafa;min-width:0;background:repeating-linear-gradient(to bottom,transparent 0,transparent 47px,#f0edf7 47px,#f0edf7 48px)}
#mioficio-dashboard.reference-ui.banking-ui .agenda-day-column:last-child{border:0}
#mioficio-dashboard.reference-ui.banking-ui .agenda-day-column:not(:first-child)>.agenda-hour{visibility:hidden}
#mioficio-dashboard.reference-ui.banking-ui .agenda-hour{display:block;height:48px;font-size:9px;color:#9f97b5;padding:3px}
#mioficio-dashboard.reference-ui.banking-ui .agenda-event{position:absolute;display:flex;flex-direction:column;gap:3px;overflow:hidden;text-align:left;border:1px solid white;border-radius:7px;background:#eeebff;color:#242044;padding:7px;font-size:10px}
#mioficio-dashboard.reference-ui.banking-ui .agenda-event.is-selected{background:#ddd8ff;outline:1px solid #8a7eff}
#mioficio-dashboard.reference-ui.banking-ui .agenda-event small{font-size:9px;color:#7972a0}
#mioficio-dashboard.reference-ui.banking-ui .agenda-detail-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
#mioficio-dashboard.reference-ui.banking-ui .agenda-detail-heading h3{font-size:13px!important;margin:0!important}
#mioficio-dashboard.reference-ui.banking-ui .agenda-detail-heading button{background:none;border:0;color:#5041f8}
#mioficio-dashboard.reference-ui.banking-ui .agenda-detail>strong{font-size:13px}
#mioficio-dashboard.reference-ui.banking-ui .agenda-detail h4{font-size:13px;margin:16px 0}
#mioficio-dashboard.reference-ui.banking-ui .agenda-detail p{display:flex;align-items:start;gap:8px;font-size:12px!important;color:#706b92;line-height:1.6!important;margin:12px 0!important;overflow-wrap:anywhere}
#mioficio-dashboard.reference-ui.banking-ui .agenda-notes{white-space:pre-wrap}
#mioficio-dashboard.reference-ui.banking-ui .agenda-detail-actions{display:flex;gap:7px;border-top:1px solid #eeeafa;padding-top:12px}
#mioficio-dashboard.reference-ui.banking-ui .agenda-detail-actions button,#mioficio-dashboard.reference-ui.banking-ui .agenda-form-actions>button{display:flex;align-items:center;justify-content:center;gap:5px;border:1px solid #ddd6f6;background:white;color:#5041f8;border-radius:7px;height:34px;padding:0 10px;font-size:11px}
#mioficio-dashboard.reference-ui.banking-ui .agenda-repeat{display:flex;align-items:center;gap:6px;font-size:11px;border:0;border-radius:7px;background:#f0edff;color:#5041f8;width:100%;padding:10px;margin-top:12px}
#mioficio-dashboard.reference-ui.banking-ui .agenda-repeat span{margin-left:auto;font-size:10px}

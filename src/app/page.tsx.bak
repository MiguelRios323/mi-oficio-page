#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard{--approved-purple:#6046f5!important;--approved-ink:#101133!important;--approved-muted:#6b6884!important;display:block!important;height:auto!important;min-height:100dvh!important;overflow:visible!important;background:#f1eeff!important;color:var(--approved-ink)!important;font-family:Arial,Helvetica,sans-serif!important}

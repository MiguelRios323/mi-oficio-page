.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2:not(.client-v2) .budget-v2-card[data-desktop-stage="1"]>.budget-v2-section:first-of-type .field{height:36px!important;min-height:36px!important;font-size:14px!important;padding:7px 9px!important;border-radius:8px!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2:not(.client-v2) .budget-v2-footer{padding:10px 16px!important;background:#fff!important;gap:8px!important;min-height:0!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2:not(.client-v2) .budget-step-arrow{width:34px!important;height:34px!important;min-width:34px!important;min-height:34px!important;padding:7px!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2:not(.client-v2) .budget-v2-scroll-notice{font-size:10px!important;line-height:1.5!important;padding:7px 14px!important}
}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2:not(.client-v2) .budget-v2-counter{display:block!important;font-size:9px!important;line-height:1.4!important;margin:3px 0 0!important;color:#98a3b6!important}

        .mi-oficio-ui.mioficio-model.compact-dashboard .client-card-actions {grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;}
        .delete-confirmation button:focus-visible {outline:2px solid #64748b;outline-offset:3px;}
        .mi-oficio-ui.mioficio-model.compact-dashboard .delete-confirmation {width:100%;max-width:390px;padding:20px !important;border:1px solid #e2e8f0;border-radius:16px !important;background:white;box-shadow:0 20px 60px #0f172a26;text-align:left;}
        .delete-confirmation-heading {display:flex;align-items:center;gap:10px;}
        .delete-confirmation-heading h3 {margin:0;font-size:16px !important;font-weight:650;line-height:1.4;color:#0f172a;}
        .delete-confirmation-icon {display:flex;align-items:center;justify-content:center;width:34px;height:34px;flex:0 0 34px;border:1px solid #ffe0e5;border-radius:9px;background:#fff1f2;color:#b03849;}
        .delete-confirmation .client-delete-svg {}
        .delete-confirmation-name {margin:14px 0 10px;padding:10px 12px;border:1px solid #e2e8f0;border-radius:8px;background:#f8fafc;font-size:13px;font-weight:600;color:#334155;overflow-wrap:anywhere;}
        .delete-confirmation-description {margin:0;font-size:13px;line-height:1.6;color:#475569;}
        .delete-confirmation-note {margin:6px 0 16px;font-size:12px;line-height:1.5;color:#64748b;}
        .delete-confirmation-actions {display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);gap:8px;}
        .mi-oficio-ui.mioficio-model.compact-dashboard .delete-confirmation-actions button {display:flex;align-items:center;justify-content:center;gap:6px;width:100%;min-height:38px !important;padding:8px 10px !important;border-radius:8px !important;font-size:12px !important;font-weight:600;line-height:1.3;}
        .delete-confirmation-submit {background:#b9384b;color:white;border:1px solid #b9384b;transition:background .18s;}
        .delete-confirmation-submit:hover {background:#a32a3d;}
        @media(max-width:479px) {.mi-oficio-ui.mioficio-model.compact-dashboard .client-card-actions button {font-size:11px !important;gap:5px;padding:0 5px !important;}.mi-oficio-ui.mioficio-model.compact-dashboard .delete-confirmation {padding:16px !important;}}
      

        .mi-oficio-ui.mioficio-model .premium-example-dialog.compact-premium-example{box-sizing:border-box;width:100%!important;max-width:360px!important;margin:0!important;padding:14px!important;flex:0 1 360px;}.mi-oficio-ui.mioficio-model .premium-example-overlay{position:fixed!important;inset:0!important;display:flex!important;align-items:center!important;justify-content:center!important;padding:16px!important;}
        .premium-export-dialog{position:fixed;inset:0;margin:auto!important;box-sizing:border-box;width:calc(100% - 32px);max-width:360px;max-height:calc(100dvh - 32px);padding:0;border:1px solid #dfe7f2;border-radius:14px;box-shadow:0 20px 70px #0f172a26;background:#fff;color:#334155;overflow:auto;font-family:inherit;}.premium-export-dialog::backdrop{background:#0f172a70;backdrop-filter:blur(3px);}.premium-export-dialog header{display:flex;align-items:start;justify-content:space-between;gap:12px;padding:14px 16px;border-bottom:1px solid #e8edf4;}.premium-export-dialog header small{font-size:10px;color:#7656bd;}.premium-export-dialog h2{font-size:16px!important;line-height:1.4;margin:4px 0 0;}.premium-export-dialog header button{display:flex;align-items:center;justify-content:center;width:30px;height:30px;padding:0;border:1px solid #e1e7f0;border-radius:8px;background:#f8faff;}.premium-export-body{display:grid;gap:12px;padding:14px 16px;}.premium-export-body p{font-size:12px;line-height:1.6;margin:0;color:#64748b;}.premium-export-body label{display:grid;gap:6px;font-size:12px;color:#526885;}.premium-export-body input,.premium-export-body select{width:100%;min-width:0;height:40px;border:1px solid #dce4ef;border-radius:8px;padding:8px 10px;background:#fafcff;font:inherit;color:#334155;}.premium-export-dates{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;}.premium-export-dates label{min-width:0;}.premium-export-body small{font-size:11px;line-height:1.6;color:#8090a5;}.premium-export-error{color:#a33143!important;}.premium-export-summary{display:flex;align-items:center;gap:10px;padding:12px;background:#f4f7fc;border:1px solid #e0e8f3;border-radius:9px;}.premium-export-summary span{min-width:0;}.premium-export-summary strong{display:block;font-size:12px;overflow-wrap:anywhere;}.premium-export-summary small{display:block;margin-top:3px;}.premium-export-primary{display:flex;align-items:center;justify-content:center;gap:7px;min-height:40px;border:1px solid #6441df;border-radius:8px;padding:10px;background:#6441df;color:#fff;font-size:12px;font-weight:600;}.premium-export-primary:disabled{opacity:.5;cursor:not-allowed;}@media(max-width:760px){.premium-export-body input,.premium-export-body select{font-size:16px;}}
${ESTILOS_ICONOS_OFICIALES}
#perfil-profesional .profile-v2-grid{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:12px 14px!important}
#perfil-profesional .profile-v2-grid>div{min-width:0!important;grid-column:auto!important}
#perfil-profesional .profile-v2-grid>.profile-v2-full{grid-column:1/-1!important}
#perfil-profesional .profile-v2-card .profile-v2-field{width:100%!important;max-width:100%!important;min-width:0!important;height:36px!important;min-height:36px!important;padding:8px 10px!important;font-size:13px!important;line-height:1.4!important;box-sizing:border-box!important}
#perfil-profesional .profile-v2-label{display:block;font-size:12px!important;line-height:1.4!important;margin-bottom:5px!important}
#perfil-profesional .profile-v2-help{font-size:11px!important;line-height:1.5!important}
#perfil-profesional .profile-v2-payments{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:8px!important}
#perfil-profesional .profile-v2-card .profile-v2-payment{display:flex!important;align-items:center!important;justify-content:flex-start!important;gap:6px!important;min-width:0!important;min-height:38px!important;height:auto!important;padding:8px!important;box-sizing:border-box!important}
#perfil-profesional .profile-v2-payment>span{min-width:0!important;font-size:12px!important;line-height:1.4!important;white-space:normal!important;overflow-wrap:break-word}
#perfil-profesional .profile-v2-payment input{position:static!important;inset:auto!important;transform:none!important;order:3!important;flex:0 0 14px!important;width:14px!important;height:14px!important;min-width:14px!important;max-width:14px!important;margin:0 0 0 auto!important}
#perfil-profesional .profile-v2-payment :is(svg,.profile-v2-payment-icon){flex:0 0 16px!important;width:16px!important;height:16px!important;min-width:16px!important;max-width:16px!important;--mioficio-icon-size:16px!important}
#perfil-profesional .profile-v2-card .profile-v2-save{min-height:36px!important;height:auto!important;padding:9px 16px!important;font-size:13px!important}
@media(min-width:641px) and (max-width:1200px){#perfil-profesional .profile-v2-payments{grid-template-columns:minmax(0,1fr)!important}}
@media(max-width:640px){
#perfil-profesional .profile-v2-grid{grid-template-columns:minmax(0,1fr)!important}
#perfil-profesional .profile-v2-grid>div{grid-column:1/-1!important}
#perfil-profesional .profile-v2-card .profile-v2-field{font-size:16px!important;height:42px!important;min-height:42px!important}
#perfil-profesional .profile-v2-payments{grid-template-columns:minmax(0,1fr)!important}
#perfil-profesional .profile-v2-card .profile-v2-payment{min-height:42px!important}
#perfil-profesional .profile-v2-card .profile-v2-save{min-height:42px!important}
}
#mioficio-dashboard{--model-control-height:38px;--model-field-size:14px;--model-card-radius:12px;font-size:13px;line-height:1.5}
#mioficio-dashboard *,#mioficio-dashboard *::before,#mioficio-dashboard *::after{box-sizing:border-box}
#mioficio-dashboard :is(button,input,select,textarea){font-family:inherit}
#mioficio-dashboard :is(button,a,input,select,textarea,summary):focus-visible{outline:2px solid #6441df!important;outline-offset:3px!important}
#mioficio-dashboard :is(.model-card,.premium-hub-card){padding:18px!important;border-radius:12px!important;min-width:0!important}
#mioficio-dashboard :is(p,.budget-v2-subtitle,.catalogo-hint,.delivery-help,.series-field-help,.account-access-help,.delete-confirmation-description):not(:where(.premium-example-paper *,#perfil-profesional *)){font-size:13px!important;line-height:1.6!important;overflow-wrap:break-word}
#mioficio-dashboard :is(label,.label,.premium-payment-label):not(:where(#perfil-profesional *)){font-size:12px!important;line-height:1.5!important;white-space:normal!important}
#mioficio-dashboard :is(input,select,textarea):not(:where(#perfil-profesional *,[type="checkbox"],[type="radio"],[type="file"],[type="range"],[type="hidden"])){width:100%!important;max-width:100%!important;min-width:0!important;height:38px!important;min-height:38px!important;padding:8px 10px!important;font-size:14px!important;line-height:1.4!important;border-radius:8px!important}
#mioficio-dashboard textarea:not(:where(#perfil-profesional *)){height:auto!important;min-height:80px!important;resize:vertical}
#mioficio-dashboard :is(input[type="checkbox"],input[type="radio"]):not(:where(#perfil-profesional *)){width:16px!important;height:16px!important;min-width:16px!important;flex-shrink:0;accent-color:#6441df}
#mioficio-dashboard .mioficio-search-field{min-width:0!important;height:38px!important;min-height:38px!important;padding:0 10px!important;gap:8px!important}
#mioficio-dashboard .mioficio-search-field>input{height:100%!important;min-height:0!important;padding:0!important;border:0!important;background:transparent!important;box-shadow:none!important}
#mioficio-dashboard :is(.model-primary-button,.model-secondary-button,.model-text-button,.catalogo-primary,.catalogo-secondary,.delivery-primary,.premium-export-primary,.budget-clean-next,.budget-clean-back,.budget-clean-secondary,.budget-v2-add,.rubro-v2-apply,.premium-plan-pay,.premium-hub-actions button,.inicio-quick-budget,.inicio-quick-client){display:inline-flex!important;align-items:center!important;justify-content:center!important;gap:8px!important;min-height:36px!important;height:auto!important;padding:8px 12px!important;border-radius:8px!important;font-size:13px!important;line-height:1.4!important}
#mioficio-dashboard :is(.model-icon-button,.budget-v2-close,.budget-v2-delete,.rubro-v2-close,.avisos-close,.account-access-close,.premium-plan-close,.logo-config-close,button[aria-label^="Cerrar"]){display:inline-flex!important;align-items:center!important;justify-content:center!important;width:34px!important;min-width:34px!important;height:34px!important;min-height:34px!important;flex:0 0 34px!important;padding:7px!important}
#mioficio-dashboard :is(svg.ui-icon,svg.lo-icon,svg.premium-tool-svg,svg.mioficio-search-svg):not(:where(#perfil-profesional *, .premium-example-paper *)){--mioficio-icon-size:18px!important;display:inline-block!important;width:18px!important;height:18px!important;min-width:18px!important;max-width:18px!important;flex:0 0 18px!important;vertical-align:middle;overflow:visible!important}
#mioficio-dashboard :is(.premium-hub-icon,.access-ended-icon,.delete-confirmation-icon,.series-dialog-icon,.premium-confirm-symbol) svg{width:22px!important;height:22px!important;min-width:22px!important;max-width:22px!important;flex-basis:22px!important}
#mioficio-dashboard>aside{width:220px!important;min-width:220px!important}
#mioficio-dashboard>aside nav button{display:flex!important;align-items:center!important;gap:10px!important;height:auto!important;min-height:40px!important;padding:9px 10px!important;font-size:13px!important;line-height:1.4!important}
#mioficio-dashboard>aside nav button>span:nth-child(3):last-child{margin-left:auto;flex-shrink:0}
#mioficio-dashboard :is(.client-card-actions,.quotes-mobile-actions,.collection-actions,.catalogo-form-actions,.delete-confirmation-actions,.premium-hub-actions,.avisos-direct-actions,.avisos-more-actions){display:flex!important;align-items:center!important;flex-wrap:wrap!important;gap:8px!important}
#mioficio-dashboard table:not(:where(.premium-example-paper *)){font-size:13px!important;line-height:1.5!important}
#mioficio-dashboard :is(th,td):not(:where(.premium-example-paper *)){padding:10px 12px!important;vertical-align:middle}
#mioficio-dashboard .budget-table-actions{display:flex!important;align-items:center!important;justify-content:flex-end!important;flex-wrap:nowrap!important;gap:6px!important;min-width:114px!important}
#mioficio-dashboard .budget-table-actions .model-icon-button{width:32px!important;min-width:32px!important;height:32px!important;min-height:32px!important;flex-basis:32px!important;padding:6px!important}
#mioficio-dashboard .premium-hub-heading{padding:18px!important;gap:14px!important;flex-wrap:wrap}
#mioficio-dashboard .premium-hub-card{grid-template-columns:38px minmax(0,1fr)!important;gap:12px!important}
#mioficio-dashboard .premium-hub-icon{width:38px!important;height:38px!important}
#mioficio-dashboard .premium-hub-card h3{font-size:15px!important}
#mioficio-dashboard .premium-hub-card p{font-size:13px!important;line-height:1.55!important}
#mioficio-dashboard :is(.budget-v2-shell,.catalogo-dialog,.delivery-dialog,.collection-dialog,.premium-export-dialog,.series-dialog,.logo-config-dialog,.rubro-v2-card,.avisos-modal,.account-access-card,.premium-plan-dialog,.premium-example-dialog,.whatsapp-share-card){min-width:0!important;max-height:calc(100dvh - 32px)!important;border-radius:14px!important}
#mioficio-dashboard :is(.budget-v2-scroll,.delivery-scroll,.avisos-content,.rubro-v2-results,.premium-plan-body,.premium-export-body){min-height:0!important;overflow-y:auto;overscroll-behavior:contain}
#mioficio-dashboard :is(.budget-v2-header,.budget-v2-footer,.rubro-v2-header,.rubro-v2-footer,.avisos-header,.catalogo-heading,.logo-config-heading,.logo-config-footer){padding:16px 18px!important;gap:10px!important;flex-wrap:wrap!important}
#mioficio-dashboard :is(.budget-v2-card,.client-form-card,.catalogo-form,.premium-export-body,.delivery-fields){min-width:0!important;padding:18px!important}
#mioficio-dashboard :is(.budget-v2-grid,.client-essential-grid,.budget-v2-item-grid,.catalogo-form-grid,.collection-grid,.delivery-fields,.premium-payment-fields){gap:12px 14px!important}
#mioficio-dashboard :is(.budget-v2-grid,.client-essential-grid,.budget-v2-item-grid,.catalogo-form-grid,.collection-grid,.delivery-fields,.premium-payment-fields)>*{min-width:0!important}
#mioficio-dashboard :is(.budget-v2-check,.budget-v2-payment,.premium-renewal-consent){font-size:12px!important;line-height:1.5!important;gap:8px!important}
#mioficio-dashboard .budget-v2-payment{min-height:36px!important;padding:8px 10px!important}
#mioficio-dashboard :is(.budget-v2-totals,.budget-v2-final){padding:16px!important;gap:14px!important;min-width:0!important}
#mioficio-dashboard .budget-v2-grand-total strong{font-size:22px!important}
#mioficio-dashboard .premium-plan-benefit{font-size:13px!important;line-height:1.5!important;gap:8px!important}
@media(max-width:1023px){
#mioficio-dashboard>aside{max-width:85vw!important}
#mioficio-dashboard>nav[aria-label="Menú principal"] button{min-height:62px!important;font-size:12px!important;padding:6px 2px!important}
#mioficio-dashboard>nav[aria-label="Menú principal"] button>span:last-child{font-size:11px!important;line-height:1.3!important;overflow-wrap:normal!important}
}
@media(max-width:640px){
#mioficio-dashboard :is(.model-card,.premium-hub-card,.premium-hub-heading){padding:14px!important}
#mioficio-dashboard :is(input,select,textarea):not(:where(#perfil-profesional *,[type="checkbox"],[type="radio"],[type="file"],[type="range"],[type="hidden"])){font-size:16px!important;min-height:42px!important;height:42px!important}
#mioficio-dashboard textarea{height:auto!important;min-height:80px!important}
#mioficio-dashboard .mioficio-search-field{height:42px!important;min-height:42px!important}
#mioficio-dashboard .mioficio-search-field>input{height:100%!important;min-height:0!important;padding:0!important}
#mioficio-dashboard :is(.model-primary-button,.model-secondary-button,.catalogo-primary,.catalogo-secondary,.delivery-primary,.premium-export-primary,.budget-clean-next,.budget-clean-back,.budget-clean-secondary,.budget-v2-add,.rubro-v2-apply,.premium-plan-pay){min-height:42px!important;padding:10px 12px!important}
#mioficio-dashboard :is(.budget-v2-grid,.client-essential-grid,.budget-v2-item-grid,.catalogo-form-grid,.collection-grid,.delivery-fields,.premium-payment-fields){grid-template-columns:minmax(0,1fr)!important}
#mioficio-dashboard :is(.budget-v2-grid,.client-essential-grid,.budget-v2-item-grid,.catalogo-form-grid,.collection-grid,.delivery-fields,.premium-payment-fields)>*{grid-column:1/-1!important}
#mioficio-dashboard :is(.budget-v2-footer,.catalogo-form-actions,.delete-confirmation-actions,.collection-actions)>button{flex:1 1 130px!important}
#mioficio-dashboard :is(.budget-v2-header,.budget-v2-footer,.budget-v2-card,.client-form-card,.catalogo-form,.premium-export-body,.delivery-fields){padding:14px!important}
}
#mioficio-dashboard>aside{width:232px!important;min-width:232px!important}
#mioficio-dashboard .app-brand{padding:10px!important;min-height:0!important;border-radius:10px!important}
#mioficio-dashboard .app-brand img{width:176px!important;max-width:100%!important;height:auto!important}
#mioficio-dashboard>aside nav{gap:5px!important}
#mioficio-dashboard>aside nav button{height:42px!important;min-height:42px!important;font-size:14px!important;line-height:1.3!important;padding:9px 12px!important;gap:10px!important;border-radius:9px!important}
#mioficio-dashboard>aside nav button svg{width:19px!important;height:19px!important;--mioficio-icon-size:19px!important}
#mioficio-dashboard .account-identity-label{font-size:10px!important}
#mioficio-dashboard main>.w-full{padding:20px!important}
#mioficio-dashboard .inicio-quick-actions{gap:10px!important;margin:0!important}
#mioficio-dashboard .inicio-quick-actions>button{height:42px!important;min-height:42px!important;padding:8px 12px!important;gap:8px!important;font-size:13px!important;border-radius:9px!important}
#mioficio-dashboard .inicio-quick-copy strong{font-size:13px!important}
#mioficio-dashboard .inicio-quick-icon{width:26px!important;height:26px!important;border-radius:7px!important}
#mioficio-dashboard .inicio-quick-icon svg{width:17px!important;height:17px!important;--mioficio-icon-size:17px!important}
#mioficio-dashboard .inicio-recent-header{padding:14px 16px!important}
#mioficio-dashboard .inicio-recent-header h2{font-size:16px!important}
#mioficio-dashboard .inicio-recent-header button{font-size:12px!important}
#mioficio-dashboard .inicio-recent-empty{padding:28px 16px!important;min-height:150px!important}
#mioficio-dashboard .inicio-recent-empty strong{font-size:15px!important}
#mioficio-dashboard .inicio-recent-empty p{font-size:13px!important}
#mioficio-dashboard .client-card-actions{display:grid!important;grid-template-columns:1fr 1fr 1fr!important;padding:10px 0 0!important;gap:8px!important;background:transparent!important}
#mioficio-dashboard .client-card-actions button{width:100%!important;min-width:0!important;height:36px!important;min-height:36px!important;padding:6px 8px!important;font-size:12px!important;border-radius:8px!important;gap:6px!important;grid-column:auto!important}
#mioficio-dashboard .client-card-actions button svg{width:16px!important;height:16px!important;--mioficio-icon-size:16px!important}
#mioficio-dashboard .budget-status-filter{height:34px!important;min-height:34px!important;padding:6px 10px!important;font-size:12px!important;gap:6px!important}
#mioficio-dashboard .mioficio-search-field{height:38px!important;min-height:38px!important;border-radius:8px!important;max-width:100%!important}
#mioficio-dashboard .premium-hub{max-width:1320px!important;padding:0!important}
#mioficio-dashboard .subscription-management{padding:16px!important;margin-bottom:16px!important}
#mioficio-dashboard .subscription-management h3{font-size:17px!important}
#mioficio-dashboard .subscription-dates{padding:10px 0!important;gap:14px!important}
#mioficio-dashboard .subscription-management p{margin:8px 0!important;font-size:13px!important}
#mioficio-dashboard .premium-hub-heading{padding:14px 16px!important;min-height:0!important;margin-bottom:16px!important}
#mioficio-dashboard .premium-hub-card{padding:16px!important;min-height:0!important;gap:10px!important}
#mioficio-dashboard .premium-hub-card h3{font-size:16px!important}
#mioficio-dashboard .premium-hub-card button{height:36px!important;min-height:36px!important;padding:7px 11px!important;font-size:12px!important}
#mioficio-dashboard #perfil-profesional{max-width:1320px!important;margin:auto!important;padding:0!important}
#mioficio-dashboard #perfil-profesional .profile-v2-card{padding:16px!important;border-radius:12px!important}
#mioficio-dashboard #perfil-profesional .profile-v2-blocks{gap:16px!important;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr)!important}
#mioficio-dashboard #perfil-profesional .profile-v2-side{gap:14px!important}
#mioficio-dashboard #perfil-profesional .profile-v2-section{padding:14px!important;margin:0!important;border-radius:10px!important}
#mioficio-dashboard #perfil-profesional .profile-v2-section h3{font-size:16px!important;line-height:1.4!important;margin:0 0 12px!important}
#mioficio-dashboard #perfil-profesional .profile-v2-grid{gap:12px!important}
#mioficio-dashboard #perfil-profesional .profile-v2-field{height:38px!important;min-height:38px!important;font-size:14px!important;padding:8px 10px!important;border-radius:8px!important}
#mioficio-dashboard #perfil-profesional .profile-v2-label{font-size:12px!important;margin-bottom:5px!important}
#mioficio-dashboard #perfil-profesional .profile-v2-payments{display:flex!important;flex-wrap:wrap!important;gap:8px!important}
#mioficio-dashboard #perfil-profesional .profile-v2-payment{flex:1 1 140px!important;min-height:38px!important;padding:8px 10px!important}
#mioficio-dashboard #perfil-profesional .profile-v2-payment>span{white-space:nowrap!important;word-break:normal!important;overflow-wrap:normal!important;font-size:12px!important}
#mioficio-dashboard #perfil-profesional .profile-v2-transfer{margin-top:14px!important;padding-top:14px!important}
#mioficio-dashboard #perfil-profesional .profile-v2-transfer h4{font-size:13px!important;margin-bottom:12px!important}
#mioficio-dashboard #perfil-profesional .profile-v2-help{font-size:11px!important;line-height:1.5!important;margin:5px 0!important}
#mioficio-dashboard #perfil-profesional .profile-v2-footer{padding:14px 0 0!important;margin:0!important}
@media(max-width:1023px){
#mioficio-dashboard main>.w-full{padding:14px!important}
#mioficio-dashboard #perfil-profesional .profile-v2-blocks{grid-template-columns:1fr!important}
}
@media(max-width:640px){
#mioficio-dashboard #perfil-profesional .profile-v2-field{height:42px!important;min-height:42px!important;font-size:16px!important}
#mioficio-dashboard #perfil-profesional .profile-v2-card{padding:12px!important}
#mioficio-dashboard #perfil-profesional .profile-v2-section{padding:12px!important}
#mioficio-dashboard .client-card-actions{grid-template-columns:repeat(2,minmax(0,1fr))!important}
#mioficio-dashboard .client-card-actions button{min-height:42px!important;height:42px!important}
}
`}</style>

      {notificacion&&<AvisoMiOficio aviso={notificacion} onCerrar={cerrarNotificacion}/>}

      {/* APP SHELL — DASHBOARD PREMIUM */}
      <aside className="compact-sidebar ref-sidebar" aria-label="Navegación de escritorio"><button type="button" className="ref-brand" aria-label="MiOficio, ir a Inicio" onClick={()=>abrirMenuPrincipal('dashboard')}><img className="ref-official-logo" src={MIOFICIO_LOGO_ENCABEZADO} alt="MiOficio · Plataforma de gestión comercial"/></button><nav aria-label="Menú principal">{navegacionReferencia.filter(n=>!['agenda','catalogo','informes','menu'].includes(n.tab)).map(n=><button type="button" key={n.tab} aria-current={activeTab===n.tab?'page':undefined} onClick={()=>abrirMenuPrincipal(n.tab)}><IconoOficial nombre={n.icono}/><span>{n.label}</span></button>)}<button type="button" aria-current={activeTab==='menu'?'page':undefined} onClick={()=>abrirMenuPrincipal('menu')}><IconoOficial nombre="settings"/><span>Configuración</span></button></nav>{accesoHerramientasMembresia()}</aside>


     

      <style>{`
#mioficio-dashboard.mio-compact-v2{--compact-violet:#6441df;--compact-ink:#24203c;--compact-muted:#807b98;background:#f4f2ff!important;color:var(--compact-ink)!important}
#mioficio-dashboard.mio-compact-v2>.compact-main{background:linear-gradient(120deg,#f6f4ff,#f0effb)!important;padding-bottom:0!important;min-width:0;flex:1;overflow-y:auto;overflow-x:hidden}
#mioficio-dashboard.mio-compact-v2>.compact-main>.compact-content{padding:22px 24px 30px!important;width:100%;max-width:1600px!important;margin:auto;box-sizing:border-box;min-width:0}
#mioficio-dashboard.mio-compact-v2 .compact-content :is(h1,h2,h3,p){line-height:1.4}
#mioficio-dashboard.mio-compact-v2 :is(.compact-home,.compact-quotes-page,.compact-clients-page){display:grid;gap:16px;min-width:0;width:100%;margin:0;padding:0}
#mioficio-dashboard.mio-compact-v2 .compact-desktop{display:block!important}#mioficio-dashboard.mio-compact-v2 .compact-mobile{display:none!important}
#mioficio-dashboard.mio-compact-v2 .compact-sidebar{width:200px!important;min-width:200px!important;max-width:200px!important;display:flex;flex-direction:column;flex-shrink:0;height:100dvh;background:linear-gradient(165deg,#6745e9,#5135c5)!important;color:white!important;border:0!important;padding:0!important;overflow:hidden}
#mioficio-dashboard.mio-compact-v2 .compact-sidebar-brand{border-bottom:1px solid #ffffff1c}
#mioficio-dashboard.mio-compact-v2 .compact-sidebar-brand img{width:146px;height:40px;object-fit:contain;filter:brightness(0) invert(1)}
#mioficio-dashboard.mio-compact-v2>.compact-sidebar>nav{flex:1;padding:14px 10px;display:flex;flex-direction:column;gap:5px;overflow-y:auto}
#mioficio-dashboard.mio-compact-v2>.compact-sidebar>nav>button{display:flex!important;align-items:center;gap:12px!important;width:100%;min-height:44px!important;height:auto!important;padding:11px 12px!important;border:0!important;border-radius:9px!important;background:none!important;color:#efeaff!important;font-size:13px!important;font-weight:500!important;text-align:left!important;line-height:1.35!important}
#mioficio-dashboard.mio-compact-v2>.compact-sidebar>nav>button[aria-current=page]{background:#ffffff21!important;color:white!important}
#mioficio-dashboard.mio-compact-v2 .compact-sidebar nav button span{flex:1;min-width:0}
#mioficio-dashboard.mio-compact-v2 .compact-sidebar nav button small{background:#ffffff2c;border-radius:14px;font-size:11px;padding:2px 7px}
#mioficio-dashboard.mio-compact-v2 .compact-sidebar nav svg{width:19px!important;height:19px!important;min-width:19px!important;max-width:19px!important;flex:0 0 19px!important;color:inherit!important}
#mioficio-dashboard.mio-compact-v2 .compact-sidebar-account{display:flex;align-items:center;gap:4px;margin:12px;padding:15px 0 0;border-top:1px solid #ffffff28}
#mioficio-dashboard.mio-compact-v2 .compact-sidebar-account>button:first-child{display:flex;align-items:center;gap:9px;min-width:0;flex:1;border:0;background:none;color:white;padding:0;text-align:left}
#mioficio-dashboard.mio-compact-v2 .compact-sidebar-account strong{display:block;font-size:12px!important;font-weight:600!important;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:116px}
#mioficio-dashboard.mio-compact-v2 .compact-sidebar-account small{display:block;font-size:10px;color:#d0c5ff;margin-top:4px}
#mioficio-dashboard.mio-compact-v2 .compact-logout{padding:5px!important;background:none!important;border:0!important;color:#ded7ff!important}
#mioficio-dashboard.mio-compact-v2 .compact-avatar{width:36px!important;height:36px!important;min-width:36px!important;min-height:36px!important;flex:0 0 36px!important;border-radius:50%!important;background:#e9e2ff!important;color:#603bd3!important;font-size:12px!important;font-weight:650!important;display:flex;align-items:center;justify-content:center;border:0!important;padding:0!important;overflow:hidden}
#mioficio-dashboard.mio-compact-v2 .compact-avatar img{width:100%;height:100%;object-fit:cover}
#mioficio-dashboard.mio-compact-v2 .compact-sidebar-account .compact-avatar{color:white!important;background:#ffffff27!important}
#mioficio-dashboard.mio-compact-v2 .compact-topbar{height:60px;min-height:60px;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:0 24px;background:white;position:sticky;top:0;z-index:20;border-bottom:1px solid #e9e5f5;box-sizing:border-box}
#mioficio-dashboard.mio-compact-v2 .compact-topbar-title{font-size:16px!important;font-weight:600!important;min-width:0}
#mioficio-dashboard.mio-compact-v2 .compact-topbar-actions{display:flex;align-items:center;gap:14px;min-width:0}
#mioficio-dashboard.mio-compact-v2 .compact-topbar-actions>button:not(.compact-avatar){color:#625779!important;border:0!important;background:transparent!important;width:32px!important;height:32px!important;min-height:32px!important}
#mioficio-dashboard.mio-compact-v2 .compact-topbar-actions>button svg{width:20px!important;height:20px!important;min-width:20px!important;max-width:20px!important}
#mioficio-dashboard.mio-compact-v2 .compact-topbar-search{display:flex!important;align-items:center;gap:8px;border:1px solid #e7e2f4;border-radius:8px;padding:0 10px;height:34px}
#mioficio-dashboard.mio-compact-v2 .compact-topbar-search input{height:32px!important;min-height:32px!important;padding:0!important;width:100%;background:transparent!important;border:0!important;font-size:12px!important;outline:none;color:#403759}
#mioficio-dashboard.mio-compact-v2 .compact-topbar-search button{border:0;background:none;padding:0;color:#9384b9}
#mioficio-dashboard.mio-compact-v2 .compact-topbar-search svg{width:16px!important;height:16px!important;flex:0 0 16px!important}
#mioficio-dashboard.mio-compact-v2 .compact-home-heading,#mioficio-dashboard.mio-compact-v2 .compact-page-heading{display:flex;align-items:center;justify-content:space-between;gap:14px;margin:0!important;padding:0!important}
#mioficio-dashboard.mio-compact-v2 .compact-home-heading h1,#mioficio-dashboard.mio-compact-v2 .compact-page-heading h1{font-size:24px!important;font-weight:650!important;line-height:1.25!important;letter-spacing:-.6px;margin:0!important;color:#24203c!important}
#mioficio-dashboard.mio-compact-v2 .compact-home-heading p{font-size:13px!important;color:#827c99;margin:6px 0 0!important}
#mioficio-dashboard.mio-compact-v2 .compact-page-heading h1 small{display:inline-flex;vertical-align:middle;align-items:center;justify-content:center;margin-left:6px;padding:3px 7px;font-size:11px;font-weight:600;letter-spacing:0;border-radius:6px;background:#e6dfff;color:#7556d9}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-quick-actions{display:flex!important;gap:10px!important;width:auto!important;margin:0!important;padding:0!important}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-quick-actions button{display:flex!important;align-items:center!important;justify-content:center!important;gap:7px!important;min-height:38px!important;height:auto!important;padding:9px 13px!important;border:1px solid #dfd5fa!important;border-radius:8px!important;background:#e9e2ff!important;color:#6036d3!important;box-shadow:none!important}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-quick-actions .inicio-quick-budget{background:linear-gradient(100deg,#6c42ee,#5c36d7)!important;color:white!important;border-color:transparent!important}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-quick-icon{width:18px!important;height:18px!important;min-width:18px!important;flex:0 0 18px!important;background:none!important;color:inherit!important;padding:0!important;border:0!important}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-quick-icon svg{width:18px!important;height:18px!important;min-width:18px!important;max-width:18px!important}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-quick-copy strong{font-size:12px!important;font-weight:600!important;color:inherit!important}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-quick-copy{flex:0 1 auto!important}#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-quick-plus{display:none!important}
#mioficio-dashboard.mio-compact-v2 .compact-kpis{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
#mioficio-dashboard.mio-compact-v2 .compact-kpis article{background:white;border:1px solid #e7e2f5;border-radius:12px;display:flex!important;align-items:center;gap:16px;padding:16px 18px;min-width:0;position:relative}
#mioficio-dashboard.mio-compact-v2 .compact-kpi-icon{width:46px;height:46px;min-width:46px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#eee8ff;color:#6c40df}
#mioficio-dashboard.mio-compact-v2 .compact-kpi-icon.is-green{background:#e3f6eb;color:#25814c}#mioficio-dashboard.mio-compact-v2 .compact-kpi-icon.is-amber{background:#fff2df;color:#d48a2f}
#mioficio-dashboard.mio-compact-v2 .compact-kpi-icon svg{width:23px!important;height:23px!important;max-width:none!important;min-width:0!important;flex:none!important}
#mioficio-dashboard.mio-compact-v2 .compact-kpis article>div{min-width:0}#mioficio-dashboard.mio-compact-v2 .compact-kpis article>div>span{font-size:12px!important;color:#69627f;display:block}
#mioficio-dashboard.mio-compact-v2 .compact-kpis strong{display:block;font-size:clamp(19px,1.9vw,28px)!important;line-height:1.3!important;font-weight:650!important;letter-spacing:-.6px;margin-top:5px;color:#211b3e;overflow-wrap:anywhere}
#mioficio-dashboard.mio-compact-v2 .compact-money-toggle{position:absolute;top:8px;right:9px;color:#9e91bc;background:none;border:0;padding:3px}
#mioficio-dashboard.mio-compact-v2 .compact-money-toggle svg{width:14px!important;height:14px!important;min-width:0!important;max-width:none!important}
#mioficio-dashboard.mio-compact-v2 .compact-card,#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent{background:white!important;border:1px solid #e7e2f5!important;border-radius:12px!important;padding:18px!important;margin:0!important;min-width:0!important;min-height:0!important;box-shadow:none!important;overflow:visible}
#mioficio-dashboard.mio-compact-v2 .compact-card h2,#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent h2{font-weight:600!important;color:#25203e!important;line-height:1.3!important;margin:0!important}
#mioficio-dashboard.mio-compact-v2 .compact-section-heading,#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-header{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 15px!important;padding:0!important}
#mioficio-dashboard.mio-compact-v2 .compact-section-heading button,#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-header button{display:inline-flex;align-items:center;gap:6px;color:#6c46dc!important;background:none!important;border:0!important;padding:0!important;height:auto!important;min-height:28px!important;font-size:11px!important}
#mioficio-dashboard.mio-compact-v2 .compact-section-heading button svg{width:14px!important;height:14px!important}
#mioficio-dashboard.mio-compact-v2 .compact-home-panels{display:grid;gap:16px}
#mioficio-dashboard.mio-compact-v2 .compact-home-panels>div{min-width:0}
#mioficio-dashboard.mio-compact-v2 .compact-table-scroll{overflow-x:auto!important;max-width:100%;overscroll-behavior-x:contain}
#mioficio-dashboard.mio-compact-v2 .compact-table{width:100%;border-collapse:collapse;table-layout:auto;font-size:12px!important;color:#3a334e}
#mioficio-dashboard.mio-compact-v2 .compact-table th{text-transform:none!important;letter-spacing:0!important;background:#f7f6fb;color:#8a809e;border-bottom:1px solid #ede8f6;padding:10px 9px!important;text-align:left;white-space:nowrap}
#mioficio-dashboard.mio-compact-v2 .compact-table td{padding:12px 9px!important;border-bottom:1px solid #eee9f7;vertical-align:middle}
#mioficio-dashboard.mio-compact-v2 .compact-table td:last-child{white-space:nowrap}#mioficio-dashboard.mio-compact-v2 .compact-table tr:last-child td{border-bottom:0}
#mioficio-dashboard.mio-compact-v2 .compact-table-amount{white-space:nowrap;font-weight:600}#mioficio-dashboard.mio-compact-v2 .compact-table-concept{max-width:230px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#mioficio-dashboard.mio-compact-v2 .compact-table-actions{display:flex;align-items:center;justify-content:flex-end;gap:6px}
#mioficio-dashboard.mio-compact-v2 .compact-table-actions button,#mioficio-dashboard.mio-compact-v2 .compact-client-heading>div button{display:flex;align-items:center;justify-content:center;height:30px!important;min-height:30px!important;width:30px!important;min-width:30px!important;background:none!important;border:0!important;color:#827297!important;padding:6px!important;border-radius:6px!important;cursor:pointer}
#mioficio-dashboard.mio-compact-v2 .compact-table-actions svg,#mioficio-dashboard.mio-compact-v2 .compact-client-heading>div svg{width:16px!important;height:16px!important;min-width:16px!important;max-width:16px!important}
#mioficio-dashboard.mio-compact-v2 .compact-status{font-size:10px;line-height:1.3;display:inline-block;padding:5px 9px;background:#f0ecf7;color:#81718f;border-radius:16px;white-space:nowrap}
#mioficio-dashboard.mio-compact-v2 .compact-status.is-paid{background:#def3e5;color:#277443}#mioficio-dashboard.mio-compact-v2 .compact-status.is-accepted{background:#fff1d9;color:#b07425}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-list{display:grid;gap:0!important}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-row{display:flex!important;gap:10px!important;align-items:center;min-height:67px!important;height:auto!important;background:none!important;border:0!important;border-bottom:1px solid #eee8f6!important;border-radius:0!important;padding:12px 0!important;box-shadow:none!important}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-row:last-child{border-bottom:0!important}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-icon{width:36px!important;height:36px!important;flex:0 0 36px!important;background:#efe9ff!important;color:#6b44dd!important;border-radius:50%!important;font-size:12px!important;font-weight:600!important}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-icon svg{width:17px!important;height:17px!important;min-width:17px!important;max-width:17px!important}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-copy{min-width:0;flex:1!important}#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-copy strong{font-size:12px!important;color:#2c2445!important}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-copy>span{font-size:10px!important;color:#7c88a3!important;line-height:1.45!important}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-value strong{font-size:12px!important;color:#302547!important;white-space:nowrap}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-status{font-size:9px!important;padding:3px 7px!important;border-radius:15px!important}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-status.is-paid{color:#287347!important;background:#ddf1e5!important}#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-status.is-accepted{color:#a57123!important;background:#fff0d9!important}
#mioficio-dashboard.mio-compact-v2 .compact-home .inicio-recent-arrow{font-size:20px!important;color:#a596bb!important}
#mioficio-dashboard.mio-compact-v2 .compact-home-bottom{display:grid;gap:16px}
#mioficio-dashboard.mio-compact-v2 .compact-access>button{display:flex;align-items:center;gap:9px;width:100%;height:auto!important;margin-top:9px!important;padding:8px!important;border:1px solid #eee8f7!important;border-radius:8px!important;color:#514360!important;text-align:left;cursor:pointer}
#mioficio-dashboard.mio-compact-v2 .compact-access>button svg{width:18px!important;height:18px!important;min-width:18px!important;max-width:18px!important;color:#794edd;flex:0 0 18px!important}#mioficio-dashboard.mio-compact-v2 .compact-access>button svg:last-child{margin-left:auto}
#mioficio-dashboard.mio-compact-v2 .compact-primary,#mioficio-dashboard.mio-compact-v2 :is(.model-primary-button,.profile-v2-save,.premium-hub-actions button,.premium-plan-pay,.budget-clean-next,.rubro-v2-apply){background:#6944df!important;border-color:#6944df!important;color:white!important;box-shadow:none!important}
#mioficio-dashboard.mio-compact-v2 .compact-primary{display:inline-flex!important;align-items:center;justify-content:center;gap:8px;border:1px solid transparent;border-radius:8px!important;padding:9px 14px!important;height:36px!important;min-height:36px!important;font-size:12px!important;font-weight:600!important;cursor:pointer}
#mioficio-dashboard.mio-compact-v2 .compact-primary svg{width:17px!important;height:17px!important;min-width:17px!important;max-width:17px!important;flex:0 0 17px!important}
#mioficio-dashboard.mio-compact-v2 .compact-page-heading .compact-member{color:#78649a;font-size:11px}
#mioficio-dashboard.mio-compact-v2 .compact-member{display:inline-flex;align-items:center;gap:5px;font-size:11px!important;color:#8a73a3}
#mioficio-dashboard.mio-compact-v2 .compact-member svg{width:13px!important;height:13px!important;min-width:13px!important;max-width:13px!important;color:#d79d3a}
#mioficio-dashboard.mio-compact-v2 .compact-list-toolbar{display:grid;grid-template-columns:minmax(240px,1fr) auto;gap:12px;align-items:center}
#mioficio-dashboard.mio-compact-v2 .compact-search{display:flex;align-items:center;gap:8px;padding:0 12px!important;min-width:0;max-width:440px;height:38px;background:#ffffffb5;border:1px solid #e1d9f2;border-radius:9px;box-sizing:border-box}
#mioficio-dashboard.mio-compact-v2 .compact-search input{width:100%!important;height:36px!important;min-height:36px!important;padding:0!important;background:transparent!important;border:0!important;font-size:13px!important;color:#51415f!important;outline:none;box-shadow:none!important}
#mioficio-dashboard.mio-compact-v2 .compact-search svg{width:16px!important;height:16px!important;max-width:16px!important;min-width:16px!important;flex:0 0 16px!important;color:#9987b0}
#mioficio-dashboard.mio-compact-v2 .compact-filters{display:flex;gap:6px;flex-wrap:wrap;max-width:100%}
#mioficio-dashboard.mio-compact-v2 .compact-filters button{font-size:11px!important;padding:7px 12px!important;border-radius:20px!important;border:1px solid #e2d9f5!important;background:#ffffff80!important;color:#586781!important;min-height:32px!important;height:auto!important;cursor:pointer}
#mioficio-dashboard.mio-compact-v2 .compact-filters button[aria-pressed=true]{background:#6944df!important;color:white!important;border-color:#6944df!important}
#mioficio-dashboard.mio-compact-v2 .compact-number{display:flex;align-items:center;gap:2px;font-size:12px;margin-bottom:6px}
#mioficio-dashboard.mio-compact-v2 .compact-pagination{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 0;margin:0!important;font-size:11px!important;color:#7c88a3}
#mioficio-dashboard.mio-compact-v2 .compact-pagination>div{display:flex;align-items:center;gap:12px;color:#5e6883}
#mioficio-dashboard.mio-compact-v2 .compact-pagination button{display:flex;align-items:center;justify-content:center;border:1px solid #e6def5;background:#ffffff8f;color:#8e77ac;border-radius:50%;width:32px;height:32px;padding:6px!important;min-height:32px!important;cursor:pointer}
#mioficio-dashboard.mio-compact-v2 .compact-pagination button:disabled{opacity:.35;cursor:default}#mioficio-dashboard.mio-compact-v2 .compact-pagination svg{width:15px!important;height:15px!important}
#mioficio-dashboard.mio-compact-v2 .compact-bulk{border:1px solid #e6def4;background:#ffffffa0;border-radius:8px;padding:8px 12px;font-size:11px!important;color:#8b7a9b}
#mioficio-dashboard.mio-compact-v2 .compact-bulk summary{display:flex;align-items:center;gap:8px;cursor:pointer;list-style:none;font-size:11px!important}
#mioficio-dashboard.mio-compact-v2 .compact-bulk summary svg{width:14px!important;height:14px!important;margin-left:auto}#mioficio-dashboard.mio-compact-v2 .compact-bulk summary span{font-size:10px}
#mioficio-dashboard.mio-compact-v2 .compact-bulk>div{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
#mioficio-dashboard.mio-compact-v2 .compact-bulk button,#mioficio-dashboard.mio-compact-v2 .compact-delete-confirm button{padding:6px 9px!important;min-height:32px!important;height:auto!important;border:1px solid #e4daf4!important;background:white!important;color:#796089!important;border-radius:6px!important;font-size:11px!important;display:flex;align-items:center;gap:5px}
#mioficio-dashboard.mio-compact-v2 .compact-bulk button:disabled{opacity:.45}#mioficio-dashboard.mio-compact-v2 .compact-bulk button svg{width:14px!important;height:14px!important}
#mioficio-dashboard.mio-compact-v2 .compact-delete-confirm p{font-size:12px!important;color:#8c768f}#mioficio-dashboard.mio-compact-v2 .compact-delete-confirm>div{display:flex;gap:10px}
#mioficio-dashboard.mio-compact-v2 .compact-danger{color:#c45c6d!important}
#mioficio-dashboard.mio-compact-v2 .compact-client-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
#mioficio-dashboard.mio-compact-v2 .compact-client-heading{display:flex;align-items:center;gap:11px}
#mioficio-dashboard.mio-compact-v2 .compact-client-avatar{width:38px;height:38px;flex:0 0 38px;display:flex;align-items:center;justify-content:center;background:#e9e1ff;color:#754bdd;border-radius:50%;font-size:13px;font-weight:600}
#mioficio-dashboard.mio-compact-v2 .compact-client-heading h2{flex:1;font-size:14px!important;overflow-wrap:anywhere;min-width:0}
#mioficio-dashboard.mio-compact-v2 .compact-client-heading>div{display:flex;flex-shrink:0;gap:0}
#mioficio-dashboard.mio-compact-v2 .compact-client-data{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:18px 0}
#mioficio-dashboard.mio-compact-v2 .compact-client-data dt{font-size:10px!important;color:#70809b;margin-bottom:4px}
#mioficio-dashboard.mio-compact-v2 .compact-client-data dd{font-size:12px!important;color:#211a3e;margin:0;overflow-wrap:anywhere;line-height:1.4}

  const herramientasCentro=[
    {id:'agenda',titulo:'Agenda',detalle:'Organizá visitas y trabajos con fecha y horario.',plan:'free' as const,icono:'calendar' as const,meta:()=>`${citasAgenda.length} ${citasAgenda.length===1?'trabajo agendado':'trabajos agendados'}`,abrir:()=>abrirMenuPrincipal('agenda')},

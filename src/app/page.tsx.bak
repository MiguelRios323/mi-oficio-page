#mioficio-dashboard.mio-compact-v2 .mio-section-heading{display:flex;align-items:center;justify-content:space-between;gap:10px}#mioficio-dashboard.mio-compact-v2 .mio-section-heading h2{font-size:17px!important;margin:0!important}#mioficio-dashboard.mio-compact-v2 .mio-section-heading p{font-size:11px!important;color:#7c88a3}
#mioficio-dashboard.mio-compact-v2 .mio-eye{width:32px!important;height:32px!important;padding:6px!important;background:#f8f2ff;border:0;border-radius:8px;color:#6541df}
#mioficio-dashboard.mio-compact-v2 .mio-report-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;margin-top:16px}#mioficio-dashboard.mio-compact-v2 .mio-report-grid article{padding:14px;background:#fbf6ff;border-radius:10px}
#mioficio-dashboard.mio-compact-v2 .mio-report-grid h3{font-size:14px!important;color:#6541df;margin:0}#mioficio-dashboard.mio-compact-v2 .mio-report-grid dl{margin:12px 0 0}#mioficio-dashboard.mio-compact-v2 .mio-report-grid dl>div{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:8px;font-size:12px!important}#mioficio-dashboard.mio-compact-v2 .mio-report-grid dd{margin:0;text-align:right;font-weight:600}#mioficio-dashboard.mio-compact-v2 .mio-report-note{font-size:11px!important;color:#7c88a3;line-height:1.5}

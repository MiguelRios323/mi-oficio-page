#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-capture-open>span svg{width:15px!important;height:15px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-real-capture figcaption{font-size:10px!important;line-height:1.5!important;color:#97829f!important;margin:8px 0 0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-step-controls{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:8px!important;margin-top:14px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-step-controls>button{display:inline-flex!important;align-items:center!important;justify-content:center!important;gap:5px!important;min-height:36px!important;height:auto!important;padding:8px 12px!important;font-size:12px!important;font-weight:600!important;line-height:1.3!important;border:1px solid #e6d9f5!important;border-radius:9px!important;background:#f1eafc!important;color:#7049a9!important;box-shadow:none!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-step-controls>button:disabled{opacity:.4!important;cursor:default!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-step-controls>span{font-size:11px!important;color:#9981ac!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-step-controls svg{width:14px!important;height:14px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-capture-dialog{padding:0!important;border:1px solid #ede3f7!important;border-radius:14px!important;width:min(1400px,calc(100vw - 24px))!important;max-width:calc(100vw - 24px)!important;height:calc(100dvh - 24px)!important;max-height:calc(100dvh - 24px)!important;background:#fff!important;color:#392446!important;margin:auto!important;overflow:hidden!important;box-shadow:0 20px 80px #21103840!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-capture-dialog[open]{display:flex!important;flex-direction:column!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-capture-dialog::backdrop{background:#1e133cbb!important;backdrop-filter:blur(4px)!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-capture-dialog>header{display:flex!important;align-items:center!important;justify-content:space-between!important;flex-shrink:0!important;padding:12px 16px!important;border-bottom:1px solid #eae0f5!important;background:#fbf8fe!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-capture-dialog>header strong{font-size:14px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-capture-dialog>header button{display:flex!important;align-items:center!important;justify-content:center!important;width:34px!important;height:34px!important;padding:7px!important;border:0!important;border-radius:8px!important;background:#f0e6fb!important;color:#7349ac!important;box-shadow:none!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-capture-dialog-scroll{flex:1!important;min-height:0!important;overflow:auto!important;padding:16px!important;overscroll-behavior:contain!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-capture-dialog-scroll>p{font-size:13px!important;line-height:1.6!important;margin:0 0 14px!important;color:#594265!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-capture-dialog-scroll>img{display:block!important;width:100%!important;max-width:1400px!important;height:auto!important;margin:auto!important}

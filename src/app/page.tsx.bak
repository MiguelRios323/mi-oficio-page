  const subtotalModal = totalesModal.subtotal;
  const totalModalItems = totalesModal.total + totalesModal.descuento;
  const totalModalFinal = totalesModal.total;
  const secuenciaDisponible = Math.max(Number(proximoNumeroSerie) || 1,1+Math.max(0,...presupuestos.filter(p => p.numero_presupuesto.startsWith(`${seriePresupuesto}-${anioSerie}-`)).map(p => Number(p.numero_presupuesto.match(/-(\d+)$/)?.[1]) || 0)));
  const numeroPresupuestoActual = perfilForm.es_premium===true ? `${seriePresupuesto}-${anioSerie}-${String(secuenciaDisponible).padStart(Math.max(1, Number(digitosSerie) || 4), '0')}` : `PRES-${new Date().getFullYear()}-${String(Math.max(0,...presupuestos.map(p=>Number(p.numero_presupuesto.match(/-(\d+)$/)?.[1]) || 0))+1).padStart(4,'0')}`;


  const clienteFichaModelo=clientes.find(c=>c.cliente_id===fichaClienteModelo);
  const hoyInicioModelo=fechaArgentina();

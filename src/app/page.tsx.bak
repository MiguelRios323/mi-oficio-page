#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .settings-date-stamp{display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;flex:0 0 42px!important;width:42px!important;height:45px!important;background:#f6f1fd!important;border-radius:9px!important;color:#7d5bb0!important}

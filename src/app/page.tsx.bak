    {tab:'negocio',label:'Mi negocio',icon:'settings',count:0},
    {tab:'catalogo',label:'Catálogo',icon:'quotes',count:0},
    {tab:'perfil',label:'Perfil',icon:'profile',count:0},
    {tab:'premium',label:'Premium',icon:'home',count:0},
  ] as const;
  const abrirMenuPrincipal = (tab:string) => {
    if(tab==='perfil'){setMostrarCuentaAcceso(true);return;}
    setMostrarCrear(false);
    setModoCatalogo(null);setFormArticuloVisible(false);setFormAgenda(null);setErrorAgenda('');
    setShowDatosNegocioMovil(false);

#mioficio-dashboard.reference-ui.banking-ui .compact-sidebar-account{display:none!important}
#mioficio-dashboard.reference-ui.banking-ui .visual-greeting-avatar{display:flex;align-items:center;justify-content:center;flex:0 0 42px;width:42px;height:42px;border-radius:50%;overflow:hidden;background:#eeeaff;color:#5041f8;font-size:15px}
#mioficio-dashboard.reference-ui.banking-ui .visual-greeting-avatar img{width:100%;height:100%;object-fit:cover}
#mioficio-dashboard.reference-ui.banking-ui .visual-card{background:white;border:1px solid #e4e0f5;border-radius:12px;padding:16px;min-width:0}

#mioficio-dashboard.reference-ui.banking-ui .compact-bottom-nav .nav-label{grid-row:2!important;display:block!important;height:14px!important;line-height:14px!important;font-size:9px!important;font-weight:400!important;white-space:nowrap!important;padding:0!important;margin:0!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-bottom-nav .nav-document-icon{position:absolute!important;left:50%!important;top:-26px!important;transform:translateX(-50%)!important;width:54px!important;height:54px!important;min-width:54px!important;border:4px solid #f4f1ff!important;border-radius:50%!important;display:flex!important;align-items:center!important;justify-content:center!important;background:linear-gradient(150deg,#7160ff,#4230b6)!important;box-shadow:0 0 0 1px #ccc6f7,0 0 12px #6049f845!important;color:white!important;line-height:0!important}
#mioficio-dashboard.reference-ui.banking-ui .compact-bottom-nav .nav-document-icon svg{width:24px!important;height:24px!important;min-width:24px!important;max-width:24px!important;display:block!important}

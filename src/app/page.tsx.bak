eccion-eliminar-movil":"/ayuda/captura-dbd7fb76daeb97c0.webp","seleccion-eliminar-pc":"/ayuda/captura-d606fd1254ba1cef.webp","seleccion-marcada-movil":"/ayuda/captura-1d02aa8d321d8f7f.webp","seleccion-marcada-pc":"/ayuda/captura-a6d70ff608e485e5.webp","seleccion-multiple-movil":"/ayuda/captura-83a1748237d421a1.webp","seleccion-multiple-pc":"/ayuda/captura-39dcd3499bb15654.webp","documentos-centro-pc":"/ayuda/v120-comprobantes-pc.webp","documentos-centro-movil":"/ayuda/v120-comprobantes-movil.webp","documentos-generar-pc":"/ayuda/captura-98bc259844d6a2bf.webp","documentos-generar-movil":"/ayuda/captura-7358d1ecae7536dd.webp","documentos-trabajo-pc":"/ayuda/captura-20fe6991c2a0734c.webp","documentos-trabajo-movil":"/ayuda/captura-e6cc646686ae0538.webp","documentos-guardado-pc":"/ayuda/captura-2199056f50e5d840.webp","documentos-guardado-movil":"/ayuda/captura-d5d442d0487d5111.webp","generador-simple-pc":"/ayuda/v120-nuevo-presupuesto-pc.webp","generador-simple-movil":"/ayuda/v120-nuevo-presupuesto-movil.webp"};

type CapturaGuiaAyuda = {texto:string;captura:string};
const PASOS_CAPTURAS_AYUDA:Record<string,string[]>={
 'comprobantes':['documentos-centro','documentos-generar','documentos-trabajo','documentos-guardado'],
 'configurar-cuenta':['config-acceso','config-preferencias','config-notificaciones','config-guardar'],
 'exportar-datos':['config-datos','config-json','config-csv'],
 'crear-cliente':['clientes','cliente-datos','cliente-contacto','cliente-guardar'],
 'editar-cliente':['cliente-ficha','cliente-editar','cliente-editar'],
 'eliminar-cliente':['cliente-ficha','cliente-papelera','cliente-eliminar'],
 'historial-cliente':['cliente-ficha','cliente-historial-acceso','cliente-historial'],
 'editar-presupuesto':['presupuestos','detalle-mas','generador-1','presupuesto-guardar'],
 'eliminar-presupuesto':['detalle','detalle-eliminar-mas','presupuesto-eliminar'],
 'eliminar-varios':['seleccion-multiple','seleccion-marcada','seleccion-eliminar','seleccion-eliminar'],
 'borrador':['generador-simple','borrador-guardar','borradores','borrador-continuar'],
 'cobro':['detalle','cobro-datos','cobro-guardar','cobro-resultado'],
 'reversion':['reversion-acceso','reversion-form','reversion-confirmar','reversion-historial'],
 'estados':['estados','inicio','inicio','cobro-revertido'],
 'consolidar':['consolidar-acceso','consolidar-cliente','consolidar-documentos','consolidar-generar'],
 'negocio':['negocio-datos','negocio-datos','negocio-cobros','negocio-documentos','negocio-guardar'],
 'periodo':['periodo-selector','periodo-selector','periodo-fechas','periodo-rango']
};
function pasosCapturadosAyuda(guia:GuiaAyuda,enPC:boolean):CapturaGuiaAyuda[]{
 if(guia.id==='crear-presupuesto')return [{texto:enPC?'Desde Inicio, tocá Nuevo presupuesto.':'Tocá el botón + de la barra inferior.',captura:'inicio'},{texto:'Elegí el cliente y completá descripción, cantidad y precio. Revisá el IVA y el total. Los campos están abiertos; Guardar borrador te permite continuar después.',captura:'generador-simple'},{texto:'Tocá Generar presupuesto. Cuando veas la confirmación podés abrir, descargar o compartir el PDF por WhatsApp.',captura:'presupuesto-emitir'}];
 return guia.pasos.map((texto,i)=>({texto,captura:PASOS_CAPTURAS_AYUDA[guia.id][i]}));
}
function CapturaRealAyuda({captura,texto,enPC}:{captura:string;texto:string;enPC:boolean}){
 const [ampliada,setAmpliada]=useState(false);const dialogRef=useRef<HTMLDialogElement|null>(null);const abrirRef=useRef<HTMLButtonElement|null>(null);
 const src=CAPTURAS_REALES_AYUDA[`${captura}-${enPC?'pc':'movil'}`];
 useEffect(()=>{if(ampliada)dialogRef.current?.showModal();},[ampliada]);
 const cerrar=()=>{dialogRef.current?.close();setAmpliada(false);abrirRef.current?.focus();};
 return <figure className="help-real-capture"><button ref={abrirRef} type="button" className="help-capture-open" onClick={()=>setAmpliada(true)} aria-label="Ampliar captura del paso"><img src={src} alt={`Captura real de MiOficio: ${texto}`} loading="lazy"/><span><IconoOficial nombre="search"/>Ampliar captura</span></button><figcaption>Captura real de MiOficio · Datos de ejemplo · Tocá para ampliar.</figcaption>{ampliada&&<dialog ref={dialogRef} className="help-capture-dialog" aria-label="Captura ampliada del paso" onCancel={e=>{e.preventDefault();cerrar();}} onKeyDown={e=>{if(e.key==='Escape')e.stopPropagation();}}><header><strong>Captura del paso</strong><button type="button" autoFocus onClick={cerrar} aria-label="Cerrar captura ampliada"><IconoOficial nombre="x"/></button></header><div className="help-capture-dialog-scroll"><p>{texto}</p><img src={src} alt={`Captura ampliada: ${texto}`}/></div></dialog>}</figure>;
}
function PasosConCapturasAyuda({guia}:{guia:GuiaAyuda}){
 const [paso,setPaso]=useState(0);const [enPC,setEnPC]=useState(false);
 useEffect(()=>{const media=window.matchMedia('(min-width:1024px)');const actualizar=()=>{setEnPC(media.matches);setPaso(0);};actualizar();media.addEventListener('change',actualizar);return()=>media.removeEventListener('change',actualizar);},[]);
 const pasos=pasosCapturadosAyuda(guia,enPC);const actual=pasos[Math.min(paso,pasos.length-1)];
 return <section className="help-visual-steps" aria-label="Paso a paso con capturas reales"><div className="help-step-progress"><span>Paso {paso+1} de {pasos.length}</span><span>{enPC?'PC':'Celular'}</span></div><p className="help-step-instruction" aria-live="polite">{actual.texto}</p><CapturaRealAyuda key={`${actual.captura}-${paso}`} captura={actual.captura} texto={actual.texto} enPC={enPC}/><div className="help-step-controls"><button type="button" disabled={paso===0} onClick={()=>setPaso(paso-1)}><IconoOficial nombre="chevron-left"/>Anterior</button><span aria-hidden="true">{paso+1} / {pasos.length}</span><button type="button" disabled={paso===pasos.length-1} onClick={()=>setPaso(paso+1)}>Siguiente<IconoOficial nombre="chevron-right"/></button></div></section>;
}

function LimpiarBusqueda({visible,onLimpiar,etiqueta}:{visible:boolean;onLimpiar:()=>void;etiqueta:string}){
 if(!visible)return null;
 return <button type="button" className="ui-search-clear" aria-label={`Limpiar búsqueda de ${etiqueta}`} title="Limpiar búsqueda" onMouseDown={e=>e.preventDefault()} onClick={e=>{e.preventDefault();e.stopPropagation();onLimpiar();e.currentTarget.closest('label')?.querySelector('input')?.focus();}}><IconoOficial nombre="x"/></button>;
}
function AvisoMiOficio({aviso,onCerrar}:{aviso:{mensaje:string;tipo:'success'|'error'};onCerrar:()=>void}){
 const [destino,setDestino]=useState<HTMLElement|null>(null);
 const [enDialogo,setEnDialogo]=useState(false);
 useEffect(()=>{
  let fijado=false;let anfitrion:HTMLDialogElement|null=null;
  const actualizar=()=>{
   const abiertos=Array.from(document.querySelectorAll<HTMLDialogElement>('dialog[open]'));const dialogo=abiertos[abiertos.length-1]||null;
   if(!fijado){anfitrion=dialogo;fijado=true;}
   else if((anfitrion&&(!anfitrion.isConnected||!anfitrion.open||dialogo!==anfitrion))||(!anfitrion&&dialogo)){onCerrar();return;}
   setDestino(anfitrion||document.getElementById('mioficio-dashboard')||document.body);setEnDialogo(Boolean(anfitrion));
  };
  actualizar();const observer=new MutationObserver(actualizar);observer.observe(document.body,{subtree:true,childList:true,attributes:true,attributeFilter:['open']});return()=>observer.disconnect();
 },[aviso]);
 if(!destino||aviso.tipo==='success'&&destino.matches('.financial-record-dialog,.document-work-result'))return null;
 return createPortal(<div role={aviso.tipo==='error'?'alert':'status'} aria-live={aviso.tipo==='error'?'assertive':'polite'} aria-atomic="true" className="mio-toast ui-feedback" data-in-dialog={enDialogo?'true':'false'} data-kind={aviso.tipo}><IconoOficial nombre={aviso.tipo==='error'?'circle-help':'check'}/><span>{aviso.mensaje}</span><button type="button" aria-label="Cerrar aviso" onClick={onCerrar}><IconoOficial nombre="x"/></button></div>,destino);
}
function CentroAyudaMiOficio({onCerrar}:{onCerrar:()=>void}) {
  const [busqueda,setBusqueda]=useState('');
  const [categoria,setCategoria]=useState('Todas');
  const [abierta,setAbierta]=useState<string|null>(null);
  const panelRef=useRef<HTMLElement|null>(null);
  const normalizar=(valor:string)=>valor.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
  const resultados=GUIAS_AYUDA_MIOFICIO.filter(g=>(categoria==='Todas'||g.categoria===categoria)&&normalizar([g.pregunta,g.respuesta,...g.pasos].join(' ')).includes(normalizar(busqueda.trim())));
  useEffect(()=>{
    const anterior=document.activeElement instanceof HTMLElement?document.activeElement:null;
    const panel=panelRef.current;if(!panel)return;
    const fondo:HTMLElement[]=[];let rama:HTMLElement=panel.parentElement!;
    while(rama.parentElement){for(const hermano of Array.from(rama.parentElement.children)){if(hermano!==rama&&hermano instanceof HTMLElement)fondo.push(hermano);}if(rama.parentElement===document.body)break;rama=rama.parentElement;}
    const estados=fondo.map(el=>el.inert);fondo.forEach(el=>{el.inert=true;});
    const overflow=document.body.style.overflow;document.body.style.overflow='hidden';panel.focus();
    const teclado=(e:KeyboardEvent)=>{if(panel.querySelector('.help-capture-dialog[open]'))return;if(e.key==='Escape'){e.preventDefault();onCerrar();return;}if(e.key!=='Tab')return;const controles=Array.from(panel.querySelectorAll<HTMLElement>('button:not(:disabled),input,a[href],select')).filter(el=>el.getClientRects().length>0);const primero=controles[0],ultimo=controles[controles.length-1];if(!primero){e.preventDefault();panel.focus();return;}if(e.shiftKey&&(document.activeElement===primero||document.activeElement===panel)){e.preventDefault();ultimo.focus();}else if(!e.shiftKey&&(document.activeElement===ultimo||document.activeElement===panel)){e.preventDefault();primero.focus();}};
    document.addEventListener('keydown',teclado);return()=>{document.removeEventListener('keydown',teclado);fondo.forEach((el,i)=>{el.inert=estados[i];});document.body.style.overflow=overflow;if(anterior?.isConnected)anterior.focus();};
  },[]);
  return <div className="help-center-overlay" onClick={e=>{if(e.target===e.currentTarget)onCerrar();}}><section className="help-center-panel" ref={panelRef} tabIndex={-1} role="dialog" aria-modal="true" aria-labelledby="help-center-title"><header className="help-center-heading"><div><span>MiOficio · Guías de uso</span><h2 id="help-center-title">Centro de ayuda</h2></div><button type="button" aria-label="Cerrar centro de ayuda" onClick={onCerrar}><IconoOficial nombre="x"/></button></header><div className="help-center-scroll"><p className="help-center-intro">Encontrá tu pregunta y seguí cada paso con capturas de los formularios de MiOficio.</p><label className="help-center-search"><IconoBusqueda/><input aria-label="Buscar en la ayuda" placeholder="Buscá: cliente, presupuesto, cobro…" value={busqueda} onChange={e=>{setBusqueda(e.target.value);setAbierta(null);}} onKeyDown={e=>{if(e.key==='Escape'&&busqueda){e.preventDefault();e.stopPropagation();setBusqueda('');setAbierta(null);}}}/><LimpiarBusqueda visible={Boolean(busqueda)} onLimpiar={()=>{setBusqueda('');setAbierta(null);}} etiqueta="ayuda"/></label><div className="help-center-categories" aria-label="Categorías de ayuda">{['Todas','Clientes','Presupuestos','Cobros','Mi negocio','Configuración'].map(c=><button key={c} type="button" aria-pressed={categoria===c} onClick={()=>{setCategoria(c);setAbierta(null);}}>{c}</button>)}</div><div className="help-center-questions">{resultados.map(g=><article className="help-guide" key={g.id}><h3><button type="button" id={`ayuda-pregunta-${g.id}`} aria-expanded={abierta===g.id} aria-controls={`ayuda-respuesta-${g.id}`} onClick={()=>setAbierta(abierta===g.id?null:g.id)}><span>{g.pregunta}</span><IconoOficial nombre="chevron-down"/></button></h3>{abierta===g.id&&<div className="help-guide-answer" id={`ayuda-respuesta-${g.id}`} role="region" aria-labelledby={`ayuda-pregunta-${g.id}`}><p>{g.respuesta}</p><PasosConCapturasAyuda key={g.id} guia={g}/></div>}</article>)}</div>{!resultados.length&&<p className="help-center-empty" role="status">No encontramos esa consulta. Probá con “cliente”, “presupuesto” o “cobro”.</p>}</div></section></div>;
}

function DashboardFrontend({
  user,
  onLogout,
  planInicial,
  onPlanConsumido,
  cerrandoSesion = false,
}: {
  user: { uid: string; name: string; email: string };
  onLogout: () => void;
  cerrandoSesion?: boolean;
  planInicial: PlanPremium | null;
  onPlanConsumido: () => void;
}) {
  const [showSelectorRubros, setShowSelectorRubros] = useState(false);
  const [busquedaRubro, setBusquedaRubro] = useState('');
  const [rubrosSeleccionados, setRubrosSeleccionados] = useState<ActividadEconomica[]>([]);
  const [rubrosCatalogo, setRubrosCatalogo] = useState<ActividadEconomica[]>(OFICIOS_MIOFICIO);
  const [cargandoRubros, setCargandoRubros] = useState(false);

  useEffect(() => {
    let activo = true;

    // Los oficios de MiOficio aparecen inmediatamente. La carga de ARCA
    // complementa el catálogo después, pero nunca bloquea el buscador.
    setRubrosCatalogo(OFICIOS_MIOFICIO);
    setCargandoRubros(false);

    const cargarRubrosOficiales = async () => {
      try {
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), 7000);

        const response = await fetch('/api/actividades', {
          cache: 'no-store',
          signal: controller.signal,
        });

        window.clearTimeout(timeout);

        if (!response.ok) throw new Error('No se pudo cargar el nomenclador oficial.');

        const data = await response.json();

        if (activo && Array.isArray(data?.actividades)) {
          const oficiales: ActividadEconomica[] = data.actividades
            .filter((a: any) => a && typeof a.nombre === 'string')
            .map((a: { codigo?: string; nombre: string }) => ({
              codigo: String(a.codigo || ''),
              nombre: a.nombre,
              tipo: 'oficial' as const,
            }));

          const unicos = new Map<string, ActividadEconomica>();

          [...OFICIOS_MIOFICIO, ...oficiales].forEach(item => {
            const clave = `${item.tipo}|${item.codigo}|${normalizarBusqueda(item.nombre)}`;
            unicos.set(clave, item);
          });

          setRubrosCatalogo(Array.from(unicos.values()));
        }
      } catch (error) {
        console.warn('CLAE oficial no disponible; se mantienen los oficios MiOficio.', error);
      }
    };

    cargarRubrosOficiales();

    return () => {
      activo = false;
    };
  }, []);

  // Modelo aprobado: estado de presentación; Firebase y los documentos mantienen su implementación.
  const [periodoInicioModelo,setPeriodoInicioModelo]=useState<'mes'|'anio'|'personalizado'>('mes');
  const [desdeInicioModelo,setDesdeInicioModelo]=useState('');
  const [hastaInicioModelo,setHastaInicioModelo]=useState('');
  const [rangoInicioEditor,setRangoInicioEditor]=useState<{desde:string;hasta:string}|null>(null);
  const [pestanaInicioModelo,setPestanaInicioModelo]=useState<'resumen'|'actividad'>('resumen');
  const [ordenClientesModelo,setOrdenClientesModelo]=useState<'recientes'|'nombre'>('recientes');
  const [fichaClienteModelo,setFichaClienteModelo]=useState<number|null>(null);
  const [selectorConsolidadoModelo,setSelectorConsolidadoModelo]=useState(false);
  const [modoSeleccionModelo,setModoSeleccionModelo]=useState(false);
  const [busquedaClienteConsolidado,setBusquedaClienteConsolidado]=useState('');
  const [activeTab, setActiveTab] = useState<string>('dashboard');
  const [busquedaGeneralReferencia,setBusquedaGeneralReferencia]=useState('');
  const [mesResumenReferencia,setMesResumenReferencia]=useState(fechaArgentina().slice(0,7));
  const [semanaAgenda, setSemanaAgenda] = useState('');
  const [diaAgenda, setDiaAgenda] = useState('');
  const [citaSeleccionada, setCitaSeleccionada] = useState<(CitaAgenda & {fecha_instancia:string})|null>(null);
  const [formAgenda, setFormAgenda] = useState<CitaAgenda|null>(null);
  const [guardandoAgenda, setGuardandoAgenda] = useState(false);
  const [errorAgenda, setErrorAgenda] = useState('');
  const [agendaFinSemana, setAgendaFinSemana] = useState(false);
  const [ocultarMontosInicio, setOcultarMontosInicio] = useState(false);
  const [busquedaCabecera, setBusquedaCabecera] = useState('');
  const [vistaInicio, setVistaInicio] = useState<'resumen' | 'negocio'>('resumen');
  const [presupuestosMarcados,setPresupuestosMarcados]=useState<number[]>([]);
  const [confirmarBorradoMultiple,setConfirmarBorradoMultiple]=useState(false);
  const [borrandoPresupuestos,setBorrandoPresupuestos]=useState(false);
  const [horaArgentina,setHoraArgentina]=useState<number|null>(null);
  const [saludoInicio,setSaludoInicio]=useState('Qué gusto tenerte de vuelta');
  useEffect(()=>{const frases=['Qué gusto tenerte de vuelta','Un gusto volver a verte','Bienvenido a tu espacio','Qué bueno que estés acá'];setSaludoInicio(frases[Math.floor(Math.random()*frases.length)]);const actualizar=()=>setHoraArgentina(Date.now());actualizar();const timer=window.setInterval(actualizar,1000);return()=>window.clearInterval(timer);},[]);

  const [showDatosNegocioMovil, setShowDatosNegocioMovil] = useState(false);

  // Cambiar de apartado siempre cierra cualquier modal/editor abierto.
  // Así Clientes, Presupuestos, Perfil y Premium nunca se superponen entre sí.
  useEffect(() => {
    setShowModalPresupuesto(false);
    setShowModalCliente(false);
    setClienteEnEdicion(null);
    setMostrarHistorialCliente(false); setClienteSeleccionadoParaVer(null);
    setPresupuestoEnEdicion(null);
    setShowModalPremium(false);
  }, [activeTab]);
  const [busquedaPresupuesto, setBusquedaPresupuesto] = useState<string>('');
  const [paginaPresupuestos, setPaginaPresupuestos] = useState<number>(1);
  const [paginaClientes, setPaginaClientes] = useState<number>(1);

  const [paginaDashboardPresupuestos, setPaginaDashboardPresupuestos] = useState<number>(1);
  const [filtroEstadoPresupuesto, setFiltroEstadoPresupuesto] = useState<string>('Todos');
  const [notificacion, setNotificacion] = useState<{ mensaje: string; tipo: 'success' | 'error' } | null>(null);
  const [cargandoPremium, setCargandoPremium] = useState(false);

  const [showModalPremium, setShowModalPremium] = useState<boolean>(false);
  const [mostrarExportacion, setMostrarExportacion] = useState(false);
  const [tipoExportacion, setTipoExportacion] = useState<'presupuestos' | 'clientes'>('presupuestos');
  const [exportarDesde, setExportarDesde] = useState('');
  const [exportarHasta, setExportarHasta] = useState('');
  const [exportarMoneda, setExportarMoneda] = useState('');
  const dialogoExportacion = useRef<HTMLDialogElement | null>(null);
  useEffect(() => {
    const dialogo = dialogoExportacion.current;
    if (!dialogo) return;
    if (mostrarExportacion && !dialogo.open) dialogo.showModal();
    else if (!mostrarExportacion && dialogo.open) dialogo.close();
  }, [mostrarExportacion]);
  const [ejemploPremium, setEjemploPremium] = useState<number | null>(null);
  const [compartirMovilDisponible, setCompartirMovilDisponible] = useState(false);
  const [mostrarCompartirWhatsapp, setMostrarCompartirWhatsapp] = useState(false);
  const [presupuestoWhatsappId, setPresupuestoWhatsappId] = useState('');
  const [mensajeWhatsapp, setMensajeWhatsapp] = useState('');
  const [archivoWhatsapp, setArchivoWhatsapp] = useState<{archivo: File; url: string; presupuestoId: number} | null>(null);
  const [preparandoWhatsapp, setPreparandoWhatsapp] = useState(false);
  const [compartiendoWhatsapp, setCompartiendoWhatsapp] = useState(false);
  const solicitudWhatsapp = useRef(0);
  useEffect(() => {
    const media = window.matchMedia('(max-width: 1023px)');
    const actualizar = () => {setCompartirMovilDisponible(media.matches);setPaginaClientes(1);};
    actualizar(); media.addEventListener('change', actualizar);
    return () => media.removeEventListener('change', actualizar);
  }, []);
  useEffect(() => () => { if (archivoWhatsapp) URL.revokeObjectURL(archivoWhatsapp.url); }, [archivoWhatsapp]);

  const [planPremium, setPlanPremium] = useState<'daily' | 'weekly' | 'monthly' | 'yearly'>('monthly');
  const [renovacionMensual,setRenovacionMensual]=useState(false);
  const [consentimientoRenovacion,setConsentimientoRenovacion]=useState(false);
  const [verBeneficiosPremium, setVerBeneficiosPremium] = useState(false);
  const [nombreTarjeta, setNombreTarjeta] = useState('');
  const [errorTarjeta, setErrorTarjeta] = useState('');
  const [procesandoPago, setProcesandoPago] = useState(false);
  const [mostrarBienvenidaPremium, setMostrarBienvenidaPremium] = useState(false);


  const temporizadorAviso=useRef<number|null>(null);
  useEffect(()=>()=>{if(temporizadorAviso.current!==null)window.clearTimeout(temporizadorAviso.current);},[]);
  const cerrarNotificacion=()=>{if(temporizadorAviso.current!==null)window.clearTimeout(temporizadorAviso.current);temporizadorAviso.current=null;setNotificacion(null);};
  const mostrarNotificacion = (mensaje: string, tipo: 'success' | 'error' = 'success') => {
    if(temporizadorAviso.current!==null)window.clearTimeout(temporizadorAviso.current);
    setNotificacion({mensaje,tipo});temporizadorAviso.current=window.setTimeout(()=>{setNotificacion(null);temporizadorAviso.current=null;},tipo==='error'?6000:4000);
  };

  const activarPremium = () => {
    if (!auth.currentUser) {
      mostrarNotificacion(
        'Iniciá sesión nuevamente para continuar.',
        'error'
      );
      return;
    }


  if (perfilForm.es_premium) {
      mostrarNotificacion(
        'Tu cuenta ya tiene MiOficio Premium activo.',
        'success'
      );
      return;
    }

    setNombreTarjeta('');
    setErrorTarjeta('');
    setShowModalPremium(true);
  };

  const pagarPremiumConTarjeta = async () => {
    if (!auth.currentUser) {
      mostrarNotificacion(
        'Iniciá sesión nuevamente para continuar.',
        'error'
      );
      return;
    }

    const documentoTitular = (perfilForm.cuit_cuil || '').trim();
    const documentoNumerico = documentoTitular.replace(/\D/g, '');

    if (
      !documentoTitular ||
      !/^(\d{7,9}|\d{11})$/.test(documentoNumerico)
    ) {
      setErrorTarjeta(
        'Completá tu CUIT / DNI para continuar al pago.'
      );
      return;
    }

    if(planPremium==='monthly'&&renovacionMensual&&!consentimientoRenovacion){setErrorTarjeta('Confirmá la autorización del cobro mensual para continuar.');return;}
    setProcesandoPago(true);
    setErrorTarjeta('');

    try {
      const firebaseToken = await auth.currentUser.getIdToken(true);

      const response = await fetch('/api/mercadopago/create', {
        method: 'POST',
        headers: {
          Authorization: `Bearer ${firebaseToken}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ plan: planPremium, documento: documentoNumerico,renewal:planPremium==='monthly'&&renovacionMensual,renewalConsent:planPremium==='monthly'&&renovacionMensual&&consentimientoRenovacion }),
      });

      const responseText = await response.text();

      let data: any = {};

      try {
        data = responseText ? JSON.parse(responseText) : {};
      } catch {
        throw new Error(
          `El servidor devolvió una respuesta inesperada (${response.status}).`
        );
      }

      if (!response.ok || data?.ok !== true) {
        throw new Error(
          data?.error ||
          data?.message ||
          'No se pudo crear el checkout de Mercado Pago.'
        );
      }

      const redirectUrl =
        data?.redirectUrl ||
        data?.redirect_url ||
        null;

      if (!redirectUrl) {
        throw new Error(
          'Mercado Pago creó la orden, pero no devolvió la URL de pago.'
        );
      }

      console.log('Checkout Premium creado correctamente:', {
        orderId: data?.orderId,
        paymentId: data?.paymentId,
        status: data?.status,
        hasRedirectUrl: true,
      });

      window.location.assign(redirectUrl);
    } catch (error) {
      console.error('Error en el checkout Premium:', error);

      setErrorTarjeta(
        error instanceof Error
          ? error.message
          : 'No se pudo iniciar el pago Premium.'
      );
    } finally {
      setProcesandoPago(false);
    }
  };

  const [perfilForm, setPerfilForm] = useState<Perfil>({
    nombre: user.name ? `Centro de Servicios de ${user.name}` : 'Mi Empresa / Profesional',
    cuit_cuil: '',
    oficio_rubro: 'Servicios Náuticos',
    telefono: '',
    direccion: '',
    localidad: '',
    provincia: 'Santa Fe',
    codigo_postal: '',
    email: user.email || '',
    condicion_iva: 'Monotributista',
    iibb: '',
    titular_cuenta: '',
    banco_pasarela: '',
    cbu_alias: '',
    terminos_default: 'Validez de la oferta: 15 días.',
    es_premium: false,
    logo_url: '',
    acepta_efectivo: true,
    acepta_cheque: false,
    acepta_transferencia: true,
    prefijo_presupuesto: 'PRES-',
    validez_default: 15,
    condicion_pago_default: 'A convenir',
    condiciones_default: 'Validez de la oferta: 15 días.',
    moneda_default: 'ARS',
    iva_default: '21%',
    notificar_aceptados: true,
    notificar_vencimientos: true,
    plantilla_estilo: 'Profesional'
  });

useEffect(() => {
  const params = new URLSearchParams(window.location.search);
  const regresoMercado = params.get('mercadopago') === 'return';

  if (!regresoMercado) return;

  if (perfilForm.es_premium === true) {
    setMostrarBienvenidaPremium(true);
    window.history.replaceState({}, '', window.location.pathname);
  }
}, [perfilForm.es_premium]);
  const [clientes, setClientes] = useState<Cliente[]>([]);
  const [presupuestos, setPresupuestos] = useState<Presupuesto[]>([]);
  const [mostrarEntregas,setMostrarEntregas]=useState(false);
  const entregaScrollRef=useRef<HTMLDivElement|null>(null);
  const entregaFormRef=useRef<HTMLDialogElement|null>(null);
  useEffect(()=>{if(mostrarEntregas&&!entregaFormRef.current?.open)entregaFormRef.current?.showModal();},[mostrarEntregas]);
  const [entregaHayMasCampos,setEntregaHayMasCampos]=useState(false);
  useEffect(()=>{
    if(!mostrarEntregas){setEntregaHayMasCampos(false);return;}
    const pane=entregaScrollRef.current;
    if(!pane)return;
    const form=pane.querySelector('form');
    const check=()=>{if(!form)return;setEntregaHayMasCampos(form.getBoundingClientRect().bottom>pane.getBoundingClientRect().bottom+12);};
    const frame=window.requestAnimationFrame(check);
    const observer=typeof ResizeObserver!=='undefined'?new ResizeObserver(check):null;
    observer?.observe(pane);if(form)observer?.observe(form);
    pane.addEventListener('scroll',check,{passive:true});window.addEventListener('resize',check);
    return()=>{window.cancelAnimationFrame(frame);observer?.disconnect();pane.removeEventListener('scroll',check);window.removeEventListener('resize',check);};
  },[mostrarEntregas,presupuestos]);
  const [entregaEstados,setEntregaEstados]=useState<EstadoPartidaEntrega[]>([]);
  const [entregaCliente,setEntregaCliente]=useState('');
  const [entregaDomicilio,setEntregaDomicilio]=useState('');
  const [entregaContexto,setEntregaContexto]=useState('');
  const [entregaPresupuesto,setEntregaPresupuesto]=useState('');
  const [entregaFecha,setEntregaFecha]=useState(fechaArgentina());
  const [entregaDetalle,setEntregaDetalle]=useState('');
  const [entregaObservaciones,setEntregaObservaciones]=useState('');
  const [entregaGarantia,setEntregaGarantia]=useState('');
  const [entregaRecibe,setEntregaRecibe]=useState('');
  const [guardandoEntrega,setGuardandoEntrega]=useState(false);
  const bloqueoEntrega=useRef(false);
  const [entregaGenerada,setEntregaGenerada]=useState<ComprobanteEntrega|null>(null);
  const [entregaConfirmada,setEntregaConfirmada]=useState(false);
  const entregaGeneradaRef=useRef<HTMLDialogElement|null>(null);
  const [descargandoEntrega,setDescargandoEntrega]=useState(false);
  const descargaEntregaRef=useRef(false);
  useEffect(()=>{if(entregaGenerada&&!entregaGeneradaRef.current?.open)entregaGeneradaRef.current?.showModal();},[entregaGenerada]);
const [mostrarFirmaPremium,setMostrarFirmaPremium]=useState(false);
const verificarPremiumFirma=async()=>{if(perfilForm.es_premium!==true)throw new Error('Las firmas están incluidas en Premium.');const session=auth.currentUser;if(!session)throw new Error('Iniciá sesión nuevamente.');const response=await fetch('/api/mercadopago/status',{cache:'no-store',headers:{Authorization:'Bearer '+await session.getIdToken()}});const status=await response.json();if(!response.ok||status.premium!==true)throw new Error('Necesitás Premium activo para guardar o aplicar una firma.');};
const guardarFirmaPerfil=async(png:string,nombre:string,modo:ModoFirmaAutomatica)=>{await verificarPremiumFirma();const nuevo={...perfilForm,firma_imagen:{png,nombre},firma_automatica:modo};if(!await sincronizarConCloudDirecto(nuevo,clientes,presupuestos))throw new Error('No se pudo guardar la firma.');setPerfilForm(nuevo);};
  const descargarEntrega=async(entrega:ComprobanteEntrega)=>{
    if(descargaEntregaRef.current)return;descargaEntregaRef.current=true;setDescargandoEntrega(true);
    try{if(entrega.firmaDigital){descargarPdfFirmado(entrega.firmaDigital,entrega.numero);return;}const doc=await crearPdfEntregaProfesional(entrega,perfilForm);doc.save(`MiOficio-${entrega.numero}.pdf`);}
    catch{mostrarNotificacion('No se pudo descargar la constancia. Podés volver a intentarlo.','error');}
    finally{descargaEntregaRef.current=false;setDescargandoEntrega(false);}
  };

  const presupuestoEntrega=presupuestos.find(p=>String(p.presupuesto_id)===entregaPresupuesto);
  const textosEntrega=textosEntregaRubro(presupuestoEntrega?.rubro||(perfilForm.oficio_rubro||''));
  const seleccionarEntrega=(id:string)=>{const p=presupuestos.find(p=>String(p.presupuesto_id)===id);const datos=p?autocompletarEntrega(p,(perfilForm.oficio_rubro||'')):null;setEntregaPresupuesto(id);setEntregaEstados((p?.items||[]).map(()=>'realizado'));setEntregaCliente(datos?.cliente||'');setEntregaDomicilio(datos?.domicilio||'');setEntregaContexto(datos?.contexto||'');setEntregaDetalle(datos?.detalle||'');setEntregaRecibe(datos?.recibe||'');setEntregaGarantia(datos?.garantia||'');setEntregaObservaciones('');setEntregaFecha(fechaArgentina());};
  const abrirEntregas=(p?:Presupuesto)=>{if(p&&!['Aceptado','Pagado'].includes(p.estado)){mostrarNotificacion('El presupuesto debe estar aceptado o pagado para generar el comprobante.','error');return;}const seleccionado=p||presupuestos.filter(p=>['Aceptado','Pagado'].includes(p.estado)).sort((a,b)=>b.presupuesto_id-a.presupuesto_id)[0];seleccionarEntrega(seleccionado?String(seleccionado.presupuesto_id):'');setMostrarEntregas(true);};
  const pdfEntrega=async(entrega:ComprobanteEntrega,pestaña:Window|null)=>{
    try {
      if(entrega.firmaDigital){const url=URL.createObjectURL(blobFirmaDigital(entrega.firmaDigital));if(pestaña&&!pestaña.closed)pestaña.location.replace(url);else window.location.assign(url);return;}
      const referencia=presupuestos.find(p=>p.numero_presupuesto===entrega.presupuestoNumero);
      const doc=await crearPdfEntregaProfesional({...entrega,importePresupuesto:entrega.importePresupuesto??(referencia?totalVigentePresupuesto(referencia):undefined),monedaPresupuesto:entrega.monedaPresupuesto||referencia?.moneda||'ARS'},perfilForm);
      const url=URL.createObjectURL(doc.output('blob'));if(pestaña&&!pestaña.closed)pestaña.location.replace(url);else window.location.assign(url);
    }catch(e){if(pestaña&&!pestaña.closed)pestaña.close();mostrarNotificacion(e instanceof Error?e.message:'No se pudo abrir el comprobante.','error');}
  };
  const verEntrega=(entrega:ComprobanteEntrega)=>{const tab=window.open('about:blank','_blank');if(tab)tab.opener=null;void pdfEntrega(entrega,tab);};
  const guardarEntrega=async(event:FormEvent)=>{
    event.preventDefault();if(bloqueoEntrega.current||guardandoEntrega)return;
    const p=presupuestos.find(p=>String(p.presupuesto_id)===entregaPresupuesto);
    if(!p||!['Aceptado','Pagado'].includes(p.estado)){mostrarNotificacion('Elegí un presupuesto aceptado o pagado.','error');return;}
    if(!(p.items||[]).some((_,i)=>entregaEstados[i]==='realizado')){mostrarNotificacion('Incluí al menos un trabajo realizado para generar la constancia.','error');return;}
    if(!entregaCliente.trim()||!entregaDetalle.trim()||!entregaRecibe.trim()||!/^\d{4}-\d{2}-\d{2}$/.test(entregaFecha)||!Number.isFinite(Date.parse(entregaFecha))||entregaFecha>fechaArgentina()){mostrarNotificacion('Completá el detalle, quien recibe y una fecha de entrega válida hasta hoy.','error');return;}
    bloqueoEntrega.current=true;setGuardandoEntrega(true);
    try{
      const session=auth.currentUser;if(!session)throw new Error('Iniciá sesión nuevamente.');
      const id=crypto.randomUUID();const entrega:ComprobanteEntrega={importeRecibido:cobradoPresupuesto(p),partidas:partidasEntregaPresupuesto(p,entregaEstados),clienteDocumento:p.cuit_cuil||'',clienteContacto:[p.telefono,p.email].filter(Boolean).join(' · '),condicionesPresupuesto:{formaPago:p.forma_pago||'',plazo:p.tiempo_ejecucion||'',validez:p.validez_dias||0,adicionales:p.incluir_condiciones_adicionales===false?'':p.condiciones_adicionales||'',descuento:p.descuento||0},rubro:p.rubro||(perfilForm.oficio_rubro||''),contexto:entregaContexto.trim(),importePresupuesto:totalVigentePresupuesto(p),monedaPresupuesto:monedaPresupuesto(p.moneda),id,numero:`ENT-${new Date().getFullYear()}-${id.slice(0,8).toUpperCase()}`,presupuestoNumero:p.numero_presupuesto,cliente:entregaCliente.trim(),domicilio:entregaDomicilio.trim(),fecha:entregaFecha,detalle:resumenPartidasEntrega(partidasEntregaPresupuesto(p,entregaEstados)),observaciones:entregaObservaciones.trim(),garantia:entregaGarantia.trim().slice(0,700),recibe:entregaRecibe.trim().slice(0,150),creadoAt:Date.now(),emisor:{nombre:perfilForm.nombre_comercial||perfilForm.nombre||'Profesional',identificacion:perfilForm.cuit_cuil||'',contacto:[perfilForm.telefono,perfilForm.email].filter(Boolean).join(' · '),logo:perfilForm.logo_url||''}};
      await crearPdfEntregaDetallada(entrega,perfilForm);
      if(perfilForm.es_premium===true&&modoFirmaPerfil(perfilForm)!=='ninguna'){
        await verificarPremiumFirma();
        entrega.firmaDigital=await firmarEntregaAutomatica(entrega,perfilForm);
      }
      if(auth.currentUser?.uid!==session.uid)throw new Error('La sesión cambió. Volvé a generar el comprobante.');
      const nuevos=presupuestos.map(item=>item.presupuesto_id===p.presupuesto_id?{...item,entregas:[...(item.entregas||[]),entrega]}:item);
      if(!await sincronizarConCloudDirecto(perfilForm,clientes,nuevos))return;
      setPresupuestos(nuevos);setMostrarEntregas(false);setEntregaConfirmada(true);setEntregaGenerada(entrega);
      mostrarNotificacion('Constancia guardada. Ya podés abrirla o descargarla.');
    }catch(e){mostrarNotificacion(e instanceof Error?e.message:'No se pudo guardar el comprobante.','error');}finally{bloqueoEntrega.current=false;setGuardandoEntrega(false);}
  };

  const [busquedaCliente, setBusquedaCliente] = useState<string>('');
  const [cargandoNube, setCargandoNube] = useState(true);

  useEffect(() => {
    if (cargandoNube || !planInicial) return;
    if (perfilForm.es_premium !== true) {
      setPlanPremium(planInicial);
      setErrorTarjeta('');
      setShowModalPremium(true);
    }
    onPlanConsumido();
  }, [cargandoNube, planInicial, perfilForm.es_premium, onPlanConsumido]);

  const premiumServidorRef = useRef<boolean | null>(null);
  const vencimientoPremiumRef = useRef<number | null>(null);
  const [avisoPagoMercado, setAvisoPagoMercado] = useState('');
  const [advertenciaFree, setAdvertenciaFree] = useState<{id:string;reason:string} | null>(null);
  const [avisosPlan, setAvisosPlan] = useState<{id:string;title:string;reason:string;at:number;expiresAt:number}[]>([]);
  useEffect(() => {
    let cancelled = false;
    setAvisosPlan([]);
    setAdvertenciaFree(null);
    let checking = false;
    const returning = new URLSearchParams(window.location.search).get('mercadopago') === 'return';
    if (returning) {
      const status = new URLSearchParams(window.location.search).get('status');
      setAvisoPagoMercado(status === 'rejected' || status === 'cancelled'
        ? 'El pago no se completó. Podés elegir un plan e intentar nuevamente.'
        : 'Estamos verificando tu pago con Mercado Pago. Premium se activará cuando se confirme.');
    }
    const check = async () => {
      if (checking || document.visibilityState === 'hidden') return;
      checking = true;
      try {
        const account = auth.currentUser;
        if (!account || account.uid !== user.uid) return;
        const response = await fetch('/api/mercadopago/status', {
          headers: {Authorization: `Bearer ${await account.getIdToken()}`}, cache: 'no-store'
        });
        const result = await response.json();
        if (cancelled || !response.ok || !result.ok) return;
        if (Array.isArray(result.notifications)) setAvisosPlan(result.notifications.filter((item: {id?:unknown;title?:unknown;reason?:unknown;at?:unknown;expiresAt?:unknown}) => typeof item.id === 'string' && typeof item.title === 'string' && typeof item.reason === 'string' && typeof item.at === 'number' && typeof item.expiresAt === 'number'));
        if (result.managed) {
          if (result.premium === true) {
            const activationId = typeof result.activationId === 'string' ? result.activationId : `access-${result.expiresAt}`;
            const welcomeKey = `mioficio-premium-welcome-${user.uid}-${activationId}`;
            let welcomed = false;
            try { welcomed = localStorage.getItem(welcomeKey) === 'seen'; } catch { /* Browser storage may be unavailable. */ }
            if (!welcomed) {
              setAdvertenciaFree(null);
              setMostrarAvisos(false);
              setEjemploPremium(null);
              setMostrarBienvenidaPremium(true);
              try { localStorage.setItem(welcomeKey, 'seen'); } catch { /* The current dialog still works. */ }
            }
          }
          if (!result.premium) {
            const latest = Array.isArray(result.notifications) ? result.notifications[0] : null;
            const lostAccess = premiumServidorRef.current === true;
            const freeEvent = latest && latest.expiresAt === 0 ? latest : null;
            const notice = freeEvent ? {id:String(freeEvent.id),reason:String(freeEvent.reason)} : lostAccess ? {id:`expired-${result.expiresAt || 'access'}`,reason:'Tu acceso Premium finalizó. Elegí un plan para volver a activar las herramientas Premium.'} : null;
            if (notice) {
              const key = `mioficio-free-warning-${user.uid}-${notice.id}`;
              let seen = false;
              try { seen = sessionStorage.getItem(key) === 'seen'; } catch { /* Storage may be unavailable. */ }
              if (!seen) {
                setAdvertenciaFree(notice);
                setMostrarBienvenidaPremium(false);
                try { sessionStorage.setItem(key, 'seen'); } catch { /* Keep the warning available in memory. */ }
              }
            }
          } else setAdvertenciaFree(null);
          premiumServidorRef.current = result.premium === true;
          vencimientoPremiumRef.current = result.expiresAt;
          setPerfilForm(previous => ({...previous, es_premium: result.premium === true}));
          if (result.premium) { setShowModalPremium(false); setAvisoPagoMercado(''); }
        }
      } catch { /* Preserve the current state during temporary network failures. */ }
      finally { checking = false; }
    };
    void check();
    const interval = window.setInterval(() => {
      if (vencimientoPremiumRef.current && Date.now() >= vencimientoPremiumRef.current) {
        premiumServidorRef.current = false;
        setPerfilForm(previous => ({...previous, es_premium: false}));
      }
      void check();
    }, 5000);
    const focus = () => { void check(); };
    window.addEventListener('focus', focus);
    return () => { cancelled = true; window.clearInterval(interval); window.removeEventListener('focus', focus); };
  }, [user.uid]);

  const escribiendoRef = useRef(false);
  const guardadosActivosRef=useRef(0);
  const datosBaseNubeRef=useRef<DatosCuentaSincronizados|null>(null);
  const lecturaPendienteNubeRef=useRef<DatosCuentaSincronizados|null>(null);
  const temporizadorLecturaNubeRef=useRef<ReturnType<typeof setTimeout>|null>(null);
  const safeEmailKey = user.email ? user.email.toLowerCase().replace(/[.#$\[\]]/g, '_') : 'usuario_default';
  const recibirLecturaNube=(data:DatosCuentaSincronizados)=>{
    lecturaPendienteNubeRef.current=data;
    if(temporizadorLecturaNubeRef.current!==null)return;
    const aplicar=()=>{
      if(escribiendoRef.current||guardadosActivosRef.current>0){temporizadorLecturaNubeRef.current=setTimeout(aplicar,100);return;}
      temporizadorLecturaNubeRef.current=null;
      const vigente=lecturaPendienteNubeRef.current;lecturaPendienteNubeRef.current=null;
      if(!vigente)return;
      const anterior=datosBaseNubeRef.current;datosBaseNubeRef.current=vigente;
      if(vigente.perfil&&!compararDatosGuardados(vigente.perfil,anterior?.perfil))setPerfilForm({...vigente.perfil,moneda_default:monedaInicialPerfil(vigente.perfil),...(premiumServidorRef.current===null?{}:{es_premium:premiumServidorRef.current})});
      setClientes(Object.values(vigente.clientes||{}));setPresupuestos(Object.values(vigente.presupuestos||{}));
    };
    temporizadorLecturaNubeRef.current=setTimeout(aplicar,0);
  };
  useEffect(() => {
    if (!user?.email) {setCargandoNube(false);return;}
    const dbRef=ref(db,`usuarios_data/${safeEmailKey}`);
    const unsubscribe=onValue(dbRef,snapshot=>{recibirLecturaNube(snapshot.exists()?snapshot.val():{});setCargandoNube(false);},error=>{console.error('Error en el listener de Firebase:',error);setCargandoNube(false);mostrarNotificacion('No se pudieron cargar tus datos. Revisá la conexión y recargá la página.','error');});
    return()=>{unsubscribe();if(temporizadorLecturaNubeRef.current!==null)clearTimeout(temporizadorLecturaNubeRef.current);temporizadorLecturaNubeRef.current=null;lecturaPendienteNubeRef.current=null;datosBaseNubeRef.current=null;};
  },[safeEmailKey]);
  const sincronizarConCloudDirecto=async(nuevoPerfil:Perfil,nuevosClientes:Cliente[],nuevosPresupuestos:Presupuesto[])=>{
    const base=structuredClone(datosBaseNubeRef.current||{});
    const deseado=structuredClone({perfil:nuevoPerfil,clientes:nuevosClientes,presupuestos:nuevosPresupuestos});
    escribiendoRef.current=true;guardadosActivosRef.current++;
    try{
      const resultado=await runTransaction(ref(db,`usuarios_data/${safeEmailKey}`),actual=>fusionarCuentaSegura(actual||{},base,deseado),{applyLocally:false});
      if(!resultado.committed){mostrarNotificacion('La operación no se confirmó. Tus datos no se modificaron.','error');return false;}
      recibirLecturaNube(resultado.snapshot.val()||{});return true;
    }catch(error){
      console.error('Error al guardar en Realtime Database:',error);
      mostrarNotificacion(error instanceof Error&&error.message.startsWith('CONFLICTO_GUARDADO:')?error.message.replace('CONFLICTO_GUARDADO: ',''):'No se pudo guardar en la nube. Revisá la conexión y volvé a intentar.','error');
      return false;
    }finally{guardadosActivosRef.current--;if(guardadosActivosRef.current===0)escribiendoRef.current=false;}
  };

  // Reserva por cuenta/año, persistente incluso al eliminar presupuestos.
  const reservarNumeroRecibo=async(p:Presupuesto,c:CobroPresupuesto):Promise<string>=>{
    const anio=(c.fecha||p.fecha).slice(0,4);
    if(!/^\d{4}$/.test(anio))throw new Error('Fecha del comprobante inválida.');
    const clave=Array.from(`${p.presupuesto_id}:${c.id}`).map(letra=>letra.codePointAt(0)!.toString(16)).join('_');
    escribiendoRef.current=true;
    try{
      const resultado=await runTransaction(ref(db,`usuarios_data/${safeEmailKey}`),(actual)=>{
        const base=actual||{},series=base.numeracion_recibos||{},serie=series[anio]||{},operaciones=serie.operaciones||{};
        if(operaciones[clave])return base;
        const existentes=listarComprobantesCobros(Object.values(base.presupuestos||{}) as Presupuesto[]);
        const original=existentes.find(item=>item.tipo==='pago'&&item.p.presupuesto_id===p.presupuesto_id&&item.c.id===c.id);
        const emitido=original?.tipo==='pago'?original.c.comprobante_recibido?.numero:undefined;
        let ultimo=Number.isSafeInteger(serie.ultimo)&&serie.ultimo>=0?serie.ultimo:0;
        for(const item of existentes){
          const numero=item.tipo==='pago'?item.c.comprobante_recibido?.numero:undefined;
          const coincidencia=numero?.match(/^REC-(\d{4})-(\d+)$/);
          if(coincidencia&&coincidencia[1]===anio)ultimo=Math.max(ultimo,Number(coincidencia[2]));
        }
        if(!Number.isSafeInteger(ultimo+1))throw new Error('Se agotó la numeración de comprobantes.');
        const numero=emitido||`REC-${anio}-${String(ultimo+1).padStart(4,'0')}`;
        return {...base,numeracion_recibos:{...series,[anio]:{...serie,ultimo:emitido?ultimo:ultimo+1,operaciones:{...operaciones,[clave]:numero}}}};
      },{applyLocally:false});
      const numero=resultado.snapshot.val()?.numeracion_recibos?.[anio]?.operaciones?.[clave];
      if(!resultado.committed||typeof numero!=='string')throw new Error('No se pudo reservar el número.');
      return numero;
    }finally{setTimeout(()=>{escribiendoRef.current=false;},1500);}
  };

  const [capacidadPantalla,setCapacidadPantalla]=useState({clientes:2,presupuestos:3,actividad:4});
  const [vistaPresupuestosTrabajo,setVistaPresupuestosTrabajo]=useState<'presupuestos'|'ordenes'>('presupuestos');
  const [ordenSeleccionadaId,setOrdenSeleccionadaId]=useState<string|null>(null);
  const [presupuestoNuevaOrden,setPresupuestoNuevaOrden]=useState('');
  const [busquedaOrdenes,setBusquedaOrdenes]=useState('');
  const [filtroOrdenes,setFiltroOrdenes]=useState('Todas');
  const [pestanaOrden,setPestanaOrden]=useState<'detalle'|'fotos'|'gastos'|'seguimiento'>('detalle');
  const [guardandoOrden,setGuardandoOrden]=useState(false);
  const bloqueoOrdenRef=useRef(false);
  const [gastoOrdenConcepto,setGastoOrdenConcepto]=useState('');
  const [gastoOrdenImporte,setGastoOrdenImporte]=useState('');
  const [notaOrden,setNotaOrden]=useState('');
  const archivoFotoOrdenRef=useRef<HTMLInputElement|null>(null);
  const preparandoFotoOrdenRef=useRef(false);
  const [preparandoFotoOrden,setPreparandoFotoOrden]=useState(false);
  const [fotoOrdenActiva,setFotoOrdenActiva]=useState<FotoOrdenTrabajo|null>(null);
  const fotoOrdenDialogRef=useRef<HTMLDialogElement|null>(null);
  useEffect(()=>{if(fotoOrdenActiva&&!fotoOrdenDialogRef.current?.open)fotoOrdenDialogRef.current?.showModal();},[fotoOrdenActiva]);
  const ordenesTrabajo=Object.values(perfilForm.ordenes_trabajo||{});
  const ordenSeleccionada=ordenesTrabajo.find(o=>o.id===ordenSeleccionadaId);
  const abrirOrdenTrabajo=(orden:OrdenTrabajo)=>{
    setDetallePresupuestoId(null);setActiveTab('presupuestos');setVistaPresupuestosTrabajo('ordenes');
    setOrdenSeleccionadaId(orden.id);setPestanaOrden('detalle');setGastoOrdenConcepto('');setGastoOrdenImporte('');setNotaOrden('');
    window.scrollTo({top:0,behavior:'auto'});
  };
  const guardarCambioOrden=async(id:string,cambiar:(actual:OrdenTrabajo)=>OrdenTrabajo,mensaje:string):Promise<boolean>=>{
    if(bloqueoOrdenRef.current)return false;
    bloqueoOrdenRef.current=true;setGuardandoOrden(true);escribiendoRef.current=true;
    const evento={id:crypto.randomUUID(),texto:mensaje,fecha:new Date().toISOString()};
    try{
      const resultado=await runTransaction(ref(db,`usuarios_data/${safeEmailKey}`),(base)=>{
        if(!base?.perfil)return;
        const lista=Object.values(base.perfil.ordenes_trabajo||{}) as OrdenTrabajo[];
        const actual=lista.find(o=>o.id===id);if(!actual)return;
        const modificada=cambiar(actual);
        const nueva={...modificada,seguimiento:[...Object.values(actual.seguimiento||{}),evento]};
        return {...base,perfil:{...base.perfil,ordenes_trabajo:lista.map(o=>o.id===id?nueva:o)},actualizado:evento.fecha};
      },{applyLocally:false});
      if(!resultado.committed)throw new Error('La orden ya no está disponible. Actualizá la página.');
      const lista=Object.values(resultado.snapshot.val().perfil.ordenes_trabajo||{}) as OrdenTrabajo[];
      setPerfilForm(prev=>({...prev,ordenes_trabajo:lista}));return true;
    }catch(error){mostrarNotificacion(error instanceof Error?error.message:'No se pudo guardar el cambio. Volvé a intentar.','error');return false;}
    finally{bloqueoOrdenRef.current=false;setGuardandoOrden(false);setTimeout(()=>{escribiendoRef.current=false;},1500);}
  };
  const crearOrdenTrabajo=async(p:Presupuesto)=>{
    if(bloqueoOrdenRef.current)return;
    const existente=ordenesTrabajo.find(o=>o.presupuestoId===p.presupuesto_id);if(existente){abrirOrdenTrabajo(existente);return;}
    if(!['Aceptado','Pagado'].includes(p.estado)){mostrarNotificacion('La orden se crea desde un presupuesto aceptado.','error');return;}
    bloqueoOrdenRef.current=true;setGuardandoOrden(true);escribiendoRef.current=true;
    const id=crypto.randomUUID(),creadaAt=new Date().toISOString(),anio=fechaArgentina().slice(0,4);
    try{
      const resultado=await runTransaction(ref(db,`usuarios_data/${safeEmailKey}`),(actual)=>{
        const base=actual||{},perfil=base.perfil||perfilForm;
        const presupuesto=(Object.values(base.presupuestos||presupuestos) as Presupuesto[]).find(item=>item.presupuesto_id===p.presupuesto_id);
        if(!presupuesto||!['Aceptado','Pagado'].includes(presupuesto.estado))throw new Error('El presupuesto debe seguir aceptado o pagado para crear la orden.');
        const ordenes=Object.values(perfil.ordenes_trabajo||{}) as OrdenTrabajo[];
        if(ordenes.some(o=>o.presupuestoId===p.presupuesto_id))return base;
        const items=(presupuesto.items||[]).filter(item=>item.descripcion.trim());
        const tareas:TareaOrdenTrabajo[]=items.map((item,index)=>({id:`${id}-${index}`,descripcion:item.descripcion,cantidad:item.cantidad,unidad:item.unidad||'un.',realizada:false}));
        if(!tareas.length&&presupuesto.tipo_proyecto?.trim())tareas.push({id:`${id}-0`,descripcion:presupuesto.tipo_proyecto.trim(),cantidad:1,unidad:'un.',realizada:false});
        if(!tareas.length)throw new Error('El presupuesto no tiene trabajos detallados para crear una orden.');
        const series=base.numeracion_ordenes||{};
        let ultimo=Number.isSafeInteger(series[anio])?series[anio]:0;
        for(const orden of ordenes){const n=orden.numero.match(/^OT-(\d{4})-(\d+)$/);if(n&&n[1]===anio)ultimo=Math.max(ultimo,Number(n[2]));}
        if(!Number.isSafeInteger(ultimo+1))throw new Error('No se pudo asignar la numeración de la orden.');
        const orden:OrdenTrabajo={id,numero:`OT-${anio}-${String(ultimo+1).padStart(4,'0')}`,presupuestoId:presupuesto.presupuesto_id,presupuestoNumero:presupuesto.numero_presupuesto,cliente:presupuesto.cliente,titulo:presupuesto.tipo_proyecto||tareas[0].descripcion,moneda:monedaPresupuesto(presupuesto.moneda),montoAcordado:totalVigentePresupuesto(presupuesto),creadaAt,fechaProgramada:'',estado:'Pendiente',tareas,fotos:[],gastos:[],seguimiento:[{id:`${id}-creada`,texto:`Orden creada desde ${presupuesto.numero_presupuesto}.`,fecha:creadaAt}]};
        return {...base,perfil:{...perfil,ordenes_trabajo:[...ordenes,orden]},numeracion_ordenes:{...series,[anio]:ultimo+1},actualizado:creadaAt};
      },{applyLocally:false});
      if(!resultado.committed)throw new Error('No se pudo guardar la orden de trabajo.');
      const lista=Object.values(resultado.snapshot.val().perfil.ordenes_trabajo||{}) as OrdenTrabajo[];
      const orden=lista.find(o=>o.presupuestoId===p.presupuesto_id);if(!orden)throw new Error('No se encontró la orden guardada.');
      setPerfilForm(prev=>({...prev,ordenes_trabajo:lista}));abrirOrdenTrabajo(orden);mostrarNotificacion('Orden de trabajo creada.');
    }catch(error){mostrarNotificacion(error instanceof Error?error.message:'No se pudo crear la orden. Volvé a intentar.','error');}
    finally{bloqueoOrdenRef.current=false;setGuardandoOrden(false);setTimeout(()=>{escribiendoRef.current=false;},1500);}
  };
  const cambiarEstadoOrden=async(orden:OrdenTrabajo,estado:OrdenTrabajo['estado'])=>{
    if(orden.estado===estado)return;
    await guardarCambioOrden(orden.id,actual=>{
      if(estado==='Terminado'&&(!Object.values(actual.tareas||{}).length||Object.values(actual.tareas||{}).some(t=>!t.realizada)))throw new Error('Marcá todos los trabajos realizados antes de terminar la orden.');
      return {...actual,estado};
    },estado==='Terminado'?'Trabajo marcado como terminado.':`Estado cambiado a ${estado.toLocaleLowerCase('es')}.`);
  };
  const agregarGastoOrden=async(e:FormEvent)=>{
    e.preventDefault();if(!ordenSeleccionada)return;
    const importe=Number(gastoOrdenImporte.replace(',','.'));
    if(!gastoOrdenConcepto.trim()||!Number.isFinite(importe)||importe<=0||Math.abs(importe*100-Math.round(importe*100))>.00001){mostrarNotificacion('Ingresá un concepto y un importe positivo con hasta dos decimales.','error');return;}
    const gasto:GastoOrdenTrabajo={id:crypto.randomUUID(),concepto:gastoOrdenConcepto.trim().slice(0,100),importe:Math.round(importe*100)/100,fecha:fechaArgentina()};
    if(await guardarCambioOrden(ordenSeleccionada.id,actual=>({...actual,gastos:[...Object.values(actual.gastos||{}),gasto]}),`Gasto agregado: ${gasto.concepto}.`)){setGastoOrdenConcepto('');setGastoOrdenImporte('');}
  };
  const agregarNotaOrden=async(e:FormEvent)=>{

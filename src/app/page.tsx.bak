#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-home-columns>.approved-card{height:auto!important}
}

/* V10: ayuda contextual junto a notificaciones. */
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-header-tools>.approved-help{display:flex!important;align-items:center!important;justify-content:center!important;width:34px!important;height:34px!important;min-width:34px!important;min-height:34px!important;padding:0!important;border-radius:10px!important;color:white!important;border:1px solid #ffffff30!important;background:#ffffff0c!important;box-shadow:none!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-center-overlay{position:fixed!important;inset:0!important;z-index:220!important;display:flex!important;justify-content:flex-end!important;background:#1b133966!important;backdrop-filter:blur(4px)!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-center-panel{display:flex!important;flex-direction:column!important;width:min(560px,100%)!important;max-width:100%!important;height:100dvh!important;background:#fff!important;color:#21172e!important;box-shadow:-10px 0 45px #1c133923!important;outline:none!important;min-height:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-center-heading{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:12px!important;padding:22px 24px!important;border-bottom:1px solid #ece6f4!important;flex:0 0 auto!important;background:#fcfaff!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-center-heading span{font-size:11px!important;color:#8a779c!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-center-heading h2{font-size:22px!important;line-height:1.3!important;font-weight:700!important;margin:4px 0 0!important;letter-spacing:-.4px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-center-heading>button{display:flex!important;align-items:center!important;justify-content:center!important;width:34px!important;height:34px!important;min-height:34px!important;padding:7px!important;border:0!important;border-radius:10px!important;background:#f0eafa!important;color:#7653ad!important;box-shadow:none!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-center-scroll{flex:1 1 auto!important;min-height:0!important;overflow-y:auto!important;overflow-x:hidden!important;padding:18px 24px 28px!important;overscroll-behavior:contain!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-center-intro{font-size:12px!important;line-height:1.6!important;color:#86738e!important;margin:0 0 16px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-center-search{display:flex!important;align-items:center!important;gap:9px!important;min-height:44px!important;padding:0 12px!important;border:1px solid #e5dcef!important;border-radius:11px!important;background:#faf8fd!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-center-search svg{width:17px!important;height:17px!important;min-width:17px!important;color:#967fab!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-center-search input{flex:1!important;width:100%!important;min-width:0!important;min-height:42px!important;margin:0!important;padding:8px 0!important;background:transparent!important;border:0!important;box-shadow:none!important;border-radius:0!important;font-size:13px!important;line-height:1.5!important;color:#362842!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-center-categories{display:flex!important;gap:7px!important;overflow-x:auto!important;padding:14px 0!important;margin:0 0 2px!important;scrollbar-width:none!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-center-categories>button{flex:0 0 auto!important;min-height:32px!important;height:32px!important;padding:6px 11px!important;border:1px solid #eee7f6!important;border-radius:18px!important;background:white!important;color:#8a729d!important;font-size:11px!important;font-weight:500!important;white-space:nowrap!important;box-shadow:none!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-center-categories>button[aria-pressed=true]{background:#eee7fa!important;border-color:#eee7fa!important;color:#7351ae!important;font-weight:650!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-guide{border-bottom:1px solid #eee8f5!important;padding:0!important;background:transparent!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-guide h3{margin:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-guide h3>button{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:12px!important;width:100%!important;min-height:54px!important;height:auto!important;padding:14px 0!important;border:0!important;border-radius:0!important;background:transparent!important;color:#352742!important;font-size:13px!important;font-weight:600!important;line-height:1.55!important;text-align:left!important;white-space:normal!important;box-shadow:none!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-guide h3>button>svg{width:15px!important;height:15px!important;min-width:15px!important;color:#9576af!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-guide h3>button[aria-expanded=true]>svg{transform:rotate(180deg)!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-guide-answer{padding:0 0 18px!important}

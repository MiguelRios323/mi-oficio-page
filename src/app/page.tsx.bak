#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-header-preview-card .approved-business-preview>summary>svg:last-child{margin-left:auto!important;width:14px!important;height:14px!important;min-width:14px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-header-preview-card .approved-business-preview>.approved-card{padding:12px!important;margin:12px 0 0!important;border:1px solid #ece4f7!important;border-radius:10px!important;background:#fcfaff!important;box-shadow:none!important;min-width:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-header-preview-card .approved-document-heading{display:grid!important;grid-template-columns:44px minmax(0,1fr)!important;gap:10px 12px!important;padding:0!important;align-items:center!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-header-preview-card .approved-document-heading>.approved-logo{width:44px!important;height:44px!important;border-radius:10px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-header-preview-card .approved-document-heading>div:last-child{grid-column:1/-1!important;display:flex!important;flex-wrap:wrap!important;gap:4px 14px!important;border-top:1px solid #ede5f6!important;padding-top:10px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-header-preview-card .approved-document-heading small{font-size:11px!important;line-height:1.5!important;overflow-wrap:anywhere!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-header-preview-card .approved-document-heading strong{font-size:13px!important;line-height:1.5!important;overflow-wrap:anywhere!important}
@media(min-width:1024px){
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard #negocio-panel-presupuestos{display:grid!important;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr)!important;gap:16px!important;align-items:start!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard #negocio-panel-presupuestos>.business-surface{align-self:start!important;height:auto!important;min-height:0!important;margin:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .budget-generator:not(.client-v2):has([data-desktop-stage="1"]) .budget-v2-shell,
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .budget-generator:not(.client-v2):has([data-desktop-stage="2"]) .budget-v2-shell{max-width:min(1040px,100%)!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .budget-generator:not(.client-v2) .budget-v2-card:is([data-desktop-stage="1"],[data-desktop-stage="2"]){display:block!important;width:100%!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .budget-generator:not(.client-v2) .budget-v2-card:is([data-desktop-stage="1"],[data-desktop-stage="2"])>.reference-budget-client{display:block!important;grid-column:1/-1!important;width:100%!important;min-width:0!important;box-sizing:border-box!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .budget-v2-card[data-desktop-stage="1"] .reference-budget-client>.budget-v2-section:nth-child(2),
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .budget-v2-card[data-desktop-stage="2"] .reference-budget-client>.budget-v2-section:first-child{display:none!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .budget-v2-card[data-desktop-stage="2"] .reference-budget-client>.budget-v2-section:nth-child(2){display:block!important;width:100%!important;min-width:0!important;margin:0!important;padding:0!important;border:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .budget-v2-card[data-desktop-stage="2"] .budget-client-essential-details>.budget-v2-grid{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:12px 16px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .budget-v2-card[data-desktop-stage="2"] .budget-client-essential-details>.budget-v2-grid>.budget-full{grid-column:1/-1!important}
}


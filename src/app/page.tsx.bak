#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-finances-grid .approved-metric>div>span{font-size:11px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-finances-grid .approved-metric strong{font-size:18px!important;white-space:normal!important;overflow-wrap:anywhere!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-finances-grid .approved-metric small{display:block!important;font-size:9px!important;line-height:1.4!important}

/* Contrato visual final: Inicio, navegación, catálogo y todos los formularios. */
#mioficio-dashboard.reference-ui .inicio-recent h2{display:flex;align-items:center;gap:9px}
#mioficio-dashboard.reference-ui .inicio-recent h2 svg{width:21px!important;height:21px!important;min-width:21px!important;max-width:21px!important;color:#6047f4}
#mioficio-dashboard.reference-ui .recent-open{display:flex;align-items:center;gap:10px;min-width:0;flex:1;width:100%;padding:0;border:0;background:none;text-align:left;color:inherit;cursor:pointer}
#mioficio-dashboard.reference-ui .recent-share{display:flex;align-items:center;justify-content:center;width:30px;height:32px;flex:0 0 30px;background:none;border:0;border-radius:8px;color:#5e41e4;padding:5px}
#mioficio-dashboard.reference-ui .recent-share svg{width:21px!important;height:21px!important;min-width:21px!important;max-width:21px!important}
#mioficio-dashboard.reference-ui .recent-open:hover .inicio-recent-copy strong{text-decoration:underline}
#mioficio-dashboard.reference-ui .recent-share:hover{background:#f1edff}
#mioficio-dashboard.reference-ui .home-catalog{background:white;border:1px solid #dfd9fc;border-radius:14px;padding:18px;box-shadow:0 3px 10px #5847b30b;min-width:0}
#mioficio-dashboard.reference-ui .home-catalog-heading{display:flex;align-items:center;gap:10px;justify-content:space-between;margin-bottom:13px}
#mioficio-dashboard.reference-ui .home-catalog-heading h2{display:flex;align-items:center;gap:8px;font-size:16px!important;margin:0}
#mioficio-dashboard.reference-ui .home-catalog-heading>span{font-size:10px;color:#6047f4;background:#f0ebff;border-radius:6px;padding:4px 8px}
#mioficio-dashboard.reference-ui .home-catalog-heading svg{width:21px!important;height:21px!important;min-width:21px!important;max-width:21px!important;color:#6047f4}
#mioficio-dashboard.reference-ui .home-catalog-search{display:flex;align-items:center;gap:8px;width:100%;height:36px;padding:0 10px;border:1px solid #e1d9f7;border-radius:9px;background:#fbfaff}
#mioficio-dashboard.reference-ui .home-catalog-search input{height:34px!important;min-height:34px!important;border:0!important;background:none!important;padding:0!important;box-shadow:none!important;width:100%;font-size:12px!important;outline:none}
#mioficio-dashboard.reference-ui .home-catalog-search svg{width:17px!important;height:17px!important;min-width:17px!important;max-width:17px!important;color:#8b7baa}
#mioficio-dashboard.reference-ui .home-catalog-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 0;border-bottom:1px solid #eeeaf6}
#mioficio-dashboard.reference-ui .home-catalog-row:last-child{border-bottom:0}
#mioficio-dashboard.reference-ui .home-catalog-row strong{display:block;font-size:13px;font-weight:500}
#mioficio-dashboard.reference-ui .home-catalog-row small{display:block;font-size:11px;color:#87839d;margin-top:3px}
#mioficio-dashboard.reference-ui .home-catalog-row>button{display:flex;align-items:center;justify-content:center;gap:0;position:relative;width:33px;height:32px;border:1px solid #ded5f7;border-radius:8px;background:#fbfaff;color:#6047f4}
#mioficio-dashboard.reference-ui .home-catalog-row>button svg:first-child{width:18px!important;height:18px!important;min-width:18px!important;max-width:18px!important}
#mioficio-dashboard.reference-ui .home-catalog-row>button svg:last-child{position:absolute;right:1px;bottom:3px;width:10px!important;height:10px!important;min-width:10px!important;max-width:10px!important;background:white}
#mioficio-dashboard.reference-ui .home-catalog-help,#mioficio-dashboard.reference-ui .home-catalog-empty p{font-size:11px!important;line-height:1.5!important;color:#87839d;margin:12px 0 0}
#mioficio-dashboard.reference-ui .home-catalog-empty button{display:inline-flex;align-items:center;gap:5px;margin-top:10px;padding:6px 9px;border:1px solid #ded5f7;border-radius:7px;background:#faf8ff;color:#6047f4;font-size:12px}
#mioficio-dashboard.reference-ui .mobile-menu-page>p{color:#ede8ff;font-size:13px!important;margin:6px 0 20px}
#mioficio-dashboard.reference-ui .mobile-menu-card{background:white;border:1px solid #dfd9fc;border-radius:15px;overflow:hidden}
#mioficio-dashboard.reference-ui .mobile-menu-card>button{display:flex;align-items:center;gap:13px;width:100%;padding:18px;border:0;border-bottom:1px solid #ede8f6;background:white;text-align:left;color:#292144}
#mioficio-dashboard.reference-ui .mobile-menu-card>button:last-child{border-bottom:0}
#mioficio-dashboard.reference-ui .mobile-menu-card>button>span{flex:1}
#mioficio-dashboard.reference-ui .mobile-menu-card strong{display:block;font-size:14px;font-weight:500}
#mioficio-dashboard.reference-ui .mobile-menu-card small{display:block;font-size:11px;color:#87839d;margin-top:5px}
#mioficio-dashboard.reference-ui .mobile-menu-card svg{width:22px!important;height:22px!important;min-width:22px!important;max-width:22px!important;color:#6047f4}
#mioficio-dashboard.reference-ui .avisos-modal{max-height:min(360px,calc(100dvh - 110px))!important;width:min(360px,calc(100vw - 24px))!important;border-color:#ddd5f5!important;border-radius:14px!important;box-shadow:0 8px 25px #2d175b22!important;color:#292144!important}
#mioficio-dashboard.reference-ui .avisos-header{padding:12px 14px!important;background:#faf8ff;border-color:#e8e1f5!important}
#mioficio-dashboard.reference-ui .avisos-header h3{font-size:14px!important;font-weight:600}
#mioficio-dashboard.reference-ui .avisos-toolbar{padding:7px 12px!important}
#mioficio-dashboard.reference-ui .avisos-item{gap:9px;padding:12px!important;border-color:#ede8f6}
#mioficio-dashboard.reference-ui .avisos-icon{width:30px;height:30px;flex:0 0 30px;border-radius:50%;background:#f1ecff;color:#6047f4}
#mioficio-dashboard.reference-ui .avisos-open strong{font-size:12px!important;font-weight:500}
#mioficio-dashboard.reference-ui .avisos-open span{font-size:11px!important;line-height:1.45}
#mioficio-dashboard.reference-ui :is(.avisos-action,.avisos-resolve,.avisos-mark,.avisos-count){color:#6047f4!important}
#mioficio-dashboard.reference-ui .avisos-direct-actions button{font-size:11px!important;min-height:25px!important;padding:4px 7px!important;border-radius:7px!important}
#mioficio-dashboard.reference-ui .avisos-content{overscroll-behavior:contain}
#mioficio-dashboard.reference-ui .budget-generator{background:#24124666!important;backdrop-filter:blur(3px)}
#mioficio-dashboard.reference-ui .budget-generator .budget-v2-shell{background:#f3f0fc!important;border:1px solid #ddd4f5!important;box-shadow:0 20px 60px #21174730!important}
#mioficio-dashboard.reference-ui .budget-generator .budget-v2-header{position:static!important;display:flex!important;align-items:center!important;justify-content:space-between!important;top:auto!important;right:auto!important;width:100%!important;height:auto!important;min-height:68px!important;padding:14px 18px!important;background:linear-gradient(110deg,#6246f5,#765afa)!important;border:0!important;flex-shrink:0;color:white!important}
#mioficio-dashboard.reference-ui .budget-generator .budget-v2-header h2{font-size:18px!important;font-weight:500!important;margin:0!important;color:white!important;line-height:1.3!important}
#mioficio-dashboard.reference-ui .budget-generator .budget-v2-header p{color:#ede6ff!important;font-size:11px!important;margin:4px 0 0!important;line-height:1.4!important}
#mioficio-dashboard.reference-ui .budget-generator .budget-v2-close{background:#ffffff12!important;color:white!important;border:0!important;width:30px!important;height:30px!important;min-width:30px!important;min-height:30px!important;flex:0 0 30px!important;border-radius:8px!important}
#mioficio-dashboard.reference-ui .budget-generator .budget-v2-scroll{padding:14px 16px!important;background:#f3f0fc!important}
#mioficio-dashboard.reference-ui .budget-generator :is(.budget-v2-section,.client-form-card){background:white!important;border:1px solid #e3dcf4!important;border-radius:12px!important;padding:15px!important;box-shadow:none!important}
#mioficio-dashboard.reference-ui .budget-generator :is(.field,.model-input){background:#fbfaff!important;border-color:#ddd4f1!important;border-radius:8px!important;color:#292144!important;font-weight:400!important}

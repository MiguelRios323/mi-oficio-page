    filasEmisor.forEach((fila,i)=>{fila.forEach((c,col)=>{const xCampo=logoProfesional ? inicioDatosEmisor : 13+col*65;font(true,9.5);if(c.label)doc.text(c.label,xCampo,ey);font(false,9.5);doc.text(c.texto,xCampo+c.offset,ey);});ey+=alturas[i];});

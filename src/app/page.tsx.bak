#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-soft{border:1px solid #e1dcf6!important;background:#efecfd!important;color:#3d26c3!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-icon{padding:5px!important;background:transparent!important;border:0!important;color:inherit!important;min-width:30px!important;min-height:30px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-link,#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-text{background:none!important;border:0!important;padding:0!important;min-height:0!important;color:var(--approved-purple)!important;font-size:12px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-text{font-size:inherit!important;color:inherit!important;text-align:left!important;white-space:normal!important;font-weight:500!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard button:disabled{cursor:not-allowed;opacity:.5}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard :is(.approved-primary,.approved-outline,.approved-soft,.approved-icon,.approved-link,.approved-text):focus-visible{outline:3px solid #b0a0ff;outline-offset:3px}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-header{position:relative!important;margin:0!important;width:100%!important;border:0!important;border-radius:0!important;background:linear-gradient(115deg,#6448fa,#5237e9)!important;color:white!important;z-index:5!important;box-shadow:none!important}

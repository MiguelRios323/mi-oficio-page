#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .help-center-scroll{padding:16px 16px calc(24px + env(safe-area-inset-bottom))!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-header-tools{gap:8px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-tab=dashboard] .approved-header-tools>.approved-help{width:34px!important;height:38px!important;min-width:34px!important;min-height:38px!important}
}
/* V11: guías con capturas reales de cada formulario. */

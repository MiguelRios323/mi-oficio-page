  };
  const cargarFotoOrden=async(e:React.ChangeEvent<HTMLInputElement>)=>{
    const archivo=e.currentTarget.files?.[0],orden=ordenSeleccionada;e.currentTarget.value='';if(!archivo||!orden||bloqueoOrdenRef.current||preparandoFotoOrdenRef.current)return;
    if(!['image/png','image/jpeg','image/webp'].includes(archivo.type)||archivo.size>5*1024*1024){mostrarNotificacion('Elegí una foto PNG, JPG o WEBP de hasta 5 MB.','error');return;}
    if(Object.values(orden.fotos||{}).length>=8){mostrarNotificacion('Podés guardar hasta 8 fotos por orden.','error');return;}
    preparandoFotoOrdenRef.current=true;setPreparandoFotoOrden(true);
    try{
      const datos=await new Promise<string>((resolve,reject)=>{
        const url=URL.createObjectURL(archivo),imagen=new Image();
        imagen.onerror=()=>{URL.revokeObjectURL(url);reject(new Error('No se pudo leer la foto.'));};
        imagen.onload=()=>{try{const escala=Math.min(1,1400/Math.max(imagen.width,imagen.height)),canvas=document.createElement('canvas');canvas.width=Math.round(imagen.width*escala);canvas.height=Math.round(imagen.height*escala);const ctx=canvas.getContext('2d');if(!ctx)throw new Error('No se pudo preparar la foto.');ctx.fillStyle='#fff';ctx.fillRect(0,0,canvas.width,canvas.height);ctx.drawImage(imagen,0,0,canvas.width,canvas.height);let foto=canvas.toDataURL('image/jpeg',.72);if(foto.length>650000)foto=canvas.toDataURL('image/jpeg',.45);if(foto.length>650000)throw new Error('La foto es demasiado grande. Elegí una de menor tamaño.');resolve(foto);}catch(error){reject(error);}finally{URL.revokeObjectURL(url);}};imagen.src=url;
      });
      const foto:FotoOrdenTrabajo={id:crypto.randomUUID(),nombre:archivo.name.slice(0,100),datos,fecha:fechaArgentina()};
      await guardarCambioOrden(orden.id,actual=>{if(Object.values(actual.fotos||{}).length>=8)throw new Error('La orden ya tiene 8 fotos.');return {...actual,fotos:[...Object.values(actual.fotos||{}),foto]};},'Foto del trabajo agregada.');
    }catch(error){mostrarNotificacion(error instanceof Error?error.message:'No se pudo cargar la foto.','error');}
    finally{preparandoFotoOrdenRef.current=false;setPreparandoFotoOrden(false);}
  };


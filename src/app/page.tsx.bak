/* Actividad reciente al costado: dos movimientos, acceso directo al detalle. */
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-home-sidebar{min-width:0;display:flex;flex-direction:column;gap:0;align-self:start}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-home-sidebar .approved-activity{width:100%;min-width:0}

#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-workspace{width:100%!important;max-width:none!important;padding:0!important;border:0!important;background:none!important;box-shadow:none!important;margin:0!important;min-height:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-workspace .visual-page-heading{display:flex!important;margin:0 0 17px!important;padding:0!important;color:var(--approved-ink)!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-workspace .visual-page-heading>svg{display:none!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-workspace .visual-page-heading h2{font-size:27px!important;font-weight:750!important;letter-spacing:-.7px!important;color:var(--approved-ink)!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-workspace .visual-page-heading p{font-size:13px!important;color:#615b7a!important;margin-top:3px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-tabs{display:flex!important;width:100%!important;border-bottom:1px solid #ddd6ee!important;background:none!important;gap:0!important;padding:0!important;border-radius:0!important;margin:0 0 18px!important;box-shadow:none!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-tabs button{flex:1!important;border:0!important;border-bottom:3px solid transparent!important;border-radius:0!important;background:none!important;padding:13px!important;font-size:14px!important;color:#524769!important;box-shadow:none!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-tabs button[aria-selected=true]{border-bottom-color:var(--approved-purple)!important;color:var(--approved-purple)!important;font-weight:700!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-form{display:grid!important;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr)!important;align-items:start!important;gap:18px!important;background:none!important;padding:0!important;border:0!important;max-width:none!important;width:100%!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-form>[role=tabpanel]{grid-column:1!important;display:grid!important;grid-template-columns:1fr!important;gap:16px!important;width:100%!important;min-width:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-columns{display:grid!important;grid-template-columns:1fr!important;gap:16px!important;max-width:none!important;min-width:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-surface{padding:20px!important;background:white!important;border:1px solid white!important;border-radius:18px!important;box-shadow:0 3px 15px #6046f509!important;min-width:0!important;width:100%!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-section-heading{display:flex!important;align-items:center!important;gap:8px!important;margin:0 0 12px!important;padding:0!important;border:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-section-heading h3{font-size:16px!important;font-weight:700!important;line-height:1.4!important;color:var(--approved-ink)!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-section-heading svg{color:var(--approved-purple)!important;width:19px!important;height:19px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-fields{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:10px 12px!important;width:100%!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-fields label{display:flex!important;flex-direction:column!important;gap:5px!important;margin:0!important;color:#554970!important;font-size:12px!important;line-height:1.4!important;min-width:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-fields label.business-full{grid-column:1/-1!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-fields :is(input,select,textarea),#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-select{height:38px!important;min-height:38px!important;border:1px solid #dcd6e7!important;border-radius:8px!important;background:#fefeff!important;padding:8px 10px!important;font-size:13px!important;color:var(--approved-ink)!important;box-shadow:none!important;width:100%!important;max-width:none!important;min-width:0!important;font-weight:400!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-fields textarea{height:auto!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-select{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:8px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-select span{white-space:normal!important;overflow-wrap:anywhere!important;text-align:left!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-fields label:has(#perfil-telefono),#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-fields label:has(#perfil-email){grid-column:auto!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-footnote{font-size:11px!important;color:#837494!important;margin-top:12px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-business-logo{display:flex;align-items:center;gap:18px}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-logo{width:100px;height:100px;display:flex;align-items:center;justify-content:center;background:#eae5ff;border-radius:50%;color:#293f81;flex-shrink:0;overflow:hidden}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-logo img{width:100%!important;height:100%!important;object-fit:contain!important;padding:10px!important;border-radius:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-logo>svg{width:58px!important;height:58px!important;min-width:58px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-business-logo h3{font-size:16px;font-weight:700;margin:0;color:var(--approved-ink)}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-business-logo p{font-size:12px;color:var(--approved-muted);line-height:1.5;margin:5px 0 10px}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-business-preview{grid-column:2;grid-row:1;position:sticky;top:20px;min-width:0}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-document-heading{display:flex;gap:12px;align-items:center;padding:18px 0}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-document-heading>div{flex:1;min-width:0;overflow-wrap:anywhere}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-document-heading .approved-logo{width:62px;height:62px}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-document-heading .approved-logo>svg{width:40px!important;height:40px!important;min-width:40px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-document-heading strong{font-size:13px;font-weight:700}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-document-heading small{font-size:10px;color:var(--approved-muted);display:block;line-height:1.5}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-save{grid-column:2!important;position:static!important;padding:0!important;display:block!important;background:none!important;border:0!important;box-shadow:none!important;align-self:start!important;margin-top:-5px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-save .visual-primary{width:100%!important;border-radius:11px!important;padding:12px!important;background:var(--approved-purple)!important;border:0!important;color:white!important;font-size:13px!important;min-height:42px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-business-preview+.business-save{grid-column:2!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-payment-options{display:flex!important;gap:10px!important;flex-wrap:wrap!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-payment-options label{background:#f7f4ff!important;border:1px solid #e5ddf5!important;border-radius:11px!important;padding:12px!important;color:#4d3c75!important;font-size:13px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-bank{margin-top:18px!important;padding:0!important;border:0!important;background:none!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-bank h4{color:var(--approved-ink)!important;font-size:14px!important;margin-bottom:14px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-numbering,#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-brand{margin-top:16px!important;padding:12px!important;background:#f6f3ff!important;border-radius:12px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .business-outline{background:#efecfd!important;border:1px solid #dfd7f5!important;color:#4931c8!important;border-radius:9px!important;font-size:12px!important;padding:9px 12px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .mobile-menu-page{display:block!important}

#mioficio-dashboard.mio-compact-v2 .premium-hub-grid{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:12px!important}
#mioficio-dashboard.mio-compact-v2 .premium-hub-card{display:grid!important;grid-template-columns:42px minmax(0,1fr)!important;gap:4px 13px!important;padding:16px!important;background:white!important;border:1px solid #e6dff2!important;border-radius:12px!important;box-shadow:none!important;min-height:0!important}

#mioficio-dashboard.reference-ui .budget-generator .budget-v2-close{background:transparent!important}
#mioficio-dashboard.reference-ui .budget-generator .budget-v2-scroll{background:white!important;padding:18px!important}
#mioficio-dashboard.reference-ui .budget-generator :is(.budget-v2-section,.client-essential-section){padding:0 0 16px!important;border:0!important;border-bottom:1px solid #edeaf3!important;background:white!important;border-radius:0!important;margin:0 0 16px!important}
#mioficio-dashboard.reference-ui .budget-generator :is(h3,h4){font-size:13px!important;font-weight:600!important;margin-bottom:12px!important}
#mioficio-dashboard.reference-ui .budget-generator :is(.field,.model-input){background:white!important;border:1px solid #e3dfec!important;border-radius:6px!important;font-size:12px!important;height:36px!important;min-height:36px!important;padding:8px 10px!important}
#mioficio-dashboard.reference-ui .budget-generator :is(.budget-v2-grid,.client-essential-grid){display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:12px!important}
#mioficio-dashboard.reference-ui .client-essential-grid>.budget-full{grid-column:auto!important}
#mioficio-dashboard.reference-ui .client-essential-grid>.client-field-wide{grid-column:1/-1!important}
#mioficio-dashboard.reference-ui .budget-generator .budget-v2-counter{display:none!important}
#mioficio-dashboard.reference-ui .budget-generator .budget-number-date{display:none!important}
#mioficio-dashboard.reference-ui .budget-generator .budget-client-essential-details>summary{display:none!important}
#mioficio-dashboard.reference-ui .budget-generator .budget-client-essential-details>.budget-v2-grid>.budget-full{grid-column:auto!important}
#mioficio-dashboard.reference-ui .budget-generator .budget-mobile-progress{background:white!important;border-bottom:1px solid #edeaf3;padding:16px 18px!important;position:relative}
#mioficio-dashboard.reference-ui .budget-mobile-progress:before{content:'';position:absolute;left:15%;right:15%;top:28px;height:1px;background:#e3ddf0}
#mioficio-dashboard.reference-ui .budget-mobile-progress span{position:relative;width:24px;height:24px}
#mioficio-dashboard.reference-ui .budget-mobile-progress small{display:none}
#mioficio-dashboard.reference-ui .budget-generator .budget-v2-form{flex:0 1 auto!important;min-height:0!important}
#mioficio-dashboard.reference-ui .client-v2 .client-v2-footer{justify-content:flex-end!important}
#mioficio-dashboard.reference-ui .avisos-modal{background:white!important;border-radius:13px!important;width:min(350px,calc(100vw - 24px))!important}
#mioficio-dashboard.reference-ui .avisos-header{background:linear-gradient(115deg,#4b31ed,#7866ff)!important;color:white!important;padding:13px 16px!important}
#mioficio-dashboard.reference-ui .avisos-heading{display:flex!important;align-items:center;gap:9px}
#mioficio-dashboard.reference-ui .avisos-heading>svg{width:19px!important;height:19px!important;min-width:19px!important}
#mioficio-dashboard.reference-ui .avisos-header h3,#mioficio-dashboard.reference-ui .avisos-close{color:white!important}
#mioficio-dashboard.reference-ui .avisos-count{display:none!important}
#mioficio-dashboard.reference-ui .avisos-tabs{display:flex;gap:8px;padding:9px 14px;border-bottom:1px solid #edeaf3;flex-shrink:0}

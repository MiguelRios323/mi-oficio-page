/* Encabezado violeta con profundidad y bordes suaves. */
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-header{
  isolation:isolate!important;overflow:hidden!important;
  background:radial-gradient(ellipse at 88% 0%,#b2a0ff70 0%,transparent 54%),linear-gradient(118deg,#392182 0%,#6141ec 48%,#8063fb 100%)!important;
  border:0!important;box-shadow:0 8px 24px #4d32bd20,inset 0 1px 0 #ffffff20!important;
}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-header::before{
  content:'';position:absolute;z-index:-1;pointer-events:none;right:-50px;top:-115px;width:390px;height:300px;border-radius:50%;border:1px solid #ffffff16;transform:rotate(-24deg);
}

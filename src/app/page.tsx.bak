const OFICIOS_MIOFICIO: ActividadEconomica[] = OFICIOS_BASE.map(([nombre, busqueda]) => ({ codigo: '', nombre, tipo: 'oficio', busqueda }));


type GuiaAyuda = {id:string;categoria:string;pregunta:string;respuesta:string;pasos:string[];visual:string[]};
const GUIAS_AYUDA_MIOFICIO: GuiaAyuda[] = [
  {id:'comprobantes',categoria:'Cobros',pregunta:'¿Dónde genero y descargo los comprobantes?',respuesta:'Comprobantes reúne pagos recibidos, devoluciones y constancias de trabajo. Los pagos y devoluciones usan operaciones ya registradas.',pasos:['En PC entrá a Comprobantes desde el menú lateral; en celular, Menú → Comprobantes. Tocá Generar comprobante.','Elegí el tipo, el presupuesto y el pago o devolución correspondiente. Tocá Ver comprobante y luego Descargar comprobante.','Para Trabajo realizado, elegí un presupuesto aceptado o pagado y revisá los trabajos incluidos. Todos vienen seleccionados. Tocá Generar comprobante.','La constancia queda guardada. Elegí Abrir PDF o Descargar PDF cuando quieras. Podés consultarla otra vez desde el historial de Comprobantes o desde el presupuesto.'],visual:['Comprobantes','Seleccionar operación','Revisar trabajos','Descargar PDF']},
  {id:'crear-cliente',categoria:'Clientes',pregunta:'¿Cómo creo un cliente?',respuesta:'Registrá los datos del cliente para reutilizarlos en tus presupuestos.',pasos:['Entrá en Clientes y tocá Nuevo cliente. También podés usar Nuevo cliente desde Inicio.','Completá el nombre o razón social y el CUIT o DNI. Elegí el tipo de documento y la condición frente al IVA.','Agregá email, teléfono y dirección si los tenés. Los campos con asterisco son obligatorios.','Tocá Guardar cliente. El cliente aparecerá en la lista.'],visual:['Clientes → Nuevo cliente','Completá nombre y CUIT / DNI','Guardar cliente']},
  {id:'editar-cliente',categoria:'Clientes',pregunta:'¿Cómo edito los datos de un cliente?',respuesta:'La edición se hace desde su ficha.',pasos:['Buscá al cliente en Clientes y tocá Ver ficha.','Tocá Editar cliente y modificá los campos necesarios.','Tocá Guardar cambios para actualizar sus datos.'],visual:['Clientes → Ver ficha','Editar cliente','Guardar cambios']},
  {id:'eliminar-cliente',categoria:'Clientes',pregunta:'¿Cómo elimino un cliente?',respuesta:'Revisá el nombre antes de confirmar la eliminación. Sus presupuestos existentes se conservan.',pasos:['Entrá en Clientes y abrí Ver ficha del cliente.','Tocá el ícono de la papelera junto a Editar cliente.','En la ventana de confirmación, revisá el nombre y tocá Eliminar cliente. Si no querés continuar, cancelá.'],visual:['Clientes → Ver ficha','Papelera de la ficha','Confirmar: Eliminar cliente']},
  {id:'historial-cliente',categoria:'Clientes',pregunta:'¿Dónde veo los presupuestos de un cliente?',respuesta:'Su ficha reúne el acceso al historial de presupuestos.',pasos:['Entrá en Clientes y tocá Ver ficha.','Tocá Historial de presupuestos.','Buscá el documento que necesitás y usá Ver PDF para abrirlo.'],visual:['Clientes → Ver ficha','Historial de presupuestos','Elegí el documento → Ver PDF']},
  {id:'crear-presupuesto',categoria:'Presupuestos',pregunta:'¿Cómo genero un presupuesto?',respuesta:'Usá un solo formulario en PC y celular. Completá cliente, descripción y precio; los campos están abiertos en un único módulo.',pasos:['En celular tocá el botón + de la barra inferior. En PC usá Nuevo presupuesto desde Inicio o Presupuestos.','Elegí el cliente o completá su nombre. En Trabajo o producto escribí la descripción, cantidad y precio sin IVA.','Agregá productos o servicios, cantidad, unidad, precio, bonificación e IVA. Revisá los importes calculados.','Ajustá la unidad, el IVA y el descuento directamente en cada ítem. En el mismo módulo están los datos del trabajo, descuento general, condiciones, moneda, validez y medios de pago.','Revisá el total y tocá Generar presupuesto. Cuando esté guardado, verás Presupuesto creado correctamente. Elegí abrir el PDF, descargarlo o compartirlo por WhatsApp.'],visual:['Celular: + · PC: Nuevo presupuesto','Completá los pasos → Revisión','Emitir presupuesto']},
  {id:'editar-presupuesto',categoria:'Presupuestos',pregunta:'¿Cómo edito un presupuesto?',respuesta:'Abrí el detalle para acceder a la edición con sus datos precargados.',pasos:['En Presupuestos tocá Ver detalle. En PC también podés tocar el número o la fila del documento.','En el detalle abrí Más y elegí Editar.','Modificá los datos y recorré los pasos con Continuar.','En la revisión final tocá Guardar cambios. Si estás completando un borrador, tocá Emitir presupuesto.'],visual:['Presupuestos → Ver detalle','Más → Editar','Revisión → Guardar cambios']},
  {id:'eliminar-presupuesto',categoria:'Presupuestos',pregunta:'¿Cómo elimino un presupuesto?',respuesta:'La eliminación requiere una confirmación y no se puede deshacer.',pasos:['Abrí Ver detalle del presupuesto que querés eliminar.','Tocá Más y elegí Eliminar presupuesto.','Revisá el número en la confirmación y tocá Eliminar presupuesto. También se eliminan los comprobantes de trabajo asociados.'],visual:['Presupuestos → Ver detalle','Más → Eliminar presupuesto','Revisá el número y confirmá']},
  {id:'eliminar-varios',categoria:'Presupuestos',pregunta:'¿Cómo elimino varios presupuestos juntos?',respuesta:'Usá Selección múltiple para marcar los documentos antes de eliminarlos.',pasos:['Entrá en Presupuestos y abrí Selección múltiple al final de la lista.','Marcá las casillas de los documentos. Todos selecciona los resultados del filtro; Limpiar quita la selección.','Tocá Eliminar y revisá la cantidad seleccionada.','Confirmá con Sí, eliminar. Los documentos y sus comprobantes se eliminan de manera permanente.'],visual:['Presupuestos → Selección múltiple','Marcá los documentos','Eliminar → Sí, eliminar']},
  {id:'borrador',categoria:'Presupuestos',pregunta:'¿Cómo guardo un presupuesto para terminarlo después?',respuesta:'Guardalo como borrador mientras completás el formulario.',pasos:['Abrí el generador y completá los datos que tengas.','Tocá Guardar borrador al pie del formulario en PC o celular.','Buscalo en Presupuestos usando el filtro Borradores.','Abrí su detalle y tocá Continuar para completar los pasos y emitirlo.'],visual:['Formulario de presupuesto','Guardar borrador','Borradores → Continuar']},
  {id:'cobro',categoria:'Cobros',pregunta:'¿Cómo registro un cobro o una seña?',respuesta:'Free permite registrar el saldo completo. Premium también permite registrar pagos parciales.',pasos:['Abrí Ver detalle del presupuesto y tocá Registrar pago.','Elegí Pago total para completar el saldo, o Pago parcial para ingresar un importe menor. Indicá fecha y medio de pago; la nota es opcional.','Confirmá con Registrar pago total o Registrar pago parcial. En Pago registrado podés revisar los datos y descargar el comprobante cuando lo necesites.','Si cubrís todo el saldo, el presupuesto pasa a Pagado. Con un pago parcial se muestra Pago parcial y el saldo restante.'],visual:['Ver detalle → Registrar pago','Importe + fecha + medio de pago','Registrar pago → Saldo actualizado']},
  {id:'reversion',categoria:'Cobros',pregunta:'¿Cómo devuelvo dinero al cliente y obtengo el comprobante?',respuesta:'Registrá una devolución realizada en efectivo, transferencia o cheque. Puede corresponder a un repuesto más económico, un ajuste de precio o una cancelación parcial o total.',pasos:['Entrá a Cobros → Devoluciones y elegí Devolver dinero en el presupuesto correspondiente. También podés hacerlo desde Más → Devolver dinero en su ficha.','Elegí Pago parcial o Pago completo. En parcial ingresá el importe; en completo se carga todo lo cobrado. Indicá el nuevo total acordado por los trabajos que continúan. Elegí el medio, la fecha y una referencia si la tenés. En Qué se canceló o ajustó describí qué cambió. Si se canceló todo, el nuevo total es cero y se devuelve todo lo cobrado.','Tocá Guardar devolución. Se guarda la operación y se actualizan los importes. En la confirmación tocá Descargar comprobante cuando quieras obtener el PDF. Si falla el guardado, no se aplica la operación.','Para abrir el comprobante de nuevo, entrá a Comprobantes o desplegá Pagos y devoluciones en el presupuesto. Abrí el movimiento y tocá Descargar comprobante.'],visual:['Detalle → Más → Devolver dinero','Importe, medio y nuevo acuerdo','Guardar y descargar','Historial → Descargar comprobante']},
  {id:'estados',categoria:'Cobros',pregunta:'¿Qué diferencia hay entre Emitido, Aceptado, Pago parcial y Pagado?',respuesta:'La fecha de emisión indica cuándo se creó el documento. Presupuesto muestra su estado comercial y Pago indica si está pendiente, parcial o pagado. Un evento de emisión en Actividad reciente no es un pago.',pasos:['Emitido: el documento está emitido; no registra un cobro. Aceptado: el cliente aceptó el trabajo; tampoco registra dinero por sí solo.','Al elegir Pagado se abre Registrar pago. Elegí el medio y confirmá el pago total; no se guarda dinero por abrir el formulario. Si registrás menos que el saldo, se muestra Pago parcial.','Si aumentás un presupuesto con pagos, lo ya cobrado se conserva y la diferencia queda pendiente. Para reducirlo por debajo de lo cobrado, registrá primero la devolución desde Más → Devolver dinero.','Volver de Pagado a Aceptado corrige y revierte los cobros activos, conservando el historial. Para entregar dinero al cliente, usá Devolver dinero e indicá importe, medio y nuevo total acordado.'],visual:['Emisión y estado actual son datos distintos','Pagado requiere confirmar el pago','Devolver dinero es una operación registrada']},
  {id:'consolidar',categoria:'Presupuestos',pregunta:'¿Cómo reúno presupuestos en un único PDF?',respuesta:'Consolidar en PDF es una función Premium y reúne documentos del mismo cliente.',pasos:['Entrá en Presupuestos y tocá Consolidar en PDF.','Buscá y seleccioná al cliente; después tocá Continuar.','Marcá al menos dos presupuestos de ese cliente.','Tocá Generar PDF para abrir el archivo. En celular puede aparecer un paso previo para compartirlo.'],visual:['Presupuestos → Consolidar en PDF','Elegí cliente y 2 o más documentos','Generar PDF']},
  {id:'negocio',categoria:'Mi negocio',pregunta:'¿Cómo configuro mis datos y el logo del negocio?',respuesta:'Mi negocio reúne los datos que usás para identificarte y preparar tus documentos.',pasos:['En PC usá Mi negocio en el menú lateral. En celular entrá en Menú → Mi negocio.','En Datos completá los datos comerciales y de contacto. Con Premium, Subir imagen permite cargar tu logo. La Vista previa del encabezado está junto al logo y se actualiza con tus datos.','En Cobros elegí tus medios de cobro y los datos para transferencias.','Configurá las condiciones habituales y la numeración desde Tu membresía Premium → Ver herramientas.','Tocá Guardar cambios para guardar la configuración.'],visual:['Datos → Logo y vista previa','Cobros / Herramientas Premium','Guardar cambios']},
  {id:'periodo',categoria:'Cobros',pregunta:'¿Cómo consulto otro período en el resumen?',respuesta:'El selector del resumen permite consultar Este mes, Este año o un período personalizado.',pasos:['En Inicio abrí el selector de período de la tarjeta de cobros.','Elegí Este mes, Este año o Personalizado.','Si elegís Personalizado, tocá el rango de fechas, completá Desde y Hasta y tocá Aplicar período.','El resumen y el gráfico se actualizan con el período seleccionado y la moneda indicada.'],visual:['Inicio → Selector de período','Personalizado → Desde y Hasta','Aplicar período']},
  {id:'configurar-cuenta',categoria:'Configuración',pregunta:'¿Cómo personalizo MiOficio y sus avisos?',respuesta:'Las preferencias se guardan en tu cuenta. La pantalla al ingresar se usa en el próximo acceso.',pasos:['Entrá en Configuración desde la barra de PC. En celular abrí Menú y elegí Configuración.','En Preferencias elegí la pantalla de inicio, el período del resumen y la cantidad de registros por página. También podés ocultar los importes al ingresar.','En Notificaciones activá o desactivá los avisos y elegí con cuántos días de anticipación querés ver los vencimientos.','Cada cambio se guarda automáticamente. También podés tocar Guardar cambios para confirmar el guardado o reintentarlo si falla. Si preferís volver a lo guardado, tocá Descartar cambio.'],visual:['Configuración → Preferencias','Elegí tus avisos','Confirmación del guardado']},
  {id:'exportar-datos',categoria:'Configuración',pregunta:'¿Cómo descargo una copia de mis datos?',respuesta:'Podés descargar un archivo JSON con tu perfil, clientes y presupuestos, o archivos CSV para abrirlos en una planilla. El perfil incluye tu agenda y catálogo.',pasos:['Entrá en Configuración y desplegá Datos y privacidad.','Tocá Descargar todos mis datos para generar el archivo JSON.','Para trabajar en una planilla elegí Clientes · CSV o Presupuestos · CSV. Buscá el archivo en las descargas de tu navegador.'],visual:['Configuración → Datos y privacidad','Descargar todos mis datos','Clientes / Presupuestos · CSV']}

];

const CAPTURAS_REALES_AYUDA:Record<string,string>={"borrador-continuar-movil":"/ayuda/captura-acd53ee9a9e1d4e3.webp","borrador-continuar-pc":"/ayuda/captura-b3e6d9b068b03d25.webp","borrador-guardar-movil":"/ayuda/captura-5351c719a35e3276.webp","borrador-guardar-pc":"/ayuda/captura-e1aaa6f50f9f580e.webp","borradores-movil":"/ayuda/captura-4ab10ab922d0e1e2.webp","borradores-pc":"/ayuda/captura-22b55577478d8565.webp","cliente-contacto-movil":"/ayuda/v120-nuevo-cliente-movil.webp","cliente-contacto-pc":"/ayuda/v120-nuevo-cliente-pc.webp","cliente-datos-movil":"/ayuda/v120-nuevo-cliente-movil.webp","cliente-datos-pc":"/ayuda/v120-nuevo-cliente-pc.webp","cliente-editar-movil":"/ayuda/captura-4d1da192c246879e.webp","cliente-editar-pc":"/ayuda/captura-ef97a57383e40bab.webp","cliente-eliminar-movil":"/ayuda/captura-8f838cf3cbb29027.webp","cliente-eliminar-pc":"/ayuda/captura-790b1d53466e9ad5.webp","cliente-ficha-movil":"/ayuda/captura-9c78bc654961e73e.webp","cliente-ficha-pc":"/ayuda/captura-fcf7fc9fec20d977.webp","cliente-guardar-movil":"/ayuda/v120-nuevo-cliente-movil.webp","cliente-guardar-pc":"/ayuda/v120-nuevo-cliente-pc.webp","cliente-historial-acceso-movil":"/ayuda/captura-4c5ce73581e071f7.webp","cliente-historial-acceso-pc":"/ayuda/captura-c4aa19e986922a1a.webp","cliente-historial-movil":"/ayuda/captura-0bd2e9e1f8132f1d.webp","cliente-historial-pc":"/ayuda/captura-d662d68d2d698332.webp","cliente-papelera-movil":"/ayuda/captura-165a102a226811c3.webp","cliente-papelera-pc":"/ayuda/captura-ff9501a6c82cf19e.webp","clientes-movil":"/ayuda/v120-clientes-movil.webp","clientes-pc":"/ayuda/v120-clientes-pc.webp","cobro-datos-movil":"/ayuda/v120-registrar-pago-movil.webp","cobro-datos-pc":"/ayuda/v120-registrar-pago-pc.webp","cobro-guardar-movil":"/ayuda/v120-registrar-pago-movil.webp","cobro-guardar-pc":"/ayuda/v120-registrar-pago-pc.webp","cobro-resultado-movil":"/ayuda/captura-5e76aa6dd7afd2e9.webp","cobro-resultado-pc":"/ayuda/captura-6585cb487c1a230c.webp","cobro-revertid
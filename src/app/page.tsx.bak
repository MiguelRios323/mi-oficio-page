#mioficio-dashboard.mio-compact-v2 #perfil-profesional .profile-v2-field{height:36px!important;min-height:36px!important;padding:8px 10px!important;background:#fbfaff!important;border:1px solid #ded2ef!important;border-radius:8px!important;font-size:13px!important;color:#211a3e!important;box-shadow:none!important}

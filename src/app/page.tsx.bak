.mi-oficio-ui.mioficio-model .premium-renewal-options{padding:11px!important;border:1px solid #dbeafe!important;border-radius:9px!important;background:#f8fbff!important;margin:12px 0!important}.mi-oficio-ui.mioficio-model .premium-renewal-options p{font-size:11px!important;line-height:1.5!important;color:#64748b!important;margin:7px 0!important}.mi-oficio-ui.mioficio-model .premium-renewal-choice{display:flex!important;gap:6px!important}.mi-oficio-ui.mioficio-model .premium-renewal-choice button{font-size:11px!important;padding:8px!important;height:auto!important;min-height:32px!important;width:auto!important;flex:1!important;border:1px solid #e2e8f0!important;border-radius:7px!important;background:#fff!important;color:#475569!important}.mi-oficio-ui.mioficio-model .premium-renewal-choice button[aria-pressed=true]{background:#eff6ff!important;color:#1d4ed8!important;border-color:#93c5fd!important}.mi-oficio-ui.mioficio-model .premium-renewal-consent{display:flex!important;gap:8px!important;font-size:11px!important;line-height:1.5!important;color:#334155!important;margin-top:9px!important;align-items:flex-start!important}.mi-oficio-ui.mioficio-model .premium-plan-checkout .premium-renewal-consent input{width:15px!important;height:15px!important;min-height:15px!important;padding:0!important;margin-top:2px!important;flex:0 0 15px!important}

const MI_OFICIO_PDF_PNG = "data:image/png;base64,";

// Marca FREE a color: símbolo y nombre al 18%; descripción al 55% para impresión legible.
const MI_OFICIO_MARCA_AGUA_PNG = 'data:image/png;base64,';

const MI_OFICIO_SIMBOLO = `data:image/svg+xml;charset=utf-8,${encodeURIComponent("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 128 132\"><defs id=\"defs9\">\n    <linearGradient id=\"mioficio-blue\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n      <stop offset=\"0\" stop-color=\"#1850ff\" id=\"stop4\" />\n      <stop offset=\"1\" stop-color=\"#1745cf\" id=\"stop6\" />\n    </linearGradient>\n  </defs><g transform=\"translate(8,12)\" id=\"g17\">\n    <path d=\"m 52,5 a 8,8 0 0 1 8,0 l 38,22 a 8,8 0 0 1 4,7 v 44 a 8,8 0 0 1 -4,7 l -38,22 a 8,8 0 0 1 -8,0 L 14,85 A 8,8 0 0 1 10,78 V 34 a 8,8 0 0 1 4,-7 z\" fill=\"url(#mioficio-blue)\" id=\"path11\" />\n    <path d=\"M 56,19 89,38 V 74 L 56,93 23,74 V 38 Z\" fill=\"none\" stroke=\"#ffffff\" stroke-opacity=\"0.25\" stroke-width=\"1.5\" stroke-linejoin=\"round\" id=\"path13\" />\n    <path d=\"M 37,74 V 39 L 56,59 75,39 v 35\" fill=\"none\" stroke=\"#ffffff\" stroke-width=\"8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" id=\"path15\" />\n  </g></svg>")}`;

const convertirSvgADataPng = (svg: string, ancho = 1040, alto = 280): Promise<string> =>
  new Promise((resolve, reject) => {
    const img = new window.Image();
    const timeout = window.setTimeout(() => reject(new Error('El logo tardó demasiado en cargar.')), 5000);
    img.onload = () => {
      window.clearTimeout(timeout);
      try {
        const canvas = document.createElement('canvas');
        canvas.width = ancho;
        canvas.height = alto;
        const ctx = canvas.getContext('2d');
        if (!ctx) throw new Error('No se pudo crear el contexto del canvas');
        ctx.drawImage(img, 0, 0, ancho, alto);
        resolve(canvas.toDataURL('image/png'));
      } catch (error) { reject(error); }
    };
    img.onerror = () => {
      window.clearTimeout(timeout);
      reject(new Error('No se pudo cargar el logo del presupuesto.'));
    };
    const normalizado = svg.replace(/<svg\b[^>]*>/i, (tag) =>
      tag.replace(/\s(?:width|height)\s*=\s*["'][^"']*["']/gi, '').replace(/>$/, ` width="${ancho}" height="${alto}">`));
    img.src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(normalizado)}`;
  });

const prepararLogoParaPdf = async (logoUrl?: string): Promise<{ data: string; format: 'PNG' | 'JPEG' }> => {
  const fuente = logoUrl || MIOFICIO_LOGO_PERMANENTE;
  if (!logoUrl || fuente === MI_OFICIO_PDF_SVG || fuente === MIOFICIO_LOGO_PERMANENTE) {
    return { data: MI_OFICIO_PDF_PNG, format: 'PNG' };
  }
  if (fuente.startsWith('data:image/svg+xml')) {
    const partes = fuente.split(',');
    const meta = partes.shift() || '';
    const payload = partes.join(',');
    const svg = meta.includes(';base64') ? atob(payload) : decodeURIComponent(payload);
    return { data: await convertirSvgADataPng(svg), format: 'PNG' };
  }
  if (fuente.trimStart().startsWith('<svg')) {
    return { data: await convertirSvgADataPng(fuente), format: 'PNG' };
  }
  if (fuente.startsWith('data:image/jpeg') || fuente.startsWith('data:image/jpg')) return { data: fuente, format: 'JPEG' };
  return { data: fuente, format: 'PNG' };
};


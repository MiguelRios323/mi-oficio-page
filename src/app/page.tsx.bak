#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-table th{background:#f5f3fa!important;font-size:11px!important;font-weight:500!important;padding:10px 8px!important;color:#53496c!important;text-align:left!important;white-space:nowrap!important;border:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-table td{padding:13px 8px!important;border-bottom:1px solid #efedf6!important;color:var(--approved-ink)!important;font-size:12px!important;text-align:left!important;vertical-align:middle!important;background:none!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-table tr:last-child td{border-bottom:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-amount{font-weight:650!important;white-space:nowrap!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-badge{display:inline-flex;border-radius:20px;background:#e7e2ff;color:#574681;padding:4px 10px;font-size:11px;white-space:nowrap}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-badge.aceptado{background:#dbf5e6;color:#127947}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-badge.pagado{background:#ddecff;color:#145abd}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-badge.emitido{background:#fff0d5;color:#ad740f}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-inline{display:flex;align-items:center;gap:7px}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-pending-list{display:grid;gap:13px}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-pending-list>button{display:flex!important;gap:12px!important;align-items:center!important;text-align:left!important;border:1px solid #ede7f7!important;background:white!important;padding:14px!important;border-radius:13px!important;width:100%!important;color:var(--approved-ink)!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-pending-list>button>strong{font-size:29px!important;font-weight:700!important;color:#c53b44!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-pending-list>button:last-child>strong{color:#db8b1a!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-pending-list>button>span:nth-last-child(2){flex:1;min-width:0}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-pending-list b{font-size:13px!important;font-weight:650!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-pending-list small{font-size:11px!important;color:var(--approved-muted)!important;display:block!important;margin-top:4px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-activity-row{display:flex!important;align-items:center!important;gap:15px!important;width:100%!important;text-align:left!important;border:0!important;border-bottom:1px solid #ece7f6!important;background:none!important;padding:12px 0!important;color:var(--approved-ink)!important;border-radius:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-activity-row>span:nth-child(2){flex:1;min-width:0}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-activity-row .approved-circle{width:38px!important;height:38px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-activity-row .approved-circle>svg{width:22px!important;height:22px!important;min-width:22px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-activity-row strong{font-size:13px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-activity-row small{font-size:11px!important;display:block!important;color:var(--approved-muted)!important;margin-top:3px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-empty{padding:22px!important;text-align:center!important;color:var(--approved-muted)!important;font-size:13px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-page-heading{margin-bottom:17px}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-page-heading h1{font-size:27px!important;font-weight:750!important;letter-spacing:-.8px!important;line-height:1.3!important;color:var(--approved-ink)!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-page-heading p{font-size:13px!important;color:#615b7a!important;margin-top:3px!important;line-height:1.5!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-toolbar{display:flex;align-items:center;gap:14px;margin-bottom:17px}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-search{display:flex!important;align-items:center!important;gap:10px!important;background:white!important;border:1px solid #e6e0f0!important;border-radius:12px!important;padding:0 13px!important;height:44px!important;flex:1!important;max-width:650px!important;min-width:0!important;color:#6b6282!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-search input{border:0!important;box-shadow:none!important;background:none!important;padding:0!important;min-height:0!important;height:auto!important;width:100%!important;min-width:0!important;font-size:13px!important;color:var(--approved-ink)!important;outline:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-list-meta{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:12px;color:#554b6f;margin-bottom:15px}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-list-meta select{background:none!important;border:0!important;width:auto!important;padding:0!important;height:auto!important;min-height:0!important;font-size:12px!important;color:#554b6f!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-client-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-client-card{display:flex;align-items:center;gap:17px;min-height:125px}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-client-copy{flex:1;min-width:0}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-client-copy h2{font-size:16px!important;font-weight:700!important;line-height:1.3!important;color:var(--approved-ink)!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-client-copy p{display:flex!important;align-items:center!important;gap:8px!important;font-size:12px!important;color:#5d5474!important;margin-top:7px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-client-copy p>svg{width:16px!important;height:16px!important;min-width:16px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-client-actions{display:flex;flex-direction:column;gap:7px;align-items:flex-end}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-client-actions .approved-soft{min-height:34px!important;padding:8px 17px!important;font-size:12px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-client-actions .approved-icon{padding:8px!important;background:#efecfd!important;border:1px solid #e1dcf6!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-client-detail{align-self:start}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-box{border:1px solid #e9e3f3;border-radius:13px;padding:13px}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-row{display:grid;grid-template-columns:1fr 1.3fr;gap:12px;padding:11px 0;border-bottom:1px solid #e9e3f3;font-size:12px;color:#5c516e;overflow-wrap:anywhere}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-detail-row strong{font-weight:500;color:var(--approved-ink)}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-wide{width:100%!important;margin-top:20px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-more{position:relative}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-more>summary{display:flex!important;align-items:center!important;justify-content:center!important;list-style:none!important;cursor:pointer;color:#4d4277;min-height:30px;min-width:28px}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-more summary::-webkit-details-marker{display:none}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-more>summary svg{width:18px!important;height:18px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-more>div{position:absolute;right:0;top:100%;background:white;border:1px solid #e6def7;box-shadow:0 8px 25px #24174722;border-radius:12px;padding:6px;min-width:195px;z-index:15}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-more>div>button,#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-more>div>label{display:flex!important;align-items:center!important;gap:7px!important;background:none!important;border:0!important;padding:10px!important;width:100%!important;color:#4a3c6b!important;text-align:left!important;white-space:nowrap;font-size:12px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-filters{display:flex;gap:8px;overflow:auto;scrollbar-width:none;margin-bottom:18px}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-filters>button{background:#f8f6ff!important;border:1px solid #eee8f8!important;border-radius:11px!important;padding:9px 12px!important;font-size:12px!important;color:#51496e!important;display:flex!important;gap:7px!important;align-items:center!important;white-space:nowrap!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-filters>button[aria-pressed=true]{background:var(--approved-purple)!important;border-color:transparent!important;color:white!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-filters>button>span{border-radius:10px;background:#9b88c51a;padding:1px 5px}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-filters>button[aria-pressed=true]>span{background:#ffffff30}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-consolidate{display:flex;gap:14px;align-items:center;width:100%;max-width:650px;color:var(--approved-ink);margin-top:18px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-consolidate>span:nth-child(2){flex:1;min-width:0}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-consolidate strong{font-size:14px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-consolidate small{display:block;color:var(--approved-muted);font-size:12px;margin-top:5px}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-bundle-clients{display:flex;flex-wrap:wrap;gap:10px;margin-top:15px}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-context{display:flex;justify-content:space-between;align-items:center;background:#e8e0ff;padding:10px;border-radius:10px;margin-bottom:12px;font-size:12px}

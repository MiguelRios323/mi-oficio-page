            if (typeof args[index] === 'number') args[index] = transform(args[index] as number);
          };
          if (property === 'text') { coordinate(1,x); coordinate(2,yy); }
          else if (property === 'rect' || property === 'roundedRect') {
            coordinate(0,x); coordinate(1,yy); coordinate(2,v=>v*sx); coordinate(3,v=>v*sy);

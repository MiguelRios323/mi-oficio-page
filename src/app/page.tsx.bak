#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .business-tabs>button[aria-selected=false]{border-bottom-color:transparent!important;box-shadow:none!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .business-tabs>button[aria-selected=true]{border-bottom-color:#4e3cff!important;box-shadow:none!important}
/* Profile uses its content's natural height, with a single identity row. */
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile>.visual-page-heading{background:transparent!important;border:0!important;border-radius:0!important;padding:0 0 16px!important;margin:0!important;min-height:0!important;box-shadow:none!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-sheet-body{display:block!important;grid-template-columns:none!important;gap:0!important;width:100%!important;max-width:560px!important;min-height:0!important;height:auto!important;padding:0!important;background:#fff!important;border:1px solid #e6e0f2!important;border-radius:12px!important;box-shadow:0 2px 5px #32204904!important;overflow:hidden!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-identity{display:flex!important;flex-direction:row!important;align-items:center!important;justify-content:flex-start!important;gap:14px!important;min-height:0!important;height:auto!important;padding:18px!important;margin:0!important;background:transparent!important;border:0!important;border-bottom:1px solid #eee9f5!important;border-radius:0!important;text-align:left!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-identity>.compact-avatar{display:flex!important;align-items:center!important;justify-content:center!important;flex:0 0 52px!important;width:52px!important;height:52px!important;min-width:52px!important;max-width:52px!important;min-height:52px!important;max-height:52px!important;font-size:21px!important;background:#eee9ff!important;border-radius:50%!important;aspect-ratio:1!important;margin:0!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-identity>.compact-avatar img{width:100%!important;height:100%!important;object-fit:contain!important;background:#fff!important;padding:3px!important;box-sizing:border-box!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-identity>div{min-width:0!important;flex:1!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-identity strong{font-size:16px!important;font-weight:600!important;line-height:1.3!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-identity p{font-size:12px!important;line-height:1.4!important;margin:4px 0 0!important;color:#8c809b!important;overflow-wrap:anywhere!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-identity small{display:inline-block!important;background:transparent!important;padding:0!important;margin:5px 0 0!important;border-radius:0!important;font-size:10px!important;line-height:1.3!important;color:#a197ab!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .visual-personal-actions{display:block!important;align-content:initial!important;padding:0 18px!important;margin:0!important;border:0!important;border-left:0!important;border-radius:0!important;background:transparent!important;box-shadow:none!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-link{display:flex!important;align-items:center!important;justify-content:flex-start!important;gap:12px!important;width:100%!important;height:56px!important;min-height:56px!important;padding:10px 0!important;margin:0!important;border:0!important;border-bottom:1px solid #eee9f5!important;border-radius:0!important;background:transparent!important;font-size:13px!important;font-weight:500!important;text-align:left!important;box-shadow:none!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-link:last-child{border-bottom:0!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-link small{display:none!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-link .reference-action-icon{width:32px!important;height:32px!important;flex:0 0 32px!important;min-width:32px!important;border-radius:8px!important;background:#f3f0fc!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-link .reference-action-icon>svg.mioficio-lucide-icon{--mioficio-icon-size:19px!important;width:19px!important;height:19px!important;min-width:19px!important;max-width:19px!important;min-height:19px!important;max-height:19px!important;flex:0 0 19px!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-logout .reference-action-icon{background:#fff1f4!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-link>svg:last-child{--mioficio-icon-size:16px!important;width:16px!important;height:16px!important;min-width:16px!important;max-width:16px!important;min-height:16px!important;max-height:16px!important}
@media(max-width:1023px){
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-sheet-body{max-width:none!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-identity{padding:18px 16px!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .visual-personal-actions{padding:0 16px!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-link{height:58px!important;min-height:58px!important;font-size:14px!important}
}

/* Centered account composition: identity and actionable security settings. */
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .profile-access-heading{padding:18px 0 10px}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .profile-access-heading h3{font-size:14px!important;font-weight:600!important;line-height:1.3!important;margin:0!important;color:#211937!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .profile-access-heading p{font-size:11px!important;color:#978aab!important;line-height:1.5!important;margin:5px 0 0!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-identity small{display:none!important}
@media(min-width:1024px){
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference]>.compact-main>.compact-content:has(.personal-profile){display:flex!important;align-items:center!important;justify-content:center!important;min-height:calc(100dvh - 70px)!important;box-sizing:border-box!important;padding:28px!important;max-width:none!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile{width:100%!important;max-width:760px!important;margin:0 auto!important;display:block!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-sheet-body{max-width:none!important;display:grid!important;grid-template-columns:280px minmax(0,1fr)!important;align-items:stretch!important;padding:0!important;gap:0!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-identity{display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;text-align:center!important;gap:14px!important;padding:24px!important;border:0!important;border-right:1px solid #eee9f5!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-identity>.compact-avatar{width:64px!important;height:64px!important;min-width:64px!important;max-width:64px!important;min-height:64px!important;max-height:64px!important;flex:0 0 64px!important;font-size:24px!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-identity>div{flex:0 0 auto!important;width:100%!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-identity strong{font-size:17px!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .visual-personal-actions{padding:4px 22px 12px!important}
#mioficio-dashboard.reference-ui.banking-ui[data-layout=reference] .personal-profile .personal-link{height:54px!important;min-height:54px!important}
}
`}</style>
      <style>{ESTILO_MODELO_APROBADO}</style>
      <main className={`compact-main ${['dashboard','clientes','presupuestos'].includes(activeTab) ? 'compact-overview' : ''} flex-1 min-w-0 min-h-0 bg-[#f5f7fb] overflow-y-auto overflow-x-hidden lg:pb-0 ${activeTab === 'perfil' ? 'pb-[calc(78px+env(safe-area-inset-bottom))]' : 'pb-[78px]'}`} >
        <header className="approved-header ref-header"><div className="ref-header-inner"><div className="mobile-welcome"><p>Hola, {(user.name||'Usuario').trim().split(/\s+/)[0]}</p><small>Miembro {perfilForm.es_premium?'Premium':'Free'}</small></div><div className="ref-global-search"><label><IconoOficial nombre="search"/><input aria-label="Buscar en MiOficio" placeholder="Buscar clientes, presupuestos, cobros…" value={busquedaGeneralReferencia} onChange={e=>setBusquedaGeneralReferencia(e.target.value)} onKeyDown={e=>{if(e.key==='Escape')setBusquedaGeneralReferencia('');}}/><LimpiarBusqueda visible={Boolean(busquedaGeneralReferencia)} onLimpiar={()=>{setBusquedaGeneralReferencia('');}} etiqueta="MiOficio"/></label>{busquedaGeneralReferencia.trim()&&<div className="ref-search-results" role="region" aria-label="Resultados de búsqueda">{resultadosBusquedaReferencia.length?resultadosBusquedaReferencia.map(r=><button type="button" key={r.id} onClick={()=>{r.abrir();setBusquedaGeneralReferencia('');}}><IconoOficial nombre={r.icono}/><span><strong>{r.titulo}</strong><small>{r.detalle}</small></span><IconoOficial nombre="chevron-right"/></button>):<p>No hay resultados para esa búsqueda.</p>}<button type="button" className="ref-search-dismiss" onClick={()=>setBusquedaGeneralReferencia('')}>Cerrar búsqueda</button></div>}</div><div className="ref-header-tools"><button type="button" className="ref-help" aria-label="Abrir centro de ayuda" onClick={()=>{setMostrarAvisos(false);setMostrarAyuda(true);}}><IconoOficial nombre="circle-help"/></button>{botonAvisos()}<button type="button" className="ref-account" aria-label="Abrir cuenta de acceso" onClick={()=>setMostrarCuentaAcceso(true)}><span className="ref-avatar">{perfilForm.foto_perfil_url?<img src={perfilForm.foto_perfil_url} alt="Tu foto"/>:inicialesUsuario}</span><span className="ref-account-copy"><strong>{user.name||perfilForm.nombre}</strong><small>Miembro {perfilForm.es_premium?'Premium':'Free'}</small></span><IconoOficial nombre="chevron-down"/></button></div></div>{activeTab==='dashboard'&&vistaInicio!=='negocio'&&resumenMovilReferencia()}</header>
        <div className={`compact-content w-full min-w-0 ${activeTab === 'perfil' ? 'px-2 pt-2 pb-0 sm:px-4 lg:px-5' : 'px-3 pt-3 pb-3 sm:px-4 lg:px-5'}`}>

                    {activeTab==='menu-movil'&&<section className="compact-section-page mobile-menu-page approved-settings mobile-hub"><div className="approved-page-heading"><h1>Menú</h1><p>Tu cuenta, herramientas y ajustes.</p></div><div className="mobile-menu-card">{[{tab:'perfil',titulo:'Mi cuenta',detalle:'Foto y acceso',icono:'user-round' as const},{tab:'cobros',titulo:'Cobros',detalle:'Registrar pagos y gestionar saldos',icono:'banknote' as const},{tab:'comprobantes',titulo:'Comprobantes',detalle:'Pagos, devoluciones y trabajos',icono:'file-text' as const},{tab:'agenda',titulo:'Agenda',detalle:'Visitas y trabajos',icono:'calendar' as const},{tab:'catalogo',titulo:'Catálogo',detalle:'Tus productos y servicios',icono:'package-search' as const},{tab:'informes',titulo:'Informes',detalle:'Resultados de tu negocio',icono:'chart-no-axes-combined' as const},{tab:'herramientas',titulo:'Herramientas',detalle:'Todos los accesos Free y Premium',icono:'wrench' as const},{tab:'negocio',titulo:'Mi negocio',detalle:'Tus datos y medios de cobro.',icono:'store' as const},{tab:'menu',titulo:'Configuración',detalle:'Preferencias, avisos y seguridad',icono:'settings' as const}].filter(item=>!['agenda','catalogo','informes','herramientas'].includes(item.tab)).map(item=><button type="button" key={item.tab} onClick={()=>abrirMenuPrincipal(item.tab)}><span className="reference-menu-icon"><IconoOficial nombre={item.icono}/></span><span><strong>{item.titulo}</strong><small>{item.detalle}</small></span><IconoOficial nombre="chevron-right"/></button>)}{accesoHerramientasMembresia(true)}</div></section>}
          {activeTab==='menu'&&<section className="configuration-page"><div className="approved-page-heading"><h1>Configuración</h1><p>Preferencias, avisos y seguridad de tu cuenta.</p></div><form onSubmit={guardarConfiguracion} aria-label="Configuración de MiOficio" aria-busy={guardandoConfiguracion}><div className="configuration-autosave"><p role={resultadoConfiguracion?.tipo==='error'?'alert':'status'} aria-live="polite" className={`configuration-result ${resultadoConfiguracion?.tipo||''}`}>{cargandoNube?'Cargando tus preferencias…':guardandoConfiguracion?'Guardando cambios…':resultadoConfiguracion?.mensaje||'Guardado automático activado.'}</p><div>{resultadoConfiguracion?.tipo==='error'&&configuracionModificada&&<button type="button" disabled={guardandoConfiguracion} onClick={()=>{setConfiguracionBorrador(leerConfiguracionMiOficio(perfilForm));setResultadoConfiguracion(null);}}>Descartar cambio</button>}<button type="submit" disabled={guardandoConfiguracion||cargandoNube}><IconoOficial nombre="save"/>{guardandoConfiguracion?'Guardando…':'Guardar cambios'}</button></div></div><fieldset disabled={guardandoConfiguracion||cargandoNube} className="configuration-fields"><div className="configuration-grid"><div className="configuration-column">
            <details className="configuration-card"><summary><span className="configuration-icon"><IconoOficial nombre="sliders-horizontal"/></span><div><h2>Preferencias</h2><p>Cómo querés usar MiOficio.</p></div><IconoOficial nombre="chevron-down"/></summary><div className="configuration-card-body"><label className="configuration-toggle" htmlFor="config-ajustar-listas"><span><strong>Aprovechar el espacio de la pantalla</strong><small>Muestra más registros cuando hay espacio disponible.</small></span><input id="config-ajustar-listas" type="checkbox" checked={configuracionBorrador.ajustar_listas_pantalla} onChange={e=>cambiarConfiguracion('ajustar_listas_pantalla',e.target.checked)}/></label><div className="configuration-input-grid"><label className="configuration-full" htmlFor="config-inicio">Pantalla al ingresar<select id="config-inicio" aria-label="Pantalla al ingresar" aria-describedby="config-inicio-ayuda" value={configuracionBorrador.iniciar_en} onChange={e=>cambiarConfiguracion('iniciar_en',e.target.value as ConfiguracionMiOficio['iniciar_en'])}><option value="dashboard">Inicio</option><option value="clientes">Clientes</option><option value="presupuestos">Presupuestos</option><option value="agenda">Agenda</option><option value="herramientas">Herramientas</option></select><small id="config-inicio-ayuda">Se aplicará en tu próximo ingreso.</small></label><label className="configuration-full" htmlFor="config-periodo">Período inicial del resumen<select id="config-periodo" aria-label="Período inicial del resumen" value={configuracionBorrador.periodo_inicio} onChange={e=>cambiarConfiguracion('periodo_inicio',e.target.value as 'mes'|'anio')}><option value="mes">Este mes</option><option value="anio">Este año</option></select></label><label htmlFor="config-clientes">Clientes por página<select id="config-clientes" disabled={configuracionBorrador.ajustar_listas_pantalla} aria-label="Clientes por página" value={configuracionBorrador.clientes_por_pagina} onChange={e=>cambiarConfiguracion('clientes_por_pagina',Number(e.target.value) as ConfiguracionMiOficio['clientes_por_pagina'])}>{[2,5,10,20].map(n=><option value={n} key={n}>{n}</option>)}</select></label><label htmlFor="config-presupuestos">Presupuestos por página<select id="config-presupuestos" disabled={configuracionBorrador.ajustar_listas_pantalla} aria-label="Presupuestos por página" value={configuracionBorrador.presupuestos_por_pagina} onChange={e=>cambiarConfiguracion('presupuestos_por_pagina',Number(e.target.value) as ConfiguracionMiOficio['presupuestos_por_pagina'])}>{[3,5,10,20].map(n=><option value={n} key={n}>{n}</option>)}</select></label></div><label className="configuration-toggle" htmlFor="config-privacidad"><span><strong>Ocultar importes al ingresar</strong><small>Protegé los montos del resumen. Podés mostrarlos con el ícono del ojo.</small></span><input id="config-privacidad" type="checkbox" role="switch" checked={configuracionBorrador.ocultar_importes} onChange={e=>cambiarConfiguracion('ocultar_importes',e.target.checked)}/></label></div></details>
            <details className="configuration-card"><summary><span className="configuration-icon"><IconoOficial nombre="bell"/></span><div><h2>Notificaciones</h2><p>Avisos dentro de MiOficio.</p></div><IconoOficial nombre="chevron-down"/></summary><div className="configuration-card-body">{([{campo:'notificar_aceptados',titulo:'Presupuestos aceptados con saldo',detalle:'Recordá registrar el pago de los trabajos aceptados.'},{campo:'notificar_vencimientos',titulo:'Vencimientos de presupuestos',detalle:'Recibí avisos cuando esté por vencer su validez.'},{campo:'recordatorios_cobro',titulo:'Recordatorios de cobro',detalle:'Mostrá los avisos que programaste para cobrar un saldo.'},{campo:'revision_pendientes',titulo:'Revisión de presupuestos pendientes',detalle:'Recordá consultar si tus clientes respondieron.'}] as const).map(item=><label key={item.campo} className="configuration-toggle" htmlFor={`config-${item.campo}`}><span><strong>{item.titulo}</strong><small>{item.detalle}</small></span><input id={`config-${item.campo}`} type="checkbox" role="switch" checked={configuracionBorrador[item.campo]} onChange={e=>cambiarConfiguracion(item.campo,e.target.checked)}/></label>)}<label className="configuration-lead-time" htmlFor="config-anticipacion">Avisar antes del vencimiento<select id="config-anticipacion" aria-label="Avisar antes del vencimiento" disabled={!configuracionBorrador.notificar_vencimientos} value={configuracionBorrador.dias_vencimiento} onChange={e=>cambiarConfiguracion('dias_vencimiento',Number(e.target.value) as 1|3|7)}><option value={1}>1 día antes</option><option value={3}>3 días antes</option><option value={7}>7 días antes</option></select></label><p className="configuration-footnote">Los recordatorios de cobro programados están incluidos en Premium.</p></div></details>
            </div><div className="configuration-column"><details className="configuration-card"><summary><span className="configuration-icon"><IconoOficial nombre="shield-check"/></span><div><h2>Cuenta y seguridad</h2><p>Tu acceso a la aplicación.</p></div><IconoOficial nombre="chevron-down"/></summary><div className="configuration-card-body"><dl className="configuration-account"><div><dt>Correo de acceso</dt><dd>{user.email}</dd></div><div><dt>Inicio de sesión</dt><dd>{auth.currentUser?.providerData.some(p=>p.providerId==='google.com')?'Cuenta de Google':'Correo y contraseña'}</dd></div></dl><div className="configuration-security-actions">{auth.currentUser?.providerData.some(p=>p.providerId==='password')&&<button type="button" disabled={enviandoClave} onClick={()=>void enviarCambioClave()}><IconoOficial nombre="lock-keyhole"/>{enviandoClave?'Enviando enlace…':'Cambiar contraseña'}</button>}{auth.currentUser?.providerData.some(p=>p.providerId==='google.com')&&<a href="https://myaccount.google.com/security" target="_blank" rel="noopener noreferrer"><IconoOficial nombre="shield-check"/>Seguridad de Google</a>}<button type="button" className="configuration-signout" disabled={cerrandoSesion} onClick={onLogout}><IconoOficial nombre="log-out"/>Cerrar sesión</button></div><p className="configuration-footnote">{auth.currentUser?.providerData.some(p=>p.providerId==='google.com')?'La seguridad de tu acceso se administra desde Google.':'Para cambiar la contraseña te enviamos un enlace al correo de acceso.'}</p></div></details>
            <details className="configuration-card"><summary><span className="configuration-icon"><IconoOficial nombre="files"/></span><div><h2>Datos y privacidad</h2><p>Descargá una copia de tu información.</p></div><IconoOficial nombre="chevron-down"/></summary><div className="configuration-card-body"><div className="configuration-data-counts"><span><strong>{clientes.length}</strong> clientes</span><span><strong>{presupuestos.length}</strong> presupuestos</span></div><div className="configuration-export-actions"><button type="button" className="configuration-full-export" onClick={()=>descargarDatosConfiguracion('json')}><IconoOficial nombre="files"/><span><strong>Descargar todos mis datos</strong><small>Perfil, clientes y presupuestos · JSON</small></span><IconoOficial nombre="chevron-right"/></button><button type="button" onClick={()=>descargarDatosConfiguracion('clientes')}><IconoOficial nombre="users"/>Clientes · CSV</button><button type="button" onClick={()=>descargarDatosConfiguracion('presupuestos')}><IconoOficial nombre="file-text"/>Presupuestos · CSV</button></div><p className="configuration-footnote">Los archivos se guardan en tu dispositivo. Los CSV se pueden abrir en una planilla de cálculo.</p></div></details>
            <details className="configuration-card configuration-support"><summary><span className="configuration-icon"><IconoOficial nombre="message-circle"/></span><div><h2>Ayuda y soporte</h2><p>Consultas, problemas y sugerencias.</p></div><IconoOficial nombre="chevron-down"/></summary><div className="configuration-card-body"><div><strong>contacto@mioficio.com.ar</strong><p>Contanos qué necesitás o qué te gustaría mejorar.</p></div><div className="configuration-support-actions"><a href="mailto:contacto@mioficio.com.ar?subject=Soporte%20MiOficio"><IconoOficial nombre="mail"/>Contactar soporte</a><a href="mailto:contacto@mioficio.com.ar?subject=Sugerencia%20para%20MiOficio"><IconoOficial nombre="message-circle"/>Enviar sugerencia</a></div><small>Se abre tu aplicación de correo electrónico.</small></div></details>
          </div></div></fieldset></form></section>}
{activeTab==='herramientas'&&<section className="tools-library" aria-labelledby="tools-library-title"><div className="approved-page-heading"><h1 id="tools-library-title">Herramientas</h1><p>Todas las herramientas de tu membresía, en un solo lugar.</p></div><div className="tools-library-toolbar"><div className="tools-plan-filters" role="group" aria-label="Filtrar herramientas por plan">{([{id:'todas',label:'Todas'},{id:'free',label:'Free'},{id:'premium',label:'Premium'}] as const).map(f=><button key={f.id} type="button" aria-pressed={filtroHerramientas===f.id} onClick={()=>setFiltroHerramientas(f.id)}>{f.label}<span>{herramientasCentro.filter(h=>f.id==='todas'||h.plan===f.id).length}</span></button>)}</div><label className="tools-library-search"><IconoBusqueda/><input aria-label="Buscar herramienta" placeholder="Buscar herramienta" value={busquedaHerramientas} onChange={e=>setBusquedaHerramientas(e.target.value)} onKeyDown={e=>{if(e.key==='Escape'&&busquedaHerramientas){e.preventDefault();e.stopPropagation();setBusquedaHerramientas('');}}}/><LimpiarBusqueda visible={Boolean(busquedaHerramientas)} onLimpiar={()=>{setBusquedaHerramientas('');}} etiqueta="herramientas"/></label></div><div className="tools-library-grid">{herramientasVisibles().map(h=>{const bloqueada=h.plan==='premium'&&perfilForm.es_premium!==true;return <button key={h.id} type="button" className="tools-library-card" aria-label={bloqueada?`Ver Premium: ${h.titulo}`:`Abrir ${h.titulo.toLocaleLowerCase('es')}`} onClick={()=>bloqueada?activarPremium():h.abrir()}><div className="tools-library-card-top"><span className="tools-library-icon"><IconoOficial nombre={h.icono}/></span><span className={`tools-library-plan ${h.plan}`}>{h.plan==='premium'&&<IconoOficial nombre="crown"/>}{h.plan==='premium'?'Premium':'Free'}</span></div><div className="tools-library-copy"><h2>{h.titulo}</h2><p>{h.detalle}</p></div><div className="tools-library-card-bottom"><small>{bloqueada?'Disponible con Premium':h.meta()}</small><IconoOficial nombre={bloqueada?'lock-keyhole':'arrow-right'}/></div></button>;})}</div>{!herramientasVisibles().length&&<div className="tools-library-empty" role="status"><IconoOficial nombre="search"/><strong>No encontramos esa herramienta</strong><p>Probá otro nombre o cambiá el filtro.</p><button type="button" onClick={()=>{setBusquedaHerramientas('');setFiltroHerramientas('todas');}}>Mostrar todas</button></div>}</section>}
          {activeTab === 'agenda' && panelAgenda()}
          {activeTab === 'premium' && panelPremiumVisual()}
          {activeTab === 'catalogo' && panelCatalogoVisual()}
                    {activeTab==='comprobantes'&&centroComprobantes()}
                    {activeTab==='cobros'&&<section className="ref-section"><div className="approved-page-heading"><h1>Cobros</h1><p>Registrá pagos, consultá saldos y gestioná devoluciones.</p></div>{gestionCobros()}</section>}
          {activeTab==='informes'&&<section className="ref-section">{perfilForm.es_premium?informeNegocioInicio():<div className="ref-panel ref-locked"><IconoOficial nombre="chart-no-axes-combined"/><h1>Informe del negocio</h1><p>Analizá ingresos, aceptación de presupuestos y servicios contratados.</p><button type="button" className="approved-primary" onClick={activarPremium}>Conocer Premium</button></div>}</section>}
          {activeTab==='dashboard'&&<div className="ref-home">{vistaInicio==='negocio'?informeNegocioInicio():<><div className="ref-home-heading"><div><h1>Hola, {(user.name||'Usuario').trim().split(/\s+/)[0]}</h1><p>Este es el resumen de tu negocio.</p></div><div className="ref-home-right"><div className="ref-home-filters">{selectorPeriodoReferencia()}<label className="ref-month"><IconoOficial nombre="calendar"/><span>{new Date(mesResumenReferencia+'-02T12:00:00Z').toLocaleDateString('es-AR',{month:'long',year:'numeric',timeZone:'UTC'})}</span><input type="month" aria-label="Mes del resumen" value={mesResumenReferencia} onChange={e=>{if(e.target.value){setMesResumenReferencia(e.target.value);setPeriodoInicioModelo('mes');}}}/></label></div><div className="ref-home-actions" aria-label="Accesos rápidos"><button type="button" className="approved-primary" onClick={abrirNuevoPresupuestoInicio}><IconoOficial nombre="circle-plus"/>Nuevo presupuesto</button><button type="button" className="approved-outline" onClick={abrirNuevoCliente}><IconoOficial nombre="user-round"/>Nuevo cliente</button></div>
          </div></div>{pestanaInicioModelo==='actividad'?<section className="ref-panel"><div className="ref-panel-heading"><h2>Actividad reciente</h2><button type="button" onClick={()=>setPestanaInicioModelo('resumen')}>Volver al resumen<IconoOficial nombre="arrow-right"/></button></div>{filasReferencia(30)}</section>:<>
          <nav className="m78-actions" aria-label="Accesos rápidos del celular"><button type="button" onClick={()=>abrirMenuPrincipal('cobros')}><span><IconoOficial nombre="banknote"/></span>Registrar pago</button><button type="button" onClick={()=>abrirMenuPrincipal('comprobantes')}><span><IconoOficial nombre="file-text"/></span>Comprobantes</button><button type="button" onClick={abrirNuevoCliente}><span><IconoOficial nombre="user-round"/></span>Nuevo cliente</button></nav>
          <div className="ref-metrics"><section className="ref-metric ref-cash"><div className="ref-metric-icon green"><IconoOficial nombre="banknote"/></div><div className="ref-cash-title"><span>Cobros registrados</span><button type="button" aria-label={ocultarMontosInicio?'Mostrar importes':'Ocultar importes'} onClick={()=>setOcultarMontosInicio(v=>!v)}><IconoOficial nombre={ocultarMontosInicio?'eye':'eye'}/></button></div><ImporteAdaptable>{montoReferencia(cobradoInicioModelo)}</ImporteAdaptable><div className="ref-comparison">{comparacionReferencia!==null?<><span className={comparacionReferencia>=0?'positive':'negative'}><IconoOficial nombre={comparacionReferencia>=0?'arrow-up-right':'arrow-up-right'}/>{Math.abs(comparacionReferencia).toLocaleString('es-AR',{maximumFractionDigits:1})}%</span><small>vs. {periodoInicioModelo==='anio'?'año':'mes'} anterior</small></>:<small>Pagos menos devoluciones · {monedaCobrado}</small>}</div></section><div className="ref-small-metrics"><button type="button" className="ref-metric" onClick={()=>abrirMenuPrincipal('presupuestos')}><span className="ref-metric-icon violet"><IconoOficial nombre="file-text"/></span><span className="ref-desktop-label">Presupuestos</span><strong>{presupuestosPeriodoModelo.length}</strong><small><span className="ref-only-mobile">Presupuestos</span><span className="ref-only-desktop">{periodoInicioModelo==='mes'?'Este mes':periodoInicioModelo==='anio'?'Este año':'Período elegido'}</span></small></button><button type="button" className="ref-metric ref-pending-metric" onClick={()=>abrirMenuPrincipal('cobros')}><span className="ref-metric-icon orange"><IconoOficial nombre="clock"/></span><span className="ref-desktop-label">Pendientes de cobro</span><strong data-long-amount={montoReferencia(pendienteInicioModelo).length>14}><span className="ref-only-desktop">{montoReferencia(pendienteInicioModelo)}</span><span className="ref-only-mobile">{pendientesPeriodoModelo.length}</span></strong><small><span className="ref-only-desktop">{pendientesPeriodoModelo.length} {pendientesPeriodoModelo.length===1?'presupuesto':'presupuestos'}</span><span className="ref-only-mobile">Pendientes</span></small></button><button type="button" className="ref-metric ref-clients-metric" onClick={()=>abrirMenuPrincipal('clientes')}><span className="ref-metric-icon blue"><IconoOficial nombre="users"/></span><span className="ref-desktop-label">Clientes activos</span><strong>{clientes.length}</strong><small><span className="ref-only-mobile">Clientes</span><span className="ref-only-desktop">Total</span></small></button></div></div>
          <section className="ref-panel ref-mobile-activity"><div className="ref-panel-heading"><h2>Actividad reciente</h2><button type="button" onClick={()=>setPestanaInicioModelo('actividad')}>Ver todos<IconoOficial nombre="arrow-right"/></button></div>{filasReferencia(capacidadPantalla.actividad)}</section>
          <div className="ref-desktop-grid"><section className="ref-panel ref-evolution"><div className="ref-panel-heading"><h2><IconoOficial nombre="chart-no-axes-combined"/>Evolución de cobros</h2><small>{monedaCobrado} · {periodoInicioModelo==='mes'?'Este mes':periodoInicioModelo==='anio'?'Este año':'Período elegido'}</small></div>{ocultarMontosInicio?<p className="ref-empty">Importes ocultos</p>:graficoCobrosModelo.length?<div className="ref-chart"><div className="ref-chart-axis">{[0,.25,.5,.75,1].map(n=><span key={n}>{etiquetaEjeImporte(maximoGraficoCobrosModelo-amplitudGraficoCobrosModelo*n)}</span>)}</div><div className="ref-chart-plot">{graficoCobrosModelo.map(c=><button type="button" key={c.fecha} title={`${fechaCortaCompacta(c.fecha)}: ${importeDocumento(c.importe,monedaCobrado)}`} onClick={()=>{abrirMenuPrincipal('cobros');setBusquedaCobros('');}}><span className="ref-chart-track"><span className="ref-chart-zero" style={{top:`${maximoGraficoCobrosModelo/amplitudGraficoCobrosModelo*100}%`}}/><span className="ref-chart-bar" data-negative={c.importe<0} style={{position:'absolute',top:`${(maximoGraficoCobrosModelo-Math.max(0,c.importe))/amplitudGraficoCobrosModelo*100}%`,height:`${Math.abs(c.importe)/amplitudGraficoCobrosModelo*100}%`}}><b>{formatearMontoCompacto(c.importe)}</b></span></span><small>{c.fecha.slice(8)}/{c.fecha.slice(5,7)}</small></button>)}</div></div>:<div className="ref-empty"><IconoOficial nombre="chart-no-axes-combined"/><p>No hay variaciones de cobros en este período.</p></div>}</section><section className="ref-panel ref-upcoming"><div className="ref-panel-heading"><h2><IconoOficial nombre="calendar"/>Próximos vencimientos</h2><button type="button" onClick={()=>{setMostrarAvisos(true);setMostrarAyuda(false);}}>Ver todos<IconoOficial nombre="arrow-right"/></button></div>{proximosReferencia.length?proximosReferencia.slice(0,3).map(v=><button className="ref-event-row" type="button" key={v.id} onClick={v.abrir}><span className={`ref-round ${v.agenda?'violet':'orange'}`}><IconoOficial nombre={v.agenda?'calendar':'clock'}/></span><span className="ref-row-copy"><strong>{v.titulo}</strong><small>{v.detalle}</small></span><span className="ref-row-end"><small>{v.fecha.slice(8)}/{v.fecha.slice(5,7)}</small>{v.importe!==null&&<b>{montoReferencia(v.importe)}</b>}</span><IconoOficial nombre="chevron-right"/></button>):<div className="ref-empty"><IconoOficial nombre="calendar"/><p>No tenés vencimientos ni visitas en los próximos 7 días.</p></div>}</section>
          <section className="ref-panel ref-quotes"><div className="ref-panel-heading"><h2><IconoOficial nombre="file-text"/>Últimos presupuestos</h2><button type="button" onClick={()=>abrirMenuPrincipal('presupuestos')}>Ver todos<IconoOficial nombre="arrow-right"/></button></div><div className="ref-table-scroll"><table><thead><tr><th scope="col">Presupuesto / cliente</th><th scope="col">Fecha</th><th scope="col">Importe</th><th scope="col" title="Estado del presupuesto">Estado</th><th scope="col" title="Estado del pago">Pago</th></tr></thead><tbody>{presupuestosRecientesCompletos.slice(0,4).map(p=><tr key={p.presupuesto_id}><td><button type="button" aria-label={`Abrir detalle ${p.numero_presupuesto}`} onClick={()=>abrirDetallePresupuesto(p)}>{p.numero_presupuesto}</button><span className="dashboard-table-client">{p.cliente}</span></td><td>{fechaCortaCompacta(p.fecha)}</td><td className="ref-money">{ocultarMontosInicio?'••••••':importeFilaCompacta(p)}</td><td><span className={`approved-badge ${estadoComercialVisible(p).toLowerCase()}`}>{estadoComercialVisible(p)}</span></td><td><span className="dashboard-payment-state" data-payment={situacionPagoVisible(p)}>{situacionPagoVisible(p)}</span></td></tr>)}</tbody></table></div>{!presupuestos.length&&<p className="ref-empty">Creá tu primer presupuesto para comenzar.</p>}</section><section className="ref-panel ref-recent-collections"><div className="ref-panel-heading"><h2><IconoOficial nombre="banknote"/>Movimientos recientes</h2><button type="button" onClick={()=>setPestanaInicioModelo('actividad')}>Ver todos<IconoOficial nombre="arrow-right"/></button></div>{filasReferencia(3,true)}</section></div>
          <button type="button" className="ref-mobile-pending ref-panel" onClick={()=>abrirMenuPrincipal('cobros')}><span className="ref-round orange"><IconoOficial nombre="clock"/></span><span><span>Saldo pendiente de cobro</span><strong data-long-amount={montoReferencia(pendienteInicioModelo).length>14}>{montoReferencia(pendienteInicioModelo)} <small>{pendientesPeriodoModelo.length} {pendientesPeriodoModelo.length===1?'presupuesto':'presupuestos'}</small></strong></span><IconoOficial nombre="chevron-right"/></button>
</> }</>}</div>}

          {activeTab==='presupuestos'&&<div className="approved-page-heading"><h1>Presupuestos</h1><p>Creá y consultá los presupuestos de tus clientes.</p></div>}
          {activeTab === 'presupuestos' && <section className="approved-quotes" id="budget-list-panel"><div className="approved-toolbar"><label className="approved-search"><IconoBusqueda/><input aria-label="Buscar presupuesto" placeholder="Cliente, número o concepto" value={busquedaPresupuesto} onChange={e=>{setBusquedaPresupuesto(e.target.value);setPaginaPresupuestos(1);}} onKeyDown={e=>{if(e.key==='Escape'&&busquedaPresupuesto){e.preventDefault();e.stopPropagation();setBusquedaPresupuesto('');setPaginaPresupuestos(1);}}}/><LimpiarBusqueda visible={Boolean(busquedaPresupuesto)} onLimpiar={()=>{setBusquedaPresupuesto('');setPaginaPresupuestos(1);}} etiqueta="presupuestos"/></label><button type="button" className="approved-primary approved-desktop" onClick={abrirNuevoPresupuestoInicio}><IconoPanel name="plus"/>Nuevo presupuesto</button></div><div className="approved-filters" aria-label="Filtrar por estado">{[{key:'Todos',label:'Todos'},{key:'Emitido',label:'Emitidos'},{key:'Aceptado',label:'Aceptados'},{key:'Pagado',label:'Pagados'},{key:'Borrador',label:'Borradores'},...(presupuestos.some(p=>p.estado==='Cancelado')?[{key:'Cancelado',label:'Cancelados'}]:[])].map(f=><button type="button" key={f.key} aria-pressed={filtroEstadoPresupuesto===f.key} onClick={()=>{setFiltroEstadoPresupuesto(f.key);setPaginaPresupuestos(1);}}>{f.label}<span>{presupuestos.filter(p=>f.key==='Todos'||p.estado===f.key).length}</span></button>)}</div>{filtroEstadoPresupuesto==='Por vencer'&&<div className="approved-context">Presupuestos por vencer<button type="button" className="approved-icon" aria-label="Quitar filtro por vencer" onClick={()=>setFiltroEstadoPresupuesto('Todos')}><IconoOficial nombre="x"/></button></div>}
            {confirmarBorradoMultiple && <section className="approved-card" role="alertdialog" aria-label="Confirmar eliminación"><h2>¿Eliminar {presupuestosMarcados.length} presupuestos?</h2><p>Se eliminarán los documentos seleccionados y sus comprobantes de trabajo. Esta acción no se puede deshacer.</p><div className="approved-inline"><button type="button" className="approved-outline" disabled={borrandoPresupuestos} onClick={()=>setConfirmarBorradoMultiple(false)}>Cancelar</button><button type="button" className="approved-primary" disabled={borrandoPresupuestos} onClick={borrarPresupuestosMarcados}>{borrandoPresupuestos?'Eliminando…':'Sí, eliminar'}</button></div></section>}
            <section className="approved-card approved-desktop approved-table-scroll"><table className="approved-table"><thead><tr><th>Nº</th><th>Cliente</th><th>Concepto</th><th>Fecha</th><th>Importe</th><th>Estado / pago</th></tr></thead><tbody>{presupuestosPaginaCompacta.map(p=><tr key={p.presupuesto_id} className="approved-budget-row" onClick={e=>{if(e.target instanceof Element && e.target.closest('button,input,select,label'))return;abrirDetallePresupuesto(p);}}><td>{modoSeleccionModelo&&seleccionPresupuesto(p)} <button type="button" className="approved-text" aria-label={`Abrir detalle ${p.numero_presupuesto}`} onClick={()=>abrirDetallePresupuesto(p)}>{p.numero_presupuesto}</button></td><td>{p.cliente||'Sin cliente'}</td><td>{p.items?.[0]?.descripcion||'Presupuesto'}</td><td>{fechaCortaCompacta(p.fecha)}</td><td className="approved-amount">{importeFilaCompacta(p)}</td><td><span className={`approved-status-selector ${p.estado?.toLowerCase()}`}><SelectorEstadoPresupuesto estado={p.estado||'Emitido'} etiqueta={estadoPagoVisible(p)} onChange={estado=>cambiarEstadoPresupuesto(p.presupuesto_id,estado)}/></span></td></tr>)}</tbody></table></section>
            <div className="approved-mobile approved-quote-list">{presupuestosPaginaCompacta.map(p=><article className="approved-card approved-quote-card" key={p.presupuesto_id}><div className="approved-quote-top"><span className="approved-circle"><IconoPanel name="quotes"/></span><div className="approved-quote-copy"><small>{p.numero_presupuesto}</small><h2>{p.cliente||'Sin cliente'}</h2></div><div className="approved-quote-value"><span className={`approved-status-selector ${p.estado?.toLowerCase()}`}><SelectorEstadoPresupuesto estado={p.estado||'Emitido'} etiqueta={estadoPagoVisible(p)} onChange={estado=>cambiarEstadoPresupuesto(p.presupuesto_id,estado)}/></span><strong>{importeFilaCompacta(p)}</strong></div></div><div className="approved-quote-info"><p><IconoOficial nombre="clipboard-list"/>{p.items?.[0]?.descripcion||'Presupuesto'}</p><p><IconoOficial nombre="calendar"/>{fechaCortaCompacta(p.fecha)}</p></div><div className="approved-quote-actions"><button type="button" className="approved-soft" aria-label={`Abrir detalle ${p.numero_presupuesto}`} onClick={()=>abrirDetallePresupuesto(p)}>Ver detalle <IconoOficial nombre="chevron-right"/></button>{modoSeleccionModelo&&<label className="approved-quote-select">{seleccionPresupuesto(p)}Seleccionar</label>}</div></article>)}</div>{!presupuestosPaginaCompacta.length&&<section className="approved-card"><p className="approved-empty" role="status">{presupuestos.length===0?'Todavía no tenés presupuestos. Creá el primero para empezar a organizar tus trabajos.':'No hay presupuestos que coincidan con la búsqueda o el estado seleccionado.'}</p>{presupuestos.length>0&&(busquedaPresupuesto||filtroEstadoPresupuesto!=='Todos')&&<button type="button" className="ui-reset-filters" onClick={()=>{setBusquedaPresupuesto('');setFiltroEstadoPresupuesto('Todos');setPaginaPresupuestos(1);}}>Limpiar filtros</button>}</section>}
            <div className="approved-quote-tools"><button type="button" className="approved-card approved-consolidate" onClick={()=>{if(!perfilForm.es_premium){activarPremium();return;}setClienteHerramientaPremium('');setBusquedaClienteConsolidado('');setSelectorConsolidadoModelo(true);}}><span className="approved-circle"><IconoOficial nombre="files"/></span><span><strong>Consolidar en PDF <span className="approved-premium inline"><IconoOficial nombre="crown"/>Premium</span></strong><small>Seleccioná presupuestos de un cliente y generá un único PDF.</small></span><IconoOficial nombre="chevron-right"/></button>
            <details className="compact-bulk" onToggle={e=>{const abierto=e.currentTarget.open;setModoSeleccionModelo(abierto);if(!abierto)setPresupuestosMarcados([]);}}><summary>Selección múltiple <span>{presupuestosMarcados.length>0?`${presupuestosMarcados.length} seleccionados`:''}</span><IconoOficial nombre="chevron-down"/></summary><div><button type="button" disabled={borrandoPresupuestos||!presupuestosFiltradosCompactos.length} onClick={()=>setPresupuestosMarcados(presupuestosFiltradosCompactos.map(p=>p.presupuesto_id))} aria-label="Seleccionar todos los resultados">Todos</button><button type="button" disabled={borrandoPresupuestos||!presupuestosMarcados.length} onClick={()=>setPresupuestosMarcados([])} aria-label="Limpiar selección">Limpiar</button><button type="button" disabled={borrandoPresupuestos||!presupuestosMarcados.length} onClick={()=>setConfirmarBorradoMultiple(true)} aria-label="Eliminar presupuestos seleccionados">Eliminar</button></div></details></div>{paginacionCompacta(paginaPresupuestosCompacta,totalPaginasPresupuestosCompactos,presupuestosFiltradosCompactos.length,setPaginaPresupuestos)}
          </section>}
          {activeTab === 'clientes' && <section className="approved-clients"><div className="approved-page-heading"><h1>Clientes</h1><p>Gestioná tus clientes y seguí todos tus trabajos.</p></div><div className="approved-toolbar"><label className="approved-search"><IconoBusqueda/><input aria-label="Buscar cliente por nombre, CUIT o DNI" placeholder="Nombre, CUIT o DNI" value={busquedaCliente} onChange={e=>{setBusquedaCliente(e.target.value);setPaginaClientes(1);}} onKeyDown={e=>{if(e.key==='Escape'&&busquedaCliente){e.preventDefault();e.stopPropagation();setBusquedaCliente('');setPaginaClientes(1);}}}/><LimpiarBusqueda visible={Boolean(busquedaCliente)} onLimpiar={()=>{setBusquedaCliente('');setPaginaClientes(1);}} etiqueta="clientes"/></label><button type="button" className="approved-primary" onClick={abrirNuevoCliente}><IconoPanel name="plus"/>Nuevo cliente</button></div><div className="approved-list-meta"><span>{clientesFiltrados.length} clientes</span><label>Ordenar por: <select aria-label="Orden de clientes" value={ordenClientesModelo} onChange={e=>{setOrdenClientesModelo(e.target.value as 'recientes'|'nombre');setPaginaClientes(1);}}><option value="recientes">Más recientes</option><option value="nombre">Nombre</option></select></label></div><div className="approved-client-layout"><div><div className="approved-client-list">{clientesPagina.map(c=><article key={c.cliente_id} className="approved-card approved-client-card"><span className="approved-avatar">{(c.nombre_razon_social||'C').trim().split(/\s+/).slice(0,2).map(v=>v[0]).join('').toUpperCase()}</span><div className="approved-client-copy"><h2>{c.nombre_razon_social}</h2><p><IconoOficial nombre="phone"/>{c.telefono||'Sin teléfono'}</p><p><IconoPanel name="quotes"/>{presupuestos.filter(p=>p.cliente.trim().toLowerCase()===c.nombre_razon_social.trim().toLowerCase()).length} {presupuestos.filter(p=>p.cliente.trim().toLowerCase()===c.nombre_razon_social.trim().toLowerCase()).length===1?'presupuesto':'presupuestos'}</p></div><div className="approved-client-actions"><button type="button" className="approved-soft" aria-label={`Abrir ficha de ${c.nombre_razon_social}`} onClick={()=>setFichaClienteModelo(c.cliente_id)}>Ver ficha <IconoOficial nombre="chevron-right"/></button></div></article>)}</div>{!clientesPagina.length&&<section className="approved-card"><p className="approved-empty" role="status">{busquedaCliente?'No hay clientes que coincidan.':'Agregá tu primer cliente para comenzar.'}</p></section>}{paginacionCompacta(paginaClientesActual,totalPaginasClientes,clientesFiltrados.length,setPaginaClientes)}</div>{clienteFichaModelo&&<section className="approved-card approved-client-detail"><div className="approved-card-heading"><h2><IconoPanel name="profile"/>Ficha del cliente</h2><button type="button" className="approved-icon" aria-label="Cerrar ficha del cliente" onClick={()=>setFichaClienteModelo(null)}><IconoOficial nombre="x"/></button></div><div className="approved-client-file-actions"><button type="button" className="approved-soft" onClick={()=>abrirEditorCliente(clienteFichaModelo)}><IconoOficial nombre="square-pen"/>Editar cliente</button><button type="button" className="approved-icon" aria-label={`Eliminar ${clienteFichaModelo.nombre_razon_social}`} onClick={()=>eliminarCliente(clienteFichaModelo.cliente_id,clienteFichaModelo.nombre_razon_social)}><IconoOficial nombre="trash-2"/></button></div><div className="approved-detail-box">{[['Nombre / empresa',clienteFichaModelo.nombre_razon_social],['CUIT / DNI',clienteFichaModelo.cuit_cuil],['Teléfono / WhatsApp',clienteFichaModelo.telefono],['Correo electrónico',clienteFichaModelo.email],['Domicilio',clienteFichaModelo.direccion]].map(([label,value])=><div className="approved-detail-row" key={label}><span>{label}</span><strong>{value||'Sin completar'}</strong></div>)}<button type="button" className="approved-soft approved-wide" onClick={()=>abrirFichaClienteCompacta(clienteFichaModelo,true)}><IconoPanel name="quotes"/>Historial de presupuestos<IconoOficial nombre="chevron-right"/></button></div></section>}</div></section>}

      {/* PERFIL PROFESIONAL — mismo estilo visual del generador */}
      {activeTab === 'negocio' && <section id="perfil-profesional" className="business-workspace">
        <div className="visual-page-heading visual-desktop"><IconoPanel name="settings"/><div><h2>Mi negocio</h2><p>Tus datos y medios de cobro.</p></div></div>
        <div className="business-tabs" role="tablist" aria-label="Configuración de Mi negocio" onKeyDown={e=>{const tabs=['datos','cobros'] as const;const i=tabs.indexOf(vistaNegocio);const n=e.key==='ArrowRight'?(i+1)%tabs.length:e.key==='ArrowLeft'?(i+tabs.length-1)%tabs.length:e.key==='Home'?0:e.key==='End'?tabs.length-1:-1;if(n<0)return;e.preventDefault();setVistaNegocio(tabs[n]);e.currentTarget.querySelector<HTMLButtonElement>(`#negocio-tab-${tabs[n]}`)?.focus();}}>{([{id:'datos',label:'Datos'},{id:'cobros',label:'Cobros'}] as const).map(tab=><button key={tab.id} type="button" role="tab" id={`negocio-tab-${tab.id}`} aria-selected={vistaNegocio===tab.id} tabIndex={vistaNegocio===tab.id?0:-1} aria-controls={`negocio-panel-${tab.id}`} onClick={()=>setVistaNegocio(tab.id)}>{tab.label}</button>)}</div>
        <form className="business-form" onSubmit={guardarPerfilManual} aria-busy={guardandoNegocio}>
          {vistaNegocio==='datos' && <div className="business-columns business-data-layout" role="tabpanel" id="negocio-panel-datos" aria-labelledby="negocio-tab-datos">

            <section className="business-surface"><div className="business-section-heading"><IconoOficial nombre="user-round"/><h3>Datos del negocio</h3></div><div className="business-fields">
              <label className="business-full" htmlFor="perfil-nombre_comercial">Nombre comercial<input id="perfil-nombre_comercial" maxLength={80} value={perfilForm.nombre_comercial || ''} onChange={e=>setPerfilForm({...perfilForm,nombre_comercial:e.target.value.slice(0,80)})} placeholder="Ej.: Servicios Ríos" /></label>
              <label className="business-full" htmlFor="negocio-rubro">Rubro<button id="negocio-rubro" type="button" className="business-select" aria-haspopup="dialog" aria-expanded={showSelectorRubros} onClick={()=>{setShowSelectorRubros(true);setBusquedaRubro('');const actividad=perfilForm.actividades_economicas?.[0];setRubrosSeleccionados(actividad?[actividad]:perfilForm.oficio_rubro?[{codigo:'',nombre:perfilForm.oficio_rubro.split(' · ')[0],tipo:'oficio' as const}]:[]);}}><span>{perfilForm.actividades_economicas?.[0]?.nombre || perfilForm.oficio_rubro?.split(' · ')[0] || 'Seleccionar rubro'}</span><IconoOficial nombre="chevron-down"/></button></label>
              <label className="business-full" htmlFor="perfil-nombre">Razón social<input id="perfil-nombre" maxLength={80} value={perfilForm.nombre || ''} onChange={e=>setPerfilForm({...perfilForm,nombre:e.target.value.slice(0,80)})} placeholder="Nombre del profesional o empresa" /></label>
              <label htmlFor="perfil-cuit_cuil">CUIT / CUIL<input id="perfil-cuit_cuil" maxLength={20} inputMode="numeric" value={perfilForm.cuit_cuil || ''} onChange={e=>setPerfilForm({...perfilForm,cuit_cuil:e.target.value.slice(0,20)})} placeholder="CUIT / CUIL / DNI" /></label>
              <label htmlFor="perfil-iva">Condición fiscal<select id="perfil-iva" value={perfilForm.condicion_iva || ''} onChange={e=>setPerfilForm({...perfilForm,condicion_iva:e.target.value})}><option value="">Seleccionar</option>{['Monotributista','Responsable Inscripto','Exento','Consumidor Final'].map(v=><option key={v}>{v}</option>)}</select></label>
              
            </div></section>
            <section className="business-surface"><div className="business-section-heading"><IconoOficial nombre="phone"/><h3>Contacto</h3></div><div className="business-fields">
              <label className="business-full" htmlFor="perfil-telefono">Teléfono / WhatsApp<input id="perfil-telefono" type="tel" maxLength={30} value={perfilForm.telefono || ''} onChange={e=>setPerfilForm({...perfilForm,telefono:e.target.value.slice(0,30)})} placeholder="Ej.: +54 9 342 123-4567" /></label>
              <label className="business-full" htmlFor="perfil-email">Correo electrónico<input id="perfil-email" type="email" maxLength={100} value={perfilForm.email || ''} onChange={e=>setPerfilForm({...perfilForm,email:e.target.value.slice(0,100)})} placeholder="Email de contacto del negocio" /></label>
              <label className="business-full" htmlFor="perfil-direccion">Domicilio comercial<input id="perfil-direccion" maxLength={100} value={perfilForm.direccion || ''} onChange={e=>setPerfilForm({...perfilForm,direccion:e.target.value.slice(0,100)})} placeholder="Calle, número, localidad y provincia" /></label>
            </div><p className="business-footnote">Estos datos identifican a tu negocio en los presupuestos.</p></section>
<div className="approved-brand-column"><section className="business-surface approved-business-logo"><span className="approved-logo">{perfilForm.es_premium&&perfilForm.logo_url?<img src={perfilForm.logo_url} alt="Logo profesional"/>:<img src={MIOFICIO_LOGO_PERMANENTE} alt="Logo oficial de MiOficio"/>}</span><div><h3>Logo profesional <span className="business-logo-premium">Premium</span></h3><p>{perfilForm.es_premium===true?'Subí tu logo para que aparezca en tus documentos.':'Tus documentos llevan el logo de MiOficio. Personalizalo con Premium.'}</p><button type="button" className="approved-soft" onClick={()=>perfilForm.es_premium?setShowModalIdentidad(true):activarPremium()}><IconoOficial nombre="image"/>{perfilForm.es_premium===true?(perfilForm.logo_url?'Cambiar logo':'Subir imagen'):'Ver Premium'}</button><div className="approved-header-preview-card"><details className="approved-business-preview"><summary><IconoOficial nombre="eye"/>Vista previa del encabezado<IconoOficial nombre="chevron-down"/></summary><section className="approved-card"><div className="approved-document-heading"><span className="approved-logo">{perfilForm.es_premium&&perfilForm.logo_url?<img src={perfilForm.logo_url} alt="Logo en presupuesto"/>:<img src={MIOFICIO_LOGO_PERMANENTE} alt="Logo oficial de MiOficio"/>}</span><div><strong>{perfilForm.nombre_comercial||perfilForm.nombre||'Nombre comercial'}</strong><small>{perfilForm.oficio_rubro}</small><small>{perfilForm.nombre}</small></div><div><small>{perfilForm.direccion||'Domicilio comercial'}</small><small>{perfilForm.telefono||'Teléfono'}</small><small>{perfilForm.email||'Correo electrónico'}</small></div></div></section></details></div></div></section></div>
          </div>}
          {vistaNegocio==='cobros' && <section className="business-surface business-payment-page" role="tabpanel" id="negocio-panel-cobros" aria-labelledby="negocio-tab-cobros"><div className="business-surface approved-payment-methods"><div className="business-section-heading"><IconoOficial nombre="banknote"/><h3>Medios de cobro</h3></div>
            <div className="business-payment-options">{([{campo:'acepta_efectivo',nombre:'Efectivo'},{campo:'acepta_cheque',nombre:'Cheque'},{campo:'acepta_transferencia',nombre:'Transferencia'}] as const).map(m=><label key={m.campo}><input type="checkbox" checked={!!perfilForm[m.campo]} onChange={e=>setPerfilForm({...perfilForm,[m.campo]:e.target.checked})}/><IconoMedioPago tipo={m.campo}/><span>{m.nombre}</span></label>)}</div></div>
            {perfilForm.acepta_transferencia && <div className="business-bank business-surface"><h4>Cuenta para transferencias</h4><div className="business-fields">
              <label htmlFor="perfil-banco_pasarela">Banco / billetera<input id="perfil-banco_pasarela" maxLength={60} value={perfilForm.banco_pasarela || ''} onChange={e=>setPerfilForm({...perfilForm,banco_pasarela:e.target.value.slice(0,60)})} placeholder="Nombre del banco o billetera" /></label>
              <label htmlFor="perfil-titular_cuenta">Titular de la cuenta<input id="perfil-titular_cuenta" maxLength={80} value={perfilForm.titular_cuenta || ''} onChange={e=>setPerfilForm({...perfilForm,titular_cuenta:e.target.value.slice(0,80)})} placeholder="Nombre completo / razón social" /></label>
              <label htmlFor="perfil-alias">Alias<input id="perfil-alias" maxLength={60} value={/^\d{22}$/.test((perfilForm.cbu_alias || '').trim())?'':perfilForm.cbu_alias || ''} onChange={e=>setPerfilForm({...perfilForm,cbu_alias:e.target.value.slice(0,60),cbu_cvu:perfilForm.cbu_cvu || (/^\d{22}$/.test((perfilForm.cbu_alias || '').trim())?perfilForm.cbu_alias:'')})} placeholder="Alias de tu cuenta" /></label>
              <label htmlFor="perfil-cbu">CBU / CVU<input id="perfil-cbu" inputMode="numeric" maxLength={22} value={perfilForm.cbu_cvu || (/^\d{22}$/.test((perfilForm.cbu_alias || '').trim())?perfilForm.cbu_alias:'') || ''} onChange={e=>setPerfilForm({...perfilForm,cbu_cvu:e.target.value.replace(/\D/g,'').slice(0,22)})} placeholder="22 dígitos" /></label>
            </div></div>}
          </section>}
          <footer className="approved-business-footer"><button type="submit" className="approved-primary approved-wide" disabled={guardandoNegocio}><IconoOficial nombre="save"/>{guardandoNegocio?'Guardando…':'Guardar cambios'}</button></footer>
        </form>
      </section>}

      {activeTab === 'perfil' && <section className="compact-section-page personal-profile"><div className="visual-page-heading visual-desktop"><IconoPanel name="profile"/><div><h2>Perfil</h2><p>Gestioná tu cuenta de usuario.</p></div></div><div className="personal-sheet-body"><div className="personal-identity"><span className="compact-avatar">{perfilForm.foto_perfil_url ? <img src={perfilForm.foto_perfil_url} alt="Tu foto" /> : inicialesUsuario}</span><div><strong>{user.name}</strong><p>{user.email}</p><small>{auth.currentUser?.providerData.some(provider=>provider.providerId==='password') ? 'Acceso con correo' : 'Acceso con Google'}</small></div></div><div className="visual-personal-actions"><div className="profile-access-heading"><h3>Acceso y seguridad</h3><p>{auth.currentUser?.providerData.some(provider=>provider.providerId==='google.com')?'Administrá el acceso desde tu cuenta de Google.':'Recibí un enlace para actualizar tu contraseña.'}</p></div><button type="button" className="personal-link" onClick={() => {setMostrarCuentaAcceso(true);}}><span className="reference-action-icon"><IconoOficial nombre="camera" /></span><span>Editar foto<small>Cambiá tu foto de perfil</small></span><IconoOficial nombre="chevron-right" /></button>{auth.currentUser?.providerData.some(provider => provider.providerId==='password') && <button type="button" disabled={enviandoClave} className="personal-link" onClick={() => void enviarCambioClave()}><span className="reference-action-icon"><IconoOficial nombre="lock-keyhole" /></span><span>{enviandoClave ? 'Enviando…' : 'Cambiar contraseña'}<small>Actualizá tu contraseña</small></span><IconoOficial nombre="chevron-right" /></button>}{auth.currentUser?.providerData.some(provider=>provider.providerId==='google.com') && <button type="button" className="personal-link" onClick={()=>window.open('https://myaccount.google.com/security','_blank','noopener,noreferrer')}><span className="reference-action-icon"><IconoOficial nombre="shield-check"/></span><span>Administrar seguridad</span><IconoOficial nombre="chevron-right"/></button>}<button type="button" className="personal-link personal-logout" disabled={cerrandoSesion} onClick={onLogout}><span className="reference-action-icon"><IconoPanel name="logout" /></span><span>Cerrar sesión<small>Salir de tu cuenta</small></span><IconoOficial nombre="chevron-right" /></button></div></div></section>}

      {/* SELECTOR DE RUBROS — CLAE ARGENTINA */}
      {showSelectorRubros && (
        <div className="rubro-v2-overlay" role="dialog" aria-modal="true" aria-labelledby="rubro-v2-title">
          <div className="rubro-v2-card">
            <div className="rubro-v2-header">
              <div>
                <h3 id="rubro-v2-title">Seleccionar rubro</h3>
                <p className="rubro-v2-subtitle">Oficios, servicios y actividades oficiales de Argentina</p>
              </div>
              <button type="button" onClick={() => setShowSelectorRubros(false)} className="rubro-v2-close" aria-label="Cerrar selector de rubro">
                <IconoOficial nombre="x" className="h-4 w-4" />
              </button>
            </div>

            <div className="rubro-v2-search">
              <label className="rubro-v2-search-field model-search-control mioficio-search-field"><span className="sr-only">Buscar rubro</span>
                <IconoBusqueda />
                <input
                  autoFocus
                  value={busquedaRubro}
                  onChange={e => setBusquedaRubro(e.target.value)}
                  placeholder="Buscar oficio, servicio, actividad o código CLAE..."
                  className="rubro-v2-input"
                />
              </label>
              <div className="rubro-v2-selection-info">
                <span className="rubro-v2-count">{rubrosSeleccionados.length ? '1 rubro seleccionado' : 'Ningún rubro seleccionado'}</span>
                {rubrosSeleccionados.length > 0 && (
                  <button type="button" onClick={() => setRubrosSeleccionados([])} className="rubro-v2-clear">Limpiar selección</button>
                )}
              </div>
            </div>

            <div className="rubro-v2-results">
              {rubrosCatalogo
                  .filter((r: ActividadEconomica) => {
                    const q = normalizarBusqueda(busquedaRubro);
                    const textoBusqueda = normalizarBusqueda(
                      [r.nombre, r.codigo, ...(r.busqueda || [])].join(' ')
                    );

                    if (!q) return true;

                    // Coincidencia completa o por todas las palabras buscadas.
                    const palabras = q.split(' ').filter(Boolean);
                    return textoBusqueda.includes(q) ||
                      palabras.every(palabra => textoBusqueda.includes(palabra));
                  })
                  .map((r: ActividadEconomica) => {
                    const selected = rubrosSeleccionados.some((v: ActividadEconomica) => v.tipo === r.tipo && v.codigo === r.codigo && v.nombre === r.nombre);
                    return (
                      <button
                        key={`${r.tipo}-${r.codigo || r.nombre}`}
                        type="button"
                        onClick={() => {
                          // Un solo rubro: al tocar uno, reemplaza inmediatamente
                          // cualquier selección anterior.
                          setRubrosSeleccionados([r]);
                        }}
                        aria-pressed={selected}
                        className={`rubro-v2-option ${selected ? 'is-selected' : ''}`}
                      >
                        <span className="rubro-v2-radio" aria-hidden="true">
                          {selected && (
                            <IconoOficial nombre="check" className="h-3 w-3" />
                          )}
                        </span>
                        <span className="rubro-v2-option-copy">
                          <span className="rubro-v2-option-name">{r.nombre}</span>
                          <span className="rubro-v2-option-kind">
                            {r.tipo === 'oficial' ? `CLAE ${r.codigo}` : 'Oficio / servicio'}
                          </span>
                        </span>
                      </button>
                    );
                  })}

            </div>

            <div className="rubro-v2-footer">
              <button
                type="button"
                onClick={() => {
                  const rubroSeleccionado = rubrosSeleccionados[0];

                  if (!rubroSeleccionado) {
                    setShowSelectorRubros(false);
                    return;
                  }

                  setPerfilForm({
                    ...perfilForm,
                    actividades_economicas: [rubroSeleccionado],
                    oficio_rubro: rubroSeleccionado.codigo
                      ? `${rubroSeleccionado.codigo} — ${rubroSeleccionado.nombre}`
                      : rubroSeleccionado.nombre
                  });
                  setShowSelectorRubros(false);
                }}
                className="rubro-v2-apply"
              >
                Aplicar rubro
              </button>
            </div>
          </div>
        </div>
      )}

      {/* REGISTRAR CLIENTE — misma tarjeta, campos y tipografía del generador */}
      {showModalCliente && (
        <div className="budget-generator budget-v2 client-v2 mi-oficio-ui" role="dialog" aria-modal="true" aria-label={clienteEnEdicion ? "Editar cliente" : "Registrar nuevo cliente"}>
          <div className="budget-v2-shell">
            <header className="budget-v2-header budget-v2-header-unbranded"><div className="final-client-heading"><IconoOficial nombre="user-round" /><div><h2>{clienteEnEdicion ? 'Editar cliente' : 'Nuevo cliente'}</h2><p>Datos del cliente</p></div></div>
              
              <button type="button" className="budget-v2-close" aria-label="Cerrar formulario de cliente" disabled={guardandoCliente} onClick={cerrarFormularioCliente}><IconoCerrar /></button>
            </header>
            <form id="nuevo-cliente-form" onSubmit={handleCrearCliente} className="budget-v2-form" aria-busy={guardandoCliente}>
              <main className="budget-v2-scroll" ref={clienteScrollRef}>
                <div className="budget-v2-card client-form-card client-essential-form">
                  <h2>{clienteEnEdicion ? "Editar cliente" : "Nuevo cliente"}</h2>
                  <section className="client-essential-section"><h3>Datos del cliente</h3><div className="client-essential-grid"><div className="budget-full">
                    <label className="label">Razón social / Nombre *</label>
                    <input required className="field model-input" maxLength={80} value={nuevoCliente.nombre_razon_social} onChange={e => setNuevoCliente({...nuevoCliente, nombre_razon_social:e.target.value.slice(0, 80)})} placeholder="Nombre completo o razón social" />
                  <small className="client-essential-counter">{nuevoCliente.nombre_razon_social.length}/80 caracteres</small></div><div><label className="label">Tipo de documento</label><select className="field model-input" value={nuevoCliente.tipo_documento === 'DNI' ? 'DNI' : 'CUIT / DNI'} onChange={e=>setNuevoCliente({...nuevoCliente,tipo_documento:e.target.value})}><option value="CUIT / DNI">CUIT</option><option value="DNI">DNI</option></select></div>
<div>
                    <label className="label">CUIT / DNI *</label>
                    <input required className="field model-input" maxLength={11} value={nuevoCliente.cuit_cuil} onChange={e => { const d = procesarDocumentoInput(e.target.value); setNuevoCliente({...nuevoCliente, cuit_cuil:d.valorLimpio, tipo_documento:d.tipoDetectado}); }} placeholder="Solo números" inputMode="numeric" />
                  <small className="client-essential-counter">{nuevoCliente.cuit_cuil.length}/11 caracteres</small></div>
<div>
                    <label className="label">Condición frente al IVA</label>
                    <select className="field model-input" value={nuevoCliente.condicion_tributaria} onChange={e => setNuevoCliente({...nuevoCliente,condicion_tributaria:e.target.value})}>
                      <option value="">Sin informar</option>
                      <option value="Responsable Inscripto">Responsable Inscripto</option>
                      <option value="Monotributista">Monotributista</option>
                      <option value="Consumidor Final">Consumidor Final</option>
                      <option value="Exento">Exento</option>
                    </select>
                  </div></div></section>
                  <section className="client-essential-section"><h3>Contacto</h3><div className="client-essential-grid"><div><label className="label">Email</label><input type="email" className="field model-input" maxLength={100} value={nuevoCliente.email} onChange={e=>setNuevoCliente({...nuevoCliente,email:e.target.value.slice(0, 100)})} placeholder="cliente@empresa.com" /><small className="client-essential-counter">{nuevoCliente.email.length}/100 caracteres</small></div>
<div><label className="label">Teléfono / WhatsApp</label><input type="tel" autoComplete="tel" className="field model-input" maxLength={30} value={nuevoCliente.telefono} onChange={e=>setNuevoCliente({...nuevoCliente,telefono:e.target.value.slice(0, 30)})} placeholder="+54 9 ..." /><small className="client-essential-counter">{nuevoCliente.telefono.length}/30 caracteres</small></div>
<div className="client-field-wide"><label className="label">Dirección</label><input className="field model-input" maxLength={100} value={nuevoCliente.direccion} onChange={e=>setNuevoCliente({...nuevoCliente,direccion:e.target.value.slice(0, 100)})} placeholder="Calle y número" /><small className="client-essential-counter">{nuevoCliente.direccion.length}/100 caracteres</small></div></div></section>
                </div>
              </main>
              {hayCamposClienteDebajo && <div className="client-fields-scroll-notice" role="status"><IconoAvisoFormulario /><span>Hay más campos abajo. Desplazate para seguir completando.</span></div>}
              <footer className="budget-v2-footer client-v2-footer">
                <button type="button" className="client-v2-cancel model-secondary-button" disabled={guardandoCliente} onClick={cerrarFormularioCliente}>Cancelar</button>
                <button type="submit" disabled={guardandoCliente} className="budget-step-emit model-primary-button">{guardandoCliente ? "Guardando…" : clienteEnEdicion ? "Guardar cambios" : "Guardar cliente"}</button>
              </footer>
            </form>
          </div>
        </div>
      )}

      {modoCatalogo && perfilForm.es_premium === true && <div className="catalogo-overlay" onClick={() => { if (!guardandoCatalogo) setModoCatalogo(null); }}>
        <section className="catalogo-dialog compact-premium-dialog compact-premium-catalog" role="dialog" aria-modal="true" aria-labelledby="catalogo-title" onClick={e => e.stopPropagation()} onKeyDown={e => { if (e.key === 'Escape' && !guardandoCatalogo) setModoCatalogo(null); }}>
          <div className="catalogo-heading"><div><h2 id="catalogo-title">Mis productos y servicios</h2><p>{modoCatalogo === 'presupuesto' ? `Elegí un artículo para este presupuesto en ${nuevoPresupuesto.moneda}.` : 'Guardá lo que cobrás seguido para usarlo en otro presupuesto.'}</p></div><button type="button" disabled={guardandoCatalogo} onClick={() => setModoCatalogo(null)} aria-label="Cerrar catálogo"><IconoCerrar /></button></div>
          {errorCatalogo && <p className="catalogo-error" role="alert">{errorCatalogo}</p>}
          {formArticuloVisible ? formularioCatalogoVisual() : <>
            <div className="catalogo-toolbar"><label className="catalogo-search mioficio-search-field"><span className="sr-only">Buscar en mis productos y servicios</span><IconoBusqueda /><input type="search" value={busquedaCatalogo} onChange={e => setBusquedaCatalogo(e.target.value)} placeholder="Buscar producto o servicio" /></label><button type="button" className="catalogo-primary" disabled={guardandoCatalogo} onClick={() => prepararArticulo()}><IconoPanel name="plus" />Nuevo</button></div>
            <div className="catalogo-list">{articulosCatalogo.filter(a => a.descripcion.toLocaleLowerCase('es').includes(busquedaCatalogo.trim().toLocaleLowerCase('es'))).sort((a,b) => a.descripcion.localeCompare(b.descripcion,'es')).map(a => <article className="catalogo-row" key={a.id}><div className="catalogo-row-copy"><strong>{a.descripcion}</strong><span>{importeDocumento(a.precio_unitario,a.moneda)} / {abreviarUnidadPresupuesto(a.unidad)} · IVA {String(a.iva).replace('.',',')} %</span></div><div className="catalogo-row-actions">{modoCatalogo === 'presupuesto' && <button type="button" className="catalogo-primary" disabled={guardandoCatalogo || a.moneda !== nuevoPresupuesto.moneda} onClick={() => usarArticuloCatalogo(a)} title={a.moneda !== nuevoPresupuesto.moneda ? `Artículo en ${a.moneda}; presupuesto en ${nuevoPresupuesto.moneda}` : 'Agregar al presupuesto'}>Agregar</button>}<button type="button" className="catalogo-icon" disabled={guardandoCatalogo} onClick={() => prepararArticulo(a)} aria-label={`Editar ${a.descripcion}`}><IconoOficial nombre="square-pen"  /></button><button type="button" className="catalogo-icon" disabled={guardandoCatalogo} onClick={() => setEliminarArticuloId(a.id)} aria-label={`Eliminar ${a.descripcion}`}><IconoOficial nombre="trash-2"  /></button></div>{eliminarArticuloId === a.id && <div className="catalogo-delete-confirm"><span>¿Eliminar este artículo? Los presupuestos anteriores conservan sus datos.</span><button type="button" disabled={guardandoCatalogo} onClick={() => borrarArticuloCatalogo(a.id)}>Eliminar</button><button type="button" disabled={guardandoCatalogo} onClick={() => setEliminarArticuloId(null)}>Cancelar</button></div>}</article>)}{!articulosCatalogo.some(a => a.descripcion.toLocaleLowerCase('es').includes(busquedaCatalogo.trim().toLocaleLowerCase('es'))) && <div className="catalogo-empty"><IconoPanel name="quotes" /><strong>{articulosCatalogo.length ? 'Sin resultados' : 'Todavía no guardaste productos o servicios'}</strong><span>{articulosCatalogo.length ? 'Probá con otra búsqueda.' : 'Completá un ítem del presupuesto y tocá Guardar para reutilizar, o creá uno con Nuevo.'}</span></div>}</div>
            <p className="catalogo-hint">Guardado en tu cuenta. Editar o eliminar artículos no cambia presupuestos ya creados.</p>
          </>}
        </section>
      </div>}

      {mostrarCompartirWhatsapp && <div className="model-overlay whatsapp-share-overlay" onClick={cerrarCompartirWhatsapp}>
        <section className="whatsapp-share-card" role="dialog" aria-modal="true" aria-labelledby="whatsapp-share-title" onClick={e => e.stopPropagation()} onKeyDown={e => { if (e.key === 'Escape') cerrarCompartirWhatsapp(); }}>
          <header><div><span className="whatsapp-premium-label">Herramienta Premium</span><h2 id="whatsapp-share-title">Compartir presupuesto</h2></div><button type="button" autoFocus aria-label="Cerrar compartir presupuesto" onClick={cerrarCompartirWhatsapp}><IconoCerrar /></button></header>
          {perfilForm.es_premium === true ? <>
            {presupuestoWhatsappSeleccionado && <div className="whatsapp-document-summary"><span className="whatsapp-document-icon"><IconoOficial nombre="file-text" className="premium-tool-svg" /></span><div><strong>{presupuestoWhatsappSeleccionado.numero_presupuesto}</strong><span>{presupuestoWhatsappSeleccionado.cliente}</span><small role="status">{preparandoWhatsapp ? 'Preparando PDF…' : archivoWhatsapp ? 'PDF adjunto listo' : 'PDF pendiente'}</small></div>{archivoWhatsapp && <a href={archivoWhatsapp.url} target="_blank" rel="noopener noreferrer" aria-label="Revisar PDF adjunto">Ver PDF<IconoOficial nombre="external-link" className="premium-tool-svg" /></a>}</div>}
            <details className="whatsapp-document-picker" open={!presupuestoWhatsappId}><summary>{presupuestoWhatsappId ? 'Cambiar presupuesto' : 'Seleccionar presupuesto'}<IconoOficial nombre="chevron-down" className="premium-tool-svg" /></summary><label className="sr-only" htmlFor="whatsapp-presupuesto">Presupuesto que vas a enviar</label><select id="whatsapp-presupuesto" disabled={compartiendoWhatsapp} value={presupuestoWhatsappId} onChange={e => seleccionarPresupuestoWhatsapp(e.target.value)}><option value="">Seleccioná un presupuesto</option>{presupuestos.map(p => <option key={p.presupuesto_id} value={String(p.presupuesto_id)}>{p.numero_presupuesto} · {p.cliente}</option>)}</select></details>
            {!presupuestos.length && <p>Primero emití un presupuesto para poder compartirlo.</p>}
            <div className="whatsapp-clipboard-notice" role="note"><IconoAvisoFormulario /><p>{compartirMovilDisponible ? 'Al compartir el PDF, pegá el mensaje copiado en el chat de WhatsApp.' : 'Descargá el PDF y adjuntalo en WhatsApp. El mensaje queda preparado para copiar.'}</p></div>

            <button type="button" className="whatsapp-share-primary" disabled={!archivoWhatsapp || preparandoWhatsapp || compartiendoWhatsapp || !mensajeWhatsapp.trim()} onClick={() => {if(compartirMovilDisponible)void enviarPdfWhatsapp();else window.open('https://wa.me/?text='+encodeURIComponent(mensajeWhatsapp),'_blank','noopener,noreferrer');}}>{preparandoWhatsapp ? 'Preparando el adjunto…' : compartiendoWhatsapp ? 'Abriendo compartir…' : compartirMovilDisponible ? 'Compartir PDF' : 'Abrir WhatsApp'}</button>
            {archivoWhatsapp && <a className="whatsapp-download" href={archivoWhatsapp.url} download={archivoWhatsapp.archivo.name}>Descargar PDF para adjuntar</a>}
            {presupuestoWhatsappId && !archivoWhatsapp && !preparandoWhatsapp && <button type="button" className="whatsapp-share-retry" onClick={() => void prepararPdfWhatsapp()}>Reintentar preparar el adjunto</button>}
            <details className="whatsapp-alternatives"><summary>Otras opciones</summary><div className="whatsapp-share-actions"><button type="button" disabled={!mensajeWhatsapp.trim() || compartiendoWhatsapp} onClick={() => void copiarMensajeWhatsapp()}>Copiar mensaje</button></div><label className="sr-only" htmlFor="whatsapp-mensaje">Mensaje preparado para copiar</label><textarea id="whatsapp-mensaje" readOnly value={mensajeWhatsapp} rows={5} /></details>
          </> : <><p>Compartí el PDF y copiá automáticamente el mensaje para tu cliente.</p><div className="whatsapp-clipboard-notice" role="note"><IconoAvisoFormulario /><p>El PDF se envía sin el texto. Pegá el mensaje copiado en el chat de WhatsApp.</p></div><button type="button" className="whatsapp-share-primary" onClick={() => { cerrarCompartirWhatsapp(); activarPremium(); }}>Elegir un plan Premium</button></>}
        </section>
      </div>}

      {mostrarAyuda&&<CentroAyudaMiOficio onCerrar={()=>setMostrarAyuda(false)}/>}

      {mostrarCuentaAcceso && <div className="model-overlay account-access-overlay" onClick={() => setMostrarCuentaAcceso(false)}>
        <dialog ref={cuentaDialogoRef} className="account-access-card model-card" aria-labelledby="cuenta-acceso-titulo" onClick={e=>e.stopPropagation()} onClose={()=>setMostrarCuentaAcceso(false)}>
          <div className="account-access-heading"><h2 id="cuenta-acceso-titulo">Cuenta de acceso</h2><button type="button" autoFocus className="account-access-close" onClick={() => setMostrarCuentaAcceso(false)} aria-label="Cerrar Cuenta de acceso"><IconoOficial nombre="x"  /></button></div>
          <div className="account-access-identity">
            <div className="account-access-photo-control">
              <input id="cuenta-foto-archivo" type="file" accept="image/png,image/jpeg,image/webp,.png,.jpg,.jpeg,.webp" onChange={cargarFotoPerfil} className="profile-v2-photo-input" aria-label="Cargar o cambiar foto de perfil" />
              <span className="account-access-photo">{perfilForm.foto_perfil_url ? <img src={perfilForm.foto_perfil_url} alt="Tu foto de perfil" /> : <IconoOficial nombre="user-round" width={28} height={28} />}</span>
              <label htmlFor="cuenta-foto-archivo" className="account-access-change"><IconoOficial nombre="camera"  />{perfilForm.foto_perfil_url ? 'Cambiar foto' : 'Cargar foto'}</label>
            </div>
            <div className="account-access-details"><span className="account-identity-label">Usuario de acceso</span><strong>{user.name || 'Tu cuenta'}</strong><span className="account-access-email">{user.email}</span></div>
          </div>
          <p className="account-access-help">Tu foto se guarda automáticamente. Formatos PNG, JPG o WEBP, hasta 5 MB.</p>
          {auth.currentUser?.providerData.some(provider=>provider.providerId==='password')&&<button type="button" className="account-access-security" disabled={enviandoClave} onClick={()=>void enviarCambioClave()}><IconoOficial nombre="lock-keyhole"/>{enviandoClave?'Enviando enlace…':'Cambiar contraseña'}</button>}{auth.currentUser?.providerData.some(provider=>provider.providerId==='google.com')&&<button type="button" className="account-access-security" onClick={()=>window.open('https://myaccount.google.com/security','_blank','noopener,noreferrer')}><IconoOficial nombre="shield-check"/>Seguridad de Google</button>}
          <button type="button" className="account-access-logout" disabled={cerrandoSesion} onClick={() => { setMostrarCuentaAcceso(false); onLogout(); }}><IconoPanel name="logout" />Cerrar sesión</button>
        </dialog>
      </div>}

      {mostrarAvisos && <div className="fixed inset-0 z-[85]" onClick={() => setMostrarAvisos(false)}>
        <style>{`
          .avisos-modal{position:fixed;width:min(480px,calc(100vw - 24px));max-height:420px;display:flex;flex-direction:column;overflow:hidden;border:1px solid #dce1ee;border-radius:16px;background:#fff;box-shadow:0 10px 32px #090e3926;color:#090e39}
          .avisos-header{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 16px;border-bottom:1px solid #edf0f6;flex-shrink:0}.avisos-header h3{font-size:15px;line-height:20px;font-weight:700;margin:0}.avisos-heading{display:flex;align-items:center;gap:8px}.avisos-count{font-size:11px;font-weight:650;color:#1850ff;background:#edf2ff;border-radius:6px;padding:2px 6px}
          .avisos-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 16px;border-bottom:1px solid #edf0f6;flex-shrink:0}.mi-oficio-ui.mioficio-model .avisos-filter{width:142px!important;height:30px!important;min-height:30px!important;padding:3px 8px!important;border:1px solid #dce1ee!important;border-radius:8px!important;background:#f9f9fc!important;color:#090e39!important;font-size:12px!important}
          .avisos-content{overflow-y:auto;min-height:0}.avisos-item{display:flex;align-items:center;gap:14px;padding:16px 18px;border-bottom:1px solid #edf0f6}.avisos-item:last-child{border-bottom:0}.avisos-icon{width:42px;height:42px;flex-shrink:0;display:flex;align-items:center;justify-content:center;border-radius:9px;background:#edf2ff;color:#1850ff}.avisos-copy{flex:1;min-width:0}.mi-oficio-ui.mioficio-model button.avisos-open{display:block!important;width:100%!important;min-height:0!important;height:auto!important;background:none!important;border:0!important;padding:0!important;text-align:left!important;white-space:normal!important;box-shadow:none!important;border-radius:0!important;color:#090e39!important;line-height:1.4!important}.avisos-open strong{display:block;font-size:14px;font-weight:650;line-height:1.4}.avisos-open span{display:block;font-size:12px;line-height:1.5;color:#707b97;margin-top:4px;overflow-wrap:anywhere}.avisos-open small{display:none}
          .mi-oficio-ui.mioficio-model button.avisos-close,.mi-oficio-ui.mioficio-model button.avisos-mark{width:28px!important;min-width:28px!important;height:28px!important;min-height:28px!important;padding:4px!important;border:0!important;background:transparent!important;display:flex!important;align-items:center!important;justify-content:center!important;box-shadow:none!important;border-radius:8px!important;color:#707b97!important;flex-shrink:0!important}.mi-oficio-ui.mioficio-model button.avisos-mark{border:1px solid #dce1ee!important;color:#1850ff!important}.avisos-read{font-size:11px;color:#8b94aa}.avisos-more{display:flex;align-items:center;justify-content:space-between;padding:10px 16px;border-top:1px solid #edf0f6;gap:8px}.mi-oficio-ui.mioficio-model button.avisos-action{background:none!important;border:0!important;padding:4px 0!important;height:auto!important;min-height:24px!important;font-size:11px!important;font-weight:650!important;line-height:16px!important;color:#1850ff!important;box-shadow:none!important;white-space:normal!important;text-align:left!important}.avisos-empty{text-align:center;padding:28px 16px;color:#707b97;font-size:13px}.avisos-more-actions{display:flex;gap:12px}.avisos-modal button:focus-visible,.avisos-filter:focus-visible{outline:2px solid #1850ff!important;outline-offset:2px}
          .avisos-direct-actions{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-top:9px}.mi-oficio-ui.mioficio-model button.avisos-resolve{height:30px!important;min-height:30px!important;padding:5px 10px!important;border-radius:8px!important;border:1px solid #dce1ee!important;background:#edf2ff!important;color:#1850ff!important;font-size:12px!important;font-weight:650!important;line-height:18px!important;box-shadow:none!important}.avisos-resolve:disabled{opacity:.55;cursor:wait}
          @media(max-width:639px){.avisos-modal{right:12px!important;width:calc(100vw - 24px);max-width:480px}.avisos-header,.avisos-toolbar,.avisos-item{padding-left:14px;padding-right:14px}.avisos-open strong{font-size:13px}}
        `}</style>
        <div role="dialog" aria-label="Panel de notificaciones" aria-labelledby="avisos-title" style={{ top: posicionAvisos.top, right: posicionAvisos.right, maxHeight: `min(${compartirMovilDisponible ? 300 : 360}px, calc(100dvh - ${posicionAvisos.top+12}px))` }} className="avisos-modal" onClick={event => event.stopPropagation()} onKeyDown={event => {if(event.key==='Escape')setMostrarAvisos(false);}}>
          <div className="avisos-header"><div className="avisos-heading"><IconoOficial nombre="bell" /><h3 id="avisos-title">Notificaciones</h3><span className="avisos-count">{obtenerAvisos().filter(aviso => !avisosLeidos.includes(aviso.id)).length}</span></div><button type="button" onClick={() => setMostrarAvisos(false)} className="avisos-close" autoFocus aria-label="Cerrar notificaciones"><IconoCerrar /></button></div>
          <div className="avisos-tabs" role="tablist" aria-label="Filtrar notificaciones">{[{value:'todos',label:'Todas'},{value:'pendientes',label:'Sin leer'}].map(tab=><button key={tab.value} type="button" role="tab" aria-selected={filtroAvisos===tab.value} onClick={()=>{setFiltroAvisos(tab.value as typeof filtroAvisos);setAvisosVisibles(100);}}>{tab.label}<span>{tab.value==='todos' ? obtenerAvisos().length : obtenerAvisos().filter(a=>!avisosLeidos.includes(a.id)).length}</span></button>)}</div>
          <div className="avisos-content">{(() => {
            const visibles = obtenerAvisos().filter(aviso => (filtroAvisos!=='pendientes' || !avisosLeidos.includes(aviso.id)) && (filtroAvisos==='todos' || filtroAvisos==='pendientes' || aviso.tipo===filtroAvisos));
            return visibles.length === 0 ? <div className="avisos-empty">No tenés notificaciones pendientes.</div> : <>{visibles.slice(0,avisosVisibles).map(aviso => <article key={aviso.id} className="avisos-item"><span className="avisos-icon"><IconoOficial nombre={aviso.tipo === "presupuestos" ? "file-text" : "house"} /></span><div className="avisos-copy"><button type="button" className="avisos-open" onClick={() => { marcarAvisoLeido(aviso.id); setMostrarAvisos(false); if (aviso.cobroId != null) { const p=presupuestos.find(p=>p.presupuesto_id===aviso.cobroId); if(p)abrirCobro(p); } else if (aviso.revisionPendientes) { abrirMenuPrincipal('presupuestos');setBusquedaPresupuesto('');setFiltroEstadoPresupuesto('Todos');setPaginaPresupuestos(1); } else if (aviso.presupuesto) { setActiveTab('presupuestos'); setBusquedaPresupuesto(aviso.presupuesto.numero_presupuesto); setFiltroEstadoPresupuesto(''); setPaginaPresupuestos(1); } else if (aviso.cambioPlan) {setMostrarCuentaAcceso(true);} else { abrirMenuPrincipal('negocio'); } }}><strong>{aviso.titulo}</strong><span>{aviso.presupuesto ? `${aviso.referencia} · ${aviso.presupuesto.moneda || 'ARS'} $ ${totalVigentePresupuesto(aviso.presupuesto).toLocaleString('es-AR')}` : aviso.detalle}</span>{aviso.cambioPlan && <span style={{fontSize:11,color:'#64748b'}}>{aviso.referencia}</span>}<small>{aviso.revisionPendientes ? 'Revisar presupuestos' : aviso.presupuesto ? 'Ver presupuesto' : aviso.cobroId != null ? 'Registrar pago' : aviso.cambioPlan ? 'Ver mi cuenta' : 'Completar datos'} →</small></button>
                    <div className="avisos-direct-actions">
                      {aviso.revisionPendientes ? <button type="button" className="avisos-resolve" onClick={() => {marcarAvisoLeido(aviso.id);setMostrarAvisos(false);abrirMenuPrincipal('presupuestos');setBusquedaPresupuesto('');setFiltroEstadoPresupuesto('Todos');setPaginaPresupuestos(1);}}>Revisar presupuestos</button> : aviso.respuestaCliente ? <button type="button" className="reply-button" onClick={()=>{setActiveTab('presupuestos');setMostrarAvisos(false);window.setTimeout(()=>{const panel=document.getElementById('respuestas-cliente') as HTMLDetailsElement|null;if(panel){panel.open=true;panel.scrollIntoView({behavior:'smooth',block:'start'});}},100);}}>Ver respuesta</button> : aviso.presupuesto ? <>
                        {aviso.presupuesto.estado === 'Aceptado' ? <button type="button" className="avisos-resolve" disabled={guardandoEstadoPresupuesto !== null} onClick={async () => { if (aviso.presupuesto && await cambiarEstadoPresupuesto(aviso.presupuesto.presupuesto_id,'Pagado')) marcarAvisoLeido(aviso.id); }}>{guardandoEstadoPresupuesto === aviso.presupuesto.presupuesto_id ? 'Guardando…' : 'Registrar pago'}</button> : <button type="button" className="avisos-resolve" onClick={() => { if (aviso.presupuesto) { setMostrarAvisos(false); abrirEditorPresupuesto(aviso.presupuesto); } }}>Revisar validez</button>}
                        <button type="button" className="avisos-action" onClick={() => { if (aviso.presupuesto) { marcarAvisoLeido(aviso.id); setMostrarAvisos(false); void generarYMostrarPdf(aviso.presupuesto); } }}>Ver PDF</button>
                      </> : aviso.cobroId != null ? <button type="button" className="avisos-resolve" onClick={()=>{setMostrarAvisos(false);const p=presupuestos.find(p=>p.presupuesto_id===aviso.cobroId);if(p)abrirCobro(p);}}>Registrar pago</button> : aviso.recontratar && perfilForm.es_premium !== true ? <button type="button" className="avisos-resolve" onClick={() => { marcarAvisoLeido(aviso.id); setMostrarAvisos(false); setAdvertenciaFree(null); activarPremium(); }}>Volver a contratar Premium</button> : <button type="button" className="avisos-resolve" onClick={() => { marcarAvisoLeido(aviso.id); setMostrarAvisos(false); setShowDatosNegocioMovil(false); if(aviso.cambioPlan)setMostrarCuentaAcceso(true);else abrirMenuPrincipal('negocio'); }}>{aviso.cobroId != null ? 'Registrar pago' : aviso.cambioPlan ? 'Ver mi cuenta' : 'Completar datos'}</button>}
                    </div>
                  </div>{avisosLeidos.includes(aviso.id) ? <span className="avisos-read" aria-label="Leída"><IconoOficial nombre="check" className="w-3.5 h-3.5" /></span> : <button type="button" className="avisos-mark" title="Marcar como leída" aria-label={`Marcar como leída: ${aviso.titulo}`} onClick={() => marcarAvisoLeido(aviso.id)}><IconoOficial nombre="check" className="w-3.5 h-3.5" /></button>}</article>)}
              {visibles.length > 1 && <div className="avisos-more"><span className="avisos-read">{Math.min(avisosVisibles,visibles.length)} de {visibles.length}</span><div className="avisos-more-actions">{avisosVisibles > 1 && <button type="button" className="avisos-action" onClick={() => setAvisosVisibles(1)}>Solo la última</button>}{avisosVisibles < visibles.length && <button type="button" className="avisos-action" onClick={() => setAvisosVisibles(cantidad => cantidad+2)}>Ver anteriores <span aria-hidden="true">↓</span></button>}</div></div>}
            </>;
          })()}</div>

        </div>
      </div>}

      {/* MODAL VER / PDF CLIENTE */}
      {clienteSeleccionadoParaVer && (
        <div className="model-overlay fixed inset-0 z-[75] flex items-center justify-center bg-slate-950/55 p-3 backdrop-blur-sm">
          <div className="flex max-h-[92vh] w-full max-w-[760px] flex-col overflow-hidden rounded-2xl border border-white/80 bg-white shadow-2xl model-card">
            <div className="flex shrink-0 items-center justify-between gap-3 border-b border-slate-200 px-4 py-3.5 sm:px-5 model-panel-header">
              <div className="flex min-w-0 items-center gap-3">
                <div className="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-slate-200 bg-slate-50 text-slate-600">
                  <IconoOficial nombre="file-text" className="h-4 w-4" />
                </div>
                <div className="min-w-0">
                  <h3 className="truncate text-[13px] font-bold text-slate-950">{mostrarHistorialCliente ? 'Historial de presupuestos del cliente' : 'Perfil del cliente'}</h3>
                  <p className="mt-0.5 truncate text-[14px] text-slate-500">{clienteSeleccionadoParaVer.nombre_razon_social}</p>
                </div>
              </div>
              <button type="button" onClick={() => { setMostrarHistorialCliente(false); setClienteSeleccionadoParaVer(null); setMostrarTodosPresupuestosCliente(false); }} className="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50 model-icon-button" aria-label="Cerrar">
                <IconoOficial nombre="x" className="h-4 w-4" />
              </button>
            </div>

            <div className="min-h-0 flex-1 overflow-y-auto bg-slate-50/60 p-3 sm:p-4">
              {!mostrarHistorialCliente && <section className="mb-4 rounded-xl border border-slate-200 bg-white p-4 model-card" aria-label="Datos del cliente">
                <dl className="grid grid-cols-1 gap-3 sm:grid-cols-2">
                  {[
                    ['Nombre / Razón social', clienteSeleccionadoParaVer.nombre_razon_social],
                    ['CUIT / DNI', clienteSeleccionadoParaVer.cuit_cuil],
                    ['Condición fiscal', clienteSeleccionadoParaVer.condicion_tributaria],
                    ['Teléfono / WhatsApp', clienteSeleccionadoParaVer.telefono],
                    ['Email', clienteSeleccionadoParaVer.email],
                    ['Domicilio', clienteSeleccionadoParaVer.direccion],
                    ['Contacto', clienteSeleccionadoParaVer.contacto_compras],
                    ['IIBB', clienteSeleccionadoParaVer.iibb],
                    ['Observaciones', clienteSeleccionadoParaVer.observaciones],
                  ].filter(([, valor]) => Boolean(valor?.trim())).map(([etiqueta, valor]) => <div key={etiqueta} className="min-w-0"><dt className="text-[12px] text-slate-500">{etiqueta}</dt><dd className="mt-1 whitespace-pre-wrap break-words text-[14px] font-medium text-slate-900">{valor}</dd></div>)}
                </dl>
                <button type="button" className="mt-4 inline-flex items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 text-[14px] font-semibold text-blue-600 model-secondary-button" onClick={() => { const cliente = clienteSeleccionadoParaVer; setMostrarHistorialCliente(false); setClienteSeleccionadoParaVer(null); abrirEditorCliente(cliente); }}><IconoOficial nombre="square-pen"  />Editar datos</button>
              </section>}
              {mostrarHistorialCliente && (() => {
                const historialCliente = presupuestos
                  .filter(p => p.cliente.toLowerCase() === clienteSeleccionadoParaVer.nombre_razon_social.toLowerCase())
                  .sort((a, b) => String(b.fecha || '').localeCompare(String(a.fecha || '')));
                const presupuestosVisibles = historialCliente;

                return historialCliente.length === 0 ? (
                  <div className="rounded-xl border border-slate-200 bg-white px-5 py-12 text-center model-card">
                    <p className="text-[14px] font-bold text-slate-700">Este cliente todavía no tiene presupuestos.</p>
                    <p className="mt-1 text-[14px] text-slate-400">Cuando generes documentos aparecerán en este historial.</p>
                  </div>
                ) : (
                  <div className="space-y-2">
                    {presupuestosVisibles.map(p => (
                      <div key={p.presupuesto_id} className="flex flex-col gap-3 rounded-xl border border-slate-200 bg-white p-3.5 sm:flex-row sm:items-center sm:justify-between model-card">
                        <div className="min-w-0">
                          <div className="flex flex-wrap items-center gap-2">
                            <span className="font-mono text-[14px] font-bold text-slate-900">{p.numero_presupuesto}</span>
                            <span className="rounded-md bg-slate-100 px-1.5 py-1 text-[14px] font-semibold text-slate-600">{estadoPagoVisible(p)}</span>
                          </div>
                          <p className="mt-1 text-[14px] text-slate-400">
                            {p.fecha} <span className="mx-1">·</span> <strong className="font-bold text-slate-800">{importeDocumento(totalVigentePresupuesto(p),p.moneda)}</strong>
                          </p>
                        </div>
                        <button type="button" onClick={() => generarYMostrarPdf(p)} className="inline-flex h-8 w-full items-center justify-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 text-[14px] font-bold text-slate-700 hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700 sm:w-auto model-secondary-button">
                          <IconoOficial nombre="external-link" className="h-3.5 w-3.5" />
                          Ver PDF
                        </button>
                        {(p.entregas||[]).map(entrega=><button type="button" key={entrega.id} onClick={()=>verEntrega(entrega)} className="model-secondary-button" style={{fontSize:12,padding:'8px 10px',borderRadius:8}}>Entrega {entrega.fecha.split('-').reverse().join('/')} · Ver PDF</button>)}
                        {perfilForm.es_premium === true && ['Aceptado','Pagado'].includes(p.estado) && <button type="button" className="model-secondary-button" style={{fontSize:12,padding:'8px 10px',borderRadius:8}} onClick={()=>{setClienteSeleccionadoParaVer(null);abrirEntregas(p);}}>Generar comprobante de trabajo</button>}
                      </div>
                    ))}
                  </div>
                );
              })()}
            </div>

            <div className="flex shrink-0 flex-col gap-2 border-t border-slate-200 bg-white p-3 sm:flex-row sm:items-center sm:justify-between sm:p-4 model-panel-footer">
              <div className="text-[14px] text-slate-400">{mostrarHistorialCliente ? 'Todos los presupuestos de este cliente' : 'Datos del cliente'}</div>
              <div className="flex w-full flex-col gap-2 sm:w-auto sm:flex-row">
                {!mostrarHistorialCliente ? <button type="button" onClick={() => setMostrarHistorialCliente(true)} className="inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-3 py-2 text-[14px] font-bold text-white model-primary-button"><IconoOficial nombre="history"  />Historial de presupuestos del cliente</button> : <button type="button" onClick={() => setMostrarHistorialCliente(false)} className="rounded-lg border border-slate-200 px-3 py-2 text-[14px] font-semibold text-slate-600 model-secondary-button">Volver al perfil</button>}
                {mostrarHistorialCliente && <>
                <button type="button" onClick={() => generarPdfConsolidadoCliente(clienteSeleccionadoParaVer)} className="inline-flex h-8 items-center justify-center gap-1.5 rounded-lg bg-slate-900 px-3 text-[14px] font-bold text-white hover:bg-slate-800 model-primary-button">
                  <IconoOficial nombre="files" className="h-3.5 w-3.5" />
                  {!perfilForm.es_premium && <IconoOficial nombre="lock-keyhole" className="w-3.5 h-3.5" />}Presupuestos en un PDF
                </button>
                </>}
                <button type="button" onClick={() => { setMostrarHistorialCliente(false); setClienteSeleccionadoParaVer(null); setMostrarTodosPresupuestosCliente(false); }} className="h-8 rounded-lg border border-slate-200 bg-white px-3 text-[14px] font-bold text-slate-600 hover:bg-slate-50 model-secondary-button">Cerrar</button>
              </div>
            </div>
          </div>
        </div>
      )}

      {rangoInicioEditor&&<div className="model-overlay approved-bundle-overlay approved-range-overlay" onClick={()=>setRangoInicioEditor(null)}><form role="dialog" aria-modal="true" aria-labelledby="rango-inicio-titulo" className="approved-bundle-chooser approved-range-dialog" onClick={e=>e.stopPropagation()} onKeyDown={e=>{if(e.key==='Escape')setRangoInicioEditor(null);}} onSubmit={e=>{e.preventDefault();if(!rangoInicioEditor.desde||!rangoInicioEditor.hasta||rangoInicioEditor.desde>rangoInicioEditor.hasta)return;setDesdeInicioModelo(rangoInicioEditor.desde);setHastaInicioModelo(rangoInicioEditor.hasta);setRangoInicioEditor(null);}}><div className="approved-card-heading"><h2 id="rango-inicio-titulo">Período personalizado</h2><button autoFocus type="button" className="approved-icon" aria-label="Cerrar período personalizado" onClick={()=>setRangoInicioEditor(null)}><IconoOficial nombre="x"/></button></div><p>Elegí las fechas para consultar tus cobros.</p><div className="approved-range-fields"><label>Desde<input required type="date" aria-label="Inicio del período" value={rangoInicioEditor.desde} max={rangoInicioEditor.hasta||undefined} onChange={e=>setRangoInicioEditor({...rangoInicioEditor,desde:e.target.value})}/></label><label>Hasta<input required type="date" aria-label="Fin del período" value={rangoInicioEditor.hasta} min={rangoInicioEditor.desde||undefined} onChange={e=>setRangoInicioEditor({...rangoInicioEditor,hasta:e.target.value})}/></label></div>{rangoInicioEditor.desde&&rangoInicioEditor.hasta&&rangoInicioEditor.desde>rangoInicioEditor.hasta&&<p role="alert" className="approved-date-error">La fecha de inicio debe ser anterior o igual a la fecha final.</p>}<button type="submit" className="approved-primary" disabled={!rangoInicioEditor.desde||!rangoInicioEditor.hasta||rangoInicioEditor.desde>rangoInicioEditor.hasta}>Aplicar período</button></form></div>}
      {selectorConsolidadoModelo&&perfilForm.es_premium&&<div className="model-overlay approved-bundle-overlay" onClick={()=>setSelectorConsolidadoModelo(false)}><section role="dialog" aria-modal="true" aria-labelledby="bundle-cliente-titulo" className="approved-bundle-chooser" onClick={e=>e.stopPropagation()} onKeyDown={e=>{if(e.key==='Escape')setSelectorConsolidadoModelo(false);}}><div className="approved-card-heading"><h2 id="bundle-cliente-titulo">Consolidar en PDF</h2><button autoFocus type="button" className="approved-icon" aria-label="Cerrar selección de cliente" onClick={()=>setSelectorConsolidadoModelo(false)}><IconoOficial nombre="x"/></button></div><p>Elegí el cliente. En el siguiente paso seleccionás sus presupuestos.</p><label className="approved-bundle-search">Buscar cliente<input autoComplete="off" aria-label="Buscar cliente para consolidar" placeholder="Nombre o empresa" value={busquedaClienteConsolidado} onChange={e=>setBusquedaClienteConsolidado(e.target.value)} onKeyDown={e=>{if(e.key==='Escape'&&busquedaClienteConsolidado){e.preventDefault();e.stopPropagation();setBusquedaClienteConsolidado('');}}}/><LimpiarBusqueda visible={Boolean(busquedaClienteConsolidado)} onLimpiar={()=>{setBusquedaClienteConsolidado('');}} etiqueta="clientes para consolidar"/></label><div className="approved-bundle-client-list" role="group" aria-label="Clientes para consolidar">{clientes.filter(c=>c.nombre_razon_social.toLowerCase().includes(busquedaClienteConsolidado.toLowerCase())).map(c=><button type="button" key={c.cliente_id} aria-pressed={clienteHerramientaPremium===String(c.cliente_id)} onClick={()=>setClienteHerramientaPremium(String(c.cliente_id))}><span className="approved-bundle-avatar">{c.nombre_razon_social.trim().split(/\s+/).slice(0,2).map(v=>v[0]).join('').toUpperCase()}</span><span>{c.nombre_razon_social}</span><IconoOficial nombre={clienteHerramientaPremium===String(c.cliente_id)?'circle-check':'chevron-right'}/></button>)}{!clientes.some(c=>c.nombre_razon_social.toLowerCase().includes(busquedaClienteConsolidado.toLowerCase()))&&<p>No hay clientes que coincidan.</p>}</div><button type="button" className="approved-primary" disabled={!clientes.some(c=>String(c.cliente_id)===clienteHerramientaPremium)} onClick={()=>{const c=clientes.find(c=>String(c.cliente_id)===clienteHerramientaPremium);if(c){generarPdfConsolidadoCliente(c);setSelectorConsolidadoModelo(false);}}}>Continuar<IconoOficial nombre="arrow-right"/></button>{!clientes.length&&<p>Primero agregá un cliente.</p>}</section></div>}
      {clientePdfPremium && <div className="model-overlay bundle-modal-overlay"><section role="dialog" aria-modal="true" aria-labelledby="bundle-budget-title" className="compact-premium-bundle">
        <div className="border-b p-4 compact-premium-bundle-heading"><div><h3 id="bundle-budget-title">Presupuestos en un PDF</h3><p className="mt-1 text-xs text-slate-500">{clientePdfPremium.nombre_razon_social}. Cada presupuesto conserva su detalle y total.</p></div><button type="button" aria-label="Cerrar presupuestos en un PDF" disabled={generandoPdfPremium} onClick={()=>{setClientePdfPremium(null);setPdfPremiumListo(null);}}><IconoOficial nombre="x"/></button></div>
        <div className="overflow-y-auto p-4 compact-premium-bundle-list">{presupuestos.filter(p=>p.cliente.trim().toLowerCase()===clientePdfPremium.nombre_razon_social.trim().toLowerCase()).map(p=><label key={p.presupuesto_id} className="mb-2 flex cursor-pointer items-center gap-3 rounded-lg border p-3"><input type="checkbox" disabled={generandoPdfPremium} checked={idsPdfPremium.includes(p.presupuesto_id)} onChange={e=>{setPdfPremiumListo(null);setIdsPdfPremium(ids=>e.target.checked?[...ids,p.presupuesto_id]:ids.filter(id=>id!==p.presupuesto_id));}}/><span className="flex-1 text-xs"><strong>{p.numero_presupuesto}</strong><span className="block text-slate-500">{fechaCortaCompacta(p.fecha)}</span></span><b className="bundle-amount">{importeDocumento(totalVigentePresupuesto(p),p.moneda)}</b></label>)}
        {!presupuestos.some(p=>p.cliente.trim().toLowerCase()===clientePdfPremium.nombre_razon_social.trim().toLowerCase()) && <p className="text-sm">Este cliente todavía no tiene presupuestos.</p>}</div>
        <div className="border-t p-4 compact-premium-bundle-footer"><p className="mb-3 text-xs text-slate-500">{idsPdfPremium.length<2?'Seleccioná al menos 2 presupuestos.':`${idsPdfPremium.length} presupuestos seleccionados`}</p>
          {mostrarOpcionesCompartir && !pdfPremiumListo && <p className="mb-3 text-xs">Generá el PDF. Después tocá Compartir y elegí WhatsApp.</p>}
          <div className="bundle-actions"><button type="button" disabled={generandoPdfPremium} onClick={()=>{setClientePdfPremium(null);setPdfPremiumListo(null);}} className="rounded-lg border px-3 py-2 text-xs model-secondary-button">Cerrar</button>
          {!pdfPremiumListo ? <><button type="button" disabled={idsPdfPremium.length<2 || generandoPdfPremium} onClick={()=>{if(window.matchMedia('(pointer: coarse)').matches && !mostrarOpcionesCompartir){setMostrarOpcionesCompartir(true);return;}void crearPdfPremiumSeleccionado();}} className="rounded-lg bg-blue-600 px-3 py-2 text-xs font-bold text-white disabled:opacity-40 model-primary-button">{generandoPdfPremium?'Generando…':mostrarOpcionesCompartir?'Generar y abrir PDF':'Generar PDF'}</button></> : <><a href={pdfPremiumListo.url} target="_blank" rel="noopener noreferrer" className="bundle-open"><IconoOficial nombre="file-text"/>Abrir PDF</a><button type="button" onClick={()=>void compartirPdfPremium()} className="bundle-share">WhatsApp</button></>}
          </div></div></section></div>}
      {/* GENERADOR DE PRESUPUESTO — formulario único */}
      <style>{`#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .operation-success{position:fixed!important;inset:auto!important;top:50%!important;left:50%!important;transform:translate(-50%,-50%)!important;margin:0!important;width:min(520px,calc(100% - 40px))!important;max-width:520px!important;height:auto!important;min-height:0!important;max-height:calc(100dvh - 40px)!important;border:0!important;border-radius:24px!important;padding:0!important;background:linear-gradient(155deg,#4d2bc8 0%,#6243dd 55%,#7756e4 100%)!important;color:#fff!important;overflow:hidden!important;box-shadow:0 24px 80px #21114355!important;box-sizing:border-box!important;}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .operation-success[open]{display:flex!important;flex-direction:column!important;}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .operation-success::backdrop{background:#1e143b88!important;backdrop-filter:blur(5px)!important;}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .operation-success :is(h2,h3,strong,b,dt,dd,p,small,span,a,summary){color:inherit!important;}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .operation-success>header{position:relative!important;display:flex!important;flex-direction:column!important;align-items:center!important;gap:14px!important;text-align:center!important;background:transparent!important;border:0!important;padding:38px 28px 16px!important;flex-shrink:0!important;}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .operation-success>header>button{position:absolute!important;right:14px!important;top:14px!important;width:36px!important;height:36px!important;min-height:36px!important;padding:7px!important;border:0!important;border-radius:50%!important;background:#ffffff16!important;color:#fff!important;}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .operation-success>header h2{font-size:26px!important;line-height:1.22!important;font-weight:700!important;margin:6px 0 0!important;}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .operation-success>header small{font-size:12px!important;opacity:.8!important;line-height:1.5!important;}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .operation-success .operation-success-symbol,#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .operation-success .financial-record-icon,#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .operation-success .budget-created-check{display:grid!important;place-items:center!important;width:68px!important;height:68px!important;min-width:68px!important;margin:0 auto 4px!important;border-radius:50%!important;background:#4ecb90!important;color:white!important;box-shadow:0 0 0 9px #ffffff12!important;}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .operation-success :is(.operation-success-symbol,.financial-record-icon,.budget-created-check)>svg{width:36px!important;height:36px!important;min-width:36px!important;max-width:36px!important;stroke-width:2.4!important;}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .operation-success .operation-success-brand{font-size:17px!important;font-weight:700!important;letter-spacing:.1px!important;}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .operation-success .budget-created-header{padding:20px 24px 6px!important;align-items:flex-start!important;}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .operation-success .budget-created-content{display:block!important;overflow-y:auto!important;min-height:0!important;padding:0 28px!important;background:transparent!important;}

  "monitor-smartphone": <><path d="M18 8V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h8" /><path d="M10 19v-3.96 3.15" /><path d="M7 19h5" /><rect width="6" height="10" x="16" y="12" rx="2" /></>, // https://lucide.dev/icons/monitor-smartphone
  "package-search": <><path d="M12 22V12" /><path d="M20.27 18.27 22 20" /><path d="M21 10.498V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.729l7 4a2 2 0 0 0 2 .001l.98-.559" /><path d="M3.29 7 12 12l8.71-5" /><path d="m7.5 4.27 8.997 5.148" /><circle cx="18.5" cy="16.5" r="2.5" /></>, // https://lucide.dev/icons/package-search
  "receipt-text": <><path d="M13 16H8" /><path d="M14 8H8" /><path d="M16 12H8" /><path d="M4 3a1 1 0 0 1 1-1 1.3 1.3 0 0 1 .7.2l.933.6a1.3 1.3 0 0 0 1.4 0l.934-.6a1.3 1.3 0 0 1 1.4 0l.933.6a1.3 1.3 0 0 0 1.4 0l.933-.6a1.3 1.3 0 0 1 1.4 0l.934.6a1.3 1.3 0 0 0 1.4 0l.933-.6A1.3 1.3 0 0 1 19 2a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1 1.3 1.3 0 0 1-.7-.2l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.934.6a1.3 1.3 0 0 1-1.4 0l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-1.4 0l-.934-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-.7.2 1 1 0 0 1-1-1z" /></>, // https://lucide.dev/icons/receipt-text
  "save": <><path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z" /><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7" /><path d="M7 3v4a1 1 0 0 0 1 1h7" /></>, // https://lucide.dev/icons/save
  "search": <><path d="m21 21-4.34-4.34" /><circle cx="11" cy="11" r="8" /></>, // https://lucide.dev/icons/search
  "send": <><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z" /><path d="m21.854 2.147-10.94 10.939" /></>, // https://lucide.dev/icons/send
  "shield-check": <><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /><path d="m9 12 2 2 4-4" /></>, // https://lucide.dev/icons/shield-check
  "sliders-horizontal": <><path d="M10 5H3" /><path d="M12 19H3" /><path d="M14 3v4" /><path d="M16 17v4" /><path d="M21 12h-9" /><path d="M21 19h-5" /><path d="M21 5h-7" /><path d="M8 10v4" /><path d="M8 12H3" /></>, // https://lucide.dev/icons/sliders-horizontal
  "square-pen": <><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z" /></>, // https://lucide.dev/icons/square-pen
  "trash-2": <><path d="M10 11v6" /><path d="M14 11v6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M3 6h18" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></>, // https://lucide.dev/icons/trash-2
  "triangle-alert": <><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" /><path d="M12 9v4" /><path d="M12 17h.01" /></>, // https://lucide.dev/icons/triangle-alert
  "user-round": <><circle cx="12" cy="8" r="5" /><path d="M20 21a8 8 0 0 0-16 0" /></>, // https://lucide.dev/icons/user-round
  "user-round-plus": <><path d="M2 21a8 8 0 0 1 13.292-6" /><circle cx="10" cy="8" r="5" /><path d="M19 16v6" /><path d="M22 19h-6" /></>, // https://lucide.dev/icons/user-round-plus
  "users": <><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><path d="M16 3.128a4 4 0 0 1 0 7.744" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><circle cx="9" cy="7" r="4" /></>, // https://lucide.dev/icons/users
  "x": <><path d="M18 6 6 18" /><path d="m6 6 12 12" /></>, // https://lucide.dev/icons/x
} as const;
type NombreIconoOficial = keyof typeof ICONOS_OFICIALES;

// A single sizing and drawing policy shared by landing, access screens and dashboard.
const ESTILOS_ICONOS_OFICIALES = `
  svg.mioficio-lucide-icon {display:inline-block!important;box-sizing:border-box;width:var(--mioficio-icon-size,18px)!important;height:var(--mioficio-icon-size,18px)!important;min-width:var(--mioficio-icon-size,18px)!important;max-width:var(--mioficio-icon-size,18px)!important;min-height:var(--mioficio-icon-size,18px)!important;max-height:var(--mioficio-icon-size,18px)!important;flex:0 0 var(--mioficio-icon-size,18px)!important;fill:none!important;stroke:currentColor!important;stroke-width:1.8!important;stroke-linecap:round!important;stroke-linejoin:round!important;vertical-align:middle;pointer-events:none;overflow:visible;}
  svg.mioficio-lucide-icon > * {fill:none!important;stroke:inherit!important;stroke-width:inherit!important;stroke-linecap:inherit!important;stroke-linejoin:inherit!important;}
  :is(.client-card-actions,.budget-table-actions,.quotes-mobile-actions,.budget-state-icon,.mioficio-search-field) svg.mioficio-lucide-icon,svg.mioficio-lucide-icon.budget-state-icon {--mioficio-icon-size:16px!important;}
  :is(.app-account,.app-nav,.premium-hub-nav,.profile-v2-payment,.budget-v2-payment) svg.mioficio-lucide-icon {--mioficio-icon-size:18px!important;}
  :is(.premium-hub-icon,.lo-feature-icon,.lo-step-icon) svg.mioficio-lucide-icon {--mioficio-icon-size:24px!important;}
  :is(.lo-feature-benefit,.lo-trust,.lo-plan-security,.lo-plan-card li,.premium-plan-benefit-icon,.premium-plan-security) svg.mioficio-lucide-icon {--mioficio-icon-size:16px!important;}
  .budget-step-arrow svg.mioficio-lucide-icon {--mioficio-icon-size:24px!important;}
  .budget-desktop-progress-number svg.mioficio-lucide-icon {--mioficio-icon-size:14px!important;}
  .account-access-photo svg.mioficio-lucide-icon {--mioficio-icon-size:28px!important;}
  :is(.client-card-actions,.budget-table-actions,.quotes-mobile-actions) button {gap:6px!important;}
  @media(max-width:1023px) {.mi-oficio-ui>nav svg.mioficio-lucide-icon {--mioficio-icon-size:20px!important;}}
`;

function IconoOficial({ nombre, className = '', width = 18 }: { nombre: NombreIconoOficial; className?: string; width?: number | string; height?: number | string }) {
  const estilo: CSSProperties = { '--mioficio-icon-size': typeof width === 'number' ? `${width}px` : /^\d+$/.test(width) ? `${width}px` : width } as CSSProperties;
  return <svg className={`ui-icon mioficio-lucide-icon ${className}`} style={estilo} data-icon={nombre} xmlns="http://www.w3.org/2000/svg" width={width} height={width} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth={1.8} strokeLinecap="round" strokeLinejoin="round" aria-hidden="true" focusable="false">{ICONOS_OFICIALES[nombre]}</svg>;
}


function IconoCerrar() {
  return <IconoOficial nombre="x" />;
}

function IconoAvisoFormulario() {
  return <IconoOficial nombre="triangle-alert" className="budget-notice-icon" width={16} height={16} />;
}

function IconoMedioPago({ tipo }: { tipo: 'acepta_efectivo' | 'acepta_cheque' | 'acepta_transferencia' }) {
  return <IconoOficial nombre={tipo === "acepta_efectivo" ? "banknote" : tipo === "acepta_cheque" ? "receipt-text" : "arrow-left-right"} className="profile-v2-payment-icon" width={24} height={24} />;
}

function IconoPanel({ name, className = 'w-4 h-4' }: { name: 'home'|'clients'|'quotes'|'settings'|'profile'|'plus'|'search'|'logout'|'identity'|'payments'|'series'; className?: string }) {
  const iconos = {"home":"house","clients":"users","quotes":"file-text","settings":"sliders-horizontal","profile":"user-round","plus":"circle-plus","search":"search","logout":"log-out","identity":"id-card","payments":"credit-card","series":"list-ordered"} as const; return <IconoOficial nombre={iconos[name]} className={className} />;
}

function IconoEstadoPresupuesto({ estado, className = 'w-3.5 h-3.5' }: { estado: string; className?: string }) {
  const iconos: Partial<Record<string, NombreIconoOficial>> = {"Enviado":"send","En revisión":"file-clock","Aceptado":"circle-check","Rechazado":"circle-x","Vencido":"clock","Pagado":"banknote"}; return <IconoOficial nombre={iconos[estado] || "file-text"} className={`budget-state-icon ${className}`} width={16} height={16} />;
}

function SelectorEstadoPresupuesto({ estado, etiqueta, onChange }: { etiqueta?:string; estado: string; onChange: (estado: EstadoPresupuesto) => void }) {
  const opciones: EstadoPresupuesto[] = ['Aceptado', 'Pagado'];
  const [abierto, setAbierto] = useState(false);
  const [posicion, setPosicion] = useState({ left: 0, top: 0 });
  const botonRef = useRef<HTMLButtonElement | null>(null);

  const estilos = (valor: string) =>
    valor === 'Pagado' ? 'bg-emerald-50 text-emerald-700 border-emerald-200 hover:bg-emerald-100' :
    valor === 'Aceptado' ? 'bg-blue-50 text-blue-700 border-blue-200 hover:bg-blue-100' :
    valor === 'Rechazado' ? 'bg-red-50 text-red-700 border-red-200 hover:bg-red-100' :
    valor === 'Vencido' ? 'bg-slate-100 text-slate-600 border-slate-200 hover:bg-slate-200' :
    valor === 'Enviado' ? 'bg-violet-50 text-violet-700 border-violet-200 hover:bg-violet-100' :
    valor === 'En revisión' ? 'bg-orange-50 text-orange-700 border-orange-200 hover:bg-orange-100' :
    'bg-blue-50 text-blue-700 border-blue-200 hover:bg-blue-100';

  useEffect(() => {
    if (!abierto || !botonRef.current) return;

    const actualizarPosicion = () => {
      if (!botonRef.current) return;
      const rect = botonRef.current.getBoundingClientRect();
      const menuWidth = 164;
      const menuHeight = 96;
      const margen = 8;

      // Siempre prioriza abrir hacia arriba. Si no hay espacio suficiente,
      // lo mantiene dentro de la ventana sin quedar atrapado por overflow.
      const left = Math.min(
        Math.max(margen, rect.left),
        window.innerWidth - menuWidth - margen
      );
      const top = Math.max(
        margen,
        rect.top - menuHeight - 4
      );

      setPosicion({ left, top });
    };

    actualizarPosicion();
    window.addEventListener('resize', actualizarPosicion);
    window.addEventListener('scroll', actualizarPosicion, true);

    const cerrarAlHacerClickFuera = (event: MouseEvent) => {
      const target = event.target as Node;
      if (botonRef.current && !botonRef.current.contains(target)) {
        const menu = document.getElementById('selector-estado-presupuesto-menu');
        if (!menu || !menu.contains(target)) setAbierto(false);
      }
    };

    document.addEventListener('mousedown', cerrarAlHacerClickFuera);
    const cerrarConEscape=(event:KeyboardEvent)=>{if(event.key==='Escape'){setAbierto(false);botonRef.current?.focus();}};
    document.addEventListener('keydown',cerrarConEscape);

    return () => {
      window.removeEventListener('resize', actualizarPosicion);
      window.removeEventListener('scroll', actualizarPosicion, true);
      document.removeEventListener('mousedown', cerrarAlHacerClickFuera);
      document.removeEventListener('keydown',cerrarConEscape);
    };
  }, [abierto]);

  const abrirSelector = () => {
    if (!botonRef.current) return;
    const rect = botonRef.current.getBoundingClientRect();
    const menuWidth = 164;
    const menuHeight = 96;
    const margen = 8;

    setPosicion({
      left: Math.min(Math.max(margen, rect.left), window.innerWidth - menuWidth - margen),
      top: Math.max(margen, rect.top - menuHeight - 4),
    });
    setAbierto(v => !v);
  };

  if (estado === 'Cancelado') return <span className="compact-status compact-draft-status">Cancelado</span>;
  if (estado === 'Borrador') return <span className="compact-status compact-draft-status"><IconoOficial nombre="file-clock" />Borrador</span>;

  return (
    <div className="relative w-[96px] max-w-full">
      <style>{`
        .mi-oficio-ui.mioficio-model button.budget-state-trigger{height:26px!important;min-height:26px!important;padding:3px 6px!important;font-size:11px!important;line-height:16px!important;border-radius:7px!important;gap:4px!important;box-shadow:none!important}
        .mi-oficio-ui.mioficio-model button.budget-state-option{height:32px!important;min-height:32px!important;padding:4px 7px!important;font-size:12px!important;border-radius:6px!important;box-shadow:none!important}
        @media(max-width:767px){.mi-oficio-ui.mioficio-model button.budget-state-trigger{height:32px!important;min-height:32px!important}}


      `}</style>
      <button
        ref={botonRef}
        type="button"
        onClick={abrirSelector}
        aria-haspopup="listbox"
        aria-label={`Cambiar estado: ${etiqueta||estado}`}
        aria-expanded={abierto}
        className={`budget-state-trigger w-full h-7 rounded-md border px-2 flex items-center gap-1.5 text-[9px] font-semibold outline-none cursor-pointer transition ${estilos(estado)}`}
      >
        <IconoEstadoPresupuesto estado={estado} className="w-3.5 h-3.5 shrink-0" />
        <span className="truncate flex-1 text-left">{estado}</span>
        <IconoOficial nombre="chevron-down" className={`w-3 h-3 shrink-0 transition-transform ${abierto ? 'rotate-180' : ''}`} />
      </button>

      {etiqueta&&etiqueta!==estado&&<small className="budget-payment-caption">{etiqueta}</small>}
      {abierto && (
        <div
          id="selector-estado-presupuesto-menu"
          role="listbox"
          aria-label="Elegir estado del presupuesto"
          tabIndex={-1}
          onKeyDown={e=>{if(e.key==='Escape'){setAbierto(false);botonRef.current?.focus();}}}
          style={{ left: posicion.left, top: posicion.top }}
          className="fixed z-[9999] w-[164px] rounded-lg border border-slate-200 bg-white p-1 shadow-2xl shadow-slate-900/15"
        >
          {opciones.map(opcion => (
            <button
              key={opcion}
              type="button"
              role="option"
              aria-selected={opcion === estado}
              onClick={() => { onChange(opcion); setAbierto(false); }}
              className={`budget-state-option w-full h-8 px-2 rounded-md flex items-center gap-2 text-[10px] font-semibold transition ${opcion === estado ? 'bg-slate-50 text-slate-900' : 'text-slate-600 hover:bg-slate-50'}`}
            >
              <span className={`w-5 h-5 rounded-md flex items-center justify-center border ${estilos(opcion)}`}>
                <IconoEstadoPresupuesto estado={opcion} className="w-3.5 h-3.5" />
              </span>
              <span>{opcion}</span>
              {opcion === estado && (
                <IconoOficial nombre="check" className="w-3 h-3 ml-auto text-blue-600" />
              )}
            </button>
          ))}
        </div>
      )}


    </div>
  );
}

const autodetectarEntidadFinanciera = (input: string) => {
  if (!input || !input.trim()) return 'Cuenta Bancaria / Digital';
  const t = input.toUpperCase().trim();
  const soloNumeros = t.replace(/\D/g, '');

  if (soloNumeros.length >= 8) {
    const p8 = soloNumeros.slice(0, 8);
    const p3 = soloNumeros.slice(0, 3);

    if (p8.startsWith('0000003')) return 'Mercado Pago (CVU)';
    if (p8.startsWith('0000007')) return 'Ualá (CVU)';
    if (p8.startsWith('0000076')) return 'Personal Pay (CVU)';
    if (p8.startsWith('0000033')) return 'Lemon Cash (CVU)';
    if (p8.startsWith('0000045')) return 'N1u (CVU)';
    if (p8.startsWith('0000013')) return 'Prex (CVU)';
    if (p8.startsWith('0000039')) return 'BKR (CVU)';

    switch (p3) {
      case '007': return 'Banco Galicia';
      case '011': return 'Banco Nación (BNA)';
      case '014': return 'Banco Provincia';
      case '015': return 'ICBC Argentina';
      case '017': return 'Banco BBVA';
      case '020': return 'Banco Provincia de Córdoba';
      case '027': return 'Banco Supervielle';
      case '029': return 'Banco Ciudad';
      case '034': return 'Banco Patagonia';
      case '044': return 'Banco Hipotecario';
      case '045': return 'Naranja X';
      case '072': return 'Banco Santander';
      case '143': return 'Brubank';
      case '150': return 'HSBC Argentina';
      case '191': return 'Banco Credicoop';
      case '259': return 'Banco Itaú';
      case '285': return 'Banco Macro';
      case '299': return 'Banco Comafi';
      case '310': return 'Banco del Sol';
      case '389': return 'Banco Columbia';
      default:
        if (soloNumeros.length === 22) return `Entidad Financiera (CBU ${p3})`;
    }
  }

  if (t.includes('MP') || t.includes('MERCADOPAGO') || t.includes('MERCADO')) return 'Mercado Pago (CVU)';
  if (t.includes('UALA')) return 'Ualá (CVU)';
  if (t.includes('NARANJA') || t.includes('NX')) return 'Naranja X';
  if (t.includes('PERSONAL') || t.includes('PPAY')) return 'Personal Pay (CVU)';
  if (t.includes('LEMON')) return 'Lemon Cash (CVU)';
  if (t.includes('BRU') || t.includes('BRUBANK')) return 'Brubank';
  if (t.includes('GALICIA')) return 'Banco Galicia';
  if (t.includes('SANTANDER')) return 'Banco Santander';
  if (t.includes('BBVA')) return 'Banco BBVA';
  if (t.includes('MACRO')) return 'Banco Macro';
  if (t.includes('PROVINCIA') || t.includes('BAPRO') || t.includes('DNI')) return 'Banco Provincia / Cuenta DNI';
  if (t.includes('NACION') || t.includes('BNA')) return 'Banco Nación (BNA)';
  if (t.includes('ICBC')) return 'ICBC Argentina';
  if (t.includes('SUPERVIELLE')) return 'Banco Supervielle';
  if (t.includes('HIPOTECARIO')) return 'Banco Hipotecario';
  if (t.includes('PATAGONIA')) return 'Banco Patagonia';
  if (t.includes('COMAFI')) return 'Banco Comafi';
  if (t.includes('PREX')) return 'Prex (CVU)';
  if (t.includes('MODO')) return 'MODO';

  return 'Cuenta Digital / Bancaria';
};

function MiOficioLogo({ className = "w-8 h-8" }: { className?: string }) {
  return (
    <svg className={className} viewBox="0 0 520 140" fill="none" xmlns="http://www.w3.org/2000/" preserveAspectRatio="xMidYMid meet" aria-label="Mi Oficio">
      <defs>
        <linearGradient id="miOficioBlueGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stopColor="#1e40af" />
          <stop offset="50%" stopColor="#2563eb" />
          <stop offset="100%" stopColor="#3b82f6" />
        </linearGradient>
        <linearGradient id="miOficioSilverGrad" x1="0%" y1="100%" x2="100%" y2="0%">
          <stop offset="0%" stopColor="#64748b" />
          <stop offset="100%" stopColor="#cbd5e1" />
        </linearGradient>
        <filter id="miOficioShadow" x="-10%" y="-10%" width="120%" height="120%">
          <feDropShadow dx="2" dy="4" stdDeviation="4" floodColor="#0f172a" floodOpacity="0.15" />
        </filter>
      </defs>
      <g transform="translate(15, 15)" filter="url(#miOficioShadow)">
        <polygon points="55,5 95,27.5 95,72.5 55,95 15,72.5 15,27.5" fill="url(#miOficioBlueGrad)" stroke="#ffffff" strokeWidth="3" />
        <circle cx="55" cy="50" r="24" fill="none" stroke="url(#miOficioSilverGrad)" strokeWidth="4" strokeDasharray="6,4" />
        <path d="M 38,65 L 38,35 L 55,52 L 72,35 L 72,65" fill="none" stroke="#ffffff" strokeWidth="7" strokeLinecap="round" strokeLinejoin="round" />
      </g>
      <g transform="translate(130, 82)">
        <text x="0" y="0" fontFamily="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" fontSize="46" fontWeight="900" fill="#0f172a" letterSpacing="-1">
          MI <tspan fill="#2563eb">OFICIO</tspan>
        </text>
        <text x="2" y="24" fontFamily="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" fontSize="11" fontWeight="700" fill="#64748b" letterSpacing="3.5">
          PLATAFORMA DE GESTIÓN COMERCIAL
        </text>
      </g>
    </svg>
  );
}

function MiOficioMark({ className = "w-8 h-8" }: { className?: string }) {
  return (
    <svg className={className} viewBox="0 0 125 125" fill="none" xmlns="http://www.w3.org/2000/" preserveAspectRatio="xMidYMid meet" aria-label="Mi Oficio">
      <defs>
        <linearGradient id="miOficioMarkBlue" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stopColor="#1e40af" />
          <stop offset="50%" stopColor="#2563eb" />
          <stop offset="100%" stopColor="#3b82f6" />
        </linearGradient>
        <linearGradient id="miOficioMarkSilver" x1="0%" y1="100%" x2="100%" y2="0%">
          <stop offset="0%" stopColor="#64748b" />
          <stop offset="100%" stopColor="#cbd5e1" />
        </linearGradient>
        <filter id="miOficioMarkShadow" x="-10%" y="-10%" width="120%" height="120%">
          <feDropShadow dx="2" dy="4" stdDeviation="4" floodColor="#0f172a" floodOpacity="0.15" />
        </filter>
      </defs>
      <g transform="translate(5, 5)" filter="url(#miOficioMarkShadow)">
        <polygon points="57.5,5 102.5,30.3 102.5,80.7 57.5,106 12.5,80.7 12.5,30.3" fill="url(#miOficioMarkBlue)" stroke="#ffffff" strokeWidth="3" />
        <circle cx="57.5" cy="55" r="26" fill="none" stroke="url(#miOficioMarkSilver)" strokeWidth="4" strokeDasharray="6,4" />
        <path d="M 39,71 L 39,39 L 57.5,57 L 76,39 L 76,71" fill="none" stroke="#ffffff" strokeWidth="7" strokeLinecap="round" strokeLinejoin="round" />
      </g>
    </svg>
  );
}


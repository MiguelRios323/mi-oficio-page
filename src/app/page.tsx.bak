#mioficio-dashboard.mio-compact-v2 #perfil-profesional .compact-logo-upload{width:100%;color:#6541df!important;cursor:pointer}#mioficio-dashboard.mio-compact-v2 #perfil-profesional .compact-logo-upload svg{width:23px!important;height:23px!important;max-width:none!important;min-width:0!important}
#mioficio-dashboard.mio-compact-v2 #perfil-profesional .compact-logo-upload span{display:grid;gap:4px;text-align:left}

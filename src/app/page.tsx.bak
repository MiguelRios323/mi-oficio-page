function IconoEliminar() {
  return <IconoOficial nombre="trash-2" className="client-delete-svg" width={16} height={16} />;
}

function IconoBusqueda() {
  return <IconoOficial nombre="search" className="mioficio-search-svg" width={16} height={16} />;
}

function IconoHerramientaPremium({ nombre }: { nombre: 'logo' | 'series' | 'unir' | 'catalogo' | 'flecha' | 'ver' | 'exportar' | 'informe' }) {
  const iconos = {"logo":"image","series":"list-ordered","unir":"files","catalogo":"package-search","flecha":"arrow-up-right","ver":"eye","exportar":"download","informe":"chart-no-axes-combined"} as const; return <IconoOficial nombre={iconos[nombre]} className="premium-tool-svg" width={24} height={24} />;
}

function IconoLanding({ nombre, className = '' }: { nombre: 'presupuesto' | 'clientes' | 'seguimiento' | 'informe' | 'crear' | 'enviar' | 'gestionar' | 'dispositivos' | 'seguridad' | 'nube' | 'free' | 'premium' | 'acceso' | 'flecha' | 'ver' | 'check' | 'desplegar' | 'pdf' | 'historial' | 'estado' | 'logo' | 'series' | 'unir' | 'catalogo' | 'avisos' | 'empezar' | 'exportar'; className?: string }) {
  const iconos = {"presupuesto":"file-text","clientes":"users","seguimiento":"clock","informe":"chart-no-axes-combined","crear":"user-round-plus","enviar":"send","gestionar":"clipboard-list","dispositivos":"monitor-smartphone","seguridad":"shield-check","nube":"cloud","free":"circle-check","premium":"crown","acceso":"log-in","flecha":"arrow-right","ver":"eye","check":"check","desplegar":"chevron-down","pdf":"file-text","historial":"history","estado":"circle-check","logo":"image","series":"list-ordered","unir":"files","catalogo":"package-search","avisos":"bell","empezar":"circle-plus","exportar":"download"} as const; return <IconoOficial nombre={iconos[nombre]} className={`lo-icon ${className}`} width={20} height={20} />;
}

type PlanPremium = 'daily' | 'weekly' | 'monthly' | 'yearly';
const esPlanPremium = (valor: unknown): valor is PlanPremium => ['daily', 'weekly', 'monthly', 'yearly'].includes(valor as string);

function LandingPage({ onGoToLogin, onGoToRegister, onElegirPremium }: { onGoToLogin: () => void; onGoToRegister: () => void; onElegirPremium: (plan: PlanPremium) => void }) {
  const [planLanding, setPlanLanding] = useState<PlanPremium>('monthly');
  const [ejemploLanding, setEjemploLanding] = useState<'logo' | 'series' | 'unir' | 'catalogo' | 'exportar' | null>(null);
  const dialogoEjemploLanding = useRef<HTMLDialogElement | null>(null);
  useEffect(() => {
    const dialogo = dialogoEjemploLanding.current;
    if (!dialogo) return;
    if (ejemploLanding && !dialogo.open) dialogo.showModal();
    else if (!ejemploLanding && dialogo.open) dialogo.close();
  }, [ejemploLanding]);
  const [terminosAbiertos, setTerminosAbiertos] = useState(false);
  const [apartadoSoporte, setApartadoSoporte] = useState<'contacto' | 'terminos'>('contacto');
  const iniciarSolicitudServicio = (tipo: 'baja' | 'arrepentimiento') => {
    setApartadoSoporte('contacto');
    setContacto(prev => ({...prev, mensaje: tipo === 'baja' ? "Solicitud de baja del servicio Premium\n\nAl equipo de atención de MiOficio:\n\nSolicito la baja del servicio Premium asociado a la cuenta indicada a continuación.\n\nCorreo asociado a la cuenta: \nPlan contratado: \nFecha de contratación: \n\nSolicito la confirmación de recepción y que se me informe la fecha efectiva de la baja.\n\nSaludos cordiales." : "Solicitud de arrepentimiento de contratación\n\nAl equipo de atención de MiOficio:\n\nPor medio de la presente, solicito ejercer mi derecho de arrepentimiento y dejar sin efecto la contratación indicada a continuación, con el reintegro que corresponda.\n\nCorreo asociado a la cuenta: \nPlan contratado: \nFecha de contratación: \nReferencia de pago (si está disponible): \n\nSolicito la confirmación de recepción y la información necesaria para continuar con el trámite.\n\nSaludos cordiales."}));
    setResultadoContacto(null);
    window.requestAnimationFrame(() => { document.getElementById('lo-contacto')?.scrollIntoView({ behavior: 'smooth', block: 'start' }); document.getElementById('lo-contact-name')?.focus({ preventScroll: true }); });
  };
  const [contacto, setContacto] = useState({ nombre: '', email: '', mensaje: '', website: '' });
  const [correoContactoDisponible, setCorreoContactoDisponible] = useState(false);
  const [verificandoContacto, setVerificandoContacto] = useState(true);
  const [enviandoContacto, setEnviandoContacto] = useState(false);
  const [resultadoContacto, setResultadoContacto] = useState<{ error: boolean; texto: string } | null>(null);
  useEffect(() => {
    const controlador = new AbortController();
    fetch('/api/contacto', { signal: controlador.signal, cache: 'no-store' })
      .then(async r => r.ok ? r.json() : { disponible: false })
      .then(data => { setCorreoContactoDisponible(data.disponible === true); setVerificandoContacto(false); })
      .catch(() => { if (!controlador.signal.aborted) { setCorreoContactoDisponible(false); setVerificandoContacto(false); } });
    return () => controlador.abort();
  }, []);
  const consultaWhatsapp = `https://wa.me/5493425057930?text=${encodeURIComponent(`Hola, MiOficio. Mi nombre es ${contacto.nombre.trim()}.\nMi correo es ${contacto.email.trim()}.\n\n${contacto.mensaje.trim()}`)}`;
  const enviarContacto = async (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();
    if (enviandoContacto || verificandoContacto) return;
    if (!contacto.nombre.trim() || !contacto.mensaje.trim()) { setResultadoContacto({ error: true, texto: 'Completá tu nombre y mensaje.' }); return; }
    if (!correoContactoDisponible) { window.open(consultaWhatsapp, '_blank', 'noopener,noreferrer'); setResultadoContacto({ error: false, texto: 'Se abrió WhatsApp con tu consulta preparada. Confirmá el envío allí.' }); return; }
    setEnviandoContacto(true); setResultadoContacto(null);
    try {
      const response = await fetch('/api/contacto', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(contacto), signal: AbortSignal.timeout(15000) });
      const result = await response.json();
      if (!response.ok || result.ok !== true) throw new Error(result.error || 'No pudimos enviar tu consulta. Podés contactarnos por WhatsApp.');
      setResultadoContacto({ error: false, texto: 'Tu consulta fue enviada. Gracias por contactarnos.' });
      setContacto({ nombre: '', email: '', mensaje: '', website: '' });
    } catch (error) { setResultadoContacto({ error: true, texto: error instanceof Error ? error.message : 'No pudimos enviar tu consulta. Intentá nuevamente.' }); }
    finally { setEnviandoContacto(false); }
  };
  return <div className="landing-oficio" id="landing-inicio">
    <style>{`
      .landing-oficio{font-family:Inter,Arial,sans-serif;color:#101b35;background:#fff;overflow-x:hidden;line-height:1.5}.landing-oficio *{box-sizing:border-box}.landing-oficio button,.landing-oficio a{font:inherit;-webkit-tap-highlight-color:transparent}.landing-oficio button{cursor:pointer}.landing-oficio a{text-decoration:none;color:inherit}.landing-oficio .lo-wrap{width:min(1160px,100%);margin:0 auto;padding:0 28px}.landing-oficio :is(h1,h2,h3,p){margin:0}.landing-oficio .ui-icon{}.landing-oficio :is(button,a,summary):focus-visible{outline:3px solid #93b4ff;outline-offset:4px}.landing-oficio section[id]{scroll-margin-top:84px}
      .lo-header{position:sticky;top:0;z-index:40;background:#ffffffed;backdrop-filter:blur(14px);border-bottom:1px solid #e8edf4}.lo-header>.lo-wrap{height:76px;display:flex;align-items:center;justify-content:space-between;gap:22px}.lo-brand{display:block;border:0;background:none;padding:0;text-align:left;flex-shrink:0}.lo-brand img{display:block;width:218px;height:auto}.lo-nav{display:flex;align-items:center;gap:24px;margin-left:auto;font-size:12px;font-weight:600;color:#475569}.lo-nav a:hover{color:#1850ff}.lo-header-actions{display:flex;gap:8px;align-items:center}.landing-oficio .lo-primary,.landing-oficio .lo-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:9px;padding:12px 18px;font-size:13px;font-weight:700;line-height:1.3;min-height:44px;transition:background .15s,box-shadow .15s}.lo-primary{border:1px solid #1850ff;background:#1850ff;color:#fff!important;box-shadow:0 3px 10px #1850ff12}.lo-primary:hover{background:#1245db}.lo-secondary{border:1px solid #cbd5e1;background:#fff;color:#1e40af!important}.lo-secondary:hover{background:#f5f8ff}.lo-login{border:0;background:none;padding:8px;font-size:12px!important;color:#334155;font-weight:600!important}.lo-header .lo-primary{min-height:38px;padding:10px 14px;font-size:12px}
      .lo-hero{background:linear-gradient(100deg,#f7faff 0%,#fff 56%);border-bottom:1px solid #edf1f7}.lo-hero-grid{display:grid;grid-template-columns:.9fr 1.1fr;align-items:center;gap:32px;padding:48px 0 42px}.lo-eyebrow{font-size:10px;letter-spacing:.13em;text-transform:uppercase;font-weight:750;color:#60749b;margin-bottom:15px!important}.lo-hero h1{font-size:clamp(36px,4.1vw,54px);line-height:1.08;letter-spacing:-.045em;font-weight:800;max-width:460px}.lo-hero h1 span{color:#1850ff}.lo-description{font-size:17px;color:#51617b;line-height:1.6;max-width:395px;margin-top:19px!important}.lo-hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:25px}.lo-trust{display:flex;flex-wrap:wrap;gap:14px;font-size:10px;color:#64748b;margin-top:22px}.lo-trust>span{display:flex;align-items:center;gap:5px}.lo-trust .ui-icon{color:#1850ff}
      .lo-hero-visual{position:relative;min-width:0;padding-bottom:28px}.lo-hero-photo{display:block;width:100%;height:360px;object-fit:cover;object-position:55% center;border-radius:16px}.lo-budget-preview{position:absolute;right:14px;bottom:0;width:230px;background:#fff;border:1px solid #e2e8f0;border-radius:12px;box-shadow:0 14px 40px #101b3522;padding:17px}.lo-budget-preview header{display:flex;align-items:center;justify-content:space-between;gap:10px;border-bottom:1px solid #e2e8f0;padding-bottom:10px;margin-bottom:10px;font-size:12px}.lo-budget-preview header span{font-size:9px;color:#94a3b8}.lo-budget-client{font-size:10px;color:#64748b;margin-bottom:10px!important}.lo-budget-client strong{display:block;color:#334155;margin-top:2px;font-size:11px}.lo-budget-line{display:flex;justify-content:space-between;gap:9px;font-size:10px;padding:7px 0;border-bottom:1px solid #f1f5f9}.lo-budget-total{display:flex;justify-content:space-between;gap:8px;padding:9px;border-radius:6px;background:#eef3ff;margin-top:10px;font-size:11px;font-weight:750;color:#173576}.lo-budget-preview footer{display:flex;align-items:center;justify-content:center;gap:5px;color:#1850ff;font-size:10px;font-weight:650;margin-top:12px}.lo-budget-preview footer .ui-icon{}.lo-demo-label{font-size:8px;text-align:center;color:#94a3b8;margin-top:7px!important}
      .lo-features{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;padding-top:30px!important;padding-bottom:32px!important}.lo-feature-icon{display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:10px;background:#edf3ff;color:#1850ff;margin-bottom:12px}.lo-feature-icon .ui-icon{}.lo-features h3{font-size:14px;font-weight:750;margin-bottom:7px}.lo-features p{font-size:12px;color:#64748b;line-height:1.6}.lo-feature-premium{display:inline-block;font-size:8px;background:#edf2ff;color:#4338ca;padding:2px 5px;border-radius:4px;margin-left:4px;vertical-align:middle}
      .lo-process{display:grid;grid-template-columns:1.1fr repeat(3,1fr);gap:24px;padding:26px 28px;border:1px solid #e7edf7;border-radius:14px;background:#f3f7ff}.lo-process h2{font-size:23px;line-height:1.2;letter-spacing:-.025em;margin-bottom:9px}.lo-process p{font-size:12px;color:#64748b;line-height:1.6}.lo-step-icon{display:flex;gap:9px;align-items:center;color:#1850ff;margin-bottom:11px}.lo-step-icon>span{display:flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:#dce8ff;font-size:10px;font-weight:750}.lo-process h3{font-size:14px;margin-bottom:6px}.lo-plans{display:grid;grid-template-columns:.9fr 1fr 1.1fr;gap:20px;align-items:center;padding-top:38px!important;padding-bottom:36px!important}.lo-plans-intro h2{font-size:29px;line-height:1.15;letter-spacing:-.035em;max-width:240px}.lo-plans-intro>p:last-child{font-size:13px;color:#64748b;margin-top:14px;max-width:250px}.lo-plan-card{border:1px solid #e2e8f0;border-radius:12px;padding:21px;background:white;align-self:stretch;display:flex;flex-direction:column;min-width:0}.lo-plan-card.is-premium{background:#f3f7ff;border-color:#b7cdff}.lo-plan-heading{display:flex;align-items:center;justify-content:space-between;gap:6px}.lo-plan-heading h3{font-size:19px}.lo-plan-heading>span{background:#1850ff;color:white;border-radius:12px;font-size:8px;padding:4px 7px;font-weight:700}.lo-plan-subtitle{font-size:11px;color:#64748b;margin-top:4px!important}.lo-plan-price{font-size:28px;font-weight:800;letter-spacing:-.03em;margin-top:13px!important;line-height:1.2}.lo-plan-price small{font-size:10px;font-weight:500;letter-spacing:0;color:#64748b}.lo-plan-card ul{list-style:none;padding:0;margin:17px 0 19px;display:grid;gap:8px;font-size:11px;color:#475569}.lo-plan-card li{display:flex;align-items:flex-start;gap:6px}.lo-plan-card li .ui-icon{color:#1850ff;margin-top:2px}.lo-plan-card .lo-primary,.lo-plan-card .lo-secondary{width:100%;margin-top:auto;font-size:12px;padding:10px;min-height:38px}.lo-plan-durations{border-top:1px solid #d9e4f7;padding-top:10px;margin:0 0 15px;font-size:9px;color:#64748b;display:grid;grid-template-columns:1fr 1fr;gap:5px}.lo-plan-durations span:last-child{font-weight:700;color:#1e40af}.lo-plan-security{font-size:10px;color:#64748b;text-align:center;margin:0 0 26px!important}.lo-faq{max-width:800px;margin:0 auto;padding:18px 28px 34px}.lo-faq h2{font-size:21px;margin-bottom:13px;text-align:center;letter-spacing:-.025em}.lo-faq details{border-bottom:1px solid #e2e8f0;padding:12px 0}.lo-faq summary{display:flex;align-items:center;justify-content:space-between;gap:12px;cursor:pointer;list-style:none;font-size:12px;font-weight:650}.lo-faq summary::-webkit-details-marker{display:none}.lo-faq details[open] summary .ui-icon{transform:rotate(180deg)}.lo-faq-intro{max-width:580px;margin:0 auto 16px!important;text-align:center;color:#64748b;font-size:13px;line-height:1.65}.lo-faq-answer{padding-right:28px}.lo-faq details p{font-size:12px;color:#64748b;line-height:1.6;margin-top:9px}.lo-footer{border-top:1px solid #e2e8f0;background:#fafcff}.lo-footer>.lo-wrap{display:flex;align-items:center;justify-content:space-between;gap:18px;padding-top:20px;padding-bottom:20px}.lo-footer img{display:block;width:155px;height:auto}.lo-footer p{font-size:10px;color:#64748b}.lo-footer a{font-size:10px;color:#1850ff}
      @media(max-width:1000px){.lo-nav{gap:14px}.lo-brand img{width:190px}.lo-hero-grid{gap:22px}.lo-hero-photo{height:340px}.lo-trust{gap:8px}.lo-process{gap:18px;padding:23px}.lo-plans{gap:14px}.lo-plan-card{padding:17px}}
      @media(max-width:760px){.landing-oficio .lo-wrap{padding-left:18px;padding-right:18px}.lo-header>.lo-wrap{height:62px;gap:9px}.lo-brand img{width:155px}.lo-nav{display:none}.lo-header-actions{gap:2px}.lo-login{font-size:10px!important;padding:7px}.lo-header .lo-primary{font-size:10px;min-height:32px;padding:8px 9px;border-radius:7px}.lo-hero-grid{grid-template-columns:1fr;padding:28px 0 24px;gap:25px}.lo-hero h1{font-size:40px;max-width:420px}.lo-eyebrow{font-size:9px;margin-bottom:12px!important}.lo-description{font-size:15px;margin-top:14px!important;max-width:420px}.lo-hero-actions{margin-top:20px}.lo-trust{font-size:9px;margin-top:16px;gap:13px}.lo-hero-photo{height:290px;object-position:55% center;border-radius:12px}.lo-hero-visual{padding-bottom:32px}.lo-budget-preview{width:205px;padding:14px;right:10px;bottom:0}.lo-features{grid-template-columns:repeat(2,minmax(0,1fr));gap:25px 18px;padding-top:26px!important;padding-bottom:26px!important}.lo-features p{font-size:11px}.lo-process{grid-template-columns:1fr;gap:18px;padding:22px}.lo-process>div:first-child{margin-bottom:2px}.lo-process>article{display:grid;grid-template-columns:54px 1fr;gap:0 9px}.lo-step-icon{grid-row:1/3;margin:0;align-self:start}.lo-process>article p{grid-column:2}.lo-process h2{max-width:260px;font-size:24px}.lo-plans{grid-template-columns:1fr 1fr;align-items:stretch;padding-top:28px!important;gap:13px}.lo-plans-intro{grid-column:1/-1;padding-bottom:4px}.lo-plans-intro h2{max-width:none;font-size:27px}.lo-plans-intro>p:last-child{max-width:none;margin-top:10px}.lo-plan-card{padding:15px}.lo-plan-price{font-size:25px}.lo-plan-card ul{font-size:10px;gap:9px}.lo-plan-heading h3{font-size:18px}.lo-plan-heading>span{font-size:7px;padding:3px 5px}.lo-plan-durations{grid-template-columns:1fr;font-size:9px}.lo-plan-security{font-size:9px;padding:0 18px}.lo-faq{padding:10px 18px 28px}.lo-footer>.lo-wrap{flex-wrap:wrap;gap:12px}.lo-footer img{width:150px}.lo-footer p{flex-basis:100%;order:3;fo
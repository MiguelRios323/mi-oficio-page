    const hueco = Math.max(0,bottom-y-reservaFinal-4);
    if(doc.getNumberOfPages()===tablePage && hueco>=12){
      const inicio=y-2;doc.setDrawColor(45,45,45);doc.line(left,inicio,left,inicio+hueco);doc.line(200,inicio,200,inicio+hueco);
      doc.setDrawColor(45,45,45);doc.line(left,inicio+hueco,200,inicio+hueco);y+=hueco;
    } else { doc.setDrawColor(45,45,45);doc.line(left,y-2,200,y-2); }
    if(comerciales.length && Math.max(totalH,ladoH)<bottom-20){
      const panelH=Math.max(totalH,ladoH);

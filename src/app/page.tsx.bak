/* Un importe principal y un gráfico de cobros reales en el 80% del resumen. */
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-cash-overview{min-width:0;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.4fr);gap:24px;align-items:center;padding:16px 20px;border:1px solid #ece7fa;border-radius:13px;background:#faf9ff}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-cash-chart{min-width:0;border-left:1px solid #e8e2f5;padding-left:24px}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-chart-heading{display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-bottom:10px}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-chart-heading h3{font-size:12px!important;font-weight:650!important;color:#262044!important;margin:0!important;white-space:nowrap!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-chart-heading small{font-size:9px!important;line-height:1.4!important;color:#81748f!important;text-align:right}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-chart-bars{display:grid!important;grid-template-columns:repeat(var(--cash-columns),minmax(0,1fr))!important;gap:12px!important;position:relative!important;background:repeating-linear-gradient(to top,transparent 0px,transparent 27px,#e8e2f5 28px,transparent 29px) 0 0 / 100% 88px no-repeat!important;padding:0!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-chart-bar{display:flex!important;flex-direction:column!important;align-items:center!important;gap:7px!important;position:relative!important;background:none!important;border:0!important;padding:0!important;border-radius:0!important;min-width:0!important;min-height:0!important;height:auto!important;width:100%!important;cursor:default!important;box-shadow:none!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-chart-track{display:flex!important;align-items:flex-end!important;height:88px!important;width:100%!important;max-width:44px!important;border-bottom:1px solid #ddd4ee!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-chart-fill{display:block!important;width:100%!important;border-radius:6px 6px 0 0!important;background:linear-gradient(0deg,#6046f5,#aa96ff)!important;min-height:3px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-chart-bar small{font-size:9px!important;color:#827490!important;line-height:1.4!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-chart-bar:hover .approved-chart-fill,#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-chart-bar:focus-visible .approved-chart-fill{background:linear-gradient(0deg,#4229bf,#896bfc)!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-chart-bar:focus-visible{outline:2px solid #6046f5!important;outline-offset:3px!important;border-radius:4px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-chart-bar:hover::after,#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-chart-bar:focus-visible::after{content:attr(data-tooltip);position:absolute;z-index:4;bottom:calc(100% + 5px);left:50%;transform:translateX(-50%);background:#282044;color:white;font-size:10px;white-space:nowrap;border-radius:7px;padding:6px 8px;box-shadow:0 4px 12px #22184420;pointer-events:none}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-chart-empty{height:110px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;text-align:center;color:#827490;font-size:11px;line-height:1.5}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .approved-chart-empty svg{width:24px!important;height:24px!important;min-width:24px!important;color:#9179cd!important}

        .budget-v2 {position:fixed;inset:0;z-index:65;display:flex;align-items:center;justify-content:center;background:rgba(15,23,42,.6);font-family:Inter,Arial,sans-serif;color:#24203c;}
        .budget-v2-shell {width:100%;max-width:940px;height:94dvh;max-height:1000px;display:flex;flex-direction:column;background:#f8f9fc;border-radius:26px;overflow:hidden;box-shadow:0 24px 80px #0f172a33;}
        .budget-v2-header {display:flex;align-items:center;justify-content:space-between;padding:22px 32px;flex-shrink:0;}
        .budget-v2-close {border:0;width:44px;height:44px;border-radius:16px;background:white;color:#24203c;box-shadow:0 5px 16px #0f172a0b;cursor:pointer;font-size:20px;}
        .budget-v2-form {flex:1;min-height:0;display:flex;flex-direction:column;}.budget-v2-scroll {flex:1;min-height:0;overflow:auto;overscroll-behavior:contain;}
        .budget-v2-card {background:white;border-radius:25px;box-shadow:0 8px 35px #0f172a08;margin:0 28px 20px;padding:30px;}
        .budget-v2-card h2 {font-size:29px;font-weight:600;line-height:1.2;margin:0;color:#24203c;letter-spacing:-.6px;}
        .budget-v2-subtitle {font-size:16px;color:#8184a4;margin:9px 0 24px;}.budget-v2-client-summary {padding:14px 17px;border:1px solid #e2e2ef;border-radius:14px;background:#f7f6fb;font-size:15px;font-weight:600;margin:0 0 22px;}
        .budget-v2-section {padding:22px 0;border-top:1px solid #eeeef4;}.budget-v2-section:first-of-type {border-top:0;padding-top:0;}
        .budget-v2-section h3 {font-size:20px !important;font-weight:600;line-height:1.35;margin:0 0 16px;color:#24203c;}
        .budget-v2-section h4 {font-size:17px;font-weight:600;margin:20px 0 14px;}
        .budget-v2-section-heading {display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:12px;}.budget-v2-section-heading h3 {margin:0;}
        .budget-v2-grid {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:14px 0;}.budget-v2-grid .budget-full {grid-column:1/-1;}
        .budget-v2 .label {display:block;font-size:13px !important;color:#797e9c !important;text-transform:none !important;letter-spacing:0 !important;font-weight:500 !important;margin:0 0 7px;line-height:1.35;}
        .budget-generator.budget-v2.mi-oficio-ui .field {height:46px !important;min-height:46px !important;border:1px solid #e0e1ed !important;border-radius:12px !important;background:#f7f6fb !important;font-size:15px !important;line-height:1.3 !important;padding:0 13px !important;color:#10183b !important;font-weight:500 !important;width:100%;box-sizing:border-box;}
        .budget-generator.budget-v2.mi-oficio-ui textarea.field {height:auto !important;min-height:88px !important;padding:12px 13px !important;}.budget-generator.budget-v2.mi-oficio-ui .field:focus {background:#fff !important;border-color:#6441df !important;outline:none;}
        .budget-generator.budget-v2.mi-oficio-ui .field:disabled {opacity:.5;}.budget-v2 input[type=checkbox] {width:17px !important;height:17px !important;min-height:0 !important;flex-shrink:0;accent-color:#6441df;}
        .budget-v2-client-picker {display:flex;align-items:center;gap:12px;margin-bottom:16px;}.budget-v2-client-picker select {flex:1;min-width:0;}
        .budget-v2-link {color:#3759ff;border:0;background:none;font-size:14px;font-weight:650;white-space:nowrap;cursor:pointer;}
        .budget-v2-work-fields {display:grid;gap:17px;margin-top:17px;}.budget-v2-work-fields label {display:block;font-size:13px !important;font-weight:600 !important;color:#797e9c !important;margin:0 0 5px;}.budget-v2-work-fields p {font-size:11px !important;margin:4px 0;color:#8b90a6;}
        .budget-v2-items {display:grid;gap:17px;}.budget-v2-item {background:#f9f9fc;border:1px solid #e6e7f1;border-radius:18px;padding:20px;}.budget-v2-item-heading {display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px;}.budget-v2-item-heading strong {font-size:17px;overflow-wrap:anywhere;}
        .budget-v2-delete {border:0;background:none;color:#8b90a6;font-size:18px;cursor:pointer;}.budget-v2-delete:disabled,.budget-step-arrow:disabled,.budget-step-emit:disabled {opacity:.3;cursor:default;}
        .budget-v2-item-grid {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:18px;}.budget-v2-item-amount {height:46px;display:flex;align-items:center;border:1px solid #e0e1ed;border-radius:12px;padding:0 12px;background:#eeedf7;font-size:15px;font-weight:600;white-space:nowrap;overflow-x:auto;}
        .budget-v2-add {width:100%;margin-top:18px;padding:15px 10px;border:1.5px solid #6441df;background:white;border-radius:13px;color:#3759ff;font-size:16px;font-weight:650;cursor:pointer;}
        .budget-v2-adjustments {margin-top:20px;max-width:280px;font-size:13px;color:#797e9c;}.budget-v2-adjustments input {margin-top:7px;}
        .budget-v2-totals {display:grid;grid-template-columns:1fr 1fr 1.3fr;gap:16px;border-top:1px solid #eeeef4;padding-top:22px;}.budget-v2-totals>div {display:flex;flex-direction:column;gap:9px;min-width:0;}.budget-v2-totals span {font-size:13px;color:#797e9c;}.budget-v2-totals strong {font-size:19px;overflow-wrap:anywhere;}.budget-v2-grand-total strong {font-size:25px;color:#24203c;}.budget-v2-grand-total span {color:#24203c;}
        .budget-v2-check {display:flex;align-items:center;gap:8px;font-size:12px;color:#797e9c;margin:10px 0;}.budget-v2-payment-options {display:flex;flex-wrap:wrap;gap:12px;margin:17px 0;}.budget-v2-payment {display:flex;align-items:center;gap:9px;flex:1;padding:15px 12px;border:1px solid #e0e1ed;border-radius:13px;background:white;font-size:14px;cursor:pointer;}.budget-v2-payment.is-selected {color:#3759ff;border-color:#6441df;background:#f1f3ff;}
        .budget-v2-final {border-top:1px solid #eeeef4;padding-top:20px;display:flex;justify-content:space-between;align-items:center;gap:16px;font-size:14px;}.budget-v2-final strong {font-size:27px;}
        .budget-v2-footer {padding:12px 28px 18px;flex-shrink:0;background:#f8f9fc;}
        @media(max-width:639px) {.budget-v2 {background:#f8f9fc;}.budget-v2-shell {height:100dvh;max-height:none;border-radius:0;}.budget-v2-header {padding:18px 20px;}.budget-v2-card {margin:0 14px 18px;padding:23px 18px;border-radius:24px;}.budget-v2-card h2 {font-size:26px;}.budget-v2-subtitle {font-size:14px;}.budget-v2-grid {gap:13px;}.budget-v2-grid>div:has(input[type=email]) {grid-column:1/-1;}.budget-v2-item {padding:15px;}.budget-v2-item-grid {grid-template-columns:repeat(2,minmax(0,1fr));gap:13px;}.budget-v2-totals {gap:10px;}.budget-v2-totals strong {font-size:15px;}.budget-v2-grand-total strong {font-size:20px;}.budget-v2-footer {padding:10px 16px max(16px,env(safe-area-inset-bottom));}.budget-v2-client-picker {flex-wrap:wrap;}.budget-v2-client-picker select {flex-basis:100%;}.budget-v2-link {margin-left:auto;}.budget-v2-section h3 {font-size:19px !important;}}
        .budget-v2-counter {display:block;text-align:right;font-size:11px;color:#8b90a6;margin:4px 0 0;}
        .budget-v2-payment-summary {font-size:14px;line-height:1.6;color:#656d8b;overflow-wrap:anywhere;}
        .budget-v2-profile-bank {padding:14px 16px;border:1px solid #e3e5f0;border-radius:14px;background:#f7f6fb;margin-top:12px;}
        .budget-v2-profile-bank p {font-size:13px;line-height:1.65;margin:3px 0;overflow-wrap:anywhere;}
        .client-v2 {z-index:70;}.client-v2 .budget-v2-shell {max-width:760px;}
        .client-v2-footer {display:flex;align-items:center;justify-content:space-between;gap:16px;padding-top:18px;}
        .client-v2-cancel {border:1px solid #e0e1ed;border-radius:999px;background:white;color:#797e9c;min-height:54px;padding:10px 24px;font-size:14px;cursor:pointer;}
        .budget-v2 {color:#24203c;}
        .budget-v2-shell {background:#fafbfc;}
        .budget-v2-header {padding:26px 32px;}
        .budget-v2-close {width:52px;height:52px;border-radius:18px;}
        .budget-v2-card {padding:32px;border-radius:28px;box-shadow:0 12px 40px #121a3810;}
        .budget-v2-card h2 {font-size:30px;}
        .budget-v2-subtitle {font-size:18px;color:#797eaa;margin:10px 0 28px;}
        .budget-v2-section {padding:26px 0;}
        .budget-v2-section h3 {font-size:23px !important;margin-bottom:20px;}
        .budget-v2 .label,.budget-v2-work-fields label {font-size:15px !important;color:#797eaa !important;}
        .budget-generator.budget-v2.mi-oficio-ui .field {height:50px !important;min-height:50px !important;font-size:16px !important;font-weight:400 !important;border-color:#e0e2f1 !important;background:#f7f7fb !important;border-radius:13px !important;padding:0 14px !important;}
        .budget-v2 select.field {padding-right:28px !important;text-overflow:ellipsis;}
        .budget-v2-client-summary {font-size:17px;font-weight:500;padding:17px 18px;}
        .budget-v2-client-picker {display:grid;grid-template-columns:1fr;gap:8px;}
        .budget-v2-client-picker .budget-v2-link {grid-row:1;justify-self:end;margin:0;}
        .budget-v2-item {background:#f8f8fc;border-color:#e1e3f2;border-radius:17px;padding:22px;}
        .budget-v2-item-heading strong {font-size:20px;color:#24203c;}
        .budget-v2-item-grid {gap:18px;}
        .budget-v2-item-amount {height:50px;font-size:17px;background:#eeedf7;border-radius:13px;}
        .budget-v2-add {min-height:52px;font-size:18px;border-color:#6441df;}
        .budget-v2-totals {gap:0;padding-top:25px;}
        .budget-v2-totals>div {padding:0 15px;border-right:1px solid #eeeef5;}
        .budget-v2-totals>div:first-child {padding-left:0;}
        .budget-v2-totals>div:last-child {padding-right:0;border-right:0;}
        .budget-v2-totals span {font-size:15px;}
        .budget-v2-totals strong {font-size:24px;}
        .budget-v2-grand-total strong {font-size:30px;}
        .budget-v2-footer {background:#fafbfc;padding-top:14px;}
        .budget-v2 .budget-step-arrow {width:60px;height:60px;flex-basis:60px;background:#6441df;}
        .budget-v2-profile-bank {padding:0;border:0;background:none;}
        .budget-v2-profile-bank .budget-v2-grid {margin-bottom:0;}
        .budget-v2-payment {cursor:default;min-width:0;justify-content:center;font-size:15px;}
        .budget-v2-final {flex-direction:column;align-items:flex-start;gap:8px;color:#24203c;}
        .budget-v2-final strong {font-size:32px;}
        @media(max-width:639px) {
          .budget-v2-header {padding:22px 20px;}
          .budget-v2-card {padding:25px 18px;margin:0 16px 18px;border-radius:25px;}
          .budget-v2-card h2 {font-size:27px;}
          .budget-v2-subtitle {font-size:16px;}
          .budget-v2-section h3 {font-size:21px !important;}
          .budget-v2 .label,.budget-v2-work-fields label {font-size:14px !important;}
          .budget-v2-item {padding:16px 12px;}
          .budget-v2-item-heading strong {font-size:18px;}
          .budget-v2-item-grid {grid-template-columns:repeat(3,minmax(0,1fr));gap:14px 10px;}
          .budget-v2-item-grid .label {font-size:12px !important;}
          .budget-generator.budget-v2.mi-oficio-ui .budget-v2-item-grid .field {padding:0 8px !important;font-size:15px !important;}
          .budget-v2-item-amount {font-size:15px;padding:0 8px;}
          .budget-v2-totals>div {padding:0 9px;}
          .budget-v2-totals span {font-size:12px;}
          .budget-v2-totals strong {font-size:18px;}
          .budget-v2-grand-total strong {font-size:22px;}
          .budget-v2-payment-options {gap:8px;}
          .budget-v2-payment {padding:12px 6px;font-size:12px;gap:6px;}
        }
        @media(max-width:379px) {
          .budget-v2-item-grid {grid-template-columns:repeat(2,minmax(0,1fr));}
          .budget-v2 .budget-step-arrow {width:48px;height:48px;flex-basis:48px;}
          .budget-v2-card h2 {font-size:24px;}
        }

        .profile-v2 {width:100%;max-width:none;box-sizing:border-box;margin:0;padding:0;font-family:Inter,Arial,sans-serif;color:#24203c;}
        .profile-v2-card {width:100%;box-sizing:border-box;padding:36px 40px 12px;background:#fff;border-radius:28px;box-shadow:0 12px 45px #121a380d;}
        .profile-v2-card h2 {font-size:34px;font-weight:600;letter-spacing:-.6px;line-height:1.2;margin:0;}
        .profile-v2-section {padding:26px 0;border-top:1px solid #edf0f6;}.profile-v2-section:first-of-type {border-top:0;padding-top:0;}
        .profile-v2-section h3 {font-size:21px;font-weight:600;margin:0 0 18px;}
        .profile-v2-transfer h4 {font-size:18px;font-weight:600;margin:24px 0 16px;}
        .profile-v2-grid {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 28px;}.profile-v2-full {grid-column:1/-1;}
        .profile-v2 .profile-v2-label {display:block;margin:0 0 9px;font-size:15px;font-weight:400;color:#6e7896;}
        .mi-oficio-ui .profile-v2 .profile-v2-field,.profile-v2 .profile-v2-field {width:100%;height:54px !important;min-height:54px !important;box-sizing:border-box;border:1px solid #dce1ee !important;border-radius:11px !important;background:#f9f9fc !important;padding:0 13px !important;color:#121b43 !important;font-family:inherit;font-size:16px !important;font-weight:400 !important;line-height:1.4 !important;}
        .profile-v2 .profile-v2-field:focus {outline:2px solid #1850ff30;border-color:#6441df !important;background:#fff !important;}
        .profile-v2 .profile-v2-field:disabled {opacity:.5;cursor:not-allowed;}
        .profile-v2 textarea.profile-v2-field {height:auto !important;min-height:88px !important;padding:12px 13px !important;resize:vertical;}
        .profile-v2-rubro {display:flex;align-items:center;justify-content:space-between;gap:10px;text-align:left;cursor:pointer;}.profile-v2-rubro>span:first-child {overflow:hidden;white-space:nowrap;text-overflow:ellipsis;}
        .profile-v2-payments {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;}
        .profile-v2-payment {display:flex;align-items:center;justify-content:center;gap:10px;min-height:52px;border:1px solid #dce1ee;border-radius:11px;background:#fff;font-size:14px;font-weight:600;cursor:pointer;}
        .profile-v2-payment.is-selected {border-color:#6441df;background:#eee8ff;}
        .profile-v2-payment input {appearance:none;width:22px !important;height:22px !important;min-height:0 !important;padding:0 !important;flex-shrink:0;border:1.5px solid #8791ad;border-radius:50%;background:#fff;}
        .profile-v2-payment input:checked {border-color:#6441df;background:#6441df;box-shadow:inset 0 0 0 4px #eee8ff;}
        .profile-v2-payment input:focus-visible {outline:2px solid #6441df;outline-offset:3px;}
        .profile-v2-save {width:100%;margin-top:16px;min-height:50px;border:0;border-radius:11px;background:#6441df;color:#fff;font-size:17px;font-weight:650;cursor:pointer;}.profile-v2-help {font-size:12px;color:#79829e;margin:8px 0;}
        @media(max-width:639px) {.profile-v2 {padding:0;}.profile-v2-card {padding:26px 20px 12px;border-radius:22px;}.profile-v2-card h2 {font-size:26px;}.profile-v2-grid {gap:16px 12px;}.profile-v2-section h3 {font-size:20px;}.profile-v2 .profile-v2-field {font-size:15px !important;padding:0 10px !important;}.profile-v2-payments {gap:8px;}.profile-v2-payment {gap:6px;font-size:12px;}.profile-v2-payment input {width:18px !important;height:18px !important;}}
        @media(max-width:379px) {.profile-v2-grid {grid-template-columns:1fr;}.profile-v2-payments {grid-template-columns:1fr;}.profile-v2-payment {justify-content:flex-start;padding:0 12px;font-size:14px;}}

        .rubro-v2-overlay {position:fixed;inset:0;z-index:100;display:flex;align-items:center;justify-content:center;padding:24px;background:#0f172a66;backdrop-filter:blur(5px);font-family:Inter,Arial,sans-serif;color:#24203c;}
        .rubro-v2-card {display:flex;flex-direction:column;width:100%;max-width:680px;max-height:90dvh;min-height:0;overflow:hidden;background:#fff;border-radius:28px;box-shadow:0 24px 70px #121a3830;}
        .rubro-v2-header {display:flex;align-items:flex-start;justify-content:space-between;gap:18px;padding:28px 28px 20px;}
        .rubro-v2-header h3 {font-size:27px;font-weight:600;line-height:1.2;letter-spacing:-.5px;margin:0;color:#24203c;}
        .rubro-v2-subtitle {font-size:14px;line-height:1.5;color:#707b97;margin:10px 0 0;}
        .rubro-v2-close {width:42px;height:42px;flex-shrink:0;display:flex;align-items:center;justify-content:center;border:1px solid #dce1ee;border-radius:13px;background:#f9f9fc;color:#707b97;cursor:pointer;}
        .rubro-v2-search {padding:0 28px 20px;border-bottom:1px solid #edf0f6;}
        .rubro-v2-search-field {position:relative;display:block;}
        .rubro-v2-input {width:100%;height:54px;box-sizing:border-box;border:1px solid #dce1ee;border-radius:13px;background:#f9f9fc;padding:0 14px 0 46px;color:#121b43;font-size:16px;font-family:inherit;}
        .rubro-v2-input:focus {outline:2px solid #1850ff30;border-color:#6441df;background:#fff;}
        .rubro-v2-selection-info {display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:13px;font-size:13px;color:#79829e;}.rubro-v2-clear {border:0;background:none;padding:4px 0;font-size:13px;font-weight:600;color:#6441df;cursor:pointer;}
        .rubro-v2-results {flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;padding:14px 20px;display:grid;gap:8px;}
        .rubro-v2-option {display:flex;align-items:center;gap:14px;width:100%;padding:16px;border:1px solid #edf0f6;border-radius:14px;background:#fff;text-align:left;font-family:inherit;cursor:pointer;}
        .rubro-v2-option:hover {background:#f9f9fc;}.rubro-v2-option.is-selected {background:#eee8ff;border-color:#6441df;}
        .rubro-v2-radio {display:flex;align-items:center;justify-content:center;width:24px;height:24px;flex-shrink:0;border:1.5px solid #8791ad;border-radius:50%;background:#fff;color:#fff;}.is-selected .rubro-v2-radio {border-color:#6441df;background:#6441df;}
        .rubro-v2-option-copy {min-width:0;flex:1;}.rubro-v2-option-name {display:block;font-size:16px;font-weight:600;line-height:1.4;color:#121b43;overflow-wrap:anywhere;}.rubro-v2-option-kind {display:block;margin-top:5px;font-size:12px;color:#79829e;}
        .rubro-v2-footer {padding:18px 28px 24px;border-top:1px solid #edf0f6;background:#fff;}.rubro-v2-apply {width:100%;min-height:50px;border:0;border-radius:11px;background:#6441df;color:#fff;font-size:17px;font-weight:650;cursor:pointer;}
        .rubro-v2-option:focus-visible,.rubro-v2-close:focus-visible,.rubro-v2-apply:focus-visible {outline:2px solid #6441df;outline-offset:2px;}
        @media(max-width:639px) {.rubro-v2-overlay {padding:12px;background:#f5f7fbee;}.rubro-v2-card {max-height:calc(100dvh - 24px);height:calc(100dvh - 24px);border-radius:24px;}.rubro-v2-header {padding:24px 20px 18px;}.rubro-v2-header h3 {font-size:25px;}.rubro-v2-search {padding:0 20px 18px;}.rubro-v2-results {padding:12px;}.rubro-v2-option {padding:15px 12px;gap:12px;}.rubro-v2-footer {padding:16px 20px max(18px,env(safe-area-inset-bottom));}}
        .mi-oficio-ui.mioficio-model {--model-ink:#24203c;--model-blue:#6441df;--model-muted:#707b97;--model-border:#dce1ee;--model-field:#f9f9fc;--model-surface:#fff;--model-radius:12px;--model-card-radius:20px;--model-control-height:44px;--model-field-size:14px;--model-label-size:13px;--model-title-size:22px;--model-section-size:16px;--model-space:20px;background:#f5f7fb;color:var(--model-ink);}
        .mioficio-model :is(h1,h2,h3,h4) {line-height:1.3;letter-spacing:-.025em;}
        .mioficio-model h1 {font-size:var(--model-title-size) !important;}.mioficio-model h2 {font-size:var(--model-title-size) !important;}.mioficio-model h3 {font-size:var(--model-section-size) !important;}.mioficio-model h4 {font-size:var(--model-section-size) !important;}
        .mioficio-model :is(.text-slate-950,.text-slate-900) {color:var(--model-ink);}
        .mioficio-model :is(.text-slate-500,.text-slate-400) {color:var(--model-muted);}
        .mioficio-model :is(.text-blue-600,.text-blue-700) {color:var(--model-blue);}
        .mioficio-model :is(.bg-blue-600,.bg-blue-700) {background-color:var(--model-blue);}
        .mi-oficio-ui.mioficio-model .label {font-size:14px !important;font-weight:500 !important;color:var(--model-muted) !important;line-height:1.4;letter-spacing:0;text-transform:none;margin-bottom:8px;}
        .mi-oficio-ui.mioficio-model :is(input:not([type=checkbox]):not([type=radio]):not([type=file]):not([type=hidden]),select,textarea) {font-size:16px !important;font-weight:400 !important;line-height:1.4 !important;border-radius:12px !important;}
        .mi-oficio-ui.mioficio-model textarea.field {height:auto !important;min-height:90px !important;padding:12px 13px !important;}
        .mi-oficio-ui.mioficio-model :is(input,select,textarea):focus-visible {outline:2px solid #1850ff30;border-color:var(--model-blue) !important;}
        .mioficio-model button {font-family:inherit;transition:background-color .15s,border-color .15s,box-shadow .15s;}
        .mioficio-model button:focus-visible {outline:2px solid var(--model-blue);outline-offset:3px;}
        .mioficio-model button:disabled {cursor:not-allowed;}
        .mioficio-model button:is(.bg-blue-600,.bg-blue-700) {font-size:14px !important;font-weight:650;}
        .mioficio-model section.bg-white {box-shadow:0 8px 25px #121a3807;}
        .mioficio-model .model-overlay {background-color:#0f172a66;backdrop-filter:blur(5px);}
        .mioficio-model .model-overlay>div {border-radius:24px;max-height:92dvh;}
        .mioficio-model .model-overlay>div.bg-white {box-shadow:0 24px 70px #121a3830;}
        .mioficio-model .model-overlay :is(.border-b,.border-t) {border-color:#edf0f6;}
        .mioficio-model aside {border-right:1px solid #e4e8f1;box-shadow:4px 0 25px #121a3804;}
        .mioficio-model aside :is(.text-slate-400,.text-slate-500,.text-white) {color:var(--model-muted);}
        .mioficio-model aside nav {display:grid;gap:7px;}
        .mioficio-model aside nav button {min-height:48px;border-radius:12px;font-size:14px !important;padding:10px 14px;}
        .mioficio-model aside nav button:not(.bg-blue-600) {color:#55617f;background:transparent;}
        .mioficio-model aside nav button:not(.bg-blue-600):hover {background:#f1f3fa;}
        .mioficio-model aside nav button.bg-blue-600 {color:#fff;box-shadow:0 5px 16px #1850ff1a;}
        .mioficio-model aside [class*="border-white"] {border-color:#edf0f6;}
        .mioficio-model aside>div:last-child {border-top:1px solid #edf0f6;}
        .mioficio-model table th {font-size:12px !important;color:var(--model-muted);padding-top:14px;padding-bottom:14px;}
        .mioficio-model table td {font-size:13px !important;padding-top:14px;padding-bottom:14px;line-height:1.45;}
        .mioficio-model main>header {min-height:64px;height:auto;padding-top:8px;padding-bottom:8px;}
        .mioficio-model main>header h1 {font-size:20px !important;}
        .mioficio-model main>header input {min-height:30px !important;font-size:14px !important;}
        @media(max-width:639px) {
          .mioficio-model h1 {font-size:25px !important;}.mioficio-model h2 {font-size:23px !important;}.mioficio-model h3 {font-size:20px !important;}
          .mioficio-model .model-overlay {padding:12px;}
          .mioficio-model .model-overlay>div {max-height:calc(100dvh - 24px);}
          .mioficio-model>nav button {min-height:58px;border-radius:12px;}
          .mioficio-model>nav button span:last-child {font-size:11px !important;line-height:1.2 !important;}
          .mi-oficio-ui.mioficio-model .budget-v2-item-grid .field {font-size:15px !important;}
        }
        .mioficio-model :is([class~="text-[6.5px]"],[class~="text-[6.8px]"],[class~="text-[7px]"],[class~="text-[7.5px]"],[class~="text-[8px]"],[class~="text-[8.5px]"],[class~="text-[9px]"],[class~="text-[9.5px]"],[class~="text-[10px]"],[class~="text-[11px]"]) {font-size:13px !important;line-height:1.45 !important;}
        .mioficio-model :is([class~="text-[12px]"],.text-xs) {font-size:14px !important;line-height:1.45;}
        .mioficio-model :is(.budget-v2-counter,.rubro-v2-option-kind,.profile-v2-help) {font-size:12px !important;}
        .mioficio-model>nav button span:last-child {font-size:11px !important;line-height:1.2 !important;}
        .mi-oficio-ui.mioficio-model .model-card {background:#fff !important;border:1px solid #e4e8f1 !important;border-radius:var(--model-card-radius) !important;box-shadow:0 8px 25px #121a3807;}
        .mi-oficio-ui.mioficio-model :is(section,article).model-card {padding:22px !important;}
        .mi-oficio-ui.mioficio-model .model-panel-header {padding:24px !important;gap:18px;border-bottom:1px solid #edf0f6;align-items:flex-start;}
        .mi-oficio-ui.mioficio-model .model-panel-header :is(h2,h3) {font-size:25px !important;font-weight:600 !important;margin-bottom:8px;}
        .mi-oficio-ui.mioficio-model .model-panel-header p {font-size:14px !important;line-height:1.5 !important;}
        .mi-oficio-ui.mioficio-model .model-panel-footer {padding:16px 24px !important;gap:12px;border-color:#edf0f6;background:#fff;}
        .mi-oficio-ui.mioficio-model .model-overlay>div {background:#fff;border-radius:26px !important;border:1px solid #e4e8f1;overflow-y:auto;}
        .mi-oficio-ui.mioficio-model .model-overlay>div:has(form) {max-width:900px !important;}
        .mi-oficio-ui.mioficio-model .model-overlay>div>div:is(.p-4,.p-3) {padding:24px !important;}
        .mi-oficio-ui.mioficio-model .model-overlay form>div {max-width:none;}
        .mi-oficio-ui.mioficio-model textarea.model-input {height:auto !important;min-height:90px !important;padding:12px 13px !important;}
        .mi-oficio-ui.mioficio-model .model-input:focus-visible {outline:2px solid #1850ff30;border-color:#6441df !important;background:#fff !important;}
        .mi-oficio-ui.mioficio-model .model-text-button {font-size:14px !important;font-weight:600 !important;line-height:1.4 !important;color:#6441df;}
        .mi-oficio-ui.mioficio-model .model-overlay [class*="grid-cols-2"] {gap:18px !important;}
        .mi-oficio-ui.mioficio-model .model-overlay label:not(:has(input[type=checkbox])) {font-size:14px !important;font-weight:500 !important;line-height:1.4 !important;color:#707b97;}
        .mi-oficio-ui.mioficio-model .model-overlay .font-mono {font-family:Inter,Arial,sans-serif !important;}
        @media(max-width:639px) {
          .mi-oficio-ui.mioficio-model .model-panel-header {padding:22px 20px !important;}
          .mi-oficio-ui.mioficio-model .model-panel-footer {padding:16px 20px !important;flex-wrap:wrap;}
          .mi-oficio-ui.mioficio-model .model-panel-footer>.model-primary-button {flex:1;}
          .mi-oficio-ui.mioficio-model .model-overlay>div>div:is(.p-4,.p-3) {padding:20px !important;}
          .mi-oficio-ui.mioficio-model :is(section,article).model-card {padding:18px !important;}
        }
        .mioficio-model .compact-overview :is(section,article).model-card {padding:14px !important;}
        .mioficio-model .compact-overview .model-panel-header {padding:16px !important;}
        .mioficio-model .compact-overview .model-panel-footer {padding:12px 16px !important;}
        .mioficio-model .compact-overview :is(.model-primary-button,.model-secondary-button) {min-height:42px !important;padding:10px 14px !important;}
        .mioficio-model .compact-overview .model-input {min-height:44px !important;height:44px !important;}
        .mioficio-model .compact-overview [class~="max-w-[1180px]"] {max-width:none;}
        .mioficio-model .compact-overview [class~="min-h-[92px]"] {min-height:72px !important;}
        .mioficio-model .compact-overview :is(.space-y-3,.space-y-4)>:not([hidden])~:not([hidden]) {margin-top:12px !important;}
        .mioficio-model .compact-overview table :is(th,td) {padding-top:10px !important;padding-bottom:10px !important;}

        .mi-oficio-ui.mioficio-model .premium-tools {margin:16px 0 0;padding:20px;background:#fff;border:1px solid #e4e8f1;border-radius:22px;box-shadow:0 8px 25px #121a3807;}
        @media(max-width:639px) {.mi-oficio-ui.mioficio-model .premium-tools {padding:16px;}}

        .inicio-quick-actions {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;}
        .mi-oficio-ui.mioficio-model :is(.inicio-quick-budget,.inicio-quick-client) {display:flex;align-items:center;gap:16px;width:100%;min-height:96px;padding:20px;border-radius:18px;text-align:left;cursor:pointer;}
        .inicio-quick-budget {background:#6441df;border:1px solid #6441df;color:#fff;box-shadow:0 6px 18px #1850ff16;}.inicio-quick-client {background:#fff;border:1px solid #dce1ee;color:#24203c;}
        .inicio-quick-icon {display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:13px;flex-shrink:0;background:#ffffff22;}.inicio-quick-client .inicio-quick-icon {background:#edf1ff;color:#6441df;}
        .inicio-quick-copy {display:grid;gap:6px;flex:1;min-width:0;}.inicio-quick-copy strong {font-size:18px;font-weight:600;line-height:1.3;}.inicio-quick-copy small {font-size:13px;line-height:1.4;color:#e1e8ff;}.inicio-quick-client small {color:#79829e;}.inicio-quick-plus {font-size:26px;font-weight:400;}
        @media(max-width:639px) {.inicio-quick-actions {gap:10px;}.mi-oficio-ui.mioficio-model :is(.inicio-quick-budget,.inicio-quick-client) {min-height:128px;padding:15px 12px;flex-direction:column;align-items:flex-start;gap:10px;}.inicio-quick-copy strong {font-size:15px;}.inicio-quick-copy small {font-size:12px;}.inicio-quick-icon {width:36px;height:36px;}.inicio-quick-plus {display:none;}}
        .mi-oficio-ui.mioficio-model .inicio-quick-actions {display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:flex-start;}

  }, [perfilForm.es_premium, perfilForm.prefijo_presupuesto, perfilForm.serie_anio, perfilForm.serie_digitos, perfilForm.serie_siguiente]);
  useEffect(() => () => { if(pdfPremiumListo) URL.revokeObjectURL(pdfPremiumListo.url); }, [pdfPremiumListo]);

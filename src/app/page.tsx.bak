  const [periodoInforme,setPeriodoInforme]=useState<'mes'|'anio'>('mes');
  const [mesInforme,setMesInforme]=useState(()=>fechaArgentina().slice(0,7));
  const [anioInforme,setAnioInforme]=useState(()=>fechaArgentina().slice(0,4));
  const [monedaInforme,setMonedaInforme]=useState('ARS');

  useEffect(()=>{
    const raiz=document.getElementById('mioficio-dashboard');if(!raiz)return;
    const viewport=window.visualViewport;
    const actualizar=()=>{raiz.style.setProperty('--mio-visible-height',`${viewport?.height||window.innerHeight}px`);raiz.style.setProperty('--mio-visible-top',`${viewport?.offsetTop||0}px`);};
    actualizar();viewport?.addEventListener('resize',actualizar);viewport?.addEventListener('scroll',actualizar);window.addEventListener('resize',actualizar);
    return()=>{viewport?.removeEventListener('resize',actualizar);viewport?.removeEventListener('scroll',actualizar);window.removeEventListener('resize',actualizar);};
  },[cargandoNube]);
  useEffect(()=>{
    if(cargandoNube)return;
    const frame=requestAnimationFrame(()=>{const raiz=document.getElementById('mioficio-dashboard');raiz?.querySelectorAll<HTMLElement>('.compact-main,.compact-content').forEach(el=>{el.scrollTop=0;el.scrollLeft=0;});window.scrollTo(0,0);});
    return()=>cancelAnimationFrame(frame);
  },[activeTab,cargandoNube]);
  const presupuestoScrollRef = useRef<HTMLElement | null>(null);
  const [hayDatosDebajo, setHayDatosDebajo] = useState(false);
  const [mostrarAvisoAdaptacion, setMostrarAvisoAdaptacion] = useState(false);

  const pasoPresupuestoRef = useRef(pasoPresupuesto);
  pasoPresupuestoRef.current = pasoPresupuesto;
  useEffect(() => {
    const pantallaPC=window.matchMedia('(min-width:1024px)');
    const adaptar=()=>setGeneradorEnPC(pantallaPC.matches);
    adaptar();pantallaPC.addEventListener('change',adaptar);
    return()=>pantallaPC.removeEventListener('change',adaptar);
  },[]);
  useEffect(() => {
    const contenido = presupuestoScrollRef.current;
    if (!showModalPresupuesto || !generadorEnPC || !contenido) {
      setHayDatosDebajo(false);
      return;
    }
    contenido.scrollTop=0;
    const actualizarAviso = () => setHayDatosDebajo(contenido.scrollHeight - contenido.clientHeight - contenido.scrollTop > 12);
    const observador = new ResizeObserver(actualizarAviso);
    observador.observe(contenido);
    if (contenido.firstElementChild) observador.observe(contenido.firstElementChild);
    contenido.addEventListener('scroll', actualizarAviso, { passive: true });
    actualizarAviso();
    return () => {
      observador.disconnect();
      contenido.removeEventListener('scroll', actualizarAviso);
    };
  }, [showModalPresupuesto, generadorEnPC, pasoPresupuesto]);


  const [presupuestoEnEdicion, setPresupuestoEnEdicion] = useState<Presupuesto | null>(null);
  const [showModalCliente, setShowModalCliente] = useState<boolean>(false);
  useEffect(()=>{
    if(!showModalPresupuesto||showModalCliente)return;
    const frame=requestAnimationFrame(()=>{const panel=presupuestoScrollRef.current;if(panel){panel.scrollTop=0;panel.scrollLeft=0;}});
    return()=>cancelAnimationFrame(frame);
  },[showModalPresupuesto,showModalCliente,pasoPresupuesto]);

  useEffect(() => {
    if (!showModalPresupuesto && !showModalCliente) return;
    const raiz = document.getElementById('mioficio-dashboard');
    const dialogo = raiz?.querySelector<HTMLElement>(showModalCliente ? '.client-v2' : '.budget-generator:not(.client-v2)');
    if (!raiz || !dialogo) return;
    const focoAnterior = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    const overflowAnterior = document.body.style.overflow;
    document.body.style.overflow = 'hidden';
    const fondo: HTMLElement[] = [];
    let rama: HTMLElement | null = dialogo;
    while (rama && rama !== raiz) {
      const padre: HTMLElement | null = rama.parentElement;
      if (!padre) break;
      for (const hermano of Array.from(padre.children)) if (hermano !== rama && hermano instanceof HTMLElement && !['STYLE','SCRIPT'].includes(hermano.tagName)) fondo.push(hermano);
      rama = padre;
    }
    const valoresInert = fondo.map(el => el.inert);
    fondo.forEach(el => { el.inert = true; });
    const viewport = window.visualViewport;
    const actualizarViewport = () => {
      raiz.style.setProperty('--mioficio-dialog-height', `${viewport?.height || window.innerHeight}px`);
      raiz.style.setProperty('--mioficio-dialog-top', `${viewport?.offsetTop || 0}px`);
    };
    actualizarViewport();
    viewport?.addEventListener('resize', actualizarViewport);
    viewport?.addEventListener('scroll', actualizarViewport);
    window.addEventListener('resize', actualizarViewport);
    const controles = () => Array.from(dialogo.querySelectorAll<HTMLElement>('button:not(:disabled),input:not(:disabled),select:not(:disabled),textarea:not(:disabled),a[href]')).filter(el => el.getClientRects().length > 0);
    controles()[0]?.focus({preventScroll:true});
    const mantenerFoco = (event:KeyboardEvent) => {
      if (event.key !== 'Tab') return;
      const lista = controles(), primero = lista[0], ultimo = lista[lista.length-1];
      if (!primero) return;
      if (event.shiftKey && document.activeElement === primero) { event.preventDefault(); ultimo.focus(); }
      else if (!event.shiftKey && document.activeElement === ultimo) { event.preventDefault(); primero.focus(); }
    };
    dialogo.addEventListener('keydown', mantenerFoco);
    return () => {
      viewport?.removeEventListener('resize', actualizarViewport);
      viewport?.removeEventListener('scroll', actualizarViewport);
      window.removeEventListener('resize', actualizarViewport);
      dialogo.removeEventListener('keydown', mantenerFoco);
      raiz.style.removeProperty('--mioficio-dialog-height');raiz.style.removeProperty('--mioficio-dialog-top');
      fondo.forEach((el,i) => { el.inert = valoresInert[i]; });
      document.body.style.overflow = overflowAnterior;
      if (focoAnterior?.isConnected) focoAnterior.focus({preventScroll:true});
    };
  }, [showModalPresupuesto,showModalCliente]);
  const clienteScrollRef = useRef<HTMLElement | null>(null);
  const [hayCamposClienteDebajo, setHayCamposClienteDebajo] = useState(false);
  useEffect(() => {
    if (!showModalCliente) { setHayCamposClienteDebajo(false); return; }
    const contenido = clienteScrollRef.current;
    if (!contenido) return;
    const actualizar = () => setHayCamposClienteDebajo(contenido.scrollHeight - contenido.clientHeight - contenido.scrollTop > 8);
    const frame = requestAnimationFrame(actualizar);
    contenido.addEventListener('scroll', actualizar, {passive:true});
    window.addEventListener('resize', actualizar);
    window.visualViewport?.addEventListener('resize', actualizar);
    const observer = typeof ResizeObserver === 'undefined' ? null : new ResizeObserver(actualizar);
    observer?.observe(contenido);
    if (contenido.firstElementChild) observer?.observe(contenido.firstElementChild);
    return () => {
      cancelAnimationFrame(frame); observer?.disconnect();
      contenido.removeEventListener('scroll', actualizar);
      window.removeEventListener('resize', actualizar);
      window.visualViewport?.removeEventListener('resize', actualizar);
    };
  }, [showModalCliente]);

  const [clienteEnEdicion, setClienteEnEdicion] = useState<Cliente | null>(null);
  const [clienteSeleccionadoParaVer, setClienteSeleccionadoParaVer] = useState<Cliente | null>(null);
  const [mostrarHistorialCliente, setMostrarHistorialCliente] = useState(false);
  const [mostrarAvisos, setMostrarAvisos] = useState(false);
  const [mostrarAyuda,setMostrarAyuda]=useState(false);
  const [mostrarCuentaAcceso, setMostrarCuentaAcceso] = useState(false);
  const cuentaDialogoRef=useRef<HTMLDialogElement|null>(null);
  useEffect(()=>{if(mostrarCuentaAcceso&&!cuentaDialogoRef.current?.open)cuentaDialogoRef.current?.showModal();},[mostrarCuentaAcceso]);

  const [mostrarCrear, setMostrarCrear] = useState(false);
  const [guardandoNegocio, setGuardandoNegocio] = useState(false);
  const [vistaNegocio, setVistaNegocio] = useState<'datos' | 'cobros'>('datos');
  const [enviandoClave, setEnviandoClave] = useState(false);
  const [guardandoEstadoPresupuesto, setGuardandoEstadoPresupuesto] = useState<number | null>(null);
  const [posicionAvisos, setPosicionAvisos] = useState({ top: 60, right: 16 });
  const [avisosLeidos, setAvisosLeidos] = useState<string[]>([]);
  const [recordatorioRevision, setRecordatorioRevision] = useState<{id:string;fecha:string} | null>(null);
  const claveRevisionPendientes = `mioficio-revision-pendientes-${user.uid}`;
  const hayPresupuestosPendientes = presupuestos.some(p => !['Borrador','Pagado','Rechazado','Cancelado'].includes(p.estado || 'Emitido'));
  useEffect(() => {
    // Aviso dentro de MiOficio, cada dos días calendario, sin acumular atrasados.
    const revisarPendientesCadaDosDias = () => {
      if (cargandoNube || !notificacionesActivas || !hayPresupuestosPendientes) {setRecordatorioRevision(null);return;}
      const hoy = fechaArgentina();
      let anterior: {fecha:string;leido?:boolean} | null = null;
      try {const raw=localStorage.getItem(claveRevisionPendientes);if(raw){const dato=JSON.parse(raw);if(typeof dato.fecha==='string' && /^\d{4}-\d{2}-\d{2}$/.test(dato.fecha))anterior=dato;}} catch {}
      const dias = anterior ? (Date.parse(`${hoy}T12:00:00Z`)-Date.parse(`${anterior.fecha}T12:00:00Z`))/86400000 : Infinity;
      if (!anterior || dias>=2) {
        anterior={fecha:hoy,leido:false};
        try {localStorage.setItem(claveRevisionPendientes,JSON.stringify(anterior));} catch {}
      }
      const id=`revision-pendientes-${anterior.fecha}`;
      setRecordatorioRevision({id,fecha:anterior.fecha});
      if (anterior.leido) setAvisosLeidos(actuales => actuales.includes(id) ? actuales : [...actuales,id]);
    };
    revisarPendientesCadaDosDias();
    const timer=window.setInterval(revisarPendientesCadaDosDias,60000);
    window.addEventListener('focus',revisarPendientesCadaDosDias);
    return () => {window.clearInterval(timer);window.removeEventListener('focus',revisarPendientesCadaDosDias);};
  }, [claveRevisionPendientes,cargandoNube,notificacionesActivas,hayPresupuestosPendientes]);
  const [avisosVisibles, setAvisosVisibles] = useState(1);
  const [filtroAvisos, setFiltroAvisos] = useState<'todos' | 'pendientes' | 'presupuestos' | 'perfil'>('todos');
  const [mostrarTodosPresupuestosCliente, setMostrarTodosPresupuestosCliente] = useState(false);

  const [showModalEliminar, setShowModalEliminar] = useState(false);
  const [itemAEliminar, setItemAEliminar] = useState<{ id: number; numero: string; tipo: 'presupuesto' | 'cliente' } | null>(null);

  const [incluirEspecificaciones, setIncluirEspecificaciones] = useState<boolean>(true);
  const [incluirCondiciones, setIncluirCondiciones] = useState<boolean>(true);
  const [incluirPago, setIncluirPago] = useState(true);
  const emitiendoRef = useRef(false);
  const [emitiendo, setEmitiendo] = useState(false);
  const [incluirNota, setIncluirNota] = useState<boolean>(false);
  const rubroActual = presupuestoEnEdicion?.rubro || perfilForm.oficio_rubro || 'Servicios Náuticos';

  const plantillaRubro = obtenerPlantillaRubro(rubroActual);
  const esRubroNautico = plantillaRubro.etiquetas[0] === 'Embarcación:';
  const [paramLabel1, setParamLabel1] = useState('Embarcación:');
  const [paramLabel2, setParamLabel2] = useState('Matrícula:');
  const [paramLabel3, setParamLabel3] = useState('Motor:');
  const mostrarTercerDatoTrabajo = esRubroNautico;

  const [paramLinea1, setParamLinea1] = useState('');
  const [paramLinea2, setParamLinea2] = useState('');
  const [paramLinea3, setParamLinea3] = useState('');

  useEffect(() => {
    const plantilla = obtenerPlantillaRubro(rubroActual);
    setParamLabel1(plantilla.etiquetas[0] === 'Embarcación:' ? plantilla.etiquetas[0] : 'Lugar o referencia del trabajo:');
    setParamLabel2(plantilla.etiquetas[1]);
    setParamLabel3(plantilla.etiquetas[2]);
    if (presupuestoEnEdicion) return;
    setIncluirEspecificaciones(true);
    // No arrastrar datos de otro rubro ni rellenar el PDF con ejemplos.
    setParamLinea1('');
    setParamLinea2('');
    setParamLinea3('');
  }, [rubroActual, presupuestoEnEdicion?.presupuesto_id]);

  const guiaDatosTrabajo = (label: string) => {
    if (!esRubroNautico) {
      const rubro = normalizarBusqueda(rubroActual);
      const ejemplosReferencia: Array<[string[], string]> = [
        [['albanil', 'construccion', 'arquitect', 'herrer', 'carpinter', 'pintor', 'techista'], 'Frente de la vivienda'],
        [['electric', 'plomer', 'gasista', 'refriger', 'electrodomest'], 'Cocina del cliente'],
        [['mecan', 'gomer', 'automotor', 'chapa'], 'Taller del cliente'],
        [['informat', 'contab', 'juridic', 'marketing', 'software'], 'Oficina del cliente'],
        [['docente', 'profesor', 'ensenanza', 'clases'], 'Domicilio del alumno'],
        [['transporte', 'flete', 'mudanza'], 'Entrega en el local del cliente'],
        [['jardiner', 'limpieza', 'agro'], 'Patio del cliente'],
        [['comercio', 'venta', 'panader', 'pasteler', 'catering'], 'Pedido del cliente']
      ];
      const ejemplo = ejemplosReferencia.find(([claves]) => claves.some(clave => rubro.includes(clave)))?.[1] || 'Local del cliente';
      return {ayuda:'Opcional. Indicá dónde se hará el trabajo o una referencia para ubicarlo. El detalle, las medidas y los materiales van en Producto / Servicio.', ejemplo:`Ej.: ${ejemplo}`};
    }
    const indice = plantillaRubro.etiquetas.findIndex(etiqueta => etiqueta === label);
    const clave = normalizarBusqueda(label);
    let ayuda = 'Agregá un dato breve que ayude a entender el trabajo.';
    if (indice === 0) ayuda = 'Identificá el lugar, equipo o proyecto. La tarea que cobrás va en Producto / Servicio.';
    if (indice === 1) ayuda = 'Agregá solo las medidas, materiales o detalles necesarios.';
    if (indice === 2) ayuda = 'Resumen general opcional. Si repite Producto / Servicio, dejalo vacío.';
    if (clave.includes('matricula')) ayuda = 'Ingresá la matrícula de la embarcación.';
    if (clave.includes('motor')) ayuda = 'Indicá la marca, el modelo o la potencia del motor.';
    return { ayuda, ejemplo: indice >= 0 ? `Ej.: ${plantillaRubro.ejemplos[indice]}` : 'Escribí un detalle breve' };
  };

  const construirMediosPagoTexto = () => {
    const arr = [];
    if (perfilForm.acepta_efectivo) arr.push('Efectivo');
    if (perfilForm.acepta_cheque) arr.push('Cheque');
    if (perfilForm.acepta_transferencia) arr.push('Transferencia Bancaria');
    return arr.length > 0 ? arr.join(' / ') : 'A coordinar';
  };

  const [nuevoPresupuesto, setNuevoPresupuesto] = useState({
    cliente: '',
    condicion_iva_cliente: '',
    cuit: '',
    email: '',
    telefono: '',
    direccion_obra: '',
    validez_dias: 15,
    forma_pago: '',
    tiempo_ejecucion: '',
    garantia: '',
    condiciones_adicionales: '',
    incluir_condiciones_adicionales: true,
    descuento: 0,
    moneda: 'ARS',
    observaciones_extra: '',
    tipo_proyecto: '',
    items: [
      { tipo: '', descripcion: '', cantidad: 1, unidad: 'un.', precio_unitario: 0, bonificacion: 0, iva: 21 }
    ] as ItemPresupuesto[]
  });

  useEffect(() => {
    if (showModalPresupuesto && !presupuestoEnEdicion) setNuevoPresupuesto(prev => ({...prev, moneda: articuloInicioRef.current?.moneda || monedaInicialPerfil(perfilForm)}));
  }, [showModalPresupuesto]);

  const [modoCatalogo, setModoCatalogo] = useState<'gestion' | 'presupuesto' | null>(null);
  const [busquedaCatalogo, setBusquedaCatalogo] = useState('');
  const [busquedaCatalogoInicio, setBusquedaCatalogoInicio] = useState('');
  const articuloInicioRef = useRef<ArticuloCatalogo | null>(null);
  const [editandoArticulo, setEditandoArticulo] = useState<string | null>(null);
  const [formArticuloVisible, setFormArticuloVisible] = useState(false);
  const [eliminarArticuloId, setEliminarArticuloId] = useState<string | null>(null);
  const [guardandoCatalogo, setGuardandoCatalogo] = useState(false);
  const [errorCatalogo, setErrorCatalogo] = useState('');
  const [formArticulo, setFormArticulo] = useState({ descripcion: '', unidad: 'un.', precio: '', iva: '21', moneda: 'ARS' });
  const articulosCatalogo: ArticuloCatalogo[] = Array.isArray(perfilForm.catalogo) ? perfilForm.catalogo : [];
  const abrirCatalogo = (modo: 'gestion' | 'presupuesto') => {
    if(modo==='gestion'){setActiveTab('catalogo');setBusquedaCatalogo('');setFormArticuloVisible(false);setEliminarArticuloId(null);setErrorCatalogo('');return;}
    if (perfilForm.es_premium !== true) { activarPremium(); return; }
    setModoCatalogo(modo); setBusquedaCatalogo(''); setFormArticuloVisible(false); setEliminarArticuloId(null); setErrorCatalogo('');
  };
  const prepararArticulo = (articulo?: ArticuloCatalogo) => {
    if(perfilForm.es_premium !== true){activarPremium();return;}
    setEditandoArticulo(articulo?.id || null);
    setFormArticulo(articulo ? { descripcion: articulo.descripcion, unidad: articulo.unidad, precio: String(articulo.precio_unitario), iva: String(articulo.iva), moneda: articulo.moneda } : { descripcion: '', unidad: 'un.', precio: '', iva: '21', moneda: modoCatalogo === 'presupuesto' ? nuevoPresupuesto.moneda : monedaInicialPerfil(perfilForm) });
    setErrorCatalogo(''); setFormArticuloVisible(true); setEliminarArticuloId(null);
  };
  const guardarItemParaReutilizar = (item: ItemPresupuesto) => {
    if (perfilForm.es_premium !== true) { activarPremium(); return; }
    if (!item.descripcion.trim()) { mostrarNotificacion('Primero completá la descripción del producto o servicio.', 'error'); return; }
    setModoCatalogo('presupuesto'); setBusquedaCatalogo(''); setEliminarArticuloId(null); setEditandoArticulo(null); setErrorCatalogo('');
    setFormArticulo({ descripcion: item.descripcion.slice(0,160), unidad: item.unidad || 'un.', precio: String(item.precio_unitario || 0), iva: String(item.iva ?? 21), moneda: nuevoPresupuesto.moneda });
    setFormArticuloVisible(true);
  };

  const guardarArticuloCatalogo = async (event: FormEvent) => {
    event.preventDefault();
    if (perfilForm.es_premium !== true || guardandoCatalogo) return;
    const articulo: ArticuloCatalogo = { id: editandoArticulo || (typeof crypto !== 'undefined' && crypto.randomUUID ? crypto.randomUUID() : `catalogo-${Date.now()}-${Math.random().toString(36).slice(2)}`), descripcion: formArticulo.descripcion.trim(), unidad: formArticulo.unidad, precio_unitario: formArticulo.precio.trim() ? Number(formArticulo.precio) : NaN, iva: Number(formArticulo.iva), moneda: formArticulo.moneda };
    const error = validarArticuloCatalogo(articulo);
    if (error) { setErrorCatalogo(error); return; }
    const catalogo = editandoArticulo ? articulosCatalogo.map(a => a.id === editandoArticulo ? articulo : a) : [...articulosCatalogo, articulo];
    const perfilActualizado = { ...perfilForm, catalogo };
    setGuardandoCatalogo(true); setErrorCatalogo('');
    try {
      const guardado = await sincronizarConCloudDirecto(perfilActualizado, clientes, presupuestos);
      if (!guardado) { setErrorCatalogo('No se pudo guardar. Tus datos siguen en el formulario para volver a intentarlo.'); return; }
      setPerfilForm(perfilActualizado); setFormArticuloVisible(false); setEditandoArticulo(null);
      mostrarNotificacion(editandoArticulo ? 'Artículo actualizado.' : 'Producto o servicio guardado para reutilizar.', 'success');
    } finally { setGuardandoCatalogo(false); }
  };
  const borrarArticuloCatalogo = async (id: string) => {
    if (perfilForm.es_premium !== true || guardandoCatalogo) return;
    setGuardandoCatalogo(true); setErrorCatalogo('');
    try {
      const perfilActualizado = { ...perfilForm, catalogo: articulosCatalogo.filter(a => a.id !== id) };
      const guardado = await sincronizarConCloudDirecto(perfilActualizado, clientes, presupuestos);
      if (!guardado) { setErrorCatalogo('No se pudo eliminar. Volvé a intentarlo.'); return; }
      setPerfilForm(perfilActualizado); setEliminarArticuloId(null); mostrarNotificacion('Producto o servicio eliminado.', 'success');
    } finally { setGuardandoCatalogo(false); }
  };
  const usarArticuloCatalogo = (a: ArticuloCatalogo) => {
    if (perfilForm.es_premium !== true || modoCatalogo !== 'presupuesto') return;
    if (a.moneda !== nuevoPresupuesto.moneda) { setErrorCatalogo(`Este artículo está en ${a.moneda}. El presupuesto está en ${nuevoPresupuesto.moneda}; elegí un artículo de la misma moneda.`); return; }
    setNuevoPresupuesto(prev => ({ ...prev, items: insertarArticuloCatalogo(prev.items, a) }));
    setModoCatalogo(null); mostrarNotificacion('Producto o servicio agregado al presupuesto.', 'success');
  };

  const [nuevoCliente, setNuevoCliente] = useState({
    nombre_razon_social: '',
    cuit_cuil: '',
    tipo_documento: 'CUIT/CUIL',
    condicion_tributaria: 'Responsable Inscripto',
    iibb: '',
    email: '',
    telefono: '',
    contacto_compras: '',
    direccion: '',
    observaciones: ''
  });

  const procesarDocumentoInput = (valor: string) => {
    const soloDigitos = valor.replace(/\D/g, '').slice(0, 11);
    let tipoDetectado = 'DNI';
    if (soloDigitos.length > 8) {
      tipoDetectado = 'CUIT/CUIL';
    }
    return { valorLimpio: soloDigitos, tipoDetectado };
  };

  const sanitizarSvgParaLogo = (svg: string): string => {
    try {
      const parser = new DOMParser();
      const doc = parser.parseFromString(svg, 'image/svg+xml');
      const root = doc.documentElement;
      if (!root || root.nodeName.toLowerCase() !== 'svg') return '';

      doc.querySelectorAll('script, foreignObject, iframe, object, embed').forEach(el => el.remove());
      doc.querySelectorAll('*').forEach(el => {
        Array.from(el.attributes).forEach(attr => {
          const nombre = attr.name.toLowerCase();
          const valor = attr.value.trim().toLowerCase();
          if (nombre.startsWith('on') || valor.startsWith('javascript:') || valor.startsWith('data:text/html')) {
            el.removeAttribute(attr.name);
          }
        });
      });

      return new XMLSerializer().serializeToString(root);
    } catch {
      return '';
    }
  };

  const cargarFotoPerfil = (e: React.ChangeEvent<HTMLInputElement>) => {
    const archivo = e.target.files?.[0];
    e.target.value = '';
    if (!archivo) return;
    if (!['image/png', 'image/jpeg', 'image/webp'].includes(archivo.type)) {
      mostrarNotificacion('Seleccioná una foto PNG, JPG o WEBP.', 'error');
      return;
    }
    if (archivo.size > 5 * 1024 * 1024) {
      mostrarNotificacion('La foto debe pesar hasta 5 MB.', 'error');
      return;
    }
    const lector = new FileReader();
    lector.onerror = () => mostrarNotificacion('No se pudo leer la foto. Volvé a seleccionarla.', 'error');
    lector.onload = async () => {
      const foto = String(lector.result || '');
      if (!foto) return;
      const nuevoPerfil = { ...perfilForm, foto_perfil_url: foto };
      if(!await sincronizarConCloudDirecto(nuevoPerfil,clientes,presupuestos))return;
      setPerfilForm(nuevoPerfil);
      mostrarNotificacion('Foto de perfil actualizada.', 'success');
    };
    lector.readAsDataURL(archivo);
  };

  const handleLogoUploadAndSave = (e: React.ChangeEvent<HTMLInputElement>) => {
    if (perfilForm.es_premium !== true) {
      e.target.value = '';
      mostrarNotificacion('El logotipo personalizado es una función de MiOficio Premium.', 'error');
      return;
    }
    const file = e.target.files?.[0];
    if (file) {
      const tiposLogo = ['image/png', 'image/jpeg', 'image/webp', 'image/svg+xml'];
      const extensionAdmitida = /\.(png|jpe?g|webp|svg)$/i.test(file.name);
      if ((!file.type && !extensionAdmitida) || (file.type && !tiposLogo.includes(file.type))) {
        e.target.value = '';
        mostrarNotificacion('Seleccioná un logo en formato PNG, JPG, WEBP o SVG.', 'error');
        return;
      }
      if (file.size > 5 * 1024 * 1024) {
        e.target.value = '';
        mostrarNotificacion('El logo debe pesar hasta 5 MB.', 'error');
        return;
      }
      e.target.value = '';
      const reader = new FileReader();
      reader.onerror = () => mostrarNotificacion('No se pudo leer el archivo. Volvé a seleccionarlo.', 'error');
      reader.onload = async () => {
        const resultado = String(reader.result || '');
        let logoFinal = resultado;

        if (file.type === 'image/svg+xml' || file.name.toLowerCase().endsWith('.svg')) {
          const partes = resultado.split(',');
          const payload = partes.slice(1).join(',');
          const svgOriginal = partes[0]?.includes(';base64')
            ? atob(payload)
            : decodeURIComponent(payload || resultado);
          const svgSeguro = sanitizarSvgParaLogo(svgOriginal);
          if (!svgSeguro) {
            mostrarNotificacion('El SVG no es válido o contiene contenido no permitido.', 'error');
            return;
          }
          logoFinal = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svgSeguro)}`;
        }

        const nuevoPerfil = { ...perfilForm, logo_url: logoFinal };
        if(!await sincronizarConCloudDirecto(nuevoPerfil,clientes,presupuestos))return;
        setPerfilForm(nuevoPerfil);
        mostrarNotificacion('Logotipo personalizado cargado y sincronizado en la nube');
      };
      reader.readAsDataURL(file);
    }
  };

  const guardarMediosDeCobro = async () => {
    if(!await sincronizarConCloudDirecto(perfilForm,clientes,presupuestos))return;
    mostrarNotificacion('Medios de cobro guardados correctamente','success');setShowModalCobros(false);
  };
  const eliminarLogoGuardado = async () => {
    if(perfilForm.es_premium!==true){mostrarNotificacion('El logo personalizado está disponible con Premium.','error');return;}
    const nuevoPerfil={...perfilForm,logo_url:''};
    if(!await sincronizarConCloudDirecto(nuevoPerfil,clientes,presupuestos))return;
    setPerfilForm(nuevoPerfil);mostrarNotificacion('Logotipo eliminado correctamente');
  };

  const agregarItem = () => {
    setNuevoPresupuesto({
      ...nuevoPresupuesto,
      items: [...nuevoPresupuesto.items, { tipo: '', descripcion: '', cantidad: 1, unidad: 'un.', precio_unitario: 0, bonificacion: 0, iva: 21 }]
    });
  };

  const formatearAlcanceDocumento = (valor: string) => {
    return String(valor || '')
      .replace(/\r/g, '')
      .split(/\n+/)
      .map(linea => linea.trim())
      .map(linea => linea.replace(/^(?:[•●▪·\-°]+\s*)+/, '').trim())
      .filter(Boolean)
      .join(' / ');
  };

  const [presupuestoCreado,setPresupuestoCreado]=useState<Presupuesto|null>(null);
  const [pdfCreado,setPdfCreado]=useState<{url:string;archivo:File}|null>(null);
  const [errorPdfCreado,setErrorPdfCreado]=useState('');
  const [avisoCompartirCreado,setAvisoCompartirCreado]=useState('');
  const [compartiendoCreado,setCompartiendoCreado]=useState(false);
  const [reintentoPdfCreado,setReintentoPdfCreado]=useState(0);
  const confirmacionPresupuestoRef=useRef<HTMLDialogElement|null>(null);
  useEffect(()=>{
    const dialogo=confirmacionPresupuestoRef.current;
    if(!presupuestoCreado||!dialogo)return;
    if(!dialogo.open)dialogo.showModal();
    dialogo.scrollTop=0;dialogo.querySelector<HTMLButtonElement>('[aria-label="Cerrar confirmación"]')?.focus({preventScroll:true});
    const anterior=document.body.style.overflow;document.body.style.overflow='hidden';
    return()=>{document.body.style.overflow=anterior;if(dialogo.open)dialogo.close();};
  },[presupuestoCreado]);
  useEffect(()=>{
    setPdfCreado(null);setErrorPdfCreado('');setAvisoCompartirCreado('');
    if(!presupuestoCreado)return;
    let vigente=true,url='';
    void(async()=>{
      try{
        const doc=new jsPDF({orientation:'portrait',unit:'mm',format:'a4'});
        await renderizarPaginaPresupuesto(doc,presupuestoCreado);
        if(!vigente)return;
        const blob=doc.output('blob');url=URL.createObjectURL(blob);
        const nombre=String(presupuestoCreado.numero_presupuesto||'presupuesto').replace(/[^a-zA-Z0-9_-]/g,'_')+'.pdf';
        setPdfCreado({url,archivo:new File([blob],nombre,{type:'application/pdf'})});
      }catch{if(vigente)setErrorPdfCreado('El presupuesto está guardado. No se pudo preparar el PDF; volvé a intentarlo.');}
    })();
    return()=>{vigente=false;if(url)URL.revokeObjectURL(url);};
  },[presupuestoCreado,reintentoPdfCreado]);
  const descargarPdfCreado=()=>{
    if(!pdfCreado)return;
    const enlace=document.createElement('a');enlace.href=pdfCreado.url;enlace.download=pdfCreado.archivo.name;
    document.body.appendChild(enlace);enlace.click();enlace.remove();
  };
  const compartirPdfCreado=async()=>{
    if(!pdfCreado||compartiendoCreado)return;
    setAvisoCompartirCreado('');
    if(!navigator.share||!navigator.canShare?.({files:[pdfCreado.archivo]})){
      setAvisoCompartirCreado('Este navegador no permite compartir archivos. Descargá el PDF y adjuntalo en el chat de WhatsApp de tu cliente.');return;
    }
    setCompartiendoCreado(true);
    try{await navigator.share({files:[pdfCreado.archivo],title:pdfCreado.archivo.name});}
    catch(error){if(!(error instanceof Error&&error.name==='AbortError'))setAvisoCompartirCreado('No se pudo compartir. Podés volver a intentarlo o descargar el PDF.');}
    finally{setCompartiendoCreado(false);}
  };

  const handleCrearPresupuesto = async (guardarComoBorrador = false) => {
    if (emitiendoRef.current) return;
if ((!guardarComoBorrador || nuevoPresupuesto.cliente.trim()) && !clientes.some(c=>c.nombre_razon_social===nuevoPresupuesto.cliente&&(c.cuit_cuil||'')===nuevoPresupuesto.cuit)) { mostrarNotificacion('Seleccioná un cliente guardado o registralo desde Nuevo cliente.', 'error'); document.getElementById('b94-client')?.focus(); return; }
    if (!guardarComoBorrador && (!nuevoPresupuesto.cliente.trim() || !nuevoPresupuesto.items.some(i => i.descripcion.trim() && i.cantidad > 0))) {
      mostrarNotificacion('Completá el cliente y al menos un producto o servicio.', 'error');
      return;
    }
    
    if(!guardarComoBorrador){
      const invalido=nuevoPresupuesto.items.some(i=>i.descripcion.trim()&&(!Number.isFinite(i.cantidad)||i.cantidad<=0||!Number.isFinite(i.precio_unitario)||i.precio_unitario<0||!Number.isFinite(i.bonificacion??0)||(i.bonificacion??0)<0||(i.bonificacion??0)>100||![0,10.5,21,27].includes(i.iva??21)));
      if(invalido||!Number.isFinite(Number(nuevoPresupuesto.descuento))||Number(nuevoPresupuesto.descuento)<0||Number(nuevoPresupuesto.descuento)>100){mostrarNotificacion('Revisá cantidades, precios, IVA y descuentos antes de generar el presupuesto.','error');return;}
    }
const limitesTexto: [string, string, number][] = [
      ['cliente', String(nuevoPresupuesto.cliente || ''), 80],
      ['cuit', String(nuevoPresupuesto.cuit || ''), 20],
      ['telefono', String(nuevoPresupuesto.telefono || ''), 30],
      ['email', String(nuevoPresupuesto.email || ''), 100],
      ['direccion_obra', String(nuevoPresupuesto.direccion_obra || ''), 100],
      ['tiempo_ejecucion', String(nuevoPresupuesto.tiempo_ejecucion || ''), 60],
      ['garantia', String(nuevoPresupuesto.garantia || ''), 60],
      ['condiciones_adicionales', String(nuevoPresupuesto.condiciones_adicionales || ''), 300],
      ['observaciones_extra', String(nuevoPresupuesto.observaciones_extra || ''), 300],
      ...nuevoPresupuesto.items.map((item, index): [string, string, number] => [`Producto / servicio ${index + 1}`, item.descripcion, 160])
    ];
    const excedido = limitesTexto.find(([, value, max]) => value.length > max);
    if (excedido) { mostrarNotificacion(`El campo ${excedido[0]} admite hasta ${excedido[2]} caracteres. Revisalo antes de emitir.`, 'error'); return; }
    emitiendoRef.current = true;
    setEmitiendo(true);
    try {
    const totalNeto = calcularTotalesPresupuesto(nuevoPresupuesto.items, Number(nuevoPresupuesto.descuento)).total;

    let notasFinales = '';
    if (incluirEspecificaciones) {
      const tecnica = [
        paramLinea1.trim() ? `${paramLabel1} ${limitarEspecificacion(paramLinea1,0).trim()}` : '',
        esRubroNautico && paramLinea2.trim() ? `${paramLabel2} ${limitarEspecificacion(paramLinea2,1).trim()}` : '',
        mostrarTercerDatoTrabajo && paramLinea3.trim() ? `${paramLabel3} ${limitarEspecificacion(paramLinea3,2).trim()}` : ''
      ].filter(Boolean);
      notasFinales = tecnica.join('\n');
    }
    if (incluirNota && nuevoPresupuesto.observaciones_extra.trim()) {
      notasFinales += (notasFinales ? '\n' : '') + `Nota adicional: ${nuevoPresupuesto.observaciones_extra.trim()}`;
    }

    // Editing an issued document creates a separate draft and preserves its payments.
    const documentoBase = presupuestoEnEdicion && (!guardarComoBorrador || presupuestoEnEdicion.estado === 'Borrador') ? presupuestoEnEdicion : null;
    const nuevo: Presupuesto = {
      ...(documentoBase || {}),
      presupuesto_id: documentoBase?.presupuesto_id ?? (presupuestos.length > 0 ? Math.max(...presupuestos.map(p => p.presupuesto_id)) + 1 : 1),
      numero_presupuesto: documentoBase?.numero_presupuesto || numeroPresupuestoActual,
      cliente: nuevoPresupuesto.cliente,
      condicion_iva_cliente: nuevoPresupuesto.condicion_iva_cliente || '',
      cuit_cuil: nuevoPresupuesto.cuit || 'Sin documento',
      email: nuevoPresupuesto.email,
      telefono: nuevoPresupuesto.telefono,
      direccion_obra: nuevoPresupuesto.direccion_obra,
      validez_dias: Number(nuevoPresupuesto.validez_dias),
      forma_pago: nuevoPresupuesto.forma_pago.trim(),
      tiempo_ejecucion: nuevoPresupuesto.tiempo_ejecucion.trim(),
      garantia: nuevoPresupuesto.garantia.trim(),
      condiciones_adicionales: nuevoPresupuesto.condiciones_adicionales.trim(),
      incluir_condiciones_adicionales: nuevoPresupuesto.incluir_condiciones_adicionales !== false,
      descuento: Number(nuevoPresupuesto.descuento),
      moneda: nuevoPresupuesto.moneda,
      estado: guardarComoBorrador ? 'Borrador' : ['Borrador','Cancelado'].includes(documentoBase?.estado||'') ? 'Emitido' : documentoBase?.estado || 'Emitido',
      total: totalNeto,
      ...(documentoBase?.total_acordado!==undefined?{total_acordado:totalNeto}:{}),
      fecha: documentoBase?.fecha || fechaArgentina(),
      rubro: rubroActual,
      tipo_proyecto: '', // legado: el concepto comercial vive únicamente en Producto / Servicio
      notas: notasFinales,
      notas_adicionales: incluirNota ? nuevoPresupuesto.observaciones_extra.trim() : '',
      especificaciones: incluirEspecificaciones ? [
        paramLinea1.trim() ? `${paramLabel1} ${limitarEspecificacion(paramLinea1,0).trim()}` : '',
        esRubroNautico && paramLinea2.trim() ? `${paramLabel2} ${limitarEspecificacion(paramLinea2,1).trim()}` : '',
        mostrarTercerDatoTrabajo && paramLinea3.trim() ? `${paramLabel3} ${limitarEspecificacion(paramLinea3,2).trim()}` : ''
      ].filter(Boolean).join('\n') : '',
      incluir_especificaciones: incluirEspecificaciones,
      incluir_condiciones: incluirCondiciones,
      incluir_nota: incluirNota,
      incluir_pago: incluirPago,
      items: nuevoPresupuesto.items
    };

    nuevo.total = contenidoDocumento(nuevo).total;
    if(documentoBase&&!guardarComoBorrador){
      const conservados=conservarCobrosAlEditar(documentoBase,totalVigentePresupuesto(nuevo));
      nuevo.estado=conservados.estado;nuevo.cobros=conservados.cobros;
    }
    if (guardarComoBorrador) {
      const nuevosPresupuestos = documentoBase ? presupuestos.map(p => p.presupuesto_id === nuevo.presupuesto_id ? nuevo : p) : [nuevo,...presupuestos];
      const siguiente = String(secuenciaDisponible+1);
      const perfilGuardado = !documentoBase && perfilForm.es_premium === true ? {...perfilForm,serie_siguiente:siguiente} : perfilForm;
      if (!await sincronizarConCloudDirecto(perfilGuardado,clientes,nuevosPresupuestos)) throw new Error('No se pudo guardar el borrador. Volvé a intentar.');
      setPresupuestos(nuevosPresupuestos);
      if (!documentoBase) {setProximoNumeroSerie(siguiente);if (perfilForm.es_premium === true) setPerfilForm(perfilGuardado);}
      setShowModalPresupuesto(false);setPresupuestoEnEdicion(null);
      setBusquedaPresupuesto('');setFiltroEstadoPresupuesto('Borrador');setPaginaPresupuestos(1);setActiveTab('presupuestos');
      mostrarNotificacion(`Borrador ${nuevo.numero_presupuesto} guardado correctamente`,'success');
      return;
    }
    if (documentoBase) {
      const nuevosPresupuestos = presupuestos.map(p => p.presupuesto_id === nuevo.presupuesto_id ? nuevo : p);
      const guardado = await sincronizarConCloudDirecto(perfilForm, clientes, nuevosPresupuestos);
      if (!guardado) throw new Error('No se pudieron guardar los cambios. Volvé a intentar.');
      setPresupuestos(nuevosPresupuestos);
      setShowModalPresupuesto(false);
      setPresupuestoEnEdicion(null);
      if (documentoBase.estado === 'Borrador') {
        setFiltroEstadoPresupuesto('Todos');setBusquedaPresupuesto('');setPaginaPresupuestos(1);setActiveTab('presupuestos');
        setPresupuestoCreado(nuevo);
        mostrarNotificacion(`Presupuesto ${nuevo.numero_presupuesto} emitido`,'success');
      } else mostrarNotificacion(`Presupuesto ${nuevo.numero_presupuesto} actualizado correctamente`, 'success');
      return;
    }

    const nuevosPresupuestos = [nuevo, ...presupuestos];
    const siguienteNumero=String(secuenciaDisponible+1);
    const perfilEmision=perfilForm.es_premium===true?{...perfilForm,serie_siguiente:siguienteNumero}:perfilForm;
    const guardado = await sincronizarConCloudDirecto(perfilEmision, clientes, nuevosPresupuestos);
    if (!guardado) throw new Error('No se pudo guardar el presupuesto. Volvé a intentar.');
    setPresupuestos(nuevosPresupuestos);
    if(perfilForm.es_premium===true)setPerfilForm(perfilEmision);
    setShowModalPresupuesto(false);
    setProximoNumeroSerie(String(secuenciaDisponible + 1));
    setPresupuestoEnEdicion(null);
    setBusquedaPresupuesto('');setFiltroEstadoPresupuesto('Todos');setPaginaPresupuestos(1);setActiveTab('presupuestos');
    setPresupuestoCreado(nuevo);
    mostrarNotificacion(`Presupuesto ${nuevo.numero_presupuesto} emitido`, 'success');
    } catch (error) {
      mostrarNotificacion(error instanceof Error ? error.message : (presupuestoEnEdicion ? 'No se pudieron guardar los cambios.' : 'No se pudo emitir el presupuesto.'), 'error');
    } finally {
      emitiendoRef.current = false;
      setEmitiendo(false);
    }
  };

  const abrirEditorPresupuesto = (p: Presupuesto) => {
    const etiquetasGuardadas = obtenerPlantillaRubro(p.rubro || perfilForm.oficio_rubro || 'Servicios Náuticos').etiquetas;
    const esNauticoGuardado = etiquetasGuardadas[0] === 'Embarcación:';
    const etiquetaReferencia = esNauticoGuardado ? etiquetasGuardadas[0] : 'Lugar o referencia del trabajo:';
    setParamLabel1(etiquetaReferencia);
    setParamLabel2(etiquetasGuardadas[1]);
    setParamLabel3(etiquetasGuardadas[2]);

    const especificaciones = (p.especificaciones || '')
      .split(/\r?\n/)
      .map(v => v.trim())
      .filter(Boolean);

    const limpiarValor = (linea: string, label: string) => {
      let valor = String(linea || '').trim();
      if (label === 'Lugar del trabajo:') valor = valor.replace(/^(?:[•●▪·-]\s*)*Instalación\s*\/\s*circuito\s*[:：]?\s*/i, '');

      // Elimina todas las viñetas del comienzo.
      valor = valor.replace(/^(?:[•●▪·-]\s*)+/, '').trim();

      const etiqueta = String(label || '')
        .replace(/[:：]\s*$/, '')
        .trim();

      if (etiqueta) {
        const esc = etiqueta.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const patron = new RegExp(`^${esc}\\s*[:：]?\\s*`, 'i');

        // Puede venir repetida varias veces en presupuestos anteriores.
        for (let i = 0; i < 10; i++) {
          const anterior = valor;
          valor = valor.replace(/^(?:[•●▪·-]\s*)+/, '').trim();
          if (patron.test(valor)) {
            valor = valor.replace(patron, '').trim();
          }
          if (valor === anterior) break;
        }
      }

      // Si quedó nuevamente la misma etiqueta después de otra viñeta,
      // repetir la limpieza hasta obtener solamente el contenido.
      valor = valor.replace(/^(?:[•●▪·-]\s*)+/, '').trim();
      return valor;
    };

    setParamLinea1(especificaciones[0] ? limitarEspecificacion(limpiarValor(especificaciones[0], etiquetaReferencia).replace(/^[^:：]{1,80}[:：]\s*/, ''),0) : '');
    setParamLinea2(especificaciones[1] ? limitarEspecificacion(limpiarValor(especificaciones[1], etiquetasGuardadas[1]),1) : '');
    setParamLinea3(especificaciones[2] ? limitarEspecificacion(limpiarValor(especificaciones[2], etiquetasGuardadas[2]),2) : '');

    setPresupuestoEnEdicion({ ...p, items: (p.items || []).map(item => ({ ...item })) });
    setNuevoPresupuesto({
      cliente: p.cliente || '',
      condicion_iva_cliente: p.condicion_iva_cliente || '',
      cuit: p.cuit_cuil === 'Sin documento' ? '' : (p.cuit_cuil || ''),
      email: p.email || '', telefono: p.telefono || '', direccion_obra: p.direccion_obra || '',
      validez_dias: p.validez_dias ?? 15, forma_pago: p.forma_pago || '',
      tiempo_ejecucion: p.tiempo_ejecucion || '', garantia: p.garantia || '',
      condiciones_adicionales: p.condiciones_adicionales || '',
      incluir_condiciones_adicionales: p.incluir_condiciones_adicionales !== false,
      descuento: p.descuento || 0, moneda: p.moneda || 'ARS',
      observaciones_extra: p.notas_adicionales || '', tipo_proyecto: p.tipo_proyecto || '',
      items: p.items?.length ? p.items.map(item => ({ ...item })) : [{ tipo:'', descripcion:'', cantidad:1, unidad:'un.', precio_unitario:0, bonificacion:0, iva:21 }]
    });
    setIncluirEspecificaciones(p.incluir_especificaciones !== false);
    setIncluirCondiciones(p.incluir_condiciones !== false);
    setIncluirPago(p.incluir_pago !== false);
    setIncluirNota(p.incluir_nota ?? !!p.notas_adicionales?.trim());
    setPasoPresupuesto(1);
    
    setShowModalPresupuesto(true);
  };


  const cambiarEstadoPresupuesto = async (id: number, nuevoEstado: string) => {
    if (guardandoEstadoPresupuesto !== null || guardandoCobro) return false;
    const actual = presupuestos.find(p => p.presupuesto_id === id);
    if (!actual || actual.estado === nuevoEstado) return false;
    if(nuevoEstado==='Pagado'&&saldoPresupuesto(actual)>0){abrirCobro(actual);return false;}
    const resultadoReversion=actual.estado==='Pagado'&&nuevoEstado==='Aceptado'&&cobradoPresupuesto(actual)>0?construirReversionCobro(actual,cobradoPresupuesto(actual),'Pago revertido al volver a Aceptado.',perfilForm):null;
    setGuardandoEstadoPresupuesto(id);
    try {
      const nuevosPresupuestos = presupuestos.map(p => {
        if(p.presupuesto_id!==id)return p;
        if(resultadoReversion)return resultadoReversion.presupuesto;
        return {...p,estado:nuevoEstado,...(nuevoEstado==='Aceptado'?{fecha_aceptacion:fechaArgentina()}:{})};
      });
      const guardado = await sincronizarConCloudDirecto(perfilForm, clientes, nuevosPresupuestos);
      if (!guardado) { mostrarNotificacion('No se pudo guardar el estado. Volvé a intentarlo.', 'error'); return false; }
      setPresupuestos(nuevosPresupuestos);
      mostrarNotificacion(nuevoEstado==='Pagado'?`Pago registrado: ${actual.numero_presupuesto}`:actual.estado==='Pagado'&&nuevoEstado==='Aceptado'?`Pago revertido y saldo pendiente actualizado: ${actual.numero_presupuesto}`:`Estado cambiado a: ${nuevoEstado}`);
      if(resultadoReversion)abrirMovimientoCobro({tipo:'correccion',p:resultadoReversion.presupuesto,r:resultadoReversion.reversion,fecha:resultadoReversion.reversion.fecha,importe:resultadoReversion.reversion.importe},true);
      return true;
    } catch { mostrarNotificacion('No se pudo guardar el estado. Volvé a intentarlo.', 'error'); return false; }
    finally { setGuardandoEstadoPresupuesto(null); }
  };

  const marcarPresupuesto=(id:number)=>setPresupuestosMarcados(prev=>prev.includes(id)?prev.filter(value=>value!==id):[...prev,id]);
  const borrarPresupuestosMarcados=async()=>{
    if(borrandoPresupuestos)return;setBorrandoPresupuestos(true);
    try{const ids=new Set(presupuestosMarcados);const nuevos=presupuestos.filter(p=>!ids.has(p.presupuesto_id));if(!await sincronizarConCloudDirecto(perfilForm,clientes,nuevos))return;setPresupuestos(nuevos);setPresupuestosMarcados([]);setConfirmarBorradoMultiple(false);setPaginaPresupuestos(1);mostrarNotificacion('Presupuestos eliminados correctamente','success');}finally{setBorrandoPresupuestos(false);}
  };
  const seleccionPresupuesto=(p:Presupuesto)=><input type="checkbox" aria-label={`Seleccionar ${p.numero_presupuesto}`} checked={presupuestosMarcados.includes(p.presupuesto_id)} disabled={borrandoPresupuestos} onChange={()=>marcarPresupuesto(p.presupuesto_id)} style={{width:16,height:16,minHeight:16,marginRight:7,accentColor:'#2563eb',flexShrink:0}}/>;
  const fechaHoraInicio=horaArgentina===null?'':new Date(horaArgentina).toLocaleString('es-AR',{timeZone:'America/Argentina/Buenos_Aires',weekday:'long',day:'2-digit',month:'long',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false});

  const eliminarPresupuesto = (id: number, numero: string) => {
    setItemAEliminar({ id, numero, tipo: 'presupuesto' });
    setShowModalEliminar(true);
  };

  const confirmarEliminacionPresupuesto = () => {
    confirmarEliminacion();
  };

  const datosClienteVacios = () => ({
    nombre_razon_social: '', cuit_cuil: '', tipo_documento: 'CUIT/CUIL',
    condicion_tributaria: 'Responsable Inscripto', iibb: '', email: '',
    telefono: '', contacto_compras: '', direccion: '', observaciones: ''
  });

  const abrirNuevoCliente = () => {
    setClienteEnEdicion(null);
    setNuevoCliente(datosClienteVacios());
    setShowModalCliente(true);
  };

  const abrirEditorCliente = (cliente: Cliente) => {
    setNuevoCliente({
      nombre_razon_social: cliente.nombre_razon_social || '',
      cuit_cuil: cliente.cuit_cuil || '',
      tipo_documento: cliente.tipo_documento || 'CUIT/CUIL',
      condicion_tributaria: cliente.condicion_tributaria || '',
      iibb: cliente.iibb || '', email: cliente.email || '',
      telefono: cliente.telefono || '', contacto_compras: cliente.contacto_compras || '',
      direccion: cliente.direccion || '', observaciones: cliente.observaciones || ''
    });
    setClienteEnEdicion(cliente);
    setShowModalCliente(true);
  };

  const cerrarFormularioCliente = () => {
    setShowModalCliente(false);
    setClienteEnEdicion(null);
  };

  const [guardandoCliente, setGuardandoCliente] = useState(false);
  const guardandoClienteRef = useRef(false);
  const handleCrearCliente = async (e: FormEvent<HTMLFormElement>) => {
    e.preventDefault();
    if (guardandoClienteRef.current) return;
    if (!nuevoCliente.nombre_razon_social.trim() || !nuevoCliente.cuit_cuil || nuevoCliente.cuit_cuil.length < 7) {
      mostrarNotificacion('Ingresá el nombre y un número de CUIT o DNI válido.', 'error');
      return;
    }
    
    if(clientes.some(c=>c.cliente_id!==clienteEnEdicion?.cliente_id&&String(c.cuit_cuil||'').replace(/\D/g,'')===nuevoCliente.cuit_cuil)){mostrarNotificacion('Ya tenés un cliente con ese CUIT o DNI. Seleccionalo de la lista o editá su ficha.','error');return;}
const editando = Boolean(clienteEnEdicion);
    const nuevoId = clienteEnEdicion?.cliente_id ?? (clientes.length > 0 ? Math.max(...clientes.map(c => c.cliente_id)) + 1 : 1);
    const cli: Cliente = { ...clienteEnEdicion, ...nuevoCliente, nombre_razon_social: nuevoCliente.nombre_razon_social.trim(), cliente_id: nuevoId };
    const nuevosClientes = editando
      ? clientes.map(c => c.cliente_id === nuevoId ? cli : c)
      : [...clientes, cli];
    guardandoClienteRef.current = true;
    setGuardandoCliente(true);
    try {
      const guardado = await sincronizarConCloudDirecto(perfilForm, nuevosClientes, presupuestos);
      if (!guardado) return;
      setClientes(nuevosClientes);
      if (showModalPresupuesto && !editando) {
        setNuevoPresupuesto(prev => ({ ...prev, cliente: cli.nombre_razon_social,
          cuit: cli.cuit_cuil || '', email: cli.email || '', telefono: cli.telefono || '',
          direccion_obra: cli.direccion || '', condicion_iva_cliente: cli.condicion_tributaria || '' }));
      }
      cerrarFormularioCliente();
      setNuevoCliente(datosClienteVacios());
      mostrarNotificacion(editando ? 'Datos del cliente actualizados correctamente' : 'Cliente registrado correctamente', 'success');
    } finally {
      guardandoClienteRef.current = false;
      setGuardandoCliente(false);
    }
  };

  const eliminarCliente = (id: number, nombre: string) => {
    setItemAEliminar({ id, numero: nombre, tipo: 'cliente' });
    setShowModalEliminar(true);
  };

  const [eliminandoRegistro,setEliminandoRegistro]=useState(false);
  const bloqueoEliminacionRef=useRef(false);
  const confirmarEliminacion=async()=>{
    if(!itemAEliminar||bloqueoEliminacionRef.current)return;
    const objetivo={...itemAEliminar};bloqueoEliminacionRef.current=true;setEliminandoRegistro(true);
    try{
      const nuevosClientes=objetivo.tipo==='cliente'?clientes.filter(c=>c.cliente_id!==objetivo.id):clientes;
      const nuevosPresupuestos=objetivo.tipo==='cliente'?presupuestos:presupuestos.filter(p=>p.presupuesto_id!==objetivo.id);
      if(!await sincronizarConCloudDirecto(perfilForm,nuevosClientes,nuevosPresupuestos))return;
      setClientes(nuevosClientes);setPresupuestos(nuevosPresupuestos);setShowModalEliminar(false);setItemAEliminar(null);
      mostrarNotificacion(`${objetivo.tipo==='cliente'?'Cliente':'Presupuesto'} ${objetivo.numero} eliminado correctamente`,'success');
    }finally{bloqueoEliminacionRef.current=false;setEliminandoRegistro(false);}
  };

  const guardarPerfilManual = async (e: FormEvent<HTMLFormElement>) => {
    e.preventDefault();
    if (guardandoNegocio) return;
    setGuardandoNegocio(true);
    try {if(await sincronizarConCloudDirecto(perfilForm,clientes,presupuestos)) mostrarNotificacion('Cambios guardados correctamente.');}
    finally {setGuardandoNegocio(false);}
  };
  const enviarCambioClave = async () => {
    if(enviandoClave || !user.email) return;
    setEnviandoClave(true);
    try {await sendPasswordResetEmail(auth,user.email);mostrarNotificacion('Te enviamos un enlace para cambiar tu contraseña.');}
    catch {mostrarNotificacion('No pudimos enviar el enlace. Volvé a intentar.','error');}
    finally {setEnviandoClave(false);}
  };

  const presupuestoWhatsappSeleccionado = presupuestos.find(p => String(p.presupuesto_id) === presupuestoWhatsappId);

  const textoWhatsappPresupuesto = (p: Presupuesto) => {
    const emisor = (perfilForm.nombre_comercial || perfilForm.nombre || 'Nuestro negocio').trim();
    const concepto = (p.items || []).map(i => i.descripcion.trim()).find(Boolean);
    return `Hola, ${p.cliente.trim() || 'estimado cliente'}.\n\nLes enviamos adjunto el presupuesto N.º ${p.numero_presupuesto}${concepto ? ` para ${concepto}` : ''}.\n\nLes agradecemos que nos confirmen la recepción. Si desean avanzar con el trabajo, pueden confirmar su aceptación por este medio.\n\nQuedamos a disposición para cualquier consulta.\n\nSaludos,\n${emisor}`;
  };
  const seleccionarPresupuestoWhatsapp = (id: string) => {
    solicitudWhatsapp.current++; setPreparandoWhatsapp(false); setArchivoWhatsapp(null);
    setPresupuestoWhatsappId(id);
    const p = presupuestos.find(p => String(p.presupuesto_id) === id);
    setMensajeWhatsapp(p ? textoWhatsappPresupuesto(p) : '');
  };
  const abrirCompartirWhatsapp = (p?: Presupuesto) => {
    if(perfilForm.es_premium !== true){activarPremium();return;}
    seleccionarPresupuestoWhatsapp(p ? String(p.presupuesto_id) : presupuestos.length === 1 ? String(presupuestos[0].presupuesto_id) : '');
    setMostrarCompartirWhatsapp(true);
  };
  const cerrarCompartirWhatsapp = () => {
    solicitudWhatsapp.current++; setMostrarCompartirWhatsapp(false); setArchivoWhatsapp(null); setPreparandoWhatsapp(false);
  };
  const prepararPdfWhatsapp = async () => {
    if (perfilForm.es_premium !== true) { activarPremium(); return; }
    if (preparandoWhatsapp || compartiendoWhatsapp) return;
    const p = presupuestos.find(p => String(p.presupuesto_id) === presupuestoWhatsappId);
    if (!p) { mostrarNotificacion('Seleccioná el presupuesto que querés enviar.', 'error'); return; }
    const solicitud = ++solicitudWhatsapp.current; setPreparandoWhatsapp(true); setArchivoWhatsapp(null);
    try {
      const doc = new jsPDF({orientation:'portrait',unit:'mm',format:'a4'});
      await renderizarPaginaPresupuesto(doc,p);
      if (solicitud !== solicitudWhatsapp.current) return;
      const blob = doc.output('blob');
      const nombre = (p.numero_presupuesto || 'presupuesto').replace(/[^a-zA-Z0-9_-]/g,'-');
      setArchivoWhatsapp({archivo:new File([blob],`${nombre}.pdf`,{type:'application/pdf'}),url:URL.createObjectURL(blob),presupuestoId:p.presupuesto_id});
    } catch (error) {
      if (solicitud === solicitudWhatsapp.current) mostrarNotificacion(error instanceof Error ? error.message : 'No se pudo preparar el PDF.', 'error');
    } finally { if (solicitud === solicitudWhatsapp.current) setPreparandoWhatsapp(false); }
  };
  useEffect(() => {
    if (!mostrarCompartirWhatsapp || perfilForm.es_premium !== true || !presupuestoWhatsappId) return;
    void prepararPdfWhatsapp();
    // Preparar antes del toque en Compartir conserva la activación necesaria para adjuntar el PDF.
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [mostrarCompartirWhatsapp, compartirMovilDisponible, perfilForm.es_premium, presupuestoWhatsappId]);
  const enviarPdfWhatsapp = async () => {
    if (perfilForm.es_premium !== true) { activarPremium(); return; }
    if (!window.matchMedia('(max-width: 1023px)').matches || !archivoWhatsapp || compartiendoWhatsapp || String(archivoWhatsapp.presupuestoId) !== presupuestoWhatsappId) return;
    if (!navigator.share || !navigator.canShare?.({files:[archivoWhatsapp.archivo]})) {
      mostrarNotificacion('Este navegador no permite adjuntar archivos al compartir. Guardá el PDF y copiá el mensaje para enviarlos desde WhatsApp.', 'error'); return;
    }
    setCompartiendoWhatsapp(true);
    // Iniciar la copia y compartir en el mismo toque: no esperar antes de abrir el menú nativo.
    let copiaMensaje = Promise.resolve(false);
    try { if (navigator.clipboard?.writeText) copiaMensaje = navigator.clipboard.writeText(mensajeWhatsapp.trim()).then(() => true, () => false); } catch { /* Se ofrece copia manual si el dispositivo bloquea el portapapeles. */ }
    try {
      await navigator.share({files:[archivoWhatsapp.archivo],title:archivoWhatsapp.archivo.name});
    } catch (error) {
      if (!(error instanceof Error && error.name === 'AbortError')) mostrarNotificacion('No se pudo compartir. Podés guardar el PDF y copiar el mensaje.', 'error');
    } finally {
      const copiado = await copiaMensaje;
      setCompartiendoWhatsapp(false);
      if (!copiado) mostrarNotificacion('El teléfono no permitió copiar el mensaje. Abrí Otras opciones para copiarlo manualmente.', 'error');
    }
  };
  const copiarMensajeWhatsapp = async () => {
    if (!mensajeWhatsapp.trim()) return;
    try { await navigator.clipboard.writeText(mensajeWhatsapp); mostrarNotificacion('Mensaje copiado. Podés pegarlo en WhatsApp.'); }
    catch { mostrarNotificacion('Seleccioná el texto del mensaje y copiálo desde tu dispositivo.', 'error'); }
  };

  const generarYMostrarPdf = async (p: Presupuesto) => {
    if (p.estado === 'Borrador') {abrirEditorPresupuesto(p);return;} 
    const pestaña = window.open('about:blank', '_blank');
    if(pestaña) pestaña.opener=null;
    try {
      const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
      await renderizarPaginaPresupuesto(doc, p);
      const url=URL.createObjectURL(doc.output('blob'));
      if(pestaña && !pestaña.closed) pestaña.location.replace(url);
      else window.location.assign(url);
    } catch(error) {
      if(pestaña && !pestaña.closed) pestaña.close();
      mostrarNotificacion(error instanceof Error ? error.message : 'No se pudo generar el PDF.', 'error');
    }
  };

  const generarPdfConsolidadoCliente = (clienteObj: Cliente) => {
    if(perfilForm.es_premium !== true){activarPremium();return;}
    setIdsPdfPremium([]);setPdfPremiumListo(null);setMostrarOpcionesCompartir(false);setClientePdfPremium(clienteObj);
  };
  const crearPdfPremiumSeleccionado = async () => {
    if(perfilForm.es_premium !== true){activarPremium();return;}
    const lista=presupuestos.filter(p=>idsPdfPremium.includes(p.presupuesto_id) && p.cliente.trim().toLowerCase()===clientePdfPremium?.nombre_razon_social.trim().toLowerCase());
    if(lista.length<2){mostrarNotificacion('Seleccioná al menos dos presupuestos del mismo cliente.', 'error');return;}
    const pestaña=window.open('about:blank','_blank');if(pestaña)pestaña.opener=null;
    setGenerandoPdfPremium(true);
    try{
      const doc=new jsPDF({orientation:'portrait',unit:'mm',format:'a4'});
      for(let i=0;i<lista.length;i++){if(i)doc.addPage();await renderizarPaginaPresupuesto(doc,lista[i]);}
      const blob=doc.output('blob');const url=URL.createObjectURL(blob);
      const archivo=new File([blob],'presupuestos-cliente.pdf',{type:'application/pdf'});
      setPdfPremiumListo({url,archivo});
      if(pestaña)pestaña.location.replace(url);else window.location.assign(url);
    }catch(error){if(pestaña)pestaña.close();mostrarNotificacion(error instanceof Error?error.message:'No se pudo generar el PDF.','error');}
    finally{setGenerandoPdfPremium(false);}
  };
  const compartirPdfPremium = async () => {
    if(perfilForm.es_premium !== true || !pdfPremiumListo)return;
    try{
      if(navigator.canShare?.({files:[pdfPremiumListo.archivo]}))await navigator.share({files:[pdfPremiumListo.archivo],title:'Presupuestos de '+clientePdfPremium?.nombre_razon_social});
      else mostrarNotificacion('Este navegador no permite compartir archivos. Abrí el PDF y usá la opción de compartir del visor.', 'error');
    }catch(error){if(!(error instanceof Error && error.name==='AbortError'))mostrarNotificacion('No se pudo compartir el archivo.', 'error');}
  };
  const guardarSeriesPremium = async () => {
    if(perfilForm.es_premium !== true){activarPremium();return;}
    const siguiente=Math.floor(Number(proximoNumeroSerie));
    if(!seriePresupuesto.trim() || !/^\d{4}$/.test(anioSerie) || siguiente<1){mostrarNotificacion('Revisá la serie, el año y el próximo número.', 'error');return;}
    const perfil={...perfilForm,prefijo_presupuesto:seriePresupuesto.trim().toUpperCase(),serie_anio:anioSerie,serie_digitos:digitosSerie,serie_siguiente:String(siguiente)};
    const guardado=await sincronizarConCloudDirecto(perfil,clientes,presupuestos);if(!guardado){mostrarNotificacion('No se pudo guardar la numeración.','error');return;}setPerfilForm(perfil);setConfigComercialActiva(null);mostrarNotificacion('Numeración personalizada guardada.');
  };
  const listadoPresupuestosInicio = (limite: number) => (
    <section className="inicio-recent"><div className="inicio-recent-header"><h2><IconoPanel name="quotes" />Últimos presupuestos</h2></div>
      {presupuestosRecientesCompletos.length===0 ? <div className="inicio-recent-empty"><strong>Todavía no hay presupuestos</strong><p>Creá el primero con Nuevo presupuesto.</p></div> : <div className="inicio-recent-list">{presupuestosRecientesCompletos.slice(0,limite).map(p => <div key={p.presupuesto_id} className="inicio-recent-row final-quote-row"><button type="button" className="recent-open" aria-label={`Abrir presupuesto ${p.numero_presupuesto} de ${p.cliente || 'cliente'}`} onClick={() => {setShowDatosNegocioMovil(false);abrirDetallePresupuesto(p);}}><span className="inicio-recent-icon"><IconoPanel name="quotes" /></span><span className="inicio-recent-copy"><strong>{p.numero_presupuesto}</strong><span>{p.cliente || 'Sin cliente'} · {fechaCortaCompacta(p.fecha)}</span></span><span className="inicio-recent-value"><strong>{importeFilaCompacta(p)}</strong><span className={`inicio-recent-status ${p.estado==='Pagado' ? 'is-paid' : p.estado==='Aceptado' ? 'is-accepted' : 'is-issued'}`}>{estadoPagoVisible(p)}</span></span></button>{p.estado!=='Borrador' && <button type="button" className="recent-share" aria-label={`Compartir ${p.numero_presupuesto} por WhatsApp`} title="Compartir por WhatsApp · Premium" onClick={() => abrirCompartirWhatsapp(p)}><IconoOficial nombre="message-circle" /></button>}</div>)}</div>}
    </section>
  );

  const listadoClientesRecientesInicio = () => (
    <section className="inicio-recent" aria-label="Clientes recientes">
      <div className="inicio-recent-header"><h2><IconoPanel name="clients" />Clientes recientes</h2></div>
      {clientes.length === 0 ? <div className="inicio-recent-empty"><IconoPanel name="clients" className="h-6 w-6" /><strong>Todavía no hay clientes registrados</strong><p>Los clientes que agregues aparecerán acá.</p></div> : <div className="inicio-recent-list">
        {[...clientes].sort((a,b) => b.cliente_id-a.cliente_id).slice(0,2).map(c => {
          const nombre = c.nombre_razon_social || 'Cliente';
          const iniciales = nombre.trim().split(/\s+/).slice(0,2).map(v => v[0]).join('').toUpperCase();
          return <button key={c.cliente_id} type="button" className="inicio-recent-row" aria-label={`Abrir perfil de ${nombre}`} onClick={() => { setShowDatosNegocioMovil(false); setMostrarTodosPresupuestosCliente(false); setMostrarHistorialCliente(false); setClienteSeleccionadoParaVer(c); }}>
            <span className="inicio-recent-icon" aria-hidden="true">{iniciales}</span>
            <span className="inicio-recent-copy"><strong>{nombre}</strong><span>{c.email || c.telefono || 'Cliente registrado'}</span></span>
            
          </button>;
        })}
      </div>}
    </section>
  );

  const obtenerAvisosPresupuestos = () => {
    const hoy = new Date(); hoy.setHours(0,0,0,0);
    return presupuestos.flatMap(p => {
      if (p.estado === 'Borrador' || p.estado === 'Pagado' || p.estado === 'Rechazado' || p.estado === 'Cancelado') return [];
      if (p.estado === 'Aceptado') return perfilForm.notificar_aceptados === false ? [] : [{ presupuesto: p, titulo: 'Pago pendiente de registrar', detalle: 'El presupuesto está aceptado. Registrá el pago cuando lo hayas recibido.' }];
      if (perfilForm.notificar_vencimientos === false || p.incluir_condiciones === false || !p.validez_dias) return [];
      const partes = String(p.fecha || '').split('-').map(Number);
      if (partes.length !== 3 || partes.some(v => !Number.isFinite(v))) return [];
      const vencimiento = new Date(partes[0],partes[1]-1,partes[2]);
      if (Number.isNaN(vencimiento.getTime())) return [];
      vencimiento.setDate(vencimiento.getDate()+Number(p.validez_dias));
      const dias = Math.round((vencimiento.getTime()-hoy.getTime())/86400000);
      if (dias > leerConfiguracionMiOficio(perfilForm).dias_vencimiento) return [];
      return [{ presupuesto: p, titulo: dias < 0 ? 'Validez vencida' : dias === 0 ? 'Vence hoy' : `Vence en ${dias} ${dias === 1 ? 'día' : 'días'}`, detalle: `Validez hasta ${vencimiento.toLocaleDateString('es-AR')}.` }];
    }).sort((a,b) => b.presupuesto.presupuesto_id-a.presupuesto.presupuesto_id);
  };
  const obtenerAvisos = () => {
    const lista: { id: string; tipo: 'presupuestos' | 'perfil'; titulo: string; detalle: string; referencia: string; cambioPlan?: boolean; recontratar?: boolean; cobroId?:number; respuestaCliente?:boolean; revisionPendientes?:boolean; presupuesto?: Presupuesto }[] = obtenerAvisosPresupuestos().map(aviso => ({ id: `presupuesto-${aviso.presupuesto.presupuesto_id}-${aviso.titulo}`, tipo: 'presupuestos', titulo: aviso.titulo, detalle: aviso.detalle, referencia: `${aviso.presupuesto.numero_presupuesto} · ${aviso.presupuesto.cliente}`, presupuesto: aviso.presupuesto }));
    if (!(perfilForm.nombre || '').trim() || !(perfilForm.telefono || '').trim() || !(perfilForm.direccion || '').trim()) lista.push({ id: 'perfil-datos', tipo: 'perfil', titulo: 'Completá los datos de Mi negocio', detalle: 'Revisá tu nombre, teléfono y domicilio para presentar tus presupuestos.', referencia: 'Datos profesionales' });
    if (perfilForm.acepta_transferencia && (!(perfilForm.titular_cuenta || '').trim() || !((perfilForm.cbu_alias || '').trim() || (perfilForm.cbu_cvu || '').trim()))) lista.push({ id: 'perfil-transferencia', tipo: 'perfil', titulo: 'Revisá los datos de transferencia', detalle: 'Agregá el titular y un alias o CBU/CVU para que tus clientes puedan pagarte.', referencia: 'Medios de pago' });
    lista.unshift(...avisosPlan.map(event => ({id:`plan-${event.id}`,tipo:'perfil' as const,titulo:event.title,detalle:`Motivo / nota: ${event.reason}`,referencia:new Intl.DateTimeFormat('es-AR',{dateStyle:'short',timeStyle:'short',timeZone:'America/Argentina/Buenos_Aires',hourCycle:'h23'}).format(new Date(event.at)),cambioPlan:true,recontratar:event.expiresAt === 0})));
    if (perfilForm.es_premium === true && leerConfiguracionMiOficio(perfilForm).recordatorios_cobro) lista.unshift(...presupuestos.filter(p=>p.fecha_recordatorio && p.fecha_recordatorio<=fechaArgentina() && saldoPresupuesto(p)>0).map(p=>({id:`cobro-${p.presupuesto_id}-${p.fecha_recordatorio}`,tipo:'perfil' as const,titulo:'Recordatorio de cobro',detalle:`${p.numero_presupuesto} · ${p.cliente}. Saldo pendiente: ${importeDocumento(saldoPresupuesto(p),p.moneda)}.`,referencia:p.fecha_recordatorio || '',cobroId:p.presupuesto_id})));
    if (recordatorioRevision && hayPresupuestosPendientes && notificacionesActivas) lista.unshift({id:recordatorioRevision.id,tipo:'presupuestos',titulo:'Revisá tus presupuestos pendientes',detalle:'Comprobá si tus clientes respondieron y actualizá el estado de los presupuestos que siguen pendientes.',referencia:recordatorioRevision.fecha,revisionPendientes:true});
    return lista;
  };
  const marcarAvisoLeido = (id: string) => {
    setAvisosLeidos(actuales => actuales.includes(id) ? actuales : [...actuales,id]);
    if (recordatorioRevision?.id===id) {try {localStorage.setItem(claveRevisionPendientes,JSON.stringify({fecha:recordatorioRevision.fecha,leido:true}));} catch {}}
  };
  const botonAvisos = () => <button type="button" onClick={event => { const rect = event.currentTarget.getBoundingClientRect(); setPosicionAvisos({ top: Math.min(rect.bottom+8, Math.max(12, window.innerHeight-220)), right: Math.min(Math.max(12,window.innerWidth-rect.right), Math.max(12, window.innerWidth-Math.min(480,window.innerWidth-24)-12)) }); setAvisosVisibles(100); setFiltroAvisos('todos'); setMostrarAvisos(abierto => !abierto); }} className="relative flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-slate-700 model-icon-button" aria-label="Abrir notificaciones"><IconoOficial nombre="bell" className="h-4 w-4" />{obtenerAvisos().some(aviso => !avisosLeidos.includes(aviso.id)) && <span className="absolute right-1 top-1 h-1.5 w-1.5 rounded-full bg-blue-600" aria-hidden="true" />}</button>;

  const marcaCabecera = (oscura = false) => <div className={`app-brand ${oscura ? 'app-brand-dark' : ''}`}><img src={MIOFICIO_LOGO_PERMANENTE} alt="MiOficio · Plataforma de gestión comercial" /></div>;
  const botonPerfilCabecera = () => <button type="button" onClick={() => { setShowDatosNegocioMovil(false); setMostrarCuentaAcceso(true); }} className="app-account account-mobile-entry account-mobile-button" aria-haspopup="dialog" aria-expanded={mostrarCuentaAcceso} aria-label={`Abrir cuenta de acceso · Cuenta: ${user.name || user.email}`} title={`Cuenta de acceso: ${user.name || user.email}`}><span className="account-mobile-photo">{perfilForm.foto_perfil_url ? <img src={perfilForm.foto_perfil_url} alt="" /> : <IconoPanel name="profile" className="w-4 h-4" />}</span></button>;

  const abrirNuevoPresupuestoInicio = () => {
                        articuloInicioRef.current = null;

                        setPresupuestoEnEdicion(null);
                        setParamLinea1('');
                        setParamLinea2('');
                        setParamLinea3('');
                        setNuevoPresupuesto(prev => ({ ...prev, cliente:'',condicion_iva_cliente:'',cuit:'',email:'',telefono:'',direccion_obra:'',tiempo_ejecucion:'',garantia:perfilForm.garantia_default || '',condiciones_adicionales:perfilForm.condiciones_default || '',validez_dias:Math.max(1,Number(perfilForm.validez_default)||15),descuento:0,items:[{tipo:'',descripcion:'',cantidad:1,unidad:'un.',precio_unitario:0,bonificacion:0,iva:21}], moneda: monedaInicialPerfil(perfilForm), forma_pago: perfilForm.condicion_pago_default || 'A convenir', tipo_proyecto: '', observaciones_extra: '' }));
                        setPasoPresupuesto(1);
                        setShowModalPresupuesto(true);
                      
  };

  const crearDesdeCatalogoInicio = (articulo: ArticuloCatalogo) => {
    if(perfilForm.es_premium !== true){activarPremium();return;}
    abrirNuevoPresupuestoInicio();
    articuloInicioRef.current=articulo;
    setNuevoPresupuesto(prev => ({...prev,moneda:articulo.moneda,items:insertarArticuloCatalogo([],articulo)}));
  };
  const accionesRapidasInicio = () => (
    <section className="inicio-quick-actions" aria-label="Crear presupuesto o cliente">
      <button type="button" className="inicio-quick-budget" onClick={abrirNuevoPresupuestoInicio}>
        <span className="inicio-quick-icon" aria-hidden="true"><IconoPanel name="quotes" className="h-6 w-6" /></span>
        <span className="inicio-quick-copy"><strong>Nuevo presupuesto</strong></span>
        <span className="inicio-quick-plus" aria-hidden="true">+</span>
      </button>
      <button type="button" className="inicio-quick-client" onClick={abrirNuevoCliente}>
        <span className="inicio-quick-icon" aria-hidden="true"><IconoPanel name="clients" className="h-6 w-6" /></span>
        <span className="inicio-quick-copy"><strong>Nuevo cliente</strong></span>
        <span className="inicio-quick-plus" aria-hidden="true">+</span>
      </button>
    </section>
  );

  const presupuestosExportables = filasPresupuestosExportacion(presupuestos,exportarDesde,exportarHasta,exportarMoneda);
  const fechasExportacionInvalidas = Boolean(exportarDesde && exportarHasta && exportarDesde > exportarHasta);
  const cantidadExportable = tipoExportacion === 'clientes' ? clientes.length : presupuestosExportables.length;
  const descargarExportacionPremium = () => {
    if (perfilForm.es_premium !== true) { activarPremium(); return; }
    if ((tipoExportacion === 'presupuestos' && fechasExportacionInvalidas) || !cantidadExportable) return;
    const csv = tipoExportacion === 'clientes' ? contenidoCsvClientes(clientes) : contenidoCsvPresupuestos(presupuestosExportables);
    const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
    const enlace = document.createElement('a'); enlace.href = url;
    enlace.download = `MiOficio_${tipoExportacion}_${new Date().toISOString().slice(0,10)}.csv`;
    document.body.appendChild(enlace); enlace.click(); enlace.remove();
    window.setTimeout(() => URL.revokeObjectURL(url),1000);
    mostrarNotificacion('Archivo CSV generado. Podés abrirlo en Excel o importar sus datos.');
  };
  const [detallePresupuestoId, setDetallePresupuestoId] = useState<number | null>(null);
  const detallePresupuesto = presupuestos.find(p => p.presupuesto_id === detallePresupuestoId);
  const detalleDialogoRef = useRef<HTMLElement | null>(null);
  const abrirDetallePresupuesto = (p: Presupuesto) => setDetallePresupuestoId(p.presupuesto_id);
  useEffect(() => {
    if (detallePresupuestoId === null) return;
    const anterior = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    const dialogo = detalleDialogoRef.current;
    if (!dialogo) return;
    const fondo: HTMLElement[] = [];
    let rama: HTMLElement | null = dialogo.parentElement;
    while (rama && rama.id !== 'mioficio-dashboard') {
      const padre: HTMLElement | null = rama.parentElement;
      if (!padre) break;
      for (const hermano of Array.from(padre.children)) {
        if (hermano !== rama && hermano instanceof HTMLElement && !['STYLE','SCRIPT'].includes(hermano.tagName)) fondo.push(hermano);
      }
      rama = padre;
    }
    const inertes = fondo.map(el => el.inert);
    fondo.forEach(el => { el.inert = true; });
    const overflowAnterior = document.body.style.overflow;
    document.body.style.overflow = 'hidden';
    dialogo.focus();
    const teclado = (event: KeyboardEvent) => {
      if (event.key === 'Escape') { event.preventDefault(); setDetallePresupuestoId(null); }
      if (event.key !== 'Tab') return;
      const controles = Array.from(dialogo.querySelectorAll<HTMLElement>('button:not(:disabled), summary, a[href], input:not(:disabled), select:not(:disabled), [tabindex="0"]')).filter(el => el.getClientRects().length > 0);
      const primero = controles[0], ultimo = controles[controles.length - 1];
      if (!primero) { event.preventDefault(); dialogo.focus(); return; }
      if (event.shiftKey && (document.activeElement === primero || document.activeElement === dialogo)) { event.preventDefault(); ultimo.focus(); }
      else if (!event.shiftKey && (document.activeElement === ultimo || document.activeElement === dialogo)) { event.preventDefault(); primero.focus(); }
    };
    document.addEventListener('keydown', teclado);
    return () => { document.removeEventListener('keydown', teclado); fondo.forEach((el,i) => { el.inert = inertes[i]; }); document.body.style.overflow = overflowAnterior; if(anterior?.isConnected) anterior.focus(); };
  }, [detallePresupuestoId]);
  const [movimientoCobro,setMovimientoCobro]=useState<ComprobanteCobroHub|null>(null);
  const [operacionConfirmada,setOperacionConfirmada]=useState(false);
  const movimientoDialogRef=useRef<HTMLDialogElement|null>(null);
  const descargaComprobanteEnCurso=useRef(false);
  const bloqueoRegistroPago=useRef(false);
  useEffect(()=>{
    const dialog=movimientoDialogRef.current;if(!movimientoCobro||!dialog)return;
    const overflow=document.body.style.overflow;document.body.style.overflow='hidden';
    if(!dialog.open)dialog.showModal();
    return()=>{document.body.style.overflow=overflow;};
  },[movimientoCobro]);
  const abrirMovimientoCobro=(movimiento:ComprobanteCobroHub,confirmado=false)=>{
    setDetallePresupuestoId(null);setCobroObjetivo(null);setOperacionConfirmada(confirmado);setMovimientoCobro(movimiento);
  };
  const [descargandoComprobante,setDescargandoComprobante]=useState<string|null>(null);
  const [cobroObjetivo, setCobroObjetivo] = useState<number | null>(null);
  const cobroDialogoRef=useRef<HTMLDialogElement|null>(null);
  useEffect(()=>{if(cobroObjetivo!==null&&!cobroDialogoRef.current?.open)cobroDialogoRef.current?.showModal();},[cobroObjetivo]);

  const [cobroImporte, setCobroImporte] = useState('');
  const [cobroFecha, setCobroFecha] = useState(fechaArgentina());
  const [cobroMedio, setCobroMedio] = useState('');
  const [cobroNota, setCobroNota] = useState('');
  const [cobroRecordatorio, setCobroRecordatorio] = useState('');
  const [tipoPago,setTipoPago]=useState<'total'|'parcial'>('total');
  const [cobroSoloRecordatorio,setCobroSoloRecordatorio]=useState(false);
  const [guardandoCobro, setGuardandoCobro] = useState(false);
  const [busquedaCobros, setBusquedaCobros] = useState('');
  const [tipoDevolucion,setTipoDevolucion]=useState<'parcial'|'completa'>('parcial');
  const [reversionActiva,setReversionActiva]=useState(false);
  const [reversionImporte,setReversionImporte]=useState('');
  const [reversionMotivo,setReversionMotivo]=useState('');
  const [devolucionMedio,setDevolucionMedio]=useState('Transferencia');
  const [devolucionReferencia,setDevolucionReferencia]=useState('');
  const [devolucionFecha,setDevolucionFecha]=useState(fechaArgentina());
  const [devolucionTotal,setDevolucionTotal]=useState('');
  const bloqueoReversion=useRef(false);
  const descargarPdfReversion=async(p:Presupuesto,r:ReversionCobro)=>{
    if(descargaComprobanteEnCurso.current)return;
    descargaComprobanteEnCurso.current=true;setDescargandoComprobante(r.id);
    try{const doc=await crearPdfReversion(p,r,perfilForm);doc.save(`MiOficio-${r.comprobante?.numero||`${r.tipo==='devolucion'?'DEV':'REV'}-${r.fecha.slice(0,4)}-${r.id.toUpperCase()}`}.pdf`);}
    catch{mostrarNotificacion('No se pudo descargar el comprobante. Volvé a intentar.','error');}
    finally{descargaComprobanteEnCurso.current=false;setDescargandoComprobante(null);}
  };
  const reservarNumeroDevolucion=async(p:Presupuesto,r:ReversionCobro):Promise<string>=>{
    const anio=(r.fecha_devolucion||r.fecha).slice(0,4);
    if(!/^\d{4}$/.test(anio))throw new Error('Fecha de devolución inválida.');
    const clave=Array.from(`${p.presupuesto_id}:${r.id}`).map(v=>v.codePointAt(0)!.toString(16)).join('_');
    const resultado=await runTransaction(ref(db,`usuarios_data/${safeEmailKey}`),actual=>{
      const base=actual||{},series=base.numeracion_devoluciones||{},serie=series[anio]||{},operaciones=serie.operaciones||{};
      if(operaciones[clave])return base;
      let ultimo=Number.isSafeInteger(serie.ultimo)&&serie.ultimo>=0?serie.ultimo:0;
      for(const presupuesto of Object.values(base.presupuestos||{}) as Presupuesto[])for(const devolucion of Object.values(presupuesto.reversiones_cobros||{})){
        const coincidencia=devolucion.comprobante?.numero.match(/^DEV-(\d{4})-(\d+)$/);
        if(coincidencia?.[1]===anio)ultimo=Math.max(ultimo,Number(coincidencia[2]));
      }
      if(!Number.isSafeInteger(ultimo+1))throw new Error('No se pudo asignar el número de devolución.');
      return {...base,numeracion_devoluciones:{...series,[anio]:{...serie,ultimo:ultimo+1,operaciones:{...operaciones,[clave]:`DEV-${anio}-${String(ultimo+1).padStart(4,'0')}`}}}};
    },{applyLocally:false});
    const numero=resultado.snapshot.val()?.numeracion_devoluciones?.[anio]?.operaciones?.[clave];
    if(!resultado.committed||typeof numero!=='string')throw new Error('No se pudo reservar el número de devolución.');
    return numero;
  };

  const confirmarReversionCobro=async()=>{
    if(bloqueoReversion.current||guardandoCobro||guardandoEstadoPresupuesto!==null)return;
    const p=presupuestos.find(item=>item.presupuesto_id===cobroObjetivo);if(!p)return;
    const importe=Number(reversionImporte.trim().replace(',','.'));
    if(!Number.isFinite(importe)||importe<=0||Math.round(importe*100)>Math.round(cobradoPresupuesto(p)*100)||Math.abs(importe*100-Math.round(importe*100))>0.00001){mostrarNotificacion('Ingresá un importe válido de hasta dos decimales que no supere lo cobrado.','error');return;}
    if(!reversionMotivo.trim()){mostrarNotificacion('Indicá qué trabajo se canceló o qué precio se ajustó.','error');return;}
    if(!devolucionTotal.trim()){mostrarNotificacion('Ingresá el nuevo total acordado con el cliente.','error');return;}
    const nuevoTotal=Number(devolucionTotal.trim().replace(',','.'));
    if(!Number.isFinite(nuevoTotal)||nuevoTotal<0||Math.abs(nuevoTotal*100-Math.round(nuevoTotal*100))>0.00001){mostrarNotificacion('Ingresá un total válido de hasta dos decimales.','error');return;}
    if(!/^\d{4}-\d{2}-\d{2}$/.test(devolucionFecha)||devolucionFecha>fechaArgentina()||!Number.isFinite(new Date(devolucionFecha+'T12:00:00Z').getTime())){mostrarNotificacion('Ingresá una fecha de devolución válida, hasta hoy.','error');return;}
    if(nuevoTotal>totalVigentePresupuesto(p)||Math.round(nuevoTotal*100)<Math.round((cobradoPresupuesto(p)-importe)*100)){mostrarNotificacion('Revisá el nuevo total: no puede superar el vigente ni ser menor al dinero que conservás.','error');return;}
    bloqueoReversion.current=true;setGuardandoCobro(true);
    try{
      const resultado=construirDevolucionCobro(p,importe,reversionMotivo,perfilForm,devolucionMedio,devolucionReferencia,devolucionFecha,nuevoTotal);
      if(resultado.reversion.comprobante)resultado.reversion.comprobante.numero=await reservarNumeroDevolucion(p,resultado.reversion);
      const nuevos=presupuestos.map(item=>item.presupuesto_id===p.presupuesto_id?resultado.presupuesto:item);
      if(!await sincronizarConCloudDirecto(perfilForm,clientes,nuevos))return;
      setCobroObjetivo(null);setReversionActiva(false);setPresupuestos(nuevos);
      mostrarNotificacion('Devolución guardada. Comprobante disponible en el historial.');
      abrirMovimientoCobro({tipo:'devolucion',p:resultado.presupuesto,r:resultado.reversion,fecha:resultado.reversion.fecha_devolucion||resultado.reversion.fecha,importe:resultado.reversion.importe},true);
    }catch{mostrarNotificacion('No se pudo guardar la devolución. Volvé a intentar.','error');}
    finally{bloqueoReversion.current=false;setGuardandoCobro(false);}
  };

  const abrirCobro = (p: Presupuesto) => {
    setCobroSoloRecordatorio(false);setTipoPago('total');
    setTipoDevolucion('parcial');setReversionActiva(false);setReversionImporte('');setReversionMotivo('');setDevolucionMedio('Transferencia');setDevolucionReferencia('');setDevolucionFecha(fechaArgentina());setDevolucionTotal('');setCobroObjetivo(p.presupuesto_id); setCobroImporte(String(saldoPresupuesto(p))); setCobroFecha(fechaArgentina());
    setCobroMedio(''); setCobroNota(''); setCobroRecordatorio(p.fecha_recordatorio || '');
  };
  const abrirDevolucion=(p:Presupuesto)=>{
    if(cobradoPresupuesto(p)<=0||guardandoCobro||guardandoEstadoPresupuesto!==null)return;
    abrirCobro(p);setReversionActiva(true);setReversionImporte('');setTipoDevolucion('parcial');
  };
  const asegurarComprobantePago=async(p:Presupuesto,c:CobroPresupuesto):Promise<ComprobantePagoRecibido|null>=>{
    const vigente=presupuestos.find(item=>item.presupuesto_id===p.presupuesto_id)||p;
    const registros=Object.values(vigente.cobros||{}),reversiones=Object.values(vigente.reversiones_cobros||{});
    const archivados=reversiones.flatMap(item=>Object.values(item.cobros||{}));
    const guardado=registros.find(item=>item.id===c.id)?.comprobante_recibido||archivados.find(item=>item.id===c.id&&item.comprobante_recibido)?.comprobante_recibido||c.comprobante_recibido;
    if(guardado)return guardado;
    const operacion=listarComprobantesCobros([vigente]).find(item=>item.tipo==='pago'&&item.c.id===c.id);
    const original=operacion&&operacion.tipo==='pago'?operacion.c:c;
    const datos={...datosComprobanteRecibido(vigente,original,perfilForm),numero:await reservarNumeroRecibo(vigente,original)};
    const repetido=listarComprobantesCobros(presupuestos).some(item=>item.tipo==='pago'&&(item.p.presupuesto_id!==vigente.presupuesto_id||item.c.id!==original.id)&&item.c.comprobante_recibido?.numero===datos.numero);
    if(repetido){mostrarNotificacion('El número de comprobante ya pertenece a otra operación. No se emitió un duplicado.','error');return null;}
    const enArchivo=archivados.some(item=>item.id===original.id),enActivos=registros.some(item=>item.id===original.id);
    if(!enActivos&&!enArchivo&&(registros.length>0||cobradoPresupuesto(vigente)<=0)){mostrarNotificacion('No se encontró la operación original para guardar el comprobante.','error');return null;}
    const cobros=enActivos?registros.map(item=>item.id===original.id?{...item,comprobante_recibido:datos}:item):enArchivo?registros:[{...original,comprobante_recibido:datos}];
    const reversionesConComprobante=enArchivo?reversiones.map(item=>({...item,cobros:Object.values(item.cobros||{}).map(pago=>pago.id===original.id?{...pago,comprobante_recibido:datos}:pago)})):reversiones;
    const nuevos=presupuestos.map(item=>item.presupuesto_id===vigente.presupuesto_id?{...item,cobros,...(enArchivo?{reversiones_cobros:reversionesConComprobante}:{})}:item);
    if(!await sincronizarConCloudDirecto(perfilForm,clientes,nuevos))return null;
    setPresupuestos(nuevos);return datos;
  };
  const descargarPagoRecibido=async(p:Presupuesto,c:CobroPresupuesto)=>{
    if(descargaComprobanteEnCurso.current||guardandoCobro||guardandoEstadoPresupuesto!==null)return;
    if(!['Efectivo','Cheque','Transferencia','Tarjeta','Otro'].includes(c.medio)){mostrarNotificacion('Este pago no tiene un medio registrado para emitir el comprobante.','error');return;}
    descargaComprobanteEnCurso.current=true;setDescargandoComprobante(c.id);
    try{
      const datos=await asegurarComprobantePago(p,c);if(!datos)return;
      const doc=await crearPdfPagoRecibido(datos,perfilForm);doc.save(`MiOficio-${datos.numero}.pdf`);
    }catch{mostrarNotificacion('No se pudo preparar el comprobante. Volvé a intentar.','error');}
    finally{descargaComprobanteEnCurso.current=false;setDescargandoComprobante(null);}
  };
  const registrarCobro = async (soloRecordatorio = false) => {
    if (bloqueoRegistroPago.current || guardandoCobro || guardandoEstadoPresupuesto !== null) return;
    const p = presupuestos.find(item => item.presupuesto_id === cobroObjetivo);
    if (!p) return;
    if (soloRecordatorio && perfilForm.es_premium !== true) { activarPremium(); return; }
    const importe = tipoPago==='total'?saldoPresupuesto(p):Math.round(Number(cobroImporte.replace(',','.')) * 100) / 100;
    const saldo = saldoPresupuesto(p);
    if(!soloRecordatorio&&tipoPago==='parcial'&&importe>=saldo){mostrarNotificacion('El pago parcial debe ser menor al saldo pendiente. Para completar el saldo elegí Pago total.','error');return;}
    if(!soloRecordatorio&&!['Efectivo','Cheque','Transferencia','Tarjeta','Otro'].includes(cobroMedio)){mostrarNotificacion('Seleccioná cómo pagó el cliente.','error');return;}
    if (!soloRecordatorio && (!Number.isFinite(importe) || importe <= 0 || importe > saldo)) { mostrarNotificacion('Ingresá un importe mayor a cero que no supere el saldo.', 'error'); return; }
    if (!soloRecordatorio && perfilForm.es_premium !== true && importe !== saldo) { mostrarNotificacion('Los pagos parciales están incluidos en Premium.', 'error'); return; }
    if (!soloRecordatorio && (!/^\d{4}-\d{2}-\d{2}$/.test(cobroFecha) || cobroFecha > fechaArgentina())) { mostrarNotificacion('Ingresá la fecha del cobro, hasta el día de hoy.', 'error'); return; }
    if (soloRecordatorio && cobroRecordatorio && (!/^\d{4}-\d{2}-\d{2}$/.test(cobroRecordatorio) || cobroRecordatorio < fechaArgentina())) { mostrarNotificacion('Elegí hoy o una fecha futura para el recordatorio.', 'error'); return; }
    bloqueoRegistroPago.current=true;setGuardandoCobro(true);
    try {
      const registro: CobroPresupuesto = {tipo_pago:importe>=saldo?'total':'parcial',id:crypto.randomUUID(),importe,fecha:cobroFecha,medio:cobroMedio,nota:cobroNota.trim().slice(0,200),registradoAt:Date.now()};
      if(!soloRecordatorio)registro.comprobante_recibido={...datosComprobanteRecibido(p,registro,perfilForm,true),numero:await reservarNumeroRecibo(p,registro)};
      const nuevos = presupuestos.map(item => item.presupuesto_id !== p.presupuesto_id ? item : {
        ...item,
        ...(soloRecordatorio ? {} : {cobros:[...Object.values(item.cobros || {}),registro],medio_pago_registrado:cobroMedio,fecha_aceptacion:item.fecha_aceptacion||fechaArgentina(),estado:Math.round(importe*100) >= Math.round(saldo*100) ? 'Pagado' : 'Aceptado'}),
        ...(soloRecordatorio ? {fecha_recordatorio:cobroRecordatorio} : {}),
      });
      if (!await sincronizarConCloudDirecto(perfilForm,clientes,nuevos)) return;
      setPresupuestos(nuevos); setCobroObjetivo(null);
      if(!soloRecordatorio)abrirMovimientoCobro({tipo:'pago',p:nuevos.find(item=>item.presupuesto_id===p.presupuesto_id)!,c:registro,fecha:registro.fecha,importe:registro.importe},true);
      mostrarNotificacion(soloRecordatorio ? 'Recordatorio guardado.' : 'Cobro registrado correctamente.');
    } catch { mostrarNotificacion('No se pudo guardar el pago y su comprobante. Volvé a intentar.','error'); } finally { bloqueoRegistroPago.current=false;setGuardandoCobro(false); }
  };
  const descargarComprobantePagoHub=async(p:Presupuesto,c:CobroPresupuesto)=>{await descargarPagoRecibido(p,c);};
  const numeroReciboGuardado=(presupuestoId:number,pagoId:string)=>{const pago=listarComprobantesCobros(presupuestos).find(item=>item.tipo==='pago'&&item.p.presupuesto_id===presupuestoId&&item.c.id===pagoId&&item.c.comprobante_recibido);return pago?.tipo==='pago'?pago.c.comprobante_recibido?.numero:undefined;};
  const referenciaMovimientoCobro=(r:ComprobanteCobroHub)=>r.tipo==='pago'?(r.c.comprobante_recibido?.numero||numeroReciboGuardado(r.p.presupuesto_id,r.c.id)||'Pendiente de emisión'):(r.r.comprobante?.numero||`${r.tipo==='devolucion'?'DEV':'REV'}-${r.r.fecha.slice(0,4)}-${r.r.id.toUpperCase()}`);
  const tituloMovimientoCobro=(r:ComprobanteCobroHub)=>r.tipo==='pago'?'Pago recibido':r.tipo==='devolucion'?'Devolución de dinero':'Corrección de registro';
  const medioMovimientoCobro=(r:ComprobanteCobroHub)=>r.tipo==='pago'?r.c.medio||'Medio pendiente':r.tipo==='devolucion'?r.r.medio_devolucion||'Sin especificar':'Ajuste del registro';
  const descargarMovimientoCobro=(r:ComprobanteCobroHub)=>{
    if(r.tipo==='pago'){
      if(!['Efectivo','Cheque','Transferencia','Tarjeta','Otro'].includes(r.c.medio))setMovimientoCobro(null);
      void descargarComprobantePagoHub(r.p,r.c);
    }else void descargarPdfReversion(r.p,r.r);
  };
  const filaMovimientoCobro=(r:ComprobanteCobroHub,compacta=false)=><button type="button" className={`collections-receipt ${compacta?'collections-receipt-compact':''}`} data-kind={r.tipo} key={`${r.tipo}-${r.p.presupuesto_id}-${r.tipo==='pago'?r.c.id:r.r.id}`} aria-label={`Ver movimiento ${referenciaMovimientoCobro(r)}`} onClick={()=>abrirMovimientoCobro(r)}><span className={`collections-receipt-icon ${r.tipo}`}><IconoOficial nombre={r.tipo==='pago'?'banknote':r.tipo==='devolucion'?'arrow-left-right':'file-text'}/></span><span className="collections-receipt-copy"><strong>{tituloMovimientoCobro(r)}</strong><span>{r.p.cliente} · {r.p.numero_presupuesto}</span><small>{fechaCortaCompacta(r.fecha)} · {medioMovimientoCobro(r)}</small></span><span className="collections-receipt-amount"><b>{r.tipo==='devolucion'?'− ':r.tipo==='pago'?'+ ':''}{formatearMontoCompacto(r.importe,monedaPresupuesto(r.p.moneda))}</b><small>{r.tipo==='pago'?'Recibido':r.tipo==='devolucion'?'Devuelto':'Corregido'}</small></span><IconoOficial nombre="chevron-right"/></button>;
  const gestionCobros = () => {
    const coincide=(p:Presupuesto)=>[p.cliente,p.numero_presupuesto].join(' ').toLocaleLowerCase('es-AR').includes(busquedaCobros.toLocaleLowerCase('es-AR').trim());
    const base=presupuestos.filter(p=>monedaPresupuesto(p.moneda)===monedaCobrosHub&&coincide(p));
    const monedas=Array.from(new Set(['ARS',...presupuestos.map(p=>monedaPresupuesto(p.moneda))]));
    const saldos=base.filter(p=>['Emitido','Aceptado','Pagado'].includes(p.estado)&&(filtroCobrosHub==='todos'||(filtroCobrosHub==='pendientes'?saldoPresupuesto(p)>0:saldoPresupuesto(p)===0))).sort((a,b)=>Number(saldoPresupuesto(b)>0)-Number(saldoPresupuesto(a)>0)||b.presupuesto_id-a.presupuesto_id);
    const devoluciones=base.filter(p=>cobradoPresupuesto(p)>0||Object.values(p.reversiones_cobros||{}).some(r=>r.tipo==='devolucion')).sort((a,b)=>b.presupuesto_id-a.presupuesto_id);
    const importe=(n:number,p:Presupuesto)=>importeDocumento(n,p.moneda).replace(/^[A-Z]{3}\s+/,'');
    return <section className="collections-hub" aria-label="Gestión de cobros">
      <div className="collections-tabs" role="tablist" aria-label="Funciones de Cobros" onKeyDown={e=>{const ids=['saldos','devoluciones'] as const;const i=ids.indexOf(vistaCobrosHub);const n=e.key==='ArrowRight'||e.key==='ArrowLeft'?(i+1)%2:e.key==='Home'?0:e.key==='End'?1:-1;if(n>=0){e.preventDefault();setVistaCobrosHub(ids[n]);document.getElementById(`cobros-tab-${ids[n]}`)?.focus();}}}>{([{id:'saldos',titulo:'Pagos y saldos',icono:'banknote'},{id:'devoluciones',titulo:'Devoluciones',icono:'arrow-left-right'}] as const).map(t=><button type="button" role="tab" tabIndex={vistaCobrosHub===t.id?0:-1} id={`cobros-tab-${t.id}`} aria-selected={vistaCobrosHub===t.id} aria-controls={`cobros-panel-${t.id}`} key={t.id} onClick={()=>setVistaCobrosHub(t.id)}><IconoOficial nombre={t.icono}/>{t.titulo}</button>)}</div>
      <div className="collections-toolbar" data-view={vistaCobrosHub}><label className="collections-search"><IconoOficial nombre="search"/><input aria-label="Buscar cobros por cliente o presupuesto" placeholder="Cliente o presupuesto" value={busquedaCobros} onChange={e=>setBusquedaCobros(e.target.value)} onKeyDown={e=>{if(e.key==='Escape'&&busquedaCobros){e.preventDefault();e.stopPropagation();setBusquedaCobros('');}}}/><LimpiarBusqueda visible={Boolean(busquedaCobros)} onLimpiar={()=>{setBusquedaCobros('');}} etiqueta="cobros"/></label><select aria-label="Moneda de cobros" value={monedaCobrosHub} onChange={e=>setMonedaCobrosHub(e.target.value)}>{monedas.map(m=><option value={m} key={m}>{m}</option>)}</select>{vistaCobrosHub==='saldos'&&<select aria-label="Filtrar saldos" value={filtroCobrosHub} onChange={e=>setFiltroCobrosHub(e.target.value as 'todos'|'pendientes'|'pagados')}><option value="todos">Todos</option><option value="pendientes">Con saldo pendiente</option><option value="pagados">Sin saldo pendiente</option></select>}</div>
      <div role="tabpanel" id={`cobros-panel-${vistaCobrosHub}`} aria-labelledby={`cobros-tab-${vistaCobrosHub}`}>
        {vistaCobrosHub==='saldos'&&<><div className="collections-section-heading"><h2>Pagos y saldos por presupuesto</h2><small>{saldos.length} {saldos.length===1?'presupuesto':'presupuestos'}</small></div><div className="collections-budget-grid">{saldos.slice(0,50).map(p=><article className="collections-budget" data-long-amount={importe(totalVigentePresupuesto(p),p).length>15} key={p.presupuesto_id}><header><span className="collections-budget-icon"><IconoOficial nombre="file-text"/></span><div><button type="button" className="collections-budget-link" aria-label={`Ver presupuesto ${p.numero_presupuesto}`} onClick={()=>abrirDetallePresupuesto(p)}>{p.numero_presupuesto}</button><span>{p.cliente||'Sin cliente'}</span></div><span className={`finance-status ${p.estado?.toLowerCase()}`} data-financial-status={estadoPagoVisible(p)}>{estadoPagoVisible(p)}</span></header><dl><div><dt>Total vigente</dt><dd>{importe(totalVigentePresupuesto(p),p)}</dd></div><div><dt>Cobrado</dt><dd>{importe(cobradoPresupuesto(p),p)}</dd></div><div><dt>Saldo pendiente</dt><dd>{importe(saldoPresupuesto(p),p)}</dd></div></dl><button type="button" className={saldoPresupuesto(p)>0?'collections-primary':'collections-secondary'} aria-label={`${saldoPresupuesto(p)>0?'Registrar pago':'Ver pagos'} de ${p.numero_presupuesto}`} onClick={()=>abrirCobro(p)}><IconoOficial nombre={saldoPresupuesto(p)>0?'circle-plus':'banknote'}/>{saldoPresupuesto(p)>0?'Registrar pago':'Ver pagos'}<IconoOficial nombre="chevron-right"/></button></article>)}</div>{!saldos.length&&<div className="collections-empty" role="status"><p>{presupuestos.length?'No hay presupuestos que coincidan con la búsqueda o el filtro.':'Todavía no hay presupuestos para registrar pagos.'}</p>{(busquedaCobros||filtroCobrosHub!=='todos')&&<button type="button" className="ui-reset-filters" onClick={()=>{setBusquedaCobros('');setFiltroCobrosHub('todos');}}>Limpiar filtros</button>}</div>}{saldos.length>50&&<p className="collections-hint">Mostrando 50 resultados. Buscá por cliente o número para encontrar otro presupuesto.</p>}</>}
        {vistaCobrosHub==='devoluciones'&&<><div className="collections-section-heading"><h2>Devolver dinero al cliente</h2></div><p className="collections-hint">Registrá una devolución parcial o completa por efectivo, transferencia o cheque.</p><div className="collections-budget-grid">{devoluciones.slice(0,50).map(p=>{const devueltas=Object.values(p.reversiones_cobros||{}).filter(r=>r.tipo==='devolucion');return <article className="collections-budget" data-long-amount={importe(totalVigentePresupuesto(p),p).length>15} key={p.presupuesto_id}><header><span className="collections-budget-icon"><IconoOficial nombre="file-text"/></span><div><button type="button" className="collections-budget-link" aria-label={`Ver presupuesto ${p.numero_presupuesto}`} onClick={()=>abrirDetallePresupuesto(p)}>{p.numero_presupuesto}</button><span>{p.cliente||'Sin cliente'}</span></div><span className={`finance-status ${p.estado?.toLowerCase()}`} data-financial-status={estadoPagoVisible(p)}>{estadoPagoVisible(p)}</span></header><dl className="collections-refund-values"><div><dt>Disponible para devolver</dt><dd>{importe(cobradoPresupuesto(p),p)}</dd></div><div><dt>Ya devuelto</dt><dd>{importe(devueltas.reduce((n,r)=>n+Number(r.importe||0),0),p)}</dd></div></dl>{cobradoPresupuesto(p)>0?<button type="button" className="collections-secondary" aria-label={`Devolver dinero de ${p.numero_presupuesto}`} onClick={()=>abrirDevolucion(p)}><IconoOficial nombre="arrow-left-right"/>Devolver dinero<IconoOficial nombre="chevron-right"/></button>:<p className="collections-hint">Devolución completa. El comprobante está en Comprobantes.</p>}</article>;})}</div>{!devoluciones.length&&<p className="collections-empty">Cuando registres un pago podrás devolverlo desde este apartado.</p>}</>}

      </div>
    </section>;
  };
  const centroComprobantes=()=>{
    const financieros=listarComprobantesCobros(presupuestos);
    const trabajos=presupuestos.flatMap(p=>Object.values(p.entregas||{}).map(e=>({p,e})));
    const registros=[...financieros.map(r=>({id:`${r.tipo}-${r.p.presupuesto_id}-${r.tipo==='pago'?r.c.id:r.r.id}`,tipo:r.tipo,numero:referenciaMovimientoCobro(r),cliente:r.p.cliente,presupuesto:r.p.numero_presupuesto,fecha:r.fecha,importe:r.importe,moneda:r.p.moneda,titulo:tituloMovimientoCobro(r),detalle:medioMovimientoCobro(r),abrir:()=>abrirMovimientoCobro(r)})),...trabajos.map(({p,e})=>({id:`trabajo-${p.presupuesto_id}-${e.id}`,tipo:'trabajo',numero:e.numero,cliente:e.cliente,presupuesto:e.presupuestoNumero,fecha:e.fecha,importe:e.importePresupuesto,moneda:e.monedaPresupuesto||p.moneda,titulo:'Trabajo realizado',detalle:'Constancia de trabajo',abrir:()=>{setEntregaConfirmada(false);setEntregaGenerada(e);}}))].sort((a,b)=>b.fecha.localeCompare(a.fecha)||a.numero.localeCompare(b.numero));
    const visibles=registros.filter(r=>(filtroDocumentos==='todos'||r.tipo===filtroDocumentos)&&[r.numero,r.cliente,r.presupuesto,r.detalle].join(' ').toLocaleLowerCase('es-AR').includes(busquedaDocumentos.trim().toLocaleLowerCase('es-AR')));
    return <section className="ref-section document-center" aria-labelledby="documents-title"><header className="document-heading"><div><h1 id="documents-title">Comprobantes</h1><p>Emití y consultá las constancias de tu trabajo.</p></div><button type="button" className="finance-button-primary" onClick={()=>abrirSelectorComprobante()}><IconoOficial nombre="circle-plus"/>Generar comprobante</button></header>
      <section className="document-history" aria-labelledby="documents-history-title"><div className="document-history-heading"><h2 id="documents-history-title">Historial de comprobantes</h2><small aria-live="polite">{visibles.length} {visibles.length===1?'documento':'documentos'}</small></div><div className="document-filters"><label className="document-search"><IconoOficial nombre="search"/><input aria-label="Buscar comprobantes" placeholder="Cliente, presupuesto o número" value={busquedaDocumentos} onChange={e=>{setBusquedaDocumentos(e.target.value);setLimiteDocumentos(20);}} onKeyDown={e=>{if(e.key==='Escape'&&busquedaDocumentos){e.preventDefault();e.stopPropagation();setBusquedaDocumentos('');setLimiteDocumentos(20);}}}/><LimpiarBusqueda visible={Boolean(busquedaDocumentos)} onLimpiar={()=>{setBusquedaDocumentos('');setLimiteDocumentos(20);}} etiqueta="comprobantes"/></label><select aria-label="Tipo de comprobante" value={filtroDocumentos} onChange={e=>{setFiltroDocumentos(e.target.value);setLimiteDocumentos(20);}}><option value="todos">Todos los tipos</option><option value="pago">Pagos recibidos</option><option value="devolucion">Devoluciones</option><option value="trabajo">Trabajos realizados</option><option value="correccion">Correcciones internas</option></select></div>
      <div className="document-list">{visibles.slice(0,limiteDocumentos).map(r=><button type="button" key={r.id} className="document-row" onClick={r.abrir} aria-label={`Consultar comprobante ${r.numero}`}><span className={`document-type-icon ${r.tipo}`}><IconoOficial nombre={r.tipo==='pago'?'banknote':r.tipo==='devolucion'?'arrow-left-right':'file-text'}/></span><span className="document-row-copy"><strong>{r.titulo}</strong><span>{r.cliente} · {r.presupuesto}</span><small title={r.numero}>{r.numero}</small></span><span className="document-row-value"><b>{r.importe===undefined?'Monto no disponible':formatearMontoCompacto(r.importe,monedaPresupuesto(r.moneda))}</b><small>{fechaCortaCompacta(r.fecha)} · {r.tipo==='trabajo'?'Monto acordado':r.detalle}</small></span><IconoOficial nombre="chevron-right"/></button>)}</div>{!visibles.length&&<div className="document-empty"><IconoOficial nombre="file-text"/><strong>{registros.length?'No encontramos comprobantes':'Todavía no hay comprobantes'}</strong><p>{registros.length?'Probá otro nombre, número o tipo de documento.':'Registrá un pago o una devolución, o generá una constancia de trabajo.'}</p>{registros.length>0&&<button type="button" className="document-text-link" onClick={()=>{setBusquedaDocumentos('');setFiltroDocumentos('todos');}}>Limpiar filtros</button>}</div>}{visibles.length>limiteDocumentos&&<button type="button" className="document-load-more" onClick={()=>setLimiteDocumentos(n=>n+20)}>Ver más comprobantes</button>}</section>
    </section>;
  };

  const informeNegocioInicio = () => {
    const monedas=Array.from(new Set(['ARS',...presupuestos.map(p=>monedaPresupuesto(p.moneda))]));
    const moneda=monedas.includes(monedaInforme)?monedaInforme:'ARS';
    const clave=periodoInforme==='mes'?mesInforme:anioInforme;
    const datos=construirInformeNegocio(presupuestos,moneda,periodoInforme,clave);
    const monto=(n:number)=>ocultarMontosInicio?'••••••':importeDocumento(n,moneda).replace(/^[A-Z]{3}\s+/,'');
    const max=Math.max(0,...datos.serie.map(v=>v.importe)),min=Math.min(0,...datos.serie.map(v=>v.importe)),amplitud=max-min||1,cero=max/amplitud*100;
    const maxEstado=Math.max(1,...datos.estados.map(e=>e.cantidad));
    const anios=Array.from(new Set([fechaArgentina().slice(0,4),...presupuestos.map(p=>p.fecha?.slice(0,4)).filter(a=>/^\d{4}$/.test(a||'')),anioInforme])).sort().reverse();
    return <section className="business-analytics" aria-labelledby="business-analytics-title">
      <header className="analytics-heading"><div><h1 id="business-analytics-title">Informe del negocio</h1><p>Evolución y resultados de tu actividad.</p></div></header>
      <div className="analytics-filters"><label>Período<select aria-label="Período del informe" value={periodoInforme} onChange={e=>setPeriodoInforme(e.target.value as 'mes'|'anio')}><option value="mes">Mes</option><option value="anio">Año</option></select></label>{periodoInforme==='mes'?<label>Mes<input type="month" aria-label="Mes del informe" value={mesInforme} onChange={e=>{if(/^\d{4}-\d{2}$/.test(e.target.value))setMesInforme(e.target.value);}}/></label>:<label>Año<select aria-label="Año del informe" value={anioInforme} onChange={e=>setAnioInforme(e.target.value)}>{anios.map(a=><option key={a} value={a}>{a}</option>)}</select></label>}<label>Moneda<select aria-label="Moneda del informe" value={moneda} onChange={e=>setMonedaInforme(e.target.value)}>{monedas.map(m=><option key={m} value={m}>{m}</option>)}</select></label></div>
      <div className="analytics-metrics"><article><span>Ingresos netos</span><ImporteAdaptable>{monto(datos.ingresos)}</ImporteAdaptable><small>{ocultarMontosInicio?'Importes ocultos':datos.variacion===null?'Sin base de comparación anterior':`${datos.variacion>0?'+':''}${datos.variacion.toLocaleString('es-AR',{maximumFractionDigits:1})}% vs. ${periodoInforme==='mes'?'mes':'año'} anterior`}</small></article><article><span>Aceptación</span><strong>{datos.aceptacion===null?'—':datos.aceptacion.toLocaleString('es-AR',{maximumFractionDigits:0})+'%'}</strong><small>{datos.contratados} aceptados o pagados</small></article><article><span>Presupuestos emitidos</span><strong>{datos.emitidos}</strong><small>En el período seleccionado</small></article><article><span>Clientes con trabajos</span><strong>{datos.clientes}</strong><small>Con presupuestos aceptados o pagados</small></article></div>
      <div className="analytics-grid"><section className="analytics-card analytics-evolution"><div className="analytics-card-heading"><h2><IconoOficial nombre="chart-no-axes-combined"/>Evolución de ingresos</h2><small>{moneda} · {periodoInforme==='mes'?'Por semana':'Por mes'}</small></div><p className="analytics-description">Pagos recibidos menos devoluciones, según la fecha de cada movimiento.</p>{ocultarMontosInicio?<div className="analytics-empty">Mostrá los importes desde el inicio para consultar la evolución.</div>:datos.serie.some(v=>v.importe!==0)?<div className="analytics-chart" role="img" aria-label={`Evolución de ingresos netos en ${clave}, ${moneda}`}><div className="analytics-axis"><span>{etiquetaEjeImporte(max)}</span><span>{etiquetaEjeImporte((max+min)/2)}</span><span>{etiquetaEjeImporte(min)}</span></div><div className="analytics-plot"><div className="analytics-zero" style={{top:`calc(${cero}% - ${cero/100*25}px)`}}/>{datos.serie.map(v=><div key={v.etiqueta} className="analytics-chart-column"><div className="analytics-chart-track" title={`${v.etiqueta}: ${monto(v.importe)}`}>{v.importe!==0&&<span className={v.importe<0?'negative':''} style={{top:`${v.importe>=0?(max-v.importe)/amplitud*100:cero}%`,height:`${Math.abs(v.importe)/amplitud*100}%`}}/>}</div><small>{v.etiqueta}</small></div>)}</div></div>:<div className="analytics-empty"><IconoOficial nombre="chart-no-axes-combined"/><p>No hay ingresos ni devoluciones en este período.</p></div>}</section>
        <section className="analytics-card"><div className="analytics-card-heading"><h2><IconoOficial nombre="file-text"/>Resultado de presupuestos</h2></div><p className="analytics-description">Estado actual de los presupuestos emitidos en el período.</p>{datos.emitidos?<div className="analytics-status-list">{datos.estados.map(e=><div className="analytics-status-row" key={e.estado}><span>{e.estado==='Emitido'?'Emitidos':e.estado==='Aceptado'?'Aceptados':e.estado==='Pagado'?'Pagados':e.estado==='Rechazado'?'Rechazados':e.estado==='Vencido'?'Vencidos':e.estado}</span><div><i className={e.estado.toLowerCase()} style={{width:`${e.cantidad/maxEstado*100}%`}}/></div><b>{e.cantidad}</b></div>)}</div>:<div className="analytics-empty">No hay presupuestos emitidos en este período.</div>}</section>
        <section className="analytics-card analytics-services"><div className="analytics-card-heading"><h2><IconoOficial nombre="wrench"/>Servicios más contratados</h2><small>Hasta 5 conceptos</small></div>{datos.servicios.length?<ol>{datos.servicios.map((v,i)=><li key={v.descripcion}><span className="analytics-rank">{String(i+1).padStart(2,'0')}</span><strong>{v.descripcion}</strong><div className="analytics-service-bar"><i style={{width:`${v.cantidad/datos.servicios[0].cantidad*100}%`}}/></div><span>{v.cantidad} {v.cantidad===1?'presupuesto':'presupuestos'}</span></li>)}</ol>:<div className="analytics-empty">Aparecerán cuando tengas presupuestos aceptados o pagados con productos o servicios.</div>}<p className="analytics-description">Cada descripción se cuenta una vez por presupuesto aceptado o pagado. No representa una factura de venta.</p></section>
      </div><details className="analytics-method"><summary>Cómo se calcula este informe</summary><p>Los ingresos se agrupan por fecha del pago y las devoluciones por la fecha en que devolviste el dinero. Las correcciones de cobros no cuentan como ingresos. Las monedas se analizan por separado, sin conversión. La aceptación se calcula con el estado actual de los presupuestos emitidos en el período, excluyendo borradores y cancelados.</p></details>
    </section>;
  };
  const herramientasPremium = () => (
    <section className="premium-hub" aria-labelledby="premium-hub-title">
      
      <div className="premium-hub-heading"><div><h2 id="premium-hub-title">Herramientas Premium</h2><p>{perfilForm.es_premium === true ? 'Tus herramientas para personalizar y agilizar el trabajo.' : 'Conocé las herramientas incluidas y elegí el plan que necesitás.'}</p></div>{perfilForm.es_premium !== true && <button type="button" onClick={activarPremium}>Elegir un plan<IconoHerramientaPremium nombre="flecha" /></button>}</div>
      {perfilForm.es_premium === true && <details className="compact-membership"><summary><IconoOficial nombre="crown" />Membresía activa<IconoOficial nombre="chevron-down" /></summary><SubscriptionMembership/></details>}
      <div className="premium-hub-grid">{[
        {titulo:'Numeración y series',detalle:'Configurá el prefijo, la serie y el próximo número.',icono:'series' as const,ejemplo:2,boton:'Configurar numeración',accion:()=>setConfigComercialActiva('series')},
        {titulo:'Presupuestos en un PDF',detalle:'Reuní presupuestos del mismo cliente, conservando cada documento.',icono:'unir' as const,ejemplo:3,boton:'Elegir cliente',accion:()=>setSeleccionarClientePremium(!seleccionarClientePremium)},
        {titulo:'Mis productos y servicios',detalle:'Reutilizá descripción, unidad, precio e IVA en tus presupuestos.',icono:'catalogo' as const,ejemplo:4,boton:'Abrir catálogo',accion:()=>abrirCatalogo('gestion')},
        {titulo:'Firma del profesional',detalle:'Guardá tu firma o tu nombre para los comprobantes de trabajo.',icono:'exportar' as const,ejemplo:-1,boton:'Configurar firma',accion:()=>setMostrarFirmaPremium(true)},
        {titulo:'Informe del negocio',detalle:'Analizá ingresos y resultados de tus presupuestos.',icono:'informe' as const,ejemplo:-1,boton:'Ver informe',accion:()=>{abrirMenuPrincipal('informes');}},
        {titulo:'Exportación de datos',detalle:'Exportá clientes y presupuestos a CSV para trabajar con Excel, por fecha y moneda.',icono:'exportar' as const,ejemplo:5,boton:'Exportar datos',accion:()=>setMostrarExportacion(true)},
      ].map(h=><article className="premium-hub-card" key={h.titulo}><span className="premium-hub-icon"><IconoHerramientaPremium nombre={h.icono} /></span><h3>{h.titulo}</h3><p>{h.detalle}</p><div className="premium-hub-actions">{perfilForm.es_premium === true ? <button type="button" onClick={h.accion}>{h.boton}<IconoHerramientaPremium nombre="flecha" /></button> : <button type="button" className="premium-hub-example" onClick={()=>h.ejemplo===-1?activarPremium():setEjemploPremium(h.ejemplo)}><IconoHerramientaPremium nombre="ver" />{h.ejemplo===-1?'Conocer Premium':'Ver ejemplo'}<IconoHerramientaPremium nombre="flecha" /></button>}</div>{h.ejemplo===3 && seleccionarClientePremium && perfilForm.es_premium === true && <div className="premium-hub-client"><label htmlFor="premium-hub-client">Cliente</label><select id="premium-hub-client" value={clienteHerramientaPremium} onChange={e=>setClienteHerramientaPremium(e.target.value)}><option value="">Seleccioná un cliente</option>{clientes.map(c=><option key={c.cliente_id} value={String(c.cliente_id)}>{c.nombre_razon_social}</option>)}</select><button type="button" disabled={!clienteHerramientaPremium} onClick={()=>{const c=clientes.find(c=>String(c.cliente_id)===clienteHerramientaPremium);if(c)generarPdfConsolidadoCliente(c);}}>Seleccionar presupuestos</button>{!clientes.length && <small>Primero registrá un cliente en Clientes.</small>}</div>}</article>)}</div>
      {compartirMovilDisponible && <article className="whatsapp-premium-entry"><span className="whatsapp-premium-label">Premium · Solo en móviles</span><h3>Compartir por WhatsApp</h3><p>Compartí el PDF y copiá el mensaje para pegarlo en WhatsApp.</p><button type="button" onClick={() => abrirCompartirWhatsapp()}><IconoOficial nombre="share-2" className="premium-tool-svg" />{perfilForm.es_premium === true ? 'Seleccionar presupuesto' : 'Ver cómo funciona'}</button></article>}
    </section>
  );

  // Vista previa y PDF consumen el mismo contenido y cálculo.
  const contenidoDocumento = (p: Presupuesto) => {
    const items = (p.items || []).filter(i => i.descripcion.trim() || i.cantidad || i.precio_unitario);
    const { subtotal, bonificaciones, iva, descuento, total } = calcularTotalesPresupuesto(items, Number(p.descuento || 0));
    const condiciones = p.incluir_condiciones === false ? [] : [
      p.tiempo_ejecucion && `Plazo de ejecución: ${formatearDuracionPresupuesto(p.tiempo_ejecucion)}`,
      p.validez_dias > 0 && `Validez: ${p.validez_dias} días corridos`,
      p.forma_pago && `Condición de pago: ${p.forma_pago}`,
      p.garantia && `Garantía ofrecida: ${formatearDuracionPresupuesto(p.garantia)}`
    ].filter(Boolean).map(String);
    if ((p.incluir_condiciones_adicionales === true || (p.incluir_condiciones !== false && p.incluir_condiciones_adicionales !== false)) && p.condiciones_adicionales?.trim()) {
      condiciones.push(`Condiciones adicionales: ${p.condiciones_adicionales.trim()}`);
    }
    const aliasCuenta = /^\d{22}$/.test((perfilForm.cbu_alias || '').trim()) ? '' : (perfilForm.cbu_alias || '').trim();
    const cbuCuenta = (perfilForm.cbu_cvu || (/^\d{22}$/.test((perfilForm.cbu_alias || '').trim()) ? perfilForm.cbu_alias : '') || '').trim();
    const pagos = p.incluir_pago === false ? [] : [
      perfilForm.acepta_efectivo && 'Efectivo', perfilForm.acepta_cheque && 'Cheque',
      perfilForm.acepta_transferencia && 'Transferencia bancaria',

/* Reference design: white compact surfaces and violet gradient headers. */
#mioficio-dashboard.reference-ui .budget-generator .budget-v2-shell{background:white!important;border-radius:12px!important;width:min(560px,calc(100vw - 32px))!important;max-height:calc(100dvh - 40px)!important;height:auto!important}
#mioficio-dashboard.reference-ui .budget-generator.client-v2 .budget-v2-shell{width:min(560px,calc(100vw - 32px))!important}
#mioficio-dashboard.reference-ui .budget-generator .budget-v2-header{min-height:60px!important;padding:12px 18px!important;background:linear-gradient(115deg,#4b31ed,#7866ff)!important}
#mioficio-dashboard.reference-ui :is(.budget-mobile-heading,.final-client-heading){display:flex!important;gap:12px;align-items:center}
#mioficio-dashboard.reference-ui :is(.budget-mobile-heading,.final-client-heading)>svg{width:23px!important;height:23px!important;min-width:23px!important;color:white!important}

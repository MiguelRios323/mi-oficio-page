  const cobradoPorMoneda=presupuestos.reduce<Record<string,number>>((suma,p)=>{const moneda=monedaPresupuesto(p.moneda);suma[moneda]=(suma[moneda]||0)+cobradoPresupuesto(p);return suma;},{});
  const monedaPreferida=monedaInicialPerfil(perfilForm);
  const monedaCobrado=monedaPreferida;

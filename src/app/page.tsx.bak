#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .budget-mobile-extra>summary:focus-visible{outline:2px solid #6046f5!important;outline-offset:2px!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .budget-generator .client-v2-footer{display:grid!important;grid-template-columns:1fr 1fr!important;gap:8px!important;flex-wrap:nowrap!important}
#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .budget-generator .client-v2-footer button{white-space:nowrap!important;font-size:12px!important;min-height:40px!important}
}


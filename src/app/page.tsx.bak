d#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .analytics-metrics>article:not(:first-child)>span{font-size:12px!important;}#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .analytics-axis{flex-basis:64px!important;width:64px!important;min-width:64px!important;font-size:10.5px!important;}#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard .analytics-metrics .importe-adaptable{--importe-max-font:32;}}`}</style>
      {presupuestoCreado&&<dialog ref={confirmacionPresupuestoRef} className="budget-created-dialog operation-success" aria-labelledby="budget-created-title" onCancel={()=>setPresupuestoCreado(null)}>
        
        <header className="budget-created-header"><span className="operation-success-brand">MiOficio</span><button autoFocus type="button" aria-label="Cerrar confirmación" onClick={()=>setPresupuestoCreado(null)}><IconoOficial nombre="x"/></button></header>
        <div className="budget-created-content">
          <section className="budget-created-summary"><div className="budget-created-check" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><path d="m10 24 9 9L38 14" stroke="currentColor" strokeWidth="7" strokeLinecap="round" strokeLinejoin="round"/></svg></div><h2 id="budget-created-title">Presupuesto creado correctamente</h2><p>Ya está guardado en tus presupuestos.</p><div className="budget-created-details"><div><IconoOficial nombre="file-text"/><span>{presupuestoCreado.numero_presupuesto}</span></div><div><IconoOficial nombre="user-round"/><span>{presupuestoCreado.cliente}</span></div><div className="created-amount"><IconoOficial nombre="banknote"/><span>{importeDocumento(contenidoDocumento(presupuestoCreado).total,presupuestoCreado.moneda)}</span></div></div></section>
          <section className="budget-created-options"><h3>¿Qué querés hacer ahora?</h3>
            {pdfCreado?<a className="budget-created-action" href={pdfCreado.url} target="_blank" rel="noopener noreferrer"><IconoOficial nombre="file-text"/><span><b>Abrir presupuesto</b><small>Ver el PDF en el navegador</small></span><IconoOficial nombre="chevron-right"/></a>:<button className="budget-created-action" disabled><IconoOficial nombre="file-text"/><span><b>Abrir presupuesto</b><small>Ver el PDF en el navegador</small></span><IconoOficial nombre="chevron-right"/></button>}
            <button type="button" className="budget-created-action" disabled={!pdfCreado} onClick={descargarPdfCreado}><IconoOficial nombre="download"/><span><b>Descargar PDF</b><small>Guardar en el {generadorEnPC?'equipo':'teléfono'}</small></span><IconoOficial nombre="chevron-right"/></button>
            <button type="button" className="budget-created-action" disabled={!pdfCreado||compartiendoCreado} onClick={()=>void compartirPdfCreado()}><svg className="created-whatsapp" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.6 11.9a8.6 8.6 0 0 1-12.8 7.5L3 21l1.6-4.8A8.6 8.6 0 1 1 20.6 12Z" stroke="currentColor" strokeWidth="1.7" strokeLinejoin="round"/><path d="M8.3 7.3c-.8.4-.8 1.3-.5 2.4.7 2.6 3 4.8 5.7 5.6 1 .3 2 .2 2.5-.6l.5-1-2.5-1.2-.9 1c-1.5-.6-2.7-1.8-3.3-3.2l1-.8-1.3-2.6-1.2.4Z" fill="currentColor"/></svg><span><b>{compartiendoCreado?'Compartiendo…':'Enviar por WhatsApp'}</b><small>Elegí WhatsApp al compartir el PDF</small></span><IconoOficial nombre="chevron-right"/></button>
            {!pdfCreado&&!errorPdfCreado&&<p className="budget-created-status" role="status">Preparando tu PDF…</p>}{errorPdfCreado&&<><p className="budget-created-status" role="alert">{errorPdfCreado}</p><button type="button" className="budget-created-retry" onClick={()=>setReintentoPdfCreado(n=>n+1)}>Volver a preparar el PDF</button></>}{avisoCompartirCreado&&<p className="budget-created-status" role="status">{avisoCompartirCreado}</p>}
          </section>

        </div>
        <footer className="budget-created-footer"><button type="button" className="budget-created-home" onClick={()=>{setPresupuestoCreado(null);setActiveTab('dashboard');}}>Volver al inicio</button></footer>
      </dialog>}

      {showModalPresupuesto && (
        <div className="budget-generator budget-v2 mi-oficio-ui" data-generator="professional" data-flow="simple" data-distribution="open" data-stage={pasoPresupuesto} role="dialog" aria-modal="true" aria-label={presupuestoEnEdicion ? 'Editar presupuesto' : 'Nuevo presupuesto'}>
          <style>{`
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui{padding:16px!important;box-sizing:border-box;background:#0f172a80!important;backdrop-filter:blur(4px)}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-shell{box-sizing:border-box;width:100%!important;max-width:760px!important;height:auto!important;max-height:calc(100dvh - 32px)!important;display:flex;flex-direction:column;overflow:hidden;border-radius:16px!important;box-shadow:0 24px 80px #0f172a30}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-header{display:flex!important;align-items:center!important;height:auto!important;min-height:76px!important;padding:16px 20px!important;gap:12px;border-bottom:1px solid #e2e8f0;background:white;flex-shrink:0}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-mobile-heading h2{font-size:21px!important;line-height:1.3!important;font-weight:700;margin:0!important;color:#0f172a}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-mobile-heading p{font-size:12px!important;margin:4px 0 0!important;line-height:1.4!important;color:#64748b}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-close{width:32px!important;height:32px!important;min-height:32px!important;padding:0!important;border:1px solid #e2e8f0!important;border-radius:8px!important;background:#fff!important;display:grid;place-items:center;margin-left:auto}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-close svg{width:18px!important;height:18px!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-desktop-progress{padding:14px 22px!important;margin:0!important;background:white;gap:10px!important;border-bottom:1px solid #e2e8f0;flex-shrink:0}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-desktop-progress li{font-size:11px!important;line-height:1.4!important;gap:6px!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-desktop-progress-number{width:26px!important;height:26px!important;min-width:26px!important;font-size:12px!important;box-shadow:none!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-form{display:flex;flex-direction:column;min-height:0;overflow:hidden}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-scroll{min-height:0;overflow-y:auto;overflow-x:hidden;padding:20px 22px!important;background:#f8fafc}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-card{margin:0!important;padding:0!important;background:transparent!important;box-shadow:none!important;border-radius:0!important;min-height:0!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-card>h2,.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-card>.budget-v2-subtitle{display:none!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-section{background:white!important;padding:16px!important;border:1px solid #e2e8f0!important;border-radius:10px!important;box-sizing:border-box}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-section h3{font-size:14px!important;color:#334155!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-number-date strong{font-size:15px!important;color:#0f172a}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .label{font-size:12px!important;color:#64748b!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .field{font-size:13px!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-scroll-notice{font-size:11px!important;line-height:1.5!important;padding:9px 22px!important;border-top:1px solid #e2e8f0;background:#f8fafc!important;color:#64748b!important;flex-shrink:0}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-scroll-notice svg{width:16px!important;height:16px!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-clean-footer{display:flex!important;justify-content:space-between;align-items:center;padding:13px 22px!important;gap:12px;background:white!important;border-top:1px solid #e2e8f0;flex-shrink:0}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-clean-secondary,.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-clean-navigation{display:flex;align-items:center;gap:8px}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-clean-footer button{display:inline-flex!important;align-items:center;justify-content:center;gap:5px;min-height:38px!important;height:auto!important;padding:9px 12px!important;font-size:12px!important;line-height:1.4!important;border-radius:8px!important;background:white!important;color:#475569!important;border:1px solid #e2e8f0!important;white-space:normal!important;box-shadow:none!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-clean-secondary button:first-child{border-color:transparent!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-clean-footer .budget-clean-next{background:#1d4ed8!important;color:white!important;border-color:#1d4ed8!important;font-weight:600}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-clean-footer button:disabled{opacity:.4;cursor:not-allowed}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-clean-footer svg{width:16px!important;height:16px!important}
@media(max-width:639px){.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui{padding:8px!important}.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-shell{max-height:calc(100dvh - 16px)!important;border-radius:12px!important}.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-header{padding:14px 16px!important}.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-scroll{padding:14px!important}.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-clean-footer{padding:12px 14px!important;flex-wrap:wrap}.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-clean-navigation{margin-left:auto}.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-clean-secondary button{padding:8px!important;font-size:11px!important}.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-scroll-notice{padding:8px 14px!important}}

.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-desktop-progress{display:grid!important;grid-template-columns:repeat(6,minmax(0,1fr))!important;padding:12px 18px!important;gap:6px!important;list-style:none}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-desktop-progress li{display:flex!important;flex-direction:row!important;align-items:center!important;justify-content:flex-start!important;font-size:10px!important;text-align:left!important;gap:6px!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-desktop-progress-number{flex-shrink:0;width:22px!important;height:22px!important;min-width:22px!important;font-size:10px!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-card[data-desktop-stage="1"]{display:block!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-scroll{padding:18px 20px!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-number-date{gap:24px!important;justify-content:flex-start!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-card[data-desktop-stage="1"] .budget-v2-grid{grid-template-columns:minmax(0,1fr) 120px!important;gap:18px!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-card[data-desktop-stage="1"] .budget-v2-section{padding:14px!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-scroll-notice{display:flex!important;align-items:center!important;gap:8px!important}
@media(max-width:639px){.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-shell{width:100%!important}.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-header{height:auto!important;min-height:72px!important}.mi-oficio-ui.mioficio-model.compact-dashboard .budget-generator.budget-v2.mi-oficio-ui .budget-v2-scroll{padding:14px!important}}
`}</style>
          <div className="budget-v2-shell">
            {(() => {
              const numeroFormulario = presupuestoEnEdicion?.numero_presupuesto || numeroPresupuestoActual;
              const fechaFormulario = presupuestoEnEdicion?.fecha || fechaArgentina();
              const clienteRegistradoFormulario = clientes.some(c => c.nombre_razon_social === nuevoPresupuesto.cliente);
              const cerrarFormulario = () => { if (emitiendo) return; setShowModalPresupuesto(false); setPresupuestoEnEdicion(null); };
              const updateItem = (index: number, patch: Partial<ItemPresupuesto>) => {
                setNuevoPresupuesto(prev => ({ ...prev, items: prev.items.map((item, i) => i === index ? { ...item, ...patch } : item) }));
              };
              const guardarBorrador = () => void handleCrearPresupuesto(true);
              return (
                <>
                  <header className="budget-v2-header budget-v2-header-unbranded">
                    <div className="budget-mobile-heading"><IconoOficial nombre="file-text" /><div><h2>{presupuestoEnEdicion ? 'Editar presupuesto' : 'Nuevo presupuesto'}</h2><p>{numeroFormulario} · {fechaFormulario.split('-').reverse().join('/')}</p></div></div>
                    <button type="button" className="budget-v2-close" aria-label="Cerrar generador" onClick={cerrarFormulario} disabled={emitiendo}><IconoCerrar /></button>
                  </header>

                  <form className="budget-v2-form" onSubmit={e => e.preventDefault()} onKeyDown={e => { if (e.key === 'Enter' && e.target instanceof HTMLInputElement) e.preventDefault(); }}>
                    <main className="budget-v2-scroll" ref={presupuestoScrollRef}>
                      <div className="b94-main">
                        <section className="b94-client"><div className="b94-title"><h3>Cliente</h3><button type="button" className="b94-link" onClick={abrirNuevoCliente}><IconoOficial nombre="circle-plus"/>Nuevo cliente</button></div><div className="b94-client-picker"><select id="b94-client" aria-label="Cliente" className="field model-input" value={String(clientes.find(c=>c.nombre_razon_social===nuevoPresupuesto.cliente&&(c.cuit_cuil||'')===nuevoPresupuesto.cuit)?.cliente_id??'')} onChange={e=>{const c=clientes.find(c=>String(c.cliente_id)===e.target.value);setNuevoPresupuesto(prev=>({...prev,cliente:c?.nombre_razon_social||'',cuit:c?.cuit_cuil||'',email:c?.email||'',telefono:c?.telefono||'',direccion_obra:c?.direccion||'',condicion_iva_cliente:c?.condicion_tributaria||''}));}}><option value="">{clientes.length?'Seleccioná un cliente':'Primero registrá un cliente'}</option>{clientes.map(c=><option key={c.cliente_id} value={String(c.cliente_id)}>{c.nombre_razon_social}{c.cuit_cuil?' · '+c.cuit_cuil:''}</option>)}</select></div>
                          <div className="b95-client-summary">{[nuevoPresupuesto.cuit,nuevoPresupuesto.telefono,nuevoPresupuesto.email].filter(Boolean).length>0?<><p>{[nuevoPresupuesto.cuit,nuevoPresupuesto.telefono].filter(Boolean).join(' · ')}</p><p>{nuevoPresupuesto.email}</p></>:<p>Los datos se completan al elegir un cliente.</p>}</div>                      <div className="b94-settings"><section><h4>Presupuesto</h4><div className="b94-three"><label>Moneda<select id="presupuesto-moneda" className="field model-input" value={nuevoPresupuesto.moneda} onChange={e=>{const moneda=e.target.value;if(moneda!==nuevoPresupuesto.moneda&&nuevoPresupuesto.items.some(i=>i.precio_unitario>0)&&!window.confirm('Cambiar la moneda no convierte los precios. Revisá los importes antes de generar. ¿Continuar?'))return;setNuevoPresupuesto({...nuevoPresupuesto,moneda});}}>{Array.from(new Set(['ARS','USD',nuevoPresupuesto.moneda])).map(v=><option key={v}>{v}</option>)}</select></label><label>Validez (días)<input aria-label="Validez en días" className="field model-input" type="number" min="1" value={nuevoPresupuesto.validez_dias||''} onChange={e=>setNuevoPresupuesto({...nuevoPresupuesto,validez_dias:Number(e.target.value)||0})}/></label><label>Desc. general<input aria-label="Descuento general" className="field model-input" type="number" min="0" step="0.01" value={nuevoPresupuesto.descuento||''} onChange={e=>setNuevoPresupuesto({...nuevoPresupuesto,descuento:Number(e.target.value)||0})}/></label></div></section><section className="b94-conditions"><div className="b94-title"><h4>Condiciones</h4><label className="b94-check"><input type="checkbox" checked={incluirCondiciones} onChange={e=>setIncluirCondiciones(e.target.checked)}/>Incluir en PDF</label></div><div className="b94-three"><label>Pago<select aria-label="Condición de pago" className="field model-input" value={nuevoPresupuesto.forma_pago||perfilForm.condicion_pago_default||'A convenir'} onChange={e=>setNuevoPresupuesto({...nuevoPresupuesto,forma_pago:e.target.value})}>{Array.from(new Set([perfilForm.condicion_pago_default||'A convenir',nuevoPresupuesto.forma_pago,...CONDICIONES_PAGO].filter(Boolean))).map(v=><option key={v}>{v}</option>)}</select></label><label>Plazo<input aria-label="Plazo del trabajo" className="field model-input" maxLength={60} value={nuevoPresupuesto.tiempo_ejecucion} onChange={e=>setNuevoPresupuesto({...nuevoPresupuesto,tiempo_ejecucion:e.target.value})}/></label><label>Garantía<input aria-label="Garantía" className="field model-input" maxLength={60} value={nuevoPresupuesto.garantia} onChange={e=>setNuevoPresupuesto({...nuevoPresupuesto,garantia:e.target.value})}/></label></div></section></div>
                      <div className="b94-payment"><label className="b94-check"><input type="checkbox" checked={incluirPago} onChange={e=>setIncluirPago(e.target.checked)}/>Medios de pago en PDF</label><span>{([{campo:'acepta_efectivo',nombre:'Efectivo'},{campo:'acepta_cheque',nombre:'Cheque'},{campo:'acepta_transferencia',nombre:'Transferencia'}] as const).filter(m=>perfilForm[m.campo]).map(m=>m.nombre).join(' · ')||'Sin configurar'}</span>{incluirPago&&perfilForm.acepta_transferencia&&<small>{[perfilForm.banco_pasarela,perfilForm.cbu_alias,perfilForm.cbu_cvu].filter(Boolean).join(' · ')}</small>}</div>

                        </section>
                        <section className="b94-work"><div className="b94-title"><h3>Trabajo o producto</h3><button type="button" className="b94-link" onClick={()=>abrirCatalogo('presupuesto')}><IconoOficial nombre="package-search"/>Catálogo{!perfilForm.es_premium&&' · Premium'}</button></div>
                          <div className="b94-items">{nuevoPresupuesto.items.map((item,index)=><div className="b94-item" key={index}><div className="b94-description"><label htmlFor={`budget-item-description-${index}`}>Descripción{nuevoPresupuesto.items.length>1?` ${index+1}`:''}</label>{nuevoPresupuesto.items.length>1&&<button type="button" className="b94-link" aria-label={`Eliminar ítem ${index+1}`} onClick={()=>setNuevoPresupuesto(prev=>({...prev,items:prev.items.filter((_,i)=>i!==index)}))}><IconoOficial nombre="trash-2"/></button>}</div><textarea id={`budget-item-description-${index}`} aria-label={`Descripción del ítem ${index+1}`} className="field model-input" rows={2} maxLength={160} placeholder={`Ej.: ${plantillaRubro.producto}`} value={item.descripcion} onChange={e=>updateItem(index,{descripcion:e.target.value})}/><div className="b94-item-fields"><label>Cant.<input type="number" min="0" step="0.01" aria-label={`Cantidad del ítem ${index+1}`} className="field model-input" value={item.cantidad||''} onChange={e=>updateItem(index,{cantidad:Number(e.target.value)||0})}/></label><label>Unidad<select aria-label={`Unidad del ítem ${index+1}`} className="field model-input" value={item.unidad||'un.'} onChange={e=>updateItem(index,{unidad:e.target.value})}>{Array.from(new Set([item.unidad||'un.',...UNIDADES_PRESUPUESTO])).map(v=><option key={v} value={v}>{abreviarUnidadPresupuesto(v)}</option>)}</select></label><label>Precio sin IVA<input type="number" min="0" step="0.01" aria-label={`Precio unitario del ítem ${index+1}`} className="field model-input" value={item.precio_unitario||''} onChange={e=>updateItem(index,{precio_unitario:Number(e.target.value)||0})}/></label><label>IVA<select aria-label={`IVA del ítem ${index+1}`} className="field model-input" value={String(item.iva??21)} onChange={e=>updateItem(index,{iva:Number(e.target.value)})}>{[0,10.5,21,27].map(v=><option key={v} value={v}>{String(v).replace('.',',')} %</option>)}</select></label><label>Desc. %<input type="number" min="0" max="100" step="0.01" aria-label={`Bonificación del ítem ${index+1}`} className="field model-input" value={item.bonificacion||''} onChange={e=>updateItem(index,{bonificacion:Number(e.target.value)||0})}/></label><label>Importe<output>{importeDocumento(calcularItemPresupuesto(item).total,nuevoPresupuesto.moneda)}</output></label></div></div>)}</div><button type="button" className="b94-link b94-add" onClick={agregarItem}><IconoOficial nombre="circle-plus"/>Agregar trabajo o producto</button>
                          <div className="b94-work-data"><div className="b94-title"><h4>Datos del trabajo</h4><label className="b94-check"><input type="checkbox" checked={incluirEspecificaciones} onChange={e=>setIncluirEspecificaciones(e.target.checked)}/>Incluir en PDF</label></div><div className="b94-tech"><label>{paramLabel1.replace(/:$/,'')}<input aria-label="Referencia del trabajo" className="field model-input" maxLength={LIMITES_ESPECIFICACIONES[0]} value={paramLinea1} onChange={e=>setParamLinea1(limitarEspecificacion(e.target.value,0))}/></label>{esRubroNautico&&<label>{paramLabel2.replace(/:$/,'')}<input className="field model-input" maxLength={LIMITES_ESPECIFICACIONES[1]} value={paramLinea2} onChange={e=>setParamLinea2(limitarEspecificacion(e.target.value,1))}/></label>}{mostrarTercerDatoTrabajo&&<label>{paramLabel3.replace(/:$/,'')}<input className="field model-input" maxLength={LIMITES_ESPECIFICACIONES[2]} value={paramLinea3} onChange={e=>setParamLinea3(limitarEspecificacion(e.target.value,2))}/></label>}</div></div>
                                              <div className="b94-comments"><label>Condiciones adicionales<textarea aria-label="Condiciones adicionales" className="field model-input" rows={1} maxLength={300} value={nuevoPresupuesto.condiciones_adicionales} onChange={e=>setNuevoPresupuesto({...nuevoPresupuesto,condiciones_adicionales:e.target.value,incluir_condiciones_adicionales:true})}/></label><label>Observaciones<textarea aria-label="Observaciones" className="field model-input" rows={1} maxLength={300} value={nuevoPresupuesto.observaciones_extra} onChange={e=>{setIncluirNota(true);setNuevoPresupuesto({...nuevoPresupuesto,observaciones_extra:e.target.value});}}/></label></div>
</section>
                      </div>
                    </main>
                    <footer className="budget-v2-footer budget-clean-footer"><div className="budget-clean-secondary"><button type="button" disabled={emitiendo} onClick={guardarBorrador}>{emitiendo?'Guardando…':'Guardar borrador'}</button></div>
                      <div className="budget-generator-final-total"><span>Total <small>{Number(totalesModal.iva)>0?'IVA incluido':'Sin IVA'}</small></span><strong>{importeDocumento(totalModalFinal,nuevoPresupuesto.moneda)}</strong></div>
                      <div className="budget-clean-navigation"><button type="button" className="budget-clean-next" disabled={emitiendo} onClick={()=>void handleCrearPresupuesto()}>{emitiendo?'Guardando…':presupuestoEnEdicion&&presupuestoEnEdicion.estado!=='Borrador'?'Guardar cambios':'Generar presupuesto'}</button></div>
                    </footer>
                  </form>
                </>
              );
            })()}
          </div>
        </div>
      )}{mostrarFirmaPremium&&perfilForm.es_premium===true&&<ConfiguracionFirmaPremium perfil={perfilForm} onCerrar={()=>setMostrarFirmaPremium(false)} onGuardar={guardarFirmaPerfil} onVerificar={verificarPremiumFirma}/>}      {/* CONFIGURACIÓN COMERCIAL */}
      {configComercialActiva==='condiciones' && perfilForm.es_premium===true && <div className="premium-defaults-overlay" onClick={e=>{if(e.target===e.currentTarget&&!guardandoNegocio)setConfigComercialActiva(null);}}><section className="premium-defaults" role="dialog" aria-modal="true" aria-labelledby="premium-defaults-title" onKeyDown={e=>{if(e.key==='Escape'&&!guardandoNegocio)setConfigComercialActiva(null);}}><header><div><h2 id="premium-defaults-title">Condiciones habituales</h2><p>Valores iniciales para tus próximos presupuestos.</p></div><button type="button" aria-label="Cerrar condiciones habituales" disabled={guardandoNegocio} onClick={()=>setConfigComercialActiva(null)}><IconoOficial nombre="x"/></button></header><form onSubmit={guardarPerfilManual} aria-busy={guardandoNegocio}><section className="business-surface"><div className="business-fields">
              <label className="business-full" htmlFor="perfil-moneda">Moneda de trabajo<select id="perfil-moneda" value={monedaInicialPerfil(perfilForm)} onChange={e=>setPerfilForm({...perfilForm,moneda_default:e.target.value,moneda_elegida_explicitamente:true})}><option value="ARS">ARS · Pesos</option><option value="USD">USD · Dólares</option></select></label>

              <label htmlFor="negocio-validez">Validez (días)<input id="negocio-validez" type="number" min="1" max="365" value={perfilForm.validez_default ?? 15} onChange={e=>setPerfilForm({...perfilForm,validez_default:Math.min(365,Math.max(1,Number(e.target.value)||1))})}/></label>
              <label htmlFor="negocio-garantia">Garantía<input id="negocio-garantia" maxLength={120} value={perfilForm.garantia_default || ''} onChange={e=>setPerfilForm({...perfilForm,garantia_default:e.target.value})} placeholder="Opcional" /></label>
              <label className="business-full" htmlFor="negocio-pago">Condición de pago<input id="negocio-pago" maxLength={120} value={perfilForm.condicion_pago_default || ''} onChange={e=>setPerfilForm({...perfilForm,condicion_pago_default:e.target.value})} placeholder="Ej.: 50% de anticipo y saldo al finalizar" /></label>
              <label className="business-full" htmlFor="negocio-condiciones">Condiciones adicionales<textarea id="negocio-condiciones" rows={3} maxLength={500} value={perfilForm.condiciones_default || ''} onChange={e=>setPerfilForm({...perfilForm,condiciones_default:e.target.value})} placeholder="Condiciones que usás habitualmente" /></label>
            </div><p className="business-footnote">Podés ajustar estas condiciones en cada presupuesto.</p></section><div className="premium-defaults-actions"><button type="submit" disabled={guardandoNegocio}><IconoOficial nombre="save"/>{guardandoNegocio?'Guardando…':'Guardar condiciones'}</button></div></form></section></div>}
      {configComercialActiva === 'series' && (
        <div role="dialog" aria-modal="true" aria-label="Configurar número de presupuesto" className="model-overlay fixed inset-0 z-[90] bg-slate-950/55 backdrop-blur-sm flex items-center justify-center p-3 sm:p-5">
          <div className="w-full max-w-lg bg-white rounded-2xl shadow-2xl overflow-hidden model-card compact-premium-dialog compact-premium-series">
            <div className="p-4 space-y-4 compact-premium-body">
              {!perfilForm.es_premium ? <div className="rounded-xl border border-amber-200 bg-amber-50 px-3 py-3 text-[14px] text-amber-800">La numeración y series personalizadas son una función <strong>Premium</strong>.</div> : <><div className="grid grid-cols-2 gap-3"><div><label className="label" htmlFor="serie-prefijo">Serie / prefijo</label><input id="serie-prefijo" aria-describedby="serie-prefijo-ayuda" maxLength={12} placeholder="PRES" className="field model-input" value={seriePresupuesto} onChange={e=>setSeriePresupuesto(e.target.value.toUpperCase().replace(/\s/g,'').slice(0,12))} /><p id="serie-prefijo-ayuda" className="series-field-help">Texto inicial del número. Ejemplo: PRES.</p></div><div><label className="label" htmlFor="serie-anio">Año</label><input id="serie-anio" inputMode="numeric" maxLength={4} aria-describedby="serie-anio-ayuda" className="field model-input" value={anioSerie} onChange={e=>setAnioSerie(e.target.value.replace(/\D/g,'').slice(0,4))} /><p id="serie-anio-ayuda" className="series-field-help">Año que aparece junto al prefijo.</p></div><div><label className="label" htmlFor="serie-siguiente">Próximo número</label><input id="serie-siguiente" aria-describedby="serie-siguiente-ayuda" type="number" min="1" className="field model-input" value={proximoNumeroSerie} onChange={e=>setProximoNumeroSerie(e.target.value)} /><p id="serie-siguiente-ayuda" className="series-field-help">Número del próximo presupuesto nuevo.</p></div><div><label className="label" htmlFor="serie-digitos">Cantidad de dígitos</label><select id="serie-digitos" aria-describedby="serie-digitos-ayuda" className="field model-input" value={digitosSerie} onChange={e=>setDigitosSerie(e.target.value)}><option value="3">3 · 001</option><option value="4">4 · 0001</option><option value="5">5 · 00001</option><option value="6">6 · 000001</option></select><p id="serie-digitos-ayuda" className="series-field-help">Cantidad de cifras, incluidos los ceros iniciales.</p></div></div><div className="rounded-xl border border-blue-100 bg-blue-50 p-4 compact-premium-number"><p className="text-[14px] uppercase tracking-wider font-bold text-blue-500">Así se verá el próximo número</p><p className="mt-1 text-lg font-bold text-slate-950">{numeroPresupuestoActual}</p><p className="mt-1 text-[14px] text-slate-500">Se mostrará en el presupuesto y en su PDF. Los presupuestos ya emitidos conservan su número.</p></div></>}
            </div>
            <div className="px-4 py-3 border-t border-slate-100 flex justify-end gap-2 model-panel-footer"><button type="button" onClick={() => setConfigComercialActiva(null)} className="h-8 px-3 rounded-md border border-slate-200 text-slate-600 text-[14px] font-bold model-secondary-button">Cancelar</button><button type="button" onClick={() => { void guardarSeriesPremium(); }} className="h-8 px-4 rounded-md bg-blue-600 text-white text-[14px] font-bold hover:bg-blue-700 model-primary-button">Guardar cambios</button></div>
          </div>
        </div>
      )}

      {/* MODAL DE CONFIRMACIÓN DE ELIMINACIÓN PROFESIONAL */}
      {showModalIdentidad && (
        <div className="logo-config-overlay" onClick={() => setShowModalIdentidad(false)}>
          <section className="logo-config-dialog" role="dialog" aria-modal="true" aria-labelledby="logo-config-title" onClick={e => e.stopPropagation()} onKeyDown={e => {if(e.key==='Escape')setShowModalIdentidad(false);}}>
            <header className="logo-config-heading"><div><h3 id="logo-config-title">Logo profesional</h3><p>Tu identidad en el presupuesto.</p></div><button type="button" className="logo-config-close" aria-label="Cerrar configuración de logo" onClick={() => setShowModalIdentidad(false)}><IconoCerrar /></button></header>
            <div className="logo-config-body"><div className="logo-config-preview"><img src={perfilForm.es_premium && perfilForm.logo_url ? perfilForm.logo_url : MIOFICIO_LOGO_PERMANENTE} alt={perfilForm.es_premium && perfilForm.logo_url ? 'Vista previa de tu logo' : 'Logo oficial de MiOficio'} /></div>
              {perfilForm.es_premium === true ? <><label className="logo-config-label" htmlFor="logo-config-file">Cargar o cambiar logo</label><input id="logo-config-file" className="logo-config-file" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" onChange={handleLogoUploadAndSave} aria-describedby="logo-config-formats" /><p id="logo-config-formats" className="logo-config-formats">PNG, JPG, WEBP o SVG · Hasta 5 MB.</p><p className="logo-config-note">Tu logo aparece en el encabezado y reemplaza la marca de agua. Si no cargás uno, se mantiene MiOficio.</p>{perfilForm.logo_url && <button type="button" className="logo-config-remove" onClick={eliminarLogoGuardado}>Volver al logo de MiOficio</button>}</> : <p className="logo-config-note">Activá Premium para cargar el logo de tu negocio.</p>}
            </div>
            <footer className="logo-config-footer"><button type="button" onClick={() => setShowModalIdentidad(false)}>Listo</button></footer>
          </section>
        </div>
      )}

      {showModalCobros && (
        <div className="model-overlay fixed inset-0 z-[90] bg-slate-950/55 backdrop-blur-sm flex items-center justify-center p-3 sm:p-5">
          <div className="w-full max-w-lg bg-white rounded-2xl shadow-2xl overflow-hidden model-card">
            <div className="px-4 py-3.5 border-b border-slate-200 flex items-center justify-between model-panel-header">
              <div><h3 className="text-[16px] font-bold text-slate-950">Medios de cobro</h3><p className="mt-0.5 text-[14px] text-slate-400">Elegí cómo querés cobrar y qué datos mostrar.</p></div>
              <button type="button" onClick={() => setShowModalCobros(false)} className="w-8 h-8 rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50 model-icon-button"><IconoCerrar /></button>
            </div>
            <div className="p-4 space-y-4">
              <div><label className="label">Condición de pago predeterminada</label><select className="field model-input" value={perfilForm.condicion_pago_default || 'A convenir'} onChange={e=>setPerfilForm({...perfilForm,condicion_pago_default:e.target.value})}>{Array.from(new Set([perfilForm.condicion_pago_default || 'A convenir',...CONDICIONES_PAGO])).map(v=><option key={v} value={v}>{v}</option>)}</select></div>
              <div><label className="label">Medios aceptados</label><div className="flex flex-wrap gap-2">
                <label className={`h-9 inline-flex items-center gap-1.5 px-3 rounded-md border cursor-pointer text-[14px] font-bold ${perfilForm.acepta_efectivo ? 'border-blue-200 bg-blue-50 text-blue-700' : 'border-slate-200 bg-white text-slate-500'}`}><input type="checkbox" checked={!!perfilForm.acepta_efectivo} onChange={e => setPerfilForm({...perfilForm,acepta_efectivo:e.target.checked})} className="w-3 h-3 rounded text-blue-600" /> Efectivo</label>
                <label className={`h-9 inline-flex items-center gap-1.5 px-3 rounded-md border cursor-pointer text-[14px] font-bold ${perfilForm.acepta_transferencia ? 'border-blue-200 bg-blue-50 text-blue-700' : 'border-slate-200 bg-white text-slate-500'}`}><input type="checkbox" checked={!!perfilForm.acepta_transferencia} onChange={e => setPerfilForm({...perfilForm,acepta_transferencia:e.target.checked})} className="w-3 h-3 rounded text-blue-600" /> Transferencia</label>
                <label className={`h-9 inline-flex items-center gap-1.5 px-3 rounded-md border cursor-pointer text-[14px] font-bold ${perfilForm.acepta_cheque ? 'border-blue-200 bg-blue-50 text-blue-700' : 'border-slate-200 bg-white text-slate-500'}`}><input type="checkbox" checked={!!perfilForm.acepta_cheque} onChange={e => setPerfilForm({...perfilForm,acepta_cheque:e.target.checked})} className="w-3 h-3 rounded text-blue-600" /> Cheque</label>
              </div></div>
              {perfilForm.acepta_transferencia && <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 rounded-xl border border-blue-100 bg-blue-50/40 p-3">
                                    <div><label className="label">Banco receptor / entidad</label><input className="field model-input" value={perfilForm.banco_pasarela || ''} onChange={e=>setPerfilForm({...perfilForm,banco_pasarela:e.target.value})} placeholder="Nombre del banco o billetera" /></div>
                                    <div><label className="label">Titular de la cuenta</label><input className="field model-input" value={perfilForm.titular_cuenta || ''} onChange={e=>setPerfilForm({...perfilForm,titular_cuenta:e.target.value})} placeholder="Nombre completo o razón social registrada" /></div>
                                    <div><label className="label">Alias</label><input className="field font-bold uppercase text-blue-700 model-input" value={/^\d{22}$/.test((perfilForm.cbu_alias || '').trim()) ? '' : (perfilForm.cbu_alias || '')} onChange={e=>setPerfilForm({...perfilForm,cbu_alias:e.target.value,cbu_cvu:perfilForm.cbu_cvu || (/^\d{22}$/.test((perfilForm.cbu_alias || '').trim()) ? perfilForm.cbu_alias : '')})} placeholder="Alias de la cuenta" /></div>
                                    <div><label className="label">CBU/CVU</label><input inputMode="numeric" maxLength={22} className="field model-input" value={perfilForm.cbu_cvu || (/^\d{22}$/.test((perfilForm.cbu_alias || '').trim()) ? perfilForm.cbu_alias : '') || ''} onChange={e=>setPerfilForm({...perfilForm,cbu_cvu:e.target.value.replace(/\D/g,'')})} placeholder="22 dígitos" /></div>
                                  </div>}
            </div>
            <div className="px-4 py-3 border-t border-slate-100 flex justify-end gap-2 model-panel-footer"><button type="button" onClick={() => setShowModalCobros(false)} className="h-8 px-3 rounded-md border border-slate-200 bg-white text-slate-600 text-[14px] font-bold model-secondary-button">Cancelar</button><button type="button" onClick={guardarMediosDeCobro} className="h-8 px-4 rounded-md bg-blue-600 text-white text-[14px] font-bold hover:bg-blue-700 model-primary-button">Guardar medios</button></div>
          </div>
        </div>
      )}


      <dialog ref={dialogoExportacion} className="premium-export-dialog" aria-labelledby="export-title" onClose={() => setMostrarExportacion(false)}>
        <header><div><small>Herramienta Premium</small><h2 id="export-title">Exportación de datos</h2></div><button type="button" autoFocus aria-label="Cerrar exportación" onClick={() => setMostrarExportacion(false)}><IconoCerrar /></button></header>
        {perfilForm.es_premium === true ? <div className="premium-export-body"><p>Elegí los datos que querés abrir en Excel.</p><label>Datos a exportar<select value={tipoExportacion} onChange={e => setTipoExportacion(e.target.value as 'presupuestos' | 'clientes')}><option value="presupuestos">Presupuestos</option><option value="clientes">Clientes</option></select></label>{tipoExportacion === 'presupuestos' && <><div className="premium-export-dates"><label>Desde<input type="date" value={exportarDesde} onChange={e => setExportarDesde(e.target.value)} /></label><label>Hasta<input type="date" value={exportarHasta} onChange={e => setExportarHasta(e.target.value)} /></label></div><label>Moneda<select value={exportarMoneda} onChange={e => setExportarMoneda(e.target.value)}><option value="">Todas · Sin conversión</option>{Array.from(new Set(presupuestos.map(p => p.moneda || 'ARS'))).sort().map(moneda => <option key={moneda} value={moneda}>{moneda}</option>)}</select></label>{fechasExportacionInvalidas && <small className="premium-export-error" role="alert">La fecha Desde debe ser anterior o igual a Hasta.</small>}</>}<div className="premium-export-summary"><IconoOficial nombre="download" width={20} /><span><strong>{cantidadExportable} {tipoExportacion === 'clientes' ? 'clientes' : 'presupuestos'}</strong><small>Archivo CSV · UTF-8</small></span></div>{!cantidadExportable && <small>No hay datos para esta selección.</small>}<button type="button" className="premium-export-primary" disabled={!cantidadExportable || (tipoExportacion === 'presupuestos' && fechasExportacionInvalidas)} onClick={descargarExportacionPremium}>Descargar CSV<IconoOficial nombre="download" width={16} /></button></div> : <div className="premium-export-body"><p>Con Premium, exportás tus clientes o presupuestos y los abrís en Excel.</p><div className="premium-export-summary"><IconoOficial nombre="download" width={20} /><span><strong>MiOficio_presupuestos.csv</strong><small>Ejemplo · Cliente, fecha, moneda, importe y estado</small></span></div><small>Podés filtrar presupuestos por fecha y moneda. No se modifican los documentos originales.</small><button type="button" className="premium-export-primary" onClick={() => { setMostrarExportacion(false); activarPremium(); }}>Elegir un plan</button></div>}
      </dialog>
      {showModalEliminar && (
        <div className="model-overlay fixed inset-0 bg-slate-950/60 backdrop-blur-xs flex items-center justify-center p-3 z-50">
          <div className="delete-confirmation model-card" role="dialog" aria-modal="true" aria-labelledby="delete-confirmation-title" aria-describedby="delete-confirmation-description" onKeyDown={e => { if (e.key === 'Escape'&&!eliminandoRegistro) { setShowModalEliminar(false); setItemAEliminar(null); } }}>
            <div className="delete-confirmation-heading">
              <span className="delete-confirmation-icon"><IconoEliminar /></span>
              <h3 id="delete-confirmation-title">Eliminar {itemAEliminar?.tipo === 'cliente' ? 'cliente' : 'presupuesto'}</h3>
            </div>
            <p className="delete-confirmation-name">{itemAEliminar?.numero}</p>
            <p id="delete-confirmation-description" className="delete-confirmation-description">{itemAEliminar?.tipo === 'cliente' ? 'Se quitará del directorio. Sus presupuestos permanecerán guardados.' : 'Se eliminará este presupuesto de tu cuenta.'}</p>
            <p className="delete-confirmation-note">Esta acción no se puede deshacer.</p>
            <div className="delete-confirmation-actions">
              <button autoFocus type="button" disabled={eliminandoRegistro} onClick={() => { setShowModalEliminar(false); setItemAEliminar(null); }} className="model-secondary-button">Cancelar</button>
              <button type="button" disabled={eliminandoRegistro} aria-busy={eliminandoRegistro} onClick={confirmarEliminacion} className="delete-confirmation-submit"><IconoEliminar /><span>{eliminandoRegistro?'Eliminando…':'Eliminar'} {itemAEliminar?.tipo === 'cliente' ? 'cliente' : 'presupuesto'}</span></button>
            </div>
          </div>
        </div>
      )}

      {advertenciaFree && perfilForm.es_premium !== true && (
        <div className="access-ended-overlay">
          <section className="access-ended-card" role="alertdialog" aria-modal="true" aria-labelledby="access-ended-title" aria-describedby="access-ended-reason" onKeyDown={event => { if (event.key === 'Escape') setAdvertenciaFree(null); }}>
            <span className="access-ended-icon" aria-hidden="true">!</span>
            <p className="access-ended-label">ACTUALIZACIÓN DE TU MEMBRESÍA</p>
            <h2 id="access-ended-title">Tu cuenta ahora está en el plan Free</h2>
            <p className="access-ended-description">Las herramientas Premium dejaron de estar disponibles. Podés volver a contratarlas eligiendo el plan que mejor se adapte a tu actividad.</p>
            <div className="access-ended-reason"><strong>Motivo del cambio</strong><p id="access-ended-reason">{advertenciaFree.reason}</p></div>
            <button autoFocus type="button" className="access-ended-primary" onClick={() => { setAdvertenciaFree(null); setMostrarAvisos(false); activarPremium(); }}>Volver a contratar Premium <span aria-hidden="true">→</span></button>
            <button type="button" className="access-ended-secondary" onClick={() => setAdvertenciaFree(null)}>Continuar con el plan Free</button>
          </section>
          <style>{`
.access-ended-overlay{position:fixed;inset:0;z-index:160;display:flex;align-items:center;justify-content:center;background:#0f172a88;backdrop-filter:blur(5px);padding:16px;box-sizing:border-box}
.mi-oficio-ui.mioficio-model .access-ended-card{box-sizing:border-box;width:100%;max-width:420px;max-height:calc(100dvh - 32px);overflow:auto;background:white;border:1px solid #e2e8f0;border-radius:18px;padding:24px;color:#0f172a;box-shadow:0 24px 80px #0f172a30}
.mi-oficio-ui.mioficio-model .access-ended-icon{display:grid;place-items:center;width:42px;height:42px;border-radius:12px;background:#fff7ed;color:#c2410c;font-size:25px;font-weight:700;margin-bottom:16px}
.mi-oficio-ui.mioficio-model .access-ended-label{font-size:10px!important;letter-spacing:.1em;color:#64748b;margin:0 0 6px!important;font-weight:700}
.mi-oficio-ui.mioficio-model .access-ended-card h2{font-size:23px!important;line-height:1.25!important;margin:0!important;letter-spacing:-.02em}
.mi-oficio-ui.mioficio-model .access-ended-description{font-size:13px!important;line-height:1.6!important;color:#64748b;margin:12px 0 16px!important}
.mi-oficio-ui.mioficio-model .access-ended-reason{padding:12px 14px;border:1px solid #fed7aa;background:#fffaf5;border-radius:10px;overflow-wrap:anywhere}
.mi-oficio-ui.mioficio-model .access-ended-reason strong{font-size:11px;color:#9a3412}.mi-oficio-ui.mioficio-model .access-ended-reason p{font-size:13px!important;line-height:1.5!important;white-space:pre-wrap;margin:5px 0 0!important;color:#334155}
.mi-oficio-ui.mioficio-model .access-ended-primary,.mi-oficio-ui.mioficio-model .access-ended-secondary{width:100%;display:flex!important;align-items:center;justify-content:center;gap:8px;min-height:42px!important;height:auto!important;padding:10px!important;border-radius:9px!important;font-size:13px!important;white-space:normal!important}
.mi-oficio-ui.mioficio-model .access-ended-primary{margin-top:18px!important;background:#1d4ed8!important;color:white!important;border:0!important;font-weight:650!important}.mi-oficio-ui.mioficio-model .access-ended-secondary{margin-top:7px!important;background:white!important;color:#64748b!important;border:1px solid #e2e8f0!important}
`}</style>
        </div>
      )}

      <style>{`
.mi-oficio-ui.mioficio-model.compact-dashboard .gestion-card{margin:14px 0!important;padding:18px!important;background:white;border:1px solid #e2e8f0;border-radius:12px;min-width:0;color:#0f172a}
.mi-oficio-ui.mioficio-model.compact-dashboard .gestion-card h3{font-size:17px!important;margin:5px 0 0!important}.mi-oficio-ui.mioficio-model.compact-dashboard .gestion-card p{font-size:12px!important;line-height:1.6!important;color:#64748b;margin:10px 0!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .gestion-card summary{font-size:14px;font-weight:650;cursor:pointer;line-height:1.6}.mi-oficio-ui.mioficio-model.compact-dashboard .gestion-kicker{font-size:10px;letter-spacing:.1em;color:#64748b;font-weight:700}
.mi-oficio-ui.mioficio-model.compact-dashboard .gestion-card button,.mi-oficio-ui.mioficio-model.compact-dashboard .collection-dialog button{height:auto!important;min-height:34px!important;padding:8px 11px!important;border-radius:8px!important;background:#eff6ff!important;color:#1d4ed8!important;border:1px solid #bfdbfe!important;font-size:12px!important;white-space:normal!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .gestion-card input,.mi-oficio-ui.mioficio-model.compact-dashboard .gestion-card select,.mi-oficio-ui.mioficio-model.compact-dashboard .collection-dialog input,.mi-oficio-ui.mioficio-model.compact-dashboard .collection-dialog select{box-sizing:border-box;height:38px!important;min-height:38px!important;padding:8px 10px!important;border:1px solid #cbd5e1!important;border-radius:8px!important;font-size:12px!important;max-width:100%;background:white!important;color:#0f172a!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .gestion-table-scroll{overflow-x:auto;margin:12px 0;max-width:100%}.mi-oficio-ui.mioficio-model.compact-dashboard .gestion-card table,.mi-oficio-ui.mioficio-model.compact-dashboard .collection-dialog table{width:100%;border-collapse:collapse;font-size:12px}.mi-oficio-ui.mioficio-model.compact-dashboard .gestion-card td,.mi-oficio-ui.mioficio-model.compact-dashboard .gestion-card th,.mi-oficio-ui.mioficio-model.compact-dashboard .collection-dialog td,.mi-oficio-ui.mioficio-model.compact-dashboard .collection-dialog th{padding:10px!important;text-align:left;border-bottom:1px solid #e2e8f0;white-space:nowrap}.mi-oficio-ui.mioficio-model.compact-dashboard .gestion-card td small{display:block;color:#64748b;margin-top:3px}
.gestion-heading,.gestion-filters{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}.gestion-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:14px}.gestion-metrics>div{padding:12px;border:1px solid #e2e8f0;border-radius:9px;background:#f8fafc}.gestion-metrics small{display:block;font-size:11px;color:#64748b}.gestion-metrics strong{display:block;font-size:16px;margin-top:7px;overflow-wrap:anywhere}.gestion-badge{font-size:10px;font-weight:500;color:#1d4ed8;margin-left:8px}.membership-card{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}.membership-card details{width:100%}
.collection-overlay{position:fixed;inset:0;z-index:150;background:#0f172a88;display:flex;align-items:center;justify-content:center;padding:14px;box-sizing:border-box}.collection-dialog{width:100%;max-width:500px;max-height:calc(100dvh - 28px);overflow:auto;padding:20px;background:white;border-radius:15px;box-sizing:border-box;color:#0f172a}.collection-dialog h2{font-size:20px!important;margin:0!important}.collection-dialog p{font-size:12px!important;line-height:1.6!important;color:#64748b}.collection-dialog label{display:grid;gap:5px;font-size:12px;color:#475569}.collection-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:14px 0}.collection-actions{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;margin-top:16px}.collection-dialog button:disabled{opacity:.5;cursor:wait}.collection-dialog .gestion-table-scroll{overflow-x:auto}.collection-dialog input{width:100%}
@media(max-width:640px){.gestion-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.gestion-heading{align-items:flex-start}.gestion-filters{width:100%}.collection-grid{grid-template-columns:1fr}.mi-oficio-ui.mioficio-model.compact-dashboard .gestion-card{padding:14px!important}.collection-dialog{padding:16px}}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-tool-grid{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:12px!important;margin:0 0 16px!important;align-items:start!important;min-width:0!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .budget-tool-grid .compact-tool-card{margin:0!important;padding:0!important;border:1px solid #e2e8f0!important;border-radius:12px!important;background:#fff!important;box-shadow:none!important;min-width:0!important;overflow:hidden!important;color:#0f172a!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .compact-tool-card>.compact-tool-heading{display:flex!important;list-style:none!important;align-items:center!important;gap:11px!important;padding:15px!important;font-size:13px!important;font-weight:400!important;cursor:pointer!important;min-width:0!important;line-height:1.4!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .compact-tool-heading::-webkit-details-marker{display:none!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .compact-tool-icon,.mi-oficio-ui.mioficio-model.compact-dashboard .plan-strip-icon{display:flex!important;align-items:center!important;justify-content:center!important;width:36px!important;height:36px!important;flex:0 0 36px!important;background:#eff6ff!important;color:#2563eb!important;border-radius:10px!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .compact-tool-icon svg,.mi-oficio-ui.mioficio-model.compact-dashboard .plan-strip-icon svg{width:19px!important;height:19px!important;max-width:19px!important;display:block!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .compact-tool-copy{flex:1!important;min-width:0!important;display:grid!important;gap:4px!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .compact-tool-copy strong{font-size:13px!important;font-weight:650!important;color:#0f172a!important;line-height:1.3!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .compact-tool-copy small{font-size:11px!important;color:#64748b!important;line-height:1.4!important;display:block!important;white-space:normal!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .compact-tool-chevron{font-size:18px!important;color:#94a3b8!important;transition:transform .15s;flex:none!important}.mi-oficio-ui.mioficio-model.compact-dashboard .compact-tool-card[open]>.compact-tool-heading .compact-tool-chevron{transform:rotate(180deg)}
.mi-oficio-ui.mioficio-model.compact-dashboard .compact-tool-body{padding:0 15px 15px!important;min-width:0!important;border-top:1px solid #f1f5f9!important}.mi-oficio-ui.mioficio-model.compact-dashboard .compact-tool-body>input{width:100%!important;margin-top:12px!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .compact-tool-footnote{display:block!important;font-size:11px!important;font-weight:400!important;line-height:1.5!important;color:#64748b!important;margin-top:10px!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .reply-field-label{display:block!important;font-size:11px!important;font-weight:600!important;color:#475569!important;margin:12px 0 6px!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .reply-tools{display:flex!important;flex-wrap:wrap!important;gap:7px!important;margin:8px 0!important;min-width:0!important}.mi-oficio-ui.mioficio-model.compact-dashboard .reply-tools select{box-sizing:border-box!important;height:36px!important;min-width:0!important;flex:1 1 160px!important;width:100%!important;max-width:100%!important;font-size:12px!important;padding:8px 28px 8px 10px!important;border:1px solid #cbd5e1!important;border-radius:8px!important;background:#fff!important;color:#0f172a!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .compact-tool-card .reply-button{box-sizing:border-box!important;display:inline-flex!important;align-items:center!important;justify-content:center!important;height:36px!important;min-height:36px!important;width:auto!important;padding:8px 11px!important;border:1px solid #e2e8f0!important;border-radius:8px!important;background:#fff!important;color:#475569!important;font-size:12px!important;font-weight:600!important;line-height:1.2!important;white-space:nowrap!important;box-shadow:none!important;cursor:pointer!important}.mi-oficio-ui.mioficio-model.compact-dashboard .compact-tool-card .reply-button.primary{background:#2563eb!important;border-color:#2563eb!important;color:#fff!important}.mi-oficio-ui.mioficio-model.compact-dashboard .compact-tool-card .reply-button:disabled{opacity:.45!important;cursor:default!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .reply-ready{display:flex!important;flex-wrap:wrap!important;gap:10px!important;align-items:center!important;justify-content:space-between!important;padding:12px!important;border:1px solid #dbeafe!important;border-radius:9px!important;background:#f8fbff!important;margin-top:12px!important}.mi-oficio-ui.mioficio-model.compact-dashboard .reply-ready strong{display:block!important;font-size:12px!important;color:#1e40af!important}.mi-oficio-ui.mioficio-model.compact-dashboard .reply-ready small{display:block!important;font-size:11px!important;color:#64748b!important;margin-top:4px!important}.mi-oficio-ui.mioficio-model.compact-dashboard .reply-ready>div{display:flex!important;gap:6px!important;flex-wrap:wrap!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .reply-notice{font-size:11px!important;line-height:1.5!important;padding:9px 10px!important;margin-top:10px!important;background:#eff6ff!important;color:#1e40af!important;border-radius:8px!important;overflow-wrap:anywhere!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .reply-history-heading{display:flex!important;align-items:center!important;justify-content:space-between!important;margin:17px 0 5px!important;font-size:10px!important;font-weight:650!important;letter-spacing:.04em!important;color:#64748b!important;text-transform:uppercase!important}.mi-oficio-ui.mioficio-model.compact-dashboard .reply-history-heading span{letter-spacing:0!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .reply-record{padding:0!important;border-top:1px solid #f1f5f9!important}.mi-oficio-ui.mioficio-model.compact-dashboard .reply-record>summary{display:flex!important;justify-content:space-between!important;align-items:center!important;gap:8px!important;list-style:none!important;padding:12px 0!important;font-size:12px!important;font-weight:600!important;cursor:pointer!important}.mi-oficio-ui.mioficio-model.compact-dashboard .reply-record>summary::-webkit-details-marker{display:none!important}.mi-oficio-ui.mioficio-model.compact-dashboard .reply-status-tag{font-size:10px!important;font-weight:500!important;padding:4px 7px!important;background:#f1f5f9!important;color:#64748b!important;border-radius:6px!important;flex:none!important}.mi-oficio-ui.mioficio-model.compact-dashboard .reply-status-tag.accepted{background:#ecfdf5!important;color:#047857!important}.mi-oficio-ui.mioficio-model.compact-dashboard .reply-status-tag.rejected{background:#fef2f2!important;color:#b91c1c!important}.mi-oficio-ui.mioficio-model.compact-dashboard .reply-history strong{font-size:12px!important}.mi-oficio-ui.mioficio-model.compact-dashboard .reply-history p{font-size:12px!important;line-height:1.5!important;margin:5px 0!important;color:#475569!important}.mi-oficio-ui.mioficio-model.compact-dashboard .reply-history small{font-size:10px!important;color:#94a3b8!important}
.mi-oficio-ui.mioficio-model.compact-dashboard .plan-strip{display:flex!important;align-items:center!important;gap:12px!important;padding:15px 17px!important;margin:0 0 16px!important;border:1px solid #dbeafe!important;border-radius:12px!important;background:#f8fbff!important;min-width:0!important;box-sizing:border-box!important}.mi-oficio-ui.mioficio-model.compact-dashboard .plan-strip-copy{flex:1!important;min-width:0!important}.mi-oficio-ui.mioficio-model.compact-dashboard .plan-strip-copy>div{display:flex!important;align-items:center!important;gap:8px!important;flex-wrap:wrap!important}.mi-oficio-ui.mioficio-model.compact-dashboard .plan-strip-copy strong{font-size:14px!important;line-height:1.3!important;font-weight:650!important;color:#0f172a!important}.mi-oficio-ui.mioficio-model.compact-dashboard .plan-strip-copy small{display:block!important;font-size:11px!important;color:#64748b!important;line-height:1.5!important;margin-top:5px!important}.mi-oficio-ui.mioficio-model.compact-dashboard .plan-strip-active,.mi-oficio-ui.mioficio-model.compact-dashboard .plan-strip-free{font-size:10px!important;font-weight:600!important;padding:3px 7px!important;border-radius:6px!important;background:#ecfdf5!important;color:#047857!important}.mi-oficio-ui.mioficio-model.compact-dashboard .plan-strip-free{background:#e2e8f0!important;color:#475569!important}.mi-oficio-ui.mioficio-model.compact-dashboard .plan-strip-action{display:inline-flex!important;align-items:center!important;gap:9px!important;flex:none!important;width:auto!important;height:auto!important;min-height:34px!important;padding:8px 10px!important;border:1px solid #dbeafe!important;border-radius:8px!important;background:#fff!important;color:#1d4ed8!important;font-size:11px!important;font-weight:600!important;white-space:nowrap!important;box-shadow:none!important}
@media(max-width:760px){.mi-oficio-ui.mioficio-model.compact-dashboard .budget-tool-grid{grid-template-columns:minmax(0,1fr)!important;gap:8px!important}.mi-oficio-ui.mioficio-model.compact-dashboard .plan-strip{padding:13px!important;gap:9px!important;flex-wrap:wrap!important}.mi-oficio-ui.mioficio-model.compact-dashboard .plan-strip-action{margin-left:45px!important}.mi-oficio-ui.mioficio-model.compact-dashboard .plan-strip-copy{flex-basis:calc(100% - 45px)!important}}

`}</style>
      {selectorComprobante&&(()=>{
        const tipo=selectorComprobante;
        const elegibles=presupuestos.filter(p=>tipo==='trabajo'?['Aceptado','Pagado'].includes(p.estado):tipo==='pago'?listarComprobantesCobros([p]).some(r=>r.tipo==='pago'):Object.values(p.reversiones_cobros||{}).some(r=>r.tipo==='devolucion'));
        const elegido=elegibles.find(p=>String(p.presupuesto_id)===presupuestoDocumento);
        const operaciones=elegido?listarComprobantesCobros([elegido]).filter(r=>r.tipo===tipo):[];
        const operacion=operaciones.find(r=>referenciaMovimientoCobro(r)===operacionDocumento)||(operaciones.length===1?operaciones[0]:undefined);
        const continuar=()=>{if(!elegido)return;if(tipo==='trabajo'){setSelectorComprobante(null);abrirEntregas(elegido);}else if(operacion){setSelectorComprobante(null);abrirMovimientoCobro(operacion);}};
        return <dialog className="document-picker" ref={selectorDocumentoRef} aria-labelledby="document-picker-title" onClose={()=>setSelectorComprobante(null)}><header><div><small>Comprobantes</small><h2 id="document-picker-title">Generar comprobante</h2></div><button type="button" aria-label="Cerrar generador de comprobantes" onClick={()=>selectorDocumentoRef.current?.close()}><IconoOficial nombre="x"/></button></header><div className="document-picker-body"><label htmlFor="document-kind">Tipo de comprobante</label><select id="document-kind" value={tipo} onChange={e=>{setSelectorComprobante(e.target.value as 'pago'|'devolucion'|'trabajo');setPresupuestoDocumento('');setOperacionDocumento('');}}><option value="pago">Pago recibido</option><option value="devolucion">Devolución de dinero</option><option value="trabajo">Trabajo realizado</option></select><label htmlFor="document-budget">Presupuesto de referencia</label><select id="document-budget" value={presupuestoDocumento} onChange={e=>{setPresupuestoDocumento(e.target.value);setOperacionDocumento('');}}><option value="">Seleccioná un presupuesto</option>{elegibles.map(p=><option key={p.presupuesto_id} value={p.presupuesto_id}>{p.numero_presupuesto} · {p.cliente}</option>)}</select>{elegido&&<div className="document-reference-summary"><strong>{elegido.cliente}</strong><span>{elegido.numero_presupuesto}</span><b>{importeDocumento(totalVigentePresupuesto(elegido),elegido.moneda)}</b><small>Monto acordado del presupuesto</small></div>}{operaciones.length>1&&<><label htmlFor="document-operation">{tipo==='pago'?'Pago recibido':'Devolución registrada'}</label><select id="document-operation" value={operacionDocumento} onChange={e=>setOperacionDocumento(e.target.value)}><option value="">Seleccioná la operación</option>{operaciones.map(r=><option key={referenciaMovimientoCobro(r)} value={referenciaMovimientoCobro(r)}>{fechaCortaCompacta(r.fecha)} · {importeDocumento(r.importe,r.p.moneda)} · {medioMovimientoCobro(r)}</option>)}</select></>}{operacion&&<p className="document-picker-note">{tipo==='pago'?'Importe recibido':'Importe devuelto'}: <strong>{importeDocumento(operacion.importe,operacion.p.moneda)}</strong> · {medioMovimientoCobro(operacion)}</p>}<p className="document-picker-note">{tipo==='trabajo'?'Vas a revisar los trabajos incluidos antes de guardar la constancia.':'El PDF usa los datos de la operación registrada. Descargarlo no modifica pagos ni saldos.'}</p>{!elegibles.length&&<div className="document-picker-empty"><p>{tipo==='trabajo'?'Necesitás un presupuesto aceptado o pagado.':tipo==='pago'?'Todavía no registraste pagos.':'Todavía no registraste devoluciones.'}</p><button type="button" className="document-text-link" onClick={()=>{setSelectorComprobante(null);if(tipo==='trabajo')abrirMenuPrincipal('presupuestos');else{setVistaCobrosHub(tipo==='pago'?'saldos':'devoluciones');abrirMenuPrincipal('cobros');}}}>{tipo==='trabajo'?'Ir a Presupuestos':tipo==='pago'?'Registrar un pago':'Ir a Devoluciones'}<IconoOficial nombre="arrow-right"/></button></div>}</div><footer><button type="button" className="finance-button-secondary" onClick={()=>selectorDocumentoRef.current?.close()}>Cancelar</button><button type="button" className="finance-button-primary" disabled={!elegido||(tipo!=='trabajo'&&!operacion)} onClick={continuar}>{tipo==='trabajo'?'Completar constancia':'Ver comprobante'}<IconoOficial nombre="arrow-right"/></button></footer></dialog>;
      })()}
      {entregaGenerada&&<dialog className={`document-picker document-work-result${entregaConfirmada?' operation-success':''}`} ref={entregaGeneradaRef} aria-labelledby="work-result-title" onClose={()=>{setEntregaGenerada(null);setEntregaConfirmada(false);}}><header>{entregaConfirmada&&<span className="operation-success-symbol"><IconoOficial nombre="check"/></span>}<div><small>{entregaConfirmada?'MiOficio':'Comprobante de trabajo'}</small><h2 id="work-result-title">{entregaConfirmada?'Comprobante generado':'Trabajo realizado'}</h2></div><button type="button" aria-label="Cerrar constancia de trabajo" onClick={()=>entregaGeneradaRef.current?.close()}><IconoOficial nombre="x"/></button></header><div className="document-picker-body"><span className="document-saved"><IconoOficial nombre="check"/>Disponible para consultar y descargar</span><div className="document-reference-summary"><strong>{entregaGenerada.cliente}</strong><span>{entregaGenerada.presupuestoNumero}</span>{entregaGenerada.importePresupuesto!==undefined&&<b>{importeDocumento(entregaGenerada.importePresupuesto,monedaPresupuesto(entregaGenerada.monedaPresupuesto))}</b>}<small>Monto acordado del presupuesto</small></div><dl className="document-work-data"><div><dt>N.º de comprobante</dt><dd>{entregaGenerada.numero}</dd></div><div><dt>Fecha del trabajo</dt><dd>{fechaCortaCompacta(entregaGenerada.fecha)}</dd></div></dl><details className="operation-success-extra" open={entregaConfirmada?undefined:true}><summary>Ver trabajos realizados</summary><ul>{entregaGenerada.partidas?entregaGenerada.partidas.filter(i=>i.estado==='realizado').map((i,n)=><li key={n}>{i.descripcion}</li>):<li>{entregaGenerada.detalle}</li>}</ul>{entregaGenerada.observaciones&&<p>{entregaGenerada.observaciones}</p>}</details>{entregaGenerada.firmaDigital&&<p className="document-saved">{entregaGenerada.firmaDigital.tipo==='nombre'?'Nombre del firmante incorporado':entregaGenerada.firmaDigital.tipo==='imagen'?'Firma incorporada automáticamente':'Firmado digitalmente'}{entregaGenerada.firmaDigital.firmante?' · '+entregaGenerada.firmaDigital.firmante:''}</p>}

<button type="button" className="document-text-link" onClick={()=>verEntrega(entregaGenerada)}><IconoOficial nombre="external-link"/>Abrir PDF en el navegador</button></div><footer><button type="button" className="finance-button-secondary" onClick={()=>{entregaGeneradaRef.current?.close();if(entregaConfirmada)setActiveTab('dashboard');}}>{entregaConfirmada?'Volver al inicio':'Cerrar'}</button><button type="button" className="finance-button-primary" disabled={descargandoEntrega} onClick={()=>void descargarEntrega(entregaGenerada)}><IconoOficial nombre="download"/>{descargandoEntrega?'Preparando…':'Descargar PDF'}</button></footer></dialog>}

      <style>{`

    {id:'consolidar',titulo:'Consolidar presupuestos',detalle:'Reuní documentos del mismo cliente en un único PDF.',plan:'premium' as const,icono:'files' as const,meta:()=> 'Selección por cliente',abrir:()=>{setClienteHerramientaPremium('');setBusquedaClienteConsolidado('');setSelectorConsolidadoModelo(true);}},
    {id:'entrega',titulo:'Comprobante de trabajo',detalle:'Generá la constancia del trabajo realizado. Free incluye la marca de MiOficio.',plan:'free' as const,icono:'file-text' as const,meta:()=> 'Constancia en PDF',abrir:()=>abrirEntregas()},
    {id:'firmas',titulo:'Firma del profesional',detalle:'Guardá tu firma o tu nombre para los comprobantes de trabajo.',plan:'premium' as const,icono:'file-text' as const,meta:()=>modoFirmaPerfil(perfilForm)==='ninguna'?'Configurar firma':'Firma automática',abrir:()=>setMostrarFirmaPremium(true)},
    {id:'condiciones',titulo:'Condiciones habituales',detalle:'Definí moneda, validez y condiciones para tus próximos presupuestos.',plan:'premium' as const,icono:'sliders-horizontal' as const,meta:()=> 'Valores iniciales del generador',abrir:()=>setConfigComercialActiva('condiciones')},
    {id:'series',titulo:'Numeración y series',detalle:'Elegí el prefijo y el número de tus próximos presupuestos.',plan:'premium' as const,icono:'file-text' as const,meta:()=> 'Serie y numeración de documentos',abrir:()=>setConfigComercialActiva('series')},
    ...(compartirMovilDisponible?[{id:'whatsapp',titulo:'Compartir por WhatsApp',detalle:'Compartí un presupuesto y su mensaje con tu cliente.',plan:'premium' as const,icono:'share-2' as const,meta:()=> 'Presupuesto en PDF',abrir:()=>abrirCompartirWhatsapp()}]:[]),
    {id:'exportar',titulo:'Exportación avanzada',detalle:'Exportá datos a CSV filtrando por fecha y moneda.',plan:'premium' as const,icono:'download' as const,meta:()=> 'Compatible con planillas',abrir:()=>setMostrarExportacion(true)},
  ];
  const herramientasVisibles=()=>herramientasCentro.filter(h=>(filtroHerramientas==='todas'||h.plan===filtroHerramientas)&&textoHerramienta(h.titulo+' '+h.detalle).includes(textoHerramienta(busquedaHerramientas)));

  const [configuracionBorrador,setConfiguracionBorrador]=useState<ConfiguracionMiOficio>(()=>leerConfiguracionMiOficio({}));

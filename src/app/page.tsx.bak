      <style>{`#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .wo-date-control{position:relative!important;display:flex!important;align-items:center!important;justify-content:space-between!important;gap:8px!important;min-height:36px!important;padding:7px 10px!important;border:1px solid #e2dced!important;border-radius:10px!important;font-size:13px!important;color:#29223d!important;background:#fff!important;}#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .wo-date-control:focus-within{outline:2px solid #6244df!important;outline-offset:3px!important;}#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .wo-workspace .wo-hero-facts .wo-date-control input{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;margin:0!important;opacity:0!important;cursor:pointer!important;}#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .wo-date-control>svg{--mioficio-icon-size:16px!important;color:#83788e!important;}@media(max-width:767px){#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .wo-hero-facts strong{font-size:17px!important;}#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .wo-hero-facts:has(.wo-money-long){grid-template-columns:minmax(0,1fr)!important;}#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard#mioficio-dashboard[data-model="166657"] .wo-hero-facts .wo-money-long{font-size:18px!important;}}`}</style>
      {!panelModalAbierto&&<nav aria-label="Menú principal móvil" className="approved-bottom-nav"><button type="button" aria-current={activeTab==='dashboard'?'page':undefined} onClick={()=>abrirMenuPrincipal('dashboard')}><IconoPanel name="home"/><span>Inicio</span></button><button type="button" aria-current={activeTab==='clientes'?'page':undefined} onClick={()=>abrirMenuPrincipal('clientes')}><IconoPanel name="clients"/><span>Clientes</span></button><button type="button" className="approved-create" aria-label="Nuevo presupuesto" onClick={abrirNuevoPresupuestoInicio}><span className="m79-create-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" aria-hidden="true"><path d="M12 4v16M4 12h16"/></svg></span><span className="m79-create-label">Crear</span></button><button type="button" aria-current={activeTab==='presupuestos'?'page':undefined} onClick={()=>abrirMenuPrincipal('presupuestos')}><IconoPanel name="quotes"/><span>Presupuestos</span></button><button type="button" aria-current={!['dashboard','clientes','presupuestos'].includes(activeTab)?'page':undefined} onClick={()=>abrirMenuPrincipal('menu-movil')}><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg><span>Menú</span></button></nav>}


    </div>
    </>
  );
}

// ------------------------------------------------------------------------------
// ROUTER MAESTRO PÚBLICO / PRIVADO (Page)
// ------------------------------------------------------------------------------
const MIOFICIO_LOGO_ENCABEZADO='data:image/svg+xml;base64,';
const MIOFICIO_LOGO_PERMANENTE = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(MI_OFICIO_PDF_SVG)}`;


const RUBROS_CLAE_ARGENTINA: { codigo: string; nombre: string }[] = [];
type ClientReply = {id:string;action:string;name:string;message:string;at:number;version:string};
type SharedBudget = {budgetId:number;number:string;status:string;expiresAt:number;token:string;updatedAt:number;replies:ClientReply[]};
type PublicBudget = {number:string;client:string;business:string;date:string;currency:string;total:number;conditions:string;items:{description:string;quantity:number;price:number;discount:number;tax:number}[]};
const replyLabel = (action:string) => (({accept:'Aceptó el presupuesto',changes:'Solicitó cambios',reject:'Rechazó el presupuesto',question:'Envió una consulta',update:'Solicitó actualizar el presupuesto'} as Record<string,string>)[action]||'Respondió');
const replyDate = (at:number) => new Date(at).toLocaleString('es-AR',{timeZone:'America/Argentina/Buenos_Aires'});
const replyMoney = (value:number,currency:string) => `${currency||'ARS'} ${Number(value).toLocaleString('es-AR',{minimumFractionDigits:2,maximumFractionDigits:2})}`;
const clientReplyCSS = `.reply-panel{border:1px solid #e2e8f0;background:#fff;border-radius:14px;padding:18px;margin-bottom:16px;color:#0f172a}.reply-panel summary{cursor:pointer;font-size:14px;font-weight:700}.reply-panel p{font-size:13px;line-height:1.6;color:#64748b;margin:10px 0}.reply-tools{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0}.reply-tools select,.reply-input{border:1px solid #cbd5e1;border-radius:9px;padding:10px;font:inherit;max-width:100%;background:white;color:#0f172a}.reply-tools select{flex:1;min-width:0}.reply-button{border:1px solid #cbd5e1;border-radius:9px;padding:10px 14px;background:white;color:#334155;font-size:13px;font-weight:600;cursor:pointer}.reply-button.primary{background:#2563eb;color:white;border-color:#2563eb}.reply-button:disabled{opacity:.5;cursor:default}.reply-button:focus-visible,.reply-input:focus-visible{outline:2px solid #2563eb;outline-offset:3px}.reply-record{padding:12px 0;border-top:1px solid #e2e8f0;font-size:13px}.reply-record summary{display:flex;flex-wrap:wrap;gap:8px;justify-content:space-between}.reply-history{border-left:2px solid #dbeafe;padding:3px 12px;margin:12px 0;overflow-wrap:anywhere}.reply-history small{color:#64748b}.reply-notice{font-size:13px;padding:12px;border-radius:9px;background:#eff6ff;color:#1e40af;overflow-wrap:anywhere}.reply-public{min-height:100vh;background:#f1f5f9;padding:28px 16px;color:#0f172a;font-family:Arial,sans-serif}.reply-public main{max-width:760px;margin:auto}.reply-public h1{font-size:26px;line-height:1.2;margin:10px 0}.reply-public h2{font-size:18px}.reply-public table{width:100%;border-collapse:collapse;font-size:13px}.reply-public th,.reply-public td{padding:12px 8px;text-align:left;border-bottom:1px solid #e2e8f0;overflow-wrap:anywhere}.reply-public textarea{width:100%;box-sizing:border-box;min-height:100px}.reply-public label{display:block;font-size:13px;margin:12px 0 6px}.reply-public input{width:100%;box-sizing:border-box}.reply-public .reply-total{text-align:right;font-size:22px;font-weight:700;margin-top:18px}.reply-table{overflow-x:auto}.reply-condition{white-space:pre-wrap;overflow-wrap:anywhere;font-size:13px;color:#475569}.reply-status{font-size:12px;color:#475569}.reply-error{color:#b91c1c;font-size:13px;margin:12px 0;overflow-wrap:anywhere}@media(max-width:480px){.reply-public{padding:16px 10px}.reply-panel{padding:14px}.reply-public h1{font-size:22px}.reply-tools .reply-button{flex:1}}`;
async function ownerReplyRequest(body?:unknown) {
 const user=auth.currentUser;
 if(!user) throw new Error('Iniciá sesión nuevamente.');
 const token=await user.getIdToken();
 const response=await fetch('/api/presupuestos/respuesta',{method:body?'POST':'GET',cache:'no-store',headers:{Authorization:`Bearer ${token}`,'Content-Type':'application/json'},...(body?{body:JSON.stringify(body)}:{})});
 const data=await response.json(); if(!response.ok) throw new Error(data.error||'No se pudo completar la operación.'); return data;
}
function PublicBudgetResponse({token}:{token:string}) {
 const [data,setData]=useState<{document:PublicBudget;status:string;expired:boolean;superseded:boolean;expiresAt:number;replies:ClientReply[]}|null>(null);const [error,setError]=useState('');const [name,setName]=useState('');const [message,setMessage]=useState('');const [busy,setBusy]=useState(false);const [confirmation,setConfirmation]=useState(false);const [success,setSuccess]=useState('');const retry=useRef<{key:string;id:string}|null>(null);
 const load=async()=>{const response=await fetch(`/api/presupuestos/respuesta?token=${encodeURIComponent(token)}`,{cache:'no-store',referrerPolicy:'no-referrer'});const body=await response.json();if(!response.ok)throw new Error(body.error||'Enlace no disponible.');setData(body);};
 useEffect(()=>{load().catch(e=>setError(e.message));},[token]);
 const send=async(action:string)=>{if(action==='accept'&&!confirmation){setError('Confirmá que revisaste el presupuesto antes de aceptarlo.');return;}setBusy(true);setError('');setSuccess('');const key=JSON.stringify([action,name,message]);if(retry.current?.key!==key)retry.current={key,id:crypto.randomUUID()};try{const response=await fetch('/api/presupuestos/respuesta',{method:'POST',headers:{'Content-Type':'application/json'},referrerPolicy:'no-referrer',body:JSON.stringify({token,action,name,message,id:retry.current.id})});const body=await response.json();if(!response.ok)throw new Error(body.error||'No se pudo enviar la respuesta.');retry.current=null;setSuccess('Tu respuesta fue enviada al profesional.');await load();}catch(e){setError(e instanceof Error?e.message:'No se pudo enviar la respuesta.');}finally{setBusy(false);}};
 const pdf=()=>{if(!data)return;const p=data.document,doc=new jsPDF();let y=20;const line=(text:string,size=11)=>{doc.setFontSize(size);for(const part of doc.splitTextToSize(text,174)){if(y>275){doc.addPage();y=20;}doc.text(part,18,y);y+=6;}y+=3;};line(p.business,18);line(`Presupuesto ${p.number}`,15);line(`Cliente: ${p.client} · Fecha: ${p.date}`);p.items.forEach(i=>line(`${i.quantity} x ${i.description} · Precio unitario neto: ${replyMoney(i.price,p.currency)} · Bonificación: ${i.discount}% · IVA: ${i.tax}%`));line(`TOTAL: ${replyMoney(p.total,p.currency)}`,15);line(p.conditions);line(`Válido hasta: ${replyDate(data.expiresAt)}`);doc.save(`presupuesto-${p.number.replace(/[^a-z0-9-]/gi,'')}.pdf`);};
 return <div className="reply-public"><main><section className="reply-panel"><span className="reply-status">MIOFICIO · PRESUPUESTO COMPARTIDO</span>{data?<><h1>{data.document.business}</h1><p>{data.document.number} · {data.document.client}</p><div className="reply-table"><table><thead><tr><th>Detalle</th><th>Cantidad</th><th>Precio neto unitario</th></tr></thead><tbody>{data.document.items.map((i,n)=><tr key={n}><td>{i.description}<small style={{display:'block',color:'#64748b'}}>Bonificación {i.discount}% · IVA {i.tax}%</small></td><td>{i.quantity}</td><td>{replyMoney(i.price,data.document.currency)}</td></tr>)}</tbody></table></div><div className="reply-total">{replyMoney(data.document.total,data.document.currency)}</div><p>Válido hasta {replyDate(data.expiresAt)}</p><div className="reply-condition">{data.document.conditions}</div><div className="reply-tools"><button className="reply-button" onClick={pdf}>Descargar PDF</button></div></>:<p>{error?'No pudimos abrir este presupuesto.':'Cargando presupuesto…'}</p>}</section>{data&&<section className="reply-panel"><h2>Tu respuesta</h2>{data.superseded?<div className="reply-notice">Hay una versión más reciente. Contactá al profesional para recibir el nuevo enlace.</div>:data.status!=='pending'?<div className="reply-notice">{data.status==='accepted'?'Este presupuesto fue aceptado.':'Este presupuesto fue rechazado.'}</div>:<>{data.expired&&<div className="reply-notice">La validez finalizó. Podés solicitar un presupuesto actualizado o enviar una consulta.</div>}<label htmlFor="reply-name">Tu nombre</label><input id="reply-name" className="reply-input" maxLength={120} value={name} onChange={e=>setName(e.target.value)} autoComplete="name"/><label htmlFor="reply-message">Mensaje</label><textarea id="reply-message" className="reply-input" maxLength={1500} value={message} onChange={e=>setMessage(e.target.value)} placeholder="Indicá tu consulta o los cambios que necesitás."/>{!data.expired&&<label style={{display:'flex',gap:8,alignItems:'flex-start'}}><input type="checkbox" style={{width:'auto',marginTop:3}} checked={confirmation} onChange={e=>setConfirmation(e.target.checked)}/>Revisé el importe y las condiciones y quiero aceptar este presupuesto.</label>}<div className="reply-tools">{data.expired?<button className="reply-button primary" disabled={busy} onClick={()=>send('update')}>Solicitar actualización</button>:<><button className="reply-button primary" disabled={busy} onClick={()=>send('accept')}>Aceptar presupuesto</button><button className="reply-button" disabled={busy} onClick={()=>send('changes')}>Solicitar cambios</button><button className="reply-button" disabled={busy} onClick={()=>send('reject')}>Rechazar</button></>}<button className="reply-button" disabled={busy} onClick={()=>send('question')}>Enviar consulta</button></div><p>La respuesta se registra desde este enlace y no verifica la identidad del remitente. Compartilo únicamente con el destinatario.</p></>}{success&&<div className="reply-notice" role="status">{success}</div>}</section>}{error&&<div className="reply-error" role="alert">{error}</div>}{data?.replies.length? <section className="reply-panel"><h2>Historial de respuestas</h2>{data.replies.map(r=><div key={r.id} className="reply-history"><strong>{replyLabel(r.action)}</strong><p>{r.message||r.name}</p><small>{replyDate(r.at)}</small></div>)}</section>:null}<style>{clientReplyCSS}</style></main></div>;
}

type MembershipSubscription={ok:boolean;subscriptionId:string|null;recurring:boolean;status:string;renewalActive:boolean;canCancel:boolean;nextPaymentDate:string|null;amount:number|null;currency:string;expiresAt:number|null;premium:boolean;message?:string};
function SubscriptionMembership(){
 const [data,setData]=useState<MembershipSubscription|null>(null),[error,setError]=useState(''),[confirmation,setConfirmation]=useState(false),[busy,setBusy]=useState(false);
 const request=async(body?:unknown)=>{if(!auth.currentUser)throw new Error('Iniciá sesión nuevamente.');const response=await fetch('/api/mercadopago/subscription',{method:body?'POST':'GET',cache:'no-store',headers:{Authorization:`Bearer ${await auth.currentUser.getIdToken()}`,'Content-Type':'application/json'},...(body?{body:JSON.stringify(body)}:{})});const result=await response.json();if(!response.ok)throw new Error(result.error||'No se pudo consultar la suscripción.');return result as MembershipSubscription;};
 useEffect(()=>{let cancelled=false,inFlight=false;const refresh=async()=>{if(inFlight||document.visibilityState==='hidden')return;inFlight=true;try{const result=await request();if(!cancelled){setData(result);setError('');}}catch(e){if(!cancelled)setError(e instanceof Error?e.message:'No se pudo consultar la suscripción.');}finally{inFlight=false;}};void refresh();const timer=window.setInterval(refresh,30000);window.addEventListener('focus',refresh);return()=>{cancelled=true;window.clearInterval(timer);window.removeEventListener('focus',refresh);};},[]);
 const cancel=async()=>{setBusy(true);setError('');try{setData(await request({action:'cancel',confirm:true,subscriptionId:data?.subscriptionId}));setConfirmation(false);}catch(e){setError(e instanceof Error?e.message:'No se pudo confirmar la cancelación.');}finally{setBusy(false);}};
 const date=(value:number|string)=>new Date(value).toLocaleDateString('es-AR',{timeZone:'America/Argentina/Buenos_Aires'});
 const cancelled=!!data&&['cancelled','canceled','finished'].includes(data.status);
 return <section className="subscription-management" aria-label="Administrar renovación"><div className="subscription-heading"><div><span className="subscription-kicker">TU MEMBRESÍA</span><h3>{!data?'Consultando suscripción…':data.recurring?'Renovación mensual':'Plan de pago único'}</h3></div>{data&&<span className="subscription-badge">{data.renewalActive?'Automática activa':cancelled?'Renovación cancelada':data.status==='pending'?'Pendiente de autorización':data.status==='paused'?'Pausada':data.status==='failed'?'Creación no completada':'Sin renovación automática'}</span>}</div>{data&&<><div className="subscription-dates"><div><small>Acceso Premium</small><strong>{data.premium&&data.expiresAt?`Hasta el ${date(data.expiresAt)}`:data.expiresAt?`Finalizó el ${date(data.expiresAt)}`:'Se activa con el primer pago aprobado'}</strong></div>{data.renewalActive&&data.nextPaymentDate&&<div><small>Próximo cobro</small><strong>{date(data.nextPaymentDate)}{data.amount?` · $ ${data.amount.toLocaleString('es-AR')} ${data.currency}`:''}</strong></div>}</div>{cancelled&&<p>La renovación está cancelada.{data.premium&&data.expiresAt?` Conservás todas las herramientas Premium hasta el ${date(data.expiresAt)}.`:' No hay una renovación activa.'}</p>}{!data.recurring&&<p>Este plan no genera cobros automáticos.</p>}{data.status==='pending'&&<p>La suscripción todavía necesita autorización. Premium se activa cuando se verifica el primer pago.</p>}{data.canCancel&&!confirmation&&<button type="button" className="subscription-cancel" onClick={()=>setConfirmation(true)}>Cancelar renovación</button>}{confirmation&&<div className="subscription-confirm" role="group" aria-label="Confirmar cancelación"><strong>¿Cancelar la renovación automática?</strong><p>Se cancelará la suscripción en Mercado Pago. El acceso ya pagado se mantiene hasta su vencimiento.</p><div><button type="button" disabled={busy} onClick={()=>setConfirmation(false)}>Mantener renovación</button><button type="button" className="subscription-cancel" disabled={busy} onClick={cancel}>{busy?'Confirmando…':'Sí, cancelar renovación'}</button></div></div>}</>}{error&&<p className="subscription-error" role="alert">{error} La cancelación solo queda confirmada cuando aparece “Renovación cancelada”.</p>}<style>{`
.mi-oficio-ui.mioficio-model .subscription-management{margin:0 0 18px!important;padding:17px!important;border:1px solid #e2e8f0!important;background:#fff!important;border-radius:12px!important;color:#0f172a!important}.mi-oficio-ui.mioficio-model .subscription-heading{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:12px!important;flex-wrap:wrap!important}.mi-oficio-ui.mioficio-model .subscription-kicker{font-size:10px!important;letter-spacing:.07em!important;font-weight:650!important;color:#64748b!important}.mi-oficio-ui.mioficio-model .subscription-management h3{font-size:16px!important;margin:5px 0!important;font-weight:650!important}.mi-oficio-ui.mioficio-model .subscription-badge{font-size:10px!important;padding:5px 8px!important;background:#eff6ff!important;color:#1d4ed8!important;border-radius:7px!important}.mi-oficio-ui.mioficio-model .subscription-dates{display:flex!important;gap:20px!important;flex-wrap:wrap!important;padding:12px 0!important}.mi-oficio-ui.mioficio-model .subscription-dates small{display:block!important;font-size:11px!important;color:#64748b!important}.mi-oficio-ui.mioficio-model .subscription-dates strong{display:block!important;font-size:12px!important;margin-top:5px!important;color:#334155!important}.mi-oficio-ui.mioficio-model .subscription-management p{font-size:12px!important;line-height:1.6!important;color:#64748b!important;margin:8px 0!important}.mi-oficio-ui.mioficio-model .subscription-management button{padding:8px 11px!important;width:auto!important;height:auto!important;border:1px solid #e2e8f0!important;background:#fff!important;color:#475569!important;border-radius:8px!important;font-size:12px!important;font-weight:600!important;cursor:pointer!important}.mi-oficio-ui.mioficio-model .subscription-management button.subscription-cancel{color:#b91c1c!important;border-color:#fecaca!important;background:#fff!important}.mi-oficio-ui.mioficio-model .subscription-management button:disabled{opacity:.5!important;cursor:default!important}.mi-oficio-ui.mioficio-model .subscription-confirm{padding:13px!important;border:1px solid #e2e8f0!important;border-radius:9px!important;background:#f8fafc!important;margin-top:12px!important}.mi-oficio-ui.mioficio-model .subscription-confirm strong{font-size:13px!important}.mi-oficio-ui.mioficio-model .subscription-confirm>div{display:flex!important;gap:8px!important;flex-wrap:wrap!important}.mi-oficio-ui.mioficio-model .subscription-management .subscription-error{color:#b91c1c!important}
.mi-oficio-ui.mioficio-model .premium-renewal-options{padding:11px!important;border:1px solid #dbeafe!important;border-radius:9px!important;background:#f8fbff!important;margin:12px 0!important}.mi-oficio-ui.mioficio-model .premium-renewal-options p{font-size:11px!important;line-height:1.5!important;color:#64748b!important;margin:7px 0!important}.mi-oficio-ui.mioficio-model .premium-renewal-choice{display:flex!important;gap:6px!important}.mi-oficio-ui.mioficio-model .premium-renewal-choice button{font-size:11px!important;padding:8px!important;height:auto!important;min-height:32px!important;width:auto!important;flex:1!important;border:1px solid #e2e8f0!important;border-radius:7px!important;background:#fff!important;color:#475569!important}.mi-oficio-ui.mioficio-model .premium-renewal-choice button[aria-pressed=true]{background:#eff6ff!important;color:#1d4ed8!important;border-color:#93c5fd!important}.mi-oficio-ui.mioficio-model .premium-renewal-consent{display:flex!important;gap:8px!important;font-size:11px!important;line-height:1.5!important;color:#334155!important;margin-top:9px!important;align-items:flex-start!important}.mi-oficio-ui.mioficio-model .premium-plan-checkout .premium-renewal-consent input{width:15px!important;height:15px!important;min-height:15px!important;padding:0!important;margin-top:2px!important;flex:0 0 15px!important}
`}</style></section>;
}

export default function Page() {

  const [cerrandoSesion,setCerrandoSesion]=useState(false);
  const [errorCerrarSesion,setErrorCerrarSesion]=useState('');
  const salidaEnCurso=useRef(false);
  const [publicBudgetToken,setPublicBudgetToken]=useState<string | null>(null);
  const [mounted, setMounted] = useState(false);
  const [usuarioActual, setUsuarioActual] = useState<FirebaseUser | null>(null);
  const [cargandoAuth, setCargandoAuth] = useState(true);
  
  const [planPendiente, setPlanPendiente] = useState<PlanPremium | null>(null);
  const [vistaPublica, setVistaPublica] = useState<'landing' | 'login' | 'register'>('landing');

  useEffect(() => {
    setPublicBudgetToken(new URLSearchParams(window.location.search).get('presupuesto'));
    try { const guardado = sessionStorage.getItem('mioficio-plan-pendiente'); if (esPlanPremium(guardado)) setPlanPendiente(guardado); } catch {}
    setMounted(true);
    const unsubscribe = onAuthStateChanged(auth, (user) => {
      setUsuarioActual(user);
      setCargandoAuth(false);
    });
    return () => unsubscribe();
  }, []);

  useEffect(() => {
    if(!usuarioActual)return;
    const current=usuarioActual;let stopped=false;let timer:ReturnType<typeof setTimeout>|undefined;let attempts=0;
    const welcome=async()=>{
      attempts++;
      try{const response=await fetch('/api/auth/welcome',{method:'POST',cache:'no-store',headers:{Authorization:`Bearer ${await current.getIdToken()}`}});if(response.ok)return;if(response.status<500)return;}catch{}
      if(!stopped&&attempts<4)timer=setTimeout(welcome,45000);
    };
    void welcome();return()=>{stopped=true;if(timer)clearTimeout(timer);};
  },[usuarioActual?.uid]);

  const consumirPlanPendiente = () => {
    setPlanPendiente(null);
    try { sessionStorage.removeItem('mioficio-plan-pendiente'); } catch {}
  };
  const elegirPlanDesdeLanding = (plan: PlanPremium) => {
    setPlanPendiente(plan);
    try { sessionStorage.setItem('mioficio-plan-pendiente', plan); } catch {}
    setVistaPublica('register');
  };
  const comenzarGratis = () => { consumirPlanPendiente(); setVistaPublica('register'); };

  const handleCerrarSesion = async () => {
    if(salidaEnCurso.current)return;
    salidaEnCurso.current=true;setCerrandoSesion(true);setErrorCerrarSesion('');
    try {
      consumirPlanPendiente();
      await signOut(auth);
      setUsuarioActual(null);
      setVistaPublica('landing');
    } catch (e) {
      console.error("Error al cerrar sesión", e);
      setErrorCerrarSesion('No se pudo cerrar la sesión. Volvé a intentarlo.');
    } finally { salidaEnCurso.current=false;setCerrandoSesion(false); }
  };

  if (mounted && publicBudgetToken) return <PublicBudgetResponse token={publicBudgetToken}/>;
  if (!mounted || cargandoAuth) {
    return (
      <div className="min-h-screen bg-[#070b19] flex items-center justify-center">
        <div className="w-8 h-8 border-4 border-blue-600 border-t-transparent rounded-full animate-spin"></div>
      </div>
    );
  }

  if (!usuarioActual) {
    if (vistaPublica === 'landing') {
      return (
        <LandingPage 
          onGoToLogin={() => setVistaPublica('login')} 
          onGoToRegister={comenzarGratis}
          onElegirPremium={elegirPlanDesdeLanding} 
        />
      );
    }
    return (
      <AuthScreen 
        initialMode={vistaPublica === 'register' ? 'register' : 'login'}
        onLoginSuccess={(u) => setUsuarioActual(u)}
        onBackToLanding={() => setVistaPublica('landing')}
      />
    );
  }

  const datosUser = {
    uid: usuarioActual.uid, 
    name: usuarioActual.displayName || usuarioActual.email?.split('@')[0] || 'Usuario Profesional',
    email: usuarioActual.email || 'contacto@mioficio.ar'
  };

  return (
    <main className="min-h-screen">
      {errorCerrarSesion&&<div role="alert" style={{position:'fixed',top:12,left:'50%',transform:'translateX(-50%)',zIndex:500,width:'min(440px,calc(100% - 24px))',padding:'12px 14px',borderRadius:12,border:'1px solid #e7dff4',background:'#fff',boxShadow:'0 8px 30px #26133d22',color:'#39244b',fontSize:13,display:'flex',alignItems:'center',gap:12}}><span style={{flex:1}}>{errorCerrarSesion}</span><button type="button" disabled={cerrandoSesion} onClick={()=>void handleCerrarSesion()} style={{color:'#6244e8',fontWeight:600}}>{cerrandoSesion?'Cerrando…':'Reintentar'}</button></div>}
      <DashboardFrontend user={datosUser} cerrandoSesion={cerrandoSesion} onLogout={handleCerrarSesion} planInicial={planPendiente} onPlanConsumido={consumirPlanPendiente} />
    </main>
  );
}


const ESTILO_MODELO_APROBADO = `
